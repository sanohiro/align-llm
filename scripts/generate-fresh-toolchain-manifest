#!/usr/bin/env python3
"""Generate the installed Section 9 schema-2 toolchain and cache manifests."""

from __future__ import annotations

import argparse
import hashlib
import os
import stat
import subprocess
import sys
from collections import OrderedDict
from pathlib import Path


REPOSITORY = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPOSITORY / "scripts"))

from fresh_attestation import canonical_json_bytes, sha256_hex  # noqa: E402
from fresh_manifest import (  # noqa: E402
    ALLOWED_CACHE_PREFIXES,
    TOOL_INVENTORY,
    serialized_digest,
    structural_digest,
    validate_cache_manifest,
    validate_manifest,
)


MAX_PROBE_BYTES = 65_536


def mode_string(value: int) -> str:
    return f"{stat.S_IMODE(value):04o}"


def staged_mode(value: os.stat_result, *, cache: bool) -> str:
    if stat.S_ISDIR(value.st_mode):
        return "0700"
    if cache:
        return "0600"
    return "0555" if stat.S_IMODE(value.st_mode) & 0o111 else "0444"


def digest_tree(path: Path, *, cache: bool, root: bool = True) -> OrderedDict[str, object]:
    value = path.stat(follow_symlinks=False)
    if stat.S_ISLNK(value.st_mode) or not (
        stat.S_ISREG(value.st_mode) or stat.S_ISDIR(value.st_mode)
    ):
        raise RuntimeError(f"unsupported manifest input: {path}")
    fields: list[tuple[str, object]] = []
    if not root:
        fields.append(("name", path.name))
    kind = "dir" if stat.S_ISDIR(value.st_mode) else "file"
    fields.extend(
        [
            ("kind", kind),
            ("mode", mode_string(value.st_mode)),
            ("staged_mode", staged_mode(value, cache=cache)),
            ("size", 0 if kind == "dir" else value.st_size),
            ("sha256", "0" * 64),
            ("entries", []),
        ]
    )
    node: OrderedDict[str, object] = OrderedDict(fields)
    if kind == "file":
        hasher = hashlib.sha256()
        with path.open("rb") as source:
            while True:
                block = source.read(1024 * 1024)
                if not block:
                    break
                hasher.update(block)
        node["sha256"] = hasher.hexdigest()
        return node
    entries = []
    for child_name in sorted(os.listdir(path), key=lambda name: os.fsencode(name)):
        if child_name in (".", "..") or "/" in child_name or "\x00" in child_name:
            raise RuntimeError(f"invalid manifest component: {child_name!r}")
        entries.append(digest_tree(path / child_name, cache=cache, root=False))
    node["entries"] = entries
    node["sha256"] = structural_digest(node)
    return node


def probe_arguments(name: str, path: str) -> list[str]:
    if name in ("sh", "bash"):
        return [path, "-c", "exit 0"]
    if name == "python3":
        return [path, "-I", "-B", "-c", "pass"]
    if name == "mount-guard":
        return [path, "--version"]
    return [path, "--version"]


def tool_record(name: str, root: Path) -> OrderedDict[str, object]:
    path = root / name
    value = path.stat(follow_symlinks=False)
    if not stat.S_ISREG(value.st_mode) or stat.S_IMODE(value.st_mode) != 0o755:
        raise RuntimeError(f"tool is not a regular 0755 file: {path}")
    arguments = probe_arguments(name, str(path))
    try:
        result = subprocess.run(
            arguments,
            env={"PATH": "/usr/bin:/bin", "LC_ALL": "C", "HOME": "/nonexistent"},
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise RuntimeError(f"tool probe failed: {name}") from error
    if result.returncode != 0:
        raise RuntimeError(f"tool probe returned {result.returncode}: {name}")
    if len(result.stdout) > MAX_PROBE_BYTES or len(result.stderr) > MAX_PROBE_BYTES:
        raise RuntimeError(f"tool probe output exceeds its bound: {name}")
    return OrderedDict(
        [
            ("name", name),
            ("path", str(path)),
            ("namespace_path", f"/tools/{name}"),
            ("mode", "0755"),
            ("sha256", sha256_hex(path.read_bytes())),
            ("argv", arguments),
            ("stdout", result.stdout.hex()),
            ("stderr", result.stderr.hex()),
        ]
    )


def runtime_record(source: Path, target: str) -> OrderedDict[str, object]:
    tree = digest_tree(source, cache=False)
    kind = "tree" if tree["kind"] == "dir" else "file"
    return OrderedDict(
        [
            ("source", str(source)),
            ("target", target),
            ("kind", kind),
            ("manifest", tree),
            ("manifest_sha256", serialized_digest(tree)),
        ]
    )


def empty_cache_manifest(cache_root: Path) -> OrderedDict[str, object]:
    tree = digest_tree(cache_root, cache=True)
    return OrderedDict(
        [
            ("schema_version", 2),
            ("allowed_prefixes", list(ALLOWED_CACHE_PREFIXES)),
            ("root", tree),
            ("entry_count", 0),
            ("total_size", 0),
        ]
    )


def parse_runtime(value: str) -> tuple[Path, str]:
    if "=" not in value:
        raise argparse.ArgumentTypeError("runtime binding must be SOURCE=TARGET")
    source, target = value.split("=", 1)
    source_path = Path(source)
    if not source_path.is_absolute() or not target.startswith("/"):
        raise argparse.ArgumentTypeError("runtime source and target must be absolute")
    return source_path, target


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--bootstrap", required=True, type=Path)
    parser.add_argument("--tool-root", required=True, type=Path)
    parser.add_argument("--runtime", action="append", default=[], type=parse_runtime)
    parser.add_argument("--cache-root", required=True, type=Path)
    parser.add_argument("--cache-manifest", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    arguments = parser.parse_args()

    cache = empty_cache_manifest(arguments.cache_root)
    validate_cache_manifest(cache)
    cache_raw = canonical_json_bytes(cache)
    arguments.cache_manifest.write_bytes(cache_raw)
    arguments.cache_manifest.chmod(0o444)

    manifest = OrderedDict(
        [
            ("schema_version", 2),
            (
                "controller",
                OrderedDict([("path", "scripts/fresh-align-compiler"), ("api", 1)]),
            ),
            (
                "bootstrap",
                OrderedDict(
                    [
                        ("path", "/usr/local/libexec/align-llm/fresh-bootstrap"),
                        ("sha256", sha256_hex(arguments.bootstrap.read_bytes())),
                        ("api", 1),
                    ]
                ),
            ),
            (
                "platform",
                OrderedDict(
                    [
                        ("os", "linux"),
                        ("architecture", "x86_64"),
                        ("kernel_minimum", "6.8"),
                        ("python_minimum", "3.12"),
                        ("make_minimum", "4.3"),
                    ]
                ),
            ),
            (
                "tools",
                [tool_record(name, arguments.tool_root) for name in TOOL_INVENTORY],
            ),
            (
                "runtime_bindings",
                [runtime_record(source, target) for source, target in arguments.runtime],
            ),
            (
                "cargo_cache",
                OrderedDict(
                    [
                        ("root", str(arguments.cache_root)),
                        ("manifest", str(arguments.cache_manifest)),
                        ("manifest_sha256", sha256_hex(cache_raw)),
                        ("entry_count", 0),
                    ]
                ),
            ),
        ]
    )
    validate_manifest(manifest)
    arguments.output.write_bytes(canonical_json_bytes(manifest))
    arguments.output.chmod(0o444)
    print(sha256_hex(arguments.output.read_bytes()))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
