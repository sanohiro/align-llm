#!/usr/bin/env python3
"""Own retained execution bindings and fail-closed independent acceptance admission."""
import copy
import pathlib
import sys
import tempfile
from gpu_backend_recipe import RecipeError, canonical
from gpu_independent_acceptance import (process, process_ok, replay_process, write_directory,
    digest, verify_build, file_inventory, write, replay, json_file, validate_timings, execution_limit)
from gpu_qualification_deadline import Deadline
import time
from types import SimpleNamespace


def rejects(call):
    try:
        call()
    except (RecipeError, OSError, ValueError, KeyError, TypeError):
        return
    raise AssertionError('malformed acceptance evidence was accepted')


for version, seconds in ((1, 1800), (2, 2400)):
    ceiling = seconds * 1_000_000_000
    assert execution_limit(version) == ceiling
    timing = {'schema_version': version, 'elapsed_ns': ceiling,
              'references': [{'process': {'elapsed_ns': ceiling // 2}}],
              'cases': [{'process': {'elapsed_ns': ceiling // 2}}]}
    assert validate_timings(timing) == ceiling
    rejects(lambda: validate_timings(dict(timing, elapsed_ns=ceiling + 1)))
    rejects(lambda: validate_timings(dict(timing, elapsed_ns=ceiling - 1)))
    for invalid in (True, -1, ceiling + 1, '1'):
        changed = copy.deepcopy(timing)
        changed['cases'][0]['process']['elapsed_ns'] = invalid
        rejects(lambda: validate_timings(changed))
for version in (True, 0, 3, None, '2'):
    rejects(lambda: execution_limit(version))
late = {'schema_version': 2, 'elapsed_ns': 1800_000_000_001,
        'references': [], 'cases': []}
validate_timings(late)
rejects(lambda: validate_timings(dict(late, schema_version=1)))
rejects(lambda: validate_timings(dict(late, cases=[{}])))
rejects(lambda: validate_timings(dict(late, cases={})))

with tempfile.TemporaryDirectory(prefix='gpu-independent-acceptance-') as temporary:
    root = pathlib.Path(temporary).resolve()
    for name in ('home', 'tmp'):
        write_directory(root / name)
    executable = write(root / 'candidate', b'#!/bin/sh\nprintf "native-output\\n"\n')
    executable.chmod(0o700)
    geometry = write(root / 'geometry.json', b'{"schema_version":2}')
    assert json_file(geometry, framed=False) == {'schema_version': 2}
    rejects(lambda: json_file(geometry))
    request = write(root / 'input.json', b'{}\n')
    result = process(root, executable, request, 'candidate', 'case', Deadline(time.monotonic_ns() + 10_000_000_000))
    process_ok(result)
    replay_process(root, result, 'case', digest(executable), 'candidate', 'input.json')
    rejects(lambda: replay_process(root, result, 'case', '0' * 64, 'candidate', 'input.json'))
    request.write_bytes(b'{"changed":true}\n')
    rejects(lambda: replay_process(root, result, 'case', digest(executable), 'candidate', 'input.json'))
    request.write_bytes(b'{}\n')
    for key, value in (('descendants_after', 1), ('exit_code', 1), ('terminal', 'FAIL'), ('elapsed_ns', True)):
        altered = copy.deepcopy(result)
        altered[key] = value
        rejects(lambda: replay_process(root, altered, 'case', digest(executable), 'candidate', 'input.json'))
    fault = canonical({'schema_version': 1, 'artifact_kind': 'GPU_RUNTIME_CASE_FAILURE',
        'phase': 'production', 'category': 'MEMORY_BUDGET', 'stage': 'plan',
        'stream_nonfinite_count': 0, 'stream_bytes': 24, 'stream_records': 0})
    failed = dict(result, terminal='FAIL', exit_code=1)
    plan = SimpleNamespace(traversal=SimpleNamespace(scalar_count=10, maximum_bytes=100, frame_count=5))
    try:
        process_ok(failed, output=fault, plan=plan)
    except RecipeError as error:
        assert str(error) == 'native MEMORY_BUDGET/plan refused acceptance'
    else:
        raise AssertionError('native first fault was discarded')
    (root / 'case/stdout').write_bytes(b'substituted\n')
    rejects(lambda: replay_process(root, result, 'case', digest(executable), 'candidate', 'input.json'))
    link = root / 'linked'
    link.symlink_to(executable)
    rejects(lambda: file_inventory(root))
    link.unlink()
    build = write_directory(root / 'build')
    write(build / 'build.json', canonical({'source_commit': '1' * 40, 'source_dirty': True,
        'source_files': {'src/main.align': '1' * 64}, 'align_revision': '1' * 40,
        'compiler_sha256': '1' * 64, 'bundle_id': '1' * 64,
        'executables': {'runtime_case': '1' * 64, 'runtime_immediate_eog_smoke': '1' * 64},
        'libraries': {'a': '1' * 64, 'b': '1' * 64, 'c': '1' * 64}, 'commands': [['build']]}))
    rejects(lambda: verify_build(build, True))
    write(root / 'result.json', canonical({'status': 'PASS'}))
    rejects(lambda: replay(root))
print('GPU independent acceptance owner: PASS (real process, executable/input/log bindings, cleanup, dirty build, incomplete result, schema-bound watchdog and child time totals)')
