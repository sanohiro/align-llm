FULL_CACHE_BYTES_FETCHED = previous.FULL_CACHE_BYTES_FETCHED
REPETITIONS = previous.REPETITIONS
CEILING_SECONDS = previous.CEILING_SECONDS
BASELINE_VALUES_NS = previous.BASELINE_VALUES_NS
BASELINE_MEDIAN_NS = previous.BASELINE_MEDIAN_NS
FLOOR_PPM = previous.FLOOR_PPM
FLOOR_NS = previous.FLOOR_NS


def unique_paths(paths: tuple[Path, ...]) -> tuple[Path, ...]:
    result: list[Path] = []
    for path in paths:
        if path not in result:
            result.append(path)
    return tuple(result)


