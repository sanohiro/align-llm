PREDECESSOR_LOADER = SourceFileLoader(
    "olmoe_attention_operation_for_attention_core_diagnosis", str(PREDECESSOR_PATH)
)
PREDECESSOR_SPEC = importlib.util.spec_from_loader(
    PREDECESSOR_LOADER.name, PREDECESSOR_LOADER
)
if PREDECESSOR_SPEC is None or PREDECESSOR_SPEC.loader is None:
    raise RuntimeError("cannot load the attention operation owner")
previous = importlib.util.module_from_spec(PREDECESSOR_SPEC)
sys.modules[PREDECESSOR_LOADER.name] = previous
PREDECESSOR_SPEC.loader.exec_module(previous)

base = previous.base
diagnosis = previous.diagnosis
owner = previous.owner
transfer = previous.transfer
# Item 72 -> item 71 -> item 68 -> shared decode-compute owner.
compute = previous.previous.previous.compute
intervention_record = previous.previous.intervention_record
BASELINE_KEYS = previous.previous.BASELINE_KEYS

ARTIFACT_KIND = "R8_OLMOE_ATTENTION_CORE_DIAGNOSIS"
MODEL_BYTES = previous.MODEL_BYTES
MODEL_SHA256 = previous.MODEL_SHA256
SERVER_BUILD = previous.SERVER_BUILD
BUDGET = previous.BUDGET
SEED = previous.SEED
FULL_TOKENS = previous.FULL_TOKENS
TEMPERATURE_MICROS = previous.TEMPERATURE_MICROS
