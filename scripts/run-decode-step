#!/usr/bin/env bash

set -euo pipefail

# R6-DECODE-KV-STEP1 and R6-STEP-N named focused qualification
# (`docs/specs/r6-decode-kv-step1.md` section 5 and `docs/specs/r6-step-n.md` section 5).
# **Opt-in and capable-only.** It is in neither HOSTED_CHECK_TARGETS nor CAPABLE_ONLY_CHECK_TARGETS
# and in no aggregate, exactly as `model-forward-qualification` is not.
#
#   ALIGN_LLM_GGML_INCLUDE          directory holding ggml.h, ggml-alloc.h, ggml-backend.h
#   ALIGN_LLM_GGML_LIB              directory holding libggml and libggml-base
#   ALIGN_LLM_GGUF_MODEL            the dense Qwen2 GGUF this step is read from
#   ALIGN_LLM_LLAMA_EVAL_CALLBACK   path to `llama-eval-callback`, R2C-patched
#   ALIGN_LLM_LLAMA_DEBUG           path to `llama-debug`
#   ALIGN_LLM_DECODE_STEP_TMPDIR    where the pack is written; defaults to TMPDIR
#   ALIGN_LLM_DECODE_STEPS          the step count `N`; defaults to 16
#   ALIGN_LLM_KV_PERSIST_PROMPTS    how many prompts get R6-KV-PERSIST's save/load leg; defaults to
#                                   all four. The documented cost fallback is, in order,
#                                   `ALIGN_LLM_DECODE_STEPS=8` and then
#                                   `ALIGN_LLM_KV_PERSIST_PROMPTS=2`
#
# When any is unset, or the model or either instrument is absent, or `numpy` is unavailable, or the
# free space under the scratch root is under the pack's size plus 2 GiB, it prints one explicit N/A
# line naming the missing input and exits 0. It never skips silently.
#
# **`N` and its documented fallback.** `DECODE_STEPS` below is the one constant. R6-STEP-N section 6
# risk 1 estimates the whole run at roughly 670 s of the 1800 s cap, with pack-read bandwidth the
# dominant uncertainty; if a host measures more than about 900 s, set `ALIGN_LLM_DECODE_STEPS=8`,
# which halves every term. The fallback changes what is measured and not what is asserted: section
# 3.5's rule is stated in terms of `N`, and `k in {1, ceil(N/2), N}` is three checkpoints at either
# value.
#
# **The sampler is pinned and this is not optional.** Section 3.1 measured it: two runs of
# `llama-eval-callback -n 1` with default sampling produced byte-identical prefill graphs and
# **different decode graphs**, because a different token was sampled — they diverge at the decode
# graph's very first node. With `--temp 0 -s 0` two consecutive runs were byte-identical over both
# graphs, and the decoded token is then the prefill's own argmax, which is what the arm derives
# rather than accepts as an operand.
#
# **Instrument provenance is load-bearing and this was found the hard way.** Section 3.1 measured
# the same llama.cpp commit built two ways producing two different 608,256-byte logits blobs. The
# qualification therefore uses only the instruments the environment names, and reports the build
# line each one printed so a later disagreement names its cause.
#
# It packs the real model into a temporary directory **outside the work tree**, derives the geometry
# with `main --model-ir`, and for each of four prompts captures both instrument outputs, checks that
# the transcript really holds `N + 1` graphs, runs `ggml-spike --decode-step` three times, and
# asserts section 3.5's rule. Everything it writes is removed on every exit path including a signal.
#
# **Gate G, the thing this capability is named for.** The transcript does not print the sampled token
# and `result_output`'s argmax is not derivable from six of 152,064 printed values (R6-STEP-N section
# 3.1 measured both). What it does print is graph `j`'s first node,
# `embd = GET_ROWS(token_embd.weight, [d_{j-1}])` — a **copy** of a vocabulary row, with no
# arithmetic — so if this arm's `d_k` is llama.cpp's, those printed bytes are equal. Section 3.2
# turns that into an id equality by measuring, over the whole vocabulary, how many rows share a
# printed fingerprint; the measurement runs here, once, before the gate is claimed, and the run
# refuses any step whose decoded id is a member of a colliding class.

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
compiler="${ALIGNC:-${root_dir}/scripts/alignc}"

na() {
  printf '%s\n' "decode step qualification: N/A $1"
  exit 0
}

[ -n "${ALIGN_LLM_GGML_INCLUDE:-}" ] || na "ALIGN_LLM_GGML_INCLUDE is unset"
[ -n "${ALIGN_LLM_GGML_LIB:-}" ] || na "ALIGN_LLM_GGML_LIB is unset"
[ -n "${ALIGN_LLM_GGUF_MODEL:-}" ] || na "ALIGN_LLM_GGUF_MODEL is unset"
[ -n "${ALIGN_LLM_LLAMA_EVAL_CALLBACK:-}" ] || na "ALIGN_LLM_LLAMA_EVAL_CALLBACK is unset"
[ -n "${ALIGN_LLM_LLAMA_DEBUG:-}" ] || na "ALIGN_LLM_LLAMA_DEBUG is unset"
[ -d "${ALIGN_LLM_GGML_INCLUDE}" ] || na "ALIGN_LLM_GGML_INCLUDE is not a directory"
[ -d "${ALIGN_LLM_GGML_LIB}" ] || na "ALIGN_LLM_GGML_LIB is not a directory"
[ -f "${ALIGN_LLM_GGUF_MODEL}" ] || na "ALIGN_LLM_GGUF_MODEL is not a file"
command -v "${ALIGN_LLM_LLAMA_EVAL_CALLBACK}" >/dev/null 2>&1 \
  || [ -x "${ALIGN_LLM_LLAMA_EVAL_CALLBACK}" ] \
  || na "ALIGN_LLM_LLAMA_EVAL_CALLBACK is not executable"
command -v "${ALIGN_LLM_LLAMA_DEBUG}" >/dev/null 2>&1 \
  || [ -x "${ALIGN_LLM_LLAMA_DEBUG}" ] \
  || na "ALIGN_LLM_LLAMA_DEBUG is not executable"
# `numpy` is a real prerequisite, so it is checked **here** with every other one and not discovered
# eleven minutes in. `scripts/decode_step_fingerprint.py` dequantizes 152,064 Q4_K rows to measure
# gate G's injectivity (section 3.2) and refuses to claim a gate it did not check; without this line
# that refusal arrives after the packing, four instrument runs, and twelve arm runs have already
# happened, which is a late exit 1 where the header promises one N/A line.
python3 -c 'import numpy' >/dev/null 2>&1 \
  || na "numpy is unavailable, so gate G's fingerprint injectivity cannot be measured"

model_bytes=$(wc -c < "${ALIGN_LLM_GGUF_MODEL}" | tr -d ' ')
scratch_root="${ALIGN_LLM_DECODE_STEP_TMPDIR:-${TMPDIR:-/tmp}}"
[ -d "${scratch_root}" ] || na "the scratch root ${scratch_root} does not exist"
free_kib=$(df -Pk "${scratch_root}" | awk 'NR == 2 { print $4 }')
# R6-STEP-N section 6 risk 2, raised by R6-KV-PERSIST section 5.4. The pack plus **3 GiB**, not 2:
# at `-n 16` one transcript is roughly 16 MB and four prompts are roughly 64 MB, and the persistence
# leg adds four 29,970,432-byte containers plus two determinism duplicates plus a second `N = 16`
# transcript per prompt. The check runs **before the first byte is written**, not after a failure
# path is asked to be pleasant.
need_kib=$(( model_bytes / 1024 + 3145728 ))
if [ "${free_kib}" -lt "${need_kib}" ]; then
  na "free space under ${scratch_root} is ${free_kib} KiB, below the ${need_kib} KiB the pack needs"
fi

work_dir=$(mktemp -d "${scratch_root%/}/align-r6-XXXXXX")
shim_built=0
cleanup() {
  status=$?
  if [ "${shim_built}" = 1 ]; then
    ALIGN_LLM_GGML_FORCE= "${root_dir}/scripts/build-ggml-shim" >/dev/null 2>&1 || true
  fi
  rm -rf "${work_dir}"
  exit "${status}"
}
trap cleanup EXIT HUP INT TERM

# Section 2.1's declared width. It is the width llama.cpp's own decode graph reduces over on this
# model at `-c 512` (section 3.1 measured `cache_k_l0 (view) (permuted) = {128, 256, 4}`), and the
# arm validates the transcript's `kq` `ne0` against it rather than reading it from the transcript.
KV_WIDTH=256

# R6-STEP-N section 5. `N`, and the only constant a host is expected to move.
DECODE_STEPS="${ALIGN_LLM_DECODE_STEPS:-16}"
case "${DECODE_STEPS}" in
  ''|*[!0-9]*) na "ALIGN_LLM_DECODE_STEPS=${DECODE_STEPS} is not a decimal step count" ;;
esac
if [ "${DECODE_STEPS}" -lt 1 ] || [ "${DECODE_STEPS}" -gt 64 ]; then
  na "ALIGN_LLM_DECODE_STEPS=${DECODE_STEPS} is outside 1..MAX_DECODE_STEPS (64)"
fi

# R6-KV-PERSIST section 5.4. The persistence leg re-runs the `N`-step loop once per prompt, so it is
# the dominant new cost and it has a documented two-step fallback: `ALIGN_LLM_DECODE_STEPS=8` halves
# every term first, and only then does this drop to two prompts, which costs one prompt's coverage
# of oracle Q and **no closure cell**.
PERSIST_PROMPTS="${ALIGN_LLM_KV_PERSIST_PROMPTS:-4}"
case "${PERSIST_PROMPTS}" in
  ''|*[!0-9]*) na "ALIGN_LLM_KV_PERSIST_PROMPTS=${PERSIST_PROMPTS} is not a decimal prompt count" ;;
esac

# The TTFT proxy's outer bound. It measures **process start to exit** around one whole invocation,
# so it includes `dyld`, the pack open, and the geometry parse on both sides -- which is the point:
# `timings.first_token_ns` is the arm's own interval and this is the one a caller would feel. Both
# are labelled diagnostic and **no rate, speedup, or per-token figure is derived from either**.
time_invocation() {
  destination="$1"
  shift
  python3 -c '
import subprocess
import sys
import time

destination = sys.argv[1]
started = time.monotonic_ns()
result = subprocess.run(sys.argv[2:], capture_output=True)
elapsed = time.monotonic_ns() - started
with open(destination, "a", encoding="utf-8") as handle:
    handle.write("%d\n" % elapsed)
sys.exit(result.returncode)
' "${destination}" "$@"
}

echo "decode step qualification: packing ${ALIGN_LLM_GGUF_MODEL} into ${work_dir}"
"${root_dir}/main" --pack "${ALIGN_LLM_GGUF_MODEL}" "${work_dir}/model.alignpack" \
  "${work_dir}/pack.json" >/dev/null
"${root_dir}/main" --model-ir "${ALIGN_LLM_GGUF_MODEL}" "${work_dir}/geometry.json" >/dev/null

shim_dir=$(ALIGN_LLM_GGML_FORCE= "${root_dir}/scripts/build-ggml-shim")
shim_built=1
(
  cd "${root_dir}"
  LIBRARY_PATH="${shim_dir}${LIBRARY_PATH:+:${LIBRARY_PATH}}" \
  DYLD_LIBRARY_PATH="${shim_dir}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}" \
  LD_LIBRARY_PATH="${shim_dir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
  "${compiler}" build src/ggml_spike.align >/dev/null
  mv -f ggml_spike ggml-spike
)
export DYLD_LIBRARY_PATH="${shim_dir}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}"
export LD_LIBRARY_PATH="${shim_dir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

# Four prompts, each short enough that its prefill fits `MAX_PREFILL_TOKENS`. The first is R5B's, so
# its prefill half is directly comparable with that qualification's recorded numbers.
PROMPTS=(
  "def add(a, b):"
  "class Foo:"
  "# TODO:"
  "int main("
)

document_root="${work_dir}/documents"
mkdir -p "${document_root}"
# R6-KV-PERSIST's own documents live apart from the loop's, so the analysis below can enumerate one
# set without filtering the other.
persist_root="${work_dir}/persist"
mkdir -p "${persist_root}"

index=0
for prompt in "${PROMPTS[@]}"; do
  index=$(( index + 1 ))
  case_dir="${work_dir}/case${index}"
  mkdir -p "${case_dir}/lg"
  echo "decode step qualification: prompt ${index} of ${#PROMPTS[@]}: ${prompt}"

  # `--temp 0 -s 0` is contractual (section 3.1). `-n N` makes the instrument emit exactly `N + 1`
  # graphs, and graph `k + 1` is the one this arm's step `k` is compared against.
  "${ALIGN_LLM_LLAMA_EVAL_CALLBACK}" -m "${ALIGN_LLM_GGUF_MODEL}" -p "${prompt}" \
    -n "${DECODE_STEPS}" -t 4 -ngl 0 -fa off -ctk f32 -ctv f32 -nr -c 512 --temp 0 -s 0 \
    > "${case_dir}/transcript.txt" 2> "${case_dir}/transcript.log"
  "${ALIGN_LLM_LLAMA_DEBUG}" -m "${ALIGN_LLM_GGUF_MODEL}" -p "${prompt}" \
    -n 1 -t 4 -ngl 0 -fa off -ctk f32 -ctv f32 -nr -c 512 \
    --save-logits --logits-output-dir "${case_dir}/lg" \
    > "${case_dir}/debug.log" 2>&1

  logits_bin=$(ls "${case_dir}"/lg/*.bin 2>/dev/null | grep -v -- '-tokens\.bin$' | head -1 || true)
  tokens_bin=$(ls "${case_dir}"/lg/*-tokens.bin 2>/dev/null | head -1 || true)
  if [ -z "${logits_bin}" ] || [ -z "${tokens_bin}" ]; then
    echo "decode step qualification: FAIL llama-debug exited 0 and wrote no logits or token file" \
      "under ${case_dir}/lg" >&2
    tail -20 "${case_dir}/debug.log" >&2 || true
    exit 1
  fi

  tokens=$(python3 - "${tokens_bin}" "${DECODE_STEPS}" <<'PY'
import struct
import sys

with open(sys.argv[1], "rb") as handle:
    raw = handle.read()
steps = int(sys.argv[2])
ids = list(struct.unpack("<%di" % (len(raw) // 4), raw))
# `T + N <= MAX_PREFILL_TOKENS` (32), because oracle C' runs `--model-forward` at `TOKENS,d_1..d_N`
# and that arm refuses more than the cap. R6-STEP-N section 2.5 is why the cap is 32 and not 8.
if not ids or len(ids) + steps > 32:
    raise SystemExit("decode step qualification: FAIL %d prompt tokens plus %d steps exceeds "
                     "MAX_PREFILL_TOKENS (32)" % (len(ids), steps))
print(",".join(str(i) for i in ids))
PY
)
  echo "decode step qualification:   ${prompt} tokenizes to ${tokens}"
  if [ "${index}" = 1 ]; then
    scaling_tokens="${tokens}"
  fi

  # R6-STEP-N section 3.5, rule 7. The transcript must hold exactly `N + 1` graphs. Every graph this
  # instrument prints begins with an `embd` header, so counting that header counts graphs. Fewer
  # means llama.cpp stopped early at EOS (section 2.12), and this arm would still emit `N` steps: the
  # two runs would then differ in **length** rather than in arithmetic, so the prompt is refused by
  # name rather than compared over a shorter run.
  want_graphs=$(( DECODE_STEPS + 1 ))
  graphs=$(grep -c 'common_debug_cb_eval:.* embd = ' "${case_dir}/transcript.txt" || true)
  if [ "${graphs}" != "${want_graphs}" ]; then
    echo "decode step qualification: FAIL prompt ${index} transcript holds ${graphs} graphs, not" \
      "${want_graphs} — llama.cpp reached EOS before step ${DECODE_STEPS}, or is" \
      "llama-eval-callback R2C-patched and was -n ${DECODE_STEPS} honoured?" >&2
    exit 1
  fi

  for repeat in 1 2 3; do
    "${root_dir}/ggml-spike" --decode-step "${work_dir}/model.alignpack" \
      "${work_dir}/geometry.json" "${tokens}" \
      "${document_root}/case${index}-run${repeat}.json" "${ALIGN_LLM_GGUF_MODEL}" \
      "${case_dir}/transcript.txt" "${KV_WIDTH}" "${logits_bin}" "${DECODE_STEPS}" \
      > "${case_dir}/summary${repeat}.txt" || {
        echo "decode step qualification: FAIL prompt ${index} run ${repeat} exited non-zero" >&2
        cat "${case_dir}/summary${repeat}.txt" >&2 || true
        python3 -c "
import json, sys
d = json.load(open(sys.argv[1]))
print(d['status'], d['error_code'], d['error_detail'], file=sys.stderr)
" "${document_root}/case${index}-run${repeat}.json" >&2 || true
        exit 1
      }
  done

  # Oracle C'. Our own single-shot `T+k` prefill against our own step `k`, at three checkpoints
  # rather than at every step: each one is a whole `--model-forward`, thirty graphs and a full pass
  # over the 4.7 GB weight set, so sixteen of them per prompt would cost more than the run.
  #
  # The three bound three regimes rather than sample uniformly: `k = 1` is the case R6 already
  # measured and the only one with a prior result to disagree with; `k = N` is the deepest
  # accumulation and where a drift would show first; `k = ceil(N/2)` catches a divergence that begins
  # mid-loop and would be invisible at both ends.
  #
  # R6 section 3.2 expected byte identity here to be a characterization at best, because llama.cpp's
  # own two paths differ by up to 0.17 in activations. **Measured, it is byte identity**, because
  # every operand this arm hands ggml is a contiguous F32 tensor, so its decode path and its prefill
  # path take the same kernel — a reason that does not weaken with `k`.
  checkpoints=$(python3 -c "
import sys
n = int(sys.argv[1])
print(' '.join(str(k) for k in sorted({1, -(-n // 2), n})))
" "${DECODE_STEPS}")
  for k in ${checkpoints}; do
    prefix=$(python3 -c "
import json, sys
ids = json.load(open(sys.argv[1]))['decode']['token_ids'][:int(sys.argv[2])]
print(','.join(str(i) for i in ids))
" "${document_root}/case${index}-run1.json" "${k}")
    "${root_dir}/ggml-spike" --model-forward "${work_dir}/model.alignpack" \
      "${work_dir}/geometry.json" "${tokens},${prefix}" \
      "${document_root}/case${index}-single${k}.json" "${ALIGN_LLM_GGUF_MODEL}" - "${KV_WIDTH}" \
      > "${case_dir}/single${k}.txt" || true
  done

  # -------------------------------------------------------------------------------------------
  # R6-KV-PERSIST section 5.4. Save, then a **separate process** load, then the comparison.
  # -------------------------------------------------------------------------------------------
  if [ "${index}" -le "${PERSIST_PROMPTS}" ]; then
    kv="${case_dir}/plane.akvp"
    kv_second="${case_dir}/plane-second.akvp"
    kv_perturbed="${case_dir}/plane-perturbed.akvp"
    echo "decode step qualification:   prompt ${index} save -> ${KV_WIDTH}-column container"
    # Step 1. An ordinary run that also writes. A save that fails at or after W1 removes its own
    # partial file, and the runner removes it again here rather than trusting that it did.
    "${root_dir}/ggml-spike" --decode-step "${work_dir}/model.alignpack" \
      "${work_dir}/geometry.json" "${tokens}" "${persist_root}/case${index}-save.json" \
      "${ALIGN_LLM_GGUF_MODEL}" "${case_dir}/transcript.txt" "${KV_WIDTH}" "${logits_bin}" \
      "${DECODE_STEPS}" "${kv}" - > "${case_dir}/save.txt" || {
        echo "decode step qualification: FAIL prompt ${index} save run exited non-zero" >&2
        rm -f "${kv}"
        exit 1
      }
    # Step 2. The independent reader, driven as a subprocess and never imported, on the file the arm
    # just wrote -- from the specification rather than from `src/kv_plane.align`.
    python3 "${root_dir}/scripts/kv_plane_reader.py" --plane "${kv}" \
      --pack "${work_dir}/model.alignpack" --geometry "${work_dir}/geometry.json" \
      --tokens "${tokens}" > "${case_dir}/reader.txt" || {
        echo "decode step qualification: FAIL prompt ${index} independent reader refused the" \
          "container" >&2
        exit 1
      }
    # Step 3. `du` against the header's own `total_bytes`: the assertion that makes section 2.3's
    # explicit padding real rather than a sparse file that happens to read back.
    du -k "${kv}" | awk '{ print $1 }' > "${case_dir}/du.txt"
    # Step 4. A separate process, the same operands, and the two kv positions swapped.
    echo "decode step qualification:   prompt ${index} load <- container, ${DECODE_STEPS} steps"
    "${root_dir}/ggml-spike" --decode-step "${work_dir}/model.alignpack" \
      "${work_dir}/geometry.json" "${tokens}" "${persist_root}/case${index}-load.json" \
      "${ALIGN_LLM_GGUF_MODEL}" "${case_dir}/transcript.txt" "${KV_WIDTH}" "${logits_bin}" \
      "${DECODE_STEPS}" - "${kv}" > "${case_dir}/load.txt" || {
        echo "decode step qualification: FAIL prompt ${index} load run exited non-zero" >&2
        exit 1
      }
    # Steps 6 and 7. Determinism of the writer, by double write, then again under a perturbed
    # environment. This is alignpack's method and it is taken deliberately in place of a hex golden.
    "${root_dir}/ggml-spike" --decode-step "${work_dir}/model.alignpack" \
      "${work_dir}/geometry.json" "${tokens}" "${persist_root}/case${index}-save2.json" \
      "${ALIGN_LLM_GGUF_MODEL}" - "${KV_WIDTH}" - "${DECODE_STEPS}" "${kv_second}" - \
      > "${case_dir}/save2.txt" || {
        echo "decode step qualification: FAIL prompt ${index} second save exited non-zero" >&2
        rm -f "${kv_second}"
        exit 1
      }
    TZ=Pacific/Kiritimati LANG=de_DE.UTF-8 LC_ALL=de_DE.UTF-8 SOURCE_DATE_EPOCH=1 PWD=/ \
      "${root_dir}/ggml-spike" --decode-step "${work_dir}/model.alignpack" \
      "${work_dir}/geometry.json" "${tokens}" "${persist_root}/case${index}-save3.json" \
      "${ALIGN_LLM_GGUF_MODEL}" - "${KV_WIDTH}" - "${DECODE_STEPS}" "${kv_perturbed}" - \
      > "${case_dir}/save3.txt" || {
        echo "decode step qualification: FAIL prompt ${index} perturbed save exited non-zero" >&2
        rm -f "${kv_perturbed}"
        exit 1
      }
    for container in "${kv}" "${kv_second}" "${kv_perturbed}"; do
      python3 -c "
import hashlib, sys
with open(sys.argv[1], 'rb') as handle:
    print(hashlib.sha256(handle.read()).hexdigest())
" "${container}" >> "${case_dir}/container-digests.txt"
    done
    # Step 8. The TTFT proxy, three runs each direction at `STEPS = 1`, with no transcript and no
    # logits blob. Reported as a range, never as a rate.
    kv_ttft="${case_dir}/ttft.akvp"
    for repeat in 1 2 3; do
      rm -f "${kv_ttft}"
      time_invocation "${case_dir}/ttft-save-wall.txt" \
        "${root_dir}/ggml-spike" --decode-step "${work_dir}/model.alignpack" \
        "${work_dir}/geometry.json" "${tokens}" "${persist_root}/case${index}-ttft-save.json" \
        "${ALIGN_LLM_GGUF_MODEL}" - "${KV_WIDTH}" - 1 "${kv_ttft}" - > /dev/null || {
          echo "decode step qualification: FAIL prompt ${index} TTFT save ${repeat} exited" \
            "non-zero" >&2
          rm -f "${kv_ttft}"
          exit 1
        }
      cp "${persist_root}/case${index}-ttft-save.json" \
        "${persist_root}/case${index}-ttft-save-${repeat}.json"
      time_invocation "${case_dir}/ttft-load-wall.txt" \
        "${root_dir}/ggml-spike" --decode-step "${work_dir}/model.alignpack" \
        "${work_dir}/geometry.json" "${tokens}" "${persist_root}/case${index}-ttft-load.json" \
        "${ALIGN_LLM_GGUF_MODEL}" - "${KV_WIDTH}" - 1 - "${kv_ttft}" > /dev/null || {
          echo "decode step qualification: FAIL prompt ${index} TTFT load ${repeat} exited" \
            "non-zero" >&2
          exit 1
        }
      cp "${persist_root}/case${index}-ttft-load.json" \
        "${persist_root}/case${index}-ttft-load-${repeat}.json"
    done
    rm -f "${kv_ttft}"
    # The two determinism duplicates have served their purpose; the load path's own container stays
    # until the analysis has read its size.
    rm -f "${kv_second}" "${kv_perturbed}"
  fi
done

# R6-STEP-N section 2.10's scaling row, on the first prompt only. It is the measurement that
# motivates resident weights — the loop re-reads the whole pack once per step — and it is
# characterization: **no TTFT or tokens-per-second claim is made anywhere in this qualification.**
scaling_dir="${work_dir}/scaling"
mkdir -p "${scaling_dir}"
for n in 1 4 "${DECODE_STEPS}"; do
  echo "decode step qualification: scaling run at N=${n} on prompt 1"
  "${root_dir}/ggml-spike" --decode-step "${work_dir}/model.alignpack" \
    "${work_dir}/geometry.json" "${scaling_tokens}" \
    "${scaling_dir}/n${n}.json" "${ALIGN_LLM_GGUF_MODEL}" - "${KV_WIDTH}" - "${n}" \
    > "${scaling_dir}/n${n}.txt" || {
      echo "decode step qualification: FAIL the scaling run at N=${n} exited non-zero" >&2
      exit 1
    }
done

# Gate G's load-bearing measurement (section 3.2), taken **once** and before the gate is claimed. It
# is over `token_embd.weight` of the source GGUF rather than of the pack, and that is equivalent
# rather than looser: every member the arm reads is compared byte for byte against this same file at
# its own `source_offset` before its graph runs, and `reference.verdict` is asserted below.
#
# It is handed every id any prompt decoded, so the same pass also reports those rows' own
# fingerprints and the gate can compare them against the transcript without a second walk over
# 4.7 GB of weights.
decoded_ids=$(python3 -c "
import glob, json, os, sys
ids = set()
for name in sorted(glob.glob(os.path.join(sys.argv[1], '*-run1.json'))):
    with open(name, 'r', encoding='utf-8') as handle:
        ids.update(json.load(handle)['decode']['token_ids'])
print(','.join(str(i) for i in sorted(ids)))
" "${document_root}")

echo "decode step qualification: measuring embd fingerprint injectivity over the whole vocabulary"
python3 "${root_dir}/scripts/decode_step_fingerprint.py" "${ALIGN_LLM_GGUF_MODEL}" \
  "${work_dir}/fingerprints.json" --ids "${decoded_ids}" || {
    echo "decode step qualification: FAIL the fingerprint measurement did not complete" >&2
    exit 1
  }

python3 - "${document_root}" "${KV_WIDTH}" "${DECODE_STEPS}" "${work_dir}/fingerprints.json" \
  "${work_dir}" "${persist_root}" "${PERSIST_PROMPTS}" <<'PY'
import hashlib
import json
import os
import re
import sys

document_root, kv_width, steps = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
fingerprint_path, work_dir = sys.argv[4], sys.argv[5]
persist_root, persist_prompts = sys.argv[6], int(sys.argv[7])
failures = []
rows = []

with open(fingerprint_path, "r", encoding="utf-8") as handle:
    measurement = json.load(handle)
COLLIDING = set(measurement["colliding_ids"])
FINGERPRINTS = {int(key): value for key, value in measurement["fingerprints"].items()}
CHECKPOINTS = sorted({1, -(-steps // 2), steps})


def load(name):
    with open(os.path.join(document_root, name), "r", encoding="utf-8") as handle:
        return json.load(handle)


def normalize(document):
    copy = json.loads(json.dumps(document))
    for key in copy["timings"]:
        copy["timings"][key] = 0
    for row in copy["schedule"]:
        row["pread_ns"] = 0
        row["compute_ns"] = 0
    copy["head"]["pread_ns"] = 0
    copy["head"]["compute_ns"] = 0
    copy["decode"]["compute_ns"] = 0
    # R6-STEP-N section 2.9. A per-step timing array is the exact place a determinism check goes
    # quietly green on nothing, so every row's own `compute_ns` is zeroed as well as the sum.
    for row in copy["steps"]:
        row["compute_ns"] = 0
    copy["plane"]["readback_ns"] = 0
    copy["plane"]["upload_ns"] = 0
    # R6-KV-PERSIST section 2.9: two single intervals and one labelled diagnostic, all wall clock.
    copy["kv"]["write_ns"] = 0
    copy["kv"]["read_ns"] = 0
    return json.dumps(copy, sort_keys=True, separators=(",", ":"))


# R6-KV-PERSIST section 3, oracle Q. `normalize` plus the keys that are **counts of work the load
# path legitimately did not do** -- a prefill pack read, a prefill head graph, a prefill-time source
# comparison, a prefill window fill -- and nothing else. What stays inside the comparison is the
# point: `decode` in full including `token_ids`, every object of `steps[]` including each step's
# `sha256`, `argmax`, `n_past`, `plane_column_written`, and complete `oracle` sub-object;
# `plane.columns_written`, `roundtrip_verdict`, `roundtrip_bytes_compared`, and every
# `first_mismatch_*`; `output` and `oracle_logits`; `oracle_decode` in full; and `model`,
# `selection`, `head`'s digests, and `abi`.
PERSIST_EXCLUDED_BLOCKS = ("kv", "graph", "schedule", "timings", "lifetime", "reference")
PERSIST_EXCLUDED_FIELDS = (
    ("plane", "source"), ("plane", "readback_ns"), ("plane", "upload_ns"),
    ("head", "node_count"), ("head", "pread_ns"), ("head", "compute_ns"),
    ("pack", "reader_pread_count"), ("pack", "reader_bytes_read"),
    ("window", "reuse_count"), ("window", "member_placements"),
)


def normalize_persist(document):
    copy = json.loads(normalize(document))
    for block in PERSIST_EXCLUDED_BLOCKS:
        copy.pop(block, None)
    for block, field in PERSIST_EXCLUDED_FIELDS:
        copy[block].pop(field, None)
    return json.dumps(copy, sort_keys=True, separators=(",", ":"))


def median_and_spread(values):
    ordered = sorted(values)
    middle = ordered[len(ordered) // 2]
    return middle, ordered[0], ordered[-1]


# ---------------------------------------------------------------------------------------------
# Gate G's second leg: the transcript's own `embd` fingerprints, graph by graph.
#
# `common_debug_print_tensor` prints, for a `{n_embd, 1, 1, 1}` f32 tensor at a print limit of 3,
# one bracketed row of six `%12.4f` values with a `...` between the halves, then `sum = %f`. The
# parse below reads exactly that and nothing else: the first `embd` node of each graph, in order.
# ---------------------------------------------------------------------------------------------

EMBD = re.compile(r"^common_debug_cb_eval:\s+embd = ")
NUMBER = re.compile(r"^\s*-?\d+\.\d+\s*$")


def transcript_embeddings(path):
    """One `(printed, sum)` pair per graph, in graph order."""
    found = []
    pending = None
    with open(path, "r", encoding="utf-8", errors="replace") as handle:
        for line in handle:
            line = line.rstrip("\n")
            if EMBD.match(line):
                pending = {"printed": None, "sum": None}
                found.append(pending)
                continue
            if pending is None or pending["sum"] is not None:
                continue
            stripped = line.strip()
            if pending["printed"] is None and stripped.startswith("[") \
                    and stripped.endswith("],") and "..." in stripped:
                pieces = [piece for piece in stripped.strip("[],").split(",")
                          if NUMBER.match(piece)]
                if len(pieces) == 6:
                    pending["printed"] = ["%12.4f" % float(piece) for piece in pieces]
            elif stripped.startswith("sum = "):
                pending["sum"] = "%f" % float(stripped[len("sum = "):])
    return found


def gate_g(case, document, transcript_path):
    """R6-STEP-N section 3.5 rule 1. Returns a one-line verdict for the report."""
    decoded = document["decode"]["token_ids"]
    if len(decoded) != steps:
        failures.append("%s: gate G has %d ids, not %d" % (case, len(decoded), steps))
        return "FAIL (wrong length)"
    # G1 is inherited and exact: `d_1` is the argmax of a vector this arm proved byte-identical to
    # `llama-debug --save-logits` on the same prompt at the same width, so it is llama.cpp's own
    # argmax with no tolerance. `oracle_logits` is asserted separately below.
    if decoded[0] != document["output"]["argmax"]:
        failures.append("%s: gate G1 -- d_1 is %d and the prefill's argmax is %d"
                        % (case, decoded[0], document["output"]["argmax"]))
        return "FAIL (G1)"
    graphs = transcript_embeddings(transcript_path)
    if len(graphs) != steps + 1:
        failures.append("%s: gate G read %d embd blocks, not %d" % (case, len(graphs), steps + 1))
        return "FAIL (graph count)"
    sums_agree = True
    for index, identifier in enumerate(decoded):
        # The measured escape hatch. A colliding id is one whose printed row is shared with another
        # vocabulary row, so equal printed bytes would not prove equal ids; the run refuses rather
        # than reporting a gate it cannot support.
        if identifier in COLLIDING:
            failures.append("%s: gate G2 -- step %d decoded id %d, which shares its printed "
                            "fingerprint with %d other vocabulary rows, so equal printed bytes do "
                            "not prove equal ids (section 3.2's fallback G3 applies)"
                            % (case, index + 1, identifier, len(COLLIDING) - 1))
            return "FAIL (collision)"
        ours = FINGERPRINTS.get(identifier)
        if ours is None:
            failures.append("%s: gate G2 -- no measured fingerprint for id %d"
                            % (case, identifier))
            return "FAIL (missing fingerprint)"
        theirs = graphs[index + 1]
        if theirs["printed"] is None:
            failures.append("%s: gate G2 -- transcript graph %d printed no embd row"
                            % (case, index + 2))
            return "FAIL (unparsed)"
        if theirs["printed"] != ours["printed"]:
            failures.append("%s: gate G2 -- step %d decoded id %d, whose embedding row prints "
                            "%r, and transcript graph %d printed %r"
                            % (case, index + 1, identifier, ours["printed"], index + 2,
                               theirs["printed"]))
            return "FAIL (step %d)" % (index + 1)
        if theirs["sum"] != ours["sum"]:
            sums_agree = False
    return "PASS (%d ids, sums %s)" % (steps, "agree" if sums_agree else "differ")


cases = sorted({name.split("-")[0] for name in os.listdir(document_root)
                if name.endswith(".json")})
for case in cases:
    runs = [load("%s-run%d.json" % (case, r)) for r in (1, 2, 3)]
    document = runs[0]
    # The status guard runs **before** any of the four objects is read. A run that stops at step 6
    # publishes the whole document shape with empty objects, but a run that cannot write a document
    # at all is a different failure and reading `document["plane"]` first would report it as a
    # `KeyError` traceback instead of as the arm's own code and detail.
    if document["status"] != "ok":
        failures.append("%s: %s %s" % (case, document["error_code"], document["error_detail"]))
        continue
    plane = document["plane"]
    decode = document["decode"]
    step_rows = document["steps"]
    oracle = document["oracle_decode"]
    logits = document["oracle_logits"]
    tokens_in = document["selection"]["token_count"]
    # Section 2.2's size arithmetic on this model at this width: 28 * 2 * 256 * 4 * 128 * 4.
    if plane["bytes"] != 29360128:
        failures.append("%s: plane is %d bytes, not 29,360,128" % (case, plane["bytes"]))
    if plane["layers"] != document["model"]["n_layer"]:
        failures.append("%s: the plane holds %d layers of %d"
                        % (case, plane["layers"], document["model"]["n_layer"]))
    # R6-STEP-N section 2.4: `T + N` columns on a complete run, grown in place one per step.
    if plane["columns_written"] != tokens_in + steps:
        failures.append("%s: the plane holds %d columns, not T + %d"
                        % (case, plane["columns_written"], steps))
    # Oracle B, cumulative and inclusive of each step's own newly written column.
    if plane["roundtrip_verdict"] != "IDENTICAL" or plane["roundtrip_bytes_compared"] <= 0:
        failures.append("%s: oracle B is %r over %d bytes"
                        % (case, plane["roundtrip_verdict"], plane["roundtrip_bytes_compared"]))
    if plane["first_mismatch_step"] != -1:
        failures.append("%s: a passing run named a mismatching step: %r" % (case, plane))
    # The loop's own shape, before any oracle reads it.
    if decode["steps_requested"] != steps or decode["steps_completed"] != steps \
            or len(step_rows) != steps or len(decode["token_ids"]) != steps:
        failures.append("%s: %d of %d steps completed with %d rows and %d ids"
                        % (case, decode["steps_completed"], decode["steps_requested"],
                           len(step_rows), len(decode["token_ids"])))
        continue
    if decode["token_ids"] != [row["token_id"] for row in step_rows]:
        failures.append("%s: token_ids and steps[].token_id disagree" % case)
    if decode["n_past_first"] != tokens_in or decode["n_past_last"] != tokens_in + steps - 1:
        failures.append("%s: n_past runs %d..%d, not %d..%d"
                        % (case, decode["n_past_first"], decode["n_past_last"], tokens_in,
                           tokens_in + steps - 1))
    digests = {row["sha256"] for row in step_rows}
    if len(digests) != steps or document["output"]["sha256"] in digests:
        failures.append("%s: two steps produced the same logits, or a step reproduced the "
                        "prefill's -- the loop is not advancing" % case)
    for index, row in enumerate(step_rows):
        if row["index"] != index + 1 or row["n_past"] != tokens_in + index \
                or row["plane_column_written"] != tokens_in + index:
            failures.append("%s: steps[%d] is at n_past %d writing column %d"
                            % (case, index, row["n_past"], row["plane_column_written"]))
        if index + 1 < steps and row["argmax"] != step_rows[index + 1]["token_id"]:
            failures.append("%s: steps[%d] produced %d and steps[%d] consumed %d -- the chain broke"
                            % (case, index, row["argmax"], index + 1,
                               step_rows[index + 1]["token_id"]))
        if row["nonfinite_count"] != 0 \
                or row["element_count"] != document["model"]["n_vocab"]:
            failures.append("%s: steps[%d] has %d logits, %d non-finite"
                            % (case, index, row["element_count"], row["nonfinite_count"]))
        # R6-STEP-N section 3.4's structural gate, at **every** step, unconditionally. None of it
        # can pass vacuously: a mis-aligned graph skip, a truncated transcript, a dropped layer, an
        # empty comparison, a width drift, and a widened tolerance each fail one of these.
        step_oracle = row["oracle"]
        if step_oracle["instrument_graph"] != index + 2:
            failures.append("%s: steps[%d] compared instrument graph %d, not %d"
                            % (case, index, step_oracle["instrument_graph"], index + 2))
        if step_oracle["nodes_matched"] != step_oracle["nodes_expected"]:
            failures.append("%s: steps[%d] matched %d of %d nodes"
                            % (case, index, step_oracle["nodes_matched"],
                               step_oracle["nodes_expected"]))
        if step_oracle["layers_matched"] != document["model"]["n_layer"]:
            failures.append("%s: steps[%d] matched %d layers"
                            % (case, index, step_oracle["layers_matched"]))
        if step_oracle["elements_compared"] <= 0:
            failures.append("%s: steps[%d] compared zero elements" % (case, index))
    if oracle["tolerance_ten_thousandths"] != 1:
        failures.append("%s: oracle A' ran at a tolerance of %d, not 1"
                        % (case, oracle["tolerance_ten_thousandths"]))
    if oracle["instrument_graph_first"] != 2 or oracle["instrument_graph_last"] != steps + 1 \
            or oracle["steps_compared"] != steps or oracle["instrument_kv_width"] != kv_width:
        failures.append("%s: oracle A' compared %d steps over graphs %d..%d at width %d"
                        % (case, oracle["steps_compared"], oracle["instrument_graph_first"],
                           oracle["instrument_graph_last"], oracle["instrument_kv_width"]))
    # The prefill half is R5B's contract, unchanged: byte identity against `llama-debug`'s blob at
    # the reconciliation width. It is also gate G1's whole evidence.
    if logits["verdict"] != "IDENTICAL" or not logits["byte_identical"]:
        failures.append("%s: the prefill logits are %r against llama-debug"
                        % (case, logits["verdict"]))
    if document["reference"]["verdict"] != "IDENTICAL":
        failures.append("%s: the pack does not match the source GGUF byte for byte: %r"
                        % (case, document["reference"]["verdict"]))
    if decode["slot_high_water"] != 66 or document["graph"]["slot_capacity"] != 128:
        failures.append("%s: slots %d/%d, not 66/128"
                        % (case, decode["slot_high_water"], document["graph"]["slot_capacity"]))
    if not document["abi"]["fp_contract_off"]:
        failures.append("%s: the shim was not built with -ffp-contract=off" % case)
    lifetime = document["lifetime"]
    if not lifetime["released_before_owner_scope_end"] \
            or lifetime["graph_balance_failures"] != 0:
        failures.append("%s: the teardown did not balance: %r" % (case, lifetime))
    for created, freed in (("ggml_buffers_created", "ggml_buffers_freed"),
                           ("contexts_created", "contexts_freed"),
                           ("backends_created", "backends_freed"),
                           ("gallocrs_created", "gallocrs_freed")):
        if lifetime[created] != lifetime[freed]:
            failures.append("%s: %s %d != %s %d"
                            % (case, created, lifetime[created], freed, lifetime[freed]))
    if len({normalize(run) for run in runs}) != 1:
        failures.append("%s: three consecutive runs produced different documents" % case)

    # Gate G, on the ids, against the same transcript the oracles read.
    transcript = os.path.join(work_dir, "case%s" % case[len("case"):], "transcript.txt")
    gate = gate_g(case, document, transcript)

    # Oracle C', at the three checkpoints.
    checkpoint_notes = []
    for k in CHECKPOINTS:
        single_path = os.path.join(document_root, "%s-single%d.json" % (case, k))
        note = "k=%d not run" % k
        identical = False
        if os.path.exists(single_path):
            single = load(single_path)
            if single["status"] == "ok":
                identical = single["output"]["sha256"] == step_rows[k - 1]["sha256"]
                note = "k=%d %s" % (k, "byte-identical" if identical else
                                    "DIFFERS (%s vs %s)" % (single["output"]["sha256"][:12],
                                                            step_rows[k - 1]["sha256"][:12]))
            else:
                note = "k=%d error %s" % (k, single["error_code"])
        if not identical:
            failures.append("%s: oracle C' is %r -- step %d did not reproduce this arm's own "
                            "single-shot T+%d prefill" % (case, note, k, k))
        checkpoint_notes.append(note)

    # R6-STEP-N section 3.5, rule 5. R6's admission rule applies **verbatim at step 1 only**, where
    # its precondition actually holds: oracle C' runs at k = 1. At steps 2..N oracle A' is
    # characterization, for the measured reason section 3.4 gives -- llama.cpp's own decode graph
    # takes a different MUL_MAT accumulation path from its own multi-column prefill, and that
    # divergence compounds through depth and through the KV cache -- and the structural assertions
    # above are what is gated there.
    first = step_rows[0]["oracle"]
    if first["verdict"] == "FAIL":
        if first["max_abs_diff_ten_thousandths"] > 5000 or "byte-identical" not in checkpoint_notes[0]:
            failures.append("%s: oracle A' FAIL at step 1 at %d/1e-4 with oracle C' %r is not "
                            "admissible -- the rule admits a FAIL only inside section 3.4's "
                            "characterization bound of 5000 AND with oracle C' byte-identical"
                            % (case, first["max_abs_diff_ten_thousandths"], checkpoint_notes[0]))
        else:
            print("decode step qualification: %s oracle A' FAIL at step 1 at %d/1e-4 on %s-%d, "
                  "admitted: oracle C' at k=1 is byte-identical, so the divergence is llama.cpp's "
                  "decode-versus-prefill kernel selection (R6 section 5.1), not this arm's "
                  "arithmetic"
                  % (case, first["max_abs_diff_ten_thousandths"], first["worst_node"],
                     first["worst_layer"]))
    elif first["verdict"] != "PASS":
        failures.append("%s: oracle A' at step 1 is %r" % (case, first["verdict"]))

    rows.append({
        "case": case,
        "tokens": tokens_in,
        "token_ids": decode["token_ids"],
        "gate_g": gate,
        "oracle_a_curve": [(row["oracle"]["verdict"],
                            row["oracle"]["max_abs_diff_ten_thousandths"],
                            row["oracle"]["max_sum_diff_millionths"]) for row in step_rows],
        "oracle_b": plane["roundtrip_verdict"],
        "oracle_b_bytes": plane["roundtrip_bytes_compared"],
        "oracle_c": checkpoint_notes,
        "plane_bytes": plane["bytes"],
        "plane_readback_ns": plane["readback_ns"],
        "plane_upload_ns": plane["upload_ns"],
        "step_compute_ns": [row["compute_ns"] for row in step_rows],
        "decode_compute_ns": decode["compute_ns"],
        "elapsed_ns": document["timings"]["elapsed_ns"],
        "reader_bytes": document["pack"]["reader_bytes_read"],
    })

print("decode step qualification: embd fingerprint injectivity over %d rows of %s: %d distinct "
      "fingerprints, %d collision class(es) covering %d ids, of which %d are not all-zero "
      "(unused) vocabulary rows"
      % (measurement["n_vocab"], measurement["ggml_type"],
         measurement["distinct_fingerprints"], measurement["collision_classes"],
         measurement["colliding_id_count"],
         len(measurement["colliding_ids_that_are_not_all_zero"])))

for row in rows:
    steps_ns = row["step_compute_ns"]
    print("decode step qualification: %s T=%d  G=%s  B=%s(%d B)  C'=[%s]  ids=%s"
          % (row["case"], row["tokens"], row["gate_g"], row["oracle_b"], row["oracle_b_bytes"],
             ", ".join(row["oracle_c"]), ",".join(str(i) for i in row["token_ids"])))
    print("decode step qualification: %s   A' per step (verdict, max abs /1e-4, max sum /1e-6): %s"
          % (row["case"], "; ".join("%d:%s/%d/%d" % (i + 1, v, a, s)
                                    for i, (v, a, s) in enumerate(row["oracle_a_curve"]))))
    print("decode step qualification: %s   compute %d ns over %d steps (min %d, max %d), "
          "plane readback %d ns upload %d ns, elapsed %d ns, pack bytes read %d"
          % (row["case"], row["decode_compute_ns"], len(steps_ns), min(steps_ns), max(steps_ns),
             row["plane_readback_ns"], row["plane_upload_ns"], row["elapsed_ns"],
             row["reader_bytes"]))

# ---------------------------------------------------------------------------------------------
# R6-KV-PERSIST section 3's shipped acceptance rule, on the real model.
#
# Rule 1 is the loop above, unchanged, on the save run. Rules 2 to 8 are here.
# ---------------------------------------------------------------------------------------------

persist_rows = []
for index in range(1, persist_prompts + 1):
    case = "case%d" % index
    save_path = os.path.join(persist_root, "%s-save.json" % case)
    load_path = os.path.join(persist_root, "%s-load.json" % case)
    if not (os.path.exists(save_path) and os.path.exists(load_path)):
        failures.append("%s: the persistence leg produced no documents" % case)
        continue
    with open(save_path, "r", encoding="utf-8") as handle:
        save = json.load(handle)
    with open(load_path, "r", encoding="utf-8") as handle:
        load = json.load(handle)
    if save["status"] != "ok" or load["status"] != "ok":
        failures.append("%s: save %s %s / load %s %s"
                        % (case, save["error_code"], save["error_detail"],
                           load["error_code"], load["error_detail"]))
        continue
    container = os.path.join(work_dir, case, "plane.akvp")
    size = os.path.getsize(container) if os.path.exists(container) else -1

    # Rule 2. The save run writes, and the header describes the run it came from.
    if save["kv"]["verdict"] != "SAVED" or save["kv"]["destination"] != "WRITTEN" \
            or save["plane"]["source"] != "PREFILL":
        failures.append("%s: the save run is %r" % (case, save["kv"]))
    if save["kv"]["total_bytes"] != size:
        failures.append("%s: kv.total_bytes is %d and the file is %d bytes"
                        % (case, save["kv"]["total_bytes"], size))
    if save["kv"]["columns_persisted"] != save["selection"]["token_count"] \
            or save["kv"]["plane_bytes"] != save["plane"]["bytes"] \
            or save["kv"]["prefill_argmax"] != save["output"]["argmax"]:
        failures.append("%s: the container's header disagrees with its own run: %r"
                        % (case, save["kv"]))
    # `du -k` against `total_bytes`: the sparse-file check that makes explicit padding an assertion.
    du_path = os.path.join(work_dir, case, "du.txt")
    du_kib = None
    if os.path.exists(du_path):
        with open(du_path, "r", encoding="utf-8") as handle:
            du_kib = int(handle.read().split()[0])
        if du_kib * 1024 < save["kv"]["total_bytes"]:
            failures.append("%s: the container occupies %d KiB on disk for %d bytes -- it is sparse"
                            % (case, du_kib, save["kv"]["total_bytes"]))

    # Rule 3, oracle P. A separate process loaded the file; the digests it republishes are the ones
    # the save run wrote; and the plane its graphs consumed matches, through a different node.
    if load["kv"]["verdict"] != "LOADED" or load["plane"]["source"] != "LOADED":
        failures.append("%s: the load run is %r / %r"
                        % (case, load["kv"]["verdict"], load["plane"]["source"]))
    for field in ("plane_sha256", "logits_sha256", "tokens_sha256", "geometry_sha256",
                  "source_header_region_sha256", "total_bytes", "plane_offset", "plane_bytes",
                  "columns_persisted", "prefill_argmax", "pack_total_bytes"):
        if save["kv"][field] != load["kv"][field]:
            failures.append("%s: kv.%s is %r on the save run and %r on the load run"
                            % (case, field, save["kv"][field], load["kv"][field]))
    # Rule 6, oracle B on the load path, at the same checkpoints and with the same byte counts.
    if load["plane"]["roundtrip_verdict"] != "IDENTICAL" \
            or load["plane"]["roundtrip_bytes_compared"] \
            != save["plane"]["roundtrip_bytes_compared"] \
            or load["plane"]["columns_written"] != save["plane"]["columns_written"]:
        failures.append("%s: oracle B on the load path is %r over %d bytes, not %r over %d"
                        % (case, load["plane"]["roundtrip_verdict"],
                           load["plane"]["roundtrip_bytes_compared"],
                           save["plane"]["roundtrip_verdict"],
                           save["plane"]["roundtrip_bytes_compared"]))

    # Rule 4, oracle Q. The two runs are the same run.
    equal_ids = save["decode"]["token_ids"] == load["decode"]["token_ids"]
    equal_documents = normalize_persist(save) == normalize_persist(load)
    if not equal_ids:
        failures.append("%s: the load run decoded %r, the save run %r"
                        % (case, load["decode"]["token_ids"], save["decode"]["token_ids"]))
    if not equal_documents:
        failures.append("%s: oracle Q -- the two documents differ outside the exclusion list"
                        % case)

    # Rule 5. Gate G on the load run: G2 at every step against the same transcript, and G1
    # **inherited** through `oracle_logits` over the persisted vector rather than re-derived.
    transcript = os.path.join(work_dir, case, "transcript.txt")
    load_gate = gate_g("%s-load" % case, load, transcript)
    if load["oracle_logits"]["verdict"] != "IDENTICAL" \
            or not load["oracle_logits"]["byte_identical"]:
        failures.append("%s: the persisted vector is %r against llama-debug on the load path"
                        % (case, load["oracle_logits"]["verdict"]))
    if load["output"]["argmax"] != load["kv"]["prefill_argmax"] \
            or load["decode"]["token_ids"][0] != load["kv"]["prefill_argmax"]:
        failures.append("%s: the id chain's root is not the container's own prefill_argmax: %r"
                        % (case, load["kv"]["prefill_argmax"]))
    # Rule 6, oracle C' on the load path, at the same three checkpoints.
    load_checkpoints = []
    for k in CHECKPOINTS:
        single_path = os.path.join(document_root, "%s-single%d.json" % (case, k))
        note = "k=%d not run" % k
        if os.path.exists(single_path):
            with open(single_path, "r", encoding="utf-8") as handle:
                single = json.load(handle)
            if single["status"] == "ok":
                same = single["output"]["sha256"] == load["steps"][k - 1]["sha256"]
                note = "k=%d %s" % (k, "byte-identical" if same else "DIFFERS")
                if not same:
                    failures.append("%s: oracle C' on the load path differs at k=%d" % (case, k))
            else:
                note = "k=%d error %s" % (k, single["error_code"])
                failures.append("%s: oracle C' at k=%d did not run" % (case, k))
        else:
            failures.append("%s: oracle C' at k=%d did not run" % (case, k))
        load_checkpoints.append(note)

    # Rule 7. Two saves and one perturbed-environment save produce one digest.
    digest_path = os.path.join(work_dir, case, "container-digests.txt")
    digests = []
    if os.path.exists(digest_path):
        with open(digest_path, "r", encoding="utf-8") as handle:
            digests = [line.strip() for line in handle if line.strip()]
    if len(digests) != 3 or len(set(digests)) != 1:
        failures.append("%s: three writes produced %d distinct containers: %r"
                        % (case, len(set(digests)), digests))

    # Section 1.4's two labelled diagnostics. **Reported, never claimed**: no acceptance decision is
    # taken from either and no rate is derived from them.
    proxy = {}
    for direction in ("save", "load"):
        wall_path = os.path.join(work_dir, case, "ttft-%s-wall.txt" % direction)
        walls = []
        if os.path.exists(wall_path):
            with open(wall_path, "r", encoding="utf-8") as handle:
                walls = [int(line) for line in handle if line.strip()]
        arm = []
        for repeat in (1, 2, 3):
            one = os.path.join(persist_root, "%s-ttft-%s-%d.json" % (case, direction, repeat))
            if os.path.exists(one):
                with open(one, "r", encoding="utf-8") as handle:
                    arm.append(json.load(handle)["timings"]["first_token_ns"])
        proxy[direction] = {"wall": walls, "arm": arm}

    persist_rows.append({
        "case": case,
        "container_bytes": size,
        "du_kib": du_kib,
        "plane_sha256": save["kv"]["plane_sha256"][:12],
        "equality": "IDENTICAL" if equal_documents and equal_ids else "DIFFERS",
        "gate_g_load": load_gate,
        "oracle_b_load": load["plane"]["roundtrip_verdict"],
        "oracle_b_bytes": load["plane"]["roundtrip_bytes_compared"],
        "oracle_c_load": load_checkpoints,
        "write_ns": save["kv"]["write_ns"],
        "read_ns": load["kv"]["read_ns"],
        "save_elapsed_ns": save["timings"]["elapsed_ns"],
        "load_elapsed_ns": load["timings"]["elapsed_ns"],
        "proxy": proxy,
        "determinism": "one digest" if len(set(digests)) == 1 else "DIFFERS",
    })

for row in persist_rows:
    print("decode step qualification: %s kv  equality=%s  G(load)=%s  B(load)=%s(%d B)  "
          "C'(load)=[%s]  determinism=%s"
          % (row["case"], row["equality"], row["gate_g_load"], row["oracle_b_load"],
             row["oracle_b_bytes"], ", ".join(row["oracle_c_load"]), row["determinism"]))
    print("decode step qualification: %s kv  container %d B (du %s KiB) plane sha %s  "
          "write %d ns  read %d ns"
          % (row["case"], row["container_bytes"],
             "?" if row["du_kib"] is None else row["du_kib"], row["plane_sha256"],
             row["write_ns"], row["read_ns"]))
    for direction in ("save", "load"):
        arm = row["proxy"][direction]["arm"]
        wall = row["proxy"][direction]["wall"]
        if not arm or not wall:
            continue
        arm_median, arm_low, arm_high = median_and_spread(arm)
        wall_median, wall_low, wall_high = median_and_spread(wall)
        # DIAGNOSTIC. Section 1.4: no TTFT claim, no rate, no speedup. The gate this number looks
        # like it is about -- TTFT on repeated coding tasks sharing a prefix -- is **not met**, and
        # section 1.4 gives four concrete reasons why a figure measured here cannot bear it. A
        # fifth belongs to this measurement specifically and is printed with it below: `REFERENCE`
        # has no `-` form, so at thirteen operands the model is always supplied, and the byte
        # comparison against it lives in the **prefill pass** -- so the save direction pays for a
        # whole second sweep of the GGUF that the load direction has no prefill to run. The
        # difference between the two numbers therefore overstates what loading saves.
        print("decode step qualification: %s kv  TTFT proxy (DIAGNOSTIC, no claim) %s: "
              "first_token %d ns [%d..%d], invocation wall %d ns [%d..%d] over 3 runs at STEPS=1"
              % (row["case"], direction, arm_median, arm_low, arm_high,
                 wall_median, wall_low, wall_high))
print("decode step qualification: the TTFT proxy above is a labelled diagnostic and no rate, "
      "speedup, or per-token figure is derived from it. It also **overstates** what loading saves: "
      "`REFERENCE` has no `-` form, so the model is supplied at thirteen operands and its byte "
      "comparison runs inside the prefill pass, which the load direction does not run at all.")

# The scaling row. Characterization, reported and not asserted, and the first concrete evidence for
# resident weights: the loop re-reads the whole pack once per step.
for n in sorted({1, 4, steps}):
    path = os.path.join(work_dir, "scaling", "n%d.json" % n)
    if not os.path.exists(path):
        continue
    with open(path, "r", encoding="utf-8") as handle:
        scaled = json.load(handle)
    if scaled["status"] != "ok":
        failures.append("scaling N=%d: %s %s" % (n, scaled["error_code"], scaled["error_detail"]))
        continue
    print("decode step qualification: scaling N=%d  elapsed %d ns  decode compute %d ns  "
          "pack bytes read %d  plane columns %d"
          % (n, scaled["timings"]["elapsed_ns"], scaled["decode"]["compute_ns"],
             scaled["pack"]["reader_bytes_read"], scaled["plane"]["columns_written"]))

if failures:
    for line in failures:
        sys.stderr.write("decode step qualification: FAIL %s\n" % line)
    raise SystemExit(1)

print("decode step qualification: %d prompts x 3 runs at N=%d PASS -- gate G on the token ids "
      "(d_1 byte-exact against llama-debug, d_1..d_N against the transcript's embd fingerprint "
      "over a vocabulary measured to have %d collision class covering only all-zero rows), oracle "
      "B byte-identical over every layer's K and V at every step including the column that step "
      "wrote, oracle C' byte-identical at k in %s, and oracle A' structurally complete at every "
      "step" % (len(rows), steps, measurement["collision_classes"], CHECKPOINTS))
print("decode step qualification: %d prompts x akvp v1 PASS -- the container written after the "
      "prefill, accepted by an independent reader, and reloaded in a **separate process** that "
      "decoded the same %d ids and published a byte-identical document outside %d excluded key "
      "groups, with gate G and oracles B and C' carried forward onto the load path and the "
      "writer's determinism proved by triple-write digest equality including under a perturbed "
      "environment. The TTFT proxy above is a labelled diagnostic: **no TTFT claim is made and the "
      "R6 roadmap gate stays unmet**, because there is no prefix-sharing corpus, no key, no "
      "lookup, and no invalidation, and loading removes one prefill pass while keeping every "
      "per-step weight sweep."
      % (len(persist_rows), steps,
         len(PERSIST_EXCLUDED_BLOCKS) + len(PERSIST_EXCLUDED_FIELDS)))
PY
