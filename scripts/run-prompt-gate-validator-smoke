#!/usr/bin/env python3
"""Owner smokes for `scripts/prompt-gate-validator.py`.

One family runs per invocation so each Makefile target named by sections 10 and 10.1 owns
an independent, narrow regression:

    validator             gate manifest, chain, and acceptance-policy rejection families
    source-bundle         the four explicit build inputs, with no ambient fallback
    source-revalidation   locator, policy, helper, interpreter, and Git identity
    git-replacement-graft raw replacement, graft, and alternate metadata rejection
    local-git-config      repository-local command-bearing configuration rejection
    ordinary-clone-config the inert ordinary-clone remote and branch metadata allowlist
    replacement-namespace `refs/replace/` enumeration through the pinned Git ref backend
    ancestry              evaluated-commit ancestry from the derived CI head
    merge-head-ancestry   a normal-merge fixture whose CI head differs from the evaluated commit

Families whose assertion needs a Git child or the source-verifier helper require the Linux
process-containment floor and report SKIP elsewhere. Every other family asserts a rejection
that happens before the first child, so it runs on any host.
"""

from __future__ import annotations

import copy
import hashlib
import importlib.util
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any, Callable, Mapping


ROOT = Path(__file__).resolve().parent.parent
PROJECT_ROOT = ROOT
VALIDATOR = ROOT / "scripts" / "prompt-gate-validator.py"
# The merged C6-MEASURED evidence, read in place: the version-1 regression asserts against the
# real frozen chain rather than against a rebuilt approximation of it.
FROZEN_GATE = ROOT / "eval" / "prompt" / "gate"
FROZEN_C4_GATE = ROOT / "eval" / "prompt" / "c4-repair-gate"
FROZEN_C4E_GATE = ROOT / "eval" / "prompt" / "c4-editset-gate"
LINUX = sys.platform.startswith("linux")


def load_module(name: str, path: Path):
    specification = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(specification)
    specification.loader.exec_module(module)
    return module


fixture = load_module("prompt_gate_fixture", ROOT / "scripts" / "prompt_gate_fixture.py")
# The validator is also driven in-process for the two rows that assert a pure recomputation, so
# they do not need the Linux containment floor a subprocess invocation reaches.
validator = load_module("prompt_gate_validator", VALIDATOR)


class SmokeFailure(RuntimeError):
    """One smoke case did not observe the required validator behavior."""


def require(condition: Any, message: str) -> None:
    if not condition:
        raise SmokeFailure(message)


def invoke(bundle, *, arguments: list[str] | None = None, environment: Mapping[str, str] | None = None):
    values = bundle.arguments() if arguments is None else arguments
    child_environment = dict(os.environ)
    child_environment.update(environment or {})
    completed = subprocess.run(
        [sys.executable, str(VALIDATOR), *values],
        cwd=bundle.checkout,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=child_environment,
    )
    return completed.returncode, completed.stdout + completed.stderr


def accepted_code() -> int:
    """A fully valid bundle exits 0 on the Linux floor and 3 without process containment."""
    return 0 if LINUX else 3


def build(root: Path, name: str, **keywords):
    directory = root / name
    directory.mkdir()
    return fixture.GateBundle(directory, **keywords)


def case(root: Path, name: str, mutate: Callable[[Any], None] | None = None, **keywords):
    bundle = build(root, name, **keywords)
    if mutate is not None:
        mutate(bundle)
    return bundle.finalize()


def rejected(
    bundle,
    label: str,
    *,
    arguments: list[str] | None = None,
    environment=None,
    code: int = 2,
    contains: str | None = None,
):
    observed, output = invoke(bundle, arguments=arguments, environment=environment)
    require(observed == code, f"{label}: expected exit {code}, observed {observed}: {output.strip()}")
    if contains is not None:
        require(
            contains in output,
            f"{label}: rejected for another reason, expected {contains!r}: {output.strip()}",
        )


def read(bundle, name: str) -> dict[str, Any]:
    return json.loads((bundle.gate_directory / name).read_text("utf-8"))


def store(bundle, name: str, value: Mapping[str, Any]) -> None:
    (bundle.gate_directory / name).write_bytes(fixture.canonical_bytes(value))


# --- family: validator ---------------------------------------------------------------


def status_field(pid: int, field: str) -> str:
    """Return one `/proc/PID/status` field value."""
    return next(
        line for line in Path(f"/proc/{pid}/status").read_text().splitlines()
        if line.startswith(field)
    ).split()[1]


def fork_zombie_leader() -> int:
    """Fork a child that becomes a zombie thread-group leader with a live worker thread.

    The child starts a worker thread and then leaves its own leader thread through
    `pthread_exit`, which the kernel takes as a plain thread exit rather than a group exit.
    A leader cannot be released while its group still holds a task, so it stays in
    `State: Z` with `Threads: 2` while the worker keeps executing. That is the reviewer's
    reproduction of a zombie entry that is still a live process. It is the portable
    construction: it needs no architecture syscall table and no compiler at test time, and
    it was verified on `x86_64` and `aarch64` glibc CPython.
    """
    child = os.fork()
    if child == 0:
        try:
            import ctypes
            import threading

            running = threading.Event()

            def worker() -> None:
                running.set()
                time.sleep(600)

            threading.Thread(target=worker, daemon=True).start()
            running.wait(5.0)
            ctypes.CDLL(None).pthread_exit(None)
        except BaseException:
            pass
        os._exit(97)
    return child


def await_zombie_leader(pid: int) -> None:
    """Block until `pid` is a zombie leader whose group still holds another task."""
    deadline = time.monotonic() + 5.0
    state, tasks = "", ""
    while time.monotonic() < deadline:
        try:
            state = status_field(pid, "State:")
            tasks = status_field(pid, "Threads:")
        except (OSError, StopIteration):
            break
        if state == "Z" and tasks != "1":
            return
        time.sleep(0.01)
    raise RuntimeError(
        f"the synthetic zombie leader never reached State Z with a live task: {state!r}/{tasks!r}"
    )


def descendant_scan_rows() -> None:
    """The scan reports every live descendant and skips only a fully terminated one.

    The first row forks a direct child that exits at once. This process has not waited for
    it, so it stays a zombie in this process's table: `State: Z` with a single task. It has
    terminated and cannot escape containment, so counting it would fail containment for a
    process that no longer runs. In production the same entry also arrives through
    child-subreaper mode, which reparents an already-exited orphan here as a zombie child;
    a direct fork reaches the identical `/proc` shape without racing an orphan.

    The second row forks a zombie thread-group *leader* whose worker thread is still
    running. That entry is `State: Z` too, but it is a live process and must be reported.
    The row fails if the `Threads:` discriminator is dropped and every zombie is skipped
    again.

    The third row proves an ordinary live descendant is still reported.
    """
    specification = importlib.util.spec_from_file_location("prompt_gate_descendants", VALIDATOR)
    require(
        specification is not None and specification.loader is not None,
        "the gate validator module could not be loaded",
    )
    module = importlib.util.module_from_spec(specification)
    specification.loader.exec_module(module)

    zombie = os.fork()
    if zombie == 0:
        os._exit(0)
    deadline = time.monotonic() + 5.0
    state = ""
    while time.monotonic() < deadline:
        state = status_field(zombie, "State:")
        if state == "Z":
            break
        time.sleep(0.01)
    require(state == "Z", "the synthetic child never reached the terminated zombie state")
    require(
        zombie not in module.owned_descendant_ids(),
        "a fully terminated zombie child was counted as a live descendant",
    )
    os.waitpid(zombie, 0)

    leader = fork_zombie_leader()
    try:
        await_zombie_leader(leader)
        require(
            leader in module.owned_descendant_ids(),
            "a zombie leader with a live worker thread was not reported as a live descendant",
        )
    finally:
        os.kill(leader, signal.SIGKILL)
        os.waitpid(leader, 0)

    live = subprocess.Popen(
        [sys.executable, "-c", "import time\ntime.sleep(30)\n"], start_new_session=True,
    )
    try:
        deadline = time.monotonic() + 5.0
        seen = False
        while time.monotonic() < deadline and not seen:
            seen = live.pid in module.owned_descendant_ids()
            if not seen:
                time.sleep(0.01)
        require(seen, "a live descendant was not reported by the scan")
    finally:
        live.kill()
        live.wait()


def family_validator(root: Path) -> None:
    if LINUX:
        descendant_scan_rows()
    valid = case(root, "valid")
    observed, output = invoke(valid)
    require(
        observed == accepted_code(),
        f"valid gate bundle: expected exit {accepted_code()}, observed {observed}: {output.strip()}",
    )
    if not LINUX:
        require(
            "containment is unavailable" in output,
            f"valid gate bundle did not reach source observation: {output.strip()}",
        )

    def tamper_manifest_field(bundle) -> None:
        manifest = read(bundle, fixture.MANIFEST_NAME)
        manifest["gate_id"] = "tampered-gate"
        store(bundle, fixture.MANIFEST_NAME, manifest)

    rejected(case(root, "manifest-tamper", tamper_manifest_field), "manifest field tamper")

    def tamper_reference_digest(bundle) -> None:
        manifest = read(bundle, fixture.MANIFEST_NAME)
        manifest["improved_evaluation"]["content_sha256"] = "0" * 64
        store(bundle, fixture.MANIFEST_NAME, fixture.bind(manifest))

    rejected(case(root, "digest-mismatch", tamper_reference_digest), "reference digest mismatch")

    def tamper_artifact_bytes(bundle) -> None:
        evaluation = read(bundle, fixture.EVALUATION_NAME)
        evaluation["sample_count"] = 3
        store(bundle, fixture.EVALUATION_NAME, evaluation)

    rejected(case(root, "artifact-tamper", tamper_artifact_bytes), "artifact byte tamper")

    def remove_referenced(bundle) -> None:
        (bundle.gate_directory / fixture.EVIDENCE_NAME).unlink()

    rejected(case(root, "missing-file", remove_referenced), "missing referenced file")

    def wrong_reference_kind(bundle) -> None:
        manifest = read(bundle, fixture.MANIFEST_NAME)
        manifest["baseline_activation"]["artifact_kind"] = "PROMPT_EVALUATION_RESULT"
        store(bundle, fixture.MANIFEST_NAME, fixture.bind(manifest))

    rejected(case(root, "reference-kind", wrong_reference_kind), "wrong reference kind")

    def unknown_manifest_field(bundle) -> None:
        manifest = read(bundle, fixture.MANIFEST_NAME)
        manifest["extra"] = 1
        store(bundle, fixture.MANIFEST_NAME, fixture.bind(manifest))

    rejected(case(root, "manifest-field", unknown_manifest_field), "unknown manifest field")

    def unpaired_evidence(bundle) -> None:
        manifest = read(bundle, fixture.MANIFEST_NAME)
        manifest["improved_evaluation_evidence"]["artifact_id"] = "another-evaluation"
        store(bundle, fixture.MANIFEST_NAME, fixture.bind(manifest))

    rejected(case(root, "evidence-identity", unpaired_evidence), "evidence reference identity")

    def foreign_activation_identity(bundle) -> None:
        manifest = read(bundle, fixture.MANIFEST_NAME)
        manifest["baseline_activation"]["artifact_id"] = "another-decision"
        store(bundle, fixture.MANIFEST_NAME, fixture.bind(manifest))

    rejected(
        case(root, "activation-identity", foreign_activation_identity),
        "baseline activation reference identity",
    )

    def pass_to_fail(bundle) -> None:
        """A candidate row regresses where its paired parent passed."""
        evaluation = read(bundle, fixture.EVALUATION_NAME)
        for row in evaluation["rows"]:
            if row["variant"] == "CANDIDATE" and row["sample_index"] == 2:
                row["measurement"]["status"] = "FAIL"
                row["measurement"]["build_status"] = "FAIL"
                row["measurement"].pop("generation_to_passing_patch_ns", None)
                row.pop("time_to_passing_patch_ns", None)
                fixture.bind(row["measurement"])
                fixture.bind(row)
        rebind_chain(bundle, evaluation)

    rejected(case(root, "pass-to-fail", pass_to_fail), "acceptance policy PASS to FAIL")

    def unpaired_variant(bundle) -> None:
        evaluation = read(bundle, fixture.EVALUATION_NAME)
        for row in evaluation["rows"]:
            if row["variant"] == "CANDIDATE" and row["sample_index"] == 1:
                row["variant"] = "PARENT"
                fixture.bind(row)
        rebind_chain(bundle, evaluation)

    rejected(case(root, "unpaired-variant", unpaired_variant), "unpaired parent/candidate schedule")

    def aggregate_tamper(bundle) -> None:
        evaluation = read(bundle, fixture.EVALUATION_NAME)
        evaluation["corpus_aggregate"]["completion_gain_count"] = 7
        rebind_chain(bundle, evaluation)

    rejected(case(root, "aggregate-tamper", aggregate_tamper), "persisted corpus aggregate tamper")

    def broken_lineage(bundle) -> None:
        accepted = read(bundle, fixture.ACCEPTED_NAME)
        accepted["activation"]["parent_activation_sha256"] = "0" * 64
        fixture.bind(accepted["activation"])
        fixture.bind(accepted)
        store(bundle, fixture.ACCEPTED_NAME, accepted)
        manifest = read(bundle, fixture.MANIFEST_NAME)
        manifest["accepted_activation"]["content_sha256"] = accepted["content_sha256"]
        store(bundle, fixture.MANIFEST_NAME, fixture.bind(manifest))
        rollback = read(bundle, fixture.ROLLBACK_NAME)
        rollback["activation"]["parent_activation_sha256"] = accepted["content_sha256"]
        fixture.bind(rollback["activation"])
        fixture.bind(rollback)
        store(bundle, fixture.ROLLBACK_NAME, rollback)
        manifest = read(bundle, fixture.MANIFEST_NAME)
        manifest["rollback_activation"]["content_sha256"] = rollback["content_sha256"]
        store(bundle, fixture.MANIFEST_NAME, fixture.bind(manifest))

    rejected(case(root, "broken-lineage", broken_lineage), "accepted activation parent lineage")

    def foreign_rollback_variant(bundle) -> None:
        rollback = read(bundle, fixture.ROLLBACK_NAME)
        accepted = read(bundle, fixture.ACCEPTED_NAME)
        rollback["activation"]["effective_variant"] = copy.deepcopy(
            accepted["activation"]["effective_variant"]
        )
        fixture.bind(rollback["activation"])
        fixture.bind(rollback)
        store(bundle, fixture.ROLLBACK_NAME, rollback)
        manifest = read(bundle, fixture.MANIFEST_NAME)
        manifest["rollback_activation"]["content_sha256"] = rollback["content_sha256"]
        store(bundle, fixture.MANIFEST_NAME, fixture.bind(manifest))

    rejected(
        case(root, "rollback-variant", foreign_rollback_variant),
        "rollback activation does not restore the baseline variant",
    )
    binding_rows(root)


def rebind_chain(bundle, evaluation: dict[str, Any]) -> None:
    """Rewrite an edited evaluation and every artifact whose identity depends on it."""
    fixture.bind(evaluation)
    store(bundle, fixture.EVALUATION_NAME, evaluation)
    evidence = read(bundle, fixture.EVIDENCE_NAME)
    evidence["evaluation_result_sha256"] = evaluation["content_sha256"]
    store(bundle, fixture.EVIDENCE_NAME, fixture.bind(evidence))
    accepted = read(bundle, fixture.ACCEPTED_NAME)
    accepted["activation"]["accepted_evaluation_sha256"] = evaluation["content_sha256"]
    fixture.bind(accepted["activation"])
    fixture.bind(accepted)
    store(bundle, fixture.ACCEPTED_NAME, accepted)
    rollback = read(bundle, fixture.ROLLBACK_NAME)
    # Section 4.4 lineage is the nested activation digest, exactly as the fixture builds it.
    rollback["activation"]["parent_activation_sha256"] = accepted["activation"]["content_sha256"]
    fixture.bind(rollback["activation"])
    fixture.bind(rollback)
    store(bundle, fixture.ROLLBACK_NAME, rollback)
    manifest = read(bundle, fixture.MANIFEST_NAME)
    manifest["improved_evaluation"]["content_sha256"] = evaluation["content_sha256"]
    manifest["improved_evaluation_evidence"]["content_sha256"] = evidence["content_sha256"]
    manifest["accepted_activation"]["content_sha256"] = accepted["content_sha256"]
    manifest["rollback_activation"]["content_sha256"] = rollback["content_sha256"]
    store(bundle, fixture.MANIFEST_NAME, fixture.bind(manifest))


def rebind_scope_cascade(bundle, evaluation: dict[str, Any]) -> None:
    """Rewrite an edited scope into every artifact that carries it, then rebind the chain.

    The scope is shared by the evaluation, the experiment artifact, and all three activations, so a
    scope edit that only rebinds the evaluation would be rejected by the lineage rules rather than
    by the binding under test. This cascade keeps the whole chain internally consistent so the row
    proves exactly the link it names.
    """
    fixture.bind(evaluation["scope"])
    scope = evaluation["scope"]
    baseline = read(bundle, fixture.BASELINE_NAME)
    baseline["activation"]["scope"] = copy.deepcopy(scope)
    fixture.bind(baseline["activation"])
    fixture.bind(baseline)
    store(bundle, fixture.BASELINE_NAME, baseline)
    accepted = read(bundle, fixture.ACCEPTED_NAME)
    accepted["activation"]["scope"] = copy.deepcopy(scope)
    accepted["activation"]["parent_activation_sha256"] = baseline["activation"]["content_sha256"]
    fixture.bind(accepted["activation"])
    fixture.bind(accepted)
    store(bundle, fixture.ACCEPTED_NAME, accepted)
    rollback = read(bundle, fixture.ROLLBACK_NAME)
    rollback["activation"]["scope"] = copy.deepcopy(scope)
    rollback["activation"]["rollback_target_activation_sha256"] = baseline["activation"][
        "content_sha256"
    ]
    fixture.bind(rollback["activation"])
    fixture.bind(rollback)
    store(bundle, fixture.ROLLBACK_NAME, rollback)
    manifest = read(bundle, fixture.MANIFEST_NAME)
    manifest["baseline_activation"]["content_sha256"] = baseline["content_sha256"]
    store(bundle, fixture.MANIFEST_NAME, fixture.bind(manifest))
    evaluation["experiment_artifact"]["scope"] = copy.deepcopy(scope)
    fixture.bind(evaluation["experiment_artifact"])
    evaluation["experiment"]["content_sha256"] = evaluation["experiment_artifact"]["content_sha256"]
    rebind_chain(bundle, evaluation)


def evaluation_case(root: Path, name: str, mutate, *, cascade: bool = False):
    """One rejection row that edits the evaluation result and rebinds every dependent digest."""

    def apply(bundle) -> None:
        evaluation = read(bundle, fixture.EVALUATION_NAME)
        mutate(evaluation)
        if cascade:
            rebind_scope_cascade(bundle, evaluation)
        else:
            rebind_chain(bundle, evaluation)

    return case(root, name, apply)


def binding_rows(root: Path) -> None:
    """One rejection row per cross-artifact link the gate now recomputes.

    Every row mutates one document, rebinds every digest that document's identity feeds, and
    requires the validator to reject for that link's own reason. A row that merely exits 2 would be
    satisfied by an unrelated earlier check, so each asserts its exact diagnostic.
    """

    # --- the scope binds the evaluated policies and the evaluated prompt hierarchy ---------------

    def acceptance_policy_unbound(evaluation) -> None:
        evaluation["acceptance_policy"]["policy_id"] = "another-policy"
        fixture.bind(evaluation["acceptance_policy"])
        evaluation["acceptance_policy_source"]["artifact_id"] = "another-policy"
        evaluation["acceptance_policy_source"]["content_sha256"] = evaluation["acceptance_policy"][
            "content_sha256"
        ]

    rejected(
        evaluation_case(root, "scope-acceptance-binding", acceptance_policy_unbound),
        "scope acceptance policy binding",
        contains="scope acceptance policy digest is not the evaluated policy",
    )

    def generation_policy_unbound(evaluation) -> None:
        evaluation["generation_policy"]["max_tokens"] += 1
        fixture.bind(evaluation["generation_policy"])
        evaluation["generation_policy_source"]["content_sha256"] = evaluation["generation_policy"][
            "content_sha256"
        ]

    rejected(
        evaluation_case(root, "scope-generation-binding", generation_policy_unbound),
        "scope generation policy binding",
        contains="scope generation policy digest is not the evaluated policy",
    )

    def scope_prompt_digest(evaluation) -> None:
        evaluation["scope"]["base_prompt_sha256"] = "0" * 64

    rejected(
        evaluation_case(root, "scope-prompt-binding", scope_prompt_digest, cascade=True),
        "evaluation scope prompt binding",
        contains="scope base_prompt_sha256 is not the variant's base_prompt digest",
    )

    def activation_scope_prompt_digest(bundle) -> None:
        accepted = read(bundle, fixture.ACCEPTED_NAME)
        accepted["activation"]["scope"]["repo_prompt_sha256"] = "0" * 64
        fixture.bind(accepted["activation"]["scope"])
        fixture.bind(accepted["activation"])
        fixture.bind(accepted)
        store(bundle, fixture.ACCEPTED_NAME, accepted)
        manifest = read(bundle, fixture.MANIFEST_NAME)
        manifest["accepted_activation"]["content_sha256"] = accepted["content_sha256"]
        store(bundle, fixture.MANIFEST_NAME, fixture.bind(manifest))

    rejected(
        case(root, "activation-scope-prompt-binding", activation_scope_prompt_digest),
        "activation scope prompt binding",
        contains="scope repo_prompt_sha256 is not the variant's repo_prompt digest",
    )

    # --- the frozen corpus and the evaluated task list are the same task set ---------------------

    def corpus_extra_task_file(evaluation) -> None:
        evaluation["corpus"]["task_files"].append("another-task.json")
        fixture.bind(evaluation["corpus"])
        evaluation["corpus_source"]["content_sha256"] = evaluation["corpus"]["content_sha256"]

    rejected(
        evaluation_case(root, "corpus-task-file-extra", corpus_extra_task_file),
        "corpus declares a task the evaluation did not run",
        contains="task files do not cover the evaluated tasks exactly",
    )

    def corpus_foreign_task_file(evaluation) -> None:
        evaluation["corpus"]["task_files"][0] = "eval/tasks/another-task.json"
        fixture.bind(evaluation["corpus"])
        evaluation["corpus_source"]["content_sha256"] = evaluation["corpus"]["content_sha256"]

    rejected(
        evaluation_case(root, "corpus-task-file-foreign", corpus_foreign_task_file),
        "corpus names a task file no snapshot observed",
        contains="input snapshot does not observe its declared task file",
    )

    def corpus_identity(evaluation) -> None:
        evaluation["corpus"]["corpus_id"] = "another-corpus"
        fixture.bind(evaluation["corpus"])
        evaluation["corpus_source"]["artifact_id"] = "another-corpus"
        evaluation["corpus_source"]["content_sha256"] = evaluation["corpus"]["content_sha256"]

    rejected(
        evaluation_case(root, "corpus-identity", corpus_identity),
        "corpus identity disagrees with its scope",
        contains="evaluation corpus id disagrees with its scope",
    )

    def foreign_task_manifest(evaluation) -> None:
        for snapshot in evaluation["input_snapshots"]:
            snapshot["task_manifest_sha256"] = "0" * 64
            fixture.bind(snapshot)
        for attestation in evaluation["snapshot_attestations"]:
            attestation["before_input_snapshot_sha256"] = evaluation["input_snapshots"][0][
                "content_sha256"
            ]
            attestation["after_input_snapshot_sha256"] = evaluation["input_snapshots"][0][
                "content_sha256"
            ]
            fixture.bind(attestation)

    rejected(
        evaluation_case(root, "input-snapshot-task-manifest", foreign_task_manifest),
        "an input snapshot names another task manifest",
        contains="input snapshot names another task manifest",
    )

    # --- workspace admission ---------------------------------------------------------------------

    def unsafe_preflight(evaluation) -> None:
        evaluation["workspace_preflight"]["status"] = "UNSAFE"
        fixture.bind(evaluation["workspace_preflight"])
        evaluation["workspace_preflight_source"]["content_sha256"] = evaluation[
            "workspace_preflight"
        ]["content_sha256"]

    rejected(
        evaluation_case(root, "workspace-preflight-unsafe", unsafe_preflight),
        "workspace preflight is not SAFE",
        contains="workspace preflight is not SAFE",
    )

    # --- snapshot observation closure -------------------------------------------------------------

    def absent_snapshot_stream(evaluation) -> None:
        evaluation["snapshot_attestations"] = []

    rejected(
        evaluation_case(root, "snapshot-stream-absent", absent_snapshot_stream),
        "an absent snapshot stream",
        contains="carries no snapshot attestation stream",
    )

    def mismatched_snapshot(evaluation) -> None:
        evaluation["snapshot_results"][0]["status"] = "MISMATCH"
        fixture.bind(evaluation["snapshot_results"][0])
        for attestation in evaluation["snapshot_attestations"]:
            attestation["before_snapshot_result_sha256"] = evaluation["snapshot_results"][0][
                "content_sha256"
            ]
            attestation["after_snapshot_result_sha256"] = evaluation["snapshot_results"][0][
                "content_sha256"
            ]
            fixture.bind(attestation)

    rejected(
        evaluation_case(root, "snapshot-result-mismatch", mismatched_snapshot),
        "a non-matching snapshot result",
        contains="snapshot result is not MATCH",
    )

    def snapshot_drift(evaluation) -> None:
        attestation = evaluation["snapshot_attestations"][0]
        attestation["after_input_snapshot_sha256"] = "0" * 64
        fixture.bind(attestation)

    rejected(
        evaluation_case(root, "snapshot-attestation-drift", snapshot_drift),
        "observed snapshot drift",
        contains="snapshot attestation records observed drift",
    )

    def foreign_snapshot_record(evaluation) -> None:
        attestation = evaluation["snapshot_attestations"][0]
        attestation["before_snapshot_result_sha256"] = "0" * 64
        attestation["after_snapshot_result_sha256"] = "0" * 64
        fixture.bind(attestation)

    rejected(
        evaluation_case(root, "snapshot-attestation-foreign-record", foreign_snapshot_record),
        "an attestation naming no persisted snapshot record",
        contains="names no persisted record",
    )

    # --- provider control -------------------------------------------------------------------------

    def provider_control_unbound(evaluation) -> None:
        evaluation["provider_control"]["endpoint"] = "http://127.0.0.1:9/v1/chat/completions"
        fixture.bind(evaluation["provider_control"])
        evaluation["provider_control_source"]["content_sha256"] = evaluation["provider_control"][
            "content_sha256"
        ]

    rejected(
        evaluation_case(root, "provider-control-unbound", provider_control_unbound),
        "the generation policy does not bind the evaluated provider control",
        contains="generation policy does not bind the evaluated provider control",
    )

    def provider_model_disagrees(evaluation) -> None:
        evaluation["provider_control"]["model"] = "another-model"
        fixture.bind(evaluation["provider_control"])
        evaluation["provider_control_source"]["content_sha256"] = evaluation["provider_control"][
            "content_sha256"
        ]
        evaluation["generation_policy"]["provider_control_sha256"] = evaluation["provider_control"][
            "content_sha256"
        ]
        fixture.bind(evaluation["generation_policy"])
        evaluation["generation_policy_source"]["content_sha256"] = evaluation["generation_policy"][
            "content_sha256"
        ]
        evaluation["scope"]["generation_policy_sha256"] = evaluation["generation_policy"][
            "content_sha256"
        ]

    rejected(
        evaluation_case(root, "provider-model-disagrees", provider_model_disagrees, cascade=True),
        "the generation policy model disagrees with the provider control",
        contains="generation policy evaluation_provider_model disagrees with the provider control",
    )

    # --- declared `ArtifactReference` bindings -----------------------------------------------------

    def foreign_source_digest(evaluation) -> None:
        evaluation["provider_control_source"]["content_sha256"] = "0" * 64

    rejected(
        evaluation_case(root, "source-reference-digest", foreign_source_digest),
        "a declared source reference digest",
        contains="digest does not match the embedded provider_control",
    )

    def foreign_source_identity(evaluation) -> None:
        evaluation["corpus_source"]["artifact_id"] = "another-corpus"

    rejected(
        evaluation_case(root, "source-reference-identity", foreign_source_identity),
        "a declared source reference identity",
        contains="names another corpus",
    )

    # --- producer-owned environment identity and the checked-in environment policy -----------------

    def environment_verifier_runtime(evaluation) -> None:
        evaluation["environment"]["core"]["source_verifier_runtime"] = "CPYTHON:x:y"
        fixture.bind(evaluation["environment"])

    rejected(
        evaluation_case(root, "environment-verifier-runtime", environment_verifier_runtime),
        "the recorded source-verifier runtime",
        contains="environment source_verifier_runtime disagrees with the gate locator",
    )

    def environment_verifier_policy(evaluation) -> None:
        evaluation["environment"]["core"]["source_verifier_policy_sha256"] = "0" * 64
        fixture.bind(evaluation["environment"])

    rejected(
        evaluation_case(root, "environment-verifier-policy", environment_verifier_policy),
        "the recorded source-verifier policy digest",
        contains="environment source_verifier_policy_sha256 disagrees with the gate locator",
    )

    def environment_policy_digest(evaluation) -> None:
        evaluation["environment"]["core"]["environment_policy_sha256"] = "0" * 64
        fixture.bind(evaluation["environment"])

    rejected(
        evaluation_case(root, "environment-policy-binding", environment_policy_digest),
        "the recorded environment policy digest",
        contains="environment policy digest is not the checked-in gate policy",
    )

    def environment_policy_bytes(bundle) -> None:
        """The manifest now binds the environment policy by digest, not by path alone."""
        policy = read(bundle, fixture.ENVIRONMENT_POLICY_NAME)
        policy["locale"] = "en_US.UTF-8"
        store(bundle, fixture.ENVIRONMENT_POLICY_NAME, fixture.bind(policy))

    rejected(
        case(root, "environment-policy-bytes", environment_policy_bytes),
        "tampered environment policy bytes",
        contains="gate environment policy digest does not match its manifest reference",
    )

    def environment_policy_absent(bundle) -> None:
        (bundle.gate_directory / fixture.ENVIRONMENT_POLICY_NAME).unlink()

    rejected(
        case(root, "environment-policy-absent", environment_policy_absent),
        "an absent environment policy",
        contains="gate environment policy is unavailable",
    )

    def environment_policy_identity(bundle) -> None:
        manifest = read(bundle, fixture.MANIFEST_NAME)
        manifest["environment_policy"]["artifact_id"] = "another-environment-policy"
        store(bundle, fixture.MANIFEST_NAME, fixture.bind(manifest))

    rejected(
        case(root, "environment-policy-identity", environment_policy_identity),
        "the environment policy reference identity",
        contains="environment policy reference names another policy",
    )
    repair_attempt_rows(root)
    frozen_version_one_chain()
    frozen_version_two_chain()
    frozen_editset_chain()
    frozen_corpus_rows()


# --- C4-REPAIR-MEASURED: the version-2 attempt stream ---------------------------------


def v2_evaluation_case(root: Path, name: str, mutate):
    """A version-2 rejection row: edit the attempt stream and rebind every dependent digest."""

    def apply(bundle) -> None:
        evaluation = read(bundle, fixture.EVALUATION_NAME)
        evidence = read(bundle, fixture.EVIDENCE_NAME)
        mutate(evaluation, evidence)
        store(bundle, fixture.EVIDENCE_NAME, fixture.bind(evidence))
        rebind_chain_keeping_evidence(bundle, evaluation)

    return case(root, name, apply, schema_version=2)


def rebind_chain_keeping_evidence(bundle, evaluation: dict[str, Any]) -> None:
    """`rebind_chain`, but preserving an already-edited evidence document's own edits."""
    fixture.bind(evaluation)
    store(bundle, fixture.EVALUATION_NAME, evaluation)
    evidence = read(bundle, fixture.EVIDENCE_NAME)
    evidence["evaluation_result_sha256"] = evaluation["content_sha256"]
    store(bundle, fixture.EVIDENCE_NAME, fixture.bind(evidence))
    accepted = read(bundle, fixture.ACCEPTED_NAME)
    accepted["activation"]["accepted_evaluation_sha256"] = evaluation["content_sha256"]
    fixture.bind(accepted["activation"])
    fixture.bind(accepted)
    store(bundle, fixture.ACCEPTED_NAME, accepted)
    rollback = read(bundle, fixture.ROLLBACK_NAME)
    rollback["activation"]["parent_activation_sha256"] = accepted["activation"]["content_sha256"]
    fixture.bind(rollback["activation"])
    fixture.bind(rollback)
    store(bundle, fixture.ROLLBACK_NAME, rollback)
    manifest = read(bundle, fixture.MANIFEST_NAME)
    manifest["improved_evaluation"]["content_sha256"] = evaluation["content_sha256"]
    manifest["improved_evaluation_evidence"]["content_sha256"] = evidence["content_sha256"]
    manifest["accepted_activation"]["content_sha256"] = accepted["content_sha256"]
    manifest["rollback_activation"]["content_sha256"] = rollback["content_sha256"]
    store(bundle, fixture.MANIFEST_NAME, fixture.bind(manifest))


def repair_attempt_rows(root: Path) -> None:
    """One rejection row per version-2 invariant `docs/specs/c4-repair-measured.md` section 3.8 adds.

    A version-2 bundle is accepted first, so every row below differs from an accepted bundle in
    exactly the attempt machinery it names. Each asserts its own diagnostic: a row that merely
    exits 2 would be satisfied by an unrelated earlier check.
    """
    accepted = case(root, "v2-valid", schema_version=2)
    observed, output = invoke(accepted)
    require(
        observed == accepted_code(),
        f"valid version-2 bundle: expected exit {accepted_code()}, observed {observed}: {output.strip()}",
    )
    evaluation = read(accepted, fixture.EVALUATION_NAME)
    require(
        evaluation["schema_version"] == 2
        and all(row["schema_version"] == 2 for row in evaluation["rows"]),
        "the version-2 fixture did not produce a version-2 document",
    )
    # The gate quantity itself, recomputed rather than trusted: two candidate rows recover across
    # both paired samples, so exactly one (task, variant) pair is a reproducible recovery.
    corpus = evaluation["corpus_aggregate"]
    require(
        corpus["repair_attempt_count"] == 4
        and corpus["repair_recovery_count"] == 3
        and corpus["repair_recovery_paired_count"] == 1,
        f"the version-2 repair aggregates are not the fixture's: {corpus!r}",
    )

    # The variant-symmetric `REPAIR_LOOPS` reason is defence in depth behind the attempt ladder:
    # a document that survives `validate_attempts` can never carry a row count above its task cap,
    # so the reason is unreachable through the CLI and is exercised here as a pure recomputation.
    # Its record shape and its position in the stream are what `rescore` is compared on.
    symmetry = read(accepted, fixture.EVALUATION_NAME)
    policy = validator.validate_acceptance_policy(symmetry["acceptance_policy"])
    parent_row = next(item for item in symmetry["rows"] if item["variant"] == "PARENT")
    parent_row["repair_loop_count"] = 2
    _, _, _, parent_reasons = validator.rescore(symmetry, policy)
    emitted = [item for item in parent_reasons if item["code"] == "REPAIR_LOOPS"]
    require(
        any(
            item["parent_value"] == "2"
            and item["candidate_value"] == "NONE"
            and item["sample_index"] == parent_row["sample_index"]
            for item in emitted
        ),
        f"a parent row above its repair cap emitted no parent reason: {parent_reasons!r}",
    )
    candidate_row = next(item for item in symmetry["rows"] if item["variant"] == "CANDIDATE")
    candidate_row["repair_loop_count"] = 2
    _, _, _, both_reasons = validator.rescore(symmetry, policy)
    codes = [(item["code"], item["parent_value"], item["candidate_value"]) for item in both_reasons]
    require(
        ("REPAIR_LOOPS", "2", "NONE") in codes and ("REPAIR_LOOPS", "NONE", "2") in codes,
        f"the repair-loop check is not variant-symmetric: {codes!r}",
    )
    # The candidate record keeps its exact version-1 shape and its position after the three-name
    # limit loop, so no version-1 verdict changes.
    require(
        codes.index(("REPAIR_LOOPS", "2", "NONE"))
        < codes.index(("REPAIR_LOOPS", "NONE", "2")),
        f"the parent repair reason is not emitted before the candidate's: {codes!r}",
    )

    def mixed_version(evaluation, evidence) -> None:
        evaluation["rows"][0]["schema_version"] = 1
        fixture.bind(evaluation["rows"][0])

    rejected(
        v2_evaluation_case(root, "v2-mixed-version", mixed_version),
        "a mixed-version container",
        contains="evaluation row version disagrees with its container",
    )

    def undeclared_row_field(evaluation, evidence) -> None:
        # Rows were only structurally checked before version 2; the per-version tuple is what makes
        # a grown or reordered row shape a rejection rather than a silently skipped key.
        row = evaluation["rows"][0]
        row["repair_recovery"] = True
        fixture.bind(row)

    rejected(
        v2_evaluation_case(root, "v2-row-field-order", undeclared_row_field),
        "an undeclared row field",
        contains="has the wrong fields or order",
    )

    def reordered_row_fields(evaluation, evidence) -> None:
        row = evaluation["rows"][0]
        reordered = {name: row[name] for name in list(row)[::-1]}
        evaluation["rows"][0] = fixture.bind(reordered)

    rejected(
        v2_evaluation_case(root, "v2-row-field-reorder", reordered_row_fields),
        "a reordered row",
        contains="has the wrong fields or order",
    )

    def evidence_version_skew(evaluation, evidence) -> None:
        evidence["schema_version"] = 1

    rejected(
        v2_evaluation_case(root, "v2-evidence-version", evidence_version_skew),
        "an evidence container at another version",
        contains="evaluation evidence header is invalid",
    )

    def sparse_attempt_index(evaluation, evidence) -> None:
        row = evaluation["rows"][0]
        row["attempts"][1]["attempt_index"] = 3
        fixture.bind(row["attempts"][1])
        fixture.bind(row)
        evidence["expected_inputs"][1]["attempt_index"] = 3
        fixture.bind(evidence["expected_inputs"][1])

    rejected(
        v2_evaluation_case(root, "v2-attempt-index", sparse_attempt_index),
        "a non-dense attempt index",
        contains="attempt index is not dense and ascending from one",
    )

    def two_initial_attempts(evaluation, evidence) -> None:
        row = evaluation["rows"][0]
        row["attempts"][1]["attempt_kind"] = "INITIAL"
        row["attempts"][1]["repair_prompt_source"] = None
        row["attempts"][1]["repair_preparation_ns"] = 0
        fixture.bind(row["attempts"][1])
        row["repair_loop_count"] = 0
        fixture.bind(row)

    rejected(
        v2_evaluation_case(root, "v2-two-initial", two_initial_attempts),
        "two initial attempts",
        contains="does not begin with exactly one initial attempt",
    )

    def repair_loop_count_skew(evaluation, evidence) -> None:
        row = evaluation["rows"][0]
        row["repair_loop_count"] = 0
        fixture.bind(row)

    rejected(
        v2_evaluation_case(root, "v2-repair-count", repair_loop_count_skew),
        "a row repair count that is not its repair attempts",
        contains="repair loop count does not match its repair attempts",
    )

    def repair_bound_exceeded(evaluation, evidence) -> None:
        # The corpus manifest is the cap: a second repair is a policy violation, not headroom.
        # A task edit moves its own digest, so the declared-input cascade is rebound with it and
        # the row proves the repair bound rather than a stale snapshot digest.
        for task in evaluation["tasks"]:
            task["regression_limits"]["maximum_repair_loops"] = 0
        fixture.bind_declared_inputs(evaluation)

    rejected(
        v2_evaluation_case(root, "v2-repair-bound", repair_bound_exceeded),
        "more attempts than the task admits",
        contains="carries more attempts than its task admits",
    )

    # --- C4-REPAIR-EDITSET ------------------------------------------------------------------------

    def measurement_version_skew(evaluation, evidence) -> None:
        """Ladder row 11: the corpus names the repair adapter, so version 1 is not admissible."""
        for row in evaluation["rows"]:
            for attempt in row["attempts"]:
                downgrade_measurement(attempt["measurement"])
                attempt["measurement_sha256"] = attempt["measurement"]["content_sha256"]
                fixture.bind(attempt)
            downgrade_measurement(row["measurement"])
            fixture.bind(row)

    def downgrade_measurement(measurement) -> None:
        """Make a fixture measurement version 1 by removing **every** member above version 1.

        The fixture emits version 3 from C4-REPAIR-TEMPLATE on, so a helper that stripped only the
        four version-2 members would leave the version-3 ones behind and every caller below would
        be rejected for the stray it did not plant rather than the one it did. Named explicitly
        rather than read from the validator's own tuples, for the reason the caller states: a
        mutant that empties those tuples must fail these rows, not pass them vacuously.
        """
        for name in (
            "edit_set", "edit_set_total_bytes", "patch_sha256", "base_adapter_runtime_identity",
            "edit_refusal", "completion_bytes", "completion_sha256", "completion_text",
        ):
            measurement.pop(name, None)
        measurement["schema_version"] = 1
        fixture.bind(measurement)

    rejected(
        v2_evaluation_case(root, "v2-measurement-version", measurement_version_skew),
        "a measurement version that disagrees with the adapter its corpus names",
        contains="version disagrees with the adapter its corpus names",
    )

    def editset_block_digest_skew(evaluation, evidence) -> None:
        """Ladder row 15: `body_sha256` digests the redacted bytes `body_text` carries."""
        # One row deliberately carries no edit set, mirroring the wire's mode-2 shape; drift the
        # first row that has one.
        for row in evaluation["rows"]:
            if "edit_set" not in row["measurement"]:
                continue
            for attempt in row["attempts"]:
                block = attempt["measurement"]["edit_set"][0]
                block["body_text"] = block["body_text"] + "# drifted\n"
                fixture.bind(block)
                fixture.bind(attempt["measurement"])
                attempt["measurement_sha256"] = attempt["measurement"]["content_sha256"]
                fixture.bind(attempt)
            block = row["measurement"]["edit_set"][0]
            block["body_text"] = block["body_text"] + "# drifted\n"
            fixture.bind(block)
            fixture.bind(row["measurement"])
            fixture.bind(row)
            break

    rejected(
        v2_evaluation_case(root, "v2-editset-body-digest", editset_block_digest_skew),
        "an edit-set block whose digest does not digest its body",
        contains="body digest does not digest its body text",
    )

    def editset_probe_identity_skew(evaluation, evidence) -> None:
        """Ladder row 12: an attempt-level probe naming another runtime, with the row's left
        correct, so only the attempt-level rule can reject it."""
        row = evaluation["rows"][0]
        attempt = row["attempts"][0]
        attempt["measurement"]["environment_probe"]["runtime_identity"] = "PYTHON:" + "9" * 64
        fixture.bind(attempt["measurement"]["environment_probe"])
        fixture.bind(attempt["measurement"])
        attempt["measurement_sha256"] = attempt["measurement"]["content_sha256"]
        fixture.bind(attempt)
        fixture.bind(row)

    rejected(
        v2_evaluation_case(root, "v2-attempt-probe-identity", editset_probe_identity_skew),
        "an attempt-level probe naming another runtime identity",
        contains="measurement probe names another runtime identity",
    )

    def editset_denominator_skew(evaluation, evidence) -> None:
        """The EDITSET denominator is recomputed, never trusted from the persisted document."""
        evaluation["corpus_aggregate"]["repair_editset_attempt_count"] += 1

    rejected(
        v2_evaluation_case(root, "v2-editset-denominator", editset_denominator_skew),
        "a persisted EDITSET denominator that is not the recomputed one",
        contains="persisted corpus aggregate disagrees with the recomputed value",
    )

    def for_each_editset_measurement(evaluation, mutate) -> None:
        """Apply `mutate` to every persisted measurement that carries an edit set, and rebind.

        Every attempt measurement and every row measurement is edited, because ladder row 18
        compares a row against its final attempt and would otherwise reject the document for a
        reason other than the one under test.
        """
        for row in evaluation["rows"]:
            for attempt in row["attempts"]:
                measurement = attempt["measurement"]
                if "edit_set" not in measurement:
                    continue
                mutate(measurement)
                fixture.bind(measurement)
                attempt["measurement_sha256"] = measurement["content_sha256"]
                fixture.bind(attempt)
            if "edit_set" in row["measurement"]:
                mutate(row["measurement"])
                fixture.bind(row["measurement"])
            fixture.bind(row)

    def editset_path_order_skew(evaluation, evidence) -> None:
        """Ladder row 15's ordering half. The `applied edits:` tail is reversed with the blocks, so
        the row-17 cross-check still agrees and the ordering rule is the only one that can fire."""

        def reverse(measurement) -> None:
            measurement["edit_set"] = list(reversed(measurement["edit_set"]))
            paths = [block["path"] for block in measurement["edit_set"]]
            measurement["diagnostic_summary"] = (
                measurement["diagnostic_summary"].rsplit("applied edits: ", 1)[0]
                + "applied edits: "
                + ", ".join(paths)
            )

        for_each_editset_measurement(evaluation, reverse)

    rejected(
        v2_evaluation_case(root, "v2-editset-path-order", editset_path_order_skew),
        "an edit set whose paths descend rather than ascend",
        contains="edit set paths are not unique and sorted ascending",
    )

    def editset_path_duplicate_skew(evaluation, evidence) -> None:
        """Ladder row 15's uniqueness half, which sorted order alone does not falsify: two blocks
        at the same path are sorted and are still a producer defect."""

        def duplicate(measurement) -> None:
            first = copy.deepcopy(measurement["edit_set"][0])
            measurement["edit_set"] = [measurement["edit_set"][0], first]
            measurement["edit_set_total_bytes"] = sum(
                block["body_bytes"] for block in measurement["edit_set"]
            )
            measurement["diagnostic_summary"] = (
                measurement["diagnostic_summary"].rsplit("applied edits: ", 1)[0]
                + "applied edits: "
                + ", ".join(block["path"] for block in measurement["edit_set"])
            )

        for_each_editset_measurement(evaluation, duplicate)

    rejected(
        v2_evaluation_case(root, "v2-editset-path-duplicate", editset_path_duplicate_skew),
        "an edit set naming the same path twice",
        contains="edit set paths are not unique and sorted ascending",
    )

    def editset_total_skew(evaluation, evidence) -> None:
        """Ladder row 14's sum. `edit_set_total_bytes` is the pre-omission sum of `body_bytes`, and
        no other rule reads it, so this is the only rule that can reject the document."""
        for_each_editset_measurement(
            evaluation,
            lambda measurement: measurement.update(
                {"edit_set_total_bytes": measurement["edit_set_total_bytes"] + 1}
            ),
        )

    rejected(
        v2_evaluation_case(root, "v2-editset-total", editset_total_skew),
        "an edit-set total that is not the sum of its block byte counts",
        contains="edit set total is not the sum of its block byte counts",
    )

    # Ladder row 10 in the direction no bundle can reach. Row 11 requires a version-1 measurement
    # to come from a corpus naming the frozen adapter, and this fixture's corpus names the repair
    # adapter, so a downgraded bundle is rejected by row 11 before row 10 is consulted. The rule is
    # therefore driven directly, exactly as the sibling owner's `editset-row10` case drives
    # `scripts/prompt-evaluate.py`. Without this, every mutant of row 10's version-1 half survived.
    frozen_task = copy.deepcopy(read(accepted, fixture.EVALUATION_NAME)["tasks"][0])
    frozen_task["argv"] = [frozen_task["cmd"]]
    frozen_task["measurement_adapter_runtime"] = fixture.BASE_ADAPTER_RUNTIME
    # The four members are named here rather than read from the validator's own tuple: a mutant
    # that empties that tuple must fail these rows, not pass them vacuously.
    strays = (
        ("edit_set", fixture.edit_set_blocks()),
        ("edit_set_total_bytes", 64),
        ("patch_sha256", "f" * 64),
        ("base_adapter_runtime_identity", fixture.BASE_ADAPTER_RUNTIME),
    )
    for member, value in strays:
        stray = copy.deepcopy(
            read(accepted, fixture.EVALUATION_NAME)["rows"][0]["attempts"][0]["measurement"]
        )
        downgrade_measurement(stray)
        stray[member] = value
        failed = ""
        try:
            validator.validate_measurement_version(stray, frozen_task, "row10 case")
        except validator.GateError as error:
            failed = str(error)
        require(
            f"carries {member} at version 1" in failed,
            f"a version-1 measurement carrying {member} was admitted: {failed!r}",
        )

    # The version-3 half of the same rule at version 1, one member at a time. Without these, a
    # mutant that dropped the below-version-3 absence check would survive every row above.
    for member, value in (
        ("edit_refusal", "NONE"), ("completion_bytes", 1),
        ("completion_sha256", "e" * 64), ("completion_text", "prose"),
    ):
        stray = copy.deepcopy(
            read(accepted, fixture.EVALUATION_NAME)["rows"][0]["attempts"][0]["measurement"]
        )
        downgrade_measurement(stray)
        stray[member] = value
        failed = ""
        try:
            validator.validate_measurement_version(stray, frozen_task, "row15 case")
        except validator.GateError as error:
            failed = str(error)
        require(
            f"carries {member} below version 3" in failed,
            f"a version-1 measurement carrying {member} was admitted: {failed!r}",
        )

    def editset_summary_truncated(evaluation, evidence) -> None:
        """Ladder row 17 is exempt on a **cut** summary, and this is the acceptance case for that
        exemption rather than a rejection: `bounded_text` appends its marker at the end, so the
        applied-edit list is exactly what a cut removes. Without the exemption a legitimate
        measurement with a long summary would be refused as malformed."""

        def truncate(measurement) -> None:
            measurement["diagnostic_summary"] = (
                measurement["diagnostic_summary"].rsplit("applied edits: ", 1)[0]
                + "applied edits: "
                + fixture.EDITSET_PATH
                + "\n[output truncated]"
            )

        for_each_editset_measurement(evaluation, truncate)

    truncated = v2_evaluation_case(root, "v2-editset-summary-truncated", editset_summary_truncated)
    observed, output = invoke(truncated)
    require(
        observed == accepted_code(),
        "a truncated diagnostic summary was refused by the applied-edit cross-check: "
        f"expected exit {accepted_code()}, observed {observed}: {output.strip()}",
    )

    def measurement_not_final(evaluation, evidence) -> None:
        # `unrelated_diff_count` is the drifted field precisely because no aggregate and no other
        # ladder row reads it, so ladder row 18 is the only rule that can reject the document.
        # `patch_size_bytes` no longer works: at version 2 it is tied to `patch_sha256` by row 13,
        # which would reject the row first and shadow the rule under test.
        row = evaluation["rows"][0]
        row["measurement"]["unrelated_diff_count"] = row["measurement"]["unrelated_diff_count"] + 1
        fixture.bind(row["measurement"])
        fixture.bind(row)

    rejected(
        v2_evaluation_case(root, "v2-measurement-binding", measurement_not_final),
        "a row measurement that is not its final attempt's",
        contains="measurement is not its final attempt's measurement",
    )

    def timing_sum_skew(evaluation, evidence) -> None:
        row = next(item for item in evaluation["rows"] if "generation_to_passing_patch_ns" in item)
        row["generation_to_passing_patch_ns"] += 1
        row["time_to_passing_patch_ns"] += 1
        fixture.bind(row)

    rejected(
        v2_evaluation_case(root, "v2-timing-sum", timing_sum_skew),
        "a generation total that is not the attempt sum",
        contains="generation total is not the sum of its attempts",
    )

    def overhead_on_failing_attempt(evaluation, evidence) -> None:
        row = evaluation["rows"][0]
        row["attempts"][0]["adapter_overhead_ns"] = 1
        fixture.bind(row["attempts"][0])
        fixture.bind(row)

    rejected(
        v2_evaluation_case(root, "v2-overhead-presence", overhead_on_failing_attempt),
        "adapter overhead on a failing attempt",
        contains="adapter overhead presence does not agree with its status",
    )

    def adapter_repair_count(evaluation, evidence) -> None:
        # Each adapter invocation is single-attempt, so a nonzero adapter repair count would
        # double-count against the evaluator-owned row total.
        row = evaluation["rows"][0]
        row["attempts"][0]["measurement"]["repair_loop_count"] = 1
        fixture.bind(row["attempts"][0]["measurement"])
        row["attempts"][0]["measurement_sha256"] = row["attempts"][0]["measurement"][
            "content_sha256"
        ]
        fixture.bind(row["attempts"][0])
        fixture.bind(row)

    rejected(
        v2_evaluation_case(root, "v2-adapter-repair-count", adapter_repair_count),
        "an adapter-reported repair loop",
        contains="adapter reported a repair loop it cannot run",
    )

    def skipped_attempt_with_a_run(evaluation, evidence) -> None:
        row = evaluation["rows"][0]
        row["attempts"][1]["status"] = "SKIPPED"
        row["attempts"][1]["skip_reason"] = "REPAIR_PROMPT_BUDGET"
        fixture.bind(row["attempts"][1])
        row["repair_loop_count"] = 0
        fixture.bind(row)

    rejected(
        v2_evaluation_case(root, "v2-skipped-carries-run", skipped_attempt_with_a_run),
        "a skipped attempt that carries a run",
        contains="carries rendered_prompt_sha256 against its status",
    )

    def attempt_trace_unbound(evaluation, evidence) -> None:
        # One positional attestation per row cannot reach a repair invocation's trace records, so
        # the attempt record is what binds them. A well-formed digest that names no persisted
        # record must be rejected, not merely a missing one.
        row = evaluation["rows"][0]
        row["attempts"][1]["input_snapshot_sha256"] = "f" * 64
        fixture.bind(row["attempts"][1])
        fixture.bind(row)

    rejected(
        v2_evaluation_case(root, "v2-attempt-trace-unbound", attempt_trace_unbound),
        "an attempt trace digest that names no persisted record",
        contains="input_snapshot_sha256 names no persisted record",
    )

    def attempt_trace_missing(evaluation, evidence) -> None:
        row = evaluation["rows"][0]
        row["attempts"][1]["snapshot_request_sha256"] = None
        fixture.bind(row["attempts"][1])
        fixture.bind(row)

    rejected(
        v2_evaluation_case(root, "v2-attempt-trace-missing", attempt_trace_missing),
        "an attempt that ran and attests no snapshot request",
        contains="omits snapshot_request_sha256 against its status",
    )

    def dropped_status_section(evaluation, evidence) -> None:
        row = evaluation["rows"][0]
        source = row["attempts"][1]["repair_prompt_source"]
        source["included_sections"] = ["SUMMARY", "STDOUT", "STDERR"]
        source["dropped_sections"] = ["STATUS"]
        fixture.bind(source)
        fixture.bind(row["attempts"][1])
        fixture.bind(row)

    rejected(
        v2_evaluation_case(root, "v2-repair-source-status", dropped_status_section),
        "a repair prompt source that drops STATUS",
        contains="drops the STATUS section",
    )

    def repair_source_on_initial(evaluation, evidence) -> None:
        row = evaluation["rows"][0]
        row["attempts"][0]["repair_prompt_source"] = copy.deepcopy(
            row["attempts"][1]["repair_prompt_source"]
        )
        fixture.bind(row["attempts"][0])
        fixture.bind(row)

    rejected(
        v2_evaluation_case(root, "v2-repair-source-initial", repair_source_on_initial),
        "a repair prompt source on the initial attempt",
        contains="initial attempt carries a repair prompt source",
    )

    def duplicate_attempt_identity(evaluation, evidence) -> None:
        evidence["expected_inputs"][1] = copy.deepcopy(evidence["expected_inputs"][0])

    rejected(
        v2_evaluation_case(root, "v2-expected-duplicate", duplicate_attempt_identity),
        "a duplicated attempt identity",
        contains="is out of attempt order",
    )

    def missing_attempt_identity(evaluation, evidence) -> None:
        del evidence["expected_inputs"][1]

    rejected(
        v2_evaluation_case(root, "v2-expected-missing", missing_attempt_identity),
        "a missing attempt identity",
        contains="do not cover every attempt exactly once",
    )

    def extra_attempt_identity(evaluation, evidence) -> None:
        evidence["expected_inputs"].append(copy.deepcopy(evidence["expected_inputs"][-1]))

    rejected(
        v2_evaluation_case(root, "v2-expected-extra", extra_attempt_identity),
        "an extra attempt identity",
        contains="do not cover every attempt exactly once",
    )

    def expected_input_content_skew(evaluation, evidence) -> None:
        expected = evidence["expected_inputs"][0]
        expected["adapter_request_sha256"] = "0" * 64
        fixture.bind(expected)

    rejected(
        v2_evaluation_case(root, "v2-expected-content", expected_input_content_skew),
        "an attempt digest that is not its attempt's",
        contains="adapter_request_sha256 does not match its attempt",
    )

    def parent_repair_loops_exceed(evaluation, evidence) -> None:
        # The variant-symmetric check: a PARENT row above its task cap was checked nowhere before.
        row = next(item for item in evaluation["rows"] if item["variant"] == "PARENT")
        row["repair_loop_count"] = 2
        fixture.bind(row)

    rejected(
        v2_evaluation_case(root, "v2-parent-repair-loops", parent_repair_loops_exceed),
        "a parent row above its repair cap",
        contains="repair loop count does not match its repair attempts",
    )

    def aggregate_not_recomputed(evaluation, evidence) -> None:
        evaluation["corpus_aggregate"]["repair_recovery_paired_count"] = 3

    rejected(
        v2_evaluation_case(root, "v2-aggregate-recompute", aggregate_not_recomputed),
        "a persisted repair aggregate the verifier does not recompute",
        contains="persisted corpus aggregate disagrees with the recomputed value",
    )
    version_three_rows(root)


def refused_attempt(evaluation: dict[str, Any]) -> dict[str, Any]:
    """The one fixture attempt that records a refusal, which is the shape every v3 rule turns on."""
    for row in evaluation["rows"]:
        for attempt in row["attempts"]:
            measurement = attempt.get("measurement") or {}
            if measurement.get("edit_refusal") not in (None, "NONE"):
                return attempt
    raise SmokeFailure("the version-3 fixture records no refused attempt")


def passing_attempt(evaluation: dict[str, Any]) -> dict[str, Any]:
    for row in evaluation["rows"]:
        for attempt in row["attempts"]:
            measurement = attempt.get("measurement") or {}
            if measurement.get("edit_refusal") == "NONE":
                return attempt
    raise SmokeFailure("the version-3 fixture records no unrefused attempt")


def rebound_measurement(row_attempt: dict[str, Any]) -> None:
    """Rebind an edited measurement and every digest the attempt and row pin it by."""
    fixture.bind(row_attempt["measurement"])
    row_attempt["measurement_sha256"] = row_attempt["measurement"]["content_sha256"]
    fixture.bind(row_attempt)


def version_three_rows(root: Path) -> None:
    """Section 6.1: the version-3 presence rules and section 3.3 invariants, one defect each.

    Every case mutates the **persisted wire form**, which is where the rules are actually read, and
    each one is a shape a producer that stopped mapping a raise site or stopped tying the code to
    the record would emit. The unmutated fixture already carries a refused attempt with the three
    `Option` members the wire omits, so the positive direction is covered by every other row here.
    """

    def unknown_code(evaluation, evidence) -> None:
        attempt = refused_attempt(evaluation)
        attempt["measurement"]["edit_refusal"] = "NO_SUCH_REFUSAL"
        rebound_measurement(attempt)

    rejected(
        v2_evaluation_case(root, "v3-unknown-refusal", unknown_code),
        "an edit refusal outside the ten-code vocabulary",
        contains="carries no valid edit refusal code at version 3",
    )

    def silent_none(evaluation, evidence) -> None:
        # The defect this capability exists to make impossible: `failure_kind: PATCH` beside a
        # refusal code of `NONE`, which is what every row of both prior gate runs would look like.
        attempt = refused_attempt(evaluation)
        attempt["measurement"]["edit_refusal"] = "NONE"
        rebound_measurement(attempt)

    rejected(
        v2_evaluation_case(root, "v3-silent-none", silent_none),
        "a PATCH failure carrying no refusal code",
        contains="refusal class disagrees with its failure kind",
    )

    def unchanged_without_blocks(evaluation, evidence) -> None:
        # The invariant this capability exists to establish, inverted.
        attempt = refused_attempt(evaluation)
        attempt["measurement"]["edit_refusal"] = "UNCHANGED_FILES"
        attempt["measurement"]["diagnostic_summary"] = (
            "the response reproduced the pinned files unchanged"
        )
        rebound_measurement(attempt)

    rejected(
        v2_evaluation_case(root, "v3-unchanged-no-blocks", unchanged_without_blocks),
        "a reproduced-unchanged refusal that discarded its blocks",
        contains="discarded the blocks its refusal was computed from",
    )

    def text_on_passing_row(evaluation, evidence) -> None:
        attempt = passing_attempt(evaluation)
        attempt["measurement"]["completion_text"] = "unstructured prose"
        rebound_measurement(attempt)

    rejected(
        v2_evaluation_case(root, "v3-text-unrefused", text_on_passing_row),
        "a completion excerpt persisted where the edit set already explains the failure",
        contains="persists a completion excerpt where the edit set explains it",
    )

    def identity_half_present(evaluation, evidence) -> None:
        attempt = passing_attempt(evaluation)
        del attempt["measurement"]["completion_bytes"]
        rebound_measurement(attempt)

    rejected(
        v2_evaluation_case(root, "v3-identity-half", identity_half_present),
        "a completion digest with no completion length",
        contains="completion identity members disagree on presence",
    )

    # Absence below version 3 is required, never defaulted, and the cheapest place to prove it is
    # against the **real** frozen version-2 chain rather than a rebuilt approximation: that is the
    # document a version-3-shaped decoder would delete. Driven in process, because the mutation is
    # one key on one measurement and rebuilding the bundle's whole digest cascade around it would
    # test the cascade rather than the rule.
    frozen = json.loads((FROZEN_C4E_GATE / "c4-editset-evaluation.json").read_text("utf-8"))
    task = frozen["tasks"][0]
    measurement = copy.deepcopy(frozen["rows"][0]["measurement"])
    validator.validate_measurement_version(measurement, task, "unmutated version-2 measurement")
    for member in ("edit_refusal", "completion_bytes", "completion_sha256", "completion_text"):
        mutated = copy.deepcopy(measurement)
        mutated[member] = "NONE" if member.endswith(("refusal", "text", "sha256")) else 0
        try:
            validator.validate_measurement_version(mutated, task, "version-2 measurement")
        except validator.GateError as failure:
            require(
                "below version 3" in str(failure),
                f"a version-2 measurement carrying {member} was rejected for another reason",
            )
        else:
            raise SmokeFailure(f"a version-2 measurement carrying {member} was accepted")

    def refusal_aggregate_not_recomputed(evaluation, evidence) -> None:
        evaluation["corpus_aggregate"]["edit_refusal_count"] = 99

    rejected(
        v2_evaluation_case(root, "v3-refusal-aggregate", refusal_aggregate_not_recomputed),
        "a persisted refusal counter the verifier does not recompute",
        contains="persisted corpus aggregate disagrees with the recomputed value",
    )


def frozen_version_one_chain() -> None:
    """The frozen version-1 chain still validates and rescores byte-identically.

    `make prompt-gate-check` is the full proof, but it needs a source bundle and a Linux floor.
    This drives the same two functions directly against the merged C6-MEASURED evidence, so a
    version-2-only decoder cannot silently delete C6's acceptance evidence.
    """
    result = json.loads((FROZEN_GATE / "prompt-evaluation-improved.json").read_text("utf-8"))
    evidence = json.loads(
        (FROZEN_GATE / "prompt-evaluation-improved-evidence.json").read_text("utf-8")
    )
    require(
        result["schema_version"] == 1 and evidence["schema_version"] == 1,
        "the frozen C6 chain is no longer version 1",
    )
    policy = validator.validate_acceptance_policy(result["acceptance_policy"])
    status, aggregates, corpus, reasons = validator.rescore(result, policy)
    require(status == "IMPROVED" and not reasons, f"the frozen chain no longer rescores: {status}")
    for persisted, computed in zip(result["task_aggregates"], aggregates):
        require(
            validator.completed_record(persisted, validator.TASK_AGGREGATE_FIELDS) == computed,
            "a frozen task aggregate no longer rescores byte-identically",
        )
    require(
        validator.completed_record(result["corpus_aggregate"], validator.CORPUS_AGGREGATE_FIELDS)
        == corpus,
        "the frozen corpus aggregate no longer rescores byte-identically",
    )
    require(
        "repair_attempt_count" not in corpus,
        "a version-1 rescore grew a version-2 aggregate field",
    )
    validator.validate_evaluation_pair(copy.deepcopy(result), copy.deepcopy(evidence))
    # A version-1 row's repair authority is, and stays, its measurement. The frozen chain carries
    # zero everywhere, which would let a row-level reader pass unnoticed, so the source of truth is
    # asserted against a nonzero value rather than against the frozen zeros.
    sourced = copy.deepcopy(result)
    parent_row = next(item for item in sourced["rows"] if item["variant"] == "PARENT")
    candidate_row = next(item for item in sourced["rows"] if item["variant"] == "CANDIDATE")
    parent_row["measurement"]["repair_loop_count"] = 3
    candidate_row["measurement"]["repair_loop_count"] = 2
    for task in sourced["tasks"]:
        task["regression_limits"]["maximum_repair_loops"] = 8
    _, sourced_aggregates, sourced_corpus, _ = validator.rescore(sourced, policy)
    selected = next(
        item for item in sourced_aggregates if item["task_id"] == parent_row["task_id"]
    )
    require(
        selected["parent_repair_loop_count"] == 3
        and selected["candidate_repair_loop_count"] == 2,
        f"a version-1 repair count is no longer sourced from its measurement: {selected!r}",
    )
    require(
        sourced_corpus["parent_repair_loop_count"] == 3
        and sourced_corpus["candidate_repair_loop_count"] == 2,
        f"a version-1 corpus repair count is no longer measurement-sourced: {sourced_corpus!r}",
    )


def frozen_version_two_chain() -> None:
    """The frozen C4-REPAIR-MEASURED version-2 chain still validates and rescores unchanged.

    Two merged evidence chains now depend on version-1 **measurement** decode — C6's and C4's — and
    `make prompt-gate-check` is unavailable on this host. This is the second half of the substitute
    C4-REPAIR-MEASURED established: the C4 result is a version-2 document whose rows carry
    version-1 measurements from the frozen adapter, which is exactly the combination a
    version-2-shaped measurement decoder could delete.

    `validate_evaluation_pair` is not used here: that function requires `IMPROVED` and
    `gate_eligible`, and this run is a published measured negative with two `POLICY` reasons. The
    row, attempt, measurement, and aggregate walks it would reach are driven directly instead, so
    the coverage is the same and the entry point is the one this document can legitimately take.
    """
    result = json.loads((FROZEN_C4_GATE / "c4-repair-evaluation.json").read_text("utf-8"))
    require(
        result["schema_version"] == 2,
        "the frozen C4 chain is no longer version 2",
    )
    require(
        all(row["measurement"]["schema_version"] == 1 for row in result["rows"]),
        "the frozen C4 chain no longer carries version-1 measurements",
    )
    policy = validator.validate_acceptance_policy(result["acceptance_policy"])
    status, aggregates, corpus, _ = validator.rescore(result, policy)
    require(
        status == result["status"],
        f"the frozen C4 chain no longer rescores to {result['status']}: {status}",
    )
    for persisted, computed in zip(result["task_aggregates"], aggregates):
        require(
            validator.completed_record(persisted, validator.TASK_AGGREGATE_V2_FIELDS)
            == validator.completed_record(computed, validator.TASK_AGGREGATE_V2_FIELDS),
            "a frozen C4 task aggregate no longer rescores byte-identically",
        )
    require(
        validator.completed_record(
            result["corpus_aggregate"], validator.CORPUS_AGGREGATE_V2_FIELDS
        )
        == validator.completed_record(corpus, validator.CORPUS_AGGREGATE_V2_FIELDS),
        "the frozen C4 corpus aggregate no longer rescores byte-identically",
    )
    # The C4 run predates `EDITSET`, so the denominator it recomputes to is zero — and a zero here
    # is the correct published statement about that run rather than an absence.
    # The C4 run predates `EDITSET` and its corpus names the frozen adapter, so the denominator is
    # undefined for it rather than zero, and it is absent on both sides. That is what keeps the
    # merged C4 evidence valid under a decoder that knows about the section.
    require(
        "repair_editset_attempt_count" not in corpus,
        "a frozen-adapter corpus recomputed an EDITSET denominator",
    )
    require(
        corpus["repair_recovery_paired_count"] == 0 and corpus["repair_attempt_count"] == 10,
        f"the frozen C4 chain's measured negative moved: {corpus!r}",
    )
    # The row, attempt, and measurement walks, driven directly against the merged evidence.
    pools = validator.validate_snapshot_closure(result, result["rows"])
    tasks_by_id = {task["task_id"]: task for task in result["tasks"]}
    generation_policy = result["generation_policy"]
    for index, row in enumerate(result["rows"]):
        task = tasks_by_id[row["task_id"]]
        validator.validate_measurement_version(
            row["measurement"], task, f"frozen C4 row {index} measurement",
        )
        validator.validate_measurement_probe(row["measurement"], task, f"frozen C4 row {index}")
        validator.validate_attempts(
            row, task, generation_policy, pools, f"frozen C4 row {index}",
        )


def frozen_editset_chain() -> None:
    """The frozen C4-REPAIR-EDITSET chain still validates and rescores unchanged.

    The **third** merged chain, and the one a version-3-shaped decoder is most likely to delete:
    unlike C6's and C4's, its rows carry version-2 *measurements*, so every version-3 presence rule
    written as key-presence rather than as a version-selected shape would reject it. That is the
    incident class `c4-repair-editset.md` section 11.3 deviations 2 and 13 record, twice each; this
    row is what makes a third repetition impossible.

    `validate_evaluation_pair` is not used, for the reason the C4 regression records: this is a
    published measured negative, not an `IMPROVED` acceptance. The row, attempt, measurement, and
    aggregate walks it would reach are driven directly instead.
    """
    result = json.loads((FROZEN_C4E_GATE / "c4-editset-evaluation.json").read_text("utf-8"))
    require(result["schema_version"] == 2, "the frozen C4E chain is no longer version 2")
    require(
        all(row["measurement"]["schema_version"] == 2 for row in result["rows"]),
        "the frozen C4E chain no longer carries version-2 measurements",
    )
    policy = validator.validate_acceptance_policy(result["acceptance_policy"])
    status, aggregates, corpus, _ = validator.rescore(result, policy)
    require(
        status == result["status"],
        f"the frozen C4E chain no longer rescores to {result['status']}: {status}",
    )
    for persisted, computed in zip(result["task_aggregates"], aggregates):
        require(
            validator.completed_record(persisted, validator.TASK_AGGREGATE_V2_FIELDS)
            == validator.completed_record(computed, validator.TASK_AGGREGATE_V2_FIELDS),
            "a frozen C4E task aggregate no longer rescores byte-identically",
        )
    require(
        validator.completed_record(
            result["corpus_aggregate"], validator.CORPUS_AGGREGATE_V2_FIELDS
        )
        == validator.completed_record(corpus, validator.CORPUS_AGGREGATE_V2_FIELDS),
        "the frozen C4E corpus aggregate no longer rescores byte-identically",
    )
    # The C4E corpus names the repair adapter, so its `EDITSET` denominator is defined and its
    # refusal counter is not: the second is undefined for a corpus whose adapter cannot persist
    # `edit_refusal`, and absent is the correct published statement rather than zero.
    require(
        corpus["repair_editset_attempt_count"] == 6,
        f"the frozen C4E EDITSET denominator moved: {corpus!r}",
    )
    require(
        "edit_refusal_count" not in corpus,
        "a repair-adapter corpus recomputed an edit-refusal counter",
    )
    require(
        all(
            "parent_edit_refusal_count" not in aggregate for aggregate in aggregates
        ),
        "a repair-adapter task aggregate recomputed an edit-refusal counter",
    )
    require(
        corpus["repair_recovery_paired_count"] == 0 and corpus["repair_attempt_count"] == 10,
        f"the frozen C4E measured negative moved: {corpus!r}",
    )
    pools = validator.validate_snapshot_closure(result, result["rows"])
    tasks_by_id = {task["task_id"]: task for task in result["tasks"]}
    generation_policy = result["generation_policy"]
    for index, row in enumerate(result["rows"]):
        task = tasks_by_id[row["task_id"]]
        validator.validate_measurement_version(
            row["measurement"], task, f"frozen C4E row {index} measurement",
        )
        validator.validate_measurement_probe(row["measurement"], task, f"frozen C4E row {index}")
        validator.validate_attempts(row, task, generation_policy, pools, f"frozen C4E row {index}")


def frozen_corpus_rows() -> None:
    """The non-mutation proof, read straight off the two file-set manifests.

    Every member `canonical-v1r` shares with `canonical-v1` carries the same digest in both, which
    is the machine-checkable statement that this capability moved neither the measurement adapter,
    the validation runner, nor any fixture.
    """

    def members(path: Path) -> dict[str, str]:
        entries: dict[str, str] = {}
        for line in path.read_bytes().split(b"\n")[2:]:
            if not line:
                continue
            head, _, rest = line.partition(b"\0")
            _, _, remainder = head.partition(b" ")
            length, _, relative = remainder.partition(b" ")
            require(
                len(relative) == int(length),
                "a corpus manifest entry length disagrees with its path",
            )
            entries[relative.decode("utf-8")] = rest.split(b" ")[1].decode("ascii")
        return entries

    frozen = members(PROJECT_ROOT / "eval/prompt/canonical-v1/corpus-file-set.manifest")
    repair = members(PROJECT_ROOT / "eval/prompt/canonical-v1r/corpus-file-set.manifest")
    editset = members(PROJECT_ROOT / "eval/prompt/canonical-v1e/corpus-file-set.manifest")
    require(
        (len(frozen), len(repair), len(editset)) == (27, 29, 30),
        f"the three corpora declare {len(frozen)}/{len(repair)}/{len(editset)} members",
    )
    shared = sorted(set(frozen) & set(repair) & set(editset))
    require(len(shared) == 24, f"the three corpora share {len(shared)} members, not 24")
    for relative in shared:
        require(
            frozen[relative] == repair[relative] == editset[relative],
            f"a shared corpus member moved between the three freezes: {relative}",
        )
    for name in (
        "eval/runners/run-coding-task.py",
        "scripts/prompt-measurement-adapter.py",
        "scripts/prompt-fixed-adapter.py",
        "scripts/prompt-snapshot-helper.py",
    ):
        require(name in shared, f"{name} is not a shared member of all three corpora")
    # The base adapter's three independent pins agree: the file-set manifests, the repair adapter's
    # own hard-coded constant, and the file's own bytes. Ladder row 3.
    base = "scripts/prompt-measurement-adapter.py"
    base_digest = hashlib.sha256((PROJECT_ROOT / base).read_bytes()).hexdigest()
    require(
        frozen[base] == repair[base] == editset[base] == base_digest,
        "the base adapter's manifest digests disagree with its own bytes",
    )
    require(
        f'BASE_ADAPTER_SHA256 = "{base_digest}"'
        in (PROJECT_ROOT / "scripts/prompt-repair-adapter.py").read_text("utf-8"),
        "the repair adapter's BASE_ADAPTER_SHA256 disagrees with the frozen manifests",
    )
    editset_added = sorted(set(editset) - set(frozen) - set(repair))
    require(
        editset_added
        == [
            "eval/prompt/canonical-v1e/generation-policy.json",
            "eval/prompt/canonical-v1e/repair-template.json",
            "eval/tasks/prompt-v1e/duration-half-away-from-zero.json",
            "eval/tasks/prompt-v1e/layer-precedence-frozen-module.json",
            "eval/tasks/prompt-v1e/record-codec-round-trip.json",
            "scripts/prompt-repair-adapter.py",
        ],
        f"the editset corpus adds an unexpected member set: {editset_added}",
    )
    for relative, digest in editset.items():
        path = PROJECT_ROOT / relative
        require(path.is_file(), f"an editset corpus member is missing: {relative}")
        require(
            hashlib.sha256(path.read_bytes()).hexdigest() == digest,
            f"an editset corpus member drifted from its manifest digest: {relative}",
        )
    # Every `prompt-v1e` task names both adapters and the five-kind template (ladder rows 5 and 8).
    for relative in editset_added:
        if not relative.startswith("eval/tasks/prompt-v1e/"):
            continue
        task = json.loads((PROJECT_ROOT / relative).read_text("utf-8"))
        declared = {item["path"] for item in task["artifacts"] if item["kind"] == "FILE"}
        require(
            {base, "scripts/prompt-repair-adapter.py"} <= declared,
            f"an editset task does not declare both adapters: {relative}",
        )
        require(
            task["argv"] == [task["cmd"], "scripts/prompt-repair-adapter.py"],
            f"an editset task does not name the repair adapter: {relative}",
        )
        require(
            task["measurement_adapter_runtime"]
            == "PYTHON:" + editset["scripts/prompt-repair-adapter.py"],
            f"an editset task does not pin the repair adapter's digest: {relative}",
        )
        require(
            task["repair_template_path"] == "eval/prompt/canonical-v1e/repair-template.json",
            f"an editset task does not pin the five-kind template: {relative}",
        )
    template = json.loads(
        (PROJECT_ROOT / "eval/prompt/canonical-v1e/repair-template.json").read_text("utf-8")
    )
    require(
        tuple(template["section_headers"]) == ("STATUS", "EDITSET", "SUMMARY", "STDOUT", "STDERR"),
        "the editset template does not declare the five section kinds in order",
    )
    added = sorted(set(repair) - set(frozen))
    require(
        added
        == [
            "eval/prompt/canonical-v1r/generation-policy.json",
            "eval/prompt/canonical-v1r/repair-template.json",
            "eval/tasks/prompt-v1r/duration-half-away-from-zero.json",
            "eval/tasks/prompt-v1r/layer-precedence-frozen-module.json",
            "eval/tasks/prompt-v1r/record-codec-round-trip.json",
        ],
        f"the repair corpus adds an unexpected member set: {added}",
    )
    # Every declared member's bytes still hash to the digest the manifest froze.
    for relative, digest in repair.items():
        path = PROJECT_ROOT / relative
        require(path.is_file(), f"a frozen corpus member is missing: {relative}")
        require(
            hashlib.sha256(path.read_bytes()).hexdigest() == digest,
            f"a frozen corpus member drifted from its manifest digest: {relative}",
        )
    # The repair bound is exactly one: the manifest itself is the cap.
    for relative in added:
        if not relative.startswith("eval/tasks/prompt-v1r/"):
            continue
        task = json.loads((PROJECT_ROOT / relative).read_text("utf-8"))
        require(
            task["regression_limits"]["maximum_repair_loops"] == 1,
            f"a repair-corpus task does not declare exactly one repair loop: {relative}",
        )
        require(
            task["repair_template_path"] == "eval/prompt/canonical-v1r/repair-template.json"
            and task["repair_template_sha256"] == repair[task["repair_template_path"]],
            f"a repair-corpus task does not pin the sealed template: {relative}",
        )


# --- family: source-bundle -----------------------------------------------------------


def family_source_bundle(root: Path) -> None:
    bundle = case(root, "explicit-inputs")
    complete = bundle.arguments()

    def without(flag: str) -> list[str]:
        index = complete.index(flag)
        return complete[:index] + complete[index + 2 :]

    def replaced(flag: str, value: str) -> list[str]:
        values = list(complete)
        values[values.index(flag) + 1] = value
        return values

    for flag, ambient in (
        ("--source-bundle-root", "C6_GATE_SOURCE_BUNDLE_ROOT"),
        ("--python-executable-path", "C6_GATE_PYTHON_EXECUTABLE_PATH"),
        ("--git-executable-path", "C6_GATE_GIT_EXECUTABLE_PATH"),
        ("--generation-child-path", "C6_GATE_GENERATION_CHILD_PATH"),
    ):
        rejected(bundle, f"missing {flag}", arguments=without(flag), code=1)
        rejected(
            bundle,
            f"ambient {ambient} is not a fallback for {flag}",
            arguments=without(flag),
            environment={ambient: complete[complete.index(flag) + 1]},
            code=1,
        )
        rejected(bundle, f"empty {flag}", arguments=replaced(flag, ""), code=1)
        rejected(bundle, f"relative {flag}", arguments=replaced(flag, "relative/path"), code=1)
        rejected(
            bundle,
            f"unsafe {flag}",
            arguments=replaced(flag, f"{bundle.bundle_root}/../source-bundle"),
            code=1,
        )
        rejected(
            bundle,
            f"unreadable {flag}",
            arguments=replaced(flag, str(root / "absent" / "path")),
            code=1,
        )

    # The declared generation-child digest is the fourth pair's second half: it has no ambient
    # fallback, must be a lowercase SHA-256, and must equal the retained binary's bytes.
    digest_flag = "--generation-child-sha256"
    rejected(bundle, f"missing {digest_flag}", arguments=without(digest_flag), code=1)
    rejected(
        bundle,
        f"ambient C6_GATE_GENERATION_CHILD_SHA256 is not a fallback for {digest_flag}",
        arguments=without(digest_flag),
        environment={"C6_GATE_GENERATION_CHILD_SHA256": bundle.generation_child_sha256},
        code=1,
    )
    for label, value in (
        ("empty", ""),
        ("non-hexadecimal", "z" * 64),
        ("uppercase", bundle.generation_child_sha256.upper()),
        ("short", bundle.generation_child_sha256[:63]),
        ("long", bundle.generation_child_sha256 + "0"),
    ):
        rejected(
            bundle,
            f"{label} {digest_flag}",
            arguments=replaced(digest_flag, value),
            code=1,
        )
    rejected(
        bundle,
        "declared generation-child digest does not match the supplied binary",
        arguments=replaced(digest_flag, "0" * 64),
        code=1,
    )

    directory = root / "not-an-executable"
    directory.mkdir()
    rejected(
        bundle,
        "directory Python executable",
        arguments=replaced("--python-executable-path", str(directory)),
        code=1,
    )
    plain = root / "plain-file"
    plain.write_text("not executable\n")
    rejected(
        bundle,
        "non-executable Git tool",
        arguments=replaced("--git-executable-path", str(plain)),
        code=1,
    )
    link = root / "python-symlink"
    link.symlink_to(bundle.python_executable)
    rejected(
        bundle,
        "symlink Python executable",
        arguments=replaced("--python-executable-path", str(link)),
        code=1,
    )

    child_link = root / "generation-child-symlink"
    child_link.symlink_to(bundle.generation_child)
    empty_child = root / "empty-generation-child"
    empty_child.write_bytes(b"")
    empty_child.chmod(0o755)
    for label, value in (
        ("symlink", str(child_link)),
        ("non-executable", str(plain)),
        ("directory", str(directory)),
        ("empty", str(empty_child)),
    ):
        rejected(
            bundle,
            f"{label} generation child",
            arguments=replaced("--generation-child-path", value),
            code=1,
        )


# --- family: source-revalidation -----------------------------------------------------


def with_locator(bundle, mutate: Callable[[dict[str, Any]], None]) -> None:
    manifest = read(bundle, fixture.MANIFEST_NAME)
    mutate(manifest["source_locator"])
    fixture.bind(manifest["source_locator"])
    store(bundle, fixture.MANIFEST_NAME, fixture.bind(manifest))


def family_source_revalidation(root: Path) -> None:
    def policy_digest(bundle) -> None:
        with_locator(bundle, lambda locator: locator.update(source_verifier_policy_sha256="0" * 64))

    rejected(case(root, "policy-digest", policy_digest), "source verifier policy digest")

    def helper_digest(bundle) -> None:
        def mutate(locator: dict[str, Any]) -> None:
            locator["source_verifier_sha256"] = "1" * 64
            locator["source_verifier_runtime"] = (
                f"CPYTHON:{locator['source_verifier_interpreter_sha256']}:{'1' * 64}"
            )

        with_locator(bundle, mutate)

    rejected(case(root, "helper-digest", helper_digest), "source verifier helper digest")

    def runtime_identity(bundle) -> None:
        with_locator(bundle, lambda locator: locator.update(source_verifier_runtime="CPYTHON:x:y"))

    rejected(case(root, "runtime-identity", runtime_identity), "source verifier runtime identity")

    def interpreter_digest(bundle) -> None:
        with_locator(
            bundle, lambda locator: locator.update(source_verifier_interpreter_sha256="2" * 64)
        )

    rejected(case(root, "interpreter-digest", interpreter_digest), "interpreter digest")

    def git_digest(bundle) -> None:
        with_locator(bundle, lambda locator: locator.update(git_executable_sha256="3" * 64))

    rejected(case(root, "git-digest", git_digest), "Git executable digest")

    def generation_child_digest(bundle) -> None:
        """The supplied per-run digest disagrees with the evidence-recorded identity."""
        with_locator(bundle, lambda locator: locator.update(generation_child_sha256="4" * 64))

    rejected(
        case(root, "generation-child-digest", generation_child_digest),
        "evidence-recorded generation child identity",
    )

    def helper_bytes(bundle) -> None:
        target = bundle.bundle_root / fixture.VERIFIER_RELATIVE
        target.write_bytes(target.read_bytes() + b"# tampered\n")

    rejected(case(root, "helper-bytes", helper_bytes), "tampered source verifier bytes")

    def absolute_locator_path(bundle) -> None:
        with_locator(bundle, lambda locator: locator.update(align_llm_source_relative_path="/etc"))

    rejected(case(root, "absolute-path", absolute_locator_path), "absolute locator path")

    def parent_locator_path(bundle) -> None:
        with_locator(
            bundle, lambda locator: locator.update(corpus_source_relative_path="../corpus")
        )

    rejected(case(root, "parent-path", parent_locator_path), "parent component locator path")

    def source_is_a_file(bundle) -> None:
        with_locator(
            bundle,
            lambda locator: locator.update(align_source_relative_path=fixture.POLICY_RELATIVE),
        )

    rejected(case(root, "expected-type", source_is_a_file), "locator directory expected type")

    def policy_is_a_symlink(bundle) -> None:
        target = bundle.bundle_root / fixture.POLICY_RELATIVE
        moved = bundle.bundle_root / "policy-real.json"
        target.rename(moved)
        target.symlink_to(moved)

    rejected(case(root, "policy-symlink", policy_is_a_symlink), "source verifier policy symlink")

    def policy_helper_disagrees(bundle) -> None:
        path = bundle.bundle_root / fixture.POLICY_RELATIVE
        policy = json.loads(path.read_text("utf-8"))
        policy["helper_path"] = "other-verifier.py"
        path.write_bytes(fixture.canonical_bytes(fixture.bind(policy)))
        with_locator(
            bundle,
            lambda locator: locator.update(source_verifier_policy_sha256=policy["content_sha256"]),
        )

    rejected(case(root, "policy-helper", policy_helper_disagrees), "policy helper path disagrees")

    def file_set_pairing(bundle) -> None:
        with_locator(
            bundle,
            lambda locator: locator.update(
                corpus_file_set_manifest_relative_path=fixture.POLICY_RELATIVE
            ),
        )

    rejected(case(root, "file-set-pairing", file_set_pairing), "file-set manifest pairing")


# --- families: raw Git metadata ------------------------------------------------------


def git_directory(repository: Path) -> Path:
    return repository / ".git"


def family_git_replacement_graft(root: Path) -> None:
    entries = (
        Path("refs") / "replace",
        Path("info") / "grafts",
        Path("objects") / "info" / "alternates",
    )
    for index, entry in enumerate(entries):
        for scope in ("ci", "bundle"):

            def plant(bundle, entry=entry, scope=scope) -> None:
                repository = bundle.checkout if scope == "ci" else bundle.bundle_root / "align-llm"
                target = git_directory(repository) / entry
                target.parent.mkdir(parents=True, exist_ok=True)
                if entry.name == "replace":
                    target.mkdir(exist_ok=True)
                    (target / ("0" * 40)).write_text("")
                else:
                    target.write_text("")

            bundle = build(root, f"graft-{scope}-{index}")
            bundle.finalize()
            plant(bundle)
            rejected(bundle, f"{scope} {entry} metadata")


def family_local_git_config(root: Path) -> None:
    hostile = (
        ("hooks-path", "[core]\n\thooksPath = /tmp/hooks\n"),
        ("include", "[include]\n\tpath = /tmp/other-config\n"),
        ("alias", '[alias]\n\tboom = "!sh -c true"\n'),
        ("filter", '[filter "x"]\n\tclean = /bin/false\n'),
        ("fsmonitor", "[core]\n\tfsmonitor = /tmp/monitor\n"),
        ("malformed", "not a section\n"),
    )
    for name, text in hostile:
        for scope in ("ci", "bundle"):
            bundle = build(root, f"config-{scope}-{name}").finalize()
            repository = bundle.checkout if scope == "ci" else bundle.bundle_root / "align-llm"
            config = git_directory(repository) / "config"
            config.write_text(config.read_text("utf-8") + text)
            rejected(bundle, f"{scope} local Git config {name}")

    bundle = build(root, "config-worktree").finalize()
    (git_directory(bundle.checkout) / "config.worktree").write_text("[core]\n\tpager = /bin/false\n")
    rejected(bundle, "worktree Git config command-bearing key")


def family_ordinary_clone_config(root: Path) -> None:
    bundle = build(root, "ordinary-clone").finalize()
    config = git_directory(bundle.checkout) / "config"
    config.write_text(
        config.read_text("utf-8")
        + '[remote "origin"]\n'
        + "\turl = https://example.invalid/align-llm.git\n"
        + "\tpushurl = https://example.invalid/align-llm.git\n"
        + "\tfetch = +refs/heads/*:refs/remotes/origin/*\n"
        + '[branch "main"]\n'
        + "\tremote = origin\n"
        + "\tmerge = refs/heads/main\n"
    )
    observed, output = invoke(bundle)
    require(
        observed == accepted_code(),
        f"inert ordinary-clone metadata was rejected: exit {observed}: {output.strip()}",
    )


# --- families requiring the Linux process-containment floor ---------------------------


def family_replacement_namespace(root: Path) -> None:
    bundle = build(root, "replacement-namespace").finalize()
    head = bundle.tested_head
    fixture.git(bundle.checkout, "replace", "--graft", head)
    fixture.git(bundle.checkout, "pack-refs", "--all")
    loose = git_directory(bundle.checkout) / "refs" / "replace"
    if loose.exists():
        shutil.rmtree(loose)
    rejected(bundle, "packed replacement reference")

    control = build(root, "replacement-control").finalize()
    observed, output = invoke(control)
    require(
        observed == 0,
        f"replacement-free control bundle was rejected: exit {observed}: {output.strip()}",
    )


def family_ancestry(root: Path) -> None:
    foreign = case(root, "foreign-commit", evaluated_is_ancestor=False)
    rejected(foreign, "evaluated commit is not reachable from the derived CI head")

    control = build(root, "ancestry-control").finalize()
    observed, output = invoke(control)
    require(
        observed == 0, f"ancestry control bundle was rejected: exit {observed}: {output.strip()}"
    )


def family_merge_head_ancestry(root: Path) -> None:
    bundle = build(root, "merge-head").finalize()
    require(
        bundle.tested_head != bundle.evaluated_commit,
        "merge-head fixture does not separate the CI head from the evaluated commit",
    )
    observed, output = invoke(bundle)
    require(
        observed == 0,
        f"differing head and evaluated commit were rejected: exit {observed}: {output.strip()}",
    )

    dirty = build(root, "merge-head-dirty").finalize()
    (dirty.checkout / "untracked.txt").write_text("dirty\n")
    rejected(dirty, "dirty CI checkout")


FAMILIES: dict[str, tuple[Callable[[Path], None], bool]] = {
    "validator": (family_validator, False),
    "source-bundle": (family_source_bundle, False),
    "source-revalidation": (family_source_revalidation, False),
    "git-replacement-graft": (family_git_replacement_graft, False),
    "local-git-config": (family_local_git_config, False),
    "ordinary-clone-config": (family_ordinary_clone_config, False),
    "replacement-namespace": (family_replacement_namespace, True),
    "ancestry": (family_ancestry, True),
    "merge-head-ancestry": (family_merge_head_ancestry, True),
}


def main(arguments: list[str]) -> int:
    if len(arguments) != 1 or arguments[0] not in FAMILIES:
        print(
            f"usage: run-prompt-gate-validator-smoke {'|'.join(FAMILIES)}",
            file=sys.stderr,
        )
        return 2
    name = arguments[0]
    runner, needs_linux = FAMILIES[name]
    if needs_linux and not LINUX:
        print(f"prompt gate {name}: SKIP (requires the Linux process-containment floor)")
        return 0
    with tempfile.TemporaryDirectory(prefix="prompt-gate-smoke-") as directory:
        runner(Path(directory).resolve(strict=True))
    print(f"prompt gate {name}: PASS")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (OSError, SmokeFailure, subprocess.CalledProcessError) as error:
        print(f"prompt gate smoke: FAIL: {error}", file=sys.stderr)
        raise SystemExit(1)
