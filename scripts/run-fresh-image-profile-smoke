#!/usr/bin/env python3
"""Build and exercise the installed Ubuntu 24.04 FRESH-IMAGE profile."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import secrets
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
from contextlib import contextmanager
from pathlib import Path
from typing import Iterator


REPOSITORY = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPOSITORY / "scripts"))

from fresh_attestation import ed25519_public_key  # noqa: E402
from fresh_manifest import serialized_digest, validate_manifest_bytes  # noqa: E402


PROVENANCE_SCRIPTS = (
    "build-fresh-image-control",
    "fresh_attestation.py",
    "fresh_manifest.py",
    "generate-fresh-toolchain-manifest",
    "materialize-fresh-tree",
)
ALIGN_REPOSITORY = "https://github.com/sanohiro/align.git"
TEST_UID = 12345
WORKER_INVOCATION_TIMEOUT = 5_100
PREPARED_IMAGE_PATTERN = re.compile(r"align-llm-fresh-test:[0-9a-f]{32}\Z")
AGGREGATE_DIAGNOSTIC_VARIABLE = "ALIGN_LLM_AGGREGATE_DIAGNOSTIC"
PROFILE_SIGNALS = tuple(
    selected
    for selected in (
        getattr(signal, "SIGHUP", None),
        signal.SIGINT,
        getattr(signal, "SIGQUIT", None),
        signal.SIGTERM,
    )
    if selected is not None
)


@contextmanager
def cleanup_signal_handlers() -> Iterator[None]:
    pending_signal: int | None = None
    previous_handlers: dict[int, signal.Handlers] = {}

    def handle_signal(signum: int, _frame: object) -> None:
        nonlocal pending_signal
        if pending_signal is None:
            pending_signal = signum
            raise SystemExit(128 + signum)

    try:
        for selected_signal in PROFILE_SIGNALS:
            previous_handlers[selected_signal] = signal.getsignal(selected_signal)
            signal.signal(selected_signal, handle_signal)
        yield
    finally:
        for selected_signal, previous in previous_handlers.items():
            signal.signal(selected_signal, previous)


def aggregate_diagnostic_requested() -> bool:
    return os.environ.get(AGGREGATE_DIAGNOSTIC_VARIABLE) == "1"


class PhaseTracker:
    def __init__(self) -> None:
        self.name: str | None = None
        self.started = 0

    def enter(self, name: str) -> None:
        self.finish("pass")
        self.name = name
        self.started = time.monotonic_ns()
        self.emit("start", None)

    def finish(self, status: str) -> None:
        if self.name is None:
            return
        duration_ms = max(0, (time.monotonic_ns() - self.started) // 1_000_000)
        self.emit(status, duration_ms)
        self.name = None

    def emit(self, status: str, duration_ms: int | None) -> None:
        record: dict[str, object] = {
            "event": "fresh-image-profile-phase",
            "phase": self.name,
            "status": status,
        }
        if duration_ms is not None:
            record["duration_ms"] = duration_ms
        print(json.dumps(record, sort_keys=True, separators=(",", ":")), file=sys.stderr)


def docker_cgroup_driver(info: bytes) -> str:
    for line in info.splitlines():
        name, separator, value = line.strip().partition(b":")
        if separator and name == b"Cgroup Driver":
            driver = value.strip().decode("ascii", "strict")
            if driver in ("cgroupfs", "systemd"):
                return driver
            raise RuntimeError(f"unsupported Docker cgroup driver: {driver}")
    raise RuntimeError("Docker cgroup driver is unavailable")


def source_provenance() -> str:
    paths = list((REPOSITORY / "image" / "fresh").rglob("*"))
    paths.extend(REPOSITORY / "scripts" / name for name in PROVENANCE_SCRIPTS)
    paths.append(REPOSITORY / ".align-revision")
    hasher = hashlib.sha256(b"align-llm-fresh-image-source-v1\0")
    for path in sorted(
        (path for path in paths if path.is_file() and not path.is_symlink()),
        key=lambda value: os.fsencode(value.relative_to(REPOSITORY).as_posix()),
    ):
        relative = path.relative_to(REPOSITORY).as_posix().encode("utf-8")
        raw = path.read_bytes()
        mode = path.stat(follow_symlinks=False).st_mode & 0o7777
        hasher.update(len(relative).to_bytes(4, "big"))
        hasher.update(relative)
        hasher.update(f"{mode:04o}".encode("ascii"))
        hasher.update(len(raw).to_bytes(8, "big"))
        hasher.update(raw)
    return "sha256:" + hasher.hexdigest()


def run(
    arguments: list[str],
    *,
    check: bool = True,
    stdout: int | None = subprocess.PIPE,
    stderr: int | None = subprocess.PIPE,
    timeout: int = 1_800,
) -> subprocess.CompletedProcess[bytes]:
    environment = {
        "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
        "LC_ALL": "C",
        "DOCKER_BUILDKIT": "1",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_TERMINAL_PROMPT": "0",
        "PYTHONDONTWRITEBYTECODE": "1",
    }
    if arguments and arguments[0] == "docker" and "DOCKER_CONFIG" in os.environ:
        environment["DOCKER_CONFIG"] = os.environ["DOCKER_CONFIG"]
    return subprocess.run(
        arguments,
        cwd=REPOSITORY,
        env=environment,
        stdin=subprocess.DEVNULL,
        stdout=stdout,
        stderr=stderr,
        check=check,
        timeout=timeout,
    )


def prepared_seed(path: Path, label: str) -> bytes:
    if not path.is_absolute():
        raise RuntimeError(f"{label} must be an absolute path")
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        raise RuntimeError(f"{label} is unavailable") from error
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise RuntimeError(f"{label} is not a regular file")
        if metadata.st_uid != os.geteuid():
            raise RuntimeError(f"{label} has the wrong owner")
        if stat.S_IMODE(metadata.st_mode) != 0o400:
            raise RuntimeError(f"{label} has the wrong mode")
        if metadata.st_size != 32:
            raise RuntimeError(f"{label} has the wrong size")
        value = bytearray()
        while len(value) <= 32:
            block = os.read(descriptor, 33 - len(value))
            if not block:
                break
            value.extend(block)
        if len(value) != 32:
            raise RuntimeError(f"{label} changed while reading")
        return bytes(value)
    except OSError as error:
        raise RuntimeError(f"{label} cannot be read") from error
    finally:
        os.close(descriptor)


def checkout_pinned_align(target: Path, source_repository: Path | None) -> None:
    revision = (REPOSITORY / ".align-revision").read_text(encoding="ascii").strip()
    source = ALIGN_REPOSITORY
    if source_repository is not None:
        source = str(source_repository)
        source_head = run(["git", "-C", source, "rev-parse", "HEAD"]).stdout
        if source_head.decode("ascii").strip() != revision:
            raise RuntimeError("provided Align source is not at the pinned revision")
        shallow = run(
            ["git", "-C", source, "rev-parse", "--is-shallow-repository"]
        ).stdout
        if shallow != b"false\n":
            raise RuntimeError("provided Align source is shallow")
        partial = run(
            [
                "git",
                "-C",
                source,
                "config",
                "--get-regexp",
                r"^(extensions\.partialclone|remote\..*\.promisor)$",
            ],
            check=False,
        )
        if partial.returncode != 1 or partial.stdout or partial.stderr:
            raise RuntimeError("provided Align source has partial-clone configuration")
        run(["git", "-C", source, "fsck", "--connectivity-only", "--no-dangling"])
    run(["git", "clone", "--no-hardlinks", source, str(target)])
    run(["git", "-C", str(target), "checkout", "--detach", revision])
    actual = run(["git", "-C", str(target), "rev-parse", "HEAD"]).stdout
    if actual.decode("ascii").strip() != revision:
        raise RuntimeError("pinned Align source identity changed after checkout")


def copy_from_image(image: str, source: str, target: Path) -> None:
    container = run(["docker", "create", image], check=True).stdout.decode("ascii").strip()
    try:
        run(["docker", "cp", f"{container}:{source}", str(target)])
    finally:
        run(["docker", "rm", "-f", container], check=False)


def populate_volume(image: str, volume: str, source: Path) -> None:
    run(
        [
            "docker",
            "run",
            "--rm",
            "--entrypoint",
            "/bin/sh",
            "--mount",
            f"type=bind,src={source},dst=/input,readonly",
            "--mount",
            f"type=volume,src={volume},dst=/output",
            image,
            "-eu",
            "-c",
            "cp /input/image-attestation.dsse /output/image-attestation.dsse; "
            "cp /input/run-signing-seed /output/run-signing-seed; "
            "cp /input/image-digest /output/image-digest; "
            "cp /input/provenance-digest /output/provenance-digest; "
            "chmod 0444 /output/image-attestation.dsse /output/image-digest /output/provenance-digest; "
            f"chown {TEST_UID}:{TEST_UID} /output/run-signing-seed; "
            "chmod 0400 /output/run-signing-seed",
        ]
    )


def profile_run(
    image: str,
    volume: str,
    runtime_volume: str,
    cgroup_driver: str,
    *,
    replacements: tuple[tuple[Path, str], ...] = (),
) -> subprocess.CompletedProcess[bytes]:
    replacement_arguments: list[str] = []
    for source, target in replacements:
        replacement_arguments.extend(
            ["--mount", f"type=bind,src={source},dst={target},readonly"]
        )
    arguments = [
        "docker",
        "run",
        "--rm",
        "--privileged",
        "--cgroupns=host",
        "--network=none",
    ]
    command = [image, "--mode", "self-test"]
    if cgroup_driver == "cgroupfs":
        arguments.extend(
            [
                "--cgroup-parent",
                f"/align-llm-fresh/{TEST_UID}",
                "--user",
                f"{TEST_UID}:{TEST_UID}",
            ]
        )
    elif cgroup_driver == "systemd":
        # Docker's systemd driver only accepts slice names and cannot express the
        # profile's fixed cgroup-v2 path. A privileged parent creates and later
        # removes a leaf there; only its child enters that leaf, drops to the
        # repository uid, and becomes the native supervisor. Keeping the
        # delegated parent free of processes lets the worker create limit leaves.
        launcher = f"""\
import os
parent = '/sys/fs/cgroup/align-llm-fresh/{TEST_UID}'
leaf = parent + '/docker-self-test-' + str(os.getpid())
os.mkdir(leaf, 0o700)
child = os.fork()
if child == 0:
    try:
        with open(leaf + '/cgroup.procs', 'w', encoding='ascii') as target:
            target.write('0\\n')
        os.setgroups([])
        os.setgid({TEST_UID})
        os.setuid({TEST_UID})
        os.execve('/usr/local/libexec/align-llm/fresh-supervise', ['fresh-supervise', '--mode', 'self-test'], {{}})
    except BaseException:
        os._exit(127)
try:
    _, status = os.waitpid(child, 0)
finally:
    os.rmdir(leaf)
if os.WIFEXITED(status):
    os._exit(os.WEXITSTATUS(status))
os._exit(128 + os.WTERMSIG(status))
"""
        arguments.extend(
            [
                "--user",
                "0:0",
                "--entrypoint",
                "/usr/bin/python3.12",
            ]
        )
        command = [image, "-I", "-c", launcher]
    else:
        raise RuntimeError(f"unsupported Docker cgroup driver: {cgroup_driver}")
    arguments.extend(
        [
            "--mount",
            f"type=volume,src={volume},dst=/run/align-llm-fresh,readonly",
            "--mount",
            f"type=volume,src={runtime_volume},dst=/run/user",
            *replacement_arguments,
            *command,
        ]
    )
    return run(arguments, check=False)


def boundary_profile_run(
    image: str,
    volume: str,
    runtime_volume: str,
    source_volume: str,
    cgroup_driver: str,
    *,
    align_repo: str | None = "/work/align",
    extra_environment: tuple[str, ...] = (),
) -> subprocess.CompletedProcess[bytes]:
    arguments = [
        "docker",
        "run",
        "--rm",
        "--privileged",
        "--cgroupns=host",
        "--network=none",
        "--workdir",
        "/work/project",
    ]
    environment_values: dict[str, str] = {}
    if align_repo is not None:
        environment_values["ALIGN_REPO"] = align_repo
    for entry in extra_environment:
        name, separator, value = entry.partition("=")
        if not separator or not name:
            raise ValueError(f"invalid boundary test environment entry: {entry!r}")
        environment_values[name] = value
    command = [image, "--mode", "ordinary-adoption-boundary"]
    if cgroup_driver == "cgroupfs":
        arguments.extend(
            [
                "--cgroup-parent",
                f"/align-llm-fresh/{TEST_UID}",
                "--user",
                f"{TEST_UID}:{TEST_UID}",
                "--entrypoint",
                "/usr/bin/env",
            ]
        )
        command = [
            image,
            "-i",
            *(f"{name}={value}" for name, value in environment_values.items()),
            "/usr/local/libexec/align-llm/fresh-supervise",
            "--mode",
            "ordinary-adoption-boundary",
        ]
    elif cgroup_driver == "systemd":
        environment = repr(environment_values)
        launcher = f"""\
import os
parent = '/sys/fs/cgroup/align-llm-fresh/{TEST_UID}'
leaf = parent + '/docker-boundary-' + str(os.getpid())
os.mkdir(leaf, 0o700)
child = os.fork()
if child == 0:
    try:
        with open(leaf + '/cgroup.procs', 'w', encoding='ascii') as target:
            target.write('0\\n')
        os.setgroups([])
        os.setgid({TEST_UID})
        os.setuid({TEST_UID})
        os.chdir('/work/project')
        os.execve('/usr/local/libexec/align-llm/fresh-supervise',
                  ['fresh-supervise', '--mode', 'ordinary-adoption-boundary'], {environment})
    except BaseException:
        os._exit(127)
try:
    _, status = os.waitpid(child, 0)
finally:
    os.rmdir(leaf)
if os.WIFEXITED(status):
    os._exit(os.WEXITSTATUS(status))
os._exit(128 + os.WTERMSIG(status))
"""
        arguments.extend(
            [
                "--user",
                "0:0",
                "--entrypoint",
                "/usr/bin/python3.12",
            ]
        )
        command = [image, "-I", "-c", launcher]
    else:
        raise RuntimeError(f"unsupported Docker cgroup driver: {cgroup_driver}")
    arguments.extend(
        [
            "--mount",
            f"type=volume,src={volume},dst=/run/align-llm-fresh,readonly",
            "--mount",
            f"type=volume,src={runtime_volume},dst=/run/user",
            "--mount",
            f"type=volume,src={source_volume},dst=/work,readonly",
            *command,
        ]
    )
    return run(arguments, check=False)


def ordinary_profile_run(
    image: str,
    volume: str,
    runtime_volume: str,
    source_volume: str,
    cgroup_driver: str,
    *,
    replacements: tuple[tuple[Path, str], ...] = (),
) -> subprocess.CompletedProcess[bytes]:
    arguments = [
        "docker",
        "run",
        "--rm",
        "--privileged",
        "--cgroupns=host",
        "--network=none",
        "--workdir",
        "/work/project",
        "--env",
        "PATH=/usr/bin:/bin",
        "--env",
        "LC_ALL=C",
        "--env",
        "LANG=C",
        "--env",
        "HOME=/nonexistent",
        "--env",
        "TMPDIR=/tmp",
        "--env",
        "ALIGN_REPO=/work/align",
    ]
    replacement_arguments: list[str] = []
    for source, target in replacements:
        replacement_arguments.extend(
            ["--mount", f"type=bind,src={source},dst={target},readonly"]
        )
    command = [image, "--mode", "ordinary-adoption"]
    if cgroup_driver == "cgroupfs":
        launcher = """\
import os
os.execve('/usr/local/libexec/align-llm/fresh-supervise',
          ['fresh-supervise', '--mode', 'ordinary-adoption'],
          {'PATH': '/usr/bin:/bin', 'LC_ALL': 'C', 'LANG': 'C',
           'HOME': '/nonexistent', 'TMPDIR': '/tmp',
           'ALIGN_REPO': '/work/align'})
"""
        arguments.extend(
            [
                "--cgroup-parent",
                f"/align-llm-fresh/{TEST_UID}",
                "--user",
                f"{TEST_UID}:{TEST_UID}",
                "--entrypoint",
                "/usr/bin/python3.12",
            ]
        )
        command = [image, "-I", "-c", launcher]
    elif cgroup_driver == "systemd":
        launcher = f"""\
import os
parent = '/sys/fs/cgroup/align-llm-fresh/{TEST_UID}'
leaf = parent + '/docker-ordinary-adoption-' + str(os.getpid())
os.mkdir(leaf, 0o700)
child = os.fork()
if child == 0:
    try:
        with open(leaf + '/cgroup.procs', 'w', encoding='ascii') as target:
            target.write('0\\n')
        os.setgroups([])
        os.setgid({TEST_UID})
        os.setuid({TEST_UID})
        os.chdir('/work/project')
        os.execve('/usr/local/libexec/align-llm/fresh-supervise',
                  ['fresh-supervise', '--mode', 'ordinary-adoption'],
                  {{'PATH': '/usr/bin:/bin', 'LC_ALL': 'C', 'LANG': 'C',
                    'HOME': '/nonexistent', 'TMPDIR': '/tmp',
                    'ALIGN_REPO': '/work/align'}})
    except BaseException:
        os._exit(127)
try:
    _, status = os.waitpid(child, 0)
finally:
    os.rmdir(leaf)
if os.WIFEXITED(status):
    os._exit(os.WEXITSTATUS(status))
os._exit(128 + os.WTERMSIG(status))
"""
        arguments.extend(
            [
                "--user",
                "0:0",
                "--entrypoint",
                "/usr/bin/python3.12",
            ]
        )
        command = [image, "-I", "-c", launcher]
    else:
        raise RuntimeError(f"unsupported Docker cgroup driver: {cgroup_driver}")
    arguments.extend(
        [
            "--mount",
            f"type=volume,src={volume},dst=/run/align-llm-fresh,readonly",
            "--mount",
            f"type=volume,src={runtime_volume},dst=/run/user",
            "--mount",
            f"type=volume,src={source_volume},dst=/work,readonly",
            *replacement_arguments,
            *command,
        ]
    )
    return run(arguments, check=False, timeout=WORKER_INVOCATION_TIMEOUT)


def worker_profile_run(
    image: str,
    volume: str,
    runtime_volume: str,
    source_volume: str,
    cgroup_driver: str,
    *,
    complete_aggregate: bool,
) -> subprocess.CompletedProcess[bytes]:
    diagnostic = complete_aggregate and aggregate_diagnostic_requested()
    arguments = [
        "docker",
        "run",
        "--rm",
        "--privileged",
        "--cgroupns=host",
        "--network=none",
        "--workdir",
        "/work/project",
    ]
    if diagnostic:
        arguments.extend(("--env", f"{AGGREGATE_DIAGNOSTIC_VARIABLE}=1"))
    request = (
        ["make", "--no-print-directory", "ci"]
        if complete_aggregate
        else ["--mode", "build"]
    )
    command = [image, *request]
    if cgroup_driver == "cgroupfs":
        arguments.extend(
            [
                "--cgroup-parent",
                f"/align-llm-fresh/{TEST_UID}",
                "--user",
                f"{TEST_UID}:{TEST_UID}",
            ]
        )
    elif cgroup_driver == "systemd":
        launcher_environment = (
            repr({AGGREGATE_DIAGNOSTIC_VARIABLE: "1"}) if diagnostic else "{}"
        )
        launcher = f"""\
import os
parent = '/sys/fs/cgroup/align-llm-fresh/{TEST_UID}'
leaf = parent + '/docker-worker-' + str(os.getpid())
os.mkdir(leaf, 0o700)
child = os.fork()
if child == 0:
    try:
        with open(leaf + '/cgroup.procs', 'w', encoding='ascii') as target:
            target.write('0\\n')
        os.setgroups([])
        os.setgid({TEST_UID})
        os.setuid({TEST_UID})
        os.chdir('/work/project')
        os.execve('/usr/local/libexec/align-llm/fresh-supervise',
                  {['fresh-supervise', *request]!r},
                  {launcher_environment})
    except BaseException:
        os._exit(127)
try:
    _, status = os.waitpid(child, 0)
finally:
    os.rmdir(leaf)
if os.WIFEXITED(status):
    os._exit(os.WEXITSTATUS(status))
os._exit(128 + os.WTERMSIG(status))
"""
        arguments.extend(
            [
                "--user",
                "0:0",
                "--entrypoint",
                "/usr/bin/python3.12",
            ]
        )
        command = [image, "-I", "-c", launcher]
    else:
        raise RuntimeError(f"unsupported Docker cgroup driver: {cgroup_driver}")
    arguments.extend(
        [
            "--mount",
            f"type=volume,src={volume},dst=/run/align-llm-fresh,readonly",
            "--mount",
            f"type=volume,src={runtime_volume},dst=/run/user",
            "--mount",
            f"type=volume,src={source_volume},dst=/work,readonly",
            *command,
        ]
    )
    return run(arguments, check=False, timeout=WORKER_INVOCATION_TIMEOUT)


def populate_source_volume(image: str, volume: str, source: Path) -> None:
    run(
        [
            "docker",
            "run",
            "--rm",
            "--entrypoint",
            "/bin/sh",
            "--mount",
            f"type=bind,src={source},dst=/input,readonly",
            "--mount",
            f"type=volume,src={volume},dst=/output",
            image,
            "-eu",
            "-c",
            "cp -a /input/project /input/align /output/; "
            f"chown -R {TEST_UID}:{TEST_UID} /output/project /output/align",
        ]
    )


def require_rejection(
    result: subprocess.CompletedProcess[bytes], name: str, expected: bytes
) -> None:
    if (
        result.returncode != 1
        or result.stdout
        or result.stderr != expected
    ):
        raise RuntimeError(
            f"{name} was not rejected canonically: returncode={result.returncode}, "
            f"stdout={result.stdout!r}, stderr={result.stderr!r}"
        )


def require_trust_rejection(result: subprocess.CompletedProcess[bytes], name: str) -> None:
    require_rejection(result, name, b"fresh compiler: ERROR TRUST supervisor\n")


def require_file_binding(
    manifest: dict[str, object],
    *,
    target: str,
    source: str,
    raw: bytes | None = None,
    mode: str = "0755",
) -> None:
    bindings = [
        binding
        for binding in manifest["runtime_bindings"]  # type: ignore[index]
        if binding["target"] == target  # type: ignore[index]
    ]
    if len(bindings) != 1:
        raise RuntimeError(f"runtime binding is missing: {target}")
    binding = bindings[0]
    binding_manifest = binding["manifest"]
    if (
        binding["source"] != source
        or binding["kind"] != "file"
        or binding_manifest["kind"] != "file"
        or binding_manifest["mode"] != mode
        or binding["manifest_sha256"] != serialized_digest(binding_manifest)
    ):
        raise RuntimeError(f"runtime binding is not canonical: {target}")
    if raw is not None and binding_manifest["sha256"] != hashlib.sha256(raw).hexdigest():
        raise RuntimeError(f"runtime binding digest mismatch: {target}")


def deployment_copy(source: Path, target: Path) -> None:
    target.mkdir()
    for name in (
        "image-attestation.dsse",
        "run-signing-seed",
        "image-digest",
        "provenance-digest",
    ):
        shutil.copyfile(source / name, target / name)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--require-docker", action="store_true")
    parser.add_argument("--complete-aggregate", action="store_true")
    parser.add_argument("--align-repo", type=Path)
    parser.add_argument("--prepared-image")
    parser.add_argument("--image-signing-seed", type=Path)
    parser.add_argument("--run-signing-seed", type=Path)
    values = parser.parse_args()
    require_docker = values.require_docker
    align_repository = values.align_repo.resolve(strict=True) if values.align_repo else None
    prepared_values = (
        values.prepared_image,
        values.image_signing_seed,
        values.run_signing_seed,
    )
    if any(value is not None for value in prepared_values) and not all(
        value is not None for value in prepared_values
    ):
        parser.error(
            "--prepared-image, --image-signing-seed, and --run-signing-seed are required together"
        )
    prepared = values.prepared_image is not None
    if prepared:
        if PREPARED_IMAGE_PATTERN.fullmatch(values.prepared_image) is None:
            parser.error("--prepared-image is not a generated fresh-image tag")
        try:
            prepared_image_seed = prepared_seed(
                values.image_signing_seed, "image signing seed"
            )
            prepared_run_seed = prepared_seed(values.run_signing_seed, "run signing seed")
        except RuntimeError as error:
            parser.error(str(error))
    else:
        prepared_image_seed = None
        prepared_run_seed = None
    phases = PhaseTracker()
    phases.enter("docker-daemon")
    availability = run(["docker", "info"], check=False)
    if availability.returncode != 0:
        phases.finish("fail" if require_docker else "skip")
        if require_docker:
            print("fresh image profile smoke: ERROR (Docker daemon unavailable)", file=sys.stderr)
            return 1
        print("fresh image profile smoke: SKIP (Docker daemon unavailable)")
        return 77
    cgroup_driver = docker_cgroup_driver(availability.stdout)
    docker_architecture = run(
        ["docker", "info", "--format", "{{.Architecture}}"]
    ).stdout.decode("ascii").strip()
    native_architecture = {
        "amd64": "x86_64",
        "x86_64": "x86_64",
        "arm64": "aarch64",
        "aarch64": "aarch64",
    }.get(docker_architecture)
    if native_architecture is None:
        raise RuntimeError(f"unsupported Docker native architecture: {docker_architecture}")
    phases.finish("pass")

    unique = secrets.token_hex(8)
    image = values.prepared_image if prepared else f"align-llm-fresh-test:{unique}"
    volume = f"align-llm-fresh-secrets-{unique}"
    runtime_volume = f"align-llm-fresh-runtime-{unique}"
    source_volume = f"align-llm-fresh-source-{unique}"
    boundary_source_volume = f"align-llm-fresh-boundary-source-{unique}"
    ordinary_source_volume = f"align-llm-fresh-ordinary-source-{unique}"
    cgroup_ready = False
    with cleanup_signal_handlers(), tempfile.TemporaryDirectory(
        prefix="fresh-image-profile-"
    ) as temporary_name:
        temporary = Path(temporary_name)
        image_seed = temporary / "image-signing-seed"
        run_seed = temporary / "run-signing-seed"
        image_seed.write_bytes(prepared_image_seed if prepared else os.urandom(32))
        run_seed.write_bytes(prepared_run_seed if prepared else os.urandom(32))
        image_seed.chmod(0o400)
        run_seed.chmod(0o400)
        image_public = ed25519_public_key(image_seed.read_bytes()).hex()
        run_public = ed25519_public_key(run_seed.read_bytes()).hex()
        try:
            if prepared:
                phases.enter("image-admission")
            else:
                phases.enter("image-build")
                build = run(
                    [
                        "docker",
                        "build",
                        "--pull",
                        "--build-arg",
                        f"IMAGE_PUBLIC_KEY_HEX={image_public}",
                        "--build-arg",
                        f"RUN_PUBLIC_KEY_HEX={run_public}",
                        "-f",
                        "image/fresh/Dockerfile",
                        "-t",
                        image,
                        ".",
                    ],
                    check=False,
                    stdout=None,
                    stderr=None,
                )
                if build.returncode != 0:
                    raise RuntimeError("FRESH-IMAGE build failed")
            image_digest = run(
                ["docker", "image", "inspect", "--format", "{{.Id}}", image]
            ).stdout.decode("ascii").strip()
            if not image_digest.startswith("sha256:"):
                raise RuntimeError("Docker image identity is not sha256")
            phases.enter("image-attestation")
            provenance = source_provenance()
            supervisor = temporary / "fresh-supervise"
            bootstrap = temporary / "fresh-bootstrap"
            dispatcher = temporary / "request6-adoption-boundary-entrypoint"
            ordinary_dispatcher = temporary / "request6-adoption-entrypoint"
            namespace_helper = temporary / "adoption-namespace"
            dynamic_loader = temporary / "dynamic-loader"
            manifest = temporary / "fresh-toolchain.json"
            copy_from_image(image, "/usr/local/libexec/align-llm/fresh-supervise", supervisor)
            copy_from_image(image, "/usr/local/libexec/align-llm/fresh-bootstrap", bootstrap)
            copy_from_image(
                image,
                "/usr/local/libexec/align-llm/request6-adoption-boundary-entrypoint",
                dispatcher,
            )
            copy_from_image(
                image,
                "/usr/local/libexec/align-llm/request6-adoption-entrypoint",
                ordinary_dispatcher,
            )
            copy_from_image(
                image,
                "/usr/local/libexec/align-llm/adoption-namespace",
                namespace_helper,
            )
            copy_from_image(image, "/runtime/system/dynamic-loader", dynamic_loader)
            copy_from_image(image, "/usr/local/share/align-llm/fresh-toolchain.json", manifest)
            run_public_key = temporary / "run-verifier.pub"
            copy_from_image(image, "/usr/local/share/align-llm/run-verifier.pub", run_public_key)
            manifest_value = validate_manifest_bytes(manifest.read_bytes())
            architecture = manifest_value["platform"]["architecture"]
            loader_target = {
                "x86_64": "/lib64/ld-linux-x86-64.so.2",
                "aarch64": "/lib/ld-linux-aarch64.so.1",
            }.get(architecture)
            if loader_target is None:
                raise RuntimeError("installed manifest has an unsupported architecture")
            image_architecture = run(
                ["docker", "image", "inspect", "--format", "{{.Architecture}}", image]
            ).stdout.decode("ascii").strip()
            normalized_image_architecture = {
                "amd64": "x86_64",
                "arm64": "aarch64",
            }.get(image_architecture)
            if normalized_image_architecture != architecture or architecture != native_architecture:
                raise RuntimeError("installed manifest architecture differs from the native image")
            require_file_binding(
                manifest_value,
                target="/usr/local/libexec/align-llm/request6-adoption-boundary-entrypoint",
                source="/usr/local/libexec/align-llm/request6-adoption-boundary-entrypoint",
                raw=dispatcher.read_bytes(),
            )
            require_file_binding(
                manifest_value,
                target="/usr/local/libexec/align-llm/request6-adoption-entrypoint",
                source="/usr/local/libexec/align-llm/request6-adoption-entrypoint",
                raw=ordinary_dispatcher.read_bytes(),
            )
            require_file_binding(
                manifest_value,
                target="/usr/bin/adoption-namespace",
                source="/usr/local/libexec/align-llm/adoption-namespace",
                raw=namespace_helper.read_bytes(),
            )
            require_file_binding(
                manifest_value,
                target="/usr/local/share/align-llm/run-verifier.pub",
                source="/usr/local/share/align-llm/run-verifier.pub",
                raw=run_public_key.read_bytes(),
                mode="0444",
            )
            require_file_binding(
                manifest_value,
                target=loader_target,
                source="/runtime/system/dynamic-loader",
                raw=dynamic_loader.read_bytes(),
            )
            require_file_binding(
                manifest_value,
                target="/usr/bin/bwrap",
                source="/runtime/bwrap/bin/bwrap",
            )
            attestation = temporary / "image-attestation.dsse"
            run(
                [
                    sys.executable,
                    "scripts/fresh-image-attest",
                    "--image-digest",
                    image_digest,
                    "--provenance-digest",
                    provenance,
                    "--supervisor",
                    str(supervisor),
                    "--bootstrap",
                    str(bootstrap),
                    "--manifest",
                    str(manifest),
                    "--image-signing-seed",
                    str(image_seed),
                    "--output",
                    str(attestation),
                ]
            )
            (temporary / "image-digest").write_text(image_digest + "\n", encoding="ascii")
            (temporary / "provenance-digest").write_text(provenance + "\n", encoding="ascii")
            (temporary / "image-digest").chmod(0o444)
            (temporary / "provenance-digest").chmod(0o444)
            phases.enter("profile-lifecycle")
            run(["docker", "volume", "create", volume])
            run(["docker", "volume", "create", runtime_volume])
            populate_volume(image, volume, temporary)
            run(
                [
                    "docker",
                    "run",
                    "--rm",
                    "--privileged",
                    "--cgroupns=host",
                    "--entrypoint",
                    "/usr/local/libexec/align-llm/fresh-profile",
                    "--mount",
                    f"type=volume,src={runtime_volume},dst=/run/user",
                    image,
                    "setup",
                    str(TEST_UID),
                ]
            )
            cgroup_ready = True
            duplicate_setup = run(
                [
                    "docker",
                    "run",
                    "--rm",
                    "--privileged",
                    "--cgroupns=host",
                    "--entrypoint",
                    "/usr/local/libexec/align-llm/fresh-profile",
                    "--mount",
                    f"type=volume,src={runtime_volume},dst=/run/user",
                    image,
                    "setup",
                    str(TEST_UID),
                ],
                check=False,
            )
            if duplicate_setup.returncode == 0:
                raise RuntimeError("duplicate profile setup was accepted")
            run(
                [
                    "docker",
                    "run",
                    "--rm",
                    "--entrypoint",
                    "/bin/sh",
                    "--mount",
                    f"type=volume,src={runtime_volume},dst=/run/user",
                    image,
                    "-eu",
                    "-c",
                    f"touch /run/user/{TEST_UID}/align-llm-fresh/roots/orphan",
                ]
            )
            refused_cleanup = run(
                [
                    "docker",
                    "run",
                    "--rm",
                    "--privileged",
                    "--cgroupns=host",
                    "--entrypoint",
                    "/usr/local/libexec/align-llm/fresh-profile",
                    "--mount",
                    f"type=volume,src={runtime_volume},dst=/run/user",
                    image,
                    "cleanup",
                    str(TEST_UID),
                ],
                check=False,
            )
            if refused_cleanup.returncode == 0:
                raise RuntimeError("nonempty profile cleanup was accepted")
            run(
                [
                    "docker",
                    "run",
                    "--rm",
                    "--entrypoint",
                    "/bin/sh",
                    "--mount",
                    f"type=volume,src={runtime_volume},dst=/run/user",
                    image,
                    "-eu",
                    "-c",
                    f"test -f /run/user/{TEST_UID}/align-llm-fresh/lock; "
                    f"test -f /run/user/{TEST_UID}/align-llm-fresh/roots/orphan; "
                    f"rm /run/user/{TEST_UID}/align-llm-fresh/roots/orphan",
                ]
            )
            residual_cgroup = f"profile-residual-{unique}"
            run(
                [
                    "docker",
                    "run",
                    "--rm",
                    "--privileged",
                    "--cgroupns=host",
                    "--entrypoint",
                    "/bin/sh",
                    image,
                    "-eu",
                    "-c",
                    f"mkdir /sys/fs/cgroup/align-llm-fresh/{TEST_UID}/{residual_cgroup}",
                ]
            )
            refused_cgroup_cleanup = run(
                [
                    "docker",
                    "run",
                    "--rm",
                    "--privileged",
                    "--cgroupns=host",
                    "--entrypoint",
                    "/usr/local/libexec/align-llm/fresh-profile",
                    "--mount",
                    f"type=volume,src={runtime_volume},dst=/run/user",
                    image,
                    "cleanup",
                    str(TEST_UID),
                ],
                check=False,
            )
            if refused_cgroup_cleanup.returncode == 0:
                raise RuntimeError("residual child cgroup cleanup was accepted")
            run(
                [
                    "docker",
                    "run",
                    "--rm",
                    "--privileged",
                    "--cgroupns=host",
                    "--entrypoint",
                    "/bin/sh",
                    image,
                    "-eu",
                    "-c",
                    f"test -d /sys/fs/cgroup/align-llm-fresh/{TEST_UID}/{residual_cgroup}; "
                    f"rmdir /sys/fs/cgroup/align-llm-fresh/{TEST_UID}/{residual_cgroup}",
                ]
            )
            phases.enter("profile-self-test")
            result = profile_run(image, volume, runtime_volume, cgroup_driver)
            if result.returncode != 0:
                raise RuntimeError(
                    "profile self-test failed:\n"
                    + result.stdout.decode("utf-8", "replace")
                    + result.stderr.decode("utf-8", "replace")
                )
            if result.stdout != b"fresh compiler self-test: PASS\n" or result.stderr:
                raise RuntimeError("profile self-test output is not canonical")

            phases.enter("trust-mutations")
            mutations = []
            corrupt = temporary / "corrupt-attestation"
            deployment_copy(temporary, corrupt)
            raw = bytearray((corrupt / "image-attestation.dsse").read_bytes())
            raw[len(raw) // 2] ^= 1
            (corrupt / "image-attestation.dsse").write_bytes(raw)
            mutations.append(("corrupt attestation", corrupt))

            wrong_digest = temporary / "wrong-image-digest"
            deployment_copy(temporary, wrong_digest)
            (wrong_digest / "image-digest").write_text(
                "sha256:" + "0" * 64 + "\n", encoding="ascii"
            )
            mutations.append(("image digest mismatch", wrong_digest))

            wrong_run_key = temporary / "wrong-run-key"
            deployment_copy(temporary, wrong_run_key)
            (wrong_run_key / "run-signing-seed").write_bytes(b"\x00" * 32)
            mutations.append(("run signing key mismatch", wrong_run_key))

            for index, (name, source) in enumerate(mutations):
                mutated_volume = f"{volume}-mutation-{index}"
                run(["docker", "volume", "create", mutated_volume])
                try:
                    populate_volume(image, mutated_volume, source)
                    require_trust_rejection(
                        profile_run(image, mutated_volume, runtime_volume, cgroup_driver), name
                    )
                finally:
                    run(["docker", "volume", "rm", "-f", mutated_volume], check=False)

            missing_volume = volume + "-missing"
            run(["docker", "volume", "create", missing_volume])
            try:
                require_trust_rejection(
                    profile_run(image, missing_volume, runtime_volume, cgroup_driver),
                    "missing image attestation",
                )
            finally:
                run(["docker", "volume", "rm", "-f", missing_volume], check=False)

            phases.enter("runtime-replacements")
            replaced_bootstrap = temporary / "replaced-bootstrap"
            replaced_bootstrap.write_bytes(bootstrap.read_bytes() + b"\x00")
            replaced_bootstrap.chmod(0o755)
            replaced_manifest = temporary / "replaced-manifest"
            replaced_manifest.write_bytes(manifest.read_bytes() + b" ")
            replaced_manifest.chmod(0o444)
            replaced_dispatcher = temporary / "replaced-boundary-dispatcher"
            replaced_dispatcher.write_bytes(dispatcher.read_bytes() + b"\x00")
            replaced_dispatcher.chmod(0o755)
            for name, source, target, expected in (
                (
                    "replaced bootstrap",
                    replaced_bootstrap,
                    "/usr/local/libexec/align-llm/fresh-bootstrap",
                    b"fresh compiler: ERROR TRUST supervisor\n",
                ),
                (
                    "replaced manifest",
                    replaced_manifest,
                    "/usr/local/share/align-llm/fresh-toolchain.json",
                    b"fresh compiler: ERROR TRUST supervisor\n",
                ),
                (
                    "replaced boundary dispatcher",
                    replaced_dispatcher,
                    "/usr/local/libexec/align-llm/request6-adoption-boundary-entrypoint",
                    b"fresh compiler: ERROR TOOL tools\n",
                ),
            ):
                require_rejection(
                    profile_run(
                        image,
                        volume,
                        runtime_volume,
                        cgroup_driver,
                        replacements=((source, target),),
                    ),
                    name,
                    expected,
                )
            runtime_replacement = temporary / "runtime-replacement"
            runtime_replacement.write_bytes(b"not the installed runtime\n")
            runtime_replacement.chmod(0o444)
            tool_replacement = temporary / "tool-replacement"
            tool_replacement.write_bytes(bootstrap.read_bytes())
            tool_replacement.chmod(0o755)
            for name, source, target in (
                (
                    "replaced runtime backend",
                    runtime_replacement,
                    "/runtime/system/dynamic-loader",
                ),
                (
                    "replaced retained tool",
                    tool_replacement,
                    "/opt/align-llm/tool-bin/bwrap",
                ),
            ):
                require_rejection(
                    profile_run(
                        image,
                        volume,
                        runtime_volume,
                        cgroup_driver,
                        replacements=((source, target),),
                    ),
                    name,
                    b"fresh compiler: ERROR TOOL tools\n",
                )

            phases.enter("boundary-profile")
            source = temporary / "source"
            source.mkdir()
            run(
                [
                    "git",
                    "clone",
                    "--no-hardlinks",
                    str(REPOSITORY),
                    str(source / "project"),
                ]
            )
            checkout_pinned_align(source / "align", align_repository)
            run(["docker", "volume", "create", source_volume])
            populate_source_volume(image, source_volume, source)
            run(["docker", "volume", "create", boundary_source_volume])
            populate_source_volume(image, boundary_source_volume, source)
            run(["docker", "volume", "create", ordinary_source_volume])
            populate_source_volume(image, ordinary_source_volume, source)
            valid_ordinary = ordinary_profile_run(
                image,
                volume,
                runtime_volume,
                ordinary_source_volume,
                cgroup_driver,
            )
            if (
                valid_ordinary.returncode != 0
                or valid_ordinary.stdout != b"json-scan adoption: PASS\n"
                or valid_ordinary.stderr
            ):
                raise RuntimeError(
                    "valid ordinary adoption failed:\n"
                    + valid_ordinary.stdout.decode("utf-8", "replace")
                    + valid_ordinary.stderr.decode("utf-8", "replace")
                )
            missing_worker = boundary_profile_run(
                image,
                volume,
                runtime_volume,
                boundary_source_volume,
                cgroup_driver,
            )
            require_rejection(
                missing_worker,
                "boundary missing worker",
                b"json-scan adoption: ERROR revision\n",
            )
            missing_align = boundary_profile_run(
                image,
                volume,
                runtime_volume,
                boundary_source_volume,
                cgroup_driver,
                align_repo=None,
            )
            require_rejection(
                missing_align,
                "boundary missing ALIGN_REPO",
                b"fresh compiler: ERROR ARGUMENT input\n",
            )
            malformed_align = boundary_profile_run(
                image,
                volume,
                runtime_volume,
                boundary_source_volume,
                cgroup_driver,
                align_repo="/work/../align",
            )
            require_rejection(
                malformed_align,
                "boundary malformed ALIGN_REPO",
                b"fresh compiler: ERROR ARGUMENT input\n",
            )
            relative_align = boundary_profile_run(
                image,
                volume,
                runtime_volume,
                boundary_source_volume,
                cgroup_driver,
                align_repo="align",
            )
            require_rejection(
                relative_align,
                "boundary relative ALIGN_REPO",
                b"fresh compiler: ERROR ARGUMENT input\n",
            )
            extra_environment = boundary_profile_run(
                image,
                volume,
                runtime_volume,
                boundary_source_volume,
                cgroup_driver,
                extra_environment=("BOUNDARY_EXTRA=1",),
            )
            require_rejection(
                extra_environment,
                "boundary extra environment",
                b"fresh compiler: ERROR ARGUMENT input\n",
            )
            run(
                [
                    "docker",
                    "run",
                    "--rm",
                    "--entrypoint",
                    "/bin/sh",
                    "--mount",
                    f"type=volume,src={boundary_source_volume},dst=/work",
                    image,
                    "-eu",
                    "-c",
                    "printf 'consumer worker\\n' > /work/project/scripts/run-json-scan-row-ownership-adoption; "
                    "chmod 0755 /work/project/scripts/run-json-scan-row-ownership-adoption",
                ]
            )
            present_worker = boundary_profile_run(
                image,
                volume,
                runtime_volume,
                boundary_source_volume,
                cgroup_driver,
            )
            require_rejection(
                present_worker,
                "boundary present worker",
                b"json-scan adoption: ERROR revision\n",
            )
            for name, mutation in (
                (
                    "boundary symlink worker",
                    "rm -f /work/project/scripts/run-json-scan-row-ownership-adoption; "
                    "ln -s missing-worker /work/project/scripts/run-json-scan-row-ownership-adoption",
                ),
                (
                    "boundary FIFO worker",
                    "rm -f /work/project/scripts/run-json-scan-row-ownership-adoption; "
                    "mkfifo /work/project/scripts/run-json-scan-row-ownership-adoption",
                ),
            ):
                run(
                    [
                        "docker",
                        "run",
                        "--rm",
                        "--entrypoint",
                        "/bin/sh",
                        "--mount",
                        f"type=volume,src={boundary_source_volume},dst=/work",
                        image,
                        "-eu",
                        "-c",
                        mutation,
                    ]
                )
                malformed_worker = boundary_profile_run(
                    image,
                    volume,
                    runtime_volume,
                    boundary_source_volume,
                    cgroup_driver,
                )
                require_rejection(
                    malformed_worker,
                    name,
                    b"json-scan adoption: ERROR revision\n",
                )
            replaced_ordinary_dispatcher = temporary / "replaced-ordinary-dispatcher"
            replaced_ordinary_dispatcher.write_bytes(ordinary_dispatcher.read_bytes() + b"\x00")
            replaced_ordinary_dispatcher.chmod(0o755)
            require_trust_rejection(
                ordinary_profile_run(
                    image,
                    volume,
                    runtime_volume,
                    source_volume,
                    cgroup_driver,
                    replacements=(
                        (
                            replaced_ordinary_dispatcher,
                            "/usr/local/libexec/align-llm/request6-adoption-entrypoint",
                        ),
                    ),
                ),
                "replaced ordinary dispatcher",
            )
            run(
                [
                    "docker",
                    "run",
                    "--rm",
                    "--entrypoint",
                    "/bin/sh",
                    "--mount",
                    f"type=volume,src={ordinary_source_volume},dst=/work",
                    "--user",
                    f"{TEST_UID}:{TEST_UID}",
                    image,
                    "-eu",
                    "-c",
                    "printf '0000000000000000000000000000000000000000\\n' > /work/project/.align-revision; "
                    "/runtime/git/bin/git -C /work/project config user.name FRESH-IMAGE-REQUEST6; "
                    "/runtime/git/bin/git -C /work/project config user.email request6@example.invalid; "
                    "/runtime/git/bin/git -C /work/project add .align-revision; "
                    "GIT_AUTHOR_DATE='2000-01-01T00:00:00Z' "
                    "GIT_COMMITTER_DATE='2000-01-01T00:00:00Z' "
                    "/runtime/git/bin/git -C /work/project commit -m 'Use an invalid Align revision'",
                ],
            )
            invalid_revision = ordinary_profile_run(
                image,
                volume,
                runtime_volume,
                ordinary_source_volume,
                cgroup_driver,
            )
            require_rejection(
                invalid_revision,
                "ordinary invalid Align revision",
                b"json-scan adoption: ERROR revision\n",
            )
            worker_phase = "worker-aggregate" if values.complete_aggregate else "worker-build"
            phases.enter(worker_phase)
            worker_result = worker_profile_run(
                image,
                volume,
                runtime_volume,
                source_volume,
                cgroup_driver,
                complete_aggregate=values.complete_aggregate,
            )
            expected_worker_output = (
                b"fresh compiler and capable checks: PASS\n"
                if values.complete_aggregate
                else b"fresh compiler: PASS\n"
            )
            if worker_result.returncode != 0:
                raise RuntimeError(
                    f"fresh {worker_phase} failed:\n"
                    + worker_result.stdout.decode("utf-8", "replace")
                    + worker_result.stderr.decode("utf-8", "replace")
                )
            if worker_result.stdout != expected_worker_output or worker_result.stderr:
                raise RuntimeError(f"fresh {worker_phase} output is not canonical")
        finally:
            phases.finish("fail" if sys.exc_info()[0] is not None else "pass")
            phases.enter("cleanup")
            if cgroup_ready:
                run(
                    [
                        "docker",
                        "run",
                        "--rm",
                        "--privileged",
                        "--cgroupns=host",
                        "--entrypoint",
                        "/usr/local/libexec/align-llm/fresh-profile",
                        "--mount",
                        f"type=volume,src={runtime_volume},dst=/run/user",
                        image,
                        "cleanup",
                        str(TEST_UID),
                    ],
                    check=False,
                )
            run(["docker", "volume", "rm", "-f", volume], check=False)
            run(["docker", "volume", "rm", "-f", runtime_volume], check=False)
            run(["docker", "volume", "rm", "-f", source_volume], check=False)
            run(["docker", "volume", "rm", "-f", boundary_source_volume], check=False)
            run(["docker", "volume", "rm", "-f", ordinary_source_volume], check=False)
            run(["docker", "image", "rm", "-f", image], check=False)
            phases.finish("pass")
    print("fresh image profile smoke: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
