#!/usr/bin/env python3
"""Developer negative owner: malformed campaigns never start servers or emit success."""
import json
from pathlib import Path
import runpy
import subprocess
import sys
import tempfile

script = Path(__file__).resolve().with_name('measure-host-reuse')
load = runpy.run_path(str(script))['workloads']
if load({}) != [[64,16], [200,64], [330,64], [64,16]]:
    raise RuntimeError('default campaign changed')
recorded = [[64,16], [200,64], [330,64], [700,64], [64,16]]
if load({'cases': recorded}) != recorded:
    raise RuntimeError('recorded campaign no longer accepted')
invalid = [[], {}, '', None, False, 1, [None], [[]], [[64]], [[64,16,1]],
           [[True,16]], [[64,False]], [[63,16]], [[2049,16]], [[64,0]], [[64,128]],
           [[64,'16']], [[64,16], []]]
with tempfile.TemporaryDirectory(prefix='host-reuse-config-') as temporary:
    root = Path(temporary)
    config, output = root/'config.json', root/'result.json'
    for cases in invalid:
        # Missing model/arm fields must never be reached: validation precedes
        # artifact reads and process creation, even after a valid first row.
        config.write_text(json.dumps({'cases': cases}))
        result = subprocess.run([sys.executable, str(script), '--config', str(config),
                                 '--output', str(output)], capture_output=True, text=True, timeout=10)
        if result.returncode == 0 or output.exists() or not any(
                message in result.stderr for message in ('cases must', 'case exceeds')):
            raise RuntimeError(f'campaign not refused before artifact/process access: {cases!r}: {result.stderr}')
print(f'host reuse config PASS: {len(invalid)} CLI refusals, default and recorded campaigns accepted')
