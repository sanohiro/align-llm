#!/usr/bin/env python3
"""Compare the explicit one-draft Qwen3.5 trial with real-model controls."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import runpy
import statistics
import tempfile


ROOT = Path(__file__).resolve().parent.parent
BASE = runpy.run_path(str(ROOT / "scripts/measure-qwen35-lookup-continuous"))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ("fixture", "binary", "gguf", "pack", "geometry", "options",
                 "reference-binary", "output"):
        parser.add_argument(f"--{name}", required=True, type=Path)
    parser.add_argument("--library-path", required=True)
    parser.add_argument("--pairs", type=int, default=5)
    parser.add_argument("--timeout-seconds", type=int, default=300)
    args = parser.parse_args()
    if not 1 <= args.pairs <= 20 or not 30 <= args.timeout_seconds <= 1200:
        parser.error("--pairs must be 1..20 and --timeout-seconds must be 30..1200")
    for name in ("fixture", "binary", "gguf", "pack", "geometry", "options",
                 "reference_binary"):
        value = getattr(args, name).resolve()
        if not value.is_file():
            parser.error(f"--{name.replace('_', '-')} must name a file")
        setattr(args, name, value)
    fixture = json.loads(args.fixture.read_text())
    digest = BASE["digest"]
    if (fixture.get("schema_version") != 1 or len(fixture.get("cases", [])) != 3
            or fixture.get("gguf_sha256") != digest(args.gguf)):
        raise ValueError("fixture or GGUF differs from the pinned corpus")
    args.eog_token_id = fixture["eog_token_id"]
    env = dict(os.environ, DYLD_LIBRARY_PATH=args.library_path)
    one_request = BASE["one_request"]
    one_reference = BASE["one_reference"]
    result = {"schema_version": 1, "gguf_sha256": digest(args.gguf),
              "pack_sha256": digest(args.pack),
              "fixture_sha256": digest(args.fixture),
              "binary_sha256": digest(args.binary),
              "reference_binary_sha256": digest(args.reference_binary),
              "geometry_sha256": digest(args.geometry),
              "options_sha256": digest(args.options),
              "execution_env": {name: env.get(name) for name in BASE["EXECUTION_ENV"]},
              "pairs_requested": args.pairs, "cases": []}
    with tempfile.TemporaryDirectory(prefix="qwen35-lookup-one-") as temporary:
        work = Path(temporary)
        for case in fixture["cases"]:
            row = {"name": case["name"],
                   "prompt_tokens": len(case["prompt_token_ids"]),
                   "expected_tokens": len(case["greedy_token_ids"]),
                   "comparisons": {}}
            for control in ("normal", "trial", "reference"):
                one_request(args, env, work, case, "trial1")
                if control == "reference":
                    one_reference(args, env, work, case)
                else:
                    one_request(args, env, work, case, control)
                pairs = []
                for pair in range(args.pairs):
                    order = (control, "trial1") if pair % 2 == 0 else ("trial1", control)
                    sample = {"order": list(order)}
                    for arm in order:
                        sample[arm] = (one_reference(args, env, work, case) if arm == "reference"
                                       else one_request(args, env, work, case, arm))
                    pairs.append(sample)
                    print(f"{case['name']} {control} pair {pair + 1}/{args.pairs}: "
                          f"{control} {sample[control]['generation_ns'] / 1e6:.3f} ms, "
                          f"trial1 {sample['trial1']['generation_ns'] / 1e6:.3f} ms", flush=True)
                generation_deltas = [(sample[control]["generation_ns"]
                                      - sample["trial1"]["generation_ns"]) / 1e6
                                     for sample in pairs]
                wall_deltas = [(sample[control]["wall_ns"]
                                - sample["trial1"]["wall_ns"]) / 1e6
                               for sample in pairs]
                row["comparisons"][control] = {
                    "pairs": pairs,
                    "paired_control_minus_trial1_generation_median_ms":
                        statistics.median(generation_deltas),
                    "generation_wins": sum(delta > 0 for delta in generation_deltas),
                    "paired_control_minus_trial1_wall_median_ms":
                        statistics.median(wall_deltas),
                    "wall_wins": sum(delta > 0 for delta in wall_deltas),
                }
            result["cases"].append(row)
    args.output.parent.mkdir(parents=True, exist_ok=True)
    temporary_output = args.output.with_name(args.output.name + ".tmp")
    temporary_output.write_text(json.dumps(result, indent=2) + "\n")
    temporary_output.replace(args.output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
