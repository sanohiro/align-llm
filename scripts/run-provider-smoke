#!/usr/bin/env bash
set -euo pipefail

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
temp_dir=$(mktemp -d)
ready_file="$temp_dir/ready"
observed_file="$temp_dir/observed"
server_pid=""

cleanup() {
  if test -n "$server_pid"; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
  rm -rf "$temp_dir"
}
trap cleanup EXIT

python3 - "$ready_file" "$observed_file" <<'PY' &
import json
import os
import sys
import time
from http.server import BaseHTTPRequestHandler, HTTPServer

ready_path, observed_path = sys.argv[1:]


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def write_chunked(self, body):
        split = max(1, len(body) // 2)
        for chunk in (body[:split], body[split:]):
            if not chunk:
                continue
            self.wfile.write(f"{len(chunk):x}\r\n".encode("ascii"))
            self.wfile.write(chunk)
            self.wfile.write(b"\r\n")
        self.wfile.write(b"0\r\nX-Provider-Trailer: discarded\r\n\r\n")

    def do_POST(self):
        length = int(self.headers.get("Content-Length", "0"))
        payload = json.loads(self.rfile.read(length))
        with open(observed_path, "a", encoding="utf-8") as observed:
            observed.write(
                json.dumps(
                    {
                        "path": self.path,
                        "authorization": self.headers.get("Authorization", ""),
                        "stream": bool(payload.get("stream", False)),
                        "content": payload.get("content", ""),
                    },
                    sort_keys=True,
                )
                + "\n"
            )

        if self.path == "/malformed-chunk":
            self.wfile.write(
                b"HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\n"
                b"Transfer-Encoding: chunked\r\n\r\nZ\r\n"
            )
            return
        if self.path == "/truncated-chunk":
            self.wfile.write(
                b"HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\n"
                b"Transfer-Encoding: chunked\r\n\r\n5\r\nabc"
            )
            self.close_connection = True
            return

        status = 200
        chunked = False
        if self.path == "/tokenize":
            token_count = 8 if "\n\n" in payload.get("content", "") else 4
            body = json.dumps({"tokens": list(range(11, 11 + token_count))}).encode("utf-8")
            content_type = "application/json"
        elif self.path == "/v1/chat/completions":
            if payload.get("stream", False):
                chunked = True
                body = (
                    'data: {"choices":[{"delta":{"content":"OPENAI-"}}]}\n'
                    'data: {"choices":[{"delta":{"content":"STREAM"}}]}\n'
                    "data: [DONE]\n"
                ).encode("utf-8")
                content_type = "text/event-stream"
            else:
                body = json.dumps(
                    {
                        "choices": [
                            {
                                "message": {
                                    "role": "assistant",
                                    "content": "OPENAI-GENERATED",
                                }
                            }
                        ]
                    }
                ).encode("utf-8")
                content_type = "application/json"
        elif self.path == "/completion":
            if payload.get("stream", False):
                chunked = True
                body = (
                    'data: {"content":"LLAMA-"}\n'
                    'data: {"content":"STREAM"}\n'
                    "data: [DONE]\n"
                ).encode("utf-8")
                content_type = "text/event-stream"
            else:
                body = json.dumps({"content": "LLAMA-GENERATED"}).encode("utf-8")
                content_type = "application/json"
        elif self.path == "/incomplete":
            body = 'data: {"choices":[{"delta":{"content":"PARTIAL"}}]}\n'.encode("utf-8")
            content_type = "text/event-stream"
        elif self.path == "/error-stream":
            body = 'data: {"error":{"message":"rate limited"}}\n data: [DONE]\n'.encode("utf-8")
            content_type = "text/event-stream"
        elif self.path == "/done-only":
            body = "data: [DONE]\n".encode("utf-8")
            content_type = "text/event-stream"
        elif self.path == "/status":
            body = json.dumps({"error": {"message": "rate limited"}}).encode("utf-8")
            content_type = "application/json"
            status = 429
        elif self.path == "/status413":
            body = json.dumps({"error": {"message": "payload rejected"}}).encode("utf-8")
            content_type = "application/json"
            status = 413
        elif self.path == "/oversized":
            body = b""
            content_type = "application/json"
        elif self.path == "/slow":
            time.sleep(0.25)
            body = json.dumps(
                {"choices": [{"message": {"role": "assistant", "content": "TOO-LATE"}}]}
            ).encode("utf-8")
            content_type = "application/json"
        else:
            self.send_error(404)
            return

        self.send_response(status)
        self.send_header("Content-Type", content_type)
        if chunked:
            self.send_header("Transfer-Encoding", "chunked")
        elif self.path == "/oversized":
            self.send_header("Content-Length", "262145")
        else:
            self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        try:
            if chunked:
                self.write_chunked(body)
            elif body:
                self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def log_message(self, *_args):
        return


server = HTTPServer(("127.0.0.1", 0), Handler)
with open(ready_path, "w", encoding="ascii") as ready:
    ready.write(str(server.server_port))
    ready.flush()
    os.fsync(ready.fileno())
server.serve_forever()
PY
server_pid=$!

for _ in $(seq 1 100); do
  if test -s "$ready_file"; then
    break
  fi
  sleep 0.02
done
test -s "$ready_file"
port=$(<"$ready_file")

run_provider() {
  "$root_dir/main" --provider "$@"
}

run_provider_with_key() {
  env OPENAI_API_KEY=test-key "$root_dir/main" --provider "$@"
}

run_provider_without_key() {
  env -u OPENAI_API_KEY "$root_dir/main" --provider "$@"
}

run_provider openai-local "http://127.0.0.1:$port/v1/chat/completions" smoke-openai - "repair the range" "$temp_dir/openai.json"
run_provider_with_key openai-local "http://127.0.0.1:$port/v1/chat/completions" smoke-openai OPENAI_API_KEY "repair the range" "$temp_dir/openai-auth.json"
run_provider llama "http://127.0.0.1:$port/completion" smoke-llama - "repair the range" "$temp_dir/llama.json" generate "http://127.0.0.1:$port/tokenize"
run_provider openai-local "http://127.0.0.1:$port/v1/chat/completions" smoke-openai - "stream the repair" "$temp_dir/openai-stream.json" stream
run_provider llama "http://127.0.0.1:$port/completion" smoke-llama - "stream the repair" "$temp_dir/llama-stream.json" stream
if run_provider_with_key cloud "http://127.0.0.1:$port/v1/chat/completions" smoke-cloud OPENAI_API_KEY "cloud over http" "$temp_dir/cloud-http.json"; then
  exit 1
fi
if run_provider_without_key cloud "https://api.openai.com/v1/chat/completions" smoke-cloud - "missing auth" "$temp_dir/cloud-missing.json"; then
  exit 1
fi
if run_provider openai-local "http://127.0.0.1:$port/incomplete" smoke-openai - "incomplete stream" "$temp_dir/incomplete.json" stream; then
  exit 1
fi
if run_provider openai-local "http://127.0.0.1:$port/error-stream" smoke-openai - "error stream" "$temp_dir/error-stream.json" stream; then
  exit 1
fi
if run_provider openai-local "http://127.0.0.1:$port/done-only" smoke-openai - "done only" "$temp_dir/done-only.json" stream; then
  exit 1
fi
if run_provider openai-local "http://127.0.0.1:$port/status" smoke-openai - "status error" "$temp_dir/status.json" generate; then
  exit 1
fi
if run_provider openai-local "http://127.0.0.1:$port/status413" smoke-openai - "status error" "$temp_dir/status413.json" generate; then
  exit 1
fi
if run_provider openai-local "http://127.0.0.1:$port/oversized" smoke-openai - "oversized response" "$temp_dir/oversized.json" generate; then
  exit 1
fi
if run_provider openai-local "http://127.0.0.1:$port/malformed-chunk" smoke-openai - "malformed chunk" "$temp_dir/malformed-chunk.json" stream; then
  exit 1
fi
if run_provider llama "http://127.0.0.1:$port/truncated-chunk" smoke-llama - "truncated chunk" "$temp_dir/truncated-chunk.json" stream; then
  exit 1
fi
if run_provider openai-local "http://127.0.0.1:$port/slow" smoke-openai - "timeout" "$temp_dir/timeout.json" generate - 100000000; then
  exit 1
fi

python3 - "$temp_dir" "$observed_file" <<'PY'
import json
import pathlib
import sys

temp_dir = pathlib.Path(sys.argv[1])
observed_path = pathlib.Path(sys.argv[2])
expected = {
    "openai.json": ("openai-local", "generate", "OPENAI-GENERATED"),
    "openai-auth.json": ("openai-local", "generate", "OPENAI-GENERATED"),
    "llama.json": ("llama.cpp", "generate", "LLAMA-GENERATED"),
    "openai-stream.json": ("openai-local", "stream", "OPENAI-STREAM"),
    "llama-stream.json": ("llama.cpp", "stream", "LLAMA-STREAM"),
}

for name, (provider, operation, output) in expected.items():
    record = json.loads((temp_dir / name).read_text(encoding="utf-8"))
    assert record["schema_version"] == 2, (name, record)
    assert record["provider"] == provider, (name, record)
    assert record["operation"] == operation, (name, record)
    assert record["status"] == "ok", (name, record)
    assert record["output"] == output, (name, record)
    assert record["error"] == "", (name, record)
    assert record["error_code"] == -1, (name, record)
    assert record["elapsed_ns"] >= 0, (name, record)

observed = [json.loads(line) for line in observed_path.read_text(encoding="utf-8").splitlines()]
assert any(
    row["path"] == "/v1/chat/completions"
    and row["authorization"] == "Bearer test-key"
    and not row["stream"]
    for row in observed
), observed
assert sum(row["path"] == "/tokenize" for row in observed) == 2, observed
assert any(row["path"] == "/tokenize" and "\n\n" in row["content"] for row in observed), observed
assert sum(row["stream"] for row in observed) == 7, observed

cloud_http = json.loads((temp_dir / "cloud-http.json").read_text(encoding="utf-8"))
assert cloud_http["status"] == "error", cloud_http
assert cloud_http["error"] == "invalid", cloud_http
assert cloud_http["error_code"] == -1, cloud_http

missing_auth = json.loads((temp_dir / "cloud-missing.json").read_text(encoding="utf-8"))
assert missing_auth["status"] == "error", missing_auth
assert missing_auth["error"] == "denied", missing_auth
assert missing_auth["output"] == "", missing_auth
assert missing_auth["error_code"] == -1, missing_auth

incomplete = json.loads((temp_dir / "incomplete.json").read_text(encoding="utf-8"))
assert incomplete["status"] == "error", incomplete
assert incomplete["error"] == "invalid", incomplete
assert incomplete["output"] == "", incomplete

error_stream = json.loads((temp_dir / "error-stream.json").read_text(encoding="utf-8"))
assert error_stream["status"] == "error", error_stream
assert error_stream["error"] == "invalid", error_stream
assert error_stream["output"] == "", error_stream

done_only = json.loads((temp_dir / "done-only.json").read_text(encoding="utf-8"))
assert done_only["status"] == "error", done_only
assert done_only["error"] == "invalid", done_only
assert done_only["output"] == "", done_only

status = json.loads((temp_dir / "status.json").read_text(encoding="utf-8"))
assert status["status"] == "error", status
assert status["error"] == "provider-status", status
assert status["error_code"] == 429, status

status413 = json.loads((temp_dir / "status413.json").read_text(encoding="utf-8"))
assert status413["status"] == "error", status413
assert status413["error"] == "provider-status", status413
assert status413["error_code"] == 413, status413

oversized = json.loads((temp_dir / "oversized.json").read_text(encoding="utf-8"))
assert oversized["status"] == "error", oversized
assert oversized["error"] == "provider-status", oversized
assert oversized["output"] == "", oversized
assert oversized["error_code"] == -1, oversized

for name in ("malformed-chunk.json", "truncated-chunk.json"):
    framing = json.loads((temp_dir / name).read_text(encoding="utf-8"))
    assert framing["status"] == "error", (name, framing)
    assert framing["error"] == "invalid", (name, framing)
    assert framing["output"] == "", (name, framing)
    assert framing["error_code"] == -1, (name, framing)

timeout = json.loads((temp_dir / "timeout.json").read_text(encoding="utf-8"))
assert timeout["status"] == "error", timeout
assert timeout["error"] == "timeout", timeout
assert timeout["output"] == "", timeout

llama = json.loads((temp_dir / "llama.json").read_text(encoding="utf-8"))
assert llama["prompt_tokens"] == 8, llama
assert llama["completion_tokens"] == 4, llama
assert llama["total_tokens"] == 12, llama
assert llama["token_count_exact"] is True, llama
print("provider smoke: adapters, chunked SSE, framing failures, bounded responses, status diagnostics, exact prompt count, and common result format PASS")
PY
