#!/usr/bin/env bash

# c7-persisted-result-owned-move-smoke.
#
# `docs/specs/c7-persisted-result.md` section 13 names this runner for the construction and
# control-flow rows the adoption slice deferred to this consumer: "Result construction",
# "Replacement/drop of `content_sha256`", "Semantic PASS/FAIL", "Diagnostic relation", "Branch
# joins", "Output write failure", "Malformed result cleanup", "Result invariant recomputation",
# and "Same-path input/output".
#
# The artifact mutations and their verdicts are built here from the independent
# `scripts/c7_persisted_result_fixtures.py` table; the module under test never sees an expected
# value.

set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
compiler="${ALIGNC:-${project_root}/scripts/alignc}"
work_dir="$(mktemp -d)"
trap 'rm -rf "${work_dir}"' EXIT

python3 - "${project_root}" "${work_dir}" <<'PY'
import sys
from pathlib import Path

sys.path.insert(0, str(Path(sys.argv[1]) / "scripts"))
import c7_persisted_result_fixtures as fixtures

fixtures.require_golden()
work = Path(sys.argv[2])

pass_input, pass_artifact, pass_status = fixtures.expected_pair("upper-equal", 4, 5, 0, 9, 2, None)
fail_input, fail_artifact, fail_status = fixtures.expected_pair(
    "expected-mismatch", 2, 3, 0, 9, 2, None
)
if pass_status != "PASS" or fail_status != "FAIL":
    raise SystemExit("c7 persisted result owned move smoke: fixture statuses drifted")
(work / "pass.input.json").write_bytes(pass_input.encode("utf-8"))
# The unchanged control copy proves the same-path preflight rejected before touching the input.
(work / "pass.input.control.json").write_bytes(pass_input.encode("utf-8"))
(work / "fail.input.json").write_bytes(fail_input.encode("utf-8"))
(work / "pass.expected.json").write_bytes(pass_artifact.encode("utf-8"))
(work / "fail.expected.json").write_bytes(fail_artifact.encode("utf-8"))

base = dict(
    case_id="upper-equal",
    status="PASS",
    left=4,
    right=5,
    lower_bound=0,
    upper_bound=9,
    expected=2,
    observed=2,
    input_sha256=fixtures.digest(pass_input),
    note=None,
    diagnostic=None,
)


def redigested(**overrides: object) -> str:
    """A mutated record whose own content digest is recomputed, so only the invariant fails."""
    fields = dict(base)
    fields.update(overrides)
    preimage = fixtures.encode_result(content_sha256="", **fields)
    return fixtures.encode_result(content_sha256=fixtures.digest(preimage), **fields)


digest_start = pass_artifact.index('"content_sha256":"') + len('"content_sha256":"')
carried = pass_artifact[digest_start : digest_start + 64]
flipped = ("b" if carried[0] != "b" else "c") + carried[1:]

cases: list[tuple[str, bytes | None, str]] = [
    # Section 8.2 rows 4-5: the digest lexical form and the recomputed content identity.
    ("content-digest-flipped", pass_artifact.replace(carried, flipped).encode("utf-8"), "REJECTED"),
    (
        "content-digest-uppercase",
        pass_artifact.replace(carried, carried.upper()).encode("utf-8"),
        "REJECTED",
    ),
    (
        "content-digest-truncated",
        pass_artifact.replace(carried, carried[:63]).encode("utf-8"),
        "REJECTED",
    ),
    ("input-digest-malformed", pass_artifact.replace(
        base["input_sha256"], "z" * 64).encode("utf-8"), "REJECTED"),
    # Section 8.2 rows 8-9: no stored measurement is trusted even when the digest agrees.
    ("observed-mutated-redigested", redigested(observed=1).encode("utf-8"), "REJECTED"),
    ("status-mutated-redigested", redigested(
        status="FAIL", diagnostic=fixtures.FAIL_DIAGNOSTIC).encode("utf-8"), "REJECTED"),
    ("diagnostic-added-redigested", redigested(
        diagnostic=fixtures.FAIL_DIAGNOSTIC).encode("utf-8"), "REJECTED"),
    ("diagnostic-text-redigested", redigested(
        status="FAIL", expected=1, diagnostic="other text").encode("utf-8"), "REJECTED"),
    # Section 8.2 row 4: unrecognized v1 data is never interpreted.
    ("schema-version-redigested", redigested(schema_version=2).encode("utf-8"), "REJECTED"),
    ("artifact-kind-redigested", redigested(
        artifact_kind=fixtures.INPUT_KIND).encode("utf-8"), "REJECTED"),
    ("algorithm-redigested", redigested(
        algorithm="bounded-bucket-v2").encode("utf-8"), "REJECTED"),
    # Section 8.2 row 7 domains.
    ("expected-out-of-range-redigested", redigested(
        status="FAIL", expected=3, diagnostic=fixtures.FAIL_DIAGNOSTIC).encode("utf-8"), "REJECTED"),
    ("oversized-note-redigested", redigested(note="n" * 257).encode("utf-8"), "REJECTED"),
    # Section 8.2 row 6: the canonical bytes must equal the file bytes exactly.
    (
        "field-order-swapped",
        pass_artifact.replace('"left":4,"right":5', '"right":5,"left":4').encode("utf-8"),
        "REJECTED",
    ),
    (
        "unknown-field",
        pass_artifact.replace('"observed":2,', '"observed":2,"extra":1,').encode("utf-8"),
        "REJECTED",
    ),
    ("leading-whitespace", (" " + pass_artifact).encode("utf-8"), "REJECTED"),
    ("trailing-newline", (pass_artifact + "\n").encode("utf-8"), "REJECTED"),
    (
        "null-optional-spelling",
        pass_artifact.replace('"observed":2,', '"observed":2,"note":null,').encode("utf-8"),
        "REJECTED",
    ),
    ("truncated-artifact", pass_artifact[:-9].encode("utf-8"), "REJECTED"),
    ("absent-artifact", None, "REJECTED"),
    # Section 5.2: the verifier deliberately does not reload `input_sha256`'s source path, so a
    # lexically valid but unrelated input digest is a valid artifact. This is the documented
    # non-claim, asserted so a future change cannot silently widen it.
    ("input-digest-unrelated-redigested", redigested(input_sha256="0" * 64).encode("utf-8"),
     "ACCEPTED"),
]

names = []
verdicts = []
for name, payload, verdict in cases:
    names.append(name)
    verdicts.append(verdict)
    if payload is not None:
        (work / f"mutation-{name}.json").write_bytes(payload)
(work / "mutation-order.txt").write_text("\n".join(names) + "\n", encoding="utf-8")
(work / "mutation-verdicts.txt").write_text("\n".join(verdicts) + "\n", encoding="utf-8")
PY

mutation_paths=()
while IFS= read -r name; do
  mutation_paths+=("${work_dir}/mutation-${name}.json")
done <"${work_dir}/mutation-order.txt"

"${compiler}" run "${project_root}/src/c7_persisted_result_owned_move_smoke.align" \
  "${work_dir}/pass.input.json" \
  "${work_dir}/pass.result.json" \
  "${work_dir}/fail.input.json" \
  "${work_dir}/fail.result.json" \
  "${work_dir}/absent-directory/unwritable.json" \
  "${work_dir}/recovery.result.json" \
  "${mutation_paths[@]}" >"${work_dir}/observed.txt"

python3 - "${work_dir}" <<'PY'
import sys
from pathlib import Path

work = Path(sys.argv[1])
names = (work / "mutation-order.txt").read_text(encoding="utf-8").splitlines()
verdicts = (work / "mutation-verdicts.txt").read_text(encoding="utf-8").splitlines()

expected_rows = [
    # Branch join 1: PASS record, `None` diagnostic owner.
    "pass/status", "PASS", "2", "2",
    # Branch join 2: a valid semantic FAIL is Ok data that still reloads.
    "fail/status", "FAIL", "2", "1",
    "fail-reload/status", "FAIL",
    # Section 7: a failed write is a mapped error with no hidden cleanup, and the next
    # publication of the same input still succeeds.
    "write-failure/verdict", "REJECTED",
    "write-failure/destination-present", "false",
    "write-failure/recovery", "ACCEPTED",
    # Section 8.1 row 1: exact-string path overlap rejects before any file operation.
    "same-path/verdict", "REJECTED",
    "same-path/input-present", "true",
]
expected_rows += verdicts
expected_rows += ["final-verify/status", "PASS"]

raw = (work / "observed.txt").read_bytes()
if not raw.endswith(b"\n"):
    raise SystemExit("c7 persisted result owned move smoke: output is not newline terminated")
observed_rows = raw.decode("utf-8").split("\n")[:-1]
if len(observed_rows) != len(expected_rows):
    raise SystemExit(
        "c7 persisted result owned move smoke: expected "
        f"{len(expected_rows)} rows, observed {len(observed_rows)}"
    )
labels = ["<fixed>"] * (len(expected_rows) - len(verdicts) - 2) + names + ["<fixed>", "<fixed>"]
for label, want, got in zip(labels, expected_rows, observed_rows):
    if want != got:
        raise SystemExit(
            f"c7 persisted result owned move smoke: row {label} expected {want}, observed {got}"
        )

for name in ("pass", "fail"):
    produced = (work / f"{name}.result.json").read_bytes()
    expected = (work / f"{name}.expected.json").read_bytes()
    if produced != expected:
        raise SystemExit(
            f"c7 persisted result owned move smoke: {name} artifact bytes mismatch\n"
            f"  expected: {expected!r}\n"
            f"  observed: {produced!r}"
        )
recovery = (work / "recovery.result.json").read_bytes()
if recovery != (work / "pass.expected.json").read_bytes():
    raise SystemExit(
        "c7 persisted result owned move smoke: the post-write-failure artifact is not canonical"
    )
if (work / "absent-directory").exists():
    raise SystemExit(
        "c7 persisted result owned move smoke: the failed write created a destination directory"
    )
if (work / "pass.input.json").read_bytes() != (work / "pass.input.control.json").read_bytes():
    raise SystemExit("c7 persisted result owned move smoke: the same-path case damaged its input")

fail_document = (work / "fail.result.json").read_text(encoding="utf-8")
if '"status":"FAIL"' not in fail_document:
    raise SystemExit("c7 persisted result owned move smoke: the FAIL artifact lost its status")
if '"diagnostic":"expected does not match observed"' not in fail_document:
    raise SystemExit("c7 persisted result owned move smoke: the FAIL diagnostic is not the fixed text")
if '"diagnostic"' in (work / "pass.result.json").read_text(encoding="utf-8"):
    raise SystemExit("c7 persisted result owned move smoke: the PASS artifact carries a diagnostic")

print(
    f"c7 persisted result owned move smoke: PASS/FAIL branch joins, digest finalization, "
    f"write-failure release, same-path preflight, and {len(names)} artifact mutations PASS"
)
PY
