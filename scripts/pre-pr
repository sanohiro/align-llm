#!/usr/bin/env python3
"""Run change-owned local verification and stamp the exact candidate HEAD."""

from __future__ import annotations

import argparse
import datetime
import json
import os
import signal
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Mapping, Sequence

sys.dont_write_bytecode = True

import output_summary
from verification_scope import REPOSITORY, Scope, ScopeError, classify_refs, diff_changes


COORDINATOR_SIGNALS = tuple(
    selected for selected in output_summary.SIGNALS if selected != signal.SIGPIPE
)


class PreflightError(RuntimeError):
    """Raised when a candidate cannot produce valid local evidence."""


@dataclass(frozen=True)
class PlanStep:
    label: str
    arguments: tuple[str, ...]
    unset_environment: tuple[str, ...] = ()
    parallel_group: str | None = None

    def record(self) -> dict[str, object]:
        return {
            "label": self.label,
            "arguments": list(self.arguments),
            "unset_environment": list(self.unset_environment),
            "parallel_group": self.parallel_group,
        }


def command_output(*arguments: str, repository: Path = REPOSITORY) -> str:
    result = subprocess.run(
        arguments,
        cwd=repository,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
        text=True,
    )
    if result.returncode != 0:
        raise PreflightError(result.stderr.strip() or f"{' '.join(arguments)} failed")
    return result.stdout.strip()


def build_plan(
    scope: Scope,
    *,
    owner_label: str | None,
    owner_command: Sequence[str],
    align_repository: Path,
    explicit_align_repository: bool,
) -> list[PlanStep]:
    if scope.docs_only:
        if owner_label is not None or owner_command:
            raise PreflightError("documentation preflight does not accept an owner command")
        return [
            PlanStep("diff-check", ("git", "diff", "--check", f"{scope.base}...{scope.head}")),
            PlanStep("markdown-fences", ("internal:markdown-fences",)),
        ]
    if not owner_label or not owner_command:
        raise PreflightError("executable preflight requires --owner-test LABEL -- COMMAND ...")
    alignc = align_repository / "target" / "release" / "alignc"
    align_build = (os.fspath(REPOSITORY / "scripts" / "align-toolchain"), "verify")
    managed_ensure: PlanStep | None = PlanStep(
        "managed-align-ensure",
        (os.fspath(REPOSITORY / "scripts" / "align-toolchain"), "ensure", "source"),
    )
    if explicit_align_repository:
        align_build = ("make", "align-build", f"ALIGN_REPO={align_repository}")
        managed_ensure = None
    plan = [
        PlanStep(owner_label, tuple(owner_command)),
    ]
    if managed_ensure is not None:
        plan.append(managed_ensure)
    plan.append(PlanStep("pinned-align-build", align_build))
    # A pure pin adoption proves its request-owned surface locally and leaves the ordinary broad
    # graph to hosted CI. Repeating that graph in local preflight would add no platform-specific
    # evidence. Any other executable change retains the existing hosted integration step.
    if scope.fresh_installed:
        plan.extend(
            (
                PlanStep(
                    "fresh-focused",
                    (sys.executable, "scripts/run-fresh-worker-qualification"),
                ),
                PlanStep(
                    "hosted-checks",
                    ("make", "hosted-checks", f"ALIGNC={alignc}"),
                    parallel_group="fresh-independent",
                ),
                PlanStep(
                    "fresh-installed",
                    (
                        sys.executable,
                        "scripts/run-fresh-worker-qualification",
                        "--installed-profile-only",
                        "--require-docker",
                        "--align-repo",
                        str(align_repository),
                    ),
                    ("DOCKER_HOST",),
                    "fresh-independent",
                ),
            )
        )
    elif scope.scope != "pin":
        plan.append(PlanStep("hosted-checks", ("make", "hosted-checks", f"ALIGNC={alignc}")))
    return plan


def emit_phase(label: str, status: str, duration_ms: int | None = None) -> None:
    record: dict[str, object] = {"event": "preflight-phase", "label": label, "status": status}
    if duration_ms is not None:
        record["duration_ms"] = duration_ms
    print(json.dumps(record, sort_keys=True, separators=(",", ":")), file=sys.stderr)


def step_environment(step: PlanStep) -> Mapping[str, str] | None:
    environment: Mapping[str, str] | None = None
    if step.unset_environment:
        selected = dict(os.environ)
        for name in step.unset_environment:
            selected.pop(name, None)
        environment = selected
    return environment


def run_step(step: PlanStep, repository: Path) -> None:
    environment = step_environment(step)
    started = time.monotonic_ns()
    emit_phase(step.label, "start")
    status = output_summary.run_command(
        step.arguments,
        phase=output_summary.canonical_phase(step.label),
        repository=repository,
        environment=environment,
    )
    duration = max(0, (time.monotonic_ns() - started) // 1_000_000)
    emit_phase(step.label, "pass" if status == 0 else "fail", duration)
    if status != 0:
        raise PreflightError(f"{step.label} failed with status {status}")


def run_parallel_steps(steps: Sequence[PlanStep], repository: Path) -> None:
    if len(steps) < 2:
        raise PreflightError("parallel group must contain at least two steps")
    labels = [step.label for step in steps]
    if len(labels) != len(set(labels)):
        raise PreflightError("parallel group contains duplicate labels")

    wrapper = repository / "scripts" / "run-output-summary"
    running: list[tuple[PlanStep, subprocess.Popen[bytes], int]] = []
    terminal: set[str] = set()
    pending_signal: int | None = None
    previous_handlers: dict[int, signal.Handlers] = {}

    def handle_signal(signum: int, _frame: object) -> None:
        nonlocal pending_signal
        if pending_signal is None:
            pending_signal = signum
        for _step, process, _started in running:
            if process.poll() is None:
                try:
                    process.send_signal(signum)
                except ProcessLookupError:
                    pass

    def finish(processes: Sequence[tuple[PlanStep, subprocess.Popen[bytes], int]]) -> None:
        for _step, process, _started in processes:
            if process.poll() is None:
                try:
                    process.send_signal(signal.SIGTERM)
                except ProcessLookupError:
                    pass
        deadline = time.monotonic() + 8.0
        for _step, process, _started in processes:
            if process.poll() is not None:
                continue
            try:
                process.wait(timeout=max(0.0, deadline - time.monotonic()))
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()

    try:
        for selected_signal in COORDINATOR_SIGNALS:
            previous_handlers[selected_signal] = signal.getsignal(selected_signal)
            signal.signal(selected_signal, handle_signal)
    except (OSError, ValueError) as error:
        for selected_signal, previous in previous_handlers.items():
            signal.signal(selected_signal, previous)
        raise PreflightError(f"cannot install parallel signal ownership: {error}") from error

    caught: BaseException | None = None
    first_failure: PreflightError | None = None
    try:
        for step in steps:
            if pending_signal is not None:
                break
            started = time.monotonic_ns()
            emit_phase(step.label, "start")
            try:
                process = subprocess.Popen(
                    (
                        sys.executable,
                        os.fspath(wrapper),
                        "--phase",
                        output_summary.canonical_phase(step.label),
                        "--",
                        *step.arguments,
                    ),
                    cwd=repository,
                    env=step_environment(step),
                    stdin=None,
                    stdout=None,
                    stderr=None,
                )
            except OSError as error:
                terminal.add(step.label)
                emit_phase(
                    step.label,
                    "fail",
                    max(0, (time.monotonic_ns() - started) // 1_000_000),
                )
                raise PreflightError(f"cannot launch {step.label}: {error}") from error
            running.append((step, process, started))
            if pending_signal is not None:
                try:
                    process.send_signal(pending_signal)
                except ProcessLookupError:
                    pass

        while len(terminal) < len(running):
            made_progress = False
            for step, process, started in running:
                if step.label in terminal:
                    continue
                status = process.poll()
                if status is None:
                    continue
                made_progress = True
                terminal.add(step.label)
                duration = max(0, (time.monotonic_ns() - started) // 1_000_000)
                emit_phase(step.label, "pass" if status == 0 else "fail", duration)
                if status != 0 and first_failure is None:
                    first_failure = PreflightError(f"{step.label} failed with status {status}")
                    finish(
                        tuple(
                            candidate
                            for candidate in running
                            if candidate[0].label not in terminal
                        )
                    )
            if not made_progress and len(terminal) < len(running):
                time.sleep(0.05)
    except BaseException as error:
        caught = error
        finish(running)
        for step, process, started in running:
            if step.label in terminal:
                continue
            status = process.poll()
            if status is None:
                status = process.wait()
            terminal.add(step.label)
            duration = max(0, (time.monotonic_ns() - started) // 1_000_000)
            emit_phase(step.label, "pass" if status == 0 else "fail", duration)
    finally:
        for selected_signal, previous in previous_handlers.items():
            signal.signal(selected_signal, previous)
    if pending_signal is not None:
        output_summary.self_signal(pending_signal)
    if caught is not None:
        raise caught
    if first_failure is not None:
        raise first_failure


def execution_batches(plan: Sequence[PlanStep]) -> tuple[tuple[PlanStep, ...], ...]:
    batches: list[tuple[PlanStep, ...]] = []
    seen_groups: set[str] = set()
    index = 0
    while index < len(plan):
        step = plan[index]
        if step.parallel_group is None:
            batches.append((step,))
            index += 1
            continue
        group = step.parallel_group
        if group in seen_groups:
            raise PreflightError(f"parallel group is not contiguous: {group}")
        selected: list[PlanStep] = []
        while index < len(plan) and plan[index].parallel_group == group:
            selected.append(plan[index])
            index += 1
        if len(selected) < 2:
            raise PreflightError(f"parallel group has fewer than two steps: {group}")
        seen_groups.add(group)
        batches.append(tuple(selected))
    return tuple(batches)


def validate_markdown_fences(scope: Scope, repository: Path) -> None:
    for status, relative in diff_changes(scope.base, scope.head, repository):
        if status == "D" or not relative.endswith(".md"):
            continue
        path = repository / relative
        try:
            fences = sum(1 for line in path.read_text(encoding="utf-8").splitlines() if line.startswith("```"))
        except (OSError, UnicodeError) as error:
            raise PreflightError(f"cannot validate Markdown fences in {relative}: {error}") from error
        if fences % 2 != 0:
            raise PreflightError(f"unbalanced Markdown fences: {relative}")


def clean_worktree(repository: Path) -> bool:
    return not command_output(
        "git", "status", "--porcelain", "--untracked-files=all", repository=repository
    )


def stamp_path(repository: Path, head: str) -> Path:
    raw = command_output("git", "rev-parse", "--git-path", "align-llm-preflight", repository=repository)
    directory = Path(raw)
    if not directory.is_absolute():
        directory = repository / directory
    return directory / head


def write_stamp(path: Path, scope: Scope, owner_label: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    content = {
        "version": 1,
        "head": scope.head,
        "base": scope.base,
        "scope": scope.scope,
        "owner_test": owner_label,
        "created_at": datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat(),
    }
    descriptor, temporary_name = tempfile.mkstemp(prefix="preflight-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as output:
            json.dump(content, output, sort_keys=True, separators=(",", ":"))
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary_name, path)
    except BaseException:
        try:
            os.unlink(temporary_name)
        except FileNotFoundError:
            pass
        raise


def parse_arguments(arguments: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base", default="origin/main")
    parser.add_argument("--align-repo")
    parser.add_argument("--owner-test")
    parser.add_argument("--plan", action="store_true")
    parser.add_argument("command", nargs=argparse.REMAINDER)
    values = parser.parse_args(arguments)
    if values.command and values.command[0] == "--":
        values.command = values.command[1:]
    return values


def resolve_align_repository(value: str | None, *, ensure: bool) -> Path:
    if value is not None:
        selected = Path(value)
        if not selected.is_absolute():
            selected = REPOSITORY / selected
        return selected.resolve(strict=False)
    helper = REPOSITORY / "scripts" / "align-toolchain"
    action = "ensure" if ensure else "path"
    result = subprocess.run(
        (os.fspath(helper), action, "source"),
        cwd=REPOSITORY,
        stdout=subprocess.PIPE,
        check=False,
        text=True,
    )
    if result.returncode != 0:
        raise PreflightError(f"managed Align source resolution failed with status {result.returncode}")
    output = result.stdout.strip()
    if not output or "\n" in output:
        raise PreflightError("managed Align source resolution returned an invalid path")
    selected = Path(output)
    if not selected.is_absolute():
        raise PreflightError("managed Align source resolution returned a relative path")
    return selected


def main(arguments: Sequence[str] | None = None) -> int:
    values = parse_arguments(sys.argv[1:] if arguments is None else arguments)
    try:
        branch = command_output("git", "branch", "--show-current")
        if not branch or branch == "main":
            raise PreflightError("preflight requires a named non-main branch")
        if not clean_worktree(REPOSITORY):
            raise PreflightError("preflight requires a clean worktree")
        scope = classify_refs(values.base, "HEAD", REPOSITORY)
        align_repository = (
            REPOSITORY
            if scope.docs_only
            else resolve_align_repository(values.align_repo, ensure=False)
        )
        plan = build_plan(
            scope,
            owner_label=values.owner_test,
            owner_command=values.command,
            align_repository=align_repository,
            explicit_align_repository=values.align_repo is not None,
        )
        if values.plan:
            print(
                json.dumps(
                    {"scope": scope.scope, "base": scope.base, "head": scope.head, "steps": [step.record() for step in plan]},
                    sort_keys=True,
                    separators=(",", ":"),
                )
            )
            return 0
        for batch in execution_batches(plan):
            if len(batch) > 1:
                run_parallel_steps(batch, REPOSITORY)
                continue
            step = batch[0]
            if step.label == "markdown-fences":
                started = time.monotonic_ns()
                emit_phase(step.label, "start")
                validate_markdown_fences(scope, REPOSITORY)
                emit_phase(
                    step.label,
                    "pass",
                    max(0, (time.monotonic_ns() - started) // 1_000_000),
                )
            else:
                run_step(step, REPOSITORY)
        current_head = command_output("git", "rev-parse", "HEAD")
        if current_head != scope.head or not clean_worktree(REPOSITORY):
            raise PreflightError("HEAD or worktree changed during preflight")
        path = stamp_path(REPOSITORY, scope.head)
        write_stamp(path, scope, values.owner_test or "none")
        print(f"preflight recorded for {scope.head} ({scope.scope}; owner {values.owner_test or 'none'})")
        return 0
    except (OSError, ScopeError, PreflightError) as error:
        print(f"preflight error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
