def test_workflow_topology() -> None:
    workflow = (REPOSITORY / ".github/workflows/ci.yml").read_text(encoding="utf-8")

    def fresh_step(source: str, name: str) -> str:
        fresh_workflow = source[source.index("  fresh-image-profile:") :]
        marker = f"      - name: {name}\n"
        start = fresh_workflow.index(marker)
        end = fresh_workflow.find("\n      - name:", start + len(marker))
        if end < 0:
            end = len(fresh_workflow)
        return fresh_workflow[start:end]

    def fresh_condition(source: str, name: str) -> str:
        rows = [
            line.removeprefix("        if: ")
            for line in fresh_step(source, name).splitlines()
            if line.startswith("        if: ")
        ]
        require(len(rows) == 1, f"fresh step does not have one if condition: {name}")
        return rows[0]

    normal_installed_condition = (
        "steps.reuse.outputs.reused != 'true' && "
        "steps.scope.outputs.fresh_installed == 'true'"
    )

    def require_fresh_reuse_routing(source: str) -> None:
        expected = {
            "Report reused pull request checks": "steps.reuse.outputs.reused == 'true'",
            "Classify verification scope": "steps.reuse.outputs.reused != 'true'",
            "Run deterministic control-plane checks": (
                "steps.reuse.outputs.reused != 'true' && "
                "steps.scope.outputs.fresh_focused == 'true'"
            ),
            "Set up Docker Buildx": normal_installed_condition,
            "Prepare installed image signing material": normal_installed_condition,
            "Build installed image with shared layers": normal_installed_condition,
            "Restore pinned Align source": normal_installed_condition,
            "Materialize pinned Align source": normal_installed_condition,
            "Enable qualified nested user namespaces": normal_installed_condition,
            "Complete installed image profile qualification": normal_installed_condition,
            "Restore user namespace restriction": (
                "always() && steps.reuse.outputs.reused != 'true' && "
                "steps.scope.outputs.fresh_installed == 'true' && "
                "steps.userns.outputs.changed == 'true'"
            ),
            "Clean installed image signing material": (
                "always() && steps.image_material.outcome == 'success'"
            ),
            "Report unaffected image profile": (
                "steps.reuse.outputs.reused != 'true' && "
                "steps.scope.outputs.fresh_installed != 'true'"
            ),
        }
        actual = {name: fresh_condition(source, name) for name in expected}
        require(actual == expected, "fresh-image reuse routing conditions changed")

    require(
        workflow.count(
            "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1"
        )
        == 2,
        "CI does not use the reviewed Node 24 checkout action in both jobs",
    )
    require(
        workflow.count(
            "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1"
        )
        == 1
        and "ALIGN_LLM_OUTPUT_DIRECTORY: ${{ runner.temp }}/align-llm-output" in workflow
        and "python3 scripts/run-output-summary --phase hosted-checks --" in workflow
        and 'make -j8 ALIGNC="$ALIGNC" hosted-checks' in workflow
        and "if: always() && steps.supported-checks.outcome != 'skipped'" in workflow
        and "name: verification-output-${{ github.run_id }}-${{ github.run_attempt }}" in workflow
        and "path: ${{ env.ALIGN_LLM_OUTPUT_DIRECTORY }}" in workflow
        and "if-no-files-found: error" in workflow
        and "retention-days: 14" in workflow,
        "CI does not retain the summarized hosted-check evidence",
    )
    cache_pin = "actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0"
    save_pin = "actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0"
    require(
        workflow.count(cache_pin) == 4
        and workflow.count(save_pin) == 2
        and workflow.count(
            "actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0"
        )
        == 1,
        "CI does not use the reviewed Node 24 cache action at all seven owners",
    )
    require(
        "llvm-22-dev clang-22 libclang-rt-22-dev lld-22\n"
        "        libssl-dev zlib1g-dev libzstd-dev make perl" in workflow
        and workflow.count("scripts/ci-apt-llvm.sh key") == 1
        and workflow.count("scripts/ci-apt-llvm.sh install") == 1
        and workflow.count("scripts/ci-apt-llvm.sh verify") == 1
        and "https://apt.llvm.org/llvm.sh" not in workflow,
        "CI does not own the exact replayable hosted package request",
    )
    bundle_route = (
        "if: (steps.reuse.outputs.reused != 'true' && "
        "steps.scope.outputs.hosted == 'true') || (steps.reuse.outputs.reused == 'true' && "
        "github.event_name == 'push' && github.ref == 'refs/heads/main')"
    )
    require(
        workflow.count(bundle_route) == 2
        and workflow.count("python3 scripts/ci-align-bundle key") == 1
        and workflow.count("python3 scripts/ci-align-bundle create") == 1
        and workflow.count("python3 scripts/ci-align-bundle verify") == 2
        and "id: align-bundle-cache" in workflow
        and workflow.count('echo "ALIGNC=$BUNDLE_DIRECTORY/alignc" >> "$GITHUB_ENV"') == 2
        and workflow.count('echo "LD_LIBRARY_PATH=$BUNDLE_DIRECTORY" >> "$GITHUB_ENV"') == 2
        and '${LD_LIBRARY_PATH' not in workflow
        and "--llvm-library /lib/x86_64-linux-gnu/libLLVM.so.22.1" in workflow
        and workflow.count('--image-version "$ImageVersion"') == 4
        and workflow.count('--runner-os "$RUNNER_OS"') == 4
        and workflow.count('--runner-arch "$RUNNER_ARCH"') == 4
        and workflow.count('--rust-version "$RUST_VERSION"') == 4
        and workflow.count("LLVM_SYS_221_PREFIX: /usr/lib/llvm-22") == 1
        and workflow.count("LLVM_CONFIG: /usr/lib/llvm-22/bin/llvm-config") == 1
        and 'echo "LLVM_SYS_221_PREFIX=' not in workflow
        and 'echo "LLVM_CONFIG=' not in workflow
        and '>> "$GITHUB_PATH"' not in workflow,
        "CI does not resolve, restore, create, and verify the exact hosted compiler bundle",
    )
    bundle_miss_route = (
        "if: ((steps.reuse.outputs.reused != 'true' && "
        "steps.scope.outputs.hosted == 'true') || (steps.reuse.outputs.reused == 'true' && "
        "github.event_name == 'push' && github.ref == 'refs/heads/main')) && "
        "steps.align-bundle-cache.outputs.cache-hit != 'true'"
    )
    bundle_consumer_route = (
        "if: (steps.reuse.outputs.reused != 'true' && steps.scope.outputs.hosted == 'true') || "
        "(steps.reuse.outputs.reused == 'true' && github.event_name == 'push' && "
        "github.ref == 'refs/heads/main' && steps.align-bundle-cache.outputs.cache-hit != 'true')"
    )
    save_condition = (
        "if: steps.apt-llvm-cache.outcome == 'success' && "
        "steps.supported-checks.outcome == 'success' && github.event_name == 'push' && "
        "github.ref == 'refs/heads/main' && "
        "steps.apt-llvm-cache.outputs.cache-hit != 'true'"
    )
    require(
        workflow.count(bundle_miss_route) == 7
        and bundle_consumer_route in workflow
        and save_condition in workflow
        and "id: apt-llvm-candidate" in workflow
        and "id: apt-llvm-save" in workflow
        and "id: apt-llvm-confirm" in workflow
        and "if: steps.apt-llvm-candidate.outcome == 'success'" in workflow
        and "if: steps.apt-llvm-save.outcome == 'success'" in workflow
        and "lookup-only: true" in workflow
        and "fail-on-cache-miss: true" in workflow
        and "if: always() && steps.apt-llvm-save.outcome == 'success'" in workflow
        and "CACHE_HIT: ${{ steps.apt-llvm-confirm.outputs.cache-hit }}" in workflow
        and 'if [[ "$CACHE_HIT" != "true" ]]; then' in workflow
        and workflow.index("- name: Reverify the apt package cache candidate")
        > workflow.index("- name: Run supported project checks")
        and workflow.index("- name: Save the apt package cache")
        > workflow.index("- name: Reverify the apt package cache candidate")
        and workflow.index("- name: Confirm the published apt package cache")
        > workflow.index("- name: Save the apt package cache")
        and workflow.index("- name: Require the published apt package cache")
        > workflow.index("- name: Confirm the published apt package cache"),
        "CI does not reverify, save, confirm, and require an exact main candidate after its consumer",
    )
    bundle_save_condition = (
        "if: steps.align-bundle-create.outcome == 'success' && "
        "steps.supported-checks.outcome == 'success' && github.event_name == 'push' && "
        "github.ref == 'refs/heads/main'"
    )
    require(
        "if: steps.align-bundle-cache.outputs.cache-hit == 'true'" in workflow
        and bundle_save_condition in workflow
        and "id: align-bundle-candidate" in workflow
        and "id: align-bundle-save" in workflow
        and "id: align-bundle-confirm" in workflow
        and "if: steps.align-bundle-candidate.outcome == 'success'" in workflow
        and "if: steps.align-bundle-save.outcome == 'success'" in workflow
        and "if: always() && steps.align-bundle-save.outcome == 'success'" in workflow
        and "CACHE_HIT: ${{ steps.align-bundle-confirm.outputs.cache-hit }}" in workflow
        and workflow.count('if [[ "$CACHE_HIT" != "true" ]]; then') == 2
        and workflow.index("- name: Verify the hosted Align compiler bundle")
        < workflow.index("- name: Resolve the apt package cache entry")
        and workflow.index("- name: Create the hosted Align compiler bundle")
        > workflow.index("- name: Build the pinned Align compiler")
        and workflow.index("- name: Run supported project checks")
        > workflow.index("- name: Create the hosted Align compiler bundle")
        and workflow.index("- name: Reverify the hosted Align compiler bundle candidate")
        > workflow.index("- name: Run supported project checks")
        and workflow.index("- name: Save the hosted Align compiler bundle")
        > workflow.index("- name: Reverify the hosted Align compiler bundle candidate")
        and workflow.index("- name: Confirm the published hosted Align compiler bundle")
        > workflow.index("- name: Save the hosted Align compiler bundle")
        and workflow.index("- name: Require the published hosted Align compiler bundle")
        > workflow.index("- name: Confirm the published hosted Align compiler bundle")
        and "continue-on-error" not in workflow,
        "CI does not fail closed across bundle hit, miss, consumer, and publication routing",
    )
    require(workflow.count("python3 scripts/classify-verification") == 6, "CI classifier callsites changed")
    require(
        workflow.index("Development workflow self-test")
        > workflow.index("Classify verification scope"),
        "CI self-tests selection machinery before scope is known",
    )
    self_test = workflow[workflow.index("- name: Development workflow self-test") :]
    self_test = self_test[: self_test.index("\n      - name:", 1)]
    require(
        "if: steps.reuse.outputs.reused != 'true' && steps.scope.outputs.hosted == 'true'"
        in self_test,
        "docs-only CI runs the executable workflow self-test",
    )
    require(
        workflow.count("case \"$path\"") == 1,
        "CI retained a duplicate executable-path classifier",
    )
    require(
        "--installed-profile-only --require-docker" in workflow,
        "CI does not use the required installed-only mode",
    )
    require(
        "align-full-source-${{ runner.os }}-${{ matrix.architecture }}-"
        "${{ hashFiles('.align-revision') }}" in workflow,
        "CI does not cache full Align source by native architecture and pinned revision",
    )
    require(
        '--align-repo "$GITHUB_WORKSPACE/align-source"' in workflow,
        "CI does not pass the cached Align source to the installed owner",
    )
    require(
        "fsck --connectivity-only --no-dangling" in workflow
        and "Pinned Align cache must not be a partial clone" in workflow,
        "CI does not revalidate cached full-source connectivity",
    )
    require(
        "python3 scripts/run-fresh-worker-qualification --installed-profile\n" not in workflow,
        "CI retained the duplicate full qualification",
    )
    require(
        "docker/setup-buildx-action@bb05f3f5519dd87d3ba754cc423b652a5edd6d2c" in workflow
        and "docker/build-push-action@53b7df96c91f9c12dcc8a07bcb9ccacbed38856a" in workflow,
        "CI does not use commit-pinned Buildx owners",
    )
    require(
        "cache-from: type=gha,scope=align-llm-fresh-image-v1-${{ matrix.architecture }}"
        in workflow
        and "cache-to: type=gha,scope=align-llm-fresh-image-v1-"
        "${{ matrix.architecture }},mode=max,ignore-error=true" in workflow,
        "CI BuildKit cache is not architecture-bounded or fails closed on export",
    )
    require(
        "name: Installed Ubuntu 24.04 fresh-image profile (${{ matrix.architecture }})"
        in workflow
        and "architecture: x86_64\n            runner: ubuntu-24.04" in workflow
        and "architecture: aarch64\n            runner: ubuntu-24.04-arm" in workflow,
        "CI does not own both native installed-image profiles",
    )
    require(
        "load: true" in fresh_step(workflow, "Build installed image with shared layers"),
        "normally executing fresh-image builds do not load their qualified image",
    )
    require(
        workflow.count("python3 scripts/prepare-fresh-image-build") == 2
        and "if: always() && steps.image_material.outcome == 'success'" in workflow,
        "CI does not prepare and clean per-run signing material",
    )
    require(
        '--prepared-image "$PREPARED_IMAGE"' in workflow
        and '--image-signing-seed "$IMAGE_SIGNING_SEED"' in workflow
        and '--run-signing-seed "$RUN_SIGNING_SEED"' in workflow,
        "CI does not pass the prepared image to the installed owner",
    )
    require_fresh_reuse_routing(workflow)
    for name in ("Set up Docker Buildx", "Clean installed image signing material"):
        condition = fresh_condition(workflow, name)
        weakened = workflow.replace(
            f"        if: {condition}\n",
            f"        if: {condition} || steps.reuse.outputs.reused == 'true'\n",
            1,
        )
        try:
            require_fresh_reuse_routing(weakened)
        except RuntimeError:
            pass
        else:
            raise RuntimeError(f"fresh reuse routing mutation was accepted: {name}")
    require(
        workflow.count("python3 scripts/select-ci-reuse") == 2,
        "CI does not evaluate merge-push reuse in both jobs",
    )
    require(
        workflow.count(
            "Bind pull request evidence pr=${{ github.event.pull_request.number }} "
            "base=${{ github.event.pull_request.base.sha }} "
            "head=${{ github.event.pull_request.head.sha }}"
        )
        == 2
        and workflow.count("if: always() && github.event_name == 'pull_request'") == 2,
        "CI does not bind both successful job records to exact pull request identities",
    )
    require(
        workflow.count("steps.reuse.outputs.reused != 'true'") >= 12,
        "CI normal steps are not guarded by reuse",
    )
    require(
        "actions: read" in workflow
        and "pull-requests: read" in workflow
        and "checks: write" not in workflow
        and "contents: write" not in workflow,
        "CI reuse permissions are not read-only and bounded",
    )


def test_cli() -> None:
    output_summary = subprocess.run(
        (sys.executable, "scripts/test-output-summary"),
        cwd=REPOSITORY,
        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    require(
        output_summary.returncode == 0
        and output_summary.stdout.endswith("worktrees, and adopters PASS\n")
        and not output_summary.stderr,
        f"output summary owner failed: {output_summary!r}",
    )
    toolchain = subprocess.run(
        (sys.executable, "scripts/test-align-toolchain"),
        cwd=REPOSITORY,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    require(
        toolchain.returncode == 0
        and toolchain.stdout.endswith("pin, warm reuse, validation, and overrides PASS\n")
        and not toolchain.stderr,
        f"managed Align toolchain owner failed: {toolchain!r}",
    )
    result = subprocess.run(
        (sys.executable, "scripts/classify-verification", "--all", "--head", "HEAD"),
        cwd=REPOSITORY,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    require(result.returncode == 0 and not result.stderr, "classifier CLI failed")
    record = json.loads(result.stdout)
    require(record["scope"] == "fresh-image" and record["base"] == "", "all-scope CLI changed")

    with tempfile.TemporaryDirectory(prefix="align-llm-ci-reuse-cli-") as temporary:
        event = Path(temporary) / "event.json"
        output = Path(temporary) / "output"
        event.write_text("{}\n", encoding="utf-8")
        result = subprocess.run(
            (
                sys.executable,
                "scripts/select-ci-reuse",
                "--event-name",
                "pull_request",
                "--event-path",
                str(event),
                "--repository",
                "sanohiro/align-llm",
                "--api-url",
                "https://api.github.com",
                "--github-output",
                str(output),
            ),
            cwd=REPOSITORY,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        require(result.returncode == 0 and not result.stderr, "CI reuse CLI failed")
        record = json.loads(result.stdout)
        require(
            record["version"] == 1
            and record["reused"] is False
            and record["reason"] == "event-not-push",
            "CI reuse CLI queried a pull-request event",
        )
        require(
            "version=1\n" in output.read_text(encoding="utf-8")
            and "reused=false\n" in output.read_text(encoding="utf-8"),
            "CI reuse CLI omitted GitHub output",
        )
    require(not (SCRIPTS / "__pycache__").exists(), "public CLI created repository bytecode")


def main() -> int:
    test_classifier()
    test_runtime_materialization()
    test_plan()
    test_ci_reuse()
    test_qualification_modes()
    test_image_build_material()
    test_image_profile_plan()
    test_apt_llvm_cache()
    test_align_bundle()
    test_workflow_topology()
    test_cli()
    print(
        "development preflight: classifier, runtime materialization, apt archives, hosted bundle, "
        "managed toolchain, plans, qualification modes, and CI topology PASS"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
