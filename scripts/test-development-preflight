#!/usr/bin/env python3
"""Owner regression for shared verification classification and local preflight."""

from __future__ import annotations

import contextlib
import importlib.machinery
import importlib.util
import io
import json
import os
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path
from types import ModuleType, SimpleNamespace


REPOSITORY = Path(__file__).resolve().parent.parent
SCRIPTS = REPOSITORY / "scripts"
sys.dont_write_bytecode = True
sys.path.insert(0, str(SCRIPTS))

import verification_scope as scope_module  # noqa: E402


def load_script(name: str, module_name: str) -> ModuleType:
    loader = importlib.machinery.SourceFileLoader(module_name, str(SCRIPTS / name))
    specification = importlib.util.spec_from_loader(module_name, loader)
    if specification is None:
        raise RuntimeError(f"cannot create a module specification for {name}")
    module = importlib.util.module_from_spec(specification)
    sys.modules[module_name] = module
    loader.exec_module(module)
    return module


def require(condition: bool, message: str) -> None:
    if not condition:
        raise RuntimeError(message)


def classify(*changes: tuple[str, str]) -> scope_module.Scope:
    return scope_module.classify_changes(changes, base="b" * 40, head="h" * 40)


def test_classifier() -> None:
    parsed = scope_module.parse_name_status(b"M\x00docs/a.md\x00A\x00docs/b.md\x00")
    require(parsed == [("M", "docs/a.md"), ("A", "docs/b.md")], "NUL diff parsing changed")
    for malformed in (b"M\x00docs/a.md", b"MM\x00docs/a.md\x00", b"Q\x00docs/a.md\x00"):
        try:
            scope_module.parse_name_status(malformed)
        except scope_module.ScopeError:
            pass
        else:
            raise RuntimeError(f"malformed name-status was accepted: {malformed!r}")

    docs = classify(("M", "docs/a.md"), ("A", "HANDOFF.md"))
    require(docs.scope == "docs" and docs.docs_only and not docs.hosted, "docs scope changed")
    deleted_docs = classify(("D", "docs/a.md"))
    require(deleted_docs.scope == "hosted" and deleted_docs.hosted, "deletion became light")
    hosted = classify(("M", "scripts/run-provider-smoke"))
    require(hosted.scope == "hosted" and not hosted.fresh_installed, "hosted scope changed")
    for path in (
        "src/main.align",
        "src/repo_index.align",
        "eval/tasks/smoke-v1.json",
        "eval/runners/record-baseline.py",
    ):
        selected = classify(("M", path))
        require(
            selected.scope == "hosted"
            and selected.hosted
            and not selected.fresh_focused
            and not selected.fresh_installed,
            f"ordinary application path selected a platform profile: {path}",
        )
    pin = classify(("M", ".align-revision"))
    require(
        pin.scope == "pin"
        and pin.hosted
        and not pin.fresh_focused
        and not pin.fresh_installed,
        "pin-only adoption selected a platform profile",
    )
    pin_with_docs = classify(("M", ".align-revision"), ("M", "docs/align-requests.md"))
    require(pin_with_docs.scope == "pin", "pin adoption documentation widened verification")
    pin_with_hosted = classify(("M", ".align-revision"), ("M", "scripts/run-provider-smoke"))
    require(
        pin_with_hosted.scope == "hosted"
        and pin_with_hosted.hosted
        and not pin_with_hosted.fresh_installed,
        "pin plus hosted owner skipped or widened its ordinary scope",
    )
    pin_with_fresh = classify(("M", ".align-revision"), ("M", "Makefile"))
    require(
        pin_with_fresh.scope == "fresh-image"
        and pin_with_fresh.hosted
        and pin_with_fresh.fresh_focused
        and pin_with_fresh.fresh_installed,
        "pin plus fresh owner skipped the installed profile",
    )
    linux_runner = "eval/runners/run-coding-task.py"
    for status in ("A", "M", "D"):
        selected = classify((status, linux_runner))
        require(
            selected.scope == "fresh-image"
            and selected.hosted
            and selected.fresh_focused
            and selected.fresh_installed,
            f"Linux sandbox runner {status} skipped a platform profile",
        )
    renamed_linux_runner = scope_module.parse_name_status(
        b"D\x00eval/runners/run-coding-task.py\x00A\x00eval/runners/retired.py\x00"
    )
    require(
        classify(*renamed_linux_runner).scope == "fresh-image",
        "renamed Linux sandbox runner skipped a platform profile",
    )
    pin_with_linux_runner = classify(
        ("M", ".align-revision"), ("M", linux_runner)
    )
    require(
        pin_with_linux_runner.scope == "fresh-image"
        and pin_with_linux_runner.fresh_installed,
        "pin plus Linux sandbox runner skipped a platform profile",
    )
    renamed_pin_changes = scope_module.parse_name_status(
        b"D\x00.align-revision\x00A\x00retired-align-revision\x00"
    )
    require(
        classify(*renamed_pin_changes).scope == "fresh-image",
        "renamed pin did not fail closed",
    )
    for path in (
        "Makefile",
        ".github/workflows/ci.yml",
        "image/fresh/Dockerfile",
        "scripts/run-fresh-worker-qualification",
        "scripts/verification_scope.py",
        "scripts/classify-verification",
        "scripts/ci-align-bundle",
        "scripts/materialize-fresh-tree",
        "scripts/pre-pr",
        "scripts/prepare-fresh-image-build",
        "scripts/select-ci-reuse",
        "scripts/test-development-preflight",
        "scripts/test-ci-align-bundle",
    ):
        selected = classify(("M", path))
        require(
            selected.scope == "fresh-image"
            and selected.hosted
            and selected.fresh_focused
            and selected.fresh_installed,
            f"fresh owner was not selected: {path}",
        )
    try:
        scope_module.classify_changes((), base="b" * 40, head="h" * 40)
    except scope_module.ScopeError:
        pass
    else:
        raise RuntimeError("empty diff was accepted")


def test_runtime_materialization() -> None:
    materializer = load_script(
        "materialize-fresh-tree", "align_llm_materialize_fresh_tree_test"
    )
    manifest_generator = load_script(
        "generate-fresh-toolchain-manifest",
        "align_llm_generate_fresh_toolchain_manifest_test",
    )
    with tempfile.TemporaryDirectory(prefix="align-llm-materialize-") as temporary:
        root = Path(temporary)
        source = root / "source"
        target = root / "target"
        source.mkdir(mode=0o751)
        source.chmod(0o751)
        original = source / "a-original"
        original.write_bytes(b"shared executable bytes")
        original.chmod(0o640)
        os.link(original, source / "b-hardlink")
        (source / "c-file-alias").symlink_to("a-original")
        (source / "d-dangling").symlink_to("missing")
        directory = source / "e-directory"
        directory.mkdir(mode=0o750)
        directory.chmod(0o750)
        child = directory / "child"
        child.write_bytes(b"directory child")
        child.chmod(0o751)
        (directory / "cycle").symlink_to("..")
        (source / "f-directory-alias").symlink_to("e-directory")

        result = subprocess.run(
            (sys.executable, "scripts/materialize-fresh-tree", str(source), str(target)),
            cwd=REPOSITORY,
            env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        require(
            result.returncode == 0 and not result.stdout and not result.stderr,
            "materializer failed",
        )
        require(stat.S_IMODE(target.stat().st_mode) == 0o751, "materialized root mode changed")
        require(
            stat.S_IMODE((target / "a-original").stat().st_mode) == 0o640,
            "materialized file mode changed",
        )
        regular_identities = {
            (target / name).stat().st_ino
            for name in ("a-original", "b-hardlink", "c-file-alias")
        }
        require(len(regular_identities) == 1, "resolved regular aliases were duplicated")
        require((target / "a-original").stat().st_nlink == 3, "regular link count changed")
        require(not (target / "d-dangling").exists(), "dangling symlink was retained")
        require(not (target / "e-directory/cycle").exists(), "directory cycle was retained")
        require(
            stat.S_IMODE((target / "e-directory").stat().st_mode) == 0o750
            and stat.S_IMODE((target / "e-directory/child").stat().st_mode) == 0o751,
            "materialized directory modes changed",
        )
        require(
            (target / "e-directory/child").stat().st_ino
            == (target / "f-directory-alias/child").stat().st_ino,
            "repeated directory alias duplicated a regular file",
        )
        require(
            not any(path.is_symlink() for path in target.rglob("*")),
            "materialized tree retained a symlink",
        )

        multi_source_a = root / "multi-source-a"
        multi_source_b = root / "multi-source-b"
        multi_source_a.mkdir()
        multi_source_b.mkdir()
        shared = multi_source_a / "shared"
        shared.write_bytes(b"cross-root identity")
        shared.chmod(0o640)
        os.link(shared, multi_source_b / "shared-alias")
        (multi_source_a / "equal-a").write_bytes(b"equal but independent")
        (multi_source_b / "equal-b").write_bytes(b"equal but independent")
        multi_target_a = root / "multi-target-a"
        multi_target_b = root / "multi-target-b"
        multi = subprocess.run(
            (
                sys.executable,
                "scripts/materialize-fresh-tree",
                str(multi_source_a),
                str(multi_target_a),
                str(multi_source_b),
                str(multi_target_b),
            ),
            cwd=REPOSITORY,
            env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        require(
            multi.returncode == 0 and not multi.stdout and not multi.stderr,
            "multi-root materialization failed",
        )
        require(
            (multi_target_a / "shared").stat().st_ino
            == (multi_target_b / "shared-alias").stat().st_ino,
            "cross-root source identity was duplicated",
        )
        require(
            (multi_target_a / "equal-a").stat().st_ino
            != (multi_target_b / "equal-b").stat().st_ino,
            "equal-byte distinct source identities were merged",
        )

        guarded_target_a = root / "guarded-target-a"
        guarded_target_b = root / "guarded-target-b"
        guarded_target_b.mkdir()
        guarded = subprocess.run(
            (
                sys.executable,
                "scripts/materialize-fresh-tree",
                str(multi_source_a),
                str(guarded_target_a),
                str(multi_source_b),
                str(guarded_target_b),
            ),
            cwd=REPOSITORY,
            env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        require(
            guarded.returncode != 0
            and "target already exists" in guarded.stderr
            and not guarded_target_a.exists(),
            "later existing target allowed earlier target construction",
        )

        incomplete = subprocess.run(
            (
                sys.executable,
                "scripts/materialize-fresh-tree",
                str(multi_source_a),
                str(root / "incomplete-target"),
                str(multi_source_b),
            ),
            cwd=REPOSITORY,
            env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        require(
            incomplete.returncode == 2
            and "expected one or more SOURCE TARGET pairs" in incomplete.stderr,
            "incomplete source/target vector was accepted",
        )

        overlapping_target = root / "overlapping-target"
        overlapping = subprocess.run(
            (
                sys.executable,
                "scripts/materialize-fresh-tree",
                str(multi_source_a),
                str(overlapping_target),
                str(multi_source_b),
                str(overlapping_target / "child"),
            ),
            cwd=REPOSITORY,
            env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        require(
            overlapping.returncode == 2
            and "target roots must be distinct and non-overlapping" in overlapping.stderr
            and not overlapping_target.exists(),
            "overlapping target roots were accepted",
        )

        descendant_target = multi_source_a / "generated"
        descendant = subprocess.run(
            (
                sys.executable,
                "scripts/materialize-fresh-tree",
                str(multi_source_a),
                str(descendant_target),
            ),
            cwd=REPOSITORY,
            env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        require(
            descendant.returncode == 2
            and "source and target roots must be non-overlapping" in descendant.stderr
            and not descendant_target.exists(),
            "source-descendant target was accepted",
        )

        later_source = root / "later-source"
        later_source.mkdir()
        (later_source / "file").write_bytes(b"later source")
        earlier_target = later_source / "earlier-target"
        later_target = root / "later-target"
        source_intersection = subprocess.run(
            (
                sys.executable,
                "scripts/materialize-fresh-tree",
                str(multi_source_a),
                str(earlier_target),
                str(later_source),
                str(later_target),
            ),
            cwd=REPOSITORY,
            env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        require(
            source_intersection.returncode == 2
            and "source and target roots must be non-overlapping" in source_intersection.stderr
            and not earlier_target.exists()
            and not later_target.exists(),
            "earlier target inside a later source was accepted",
        )

        real_parent = root / "real-parent"
        real_parent.mkdir()
        alias_parent = root / "alias-parent"
        alias_parent.symlink_to(real_parent, target_is_directory=True)
        real_target = real_parent / "same-target"
        alias_target = alias_parent / "same-target"
        aliased_targets = subprocess.run(
            (
                sys.executable,
                "scripts/materialize-fresh-tree",
                str(multi_source_a),
                str(real_target),
                str(multi_source_b),
                str(alias_target),
            ),
            cwd=REPOSITORY,
            env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        require(
            aliased_targets.returncode == 2
            and "target roots must be distinct and non-overlapping" in aliased_targets.stderr
            and not real_target.exists()
            and not alias_target.exists(),
            "symlink-parent alias targets were accepted",
        )

        independent = root / "independent-copies"
        shutil.copytree(target, independent, copy_function=shutil.copy2)
        require(
            manifest_generator.digest_tree(target, cache=False)
            == manifest_generator.digest_tree(independent, cache=False),
            "hardlink materialization changed the logical digest tree",
        )

        existing = subprocess.run(
            (sys.executable, "scripts/materialize-fresh-tree", str(source), str(target)),
            cwd=REPOSITORY,
            env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        require(
            existing.returncode != 0 and "target already exists" in existing.stderr,
            "materializer accepted an existing target",
        )

        unsupported = root / "unsupported"
        os.mkfifo(unsupported)
        unsupported_target = root / "unsupported-target"
        invalid = subprocess.run(
            (
                sys.executable,
                "scripts/materialize-fresh-tree",
                str(unsupported),
                str(unsupported_target),
            ),
            cwd=REPOSITORY,
            env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        require(
            invalid.returncode != 0
            and "unsupported runtime entry" in invalid.stderr
            and not unsupported_target.exists(),
            "materializer accepted an unsupported entry",
        )

        dangling = root / "dangling"
        dangling.symlink_to("missing")
        dangling_target = root / "dangling-target"
        missing = subprocess.run(
            (
                sys.executable,
                "scripts/materialize-fresh-tree",
                str(dangling),
                str(dangling_target),
            ),
            cwd=REPOSITORY,
            env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        require(
            missing.returncode != 0
            and "source did not materialize" in missing.stderr
            and not dangling_target.exists(),
            "materializer accepted a source with no root",
        )

        failure_source = root / "failure-source"
        failure_source.mkdir()
        (failure_source / "a").write_bytes(b"same")
        os.link(failure_source / "a", failure_source / "b")
        real_link = materializer.os.link

        def fail_link(*_arguments: object, **_keywords: object) -> None:
            raise OSError("injected hardlink failure")

        materializer.os.link = fail_link
        try:
            try:
                materializer.copy_entry(failure_source, root / "failure-target", frozenset(), {})
            except OSError as error:
                require(str(error) == "injected hardlink failure", "hardlink failure changed")
            else:
                raise RuntimeError("materializer ignored a hardlink failure")
        finally:
            materializer.os.link = real_link

    dockerfile = (REPOSITORY / "image/fresh/Dockerfile").read_text(encoding="utf-8")
    require(
        dockerfile.count("/usr/local/libexec/align-llm/materialize-fresh-tree") == 4
        and "for tree in git rust bwrap" in dockerfile
        and "/usr/lib/llvm-22 /runtime/cc-suite" in dockerfile
        and '"/usr/lib/$DEB_MULTIARCH" "/runtime/system/usr-lib-$PROFILE_ARCH"' in dockerfile
        and '"/usr/lib/$DEB_MULTIARCH" "/runtime/system/lib-$PROFILE_ARCH"' in dockerfile
        and '"/usr/lib/gcc/$DEB_MULTIARCH" "/runtime/system/gcc-$PROFILE_ARCH"' in dockerfile
        and "/usr/lib/python3.12 /runtime/system/python3.12" in dockerfile
        and "/usr/include /runtime/system/include" in dockerfile
        and "/usr/share/git-core /runtime/system/git-core" in dockerfile,
        "Dockerfile materialization ownership changed",
    )
    require(
        "stat -c '%d:%i' /runtime/git/bin/git" in dockerfile
        and "stat -c '%d:%i' /runtime/git/bin/git-receive-pack" in dockerfile,
        "Dockerfile does not enforce Git hardlink materialization",
    )
    require(
        dockerfile.count("FROM ubuntu:24.04@sha256:561618e2c15bf2397621dd04f96926663a3b5616c189cf7e38db7e82f5c538ea") == 2
        and "AS builder" in dockerfile
        and "AS runtime" in dockerfile,
        "Dockerfile stage ownership changed",
    )
    runtime_stage = dockerfile.split(" AS runtime", maxsplit=1)[1]
    require(
        runtime_stage.count("stat -c '%d:%i' /runtime/cc-suite/lib/libLLVM.so.22.1") == 1
        and runtime_stage.count(
            'stat -c \'%d:%i\' "/runtime/system/usr-lib-$PROFILE_ARCH/libLLVM.so.22.1"'
        )
        == 1
        and runtime_stage.count(
            'stat -c \'%d:%i\' "/runtime/system/lib-$PROFILE_ARCH/libLLVM.so.22.1"'
        )
        == 1,
        "runtime stage does not enforce cross-root LLVM hardlinks after transfer",
    )
    for forbidden in ("apt-get", "apt.llvm.org", "curl ", "wget ", "git clone", "cargo fetch"):
        require(forbidden not in runtime_stage, f"runtime stage retained builder operation: {forbidden}")
    for transfer in (
        "COPY --from=builder /runtime /runtime",
        "COPY --from=builder /opt/align-llm/tool-bin /opt/align-llm/tool-bin",
        "COPY --from=builder /var/cache/align-llm/cargo /var/cache/align-llm/cargo",
        "COPY --from=builder /image-control/usr/bin/ /usr/bin/",
        "COPY --from=builder /image-control/usr/lib/ /usr/lib/",
        "COPY --from=builder /usr/local/share/align-llm /usr/local/share/align-llm",
    ):
        require(transfer in runtime_stage, f"runtime stage transfer is missing: {transfer}")
    require(
        "outer Python control tree contains a symlink" in dockerfile
        and "final outer Python control tree contains a symlink" in runtime_stage
        and "unexpected final control executable inventory" in runtime_stage,
        "outer Python closure is not verified across the stage boundary",
    )
    control = (REPOSITORY / "image/fresh/control/fresh_image_control.py").read_text(
        encoding="utf-8"
    )
    control_self_test = control.split("def _platform_self_test(", maxsplit=1)[1]
    control_supervisor = control.split("def supervise(", maxsplit=1)[1].split(
        "\ndef ", maxsplit=1
    )[0]
    control_bootstrap = control.split("def bootstrap(", maxsplit=1)[1].split(
        "\ndef ", maxsplit=1
    )[0]
    control_runner = control.split("def _run_controlled_child(", maxsplit=1)[1].split(
        "\n@dataclass", maxsplit=1
    )[0]
    control_termination = control.split("def _control_terminate(", maxsplit=1)[1].split(
        "\ndef ", maxsplit=1
    )[0]
    control_owner = (
        REPOSITORY / "scripts/run-fresh-image-control-smoke"
    ).read_text(encoding="utf-8")
    profile_owner = (
        REPOSITORY / "scripts/run-fresh-image-profile-smoke"
    ).read_text(encoding="utf-8")
    worker = (REPOSITORY / "scripts/fresh-align-compiler").read_text(encoding="utf-8")
    worker_owner = (
        REPOSITORY / "scripts/run-fresh-worker-unit-smoke"
    ).read_text(encoding="utf-8")
    worker_entry = worker.split("def worker(", maxsplit=1)[1]
    worker_authentication = worker.split(
        "def authenticate_runtime_and_tools(", maxsplit=1
    )[1].split("\ndef ", maxsplit=1)[0]
    require(
        "RUNTIME_LIBRARY_PATH = (" in control
        and "usr-lib-{NATIVE_ARCHITECTURE}" in control
        and 'NATIVE_ARCHITECTURE not in ("x86_64", "aarch64")' in control_self_test
        and 'manifest["platform"]["architecture"] != NATIVE_ARCHITECTURE' in control_self_test
        and '_require_native_runtime_contract(manifest["runtime_bindings"])' in control_self_test
        and control_self_test.index('for binding in manifest["runtime_bindings"]')
        < control_self_test.index('for tool in manifest["tools"]')
        and '"LD_LIBRARY_PATH": RUNTIME_LIBRARY_PATH' in worker
        and "require_native_runtime_contract(bindings)" in worker
        and worker_authentication.index('for binding in manifest["runtime_bindings"]')
        < worker_authentication.index("tools = authenticate_tools(manifest)")
        and "authenticate_runtime_and_tools(manifest)" in worker_entry
        and control_supervisor.index("_control_set_subreaper()")
        < control_supervisor.index("_platform_self_test(manifest_raw)")
        < control_supervisor.index("_retained_runtime_file(")
        < control_supervisor.index("_git_identity(")
        and "os.set_inheritable(4, True)" in control_supervisor
        and control_bootstrap.index("_control_require_subreaper()")
        < control_bootstrap.index("_run_controlled_child(")
        and 'raise ControlError("CHILD", "aggregate", "worker lifecycle rejected")'
        in control_bootstrap
        and "forced_termination = _control_terminate(" in control_runner
        and 'if forced_termination:' in control_runner
        and "_control_reap_descendants(cleanup_deadline, process)" in control_termination
        and "controller_runtime_bwrap_precedence_case()" in control_owner
        and 'control.supervise(["--mode", "build"], self_fd=10, image_fd=11)'
        in control_owner
        and 'CONTROL_CGROUP_PREFIX = "align-llm-control-"' in control
        and "candidate = CONTROL_CGROUP_PREFIX + os.urandom(16).hex()" in control
        and "controller_cgroup_contract_case()" in control_owner
        and "controller_phase_mapping_cases()" in control_owner
        and "residual child cgroup cleanup was accepted" in profile_owner
        and "profile-residual-" in profile_owner
        and "controlled_child_drain_cases()" in control_owner
        and "controlled_double_fork_forced_case(temporary)" in control_owner
        and "run_owned_double_fork_forced_case(module, temporary)" in worker_owner
        and "module.run_owned(" in worker_owner
        and "subreaper_cases()" in control_owner
        and "final control files overlap base package ownership" in runtime_stage
        and 'Path("/var/lib/dpkg/info").glob("*.list")' in runtime_stage,
        "verified runtime tool probe or package identity verification changed",
    )
    for forbidden_pruning in (
        '/runtime/system/$tree/cryptsetup',
        '/runtime/system/$tree/systemd',
        '/runtime/system/$tree/libsystemd.so',
        '/runtime/system/$tree/libudev.so',
        '/runtime/system/$tree/security/pam_systemd',
    ):
        require(
            forbidden_pruning not in dockerfile,
            f"manifest runtime tree is pruned after materialization: {forbidden_pruning}",
        )
    topology = (REPOSITORY / "docs/specs/check-gate-topology.md").read_text(encoding="utf-8")
    validation_order = topology.split("### 9.9 Validation order and failure categories", maxsplit=1)[
        1
    ].split("### 9.10 Closure matrix", maxsplit=1)[0]
    require(
        validation_order.index("manifest-declared runtime-binding source tree")
        < validation_order.index("retained tool descriptor")
        < validation_order.index("project-root Git descriptors")
        < validation_order.index("cache root"),
        "public runtime/tool/source/cache validation order changed",
    )
    require(
        "`tools` to `TOOL` including runtime-binding identity failures" in validation_order,
        "public runtime-binding failure category changed",
    )
    require(
        "runtime-binding failure therefore wins over a simultaneously invalid bwrap binding"
        in validation_order
        and "`align-llm-control-<32 lowercase random hex>`" in topology
        and "controller lease admission maps to the public phase" in topology
        and "Per-tick descendant procfs-fd enumeration is N/A" in topology
        and "profile cleanup refuses any residual leaf" in topology,
        "public controller/profile ownership contract changed",
    )
    require(
        "foreign member is a platform/cleanup failure and is never killed as owned"
        not in topology
        and "no child-side\nrlimit readback handshake is claimed" in topology,
        "superseded cgroup ownership or worker readback contract remains",
    )
    require(
        "either drained naturally after a\nnormal direct-child exit or were terminated"
        in topology
        and "On every catchable exit the worker terminates owned descendants" not in topology,
        "public natural-drain cleanup contract changed",
    )
    require(
        "COPY --from=builder /runtime/system/" not in runtime_stage,
        "runtime stage overwrites the final base library inventory",
    )
    for path in ("/root/.rustup", "/root/.cargo", "/usr/lib/llvm-22", "/build"):
        require(path in runtime_stage, f"builder-only path is not rejected: {path}")
    require(
        runtime_stage.index("COPY --from=builder /runtime /runtime")
        < runtime_stage.index("ARG IMAGE_PUBLIC_KEY_HEX")
        < runtime_stage.index("ENTRYPOINT"),
        "random verifier key ordering changed",
    )


def test_plan() -> None:
    preflight = load_script("pre-pr", "align_llm_pre_pr_test")
    align = Path("/explicit/align")
    with tempfile.TemporaryDirectory(prefix="align-llm-managed-plan-") as temporary:
        root = Path(temporary) / "cache"
        previous = os.environ.get("ALIGN_TOOLCHAIN_ROOT")
        os.environ["ALIGN_TOOLCHAIN_ROOT"] = str(root)
        try:
            managed = preflight.resolve_align_repository(None, ensure=False)
        finally:
            if previous is None:
                os.environ.pop("ALIGN_TOOLCHAIN_ROOT", None)
            else:
                os.environ["ALIGN_TOOLCHAIN_ROOT"] = previous
        revision = (REPOSITORY / ".align-revision").read_text(encoding="ascii").strip()
        require(
            managed == root / "dev-v1" / revision,
            "preflight plan did not select the managed pinned source",
        )
        require(not root.exists(), "preflight plan materialized the managed source")
    require(
        preflight.resolve_align_repository(str(align), ensure=False) == align,
        "preflight explicit Align source override changed",
    )
    docs = classify(("M", "docs/a.md"))
    doc_plan = preflight.build_plan(
        docs,
        owner_label=None,
        owner_command=(),
        align_repository=align,
        explicit_align_repository=True,
    )
    require([step.label for step in doc_plan] == ["diff-check", "markdown-fences"], "docs plan changed")
    try:
        preflight.build_plan(
            classify(("M", "scripts/run-provider-smoke")),
            owner_label=None,
            owner_command=(),
            align_repository=align,
            explicit_align_repository=True,
        )
    except preflight.PreflightError:
        pass
    else:
        raise RuntimeError("executable plan accepted no owner")
    hosted = preflight.build_plan(
        classify(("M", "scripts/run-provider-smoke")),
        owner_label="provider-owner",
        owner_command=("python3", "scripts/run-provider-smoke"),
        align_repository=align,
        explicit_align_repository=True,
    )
    require(
        [step.label for step in hosted]
        == ["provider-owner", "pinned-align-build", "hosted-checks"],
        "hosted plan order changed",
    )
    fresh = preflight.build_plan(
        classify(("M", "image/fresh/Dockerfile")),
        owner_label="workflow-owner",
        owner_command=("python3", "scripts/test-development-preflight"),
        align_repository=align,
        explicit_align_repository=True,
    )
    require(
        [step.label for step in fresh]
        == [
            "workflow-owner",
            "pinned-align-build",
            "hosted-checks",
            "fresh-focused",
            "fresh-installed",
        ],
        "fresh plan order changed",
    )
    installed = fresh[-1]
    require(installed.unset_environment == ("DOCKER_HOST",), "installed plan retained DOCKER_HOST")
    require(
        installed.arguments[-4:]
        == ("--installed-profile-only", "--require-docker", "--align-repo", str(align)),
        "installed plan does not require the installed-only Docker path and explicit Align source",
    )
    managed = preflight.build_plan(
        classify(("M", "scripts/run-provider-smoke")),
        owner_label="provider-owner",
        owner_command=("python3", "scripts/run-provider-smoke"),
        align_repository=align,
        explicit_align_repository=False,
    )
    require(
        [step.label for step in managed]
        == ["provider-owner", "managed-align-ensure", "pinned-align-build", "hosted-checks"]
        and managed[1].arguments
        == (str(REPOSITORY / "scripts" / "align-toolchain"), "ensure", "source")
        and managed[2].arguments == (str(REPOSITORY / "scripts" / "align-toolchain"), "verify")
        and managed[3].arguments == ("make", "hosted-checks", f"ALIGNC={align / 'target/release/alignc'}"),
        "managed preflight order, admission, or verification changed",
    )
    managed_pin = preflight.build_plan(
        classify(("M", ".align-revision")),
        owner_label="request-owner",
        owner_command=("make", "request-owner"),
        align_repository=align,
        explicit_align_repository=False,
    )
    require(
        [step.label for step in managed_pin]
        == ["request-owner", "managed-align-ensure", "pinned-align-build"],
        "pin-only preflight duplicated the hosted integration graph",
    )
    mixed_hosted = preflight.build_plan(
        classify(("M", ".align-revision"), ("M", "scripts/run-provider-smoke")),
        owner_label="provider-owner",
        owner_command=("python3", "scripts/run-provider-smoke"),
        align_repository=align,
        explicit_align_repository=False,
    )
    require(
        [step.label for step in mixed_hosted]
        == ["provider-owner", "managed-align-ensure", "pinned-align-build", "hosted-checks"],
        "pin plus hosted owner lost the local hosted graph",
    )
    for label, changes in (
        ("pin plus fresh owner", (("M", ".align-revision"), ("M", "Makefile"))),
        ("renamed pin", (("D", ".align-revision"), ("A", "retired-align-revision"))),
    ):
        mixed_fresh = preflight.build_plan(
            classify(*changes),
            owner_label="workflow-owner",
            owner_command=("python3", "scripts/test-development-preflight"),
            align_repository=align,
            explicit_align_repository=False,
        )
        require(
            [step.label for step in mixed_fresh]
            == [
                "workflow-owner",
                "managed-align-ensure",
                "pinned-align-build",
                "hosted-checks",
                "fresh-focused",
                "fresh-installed",
            ],
            f"{label} lost the fail-closed local plan",
        )


def git(repository: Path, *arguments: str) -> str:
    result = subprocess.run(
        ("git", *arguments),
        cwd=repository,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    require(result.returncode == 0, f"git fixture failed: {arguments!r}: {result.stderr}")
    return result.stdout.strip()


def test_ci_reuse() -> None:
    reuse = load_script("select-ci-reuse", "align_llm_ci_reuse_test")
    repository_name = "sanohiro/align-llm"
    with tempfile.TemporaryDirectory(prefix="align-llm-ci-reuse-") as temporary:
        repository = Path(temporary)
        git(repository, "init", "-b", "main")
        git(repository, "config", "user.name", "CI reuse fixture")
        git(repository, "config", "user.email", "ci-reuse@example.invalid")
        (repository / "value").write_text("base\n", encoding="utf-8")
        git(repository, "add", "value")
        git(repository, "commit", "-m", "base")
        before = git(repository, "rev-parse", "HEAD")
        git(repository, "checkout", "-b", "feature")
        (repository / "value").write_text("head\n", encoding="utf-8")
        git(repository, "commit", "-am", "head")
        source_head = git(repository, "rev-parse", "HEAD")
        git(repository, "checkout", "main")
        git(repository, "merge", "--no-ff", "feature", "-m", "merge")
        merge_head = git(repository, "rev-parse", "HEAD")
        event = {
            "ref": "refs/heads/main",
            "before": before,
            "after": merge_head,
            "created": False,
            "deleted": False,
            "forced": False,
        }

        def fixtures() -> tuple[list[object], dict[str, object], dict[str, object]]:
            evidence = reuse.evidence_step_name(71, before, source_head)
            pulls: list[object] = [
                {
                    "number": 71,
                    "state": "closed",
                    "merged_at": "2026-08-12T00:00:00Z",
                    "merge_commit_sha": merge_head,
                    "head": {"sha": source_head},
                    "base": {
                        "sha": before,
                        "ref": "main",
                        "repo": {"full_name": repository_name},
                    },
                }
            ]
            runs: dict[str, object] = {
                "total_count": 1,
                "workflow_runs": [
                    {
                        "id": 9001,
                        "run_number": 40,
                        "run_attempt": 1,
                        "event": "pull_request",
                        "head_sha": source_head,
                        "path": ".github/workflows/ci.yml",
                        "repository": {"full_name": repository_name},
                        "status": "completed",
                        "conclusion": "success",
                    }
                ],
            }
            jobs: dict[str, object] = {
                "total_count": len(reuse.REQUIRED_JOBS),
                "jobs": [
                    {
                        "name": name,
                        "head_sha": source_head,
                        "run_id": 9001,
                        "status": "completed",
                        "conclusion": "success",
                        "steps": [
                            {
                                "name": evidence,
                                "status": "completed",
                                "conclusion": "success",
                            }
                        ],
                    }
                    for name in reuse.REQUIRED_JOBS
                ],
            }
            return pulls, runs, jobs

        def decide_with(
            mutate: object | None = None,
            *,
            api_error: str = "",
        ) -> object:
            pulls, runs, jobs = fixtures()
            if callable(mutate):
                mutate(pulls, runs, jobs)

            def api(path: str) -> object:
                if api_error:
                    raise reuse.ReuseError(api_error)
                if path.startswith(f"/repos/{repository_name}/commits/{source_head}/pulls?"):
                    return pulls
                if "/actions/workflows/ci.yml/runs?" in path:
                    return runs
                if path == f"/repos/{repository_name}/actions/runs/9001/jobs?per_page=100":
                    return jobs
                raise RuntimeError(f"unexpected API path: {path}")

            return reuse.decide(
                event_name="push",
                event=event,
                repository=repository_name,
                api_get=api,
                git_repository=repository,
            )

        selected = decide_with()
        require(
            selected.reused
            and selected.reason == "exact-merged-pr-checks"
            and selected.source_head == source_head
            and selected.pull_request == 71
            and selected.workflow_run == 9001,
            "exact merged PR evidence was not reused",
        )

        for name, changed_event, reason in (
            ("wrong-before", {**event, "before": "0" * 40}, "event-before-mismatch"),
            ("forced", {**event, "forced": True}, "push-not-normal-main-update"),
            ("created", {**event, "created": True}, "push-not-normal-main-update"),
            ("deleted", {**event, "deleted": True}, "push-not-normal-main-update"),
            (
                "wrong-ref",
                {**event, "ref": "refs/heads/release"},
                "push-not-normal-main-update",
            ),
        ):
            rejected = reuse.decide(
                event_name="push",
                event=changed_event,
                repository=repository_name,
                api_get=lambda path: None,
                git_repository=repository,
            )
            require(
                not rejected.reused and rejected.reason == reason,
                f"{name} push did not fail closed: {rejected}",
            )

        def duplicate_pull(pulls: list[object], runs: dict[str, object], jobs: dict[str, object]) -> None:
            pulls.append(json.loads(json.dumps(pulls[0])))

        def duplicate_run(pulls: list[object], runs: dict[str, object], jobs: dict[str, object]) -> None:
            records = runs["workflow_runs"]
            require(isinstance(records, list), "workflow fixture changed")
            records.append(json.loads(json.dumps(records[0])))
            runs["total_count"] = 2

        rejection_cases = (
            (
                "wrong-pr-base",
                lambda pulls, runs, jobs: pulls[0]["base"].__setitem__("sha", "9" * 40),
                "exact-merged-pull-request-not-found",
            ),
            (
                "wrong-pr-ref",
                lambda pulls, runs, jobs: pulls[0]["base"].__setitem__("ref", "release"),
                "exact-merged-pull-request-not-found",
            ),
            (
                "wrong-pr-repository",
                lambda pulls, runs, jobs: pulls[0]["base"]["repo"].__setitem__(
                    "full_name", "elsewhere/align-llm"
                ),
                "exact-merged-pull-request-not-found",
            ),
            ("ambiguous-pulls", duplicate_pull, "exact-merged-pull-request-not-found"),
            (
                "pulls-paginated",
                lambda pulls, runs, jobs: pulls.extend(
                    json.loads(json.dumps(pulls[0])) for _ in range(99)
                ),
                "github-api-pulls-paginated",
            ),
            (
                "failed-run",
                lambda pulls, runs, jobs: runs["workflow_runs"][0].__setitem__(
                    "conclusion", "failure"
                ),
                "latest-pull-request-workflow-not-successful",
            ),
            ("ambiguous-runs", duplicate_run, "latest-workflow-run-not-unique"),
            (
                "runs-paginated",
                lambda pulls, runs, jobs: runs.__setitem__("total_count", 2),
                "github-api-workflow-runs-paginated",
            ),
            (
                "missing-job",
                lambda pulls, runs, jobs: (
                    jobs["jobs"].pop(),
                    jobs.__setitem__("total_count", len(reuse.REQUIRED_JOBS) - 1),
                ),
                "required-job-not-unique",
            ),
            (
                "failed-job",
                lambda pulls, runs, jobs: jobs["jobs"][0].__setitem__(
                    "conclusion", "failure"
                ),
                "required-job-not-successful",
            ),
            (
                "wrong-pr-evidence",
                lambda pulls, runs, jobs: jobs["jobs"][0]["steps"][0].__setitem__(
                    "name", reuse.evidence_step_name(999, before, source_head)
                ),
                "pull-request-evidence-not-unique",
            ),
            (
                "wrong-base-evidence",
                lambda pulls, runs, jobs: jobs["jobs"][0]["steps"][0].__setitem__(
                    "name", reuse.evidence_step_name(71, "9" * 40, source_head)
                ),
                "pull-request-evidence-not-unique",
            ),
            (
                "failed-evidence",
                lambda pulls, runs, jobs: jobs["jobs"][0]["steps"][0].__setitem__(
                    "conclusion", "failure"
                ),
                "pull-request-evidence-not-successful",
            ),
            (
                "jobs-paginated",
                lambda pulls, runs, jobs: jobs.__setitem__(
                    "total_count", len(reuse.REQUIRED_JOBS) + 1
                ),
                "github-api-jobs-paginated",
            ),
            (
                "malformed-runs",
                lambda pulls, runs, jobs: runs.__setitem__("workflow_runs", None),
                "github-api-invalid-workflow-runs",
            ),
        )
        for name, mutate, reason in rejection_cases:
            rejected = decide_with(mutate)
            require(
                not rejected.reused and rejected.reason == reason,
                f"{name} did not fail closed: {rejected}",
            )

        unavailable = decide_with(api_error="github-api-unavailable")
        require(
            not unavailable.reused and unavailable.reason == "github-api-unavailable",
            "API failure did not fall back to normal checks",
        )

        (repository / "merge-only").write_text("changed merge tree\n", encoding="utf-8")
        git(repository, "add", "merge-only")
        git(repository, "commit", "--amend", "--no-edit")
        changed_merge = git(repository, "rev-parse", "HEAD")
        changed_tree = reuse.decide(
            event_name="push",
            event={**event, "after": changed_merge},
            repository=repository_name,
            api_get=lambda path: None,
            git_repository=repository,
        )
        require(
            not changed_tree.reused and changed_tree.reason == "merge-tree-changed",
            "merge-owned tree change reused PR evidence",
        )

        git(repository, "checkout", "feature")
        direct_push = reuse.decide(
            event_name="push",
            event={**event, "after": source_head},
            repository=repository_name,
            api_get=lambda path: None,
            git_repository=repository,
        )
        require(
            not direct_push.reused and direct_push.reason == "not-two-parent-merge",
            "direct push reused PR evidence",
        )

    class ApiResponse:
        def __init__(self, payload: bytes = b"{}", error: Exception | None = None):
            self.payload = payload
            self.error = error

        def __enter__(self) -> object:
            return self

        def __exit__(self, *arguments: object) -> None:
            return None

        def read(self, limit: int) -> bytes:
            if self.error is not None:
                raise self.error
            return self.payload

    original_urlopen = reuse.urllib.request.urlopen
    try:
        api_failure_cases = (
            (
                "incomplete-response",
                ApiResponse(error=reuse.http.client.IncompleteRead(b"{}", 8)),
                "github-api-unavailable",
            ),
            ("malformed-json", ApiResponse(payload=b"{"), "github-api-invalid-json"),
            (
                "oversized-response",
                ApiResponse(payload=b"x" * (reuse.MAX_API_BYTES + 1)),
                "github-api-response-too-large",
            ),
        )
        for name, response, reason in api_failure_cases:
            reuse.urllib.request.urlopen = lambda request, timeout, response=response: response
            try:
                reuse.GitHubApi("https://api.github.com", "test-token")("/rate_limit")
            except reuse.ReuseError as error:
                require(str(error) == reason, f"{name} reported {error}")
            else:
                raise RuntimeError(f"{name} escaped the API fail-closed boundary")
    finally:
        reuse.urllib.request.urlopen = original_urlopen

    try:
        reuse.api_base_url("https://[invalid")
    except reuse.ReuseError as error:
        require(str(error) == "invalid-api-url", "invalid API URL escaped validation")
    else:
        raise RuntimeError("invalid API URL was accepted")

    original_run = reuse.subprocess.run
    try:
        def unavailable_git(*arguments: object, **keywords: object) -> object:
            raise OSError("git unavailable")

        reuse.subprocess.run = unavailable_git
        try:
            reuse.git_output(REPOSITORY, "rev-parse", "HEAD")
        except reuse.ReuseError as error:
            require(str(error) == "git-identity-unavailable", "Git launch failure escaped fallback")
        else:
            raise RuntimeError("Git launch failure was accepted")
    finally:
        reuse.subprocess.run = original_run

    with tempfile.TemporaryDirectory(prefix="align-llm-ci-reuse-io-") as temporary:
        root = Path(temporary)
        malformed = root / "malformed.json"
        malformed.write_bytes(b"{")
        oversized = root / "oversized.json"
        oversized.write_bytes(b"x" * (reuse.MAX_API_BYTES + 1))
        for path, reason in (
            (malformed, "event-unavailable"),
            (oversized, "event-too-large"),
        ):
            try:
                reuse.read_event(path)
            except reuse.ReuseError as error:
                require(str(error) == reason, f"event input reported {error}")
            else:
                raise RuntimeError(f"event input did not fail closed: {path.name}")

        valid = root / "valid.json"
        valid.write_text("{}\n", encoding="utf-8")
        stdout = io.StringIO()
        stderr = io.StringIO()
        with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
            status = reuse.main(
                (
                    "--event-name",
                    "pull_request",
                    "--event-path",
                    str(valid),
                    "--repository",
                    repository_name,
                    "--api-url",
                    "https://api.github.com",
                    "--github-output",
                    str(root),
                )
            )
        require(status == 1 and "CI reuse output failed" in stderr.getvalue(), "output failure passed")

    non_push = reuse.decide(
        event_name="pull_request",
        event={},
        repository=repository_name,
        api_get=lambda path: None,
    )
    require(not non_push.reused and non_push.reason == "event-not-push", "PR event queried reuse")


def test_qualification_modes() -> None:
    qualification = load_script(
        "run-fresh-worker-qualification", "align_llm_fresh_qualification_test"
    )
    require(
        qualification.qualification_path("run-fresh-attestation-wire-smoke")
        == "/usr/bin:/bin",
        "focused qualification inherited a platform tool path",
    )
    prior_path = os.environ.get("PATH")
    try:
        with tempfile.TemporaryDirectory(prefix="qualification-path-") as temporary_name:
            temporary = Path(temporary_name)
            selected = temporary / "selected"
            canonical = temporary / "Docker.app" / "Contents" / "Resources" / "bin"
            selected.mkdir()
            canonical.mkdir(parents=True)
            docker = canonical / "docker"
            docker.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
            docker.chmod(0o755)
            (selected / "docker").symlink_to(docker)
            os.environ["PATH"] = str(selected)
            require(
                qualification.qualification_path(qualification.INSTALLED_OWNER)
                == f"/usr/bin:/bin:{canonical.resolve()}",
                "installed qualification did not canonicalize the Docker CLI path",
            )

            docker.chmod(0o644)
            require(
                qualification.qualification_path(qualification.INSTALLED_OWNER)
                == "/usr/bin:/bin",
                "installed qualification accepted a non-executable Docker CLI",
            )
            (selected / "docker").unlink()
            (selected / "docker").mkdir()
            require(
                qualification.qualification_path(qualification.INSTALLED_OWNER)
                == "/usr/bin:/bin",
                "installed qualification accepted a Docker directory",
            )
            os.environ["PATH"] = str(temporary / "missing")
            require(
                qualification.qualification_path(qualification.INSTALLED_OWNER)
                == "/usr/bin:/bin",
                "installed qualification changed the path without Docker",
            )
    finally:
        if prior_path is None:
            os.environ.pop("PATH", None)
        else:
            os.environ["PATH"] = prior_path
    qualification.verify_contract_inventory = lambda: None
    calls: list[tuple[str, tuple[str, ...]]] = []
    qualification.run = lambda owner, *arguments: calls.append((owner, arguments))

    def invoke(*arguments: str) -> list[tuple[str, tuple[str, ...]]]:
        calls.clear()
        prior = sys.argv
        sys.argv = ["run-fresh-worker-qualification", *arguments]
        try:
            with contextlib.redirect_stdout(io.StringIO()):
                require(qualification.main() == 0, "qualification mode failed")
        finally:
            sys.argv = prior
        return list(calls)

    focused = invoke()
    require(len(focused) == len(qualification.FOCUSED_CHECKS), "focused owner count changed")
    require(
        all(owner != "run-fresh-image-profile-smoke" for owner, _ in focused),
        "focused mode ran the installed profile",
    )
    installed = invoke(
        "--installed-profile-only", "--require-docker", "--align-repo", "/full/align"
    )
    require(
        installed
        == [
            (
                "run-fresh-image-profile-smoke",
                (
                    sys.executable,
                    "scripts/run-fresh-image-profile-smoke",
                    "--require-docker",
                    "--align-repo",
                    "/full/align",
                ),
            )
        ],
        "installed-only mode repeated focused owners",
    )
    prepared = invoke(
        "--installed-profile-only",
        "--require-docker",
        "--prepared-image",
        "align-llm-fresh-test:" + "a" * 32,
        "--image-signing-seed",
        "/private/image-seed",
        "--run-signing-seed",
        "/private/run-seed",
    )
    require(
        prepared
        == [
            (
                "run-fresh-image-profile-smoke",
                (
                    sys.executable,
                    "scripts/run-fresh-image-profile-smoke",
                    "--require-docker",
                    "--prepared-image",
                    "align-llm-fresh-test:" + "a" * 32,
                    "--image-signing-seed",
                    "/private/image-seed",
                    "--run-signing-seed",
                    "/private/run-seed",
                ),
            )
        ],
        "installed-only mode did not forward the prepared image identity",
    )
    complete = invoke("--installed-profile", "--require-docker")
    require(
        len(complete) == len(qualification.FOCUSED_CHECKS) + 1
        and complete[-1][0] == "run-fresh-image-profile-smoke",
        "complete mode does not run each owner once",
    )

    image_profile = load_script(
        "run-fresh-image-profile-smoke", "align_llm_fresh_image_profile_test"
    )
    image_profile.run = lambda *arguments, **keywords: SimpleNamespace(returncode=1)

    def unavailable(*arguments: str) -> int:
        prior = sys.argv
        sys.argv = ["run-fresh-image-profile-smoke", *arguments]
        try:
            with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
                return image_profile.main()
        finally:
            sys.argv = prior

    require(unavailable() == 77, "optional Docker unavailability no longer reports skip")
    require(unavailable("--require-docker") == 1, "required Docker unavailability did not fail")
    prior = sys.argv
    sys.argv = [
        "run-fresh-image-profile-smoke",
        "--prepared-image",
        "align-llm-fresh-test:" + "a" * 32,
    ]
    try:
        with contextlib.redirect_stderr(io.StringIO()):
            try:
                image_profile.main()
            except SystemExit as error:
                require(error.code == 2, "partial prepared-image input did not report usage failure")
            else:
                raise RuntimeError("partial prepared-image input was accepted")
    finally:
        sys.argv = prior


def test_image_build_material() -> None:
    material = load_script(
        "prepare-fresh-image-build", "align_llm_fresh_image_material_test"
    )
    image_profile = load_script(
        "run-fresh-image-profile-smoke", "align_llm_fresh_image_seed_test"
    )
    with tempfile.TemporaryDirectory(prefix="align-llm-image-material-") as temporary:
        root = Path(temporary)
        directory = root / "material"
        output = root / "github-output"
        output.write_text("prior=value\n", encoding="ascii")
        material.prepare(directory, output)
        require(stat.S_IMODE(directory.lstat().st_mode) == 0o700, "material directory is not private")
        image_seed = directory / material.IMAGE_SEED
        run_seed = directory / material.RUN_SEED
        require(
            stat.S_IMODE(image_seed.lstat().st_mode) == 0o400
            and stat.S_IMODE(run_seed.lstat().st_mode) == 0o400,
            "prepared signing seeds are not private",
        )
        image_raw = image_profile.prepared_seed(image_seed, "image signing seed")
        run_raw = image_profile.prepared_seed(run_seed, "run signing seed")
        require(len(image_raw) == 32 and len(run_raw) == 32 and image_raw != run_raw, "seed generation changed")
        outputs = output.read_text(encoding="ascii")
        output_rows = dict(
            line.split("=", 1) for line in outputs.splitlines() if not line.startswith("prior=")
        )
        require(
            outputs.startswith("prior=value\n")
            and list(output_rows)
            == ["image", "image_public_key_hex", "run_public_key_hex", "material_directory"]
            and material.IMAGE_PATTERN.fullmatch(output_rows["image"]) is not None
            and output_rows["image_public_key_hex"]
            == material.ed25519_public_key(image_raw).hex()
            and output_rows["run_public_key_hex"]
            == material.ed25519_public_key(run_raw).hex()
            and output_rows["material_directory"] == str(directory),
            "public build outputs are incomplete",
        )
        require(
            image_raw.hex() not in outputs and run_raw.hex() not in outputs,
            "private seed escaped into GitHub output",
        )
        original_files = {
            name: (directory / name).read_bytes() for name in material.OWNED_FILES
        }
        try:
            material.prepare(directory, output)
        except material.MaterialError:
            pass
        else:
            raise RuntimeError("a second preparation reused live signing material")
        require(
            all((directory / name).read_bytes() == value for name, value in original_files.items()),
            "failed second preparation changed live signing material",
        )
        unknown = directory / "unknown"
        unknown.write_text("do not delete\n", encoding="ascii")
        try:
            material.cleanup(directory)
        except material.MaterialError:
            pass
        else:
            raise RuntimeError("cleanup accepted an unknown entry")
        require(unknown.exists() and image_seed.exists(), "rejected cleanup mutated material")
        unknown.unlink()

        marker_path = directory / material.MARKER
        marker_raw = marker_path.read_bytes()
        marker_value = json.loads(marker_raw)
        marker_value["directory"] = str(root / "wrong-directory")
        marker_path.chmod(0o600)
        marker_path.write_text(
            json.dumps(marker_value, sort_keys=True, separators=(",", ":")) + "\n",
            encoding="ascii",
        )
        marker_path.chmod(0o400)
        try:
            material.cleanup(directory)
        except material.MaterialError:
            pass
        else:
            raise RuntimeError("cleanup accepted a marker for another directory")
        require(image_seed.exists() and run_seed.exists(), "marker rejection removed signing material")
        marker_path.chmod(0o600)
        marker_path.write_bytes(marker_raw)
        marker_path.chmod(0o400)
        for invalid_version in (True, 1.0):
            marker_value = json.loads(marker_raw)
            marker_value["version"] = invalid_version
            marker_path.chmod(0o600)
            marker_path.write_text(
                json.dumps(marker_value, sort_keys=True, separators=(",", ":")) + "\n",
                encoding="ascii",
            )
            marker_path.chmod(0o400)
            try:
                material.cleanup(directory)
            except material.MaterialError:
                pass
            else:
                raise RuntimeError(f"cleanup accepted marker version {invalid_version!r}")
            require(
                image_seed.exists() and run_seed.exists(),
                "schema-version rejection removed signing material",
            )
        marker_path.chmod(0o600)
        marker_path.write_bytes(marker_raw)
        marker_path.chmod(0o400)
        material.cleanup(directory)
        require(not directory.exists(), "material cleanup retained its directory")

        unicode_directory = root / "mät"
        unicode_output = root / "unicode-output"
        unicode_output.write_text("unchanged=value\n", encoding="ascii")
        try:
            material.prepare(unicode_directory, unicode_output)
        except material.MaterialError:
            pass
        else:
            raise RuntimeError("non-ASCII material path was accepted")
        require(
            not unicode_directory.exists()
            and unicode_output.read_text(encoding="ascii") == "unchanged=value\n",
            "encoding rejection created material or partial GitHub output",
        )

        unicode_cli = subprocess.run(
            (
                sys.executable,
                "scripts/prepare-fresh-image-build",
                "--directory",
                str(unicode_directory),
                "--github-output",
                str(unicode_output),
            ),
            cwd=REPOSITORY,
            env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        require(
            unicode_cli.returncode == 1
            and not unicode_cli.stdout
            and b"Traceback" not in unicode_cli.stderr
            and unicode_output.read_text(encoding="ascii") == "unchanged=value\n",
            "public CLI leaked partial output or a traceback on encoding rejection",
        )

        cli_directory = root / "cli-material"
        cli_output = root / "cli-output"
        cli_output.touch()
        environment = dict(os.environ)
        environment["PYTHONDONTWRITEBYTECODE"] = "1"
        prepared = subprocess.run(
            (
                sys.executable,
                "scripts/prepare-fresh-image-build",
                "--directory",
                str(cli_directory),
                "--github-output",
                str(cli_output),
            ),
            cwd=REPOSITORY,
            env=environment,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        require(
            prepared.returncode == 0 and not prepared.stdout and not prepared.stderr,
            "public material preparation CLI failed",
        )
        cleaned = subprocess.run(
            (
                sys.executable,
                "scripts/prepare-fresh-image-build",
                "--cleanup",
                "--directory",
                str(cli_directory),
            ),
            cwd=REPOSITORY,
            env=environment,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        require(
            cleaned.returncode == 0
            and not cleaned.stdout
            and not cleaned.stderr
            and not cli_directory.exists(),
            "public material cleanup CLI failed",
        )

        failed_directory = root / "failed-material"
        unavailable_output = root / "output-directory"
        unavailable_output.mkdir()
        try:
            material.prepare(failed_directory, unavailable_output)
        except material.MaterialError:
            pass
        else:
            raise RuntimeError("unavailable GitHub output was accepted")
        require(not failed_directory.exists(), "failed preparation retained private material")

        wrong_mode = root / "wrong-mode-seed"
        wrong_mode.write_bytes(os.urandom(32))
        wrong_mode.chmod(0o600)
        try:
            image_profile.prepared_seed(wrong_mode, "image signing seed")
        except RuntimeError:
            pass
        else:
            raise RuntimeError("prepared image accepted a noncanonical seed mode")


def test_image_profile_plan() -> None:
    image_profile = load_script(
        "run-fresh-image-profile-smoke", "align_llm_fresh_image_profile_plan_test"
    )
    revision = (REPOSITORY / ".align-revision").read_text(encoding="ascii").strip()
    calls: list[tuple[list[str], dict[str, object]]] = []

    def capture(arguments: list[str], **keywords: object) -> SimpleNamespace:
        calls.append((arguments, keywords))
        if "config" in arguments:
            return SimpleNamespace(returncode=1, stdout=b"", stderr=b"")
        if arguments[-2:] == ["rev-parse", "HEAD"]:
            stdout = (revision + "\n").encode("ascii")
        elif arguments[-2:] == ["rev-parse", "--is-shallow-repository"]:
            stdout = b"false\n"
        else:
            stdout = b""
        return SimpleNamespace(returncode=0, stdout=stdout, stderr=b"")

    image_profile.run = capture
    image_profile.checkout_pinned_align(Path("/isolated/align"), Path("/full/align"))
    require(
        any(
            arguments
            == ["git", "clone", "--no-hardlinks", "/full/align", "/isolated/align"]
            for arguments, _ in calls
        ),
        "installed profile does not isolate the provided full Align source",
    )
    require(
        any(arguments[-3:] == ["checkout", "--detach", revision] for arguments, _ in calls),
        "Align checkout does not consume the pinned revision",
    )
    require(
        any("fsck" in arguments and "--connectivity-only" in arguments for arguments, _ in calls),
        "provided Align source connectivity is not checked",
    )

    calls.clear()
    image_profile.boundary_profile_run(
        "image",
        "profile-volume",
        "runtime-volume",
        "source-volume",
        "cgroupfs",
        extra_environment=("BOUNDARY_EXTRA=1",),
    )
    boundary = calls[-1][0]
    require("--env" not in boundary, "cgroupfs boundary retained Docker-provided environment")
    require(
        boundary[boundary.index("--entrypoint") + 1] == "/usr/bin/env"
        and boundary[-6:]
        == [
            "-i",
            "ALIGN_REPO=/work/align",
            "BOUNDARY_EXTRA=1",
            "/usr/local/libexec/align-llm/fresh-supervise",
            "--mode",
            "ordinary-adoption-boundary",
        ],
        "cgroupfs boundary does not reconstruct the exact environment",
    )

    dockerfile = (REPOSITORY / "image/fresh/Dockerfile").read_text(encoding="utf-8")
    require(
        "--depth=1 --filter=blob:none origin \"$ALIGN_REVISION\"" in dockerfile,
        "image cache fetch is not exact and shallow",
    )
    require(
        "git clone --filter=blob:none https://github.com/sanohiro/align.git /tmp/align-cache-source"
        not in dockerfile,
        "image cache retained the full-history Align clone",
    )
    revision_copy = "COPY .align-revision /build/align-llm/.align-revision"
    cargo_fetch = "/runtime/rust/bin/cargo fetch --locked"
    control_inputs = (
        "COPY scripts/build-fresh-image-control scripts/fresh_attestation.py scripts/fresh_manifest.py",
        "COPY image/fresh /build/align-llm/image/fresh",
    )
    require(
        dockerfile.count(revision_copy) == 1
        and dockerfile.count(cargo_fetch) == 1
        and dockerfile.index("for tree in git rust bwrap") < dockerfile.index(revision_copy)
        and dockerfile.index("/usr/lib/llvm-22 /runtime/cc-suite")
        < dockerfile.index(revision_copy)
        and dockerfile.index(revision_copy) < dockerfile.index(cargo_fetch)
        and all(dockerfile.index(cargo_fetch) < dockerfile.index(source) for source in control_inputs),
        "pin-owned Cargo fetch does not precede repository-owned image inputs",
    )
    require(
        dockerfile.count("ARG IMAGE_PUBLIC_KEY_HEX") == 2
        and dockerfile.count("ARG RUN_PUBLIC_KEY_HEX") == 2
        and dockerfile.index("ARG IMAGE_PUBLIC_KEY_HEX") > dockerfile.index(cargo_fetch)
        and dockerfile.index('image = os.environ.get("IMAGE_PUBLIC_KEY_HEX", "")')
        > dockerfile.index(cargo_fetch)
        and dockerfile.rindex("ARG IMAGE_PUBLIC_KEY_HEX")
        > dockerfile.index("AS runtime"),
        "random verifier keys invalidate heavy image layers",
    )


