#!/usr/bin/env python3
"""Independent real-model trial; no automatic performance adoption decision."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import select
import statistics
import subprocess
import tempfile
import time
from gpu_session_client import Session

SYSTEM = 'You are a coding assistant. Return a concise patch-oriented answer.'

def digest(path):
    with open(path, 'rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()

def bundle_patch_digest(bundle, flag_name, file_name):
    bundle = Path(bundle)
    manifest = json.loads((bundle/'manifest.json').read_text())
    prefix = '-D' + flag_name + '='
    values = [flag[len(prefix):] for flag in manifest['build_flags'] if flag.startswith(prefix)]
    if not values:
        return None
    if len(values) != 1 or not re.fullmatch('[0-9a-f]{64}', values[0]):
        raise ValueError('invalid bundle patch digest flag')
    retained = bundle.parent/file_name
    if not retained.is_file() or digest(retained) != values[0]:
        raise ValueError('retained bundle patch does not match build flag')
    return values[0]

def read_log_span(fd, start, end):
    if end < start:
        raise ValueError('diagnostic log shrank during a request')
    parts = []
    while start < end:
        part = os.pread(fd, end - start, start)
        if not part:
            raise ValueError('diagnostic log span could not be read')
        parts.append(part)
        start += len(part)
    return b''.join(parts)

def last_request_native_waits(request_waits, prefill_graphs, steps, state_copy, prefill_copy):
    per_request = (steps - 1 if state_copy else 0) + (prefill_graphs if prefill_copy else 0)
    if len(request_waits) != 3:
        raise ValueError('three request-local native wait groups are required')
    for ordinal, waits in enumerate(request_waits):
        if len(waits) != per_request:
            raise ValueError(f'request {ordinal} native wait count mismatch: {len(waits)} != {per_request}')
        prefill_waits = prefill_graphs if prefill_copy else 0
        if any(kind != 0 for kind, _ in waits[:prefill_waits]) \
                or any(kind == 0 for kind, _ in waits[prefill_waits:]):
            raise ValueError(f'request {ordinal} native wait kinds differ from selected execution')
    return request_waits[-1]

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--config', type=Path, required=True,
                        help='JSON: model, pack, geometry, control/candidate {binary,options,lib}, llama, trace')
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--wall-only', action='store_true', help='omit Align phase interposer; report phase clocks as unavailable')
    parser.add_argument('--pairs', type=int, default=5)
    parser.add_argument('--native-ab', action='store_true', help='same candidate binary/bundle with fusion disabled versus enabled; no reference rerun')
    parser.add_argument('--native-control', action='store_true', help='enable native fusion on the explicitly supplied prior control build; retain reference arm')
    parser.add_argument('--native-disabled', action='store_true', help='disable fusion on both explicit builds to measure host/runtime changes against the pinned reference')
    args = parser.parse_args()
    if sum((args.native_ab, args.native_control, args.native_disabled)) > 1:
        parser.error('--native-ab, --native-control and --native-disabled are mutually exclusive')
    if args.pairs < 5 or args.output.exists():
        parser.error('at least five pairs and a new output path are required')
    cfg = json.loads(args.config.read_text())
    if args.native_ab:
        cfg['control']=dict(cfg['candidate'])
        cfg['control_commit']=None
    arms=('control','candidate') if args.native_ab else ('control','candidate','llama')
    env = {k:v for k,v in os.environ.items() if not k.startswith(('DYLD_', 'GGML_', 'ALIGN_LLM_NATIVE_', 'ALIGN_FFN_', 'ALIGN_LLM_SYNC_WEIGHT_UPLOAD', 'ALIGN_LLM_PREFILL_', 'ALIGN_LLM_MAPPED_WEIGHTS', 'ALIGN_LLM_SHARED_LOGITS', 'ALIGN_LLM_NEON_GREEDY', 'ALIGN_LLM_GRAPH_GREEDY'))}
    execution = {}
    for arm in ('control', 'candidate'):
        selected = cfg[arm].get('execution', {})
        if set(selected) - {'sync_weight_upload', 'prefill_chunk', 'final_prefill_logits', 'final_ffn_row', 'mapped_weights', 'shared_logits', 'neon_greedy', 'graph_greedy', 'private_buffers', 'native_state_copy', 'native_conv_copy', 'native_prefill_state_copy', 'native_copy_greedy'}:
            raise ValueError('unknown execution setting')
        sync = selected.get('sync_weight_upload', '0')
        chunk = selected.get('prefill_chunk', '128')
        final_logits = selected.get('final_prefill_logits', '0')
        last_row = selected.get('final_ffn_row', '0')
        mapped = selected.get('mapped_weights', '0')
        shared = selected.get('shared_logits', '0')
        neon = selected.get('neon_greedy', '0')
        graph = selected.get('graph_greedy', '0')
        private = selected.get('private_buffers', '0')
        state_copy = selected.get('native_state_copy', '0')
        conv_copy = selected.get('native_conv_copy', '0')
        prefill_copy = selected.get('native_prefill_state_copy', '0')
        copy_greedy = selected.get('native_copy_greedy', '0')
        if sync not in ('0', '1') or chunk not in ('128', '256', '512') or final_logits not in ('0', '1') or last_row not in ('0', '1') or mapped not in ('0', '1') or shared not in ('0', '1') or neon not in ('0', '1') or graph not in ('0', '1') or private not in ('0', '1') or state_copy not in ('0', '1') or conv_copy not in ('0', '1') or prefill_copy not in ('0', '1') or copy_greedy not in ('0', '1') or (conv_copy == '1' and state_copy != '1') or (prefill_copy == '1' and (state_copy != '1' or conv_copy != '1')) or (copy_greedy == '1' and (state_copy != '1' or conv_copy != '1' or shared == '1' or neon == '1' or graph == '1')) or sum((shared == '1', neon == '1', graph == '1')) > 1 or (mapped == '1' and sync == '1') or (private == '1' and (mapped == '1' or shared == '1' or neon == '1' or graph == '1' or state_copy == '1')):
            raise ValueError('invalid execution setting')
        execution[arm] = dict(sync_weight_upload=sync, prefill_chunk=chunk, final_prefill_logits=final_logits, final_ffn_row=last_row, mapped_weights=mapped, shared_logits=shared, neon_greedy=neon, graph_greedy=graph, private_buffers=private, native_state_copy=state_copy, native_conv_copy=conv_copy, native_prefill_state_copy=prefill_copy, native_copy_greedy=copy_greedy)
    graph_trial = any(execution[arm]['graph_greedy'] == '1' for arm in ('control', 'candidate'))
    greedy_trial = execution['candidate']['native_copy_greedy'] == '1'
    state_copy_trial = not greedy_trial and any(execution[arm]['native_state_copy'] == '1' for arm in ('control', 'candidate'))
    conv_copy_trial = not greedy_trial and execution['candidate']['native_conv_copy'] == '1'
    prefill_copy_trial = execution['candidate']['native_prefill_state_copy'] == '1'
    if greedy_trial and (execution['control']['native_copy_greedy'] != '0'
                         or execution['control']['native_state_copy'] != execution['control']['native_conv_copy']
                         or execution['candidate']['native_state_copy'] != '1'
                         or execution['candidate']['native_conv_copy'] != '1'
                         or any(execution[arm]['native_prefill_state_copy'] != '0'
                                for arm in ('control', 'candidate'))):
        raise ValueError('native-copy greedy trial requires ordinary or mixed control and mixed candidate')
    if prefill_copy_trial and execution['control']['native_prefill_state_copy'] != '0':
        raise ValueError('prefill-copy trial requires control off and candidate on')
    if prefill_copy_trial and execution['control']['native_state_copy'] != execution['control']['native_conv_copy']:
        raise ValueError('prefill-copy control must select ordinary or mixed decode copy')
    if conv_copy_trial and not prefill_copy_trial and execution['control']['native_conv_copy'] != '0':
        raise ValueError('convolution-copy trial requires control off and candidate on')
    if conv_copy_trial or greedy_trial:
        for arm in ('control', 'candidate'):
            shim = cfg[arm].get('shim')
            if not shim or shim not in subprocess.check_output(
                    ['otool', '-L', cfg[arm]['binary']], text=True):
                raise ValueError(f'{arm} native shim is not bound to the measured binary')
    if state_copy_trial and not conv_copy_trial and not prefill_copy_trial and (execution['control']['native_state_copy'] != '0'
                             or execution['candidate']['native_state_copy'] != '1'):
        raise ValueError('state-copy trial requires control off and candidate on')
    native_patches = {arm:bundle_patch_digest(cfg[arm]['lib'],
                         'ALIGN_LLM_NATIVE_SWIGLU_PATCH_SHA256',
                         'native-metal-swiglu.patch')
                      for arm in ('control', 'candidate')}
    argmax_patches = {arm:bundle_patch_digest(cfg[arm]['lib'],
                        'ALIGN_LLM_INGRAPH_ARGMAX_PATCH_SHA256',
                        'metal-ingraph-argmax.patch')
                      for arm in ('control', 'candidate')}
    if any(execution[arm]['graph_greedy'] == '1' and argmax_patches[arm] is None
           for arm in ('control', 'candidate')):
        raise ValueError('graph greedy requires a verified argmax bundle patch')
    report = dict(schema_version=3,
                  artifact_kind='NATIVE_COPY_GREEDY_MEASUREMENT' if greedy_trial else ('NATIVE_PREFILL_STATE_COPY_MEASUREMENT' if prefill_copy_trial else ('NATIVE_CONV_COPY_MEASUREMENT' if conv_copy_trial else ('NATIVE_STATE_COPY_MEASUREMENT' if state_copy_trial else ('INGRAPH_ARGMAX_MEASUREMENT' if graph_trial else 'NATIVE_SWIGLU_MEASUREMENT')))),
                  align_revision=Path('.align-revision').read_text().strip(),
                  policy='2026-09-26-no-percentage-floor', status='INCOMPLETE',
                  control_kind=(('same_binary_same_bundle_' if cfg['control']['binary'] == cfg['candidate']['binary'] and cfg['control']['lib'] == cfg['candidate']['lib'] else 'explicit_') + ('mixed_decode_cpu_greedy' if execution['control']['native_conv_copy'] == '1' else 'ordinary_ggml_cpu_greedy')) if greedy_trial else
                               (('same_binary_same_bundle_' if cfg['control']['binary'] == cfg['candidate']['binary'] and cfg['control']['lib'] == cfg['candidate']['lib'] else 'explicit_')
                                + ('mixed_decode' if execution['control']['native_conv_copy'] == '1' else 'ordinary_ggml')) if prefill_copy_trial else
                               (('same_binary_same_bundle_' if cfg['control']['binary'] == cfg['candidate']['binary'] and cfg['control']['lib'] == cfg['candidate']['lib'] else 'explicit_')
                                + ('delta_only' if execution['control']['native_state_copy'] == '1' else 'ordinary_ggml')) if conv_copy_trial else
                               (('same_binary_same_bundle_state_copy_off' if cfg['control']['binary'] == cfg['candidate']['binary'] and cfg['control']['lib'] == cfg['candidate']['lib'] else 'explicit_state_copy_off') if state_copy_trial else
                                ('same_binary_same_bundle_native_off' if args.native_ab else ('both_native_disabled' if args.native_disabled else ('prior_native_source' if args.native_control else 'unchanged_align_source')))),
                  model_sha256=digest(cfg['model']), ggml_commit=Path('.llama-revision').read_text().strip(),
                  identities={name:digest(cfg[name]['binary']) for name in ('control','candidate')},
                  native_shim_sha256={arm:digest(cfg[arm]['shim']) if cfg[arm].get('shim') else None
                                      for arm in ('control','candidate')},
                  reference_sha256=digest(cfg['llama']), trace_sha256=digest(cfg['trace']),
                  backend_identities={arm:json.loads((Path(cfg[arm]['lib'])/'manifest.json').read_text())['bundle_id'] for arm in ('control','candidate')},
                  options_sha256={arm:digest(cfg[arm]['options']) for arm in ('control','candidate')},
                  control_commit=cfg['control_commit'],
                  candidate_patch_sha256=native_patches['candidate'],
                  native_patch_sha256_by_arm=native_patches,
                  argmax_patch_sha256=(argmax_patches['candidate'] if execution['candidate']['graph_greedy'] == '1'
                      else argmax_patches['control'] if graph_trial else None),
                  argmax_patch_sha256_by_arm=argmax_patches if graph_trial else None,
                  note='Startup is construction-to-ready with OS file cache uncontrolled. Phase totals include synchronized ggml graph calls (including native submission when selected) and measured native completion waits when recorded; they exclude CPU readback and sampling and are not shader-only time.',
                  phase_instrumented=not args.wall_only, execution=execution, cases=[], adoption='ASSESSMENT_REQUIRED')
    def save(): args.output.write_text(json.dumps(report,indent=2)+'\n')
    save()
    try:
        with tempfile.TemporaryDirectory(prefix='native-swiglu-measure-') as work:
            work=Path(work)
            system=work/'system';system.write_text(SYSTEM)
            for target_prompt,steps in ((64,16),(200,32),(330,64)):
                prefix='List the integers from 1 to 1000 in ascending order, separated by single spaces. Output only the integers. '
                repeat_count=target_prompt-57
                user_path=work/'user';prompt_path=work/'ids.json'
                for attempt in range(3):
                    user=prefix+'hello '*repeat_count
                    user_path.write_text(user)
                    prompt=subprocess.check_output([cfg['control']['binary'],'--prepare-prompt',cfg['model'],str(system),str(user_path)],env=env)
                    ids=json.loads(prompt)
                    if len(ids)==target_prompt:break
                    repeat_count+=target_prompt-len(ids)
                if len(ids)!=target_prompt:raise ValueError('prompt length construction failed')
                candidate_ids=json.loads(subprocess.check_output(
                    [cfg['candidate']['binary'],'--prepare-prompt',cfg['model'],str(system),str(user_path)],env=env))
                if candidate_ids!=ids:raise ValueError('candidate prompt token IDs differ')
                prompt_path.write_bytes(prompt)
                rendered=work/'rendered'
                rendered.write_bytes(subprocess.check_output([cfg['control']['binary'],'--detokenize',cfg['model'],str(prompt_path),'render-control'],env=env))
                case=dict(prompt_tokens=len(ids),completion_tokens=steps,prompt_ids=ids,pairs=[])
                report['cases'].append(case)
                def align(arm):
                    c=cfg[arm]
                    e=dict(env,DYLD_LIBRARY_PATH=c['lib'],DYLD_INSERT_LIBRARIES=cfg['trace'],
                           ALIGN_LLM_NATIVE_SWIGLU='1' if not args.native_disabled and (arm=='candidate' or args.native_control) else '0')
                    if args.wall_only:e.pop('DYLD_INSERT_LIBRARIES')
                    e['ALIGN_LLM_SYNC_WEIGHT_UPLOAD']=execution[arm]['sync_weight_upload']
                    e['ALIGN_LLM_PREFILL_CHUNK']=execution[arm]['prefill_chunk']
                    e['ALIGN_LLM_PREFILL_FINAL_LOGITS']=execution[arm]['final_prefill_logits']
                    e['ALIGN_LLM_PREFILL_LAST_FFN_ROW']=execution[arm]['final_ffn_row']
                    e['ALIGN_LLM_MAPPED_WEIGHTS']=execution[arm]['mapped_weights']
                    e['ALIGN_LLM_SHARED_LOGITS']=execution[arm]['shared_logits']
                    e['ALIGN_LLM_NEON_GREEDY']=execution[arm]['neon_greedy']
                    e['ALIGN_LLM_GRAPH_GREEDY']=execution[arm]['graph_greedy']
                    e['ALIGN_LLM_NATIVE_STATE_COPY']=execution[arm]['native_state_copy']
                    e['ALIGN_LLM_NATIVE_CONV_COPY']=execution[arm]['native_conv_copy']
                    e['ALIGN_LLM_NATIVE_PREFILL_STATE_COPY']=execution[arm]['native_prefill_state_copy']
                    e['ALIGN_LLM_NATIVE_COPY_GREEDY']=execution[arm]['native_copy_greedy']
                    if execution[arm]['private_buffers'] == '1':
                        e['GGML_METAL_SHARED_BUFFERS_DISABLE']='1'
                    started=time.monotonic_ns()
                    with Session([c['binary'],'--runtime-session',cfg['model'],cfg['pack'],cfg['geometry'],c['options'],'0'],timeout=180,env=e) as session:
                        startup=time.monotonic_ns()-started
                        first_wall=None
                        outputs=[]
                        log_offsets=[os.fstat(session.log.fileno()).st_size] if not args.wall_only else []
                        for _ in range(3):
                            start=time.monotonic_ns()
                            result=session.generate(dict(schema_version=1,system=SYSTEM,user=user,max_tokens=steps,temperature=0.0,seed=None))
                            wall=time.monotonic_ns()-start
                            if first_wall is None:first_wall=wall
                            outputs.append(result['output'])
                            if result['prompt_tokens']!=len(ids) or result['completion_tokens']!=steps:
                                raise ValueError('actual processed token count differs')
                            if not args.wall_only:
                                log_offsets.append(os.fstat(session.log.fileno()).st_size)
                        request_logs=[read_log_span(session.log.fileno(),start,end).decode('utf-8','replace')
                                      for start,end in zip(log_offsets,log_offsets[1:])]
                    graph_groups=[[(int(k),int(t)) for k,t in re.findall(r'Q35_TIMING graph_kind=(\d+) elapsed_ns=(\d+) status=0',log)]
                                  for log in request_logs]
                    wait_groups=[[(int(k),int(t)) for k,t in re.findall(r'Q35_TIMING native_wait_kind=(\d+) elapsed_ns=(\d+) status=0',log)]
                                 for log in request_logs]
                    if len(set(outputs))!=1:raise ValueError('repeated output disagreement')
                    chunk=int(execution[arm]['prefill_chunk'])
                    count=(len(ids)+chunk-1)//chunk+steps-1
                    if not args.wall_only:
                        for ordinal,graphs in enumerate(graph_groups):
                            prefill_count=(len(ids)+chunk-1)//chunk
                            if len(graphs)!=count or any(k!=0 for k,_ in graphs[:prefill_count]) \
                                    or any(k==0 for k,_ in graphs[prefill_count:]):
                                raise ValueError(f'request {ordinal} graph count/kinds differ from selected execution')
                    recent=graph_groups[-1] if graph_groups else []
                    recent_waits=[] if args.wall_only else last_request_native_waits(
                        wait_groups, (len(ids)+chunk-1)//chunk, steps,
                        execution[arm]['native_state_copy']=='1',
                        execution[arm]['native_prefill_state_copy']=='1')
                    graph_prefill=sum(t for k,t in recent if k==0)
                    graph_decode=sum(t for k,t in recent if k!=0)
                    wait_prefill=sum(t for k,t in recent_waits if k==0)
                    wait_decode=sum(t for k,t in recent_waits if k!=0)
                    if not args.wall_only and graph_prefill+graph_decode+wait_prefill+wait_decode>wall:
                        raise ValueError('last-request phase clocks exceed measured request wall')
                    return dict(wall_ns=wall,startup_ns=startup,first_request_ns=first_wall,first_ready_ns=startup+first_wall,prefill_graphs=(len(ids)+chunk-1)//chunk,prefill_ns=None if args.wall_only else graph_prefill+wait_prefill,
                                decode_ns=None if args.wall_only else graph_decode+wait_decode,
                                graph_submit_prefill_ns=None if args.wall_only else graph_prefill,
                                graph_submit_decode_ns=None if args.wall_only else graph_decode,
                                native_wait_prefill_ns=None if args.wall_only or not recent_waits else wait_prefill,
                                native_wait_decode_ns=None if args.wall_only or not recent_waits else wait_decode,
                                output=result['output'])
                def llama():
                    started=time.monotonic_ns()
                    with tempfile.TemporaryFile(mode='w+') as errors:
                        with subprocess.Popen([cfg['llama'],cfg['model'],str(rendered),str(prompt_path),str(steps)],env=env,stdout=subprocess.PIPE,stderr=errors,text=True) as process:
                            # The reference flushes readiness before any request; both
                            # arms now use parent construction-to-ready clocks.
                            try:
                                if not select.select([process.stdout],[],[],180)[0]:
                                    raise TimeoutError('reference readiness timeout')
                                ready=process.stdout.readline()
                                startup=time.monotonic_ns()-started
                                stdout,_=process.communicate(timeout=180)
                            except BaseException:
                                process.kill();process.wait();raise
                            if process.returncode or not re.fullmatch(r'startup_ns=[0-9]+\n',ready):
                                raise ValueError('reference startup/compute failed')
                            done_stdout=ready+stdout
                    parsed=re.findall(r'iteration=(\d+) prompt=(\d+) elapsed_ns=(\d+) prefill_ns=(\d+) decode_ns=(\d+) ids=([0-9,]+)',done_stdout)
                    if len(parsed)!=3 or int(parsed[-1][1])!=len(ids):raise ValueError('reference phase/count mismatch')
                    row=parsed[-1];generated=[int(v) for v in row[5].split(',') if v]
                    if len(generated)!=steps:raise ValueError('reference output count mismatch')
                    output_ids=work/'out.json';output_ids.write_text(json.dumps(generated,separators=(',',':'))+'\n')
                    text=subprocess.check_output([cfg['control']['binary'],'--detokenize',cfg['model'],str(output_ids),'render-control'],env=env).decode()
                    return dict(wall_ns=int(row[2]),prefill_ns=int(row[3]),decode_ns=int(row[4]),startup_ns=startup,output=text)
                for pair in range(args.pairs):
                    row={}
                    order=arms if pair%2==0 else tuple(reversed(arms))
                    for arm in order:row[arm]=llama() if arm=='llama' else align(arm)
                    case['pairs'].append(row);save()
                    if len({v['output'] for v in row.values()})!=1:raise ValueError('output disagreement: retained all evidence; no speed claim')
                    print(f'prompt={len(ids)} output={steps} pair={pair} '+str({k:round(v['wall_ns']/1e6,3) for k,v in row.items()}),flush=True)
                case['median_ms']={arm:{field:None if case['pairs'][0][arm][field] is None else statistics.median(r[arm][field]/1e6 for r in case['pairs']) for field in ('wall_ns','prefill_ns','decode_ns','startup_ns')} for arm in arms}
                save()
        report['status']='PASS'
    except BaseException as error:
        report['error']=str(error);save();raise
    save()
if __name__=='__main__': main()
