#!/usr/bin/env bash

set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
compiler="${ALIGNC:-${project_root}/scripts/alignc}"
variant_fixture="${project_root}/eval/fixtures/c6-prompt-artifacts/prompt-variant.json"
temporary_dir="$(mktemp -d)"
trap 'rm -rf "${temporary_dir}"' EXIT

check_output="${temporary_dir}/check.txt"
"${compiler}" check-per-unit "${project_root}/src/prompt_artifact_io_smoke.align" >"${check_output}"

python3 - "${project_root}/src/prompt_artifacts.align" "${check_output}" <<'PY'
import hashlib
import json
import re
import sys
from pathlib import Path

source = Path(sys.argv[1]).read_text(encoding="utf-8")
records = re.findall(r"^pub ([A-Z][A-Za-z0-9_]*) \{$", source, re.MULTILINE)
expected_records = [
    "PromptTextArtifact",
    "ArtifactReference",
    "PromptVariant",
    "ContextSources",
    "RenderedPromptArtifact",
    "PromptScope",
    "CorpusRevision",
    "ContextPolicy",
    "ArtifactDigest",
    "ArtifactExpectation",
    "SnapshotRequest",
    "WorkspacePreflightRequest",
    "WorkspacePreflightResult",
    "SnapshotResult",
    "TaskInputSnapshot",
    "RunSnapshotAttestation",
    "GenerationPolicy",
    "EvaluationProviderControl",
    "EnvironmentPolicy",
    "EnvironmentVariable",
    "PromptSourceVerifierPolicy",
    "TaskAdapterRequest",
    "EnvironmentProbe",
    "EnvironmentIdentityCore",
    "EnvironmentIdentity",
    "EvaluationInputIdentity",
    "GenerationRequestIdentity",
    "SeedCapabilityAttestation",
    "CandidateProposal",
    "PromptExperimentResult",
    "PromptEvaluateRequest",
    "PromptSourceVerifierRequest",
    "PromptSourceVerifierResult",
    "PromptEvaluationCorpus",
    "PromptEvaluationTask",
    "RegressionLimits",
    "TaskMeasurement",
    "PromptTaskRow",
    "PromptTraceOverflow",
    "PromptEvaluationResult",
    "PromptVerifierTrust",
    "PromptExpectedInputDigest",
    "PromptEvaluationEvidence",
    "PromptAcceptRequest",
    "PromptRollbackRequest",
    "PromptActivation",
    "PromptActivationResult",
    "PromptAcceptancePolicy",
    "TaskAggregate",
    "CorpusAggregate",
    "RegressionReason",
    "PromptGateManifest",
    "PromptGateSourceLocator",
]
decode_functions = re.findall(r"^pub fn decode_[a-z0-9_]+\(", source, re.MULTILINE)
bounded_encode_functions = re.findall(r"^pub fn encode_[a-z0-9_]+_bounded\(", source, re.MULTILINE)
fields = 0
for match in re.finditer(r"^pub ([A-Z][A-Za-z0-9_]*) \{\n(.*?)^\}", source, re.MULTILINE | re.DOTALL):
    fields += sum(
        1
        for line in match.group(2).splitlines()
        if re.match(r"^  [A-Za-z_][A-Za-z0-9_]*:", line)
    )
if records != expected_records:
    raise SystemExit(f"artifact graph declaration order mismatch: {records!r}")
if (len(records), fields, len(decode_functions), len(bounded_encode_functions)) != (53, 585, 53, 53):
    raise SystemExit(
        "artifact graph shape mismatch: "
        f"records={len(records)} fields={fields} "
        f"decode={len(decode_functions)} bounded_encode={len(bounded_encode_functions)}"
    )
if "ok: checked 3 unit(s) per-unit" not in Path(sys.argv[2]).read_text(encoding="utf-8"):
    raise SystemExit("artifact graph owner did not compile the graph consumer")

policy_preimage = {
    "schema_version": 1,
    "artifact_kind": "PROMPT_SOURCE_VERIFIER_POLICY",
    "policy_id": "policy",
    "helper_path": "helper.py",
    "helper_sha256": "helper",
    "helper_runtime": "CPYTHON:python:helper",
    "interpreter_sha256": "python",
    "git_executable_sha256": "git",
    "content_sha256": "",
}
expected_digests = {
    "base": "0dd53d1036d04149fe85af24cf288f5899e1b5bae18afe377540147dccd9bba8",
    "helper_sha256": "7e10e0a60f70cd3f41cbeff5cbeef7bb6625ba4cc59af5b45db90cafe1927da4",
    "helper_runtime": "e6616bd4905eb688e07cfbfaa589328bda92979608c5b33e7825737554a0eefc",
    "interpreter_sha256": "6bbeb077f37a2f4428e17fe81890a1c97fb686e021d2943e67fbbb765343fd27",
    "git_executable_sha256": "7c30995397e7504df0a4bce0b90564d4c473eaa5e6e1fb266b050de9669489c5",
}
def canonical_digest(value):
    return hashlib.sha256(json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode()).hexdigest()
if canonical_digest(policy_preimage) != expected_digests["base"]:
    raise SystemExit("source-verifier policy base digest golden changed")
for field, replacement in (
    ("helper_sha256", "helper-2"),
    ("helper_runtime", "CPYTHON:python-2:helper"),
    ("interpreter_sha256", "python-2"),
    ("git_executable_sha256", "git-2"),
):
    mutated = dict(policy_preimage)
    mutated[field] = replacement
    if canonical_digest(mutated) != expected_digests[field]:
        raise SystemExit(f"source-verifier policy {field} digest golden changed")
PY

"${compiler}" run "${project_root}/src/prompt_runtime_schema_smoke.align"

variant_output="${temporary_dir}/variant.json"
"${compiler}" run "${project_root}/src/prompt_artifact_io_smoke.align" "${variant_fixture}" >"${variant_output}"
cmp "${variant_output}" "${variant_fixture}"

valid_missing_id_failure="${temporary_dir}/valid-missing-id-failure.json"
invalid_missing_id_failure="${temporary_dir}/invalid-missing-id-failure.json"
python3 - "${valid_missing_id_failure}" "${invalid_missing_id_failure}" <<'PY'
import hashlib
import json
import sys
from pathlib import Path


def write(path, status, error_code, error):
    value = {
        "schema_version": 1,
        "artifact_kind": "PROMPT_ACTIVATION_RESULT",
        "status": status,
        "error_code": error_code,
        "error": error,
        "content_sha256": "",
    }
    canonical = json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    value["content_sha256"] = hashlib.sha256(canonical).hexdigest()
    Path(path).write_text(
        json.dumps(value, ensure_ascii=False, separators=(",", ":")),
        encoding="utf-8",
    )


write(sys.argv[1], "INVALID_INPUT", "INVALID_BOUNDS", "invalid request identifier")
write(sys.argv[2], "INELIGIBLE", "INELIGIBLE", "evaluation is not eligible")
PY

"${compiler}" run "${project_root}/src/prompt_artifact_io_smoke.align" \
  activation-valid "${temporary_dir}" "$(basename "${valid_missing_id_failure}")"
if "${compiler}" run "${project_root}/src/prompt_artifact_io_smoke.align" \
  activation-valid "${temporary_dir}" "$(basename "${invalid_missing_id_failure}")" \
  >"${temporary_dir}/invalid-missing-id.stdout" 2>"${temporary_dir}/invalid-missing-id.stderr"; then
  printf '%s\n' "non-INVALID_INPUT failure accepted a missing decision ID" >&2
  exit 1
fi

unknown_variant="${temporary_dir}/unknown-variant.json"
invalid_variant="${temporary_dir}/invalid-variant.json"
oversized_variant="${temporary_dir}/oversized-variant.json"
invalid_memory_policy_variant="${temporary_dir}/invalid-memory-policy-variant.json"
oversized_memory_context_variant="${temporary_dir}/oversized-memory-context-variant.json"
python3 - "${variant_fixture}" "${unknown_variant}" "${invalid_variant}" "${oversized_variant}" \
  "${invalid_memory_policy_variant}" "${oversized_memory_context_variant}" <<'PY'
import hashlib
import json
import sys
from pathlib import Path

value = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
unknown = dict(value)
unknown["unknown_field"] = {"ignored": True}
oversized = {
    "schema_version": 1,
    "artifact_kind": "PROMPT_VARIANT",
    "unknown_field": "x" * 2097152,
}
def with_context_policy(context_policy):
    candidate = dict(value)
    candidate["context_policy"] = context_policy
    candidate["content_sha256"] = ""
    canonical = json.dumps(candidate, separators=(",", ":"), ensure_ascii=False)
    candidate["content_sha256"] = hashlib.sha256(canonical.encode("utf-8")).hexdigest()
    return candidate

invalid_memory_policy = dict(value["context_policy"])
invalid_memory_policy["include_failure_memory"] = True
invalid_memory_policy["max_failure_events"] = 0
invalid_memory_policy["max_failure_context_bytes"] = 32
oversized_memory_context = dict(value["context_policy"])
oversized_memory_context["include_failure_memory"] = True
oversized_memory_context["max_failure_events"] = 1
oversized_memory_context["max_failure_context_bytes"] = 65537

for path, payload in (
    (sys.argv[2], unknown),
    (sys.argv[3], {**value, "content_sha256": "0" * 64}),
    (sys.argv[4], oversized),
    (sys.argv[5], with_context_policy(invalid_memory_policy)),
    (sys.argv[6], with_context_policy(oversized_memory_context)),
):
    Path(path).write_text(json.dumps(payload, separators=(",", ":")) + "\n", encoding="utf-8")
PY

unknown_output="${temporary_dir}/unknown-output.json"
"${compiler}" run "${project_root}/src/prompt_artifact_io_smoke.align" "${unknown_variant}" >"${unknown_output}"
cmp "${unknown_output}" "${variant_fixture}"
if "${compiler}" run "${project_root}/src/prompt_artifact_io_smoke.align" "${invalid_variant}" \
  >"${temporary_dir}/invalid-output" 2>"${temporary_dir}/invalid-error"; then
  echo "invalid digest was accepted" >&2
  exit 1
fi
if "${compiler}" run "${project_root}/src/prompt_artifact_io_smoke.align" "${oversized_variant}" \
  >"${temporary_dir}/oversized-output" 2>"${temporary_dir}/oversized-error"; then
  echo "oversized artifact was accepted" >&2
  exit 1
fi
if "${compiler}" run "${project_root}/src/prompt_artifact_io_smoke.align" "${invalid_memory_policy_variant}" \
  >"${temporary_dir}/invalid-memory-policy-output" 2>"${temporary_dir}/invalid-memory-policy-error"; then
  echo "invalid failure-memory policy was accepted" >&2
  exit 1
fi
if "${compiler}" run "${project_root}/src/prompt_artifact_io_smoke.align" "${oversized_memory_context_variant}" \
  >"${temporary_dir}/oversized-memory-context-output" 2>"${temporary_dir}/oversized-memory-context-error"; then
  echo "oversized failure-memory context policy was accepted" >&2
  exit 1
fi

echo "c6 prompt artifact graph, canonical round-trip, unknown-field, digest, and input-cap adoption: PASS"
