#!/usr/bin/env python3
"""Strict request records over the actual Align session framing."""
import json
import os
from pathlib import Path
import shutil
import struct
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent

def frame(value):
    return struct.pack("<I", len(value)) + value

def encoded(record):
    return json.dumps(record, separators=(",", ":")).encode()

def main():
    compiler = os.environ.get("ALIGNC", str(ROOT / "scripts/alignc"))
    subprocess.run([compiler, "build", "src/runtime_session_protocol_smoke.align"], cwd=ROOT, check=True)
    base = dict(schema_version=1, system="system", user="hello", max_tokens=3, temperature=0.0, seed=None)
    cases = [(encoded(base), True), (encoded(dict(base, user="line one\nline two")), True),
             (encoded(dict(base, system="quoted \"system\"", user="tab\tand slash\\")), True)]
    for seed in (0, -(2**63), 2**63-1):
        cases.append((encoded(dict(base, temperature=0.3, seed=seed)), True))
    for key, values in {"schema_version": [True, 1.5, 2, "1"],
                        "max_tokens": [True, 0, 129, 1.5, "3", 2**63],
                        "temperature": [True, "0", 0.1, None],
                        "seed": [True, "1", 0, 1.5, 2**63],
                        "system": [None, [], {}, 3, "bad\0"],
                        "user": [None, True, "bad\0"]}.items():
        for value in values:
            cases.append((encoded(dict(base, **{key: value})), False))
    for key in base:
        record = dict(base)
        del record[key]
        cases.append((encoded(record), False))
    raw = encoded(base)
    cases.extend([(encoded(dict(base, unknown=1)), False),
                  (raw[:-1] + b',"seed":null}', False),
                  (raw + b"{}", False), (b"[]", False),
                  (raw.replace(b'"schema_version":1', b'"schema_version":01'), False),
                  (raw.replace(b'"hello"', b'"raw\nnewline"'), False)])
    # Every invalid record is followed by a valid one in the same process.
    sequence = []
    for row in cases:
        sequence.extend([row, (raw, True)])
    with tempfile.TemporaryDirectory(prefix="gpu-session-protocol-") as temporary:
        executable = Path(temporary) / "protocol"
        shutil.move(str(ROOT / "runtime_session_protocol_smoke"), executable)
        result = subprocess.run([executable], input=b"".join(frame(row[0]) for row in sequence),
                                capture_output=True, timeout=30)
        expected = b"".join(frame(b"ok" if row[1] else b"invalid") for row in sequence)
        assert result.returncode == 0, result.stderr
        if result.stdout != expected:
            actual = result.stdout
            for index, row in enumerate(sequence):
                size = struct.unpack("<I", actual[:4])[0]
                value, actual = actual[4:4+size], actual[4+size:]
                assert value == (b"ok" if row[1] else b"invalid"), (index, row[0], value)
            raise AssertionError("unexpected trailing response")
    print(f"gpu session protocol smoke: PASS ({len(sequence)} ordered requests)")

if __name__ == "__main__":
    main()
