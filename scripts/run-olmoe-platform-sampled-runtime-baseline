# ggml's own default, `GGML_DEFAULT_N_THREADS` in the pinned ggml's `ggml/include/ggml.h`. The
# shim never calls `ggml_graph_plan`/`n_threads`, so the runtime arm runs at this value.
EFFECTIVE_GGML_THREADS = 4

# The inherited llama-server launch line is part of the fixed workload: `-t 4` and `-c 512` decide
# how fast the local arm can answer, `-np 1` its concurrency, `-ngl 0` that nothing leaves the
# CPU, `--jinja` the prompt template and `--no-warmup` what the first request pays. The tokens
# below are matched against the source of `isolated.measure_local_isolated`, the function that
# builds that argv, so an edit there cannot silently change what this baseline measures. They are
# written in that source's exact literal style.
SERVER_ARGV_TOKENS = (
    '"-t", "4"',
    '"-c", "512"',
    '"-np", "1"',
    '"-ngl", "0"',
    '"--jinja"',
    '"--no-warmup"',
)

