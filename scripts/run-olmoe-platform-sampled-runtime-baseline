import json
import os
import platform
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any
from unittest import mock


ROOT = Path(__file__).resolve().parents[1]
ISOLATED_RELATIVE = "scripts/run-olmoe-isolated-sampled-runtime-decision"
LOADER = SourceFileLoader("olmoe_isolated_for_platform_baseline", str(ROOT / ISOLATED_RELATIVE))
SPEC = importlib.util.spec_from_loader(LOADER.name, LOADER)
if SPEC is None or SPEC.loader is None:
    raise RuntimeError("cannot load the isolated sampled runtime owner")
isolated = importlib.util.module_from_spec(SPEC)
sys.modules[LOADER.name] = isolated
SPEC.loader.exec_module(isolated)
sampled = isolated.previous
coding = sampled.base

