#!/usr/bin/env bash

set -euo pipefail

# R4.5-EXTERNAL-BUFFER-SPIKE narrow durable owner (`docs/specs/r4-5-external-buffer.md` section
# 5.1). Hosted, ggml-free, in HOSTED_CHECK_TARGETS.
#
# It builds the **stub** shim and the `ggml-spike` executable, writes a synthetic alignpack v1
# corpus into a temporary tree, runs the whole CLI over every fixture, and compares each rendered
# document byte for byte against a checked-in golden. Eleven of the sixteen error codes are reached
# for real, without ggml, without a model, without a network, and without a reference tool.
#
# Since MOE-PREREQ-DISCHARGE (`docs/specs/moe-prereq-discharge.md` section 4.6) it also packs the
# **synthetic olmoe** container `scripts/gguf_fixture.py` already generates with `main --pack`,
# verifies it, and drives the whole of steps 7a and 7b — both success forms, both new
# `R4_5_SHAPE` details, and every `R4_5_SLICE` detail — over a real `ExpertBlock` claim. That is
# reachable here because `r4-5-external-buffer.md` section 3.8 stops the stub at step 10, so the
# entire new validation surface is hosted and only the *computations* need real ggml.
#
# `ALIGN_LLM_GGML_INCLUDE` is unset deliberately and unconditionally: this runner's contract is that
# it exercises the ggml-free build, so a developer's exported include path must not silently turn it
# into a different test.
#
#   ALIGN_LLM_GGML_SPIKE_GOLDEN_UPDATE=1   rewrite the golden file instead of comparing to it

unset ALIGN_LLM_GGML_INCLUDE ALIGN_LLM_GGML_LIB ALIGN_LLM_GGML_FORCE
export PYTHONDONTWRITEBYTECODE=1

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
compiler="${ALIGNC:-${root_dir}/scripts/alignc}"

work_dir=$(mktemp -d)
# The temporary tree now holds a packed synthetic olmoe container as well as the hand-written
# corpus, so removal is asserted rather than assumed (section 4.6, cell *Cleanup*): a tree that
# survives is a leak this runner caused, and on the fresh worker it is also an aggregate failure
# with no output naming the cause.
cleanup() {
  status=$?
  rm -rf "${work_dir}"
  if [ -e "${work_dir}" ]; then
    echo "ggml spike smoke: FAIL the temporary tree survived cleanup: ${work_dir}" >&2
    exit 1
  fi
  exit "${status}"
}
trap cleanup EXIT HUP INT TERM

# Static assertions that are not about a fixture (section 5.1).
#
# The two C files are one contract compiled twice; a drift between them would let this runner pass
# against a contract the qualification never runs. One `unsafe` block in one file is the discipline
# `../align/docs/guide/15-unsafe-and-ffi.md` asks for, and the scan below is the block-level form of
# it — the word alone appears in prose and in an `unsafe_workspace` parameter name elsewhere in
# `src/`, so the keyword, not the word, is what is asserted (section 6, correction C19).
real_region=$(sed -n '/BEGIN R4.5 SHARED SHIM CONTRACT/,/END R4.5 SHARED SHIM CONTRACT/p' \
  "${root_dir}/scripts/ggml_shim.c")
stub_region=$(sed -n '/BEGIN R4.5 SHARED SHIM CONTRACT/,/END R4.5 SHARED SHIM CONTRACT/p' \
  "${root_dir}/scripts/ggml_shim_stub.c")
if [ -z "${real_region}" ] || [ "${real_region}" != "${stub_region}" ]; then
  echo "ggml spike smoke: FAIL the shared shim contract differs between the two C files" >&2
  exit 1
fi
if grep -q "malloc" "${root_dir}/scripts/ggml_shim.c" "${root_dir}/scripts/ggml_shim_stub.c"; then
  echo "ggml spike smoke: FAIL a shim allocates; the shim owns no memory the document describes" >&2
  exit 1
fi
# The keyword, not the word: `prompt_verifier_smoke.align` legitimately names an
# `unsafe_workspace` parameter, and this capability's own modules discuss the boundary in prose.
# `grep -rl` reports matches in directory order, so the comparison needs a deterministic sort. It
# comes from `python3` rather than `sort`, because the fresh worker image ships a curated tool set
# (`image/fresh/Dockerfile`) that has no `sort` and this runner is a `capable-checks` member there.
sorted_paths() {
  python3 -c 'import sys; sys.stdout.write(" ".join(sorted(sys.stdin.read().split())))'
}
unsafe_files=$(cd "${root_dir}" \
  && grep -rlE '(^|[^A-Za-z_])unsafe[[:space:]]*\{' src/ | sorted_paths)
if [ "${unsafe_files}" != "src/ggml_ffi.align" ]; then
  echo "ggml spike smoke: FAIL an unsafe block appears outside src/ggml_ffi.align: ${unsafe_files}" >&2
  exit 1
fi
extern_files=$(cd "${root_dir}" \
  && grep -rlE '^[[:space:]]*extern[[:space:]]+"C"' src/ | sorted_paths)
if [ "${extern_files}" != "src/ggml_ffi.align" ]; then
  echo "ggml spike smoke: FAIL an extern block appears outside src/ggml_ffi.align: ${extern_files}" >&2
  exit 1
fi

# The shim and the executable are built **into the temporary tree**, not into the work tree. The
# fresh worker permits the whole `capable-checks` aggregate to leave exactly one file, `main`, in
# `/workspace` (`scripts/fresh-align-compiler`), and this runner is one of its members; a `build/`
# directory or a `ggml-spike` binary left behind fails the aggregate after every check has passed,
# with no output naming the cause. `alignc` writes its executable next to the invocation, so the
# one file it does create in the work tree is moved out in the same step.
shim_dir=$(ALIGN_LLM_GGML_SHIM_DIR="${work_dir}/lib" "${root_dir}/scripts/build-ggml-shim")
# The compiler's warnings are captured rather than streamed **under the fresh worker**, exactly as
# `Makefile`'s own `check` and `build` targets do. `src/ggml_spike.align` now imports
# `src/layer_forward.align` and `src/layer_qwen2.align`, so one build of it writes ~22 KB of
# `huge struct copy` and `lossy conversion` warnings, and the supervisor bounds the whole
# `capable-checks` child at 65,536 bytes per stream (`scripts/fresh-align-compiler`
# `MAX_STREAM_BYTES`). Two runners building it is already two thirds of that budget, and an
# overflow kills the child with no message naming the cause. Developers still see every warning.
(
  cd "${root_dir}"
  export LIBRARY_PATH="${shim_dir}${LIBRARY_PATH:+:${LIBRARY_PATH}}"
  export DYLD_LIBRARY_PATH="${shim_dir}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}"
  export LD_LIBRARY_PATH="${shim_dir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
  if [ "${ALIGN_LLM_FRESH_COMPILER:-0}" = 1 ]; then
    diagnostic="${work_dir}/alignc-diagnostic.txt"
    if ! "${compiler}" build src/ggml_spike.align >/dev/null 2>"${diagnostic}"; then
      cat "${diagnostic}" >&2
      exit 1
    fi
    rm -f "${diagnostic}"
  else
    "${compiler}" build src/ggml_spike.align >/dev/null
  fi
  mv -f ggml_spike "${work_dir}/ggml-spike"
)

python3 "${root_dir}/scripts/ggml_spike_fixture.py" "${work_dir}" >/dev/null

DYLD_LIBRARY_PATH="${shim_dir}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}" \
LD_LIBRARY_PATH="${shim_dir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
python3 - "${root_dir}" "${work_dir}" <<'PY'
import json
import os
import struct
import subprocess
import sys

root_dir, work_dir = sys.argv[1:3]
sys.path.insert(0, os.path.join(root_dir, "scripts"))
import alignpack_reader  # noqa: E402  (the independent third opinion, section 3.5)
import gguf_fixture  # noqa: E402  (the synthetic olmoe container, section 5.1)

binary = os.path.join(work_dir, "ggml-spike")
main_binary = os.path.join(root_dir, "main")
golden_path = os.path.join(root_dir, "scripts", "ggml-spike-golden.jsonl")
update = os.environ.get("ALIGN_LLM_GGML_SPIKE_GOLDEN_UPDATE") == "1"

PACK = os.path.join(work_dir, "pack-minimal.alignpack")
SOURCE_OK = os.path.join(work_dir, "source-identical.bin")
SOURCE_BAD = os.path.join(work_dir, "source-diverged.bin")
SOURCE_EMPTY = os.path.join(work_dir, "source-empty.bin")
SOURCE_EOF = os.path.join(work_dir, "source-eof.bin")
SOURCE_MID = os.path.join(work_dir, "source-mid-member.bin")


def pack(name):
    return os.path.join(work_dir, name + ".alignpack")


# =============================================================================================
# The synthetic olmoe stage (`docs/specs/moe-prereq-discharge.md` sections 4.6 and 5.1)
#
# No new corpus: `scripts/gguf_fixture.py` already generates the olmoe container `run-model-ir-smoke`
# drives, so this packs *that* with the repository's own `main --pack`, verifies it, and takes every
# claim fixture from a copy of the result. A fixture forged by hand could disagree with the writer
# about where a plane lives; one produced by the writer cannot.
# =============================================================================================

MEMBER_RECORD_BYTES = 96
SLICE_INDEX_OFFSET = 80
SLICE_COUNT_OFFSET = 84
DIM3_OFFSET = 72

olmoe_failures = []
OLMOE_GGUF = os.path.join(work_dir, "olmoe-full.gguf")
OLMOE_PACK = os.path.join(work_dir, "olmoe.alignpack")
OLMOE_PACK_DOCUMENT = os.path.join(work_dir, "olmoe-pack.json")
OLMOE_VERIFY_DOCUMENT = os.path.join(work_dir, "olmoe-verify.json")

with open(OLMOE_GGUF, "wb") as handle:
    handle.write(gguf_fixture.OlmoeModel().bytes)


def run_main(operands):
    return subprocess.run([main_binary] + operands, capture_output=True, cwd=work_dir)


packed = run_main(["--pack", OLMOE_GGUF, OLMOE_PACK, OLMOE_PACK_DOCUMENT])
if packed.returncode != 0:
    raise SystemExit("ggml spike smoke: FAIL olmoe-pack-verify: --pack exited %d: %s"
                     % (packed.returncode, packed.stderr.decode("utf-8", "replace")[-400:]))
verified = run_main(["--pack-verify", OLMOE_GGUF, OLMOE_PACK, OLMOE_VERIFY_DOCUMENT])
if verified.returncode != 0:
    raise SystemExit("ggml spike smoke: FAIL olmoe-pack-verify: --pack-verify exited %d"
                     % verified.returncode)

with open(OLMOE_PACK_DOCUMENT, "r", encoding="utf-8") as handle:
    olmoe_document = json.load(handle)
with open(OLMOE_VERIFY_DOCUMENT, "r", encoding="utf-8") as handle:
    olmoe_verify = json.load(handle)
if olmoe_document["status"] != "ok":
    olmoe_failures.append("olmoe-pack-verify: --pack reported %r" % olmoe_document["error_code"])
if olmoe_verify["status"] != "ok" or olmoe_verify["verdict"] != "identical":
    olmoe_failures.append("olmoe-pack-verify: --pack-verify reported %r/%r"
                          % (olmoe_verify["status"], olmoe_verify["verdict"]))

# The block set this stage measured, read from the document rather than assumed: a fixture that
# stopped emitting `ExpertBlock`s must fail here rather than silently skip the whole new surface.
olmoe_blocks = olmoe_document["blocks"]
olmoe_experts = [entry for entry in olmoe_blocks if entry["kind"] == "ExpertBlock"]
if not olmoe_experts:
    raise SystemExit("ggml spike smoke: FAIL the synthetic olmoe pack holds no ExpertBlock")
FIRST_EXPERT = olmoe_experts[0]
N_EXPERT = FIRST_EXPERT["members"][0]["slice_count"]
LAST_EXPERT = [entry for entry in olmoe_experts
               if entry["members"][0]["slice_index"] == N_EXPERT - 1][0]
FIRST_DENSE = [entry for entry in olmoe_blocks if entry["kind"] == "AttentionBlock"][0]
FIRST_DENSE_MEMBER = [position for position, member in enumerate(FIRST_DENSE["members"])
                      if member["role_id"] == 1][0]

# Section 4.1's *Malformed input* cell: every claim fixture below is a **mutation**, and the claim
# that `--pack` cannot write one is asserted rather than assumed.
olmoe_members = []
for entry in olmoe_blocks:
    olmoe_members.extend(entry["members"])
for position, member in enumerate(olmoe_members):
    pair = (member["slice_index"], member["slice_count"])
    well_formed = pair == (-1, -1) or (pair[0] >= 0 and pair[1] >= 1 and pair[0] < pair[1])
    if not well_formed:
        olmoe_failures.append("olmoe-pack-verify: --pack wrote a self-inconsistent slice pair "
                              "%r at member %d" % (pair, position))

MEMBER_TABLE_OFFSET = olmoe_document["pack"]["member_table_offset"]
FIRST_EXPERT_GLOBAL = sum(len(entry["members"]) for entry in olmoe_blocks
                          if entry["index"] < FIRST_EXPERT["index"])


def olmoe_mutation(name, offset, fmt, *values):
    """One claim fixture: a copy of the packed olmoe container with one member record edited.

    The edit is always inside the **first `ExpertBlock`'s first member**, which is the record every
    claim case selects, and it is the smallest change that produces the named defect (section 5.1).
    """
    with open(OLMOE_PACK, "rb") as source:
        raw = bytearray(source.read())
    struct.pack_into(fmt, raw, MEMBER_TABLE_OFFSET + FIRST_EXPERT_GLOBAL * MEMBER_RECORD_BYTES
                     + offset, *values)
    path = pack(name)
    with open(path, "wb") as destination:
        destination.write(bytes(raw))
    return path


# Every case: (name, operands). A case whose operands are rejected before any file work emits no
# document at all, and is listed in NO_DOCUMENT instead.
NO_DOCUMENT = [
    ("spike-arity-2", [PACK]),
    ("spike-arity-3", [PACK, "1"]),
    ("spike-arity-6", [PACK, "1", "1", "-", SOURCE_OK, "extra"]),
    ("spike-path-empty", ["", "1", "1"]),
    ("spike-path-long", ["/" + ("a" * 5000), "1", "1"]),
    ("spike-doc-path-empty", [PACK, "1", "1", ""]),
    ("spike-reference-path-empty", [PACK, "1", "1", "-", ""]),
]

CASES = [
    ("spike-stub-unavailable", [PACK, "1", "1"]),
    ("spike-block-zero", [PACK, "0", "0"]),
    ("spike-index-negative", [PACK, "-1", "1"]),
    ("spike-index-nonnumeric", [PACK, "1x", "1"]),
    ("spike-index-leading-zero", [PACK, "01", "1"]),
    ("spike-index-huge", [PACK, "1", "99999999999999999999"]),
    ("spike-block-oob", [PACK, "9", "0"]),
    ("spike-member-oob", [PACK, "1", "9"]),
    ("pack-bad-magic", [pack("pack-bad-magic"), "1", "1"]),
    ("pack-bad-version", [pack("pack-bad-version"), "1", "1"]),
    ("pack-bad-widths", [pack("pack-bad-widths"), "1", "1"]),
    ("pack-bad-align", [pack("pack-bad-align"), "1", "1"]),
    ("pack-flags-set", [pack("pack-flags-set"), "1", "1"]),
    ("pack-len-mismatch", [pack("pack-len-mismatch"), "1", "1"]),
    ("pack-region-overlap", [pack("pack-region-overlap"), "1", "1"]),
    ("pack-u64-highbit", [pack("pack-u64-highbit"), "1", "1"]),
    ("pack-name-overrun", [pack("pack-name-overrun"), "1", "1"]),
    ("pack-offset-nonmonotonic", [pack("pack-offset-nonmonotonic"), "1", "1"]),
    ("pack-reserved-block", [pack("pack-reserved-block"), "1", "1"]),
    ("pack-reserved-member", [pack("pack-reserved-member"), "1", "1"]),
    ("pack-missing", [os.path.join(work_dir, "absent.alignpack"), "1", "1"]),
    ("spike-shape-3d", [pack("spike-shape-3d"), "1", "1"]),
    ("spike-shape-zero", [pack("spike-shape-zero"), "1", "1"]),
    ("spike-dimension-bound", [pack("spike-dimension-bound"), "1", "1"]),
    ("spike-ne0-not-multiple", [pack("spike-ne0-not-multiple"), "1", "1"]),
    ("spike-type-unsupported", [pack("spike-type-unsupported"), "1", "1"]),
    ("spike-misaligned-member", [pack("spike-misaligned-member"), "1", "1"]),
    ("spike-reference-identical", [PACK, "1", "1", "-", SOURCE_OK]),
    ("spike-reference-diverged", [PACK, "1", "1", "-", SOURCE_BAD]),
    ("spike-reference-missing", [PACK, "1", "1", "-", os.path.join(work_dir, "absent.bin")]),
    # The three references that exist and still cannot supply the member's range. Each must be
    # `R4_5_SOURCE_UNREADABLE` naming the range and the file's length, not the container reader's
    # `R4_WINDOW_UNAVAILABLE` (section 6, correction C15).
    ("spike-reference-empty", [PACK, "1", "1", "-", SOURCE_EMPTY]),
    ("spike-reference-eof", [PACK, "1", "1", "-", SOURCE_EOF]),
    ("spike-reference-mid-member", [PACK, "1", "1", "-", SOURCE_MID]),
]

# The claim half, all of it over the packed synthetic olmoe container. Steps 7a and 7b sit inside
# the ggml-free prefix, so every code, every detail, and both success forms are reached here.
FIRST_EXPERT_OPERANDS = [OLMOE_PACK, str(FIRST_EXPERT["index"]), "0"]
CASES += [
    # Success — the claim form, at plane 0 and at plane `n_expert - 1`.
    ("olmoe-expert-claim", list(FIRST_EXPERT_OPERANDS)),
    ("olmoe-expert-claim-last", [OLMOE_PACK, str(LAST_EXPERT["index"]), "0"]),
    # Success — the whole form on the same container, which is also the `slice: -` case.
    ("olmoe-dense-member",
     [OLMOE_PACK, str(FIRST_DENSE["index"]), str(FIRST_DENSE_MEMBER)]),
    # Failure — step 7a. Each is one edit of bytes 80-95 of one member record.
    ("olmoe-expert-claim-slice-pair",
     [olmoe_mutation("olmoe-expert-claim-slice-pair", SLICE_COUNT_OFFSET, "<i", -1)]
     + FIRST_EXPERT_OPERANDS[1:]),
    ("olmoe-expert-claim-slice-pair-mirror",
     [olmoe_mutation("olmoe-expert-claim-slice-pair-mirror", SLICE_INDEX_OFFSET, "<i", -1)]
     + FIRST_EXPERT_OPERANDS[1:]),
    ("olmoe-expert-claim-slice-count",
     [olmoe_mutation("olmoe-expert-claim-slice-count", SLICE_COUNT_OFFSET, "<i", 0)]
     + FIRST_EXPERT_OPERANDS[1:]),
    ("olmoe-expert-claim-slice-range",
     [olmoe_mutation("olmoe-expert-claim-slice-range", SLICE_INDEX_OFFSET, "<i", N_EXPERT)]
     + FIRST_EXPERT_OPERANDS[1:]),
    # Failure — step 7b. `whole-member-3d` is section 2.4's measured refusal, kept as the whole
    # form's rule: a member declaring `-1`/`-1` and three dimensions is still not a `mul_mat` left
    # operand, and the same edit that admits the claim is what would have hidden it.
    ("olmoe-whole-member-3d",
     [olmoe_mutation("olmoe-whole-member-3d", SLICE_INDEX_OFFSET, "<ii", -1, -1)]
     + FIRST_EXPERT_OPERANDS[1:]),
    ("olmoe-expert-claim-dim2",
     [olmoe_mutation("olmoe-expert-claim-dim2", SLICE_COUNT_OFFSET, "<i", N_EXPERT - 1)]
     + FIRST_EXPERT_OPERANDS[1:]),
    ("olmoe-expert-claim-dim3",
     [olmoe_mutation("olmoe-expert-claim-dim3", DIM3_OFFSET, "<Q", 2)]
     + FIRST_EXPERT_OPERANDS[1:]),
]

PLACEHOLDER = "<pack>"
SOURCE_PLACEHOLDER = "<source>"


# The fields that are properties of *this run* rather than of the contract, and cannot be
# byte-stable (section 6, correction C10):
#
#   timings.*                  wall-clock nanoseconds;
#   pack_path, reference_path  a `mktemp -d` tree;
#   buffer.base_alignment, buffer.weights_pad,
#   buffer.output_base_alignment, buffer.output_pad
#                              the **allocator's** answer. Measured on this host, the same window
#                              comes back 32-aligned on one run and 16-aligned on the next — this
#                              runner sees `weights_pad` vary run to run within `[1, 64]` for one
#                              fixture. That variation is the whole of the recorded
#                              aligned-allocation gap, it is why the arm pads instead of refusing,
#                              and it is why these four are checked as an invariant below rather
#                              than as a constant.
#
# Everything else stays a byte-for-byte regression: the normalizer rewrites values in place and
# never reorders, adds, or drops a field.
ALLOCATOR_FIELDS = ("base_alignment", "weights_pad", "output_base_alignment", "output_pad")


def normalize(text):
    document = json.loads(text)
    for key in document["timings"]:
        document["timings"][key] = 0
    for key in ALLOCATOR_FIELDS:
        document["buffer"][key] = 0
    for key, placeholder in (("pack_path", PLACEHOLDER), ("reference_path", SOURCE_PLACEHOLDER)):
        value = document[key]
        if value:
            document[key] = placeholder
    return json.dumps(document, separators=(",", ":"), ensure_ascii=False)


# `src/ggml_spike.align`'s `MAX_TENSOR_ALIGNMENT`: the compensation window both device-visible
# buffers are over-reserved by, and the modulus the pads are computed against, because the linked
# library's own `tensor_alignment` is not known until after the block is read.
COMPENSATION = 64


def check_alignment_invariant(name, document):
    """What the four allocator-dependent fields must satisfy on every run.

    The arm **compensates** for the allocator's base rather than refusing it (section 6, correction
    C14): each device-visible window is over-reserved by `COMPENSATION` bytes and the range handed
    to ggml starts `pad` bytes into it, so `base + pad` is on a `tensor_alignment` boundary whatever
    the allocator returned. The weights pad is at least one byte because publishing one byte is what
    makes the base measurable at all; the output pad may be zero because it is only a slice offset.

    The member's address is then block byte 0 — compensated — plus a **container-chosen** interior
    offset, which is why `R4_5_ALIGNMENT` with detail `member` must mean exactly one thing: the
    interior offset is not a multiple of the alignment. That verdict is the same on every host and
    on every run, and this is where that is checked.
    """
    buffer = document["buffer"]
    alignment = document["abi"]["tensor_alignment"]
    problems = []
    if alignment <= 0:
        return problems
    for base_key, pad_key, low, high in (("base_alignment", "weights_pad", 1, COMPENSATION),
                                         ("output_base_alignment", "output_pad", 0,
                                          COMPENSATION - 1)):
        base = buffer[base_key]
        pad = buffer[pad_key]
        if pad != -1 and not low <= pad <= high:
            problems.append("%s: %s is %d, outside [%d, %d]" % (name, pad_key, pad, low, high))
        if base < 0:
            continue
        if not 0 <= base < alignment:
            problems.append("%s: %s is %d, outside [0, %d)" % (name, base_key, base, alignment))
        if pad < 0 or (base + pad) % alignment != 0:
            problems.append("%s: %s %d does not carry %s %d onto a %d boundary"
                            % (name, pad_key, pad, base_key, base, alignment))
    interior = buffer["interior_offset"]
    if document["error_code"] == "R4_5_ALIGNMENT" and document["error_detail"] == "member":
        if interior % alignment == 0:
            problems.append("%s: R4_5_ALIGNMENT/member on interior_offset %d, which is %d-aligned"
                            % (name, interior, alignment))
    elif document["error_code"] != "R4_5_ALIGNMENT" and buffer["base_alignment"] >= 0:
        if interior % alignment != 0:
            problems.append("%s: interior_offset %d is not %d-aligned but the run continued"
                            % (name, interior, alignment))
        if (buffer["base_alignment"] + buffer["weights_pad"] + interior) % alignment != 0:
            problems.append("%s: the member address is not %d-aligned but the run continued"
                            % (name, alignment))
    return problems


def check_stub_lifetime(name, document):
    """No ggml object exists in a stub build, and the document says so rather than implying it.

    The stub stops the arm at the availability gate, before the first constructor, so every
    `lifetime` counter must still be zero — an unbalanced or non-zero count here would mean the arm
    reached construction against a shim that cannot construct anything.
    """
    lifetime = document["lifetime"]
    problems = []
    for key in ("ggml_buffers_created", "ggml_buffers_freed", "contexts_created", "contexts_freed",
                "backends_created", "backends_freed"):
        if lifetime[key] != 0:
            problems.append("%s: lifetime.%s is %d in a stub build, not 0"
                            % (name, key, lifetime[key]))
    if lifetime["released_before_owner_scope_end"]:
        problems.append("%s: lifetime.released_before_owner_scope_end is true in a stub build, "
                        "where the teardown is never reached" % name)
    return problems


def run(operands):
    return subprocess.run([binary] + operands, capture_output=True, cwd=work_dir)


failures = []
produced = {}

for name, operands in NO_DOCUMENT:
    result = run(operands)
    if result.returncode == 0:
        failures.append("%s: expected a non-zero exit, got 0" % name)
    if result.stdout != b"":
        failures.append("%s: expected no document, got %d bytes" % (name, len(result.stdout)))

for name, operands in CASES:
    result = run(operands)
    if result.stdout == b"":
        failures.append("%s: no document (exit %d): %s"
                        % (name, result.returncode, result.stderr.decode("utf-8", "replace")[-400:]))
        continue
    try:
        rendered = normalize(result.stdout.decode("utf-8"))
    except Exception as error:  # noqa: BLE001 - the document is the thing under test
        failures.append("%s: the document is not valid JSON: %s" % (name, error))
        continue
    produced[name] = rendered
    document = json.loads(result.stdout.decode("utf-8"))
    failures.extend(check_alignment_invariant(name, document))
    failures.extend(check_stub_lifetime(name, document))
    expected_exit = 0 if document["status"] == "ok" else 1
    if (result.returncode == 0) != (expected_exit == 0):
        failures.append("%s: status %r but exit %d"
                        % (name, document["status"], result.returncode))

failures.extend(olmoe_failures)

# ---- the claim surface, asserted by code and detail ------------------------------------------
#
# `docs/specs/moe-prereq-discharge.md` sections 4.1 and 4.2. Every mutation names the exact fault
# it was written to produce, and the two unmutated claim cases are what proves each mutation is the
# cause rather than the container being unusable for a claim at all.
OLMOE_EXPECTED = {
    "olmoe-expert-claim": ("R4_5_GGML_UNAVAILABLE", "stub"),
    "olmoe-expert-claim-last": ("R4_5_GGML_UNAVAILABLE", "stub"),
    "olmoe-dense-member": ("R4_5_GGML_UNAVAILABLE", "stub"),
    "olmoe-expert-claim-slice-pair": ("R4_5_SLICE", "pair"),
    "olmoe-expert-claim-slice-pair-mirror": ("R4_5_SLICE", "pair"),
    "olmoe-expert-claim-slice-count": ("R4_5_SLICE", "count[0]"),
    "olmoe-expert-claim-slice-range": ("R4_5_SLICE", "index[%d]" % N_EXPERT),
    "olmoe-whole-member-3d": ("R4_5_SHAPE", "n_dims[3]"),
    "olmoe-expert-claim-dim2": ("R4_5_SHAPE", "dim2[%d]" % N_EXPERT),
    "olmoe-expert-claim-dim3": ("R4_5_SHAPE", "dim3[2]"),
}
for name, (code, detail) in sorted(OLMOE_EXPECTED.items()):
    document = json.loads(produced[name]) if name in produced else None
    if document is None:
        failures.append("%s: no document" % name)
        continue
    if (document["error_code"], document["error_detail"]) != (code, detail):
        failures.append("%s: %s/%s, expected %s/%s"
                        % (name, document["error_code"], document["error_detail"], code, detail))
    if document["verdict"] != "UNAVAILABLE":
        failures.append("%s: verdict %s" % (name, document["verdict"]))
    if document["schema_version"] != 2:
        failures.append("%s: schema_version %d" % (name, document["schema_version"]))

# The claim's own record, against the pack document `main --pack` wrote (section 4.1,
# *Construction*): the arm reads the decoded `PackMember` and decodes nothing a second time.
for name, block, position in (("olmoe-expert-claim", FIRST_EXPERT, 0),
                              ("olmoe-expert-claim-last", LAST_EXPERT, 0),
                              ("olmoe-dense-member", FIRST_DENSE, FIRST_DENSE_MEMBER)):
    document = json.loads(produced[name])
    member = block["members"][position]
    for field, got, want in (
            ("kind", document["selection"]["kind"], block["kind"]),
            ("name", document["selection"]["name"], member["name"]),
            ("role_id", document["selection"]["role_id"], member["role_id"]),
            ("n_dims", document["tensor"]["n_dims"], member["n_dims"]),
            ("ne0", document["tensor"]["ne0"], member["dims"][0]),
            ("ne1", document["tensor"]["ne1"], member["dims"][1]),
            ("nbytes", document["tensor"]["nbytes"], member["nbytes"]),
            ("slice_index", document["tensor"]["slice_index"], member["slice_index"]),
            ("slice_count", document["tensor"]["slice_count"], member["slice_count"]),
            ("interior_offset", document["buffer"]["interior_offset"],
             member["pack_offset"] - block["pack_offset"])):
        if got != want:
            failures.append("%s: %s is %r, the pack document says %r" % (name, field, got, want))

# Section 4.3's summary cell, as exact lines: the block is read positionally, so `slice:` must be
# the line after `dims:` and must carry the pair, or `-` for a whole-tensor member.
for name, operands, expected in (
        ("olmoe-expert-claim", FIRST_EXPERT_OPERANDS,
         "%d/%d" % (FIRST_EXPERT["members"][0]["slice_index"],
                    FIRST_EXPERT["members"][0]["slice_count"])),
        ("olmoe-dense-member",
         [OLMOE_PACK, str(FIRST_DENSE["index"]), str(FIRST_DENSE_MEMBER)], "-")):
    summary_path = os.path.join(work_dir, "%s-summary.json" % name)
    lines = run(list(operands) + [summary_path]).stdout.decode("utf-8").splitlines()
    if "slice:" not in lines:
        failures.append("%s: the summary block has no `slice:` line" % name)
    else:
        at = lines.index("slice:")
        if lines[at - 2] != "dims:":
            failures.append("%s: `slice:` does not follow the `dims:` value" % name)
        if lines[at + 1] != expected:
            failures.append("%s: summary slice is %r, expected %r"
                            % (name, lines[at + 1], expected))

# Section 4.6's cross-implementation cell: the standalone reader decodes the same pair for **every**
# member of the packed olmoe container, not only the ones a case selects.
olmoe_independent = alignpack_reader.Pack(OLMOE_PACK)
try:
    if len(olmoe_independent.members) != len(olmoe_members):
        failures.append("olmoe-reader-agreement: %d members, the pack document says %d"
                        % (len(olmoe_independent.members), len(olmoe_members)))
    else:
        for position, (theirs, ours) in enumerate(zip(olmoe_independent.members, olmoe_members)):
            got = (theirs["slice_index"], theirs["slice_count"])
            want = (ours["slice_index"], ours["slice_count"])
            if got != want:
                failures.append("olmoe-reader-agreement: member %d python %r, align %r"
                                % (position, got, want))
finally:
    olmoe_independent.close()

# ---- the qualification's selection rule, hosted (section 4.5) ---------------------------------
#
# `scripts/run-ggml-spike` refuses before its selection on any host without ggml, which is why the
# rule lives in `scripts/ggml_spike_select.py` and is exercised here, over pack documents rather
# than over a copy of the logic.
selector = os.path.join(root_dir, "scripts", "ggml_spike_select.py")


OWN_SOURCE = object()


def selection_document(name, blocks, source=OWN_SOURCE):
    """A pack document for the selector. `source=None` writes one with **no** `source` object."""
    path = os.path.join(work_dir, "selection-%s.json" % name)
    document = {"blocks": blocks}
    if source is OWN_SOURCE:
        document["source"] = olmoe_document["source"]
    elif source is not None:
        document["source"] = source
    with open(path, "w", encoding="utf-8") as handle:
        json.dump(document, handle)
    return path


def run_selector(path):
    return subprocess.run([sys.executable, selector, path], capture_output=True, cwd=work_dir)

# Construction: the real olmoe document resolves both arms by `role_id`.
chosen = run_selector(OLMOE_PACK_DOCUMENT)
if chosen.returncode != 0:
    failures.append("selection-olmoe: exited %d: %s"
                    % (chosen.returncode, chosen.stderr.decode("utf-8", "replace")[-200:]))
else:
    selection = json.loads(chosen.stdout.decode("utf-8"))
    if selection["dense"] != {"block": FIRST_DENSE["index"], "member": FIRST_DENSE_MEMBER}:
        failures.append("selection-olmoe: dense arm is %r" % (selection["dense"],))
    if selection["expert"] != {"block": FIRST_EXPERT["index"],
                               "members": list(range(len(FIRST_EXPERT["members"]))),
                               "last_block": olmoe_experts[-1]["index"]}:
        failures.append("selection-olmoe: expert arm is %r" % (selection["expert"],))
    elif olmoe_experts[-1]["members"][0]["slice_index"] < 1:
        # The whole reason the last block is selected: it is the plane the first block cannot give.
        failures.append("selection-olmoe: the last ExpertBlock's member 0 is plane %r"
                        % (olmoe_experts[-1]["members"][0]["slice_index"],))
    if selection["identity"] != olmoe_document["source"]["header_region_sha256"]:
        failures.append("selection-olmoe: identity is %r" % selection["identity"])

# `last_block` is the plane index the first `ExpertBlock` cannot give: every member of that block is
# plane 0, so without a second block the real-model arm never addresses a `slice_index > 0` interior
# (section 5.4). A container with exactly one `ExpertBlock` reports `None` rather than repeating the
# first arm's block.
single_expert = run_selector(selection_document(
    "single-expert",
    [entry for entry in olmoe_blocks if entry["kind"] != "ExpertBlock"]
    + [entry for entry in olmoe_blocks if entry["kind"] == "ExpertBlock"][:1]))
if single_expert.returncode != 0:
    failures.append("selection-single-expert: exited %d" % single_expert.returncode)
else:
    only = json.loads(single_expert.stdout.decode("utf-8"))["expert"]
    if only["last_block"] is not None:
        failures.append("selection-single-expert: last_block is %r for one ExpertBlock"
                        % (only["last_block"],))

# Early exit: a model with no `ExpertBlock` is a legitimate shape — the dense arm still runs and
# the expert arm is absent, which is the `N/A` line rather than a failure.
dense_only = run_selector(selection_document(
    "dense-only", [entry for entry in olmoe_blocks if entry["kind"] != "ExpertBlock"]))
if dense_only.returncode != 0:
    failures.append("selection-dense-only: exited %d" % dense_only.returncode)
elif json.loads(dense_only.stdout.decode("utf-8"))["expert"] is not None:
    failures.append("selection-dense-only: an expert arm was selected from a dense document")

# Failure: no `AttentionBlock` at all is a `FAIL`, named, because every architecture this repository
# supports has one.
no_attention = run_selector(selection_document(
    "no-attention", [entry for entry in olmoe_blocks if entry["kind"] != "AttentionBlock"]))
if no_attention.returncode == 0:
    failures.append("selection-no-attention: exited 0 on a document with no AttentionBlock")
elif b"AttentionBlock" not in no_attention.stderr:
    failures.append("selection-no-attention: the failure does not name the missing block: %r"
                    % no_attention.stderr.decode("utf-8", "replace")[-200:])

# Malformed input: a pack document missing a field the rule reads is a producer defect, and it must
# leave one `FAIL` line naming the field rather than a `KeyError` traceback an operator has to
# decode. Three shapes, one per level the selector descends: the document, a block, and `source`.
for label, blocks, source in (
        ("no-blocks", None, OWN_SOURCE),
        ("block-without-kind", [{"index": 0, "members": []}], OWN_SOURCE),
        ("no-source", olmoe_blocks, None)):
    path = os.path.join(work_dir, "selection-%s.json" % label)
    with open(path, "w", encoding="utf-8") as handle:
        document = {} if blocks is None else {"blocks": blocks}
        if source is OWN_SOURCE:
            document["source"] = olmoe_document["source"]
        json.dump(document, handle)
    malformed = run_selector(path)
    text = malformed.stderr.decode("utf-8", "replace")
    if malformed.returncode == 0:
        failures.append("selection-%s: exited 0 on a malformed pack document" % label)
    elif "Traceback" in text or "ggml spike qualification: FAIL" not in text:
        failures.append("selection-%s: the refusal is not a named FAIL: %r" % (label, text[-300:]))

# Both output forms must emit byte-identical document bytes (section 3.3).
document_path = os.path.join(work_dir, "spike.json")
stdout_form = run([PACK, "1", "1"]).stdout.decode("utf-8").rstrip("\n")
run([PACK, "1", "1", document_path])
with open(document_path, "r", encoding="utf-8") as handle:
    file_form = handle.read()
if normalize(stdout_form) != normalize(file_form):
    failures.append("the stdout and file forms differ")

# The `-` fourth operand is the machine form: the document alone, no summary block.
dash_form = run([PACK, "1", "1", "-"]).stdout.decode("utf-8").rstrip("\n")
if normalize(dash_form) != normalize(stdout_form):
    failures.append("the `-` form differs from the three-operand form")

# Section 3.5's two-decoders guard: the Align reader's decoded header, block record, and member
# record against `scripts/alignpack_reader.py`, which shares no code with either Align decoder.
independent = alignpack_reader.Pack(PACK)
try:
    mine = json.loads(produced["spike-stub-unavailable"])
    header = independent.header
    block = independent.blocks[1]
    member = independent.members[2]
    parity = [
        ("format_version", mine["pack"]["format_version"], header["format_version"]),
        ("block_align", mine["pack"]["block_align"], header["block_align"]),
        ("member_align", mine["pack"]["member_align"], header["member_align"]),
        ("block_count", mine["pack"]["block_count"], header["block_count"]),
        ("member_count", mine["pack"]["member_count"], header["member_count"]),
        ("total_bytes", mine["pack"]["total_bytes"], header["total_bytes"]),
        ("payload_offset", mine["pack"]["payload_offset"], header["payload_offset"]),
        ("block.pack_offset", mine["buffer"]["block_pack_offset"], block["pack_offset"]),
        ("block.pack_bytes", mine["buffer"]["block_pack_bytes"], block["pack_bytes"]),
        ("block.layer", mine["selection"]["layer"], block["layer"]),
        ("block.expert", mine["selection"]["expert"], block["expert"]),
        ("block.kind", mine["selection"]["kind"],
         alignpack_reader.BLOCK_KINDS[block["kind"]].replace("WeightBlock", "Weight")),
        ("member.index_global", mine["selection"]["member_index_global"], member["index"]),
        ("member.name", mine["selection"]["name"], member["name"]),
        ("member.role_id", mine["selection"]["role_id"], member["role_id"]),
        ("member.pack_offset", mine["buffer"]["member_pack_offset"], member["pack_offset"]),
        ("member.nbytes", mine["tensor"]["nbytes"], member["nbytes"]),
        ("member.ggml_type", mine["tensor"]["ggml_type"], member["ggml_type"]),
        ("member.n_dims", mine["tensor"]["n_dims"], member["n_dims"]),
        ("member.ne0", mine["tensor"]["ne0"], member["dims"][0]),
        ("member.ne1", mine["tensor"]["ne1"], member["dims"][1]),
        ("member.slice_index", mine["tensor"]["slice_index"], member["slice_index"]),
        ("member.slice_count", mine["tensor"]["slice_count"], member["slice_count"]),
        ("interior_offset", mine["buffer"]["interior_offset"],
         member["pack_offset"] - block["pack_offset"]),
    ]
    for field, got, want in parity:
        if got != want:
            failures.append("reader parity %s: align %r, python %r" % (field, got, want))
finally:
    independent.close()

# The pack-len-mismatch container must be refused before a single table byte is read.
len_mismatch = json.loads(produced["pack-len-mismatch"])
if len_mismatch["pack"]["reader_pread_count"] != 1:
    failures.append("pack-len-mismatch read the tables: %d preads"
                    % len_mismatch["pack"]["reader_pread_count"])

if update:
    with open(golden_path, "w", encoding="utf-8") as handle:
        for name, _ in CASES:
            handle.write(json.dumps({"case": name, "document": produced[name]},
                                    separators=(",", ":"), ensure_ascii=False) + "\n")
    print("ggml spike smoke: golden rewritten with %d cases" % len(produced))
else:
    with open(golden_path, "r", encoding="utf-8") as handle:
        golden = [json.loads(line) for line in handle if line.strip()]
    if [row["case"] for row in golden] != [name for name, _ in CASES]:
        failures.append("the golden case list does not match the runner's case list")
    else:
        for row in golden:
            if produced.get(row["case"]) != row["document"]:
                failures.append("golden mismatch for %s:\n  expected %s\n  actual   %s"
                                % (row["case"], row["document"], produced.get(row["case"])))

if failures:
    for line in failures:
        sys.stderr.write("ggml spike smoke: FAIL %s\n" % line)
    raise SystemExit(1)

print("ggml spike smoke: %d no-document cases, %d documented cases, reader parity, "
      "shared shim contract, and lifetime PASS" % (len(NO_DOCUMENT), len(CASES)))
print("ggml spike smoke: olmoe %d blocks / %d members packed and verified, %d ExpertBlocks, "
      "n_expert %d, claim surface PASS"
      % (len(olmoe_blocks), len(olmoe_members), len(olmoe_experts), N_EXPERT))
PY
