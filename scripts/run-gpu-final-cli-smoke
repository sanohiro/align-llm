#!/usr/bin/env python3
"""Run real final CLI admission, failed preparation, publication and independent replay."""
import importlib.machinery
import json
import pathlib
import shutil
import subprocess
import tempfile
from unittest import mock
import gpu_qualification_main as qualification_main
import gpu_qualification_publish as publication

import gpu_backend_recipe as recipe
from gpu_qualification_cli import Arguments
from gpu_qualification_main import qualify
from gpu_qualification_records import replay_evidence_directory

ROOT = pathlib.Path(__file__).resolve().parent.parent
fixture = importlib.machinery.SourceFileLoader("final_cli_fixture",
    str(ROOT / "scripts/run-gpu-input-admission-smoke")).load_module()


with tempfile.TemporaryDirectory(prefix="gpu-final-cli-") as raw:
    root = pathlib.Path(raw).resolve()
    source = root / "repository"
    source.mkdir()
    (source / "scripts").mkdir()
    for path in (ROOT / "scripts").glob("gpu_*.py"):
        shutil.copyfile(path, source / "scripts" / path.name)
    launcher = ROOT / "scripts/gpu-runtime-qualify"
    shutil.copyfile(launcher, source / "scripts" / launcher.name)
    (source / "scripts" / launcher.name).chmod(0o755)
    shutil.copyfile(ROOT / ".align-revision", source / ".align-revision")
    # A real complete source closure can exceed the former 4096-file evidence limit.
    (source / "closure").mkdir()
    for index in range(4100):
        (source / "closure" / f"{index:04d}.txt").write_text(f"source blob {index}\n")
    git = shutil.which("git")
    environment = {"HOME": str(root), "LC_ALL": "C", "TMPDIR": str(root), "TZ": "UTC"}
    def run(*args):
        return subprocess.run([git, *recipe.GIT_SAFE_OPTIONS, *args], cwd=source, env=environment,
                              check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE).stdout
    run("init", "-q")
    run("config", "user.name", "Qualifier Fixture")
    run("config", "user.email", "qualifier@example.invalid")
    run("remote", "add", "origin", recipe.SOURCE_REPOSITORIES["align-llm"])
    run("add", ".")
    run("-c", "commit.gpgsign=false", "commit", "-qm", "fixture")
    commit = run("rev-parse", "HEAD").decode().strip()
    manifest, raw_manifest, raw_commit, blobs = recipe.source_snapshot(
        source, git, environment, source_kind="align-llm", commit=commit)
    inputs = root / "inputs"
    inputs.mkdir()
    fixture.materialize(inputs)
    shutil.rmtree(inputs / "source/align-llm")
    recipe.write_source_snapshot(inputs / "source/align-llm", manifest, raw_manifest, raw_commit, blobs, "align-llm")
    profile = json.loads((inputs / "profile.json").read_bytes())
    profile["source"] = {"commit": commit, "manifest_sha256": recipe.digest(raw_manifest)}
    profile["deadlines_ns"]["preparation"] = 30_000_000_000
    (inputs / "profile.json").write_bytes(recipe.canonical(profile))
    output = root / "evidence"
    arguments = Arguments(inputs / "profile.json", "generation", output)
    with mock.patch.object(publication, "MAX_EVIDENCE_FILES", 1),             mock.patch.object(qualification_main, "prepare_invocation") as preparation:
        try:
            qualify(arguments, launcher=launcher)
        except recipe.RecipeError as error:
            assert "projection cannot fit" in str(error)
        else:
            raise AssertionError("oversize closure reached preparation")
        preparation.assert_not_called()
    assert not output.exists() and not list(root.glob(".evidence.invoke-*"))
    # The fixture bundle has deliberately uninstalled toolchain identities. Actual host
    # admission must stop before compiler construction and still publish replayable FAIL.
    assert qualify(arguments, launcher=launcher) == "FAIL"
    replayed = replay_evidence_directory(output)["evidence"]
    assert len(replayed["files"]) > 4096
    assert replayed["failure"]["stage"] == "compiler" and replayed["failure"]["category"] == "PREPARATION"
    assert replayed["cases"] == [] and replayed["preparation_commands"] == []
    assert replayed["host"]["cpu"] != "fixture" and replayed["host"]["host_total_bytes"] > 1
    assert replayed["host"]["device_state"] == "unavailable"
    assert replayed["cleanup"]["source_unchanged"] and replayed["cleanup"]["owned_paths_removed"]
    assert not list(root.glob(".evidence.invoke-*")) and not list(root.glob(".evidence.stage-*"))
    public_output = root / "public-evidence"
    public = subprocess.run([str(launcher), "--profile", str(arguments.profile), "--suite", "generation",
                             "--output", str(public_output)], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    assert public.returncode == 1 and public.stdout == b"gpu-runtime-qualify: FAIL\n", public.stderr
    assert replay_evidence_directory(public_output)["evidence"]["failure"]["stage"] == "compiler"
    original = (output / "result.json").read_bytes()
    try:
        qualify(arguments, launcher=launcher)
    except recipe.RecipeError:
        pass
    else:
        raise AssertionError("occupied evidence output was replaced")
    assert (output / "result.json").read_bytes() == original
    wrong_launcher = root / launcher.name
    wrong_launcher.write_bytes(b"different launcher\n")
    try:
        qualify(Arguments(arguments.profile, arguments.suite, root / "wrong"), launcher=wrong_launcher)
    except recipe.RecipeError as error:
        assert "helper differs" in str(error)
    else:
        raise AssertionError("unbound qualifier source was accepted")
    assert not (root / "wrong").exists() and not list(root.glob(".wrong.invoke-*"))
print("gpu-final-cli: PASS (real source binding, host discovery, failed preparation, publication/replay)")
