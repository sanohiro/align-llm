#!/usr/bin/env bash

set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
compiler="${ALIGNC:-${project_root}/scripts/alignc}"
output_file="$(mktemp)"
trap 'rm -f "${output_file}"' EXIT

"${compiler}" run "${project_root}/src/prompt_model_smoke.align" >"${output_file}"

python3 - "${output_file}" <<'PY'
import hashlib
import json
import sys
from pathlib import Path

actual = [json.loads(line) for line in Path(sys.argv[1]).read_text(encoding="utf-8").splitlines()]
names = [row["case_name"] for row in actual]
expected_names = [
    "baseline",
    "bounded",
    "invalid-policy",
    "oversized-source",
    "oversized-learned",
]
if names != expected_names:
    raise SystemExit(f"unexpected smoke cases: {names!r}")


def bounded(value: str, limit: int, marker: str) -> str:
    raw = value.encode()
    suffix = marker.encode()
    if limit <= 0 or len(raw) <= limit:
        return "" if limit <= 0 else value
    if len(suffix) > limit:
        return ""
    return raw[: limit - len(suffix)].decode("utf-8", errors="ignore") + marker


def render(
    base: str,
    repo: str,
    task: str,
    learned: str,
    patch: str,
    stdout: str,
    stderr: str,
    include_patch: bool,
    include_diagnostics: bool,
    patch_limit: int,
    diagnostic_limit: int,
) -> str:
    parts = [base, "\n\n--- repo prompt ---\n", repo, "\n\n--- task prompt ---\n", task]
    parts += ["\n\n--- learned prompt append ---\n", learned or "(none)"]
    parts += ["\n\n--- patch evaluation context ---\n"]
    parts += [bounded(patch, patch_limit, "\n[context truncated]") if include_patch else "(omitted)"]
    parts += ["\n\n--- failure memory context ---\n", "(omitted)"]
    parts += ["\n\n--- current failure diagnostics ---\n"]
    if include_diagnostics:
        parts += ["stdout:\n", bounded(stdout, diagnostic_limit, "\n[output truncated]")]
        parts += ["\nstderr:\n", bounded(stderr, diagnostic_limit, "\n[output truncated]")]
    else:
        parts += ["(omitted)"]
    return "".join(parts)


def row(name: str, status: str, text: str) -> dict[str, str]:
    return {
        "case_name": name,
        "status": status,
        "text": text,
        "sha256": hashlib.sha256(text.encode()).hexdigest() if text else "",
    }


expected = [
    row(
        "baseline",
        "VALID",
        render("BASE", "REPO", "TASK", "", "ignored", "stdout", "stderr", False, False, 0, 0),
    ),
    row(
        "bounded",
        "VALID",
        render(
            "BASE",
            "REPO",
            "TASK",
            "learned",
            "é🙂abcdefghijklmnopqrstuvwxyz",
            "é🙂stdout",
            "stderr-output-0123456789",
            True,
            True,
            24,
            23,
        ),
    ),
    {"case_name": "invalid-policy", "status": "INVALID_INPUT", "text": "", "sha256": ""},
    {"case_name": "oversized-source", "status": "INVALID_INPUT", "text": "", "sha256": ""},
    {"case_name": "oversized-learned", "status": "INVALID_INPUT", "text": "", "sha256": ""},
]

if actual != expected:
    raise SystemExit(f"prompt model smoke mismatch:\nexpected={expected!r}\nactual={actual!r}")
print("prompt model smoke: hierarchy, UTF-8 bounds, source validation, and SHA-256 PASS")
PY
