#!/usr/bin/env python3
"""Execute the frozen first resident session campaign in gpu-runtime-performance.md §6.1."""
from __future__ import annotations
import argparse
from contextlib import contextmanager
import hashlib
import http.client
import importlib.util
from importlib.machinery import SourceFileLoader
import json
import math
import os
from pathlib import Path
import platform
import signal
import shutil
import socket
import statistics
import subprocess
import tempfile
import threading
import time

from gpu_independent_acceptance import verify_build, source_files
from gpu_qualification_input import admit
from gpu_qualification_host_observation import observe_host
from gpu_session_client import Session, SessionError, qualification_environment

ROOT = Path(__file__).resolve().parent.parent
PIN = 'bb4caa7540188872173c44d161602d9271386413'
CURRENT = '304665fe7ac957df95e3ff8c8c4ffdf92dd6ffa3'
CANDIDATE = '12a633d5fe60c3c3f853203c452754a695d908dd'
CUDA_CANDIDATE = '688232c665aafca3cdff940e9e34eac5c7f0509e'
ORDER = [('candidate','same','current'), ('same','current','candidate'),
         ('current','candidate','same'), ('current','same','candidate'), ('candidate','current','same')]
SYSTEM = 'You are a helpful assistant. Follow the output format exactly.'
SHORT = 'List the integers from 1 through 500 in ascending order, separated by single spaces. Output only the integers.'
LONG = 'Repository context (irrelevant to this formatting task):\n' + 'alpha beta gamma delta\n' * 128 + '\n' + SHORT
CASES = [('cold-short', SHORT), ('warm-short-cached', SHORT), ('warm-long-changed', LONG), ('warm-long-cached', LONG)]
LOG_LIMIT = 16 * 1024 * 1024
loader = SourceFileLoader('session_measurement_coding', str(ROOT / 'scripts/run-gpu-session-coding'))
spec = importlib.util.spec_from_loader(loader.name, loader)
coding = importlib.util.module_from_spec(spec)
spec.loader.exec_module(coding)
base = coding.base


def digest(path):
    with Path(path).open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def remaining(deadline, maximum=300):
    value = min(maximum, deadline - time.monotonic())
    if value <= 0:
        raise TimeoutError('campaign deadline exhausted')
    return value


def quality(result):
    if result['completion_tokens'] != 128:
        return False
    values = result['output'].strip().split()
    if values and values[-1] != str(len(values)) and str(len(values)).startswith(values[-1]):
        values.pop()
    return len(values) >= 16 and all(value == str(index) for index, value in enumerate(values, 1))


def comparison(arms, model, case, reference):
    reductions = []
    for repeat in range(5):
        selected = [row for row in arms if row['model'] == model and row['repeat'] == repeat
                    and row['system'] in ('candidate', reference)]
        if len(selected) != 2 or {row['system'] for row in selected} != {'candidate', reference}:
            return dict(decision='invalid_quality', paired_reductions=[])
        values = {}
        for arm in selected:
            rows = [row for row in arm['runtime'] if row['case'] == case]
            if len(rows) != 1 or not rows[0]['quality'] or arm['status'] != 'PASS' or rows[0]['elapsed_ns'] <= 0:
                return dict(decision='invalid_quality', paired_reductions=[])
            values[arm['system']] = rows[0]['elapsed_ns']
        reductions.append((values[reference] - values['candidate']) / values[reference])
    median = statistics.median(reductions)
    met = median >= .15 and sum(value > 0 for value in reductions) >= 4
    return dict(decision='met' if met else 'not_met', median_paired_reduction=median,
                paired_reductions=reductions)


def internal_elapsed_ns(result, system):
    if system == 'candidate':
        value = result.get('elapsed_ns')
        if type(value) is not int or value <= 0:
            raise ValueError('invalid candidate internal clock')
        return value
    if system not in ('same', 'current'):
        raise ValueError('unknown internal clock producer')
    timings = result.get('timings')
    if not isinstance(timings, dict):
        raise ValueError('baseline internal timings missing')
    values = [timings.get(key) for key in ('prompt_ms', 'predicted_ms')]
    if any(type(value) not in (int, float) or not math.isfinite(value) or value < 0 for value in values):
        raise ValueError('invalid baseline internal clock')
    total = sum(values) * 1_000_000
    if not math.isfinite(total) or total < 1:
        raise ValueError('invalid baseline internal clock total')
    return round(total)


def final_cuda(args):
    return args.campaign == 'cuda-final'


def coding_clock(args):
    return 'processing_to_passing_patch_ns' if final_cuda(args) else 'time_to_passing_patch_ns'


def baseline_identity(executable, revision, backend):
    executable = executable.resolve(strict=True)
    if executable.name != 'llama-server':
        raise ValueError('baseline must be the ordinary llama-server executable')
    build = executable.parent.parent
    cache_path = build / 'CMakeCache.txt'
    cache = {}
    for line in cache_path.read_text().splitlines():
        if line and not line.startswith(('#','//')) and ':' in line and '=' in line:
            key, value = line.split('=', 1)
            cache[key.split(':', 1)[0]] = value
    source = Path(cache['CMAKE_HOME_DIRECTORY'])
    actual = subprocess.check_output(['git','-C',str(source),'rev-parse','HEAD'], text=True).strip()
    if actual != revision or subprocess.check_output(['git','-C',str(source),'status','--porcelain']):
        raise ValueError('baseline checkout must be clean at its frozen upstream revision')
    expected = {'CMAKE_BUILD_TYPE':'Release', 'GGML_CPU':'ON', 'GGML_'+backend.upper():'ON'}
    if any(cache.get(key) != value for key,value in expected.items()):
        raise ValueError('baseline CMake configuration does not match the campaign')
    files = {path.name:digest(path) for path in sorted(executable.parent.iterdir())
             if path.is_file() and (path.name == 'llama-server' or '.dylib' in path.name or '.so' in path.name)}
    return dict(source_commit=actual, executable=str(executable), cmake_cache_sha256=digest(cache_path), files=files)


def host_identity(bundle, option, deadline):
    with tempfile.TemporaryDirectory(prefix='gpu-measure-host-') as temporary:
        environment = qualification_environment(Path(temporary))
        def probe(command, *arguments):
            executable = shutil.which(command)
            if executable is None: raise ValueError('host observation tool is absent: '+command)
            result = subprocess.run([executable,*arguments],env=environment,capture_output=True,
                check=True,timeout=remaining(deadline,30))
            if len(result.stdout)>65536: raise ValueError('host observation exceeds its bound')
            return result.stdout.decode().strip()
        expected_platform = 'wsl2' if 'microsoft' in platform.release().lower() else bundle['target']['os']
        host = observe_host(expected_platform=expected_platform,backend=option['backend'],
            probe=probe,deadline_ns=time.monotonic_ns()+int(remaining(deadline)*1e9))
        host = {key:host[key] for key in ('platform','os_version','kernel','arch','wsl','cpu',
            'logical_cpus','host_total_bytes','host_free_bytes')}
        if option['backend']=='metal':
            inventory = json.loads(probe('/usr/sbin/system_profiler','SPDisplaysDataType','-json'))
        else:
            inventory = probe('nvidia-smi','--query-gpu=index,pci.bus_id,name,memory.total,driver_version,compute_cap',
                              '--format=csv,noheader,nounits')
        return dict(**host,selected_device=option['device'],gpu_inventory=inventory,
                    unified_memory=option['backend']=='metal')


def decode_response(raw):
    def fields(pairs):
        result = {}
        for key,value in pairs:
            if key in result: raise ValueError('duplicate server response field')
            result[key] = value
        return result
    def nonfinite(_): raise ValueError('nonfinite server response')
    return json.loads(raw, object_pairs_hook=fields, parse_constant=nonfinite)


class Server:
    def __init__(self, executable, model, option, precision, work, deadline, *, internal_timing=False):
        self.internal_timing = internal_timing
        self.deadline = deadline
        self.log = (work / 'server.log').open('w+b')
        with socket.socket() as reservation:
            reservation.bind(('127.0.0.1',0))
            port = reservation.getsockname()[1]
        self.endpoint = f'http://127.0.0.1:{port}'
        self.port = port
        self.alias = 'g1r-measurement'
        self.command = [str(executable), '-m', str(model), '--alias', self.alias, '--host', '127.0.0.1',
            '--port', str(port), '-ngl', '999', '--device', option['device'], '-c', '2304', '-b', '2048',
            '-ub', '128', '-t', '4', '-tb', '4', '-np', '1', '-fa', 'on',
            '--cache-type-k', precision, '--cache-type-v', precision, '--no-warmup', '--no-context-shift']
        try:
            self.process = subprocess.Popen(self.command, stdin=subprocess.DEVNULL, stdout=self.log, stderr=self.log,
                env=qualification_environment(work), start_new_session=True)
        except BaseException:
            self.log.close()
            raise
        try:
            ready_deadline = time.monotonic() + remaining(deadline)
            while True:
                if self.process.poll() is not None: raise SessionError('baseline exited before readiness')
                try:
                    self.http('/health', None, remaining(ready_deadline,2))
                    break
                except (OSError, http.client.HTTPException):
                    remaining(ready_deadline)
                    time.sleep(.1)
        except BaseException:
            self.close(check=False)
            with (work/'server.log').open('rb') as stream:
                (work/'worker.log').write_bytes(stream.read(LOG_LIMIT))
            (work/'server.log').unlink()
            raise

    def http(self, route, payload, timeout):
        data = None if payload is None else json.dumps(payload, allow_nan=False).encode()
        deadline = time.monotonic()+timeout
        connection = http.client.HTTPConnection('127.0.0.1',self.port,timeout=timeout)
        timer = None
        try:
            connection.connect()
            active_socket = connection.sock
            def expire():
                try: active_socket.shutdown(socket.SHUT_RDWR)
                except OSError: pass
            timer = threading.Timer(remaining(deadline),expire)
            timer.daemon = True
            timer.start()
            connection.request('GET' if payload is None else 'POST',route,body=data,
                headers={'Content-Type':'application/json'})
            response = connection.getresponse()
            if response.status != 200: raise ConnectionError(f'baseline HTTP status {response.status}')
            raw = response.read(2097153)
        finally:
            if timer is not None:
                timer.cancel()
                timer.join()
            connection.close()
        if len(raw) > 2097152: raise ValueError('baseline response limit exceeded')
        return decode_response(raw)

    def generate(self, request):
        response = self.http('/v1/chat/completions', dict(model=self.alias,
            messages=[dict(role='system',content=request['system']),dict(role='user',content=request['user'])],
            max_tokens=request['max_tokens'], temperature=request['temperature'],
            seed=request['seed'] if request['seed'] is not None else 0,
            top_k=40, top_p=.95, min_p=.05, repeat_penalty=1.0, presence_penalty=0.0,
            frequency_penalty=0.0, samplers=['top_k','top_p','min_p','temperature'],
            cache_prompt=True, stream=False), remaining(self.deadline))
        if not isinstance(response,dict): raise ValueError('invalid baseline response envelope')
        choices, usage = response.get('choices'), response.get('usage')
        if not isinstance(choices,list) or len(choices) != 1 or not isinstance(usage,dict):
            raise ValueError('invalid baseline completion response')
        if not isinstance(choices[0],dict) or not isinstance(choices[0].get('message'),dict):
            raise ValueError('invalid baseline message')
        output = choices[0]['message'].get('content')
        if not isinstance(output,str) or len(output.encode()) > 262144:
            raise ValueError('invalid baseline output')
        for key in ('prompt_tokens','completion_tokens','total_tokens'):
            if type(usage.get(key)) is not int or usage[key] < 0:
                raise ValueError('invalid baseline token count')
        if usage['total_tokens'] != usage['prompt_tokens'] + usage['completion_tokens']:
            raise ValueError('inconsistent baseline token count')
        result = dict(output=output, prompt_tokens=usage['prompt_tokens'], completion_tokens=usage['completion_tokens'])
        if self.internal_timing:
            result['timings'] = response.get('timings')
            internal_elapsed_ns(result, 'same')
        return result

    def close(self, *, check=True):
        forced = False
        try:
            if self.process.poll() is None:
                os.killpg(self.process.pid, signal.SIGTERM)
            try:
                self.process.wait(timeout=10)
            except subprocess.TimeoutExpired:
                forced = True
                os.killpg(self.process.pid, signal.SIGKILL)
                self.process.wait(timeout=5)
            if check and (forced or self.process.returncode not in (0,-signal.SIGTERM)):
                raise SessionError('baseline did not shut down normally')
        finally:
            try: os.killpg(self.process.pid, signal.SIGKILL)
            except ProcessLookupError: pass
            self.log.close()


@contextmanager
def service(system, args, model, options_path, option, work, deadline):
    work.mkdir()
    if system == 'candidate':
        command = [str(args.runtime), '--runtime-session', str(model['model_path']), str(model['pack_path']),
                   str(model['geometry_path']), str(options_path), str(model['runtime_cache_budget_bytes'])]
        worker = Session(command, timeout=remaining(deadline), env=qualification_environment(work))
        worker.command = command
    else:
        worker = Server(getattr(args, system+'_server'), model['model_path'], option,
                        'f32' if system == 'same' else 'f16', work, deadline, internal_timing=final_cuda(args))
    retained_log = os.fdopen(os.dup(worker.log.fileno()),'rb')
    normal = False
    try:
        yield worker
        normal = True
    finally:
        try:
            worker.close(check=normal)
        finally:
            with retained_log:
                retained_log.seek(0)
                log = retained_log.read(LOG_LIMIT+1)
            (work / 'worker.log').write_bytes(log[:LOG_LIMIT])
            (work / 'server.log').unlink(missing_ok=True)
            if len(log) > LOG_LIMIT: raise ValueError('arm log limit exceeded')


def runtime_sequence(system, args, model, options_path, option, work, deadline, row):
    started = time.monotonic_ns()
    with service(system,args,model,options_path,option,work,deadline) as worker:
        row['startup_ns'] = time.monotonic_ns()-started
        row['runtime_command'] = worker.command
        for index,(name,user) in enumerate(CASES):
            request = dict(schema_version=1,system=SYSTEM,user=user,max_tokens=128,temperature=0.0,seed=None)
            before = started if index == 0 else time.monotonic_ns()
            if system == 'candidate': worker.timeout = remaining(deadline)
            result = worker.generate(request)
            elapsed = internal_elapsed_ns(result, system) if final_cuda(args) else time.monotonic_ns()-before
            row['runtime'].append(dict(case=name,elapsed_ns=elapsed,quality=quality(result),result=result))


def coding_portfolio(system, args, model, options_path, option, work, deadline, row, validator):
    started = time.monotonic_ns()
    previous,feedback = None,''
    processing_ns = 0
    with service(system,args,model,options_path,option,work,deadline) as worker:
        row['coding_command'] = worker.command
        for index in range(1,9):
            request = dict(schema_version=1,system='',user=base.PROMPT_TEXT if previous is None else coding.repair_prompt(previous,feedback),
                max_tokens=128,temperature=.3 if model['model_id']=='olmoe' else 0.0,
                seed=index if model['model_id']=='olmoe' else None)
            if system == 'candidate': worker.timeout = remaining(deadline)
            result = worker.generate(request)
            if final_cuda(args): processing_ns += internal_elapsed_ns(result, system)
            previous = result['output']
            feedback = 'The completion is not the complete fixed-task diff.'
            if result['completion_tokens'] == 128: feedback += ' The response reached its 128 output-token limit.'
            passed,validation_ns = False,0
            try: patch_text = base.extract_patch(previous)
            except base.DecisionError: patch_text = None
            if patch_text is not None:
                patch_path = work / f'attempt-{index}.patch'
                patch_path.write_text(patch_text)
                passed,validation_ns,feedback = base.validate_patch_details(patch_path,work,deadline,validator)
            if final_cuda(args): processing_ns += validation_ns
            row['coding']['attempts'].append(dict(index=index,seed=request['seed'],passed=passed,
                result=result,feedback=feedback,validation_ns=validation_ns))
            if passed:
                row['coding'].update(passed=True, **{coding_clock(args): processing_ns if final_cuda(args) else time.monotonic_ns()-started})
                break


def run(args):
    started = time.monotonic_ns()
    deadline = time.monotonic()+7200
    admitted = admit(args.profile.resolve(strict=True))
    profile = admitted.records['profile']
    if len(profile['models']) != 2 or {row['model_id'] for row in profile['models']} != {'qwen2','olmoe'}:
        raise ValueError('campaign requires exactly both models')
    if len(profile['runtime_options']) != 1:
        raise ValueError('campaign requires one resident option')
    option = {key:value for key,value in profile['runtime_options'][0].items() if key!='option_id'}
    if option['placement'] != 'resident' or option['prefetch'] != 'off': raise ValueError('unsupported campaign option')
    if final_cuda(args) and option['backend'] != 'cuda': raise ValueError('cuda-final requires CUDA')
    nomination = CUDA_CANDIDATE if final_cuda(args) else CANDIDATE
    if option['host_budget_bytes'] < 1073741824 or option['device_budget_bytes'] < 6000000000:
        raise ValueError('profile cannot admit the frozen resident memory ceilings')
    if any(row['runtime_cache_budget_bytes']>1073741824 for row in profile['models']):
        raise ValueError('legacy cache ceiling exceeds the frozen campaign host ceiling')
    option.update(host_budget_bytes=1073741824,device_budget_bytes=6000000000)
    for name in ('runtime','same_server','current_server'): setattr(args,name,getattr(args,name).resolve(strict=True))
    candidate = verify_build(args.runtime.parent,True,session=True)
    if args.runtime.name != 'main' or candidate['bundle_id'] != admitted.records['bundle']['bundle_id']:
        raise ValueError('candidate does not bind the admitted backend')
    subprocess.run(['git','-C',str(ROOT),'merge-base','--is-ancestor',nomination,candidate['source_commit']],check=True)
    paths = subprocess.check_output(['git','-C',str(ROOT),'ls-tree','-r','--name-only',nomination],text=True).splitlines()
    for path in paths:
        if path.startswith('src/') or path in ('.align-revision','scripts/ggml_shim.c'):
            expected = subprocess.check_output(['git','-C',str(ROOT),'show',nomination+':'+path])
            if hashlib.sha256(expected).hexdigest() != candidate['source_files'].get(path): raise ValueError('candidate runtime differs from the frozen session')
    same = baseline_identity(args.same_server,PIN,option['backend'])
    current = baseline_identity(args.current_server,CURRENT,option['backend'])
    if subprocess.check_output(['git','-C',str(ROOT),'status','--porcelain']):
        raise ValueError('measurement requires a clean committed campaign')
    if args.output.resolve()==ROOT or ROOT in args.output.resolve().parents:
        raise ValueError('measurement output must be outside the source checkout')
    campaign_commit = subprocess.check_output(['git','-C',str(ROOT),'rev-parse','HEAD'],text=True).strip()
    campaign_source = source_files(ROOT)
    plan_path = ROOT/'docs/specs/gpu-runtime-performance.md'
    plan_digest = digest(plan_path)
    identities = dict(candidate=candidate,same=same,current=current,profile_sha256=digest(args.profile),
        models=profile['models'],bundle=admitted.records['bundle'],host=host_identity(admitted.records['bundle'],option,deadline),
        campaign_commit=campaign_commit,campaign_source=campaign_source,plan_sha256=plan_digest)
    args.output.mkdir()
    destination = args.output.resolve()
    option['backend_bundle'] = str((args.profile.resolve().parent/option['backend_bundle']).resolve())
    options_path = destination/'options.json'
    options_path.write_text(json.dumps(option))
    record = dict(schema_version=2 if final_cuda(args) else 1,artifact_kind='GPU_SESSION_MEASUREMENT',status='FAIL',decision='incomplete',
        identities=identities,policy=dict(campaign=args.campaign,
            timing_basis='producer_internal_processing' if final_cuda(args) else 'caller_wall_including_startup_and_transport',order=ORDER,cases=CASES,system=SYSTEM,maximum_tokens=128,deadline_seconds=7200,
            same_kv='f32',current_kv='f16',context=2304,batch=2048,microbatch=128,threads=4,flash_attention=True,
            startup_warmup=False,context_shift=False,samplers=['top_k','top_p','min_p','temperature'],
            top_k=40,top_p=.95,min_p=.05,repeat_penalty=1,task_sha256=base.file_sha256(base.TASK)),
        arms=[],comparisons=[],failure='',elapsed_ns=0)
    try:
        validator = base.resolve_validator(deadline)
        if final_cuda(args) and validator['kind'] != 'native': raise ValueError('cuda-final requires native validation')
        record['identities']['validator'] = dict(validator)
        control = destination/'known-good.patch'
        control.write_text(base.KNOWN_GOOD_PATCH)
        passed,_ = base.validate_patch(control,destination,deadline,validator)
        if not passed: raise ValueError('validator control failed')
        models = {row['model_id']:dict(row) for row in profile['models']}
        for model in models.values():
            for field in ('model_path','pack_path','geometry_path'):
                model[field] = (args.profile.resolve().parent/model[field]).resolve(strict=True)
        for model_name in ('qwen2','olmoe'):
            for repeat,order in enumerate(ORDER):
                for system in order:
                    remaining(deadline)
                    row = dict(model=model_name,repeat=repeat,system=system,status='FAIL',runtime=[],
                               coding=dict(passed=False,attempts=[],**{coding_clock(args):None}))
                    record['arms'].append(row)
                    prefix = f'{model_name}-{repeat}-{system}'
                    print(prefix+': start',flush=True)
                    runtime_sequence(system,args,models[model_name],options_path,option,destination/(prefix+'-runtime'),deadline,row)
                    coding_portfolio(system,args,models[model_name],options_path,option,destination/(prefix+'-coding'),deadline,row,validator)
                    row['status']='PASS'
                    print(prefix+': complete',flush=True)
        admitted.recheck()
        if source_files(ROOT)!=campaign_source or digest(plan_path)!=plan_digest:
            raise ValueError('campaign or validator source changed during measurement')
        if verify_build(args.runtime.parent,True,session=True) != candidate or baseline_identity(args.same_server,PIN,option['backend']) != same or baseline_identity(args.current_server,CURRENT,option['backend']) != current:
            raise ValueError('campaign executable identities changed')
        record.update(status='PASS',decision='measured')
    except (Exception,KeyboardInterrupt) as error:
        record['failure'] = str(error)[-4096:]
    finally:
        for model in ('qwen2','olmoe'):
            for case,_ in CASES:
                for reference in ('same','current'):
                    record['comparisons'].append(dict(model=model,case=case,reference=reference,
                        **(comparison(record['arms'],model,case,reference) if record['status']=='PASS'
                           else dict(decision='invalid_quality',paired_reductions=[]))))
            for reference in ('same','current'):
                selected = {(row['repeat'],row['system']):row['coding'] for row in record['arms']
                            if row['model']==model and row['status']=='PASS'}
                pairs = []
                for repeat in range(5):
                    candidate_row,reference_row = selected.get((repeat,'candidate')),selected.get((repeat,reference))
                    pairs.append(None if not candidate_row or not reference_row or not candidate_row['passed'] or not reference_row['passed']
                        else (reference_row[coding_clock(args)]-candidate_row[coding_clock(args)])/reference_row[coding_clock(args)])
                record['comparisons'].append(dict(model=model,case='coding',reference=reference,decision='diagnostic',
                    candidate_successes=sum(bool(selected.get((repeat,'candidate'),{}).get('passed')) for repeat in range(5)),
                    reference_successes=sum(bool(selected.get((repeat,reference),{}).get('passed')) for repeat in range(5)),
                    paired_reductions=pairs,median_paired_reduction=statistics.median(pairs) if record['status']=='PASS' and all(value is not None for value in pairs) else None))
        record['elapsed_ns']=time.monotonic_ns()-started
        (destination/'result.json').write_text(json.dumps(record,indent=2,allow_nan=False)+'\n')
    print('gpu session measurement: '+record['status'],flush=True)
    return 0 if record['status']=='PASS' else 1


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    for name in ('profile','runtime','same-server','current-server','output'):
        parser.add_argument('--'+name,type=Path,required=True)
    parser.add_argument('--campaign', choices=('original','cuda-final'), default='original')
    args=parser.parse_args()
    def interrupted(*_): raise KeyboardInterrupt
    previous=signal.signal(signal.SIGTERM,interrupted)
    try: return run(args)
    finally: signal.signal(signal.SIGTERM,previous)

if __name__=='__main__':
    raise SystemExit(main())
