+// Align opts in at graph construction. This specialization owns only a device
+// operation, never model semantics, graph scheduling or generation.
+static bool align_native_swiglu(ggml_metal_op_t ctx, int idx) {
+    auto gate = ctx->node(idx);
+    if (strcmp(gate->name, "align_native_q40_swiglu") != 0 ||
+        !ctx->can_fuse_swiglu(idx)) return false;
+    auto up = ctx->node(idx + 1);
+    auto out = ctx->node(idx + 2);
+    auto wg = gate->src[0];
+    auto wu = up->src[0];
+    auto x = gate->src[1];
+    if (!wg || !wu || !x || up->src[1] != x ||
+        out->src[0] != gate || out->src[1] != up ||
+        ggml_get_glu_op(out) != GGML_GLU_OP_SWIGLU ||
+        ggml_get_op_params_i32(out, 1) != 0 ||
+        wg->type != GGML_TYPE_Q4_0 || wu->type != GGML_TYPE_Q4_0 ||
+        x->type != GGML_TYPE_F32 || out->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(wg) || !ggml_is_contiguous(wu) ||
+        !ggml_is_contiguous(x) || !ggml_is_contiguous(out) ||
+        !ggml_are_same_shape(wg, wu) || !ggml_is_matrix(wg) ||
+        !ggml_is_vector(x) || !ggml_is_vector(out) ||
+        wg->ne[0] != x->ne[0] || wg->ne[1] != out->ne[0] ||
+        wg->ne[0] % 32 != 0 || wg->ne[1] % 4 != 0 ||
+        wg->ne[0] > 65536 || wg->ne[1] > 65536) return false;
+    // The unfused allocator may recycle the input after the two projections.
+    // A fused dispatch must not read and write overlapping GPU storage.
+    const uintptr_t output_begin = reinterpret_cast<uintptr_t>(out->data);
+    for (const auto source : {wg, wu, x}) {
+        // Metal can expose overlapping views of a large backing allocation as
+        // different MTLBuffer objects. Compare backing addresses, not object IDs.
+        const uintptr_t input_begin = reinterpret_cast<uintptr_t>(source->data);
+        if (input_begin <= output_begin
+                ? output_begin - input_begin < ggml_nbytes(source)
+                : input_begin - output_begin < ggml_nbytes(out)) return false;
+    }
+    auto pipeline = ggml_metal_library_compile_pipeline(ctx->lib,
+        "align_q40_gate_up_swiglu", "align_q40_gate_up_swiglu", nullptr);
+    GGML_ASSERT(pipeline.pipeline);
+    // Account for both branches' reads and the new output before dispatch.
+    // The outer encoder already checked gate. Check the other branch and
+    // output against earlier dispatches, retaining every necessary barrier.
+    if (!ggml_metal_op_concurrency_check(ctx, up) ||
+        !ggml_metal_op_concurrency_check(ctx, out)) {
+        ggml_metal_op_concurrency_reset(ctx);
+    }
+    uint32_t width = wg->ne[0], hidden = wg->ne[1];
+    ggml_metal_encoder_set_pipeline(ctx->enc, pipeline);
+    ggml_metal_encoder_set_buffer(ctx->enc, ggml_metal_get_buffer_id(wg), 0);
+    ggml_metal_encoder_set_buffer(ctx->enc, ggml_metal_get_buffer_id(wu), 1);
+    ggml_metal_encoder_set_buffer(ctx->enc, ggml_metal_get_buffer_id(x), 2);
+    ggml_metal_encoder_set_buffer(ctx->enc, ggml_metal_get_buffer_id(out), 3);
+    ggml_metal_encoder_set_bytes(ctx->enc, &width, sizeof(width), 4);
+    ggml_metal_encoder_set_bytes(ctx->enc, &hidden, sizeof(hidden), 5);
+    ggml_metal_encoder_dispatch_threadgroups(ctx->enc, (hidden * 8 + 127) / 128, 1, 1, 128, 1, 1);
+    return true;
+}
