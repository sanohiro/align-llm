#!/usr/bin/env bash

set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
compiler="${ALIGNC:-${project_root}/scripts/alignc}"
output_file="$(mktemp)"
trap 'rm -f "${output_file}"' EXIT

"${compiler}" run "${project_root}/src/prompt_verifier_smoke.align" >"${output_file}"

expected='prompt verifier smoke: complete, incomplete, compact, and tamper cases PASS'
actual="$(tr -d '\r' <"${output_file}")"
if [[ "${actual}" != "${expected}" ]]; then
  printf 'unexpected prompt verifier smoke output: %s\n' "${actual}" >&2
  exit 1
fi

printf '%s\n' "${expected}"
