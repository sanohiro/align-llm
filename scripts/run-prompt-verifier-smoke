#!/usr/bin/env bash

set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
compiler="${ALIGNC:-${project_root}/scripts/alignc}"
output_file="$(mktemp)"
diagnostic_file="$(mktemp)"
trap 'rm -f "${output_file}" "${diagnostic_file}"' EXIT

if ! "${compiler}" run "${project_root}/src/prompt_verifier_smoke.align" \
  >"${output_file}" 2>"${diagnostic_file}"; then
  printf 'prompt verifier compiler failed\n' >&2
  tail -c 32768 "${diagnostic_file}" >&2
  exit 1
fi

expected='prompt verifier smoke: complete, incomplete, compact, tamper, and repair-attempt cases PASS'
actual="$(tr -d '\r' <"${output_file}")"
if [[ "${actual}" != "${expected}" ]]; then
  printf 'unexpected prompt verifier smoke output: %s\n' "${actual}" >&2
  exit 1
fi

printf '%s\n' "${expected}"
