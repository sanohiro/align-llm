#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
compiler="${ALIGNC:-${project_root}/scripts/alignc}"
scratch="$(mktemp -d)"
scratch="$(cd "$scratch" && pwd -P)"
trap 'status=$?; if [ "$status" -eq 0 ]; then rm -rf "$scratch"; else echo "Preserved attempt fixture: $scratch" >&2; fi' EXIT
"$compiler" check-per-unit "$project_root/src/prompt_evaluation_row_smoke.align"
(cd "$scratch" && "$project_root/scripts/run-main-with-shim" "$compiler" build "$project_root/src/prompt_evaluation_row_smoke.align")
mkdir "$scratch/image" "$scratch/source" "$scratch/oracle" "$scratch/workspace"
cp "$(command -v git)" "$scratch/image/git"
git_hash="$(sha256sum "$scratch/image/git" | cut -d ' ' -f 1)"
printf 'before\n' > "$scratch/source/a"
chmod 644 "$scratch/source/a"
oracle_env=(env -i HOME=/tmp/home PATH=/usr/bin:/bin TMPDIR=/tmp LC_ALL=C
  GIT_CONFIG_NOSYSTEM=1 GIT_ATTR_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_NO_REPLACE_OBJECTS=1
  'GIT_AUTHOR_NAME=align-llm fixture' GIT_AUTHOR_EMAIL=fixture@align-llm.invalid GIT_AUTHOR_DATE=2026-01-01T00:00:00Z
  'GIT_COMMITTER_NAME=align-llm fixture' GIT_COMMITTER_EMAIL=fixture@align-llm.invalid GIT_COMMITTER_DATE=2026-01-01T00:00:00Z)
"${oracle_env[@]}" git -C "$scratch/oracle" init -q --initial-branch=main --object-format=sha1
blob="$(printf 'before\n' | "${oracle_env[@]}" git -C "$scratch/oracle" hash-object -w --stdin)"
tree="$(printf '100644 blob %s\ta\n' "$blob" | "${oracle_env[@]}" git -C "$scratch/oracle" mktree)"
revision="$(printf 'Create deterministic evaluation fixture\n' | "${oracle_env[@]}" git -C "$scratch/oracle" commit-tree "$tree")"
cat > "$scratch/patch-input" <<'PATCH'
diff --git a/a b/a
--- a/a
+++ b/a
@@ -1 +1 @@
-before
+after
PATCH
hash=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
product_hash="$(sha256sum "$scratch/prompt_evaluation_row_smoke" | cut -d ' ' -f 1)"
revision_align="$(tr -d '\n' < "$project_root/.align-revision")"
jq -cn --arg root "$scratch" --arg hash "$hash" --arg revision "$revision" \
  --arg provider FIXTURE --arg kind FIXTURE_PATCH --arg mode fixture --rawfile patch "$scratch/patch-input" \
  -f "$project_root/eval/fixtures/product-cutover-attempt-input.jq" > "$scratch/base"
jq -c --arg root "$scratch" --arg hash "$hash" --arg product "$product_hash" --arg git "$git_hash" --arg align "$revision_align" '
  .task.environment.allowed_variables=[
    {name:"LANG",non_secret_value:"C",source:"EXPLICIT_POLICY",precedence:0},
    {name:"LC_ALL",non_secret_value:"C",source:"EXPLICIT_POLICY",precedence:1}] |
  .task.environment.executable_paths=["/usr/bin/sh"] |
  .task.definition.validation_argv=["/usr/bin/sh","-c","test \"$(cat a)\" = after"] |
  .request.product_executable_sha256=$product | .request.task_deadline_ns=30000000000 |
  .evaluation={schema_version:2,artifact_kind:"PROMPT_EVALUATE_REQUEST",evaluation_id:"evaluation",project_root:$root,
    experiment_path:"experiment",parent_activation_path:"activation",corpus_path:"corpus",sample_count:2,acceptance_policy_path:"policy",
    workspace_path:($root+"/workspace"),workspace_preflight_path:"preflight",verifier_align_llm_repository_path:$root,
    verifier_align_llm_commit:$align,verifier_align_repository_path:$root,verifier_align_revision:$align,
    verifier_corpus_source_path:$root,verifier_corpus_source_kind:"GIT_COMMIT",verifier_corpus_source_repository_id:"repository",
    verifier_corpus_source_sha256:$hash,verifier_source_policy_path:"policy",verifier_source_policy_sha256:$hash,
    verifier_git_executable_path:($root+"/image/git"),evaluation_evidence_path:"evidence",product_executable_path:($root+"/prompt_evaluation_row_smoke"),product_executable_sha256:$product} |
  .source_policy={schema_version:2,artifact_kind:"PROMPT_SOURCE_VERIFIER_POLICY",policy_id:"policy",git_executable_sha256:$git,product_executable_sha256:$product,content_sha256:$hash} |
  del(.paths)
' "$scratch/base" > "$scratch/input"
# These records are already-admitted fixtures. This owner checks invocation snapshots and row
# execution; the complete input-admission owner independently checks document/source identities.
jq -c --arg hash "$hash" '
  .variant={schema_version:1,artifact_kind:"PROMPT_VARIANT",variant_id:"variant",
    base_prompt:.task.prompt,repo_prompt:.task.prompt,learned_prompt_append:"",
    context_policy:{include_patch_evaluation:false,include_failure_memory:false,include_diagnostics:false,
      max_patch_evaluation_bytes:0,max_failure_events:0,max_failure_context_bytes:0,max_diagnostic_bytes_per_stream:0},
    candidate_id:"candidate",content_sha256:$hash} |
  .task.manifest.timeout_ns=30000000000 | del(.request)
' "$scratch/input" > "$scratch/admitted"
for name in experiment activation corpus policy preflight task control environment prompt context .align-revision; do
  printf 'stable\n' > "$scratch/$name"
  chmod 644 "$scratch/$name"
done
run() {
  "$scratch/prompt_evaluation_row_smoke" "$scratch/case" "$1" > "$scratch/result"
  [[ -z "$(find "$scratch/workspace" -mindepth 1 -print -quit)" ]]
  [[ "$(cat "$scratch/source/a")" == before ]]
  jq -e '.survivors==[]' "$scratch/result" >/dev/null
  jq -c '.rows[], .requests[], .snapshots[], .inputs[], .attestations[], .expected[]' "$scratch/result" |
    while IFS= read -r record; do
      claimed="$(printf '%s' "$record" | jq -r .content_sha256)"
      canonical="$(printf '%s' "$record" | jq -cj '.content_sha256=""')"
      [[ "$(printf '%s' "$canonical" | sha256sum | cut -d ' ' -f 1)" == "$claimed" ]]
    done
}
cp "$scratch/admitted" "$scratch/case"
run pass
jq -e '.status=="COMPLETE" and (.rows|length)==2 and (.attestations|length)==2 and
  all(.rows[]; .measurement.status=="PASS" and (.attempts|length)==1 and .repair_loop_count==0) and
  all(.attestations[]; .status=="COMPLETE") and (.expected|length)==2' "$scratch/result" >/dev/null

jq -c --arg hash "$hash" '
  .task.definition.validation_argv=["/usr/bin/false"] |
  .task.environment.executable_paths=["/usr/bin/false"] |
  .task.manifest.regression_limits.maximum_repair_loops=1 |
  .task.repair_template={schema_version:1,artifact_kind:"REPAIR_PROMPT_TEMPLATE",template_id:"repair",
    preamble_text:"Repair the failed patch.",section_headers:{STATUS:"Status",SUMMARY:"Summary",STDOUT:"Stdout",STDERR:"Stderr"},
    closing_text:"Return corrected FILE blocks.",content_sha256:$hash}
' "$scratch/admitted" > "$scratch/repair"
cp "$scratch/repair" "$scratch/case"
run repair
jq -e '.status=="COMPLETE" and all(.rows[];
  .measurement.status=="FAIL" and (.attempts|length)==2 and .repair_loop_count==1 and
  .attempts[1].attempt_kind=="REPAIR" and .attempts[1].repair_prompt_source.source_measurement_sha256==.attempts[0].measurement_sha256) and
  (.expected|length)==4 and (.attestations|length)==2' "$scratch/result" >/dev/null

jq -c '.task.generation.max_prompt_bytes=(.rendered.text|utf8bytelength)' "$scratch/repair" > "$scratch/case"
run budget
jq -e '.status=="COMPLETE" and all(.rows[]; .repair_loop_count==0 and
  .attempts[1].status=="SKIPPED" and .attempts[1].skip_reason=="REPAIR_PROMPT_BUDGET") and
  (.expected|length)==2' "$scratch/result" >/dev/null

cp "$scratch/admitted" "$scratch/case"
run drift
jq -e '.status=="ERROR" and .error=="INPUT_DRIFT" and (.rows|length)==1 and
  .attestations[-1].status=="PRECHECK_DRIFT"' "$scratch/result" >/dev/null
printf 'stable\n' > "$scratch/experiment"
rm "$scratch/context"
run missing
jq -e '.status=="ERROR" and (.rows|length)==0 and .attestations[-1].status=="PRECHECK_FAILED"' "$scratch/result" >/dev/null
printf 'native rows: passing termination, two-attempt repair, budget skip, cross-row drift, missing input, canonical evidence and workspace retirement PASS\n'
