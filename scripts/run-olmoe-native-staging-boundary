class NativeStagingError(RuntimeError):
    pass


def require(condition: bool, message: str) -> None:
    if not condition:
        raise NativeStagingError(message)


def keys(value: Any, expected: set[str], label: str) -> None:
    require(isinstance(value, dict) and set(value) == expected, f"{label} keys drifted")


def same(actual: Any, expected: Any, label: str) -> None:
    if type(actual) is not type(expected):
        raise NativeStagingError(f"{label} type drifted")
    if isinstance(expected, dict):
        keys(actual, set(expected), label)
        for key, value in expected.items():
            same(actual[key], value, f"{label}.{key}")
    elif isinstance(expected, (tuple, list)):
        require(len(actual) == len(expected), f"{label} length drifted")
        for left, right in zip(actual, expected, strict=True):
            same(left, right, label)
    else:
        require(actual == expected, f"{label} drifted")


def strict_json(data: bytes | str, label: str) -> Any:
    def pairs(items: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in items:
            require(key not in result, f"duplicate JSON key in {label}: {key}")
            result[key] = value
        return result

    def constant(value: str) -> None:
        raise NativeStagingError(f"invalid JSON constant in {label}: {value}")

    try:
        text = data.decode("utf-8", "strict") if isinstance(data, bytes) else data
        return json.loads(text, object_pairs_hook=pairs, parse_constant=constant)
    except (UnicodeError, json.JSONDecodeError) as error:
        raise NativeStagingError(f"{label} did not contain one valid JSON document") from error


def source_identities() -> tuple[str, ...]:
    return tuple(base.file_sha256(path) for path in SOURCE_PATHS)


def validate_imported_contract() -> None:
    require(bool(EXPECTED_SOURCE_IDENTITIES), "current source identities are pending; qualification is disabled")
    same(source_identities(), EXPECTED_SOURCE_IDENTITIES, "current consumed source closure")
    same((previous.MODEL_BYTES, previous.MODEL_SHA256, previous.SERVER_BUILD, previous.BUDGET,
          previous.SEED, previous.FULL_TOKENS, previous.TEMPERATURE_MICROS,
          previous.FULL_OUTPUT_SHA256, previous.FULL_CACHE_BYTES_FETCHED,
          previous.REPETITIONS, previous.CEILING_SECONDS, previous.EXPECTED_ALIGN_REVISION),
         (4_213_512_192, "4ddc0e53159ed512b8dd67914a66e27bc618f694672ba43a9a0454eabd9c684f",
          "build 10566, commit bb4caa754", 975_175_680, 5, 128, 300_000,
          "aac1d1158144da0b3afd4f4cdff7c10df240adaa85529b8a21839a0c89777e52",
          17_656_872_960, REPETITIONS, CEILING_SECONDS,
          "8cefc803d5c7f883a8db5b67250ed4ed069b43a4"), "fixed workload")
    require(diagnosis.integer_median(BASELINE_VALUES_NS) == BASELINE_MEDIAN_NS, "baseline median drifted")
    require((BASELINE_MEDIAN_NS * FLOOR_PPM + 999_999) // 1_000_000 == FLOOR_NS,
            "immutable floor arithmetic drifted")


def integer(value: Any, *, signed: bool = False, positive: bool = False) -> bool:
    lower = MIN_I64 if signed else (1 if positive else 0)
    return type(value) is int and lower <= value <= MAX_I64


def scalar_domains(value: Any, field: str = "") -> None:
    if isinstance(value, dict):
        for name, item in value.items():
            scalar_domains(item, name)
    elif isinstance(value, list):
        for item in value:
            scalar_domains(item, field)
    elif isinstance(value, bool):
        require(field in {"stopped_eog", "released_before_owner_scope_end"},
                f"boolean integer at {field}")
    elif isinstance(value, int):
        require(integer(value, signed=field in {"gain_ns", "paired_gains_ns", "median_gain_ns", "gain_ppm"}),
                f"integer outside signed-i64 domain at {field}")
    elif isinstance(value, float):
        raise NativeStagingError(f"non-integer scalar at {field}")


class ProcessGroups:
    """Own one synchronous process group, including descendants and signal-launch races."""

    def __init__(self, cleanup_seconds: float = 5.0) -> None:
        self.active: subprocess.Popen[bytes] | None = None
        self.pending_signal: int | None = None
        self.launching = False
        self.cleaning = False
        self.cleanup_seconds = cleanup_seconds

    @staticmethod
    def exists(group: int) -> bool:
        try:
            os.killpg(group, 0)
            return True
        except ProcessLookupError:
            return False
        except PermissionError:
            # A dying group can transiently refuse signal 0 on Darwin. It is still
            # present until its leader is reaped; never mistake refusal for absence.
            return True

    @staticmethod
    def send(group: int, number: int) -> None:
        try:
            os.killpg(group, number)
        except ProcessLookupError:
            pass

    def stop(self, process: subprocess.Popen[bytes]) -> None:
        self.cleaning = True
        try:
            self.send(process.pid, signal.SIGTERM)
            until = time.monotonic() + self.cleanup_seconds
            while self.exists(process.pid) and time.monotonic() < until:
                process.poll()
                time.sleep(0.01)
            if self.exists(process.pid):
                self.send(process.pid, signal.SIGKILL)
            process.wait(timeout=self.cleanup_seconds)
            until = time.monotonic() + self.cleanup_seconds
            while self.exists(process.pid) and time.monotonic() < until:
                time.sleep(0.01)
            require(not self.exists(process.pid), "owned process group survived cleanup")
        finally:
            self.cleaning = False

    def interrupted(self, number: int, _frame: object) -> None:
        # Record first; Popen may still be creating its session when the signal arrives.
        if self.pending_signal is None:
            self.pending_signal = number
        if self.active is not None:
            self.send(self.active.pid, number)
        if not self.launching and not self.cleaning:
            raise SystemExit(128 + number)

    def run(self, argv: list[str], *, deadline: float, maximum: float = 240,
            env: dict[str, str] | None = None, cwd: Path = ROOT,
            check: bool = True) -> subprocess.CompletedProcess[bytes]:
        require(self.active is None, "nested child process ownership is unsupported")
        require(self.pending_signal is None, "refusing a child after interruption")
        timeout = min(float(maximum), deadline - time.monotonic())
        require(timeout > 0, "complete diagnosis exceeded its 8-minute ceiling")
        self.launching = True
        try:
            process = subprocess.Popen(argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
            self.active = process
        finally:
            self.launching = False
        try:
            if self.pending_signal is not None:
                raise SystemExit(128 + self.pending_signal)
            stdout, stderr = process.communicate(timeout=timeout)
            require(not self.exists(process.pid), "child exited with surviving group descendants")
            completed = subprocess.CompletedProcess(argv, process.returncode, stdout, stderr)
            require(not check or completed.returncode == 0,
                    f"command failed ({completed.returncode}): {' '.join(argv)}\n"
                    + stderr.decode("utf-8", "replace")[-4096:])
            return completed
        finally:
            try:
                if process.poll() is None or self.exists(process.pid):
                    self.stop(process)
            finally:
                self.active = None


@contextmanager
def process_scope() -> Iterator[ProcessGroups]:
    processes = ProcessGroups()
    old_handlers = {number: signal.getsignal(number) for number in (signal.SIGINT, signal.SIGTERM)}
    old_run = owner.run_process
    try:
        for number in old_handlers:
            signal.signal(number, processes.interrupted)
        # The inherited host and process-absence helpers call this module's run_process.
        # Scope this one delegation; do not change historical runners on disk or retain it.
        owner.run_process = processes.run
        yield processes
    finally:
        try:
            if processes.active is not None:
                processes.stop(processes.active)
        finally:
            owner.run_process = old_run
            for number, handler in old_handlers.items():
                signal.signal(number, handler)


def git(processes: ProcessGroups, arguments: list[str], deadline: float,
        env: dict[str, str], *, cwd: Path = ROOT, check: bool = True) -> subprocess.CompletedProcess[bytes]:
    return processes.run(["git", "--no-replace-objects", *arguments], deadline=deadline,
                         env=env, cwd=cwd, maximum=30, check=check)


def clean_head(processes: ProcessGroups, deadline: float, env: dict[str, str], *, cwd: Path = ROOT) -> str:
    require(not git(processes, ["status", "--porcelain", "--untracked-files=all"], deadline, env,
                    cwd=cwd).stdout, "real diagnosis requires a clean worktree")
    return git(processes, ["rev-parse", "HEAD"], deadline, env, cwd=cwd).stdout.decode("ascii").strip()


def git_common_dir(processes: ProcessGroups, deadline: float, env: dict[str, str], *, cwd: Path = ROOT) -> Path:
    value = git(processes, ["rev-parse", "--git-common-dir"], deadline, env, cwd=cwd).stdout.decode("utf-8").strip()
    require(bool(value), "Git common directory was empty")
    return (cwd / value).resolve()


def require_ancestry(processes: ProcessGroups, head: str, common: Path, deadline: float,
                     env: dict[str, str], *, cwd: Path = ROOT,
                     ancestors: tuple[str, ...] | None = None) -> None:
    require(git_common_dir(processes, deadline, env, cwd=cwd) == common, "Git common directory changed")
    require(not git(processes, ["for-each-ref", "--format=%(refname)", "refs/replace"],
                    deadline, env, cwd=cwd).stdout.strip(), "ancestry refuses Git replacement refs")
    require(not (common / "info/grafts").exists(), "ancestry refuses Git grafts")
    required = ancestors if ancestors is not None else (MERGED_SOURCE_BASE,) + (
        (EVALUATED_HEAD,) if EVALUATED_HEAD is not None else ())
    for ancestor in required:
        require(git(processes, ["merge-base", "--is-ancestor", ancestor, head], deadline, env,
                    cwd=cwd, check=False).returncode == 0, "required revision is not an ancestor")


def source_inventory(processes: ProcessGroups, head: str, deadline: float,
                     env: dict[str, str]) -> dict[str, tuple[str, str]]:
    rows = git(processes, ["ls-tree", "-r", "-z", head, "--", "src", *sorted(BUILD_FILES)],
               deadline, env).stdout
    result = {}
    for raw in rows.split(b"\0"):
        if not raw:
            continue
        metadata, raw_path = raw.split(b"\t", 1)
        mode, kind, blob = metadata.decode("ascii").split()
        path = raw_path.decode("utf-8", "strict")
        if path not in BUILD_FILES and not (path.startswith("src/") and path.endswith(".align")):
            continue
        require(kind == "blob" and mode in {"100644", "100755"}, "source is not a regular tracked file")
        require(not Path(path).is_absolute() and ".." not in Path(path).parts, "unsafe source path")
        result[path] = (mode, blob)
    require(BUILD_FILES | {HELPER_SOURCE} <= set(result), "tracked source inventory incomplete")
    return result


def snapshot_identity(tree: Path, inventory: dict[str, tuple[str, str]]) -> None:
    require({path.relative_to(tree).as_posix() for path in (tree / "src").rglob("*.align")}
            == {path for path in inventory if path.endswith(".align")}, "snapshot inventory changed")
    for path, (mode, blob) in inventory.items():
        source = tree / path
        require(source.is_file() and not source.is_symlink(), "snapshot source missing or symlinked")
        data = source.read_bytes()
        actual = hashlib.sha1(b"blob " + str(len(data)).encode("ascii") + b"\0" + data).hexdigest()
        require(actual == blob and source.stat().st_mode & 0o777 == int(mode, 8) & 0o777,
                f"snapshot differs from tracked source: {path}")


def materialize(processes: ProcessGroups, head: str, tree: Path, deadline: float,
                env: dict[str, str]) -> dict[str, tuple[str, str]]:
    inventory = source_inventory(processes, head, deadline, env)
    archive = git(processes, ["archive", "--format=tar", head, "--", *sorted(inventory)], deadline, env).stdout
    tree.mkdir()
    with tarfile.open(fileobj=io.BytesIO(archive), mode="r:") as bundle:
        for member in bundle:
            if member.isdir():
                continue
            require(member.name in inventory and member.isfile(), "unexpected source archive member")
            source = bundle.extractfile(member)
            require(source is not None, "snapshot archive member unreadable")
            destination = tree / member.name
            destination.parent.mkdir(parents=True, exist_ok=True)
            destination.write_bytes(source.read())
            destination.chmod(int(inventory[member.name][0], 8) & 0o777)
    snapshot_identity(tree, inventory)
    return inventory


def validate_manifests(control: Any, candidate: Any, *, restored: bool = False) -> None:
    for rows in (control, candidate):
        require(isinstance(rows, list) and rows, "source manifest was not a nonempty array")
        paths = []
        for row in rows:
            keys(row, {"path", "bytes", "sha256"}, "source manifest row")
            require(isinstance(row["path"], str) and not Path(row["path"]).is_absolute()
                    and ".." not in Path(row["path"]).parts, "manifest source path was invalid")
            require(integer(row["bytes"], positive=True) and transfer.is_lower_hex(row["sha256"], 64),
                    "manifest file identity was invalid")
            paths.append(row["path"])
        require(paths == list(MANIFEST_PATHS), "source manifest is not complete, unique and path-sorted")
        require(BUILD_FILES | ALLOWED_DELTA | {HELPER_SOURCE} <= set(paths), "manifest source inventory incomplete")
        require(all(path in BUILD_FILES or (path.startswith("src/") and path.endswith(".align"))
                    for path in paths), "manifest source path outside declared inventory")
    require([row["path"] for row in control] == [row["path"] for row in candidate],
            "compiled source inventory differs between arms")
    differences = {left["path"] for left, right in zip(control, candidate, strict=True) if left != right}
    if restored:
        require(not differences, "removed production does not match control bytes")
    else:
        require(differences == ALLOWED_DELTA,
                "compiled source delta is empty or outside the two allowed paths")


def prerequisites() -> tuple[Path, ...] | None:
    rows = [("ALIGN_LLM_OLMOE_MODEL", base.configured_file("ALIGN_LLM_OLMOE_MODEL")),
        ("ALIGN_LLM_MOE_ALIGNPACK", base.configured_file("ALIGN_LLM_MOE_ALIGNPACK")),
        ("ALIGN_LLM_MOE_GEOMETRY", base.configured_file("ALIGN_LLM_MOE_GEOMETRY")),
        ("ALIGN_LLM_GGML_INCLUDE", base.configured_directory("ALIGN_LLM_GGML_INCLUDE")),
        ("ALIGN_LLM_GGML_LIB", base.configured_directory("ALIGN_LLM_GGML_LIB")),
        ("ALIGN_LLM_LLAMA_SERVER", base.configured_file("ALIGN_LLM_LLAMA_SERVER", executable=True))]
    missing = next((name for name, path in rows if path is None), None)
    if missing is not None:
        print(f"{LABEL}: N/A ({missing} unset)")
        return None
    return tuple(path.resolve() for _, path in rows)


def runtime_identity(compiler: Path) -> str:
    # The managed compiler links this adjacent archive; compiler bytes alone do not
    # identify it. Its fixed digest is also emitted in fixed_request so the result
    # explicitly identifies both native toolchain outputs.
    runtime = compiler.parent / "libalign_runtime.a"
    require(runtime.is_file() and not runtime.is_symlink(), "managed runtime archive unavailable")
    digest = base.file_sha256(runtime)
    require(digest == EXPECTED_RUNTIME_SHA256, "managed runtime archive identity drifted")
    return digest


def external_identity(processes: ProcessGroups, paths: tuple[Path, ...], compiler: Path,
                      c_compiler: Path, env: dict[str, str], linker_search: str,
                      deadline: float) -> dict[str, Any]:
    model, pack, geometry, include, library, server = paths
    task = strict_json(diagnosis.TASK.read_bytes(), "task")
    require(isinstance(task, dict) and task.get("id") == "python-inclusive-range", "task identity drifted")
    require(model.stat().st_size == previous.MODEL_BYTES and base.file_sha256(model) == previous.MODEL_SHA256,
            "model identity drifted")
    version = processes.run([str(server), "--version"], deadline=deadline, env=env, maximum=30)
    require(previous.SERVER_BUILD in (version.stdout + version.stderr).decode("utf-8", "replace"),
            "server build identity drifted")
    c_version = processes.run([str(c_compiler), "--version"], deadline=deadline, env=env, maximum=30)
    toolchain = {"compiler_sha256": base.file_sha256(compiler), "c_compiler_sha256": base.file_sha256(c_compiler),
                 "c_compiler_version_sha256": base.command_output_sha256(c_version)}
    diagnosis.validate_toolchain_identity(toolchain)
    runtime_digest = runtime_identity(compiler)
    linker_digest = None if not linker_search else base.bytes_sha256(linker_search.encode("utf-8"))
    candidate = {"provider": "align-runtime", "align_revision": (ROOT / ".align-revision").read_text().strip(),
        "compiler_sha256": toolchain["compiler_sha256"], "ggml_libraries": base.library_identities(library),
        "ggml_headers": previous.compute.predecessor.ggml_header_identities(include),
        "pack_sha256": base.file_sha256(pack), "geometry_sha256": base.file_sha256(geometry),
        "cache_budget_bytes": previous.BUDGET}
    task_record = {"task_id": task["id"], "task_sha256": base.file_sha256(diagnosis.TASK),
        "prompt_sha256": base.bytes_sha256(diagnosis.PROMPT_TEXT.encode("utf-8")),
        "maximum_tokens": previous.FULL_TOKENS, "temperature_micros": previous.TEMPERATURE_MICROS,
        "seed": previous.SEED, "full_output_sha256": previous.FULL_OUTPUT_SHA256}
    diagnosis.validate_external_identity(align_revision=candidate["align_revision"],
        pack_sha256=candidate["pack_sha256"], geometry_sha256=candidate["geometry_sha256"],
        server_sha256=base.file_sha256(server), task_sha256=task_record["task_sha256"],
        prompt_sha256=task_record["prompt_sha256"], ggml_libraries=candidate["ggml_libraries"],
        linker_search_sha256=linker_digest)
    same(candidate["ggml_headers"], previous.EXPECTED_GGML_HEADERS, "ggml headers")
    environment = {**transfer.qualification_host(env, deadline),
        "c_compiler_sha256": toolchain["c_compiler_sha256"],
        "c_compiler_version_sha256": toolchain["c_compiler_version_sha256"],
        "linker_search_sha256": linker_digest}
    same(environment, {**previous.EXPECTED_BASELINE_HOST,
        "host_fingerprint_sha256": previous.EXPECTED_BASELINE_HOST_SHA256,
        "c_compiler_sha256": previous.EXPECTED_C_COMPILER_SHA256,
        "c_compiler_version_sha256": previous.EXPECTED_C_COMPILER_VERSION_SHA256,
        "linker_search_sha256": previous.EXPECTED_LINKER_SEARCH_SHA256}, "host/toolchain")
    return {"candidate": candidate, "task": task_record, "environment": environment,
            "runtime_sha256": runtime_digest}


def build_snapshot(processes: ProcessGroups, tree: Path, compiler: Path, include: Path,
                   library: Path, env: dict[str, str], deadline: float) -> dict[str, Any]:
    shim_dir = tree / "lib"
    build_env = {**env, "ALIGN_LLM_GGML_INCLUDE": str(include), "ALIGN_LLM_GGML_LIB": str(library),
                 "ALIGN_LLM_GGML_SHIM_DIR": str(shim_dir)}
    processes.run([str(tree / "scripts/build-ggml-shim")], cwd=tree, env=build_env,
                  deadline=deadline, maximum=180)
    build_env["LIBRARY_PATH"] = ":".join(value for value in (str(shim_dir), str(library), env.get("LIBRARY_PATH", "")) if value)
    processes.run([str(compiler), "build", HELPER_SOURCE], cwd=tree, env=build_env, deadline=deadline, maximum=300)
    helper = tree / HELPER_NAME
    shim = shim_dir / ("libalign_ggml_shim.dylib" if platform.system() == "Darwin" else "libalign_ggml_shim.so")
    require(helper.is_file() and os.access(helper, os.X_OK) and shim.is_file(), "isolated build incomplete")
    runtime_env = {**env, "DYLD_LIBRARY_PATH": ":".join((str(shim_dir), str(library))),
                   "LD_LIBRARY_PATH": ":".join((str(shim_dir), str(library)))}
    return {"root": tree, "helper": helper, "shim": shim, "helper_sha256": base.file_sha256(helper),
            "shim_sha256": base.file_sha256(shim), "runtime_env": runtime_env}


def inherited_sample(leg: dict[str, Any], index: int) -> dict[str, Any]:
    return {"index": index, "conditioning": leg["short"], "full": leg["full"],
            "full_helper_wall_ns": leg["full_helper_wall_ns"], "isolation": leg["isolation"]}


def validate_leg(leg: Any, index: int) -> None:
    keys(leg, LEG_KEYS, "arm leg")
    scalar_domains(leg)
    for record in (leg["short"], leg["full"]):
        require(integer(record["schema_version"]) and record["schema_version"] == 1,
                "helper schema version drifted")
    previous.validate_sample(inherited_sample(leg, index), index)
    require(integer(leg["full_helper_wall_ns"], positive=True)
            and leg["full_helper_wall_ns"] >= leg["full"]["phases"]["elapsed_ns"],
            "full helper wall did not contain helper elapsed")


def measure_pairs(processes: ProcessGroups, builds: dict[str, Any], paths: tuple[Path, ...], env: dict[str, str],
                  deadline: float) -> list[dict[str, Any]]:
    pairs = []
    for index, order in enumerate(PAIR_ORDER, 1):
        pair: dict[str, Any] = {"index": index, "order": order}
        for symbol in order:
            arm = ARM_NAMES[symbol]
            pair[arm] = measure_leg(processes, builds[arm], paths, env, deadline, index)
        pair["gain_ns"] = pair["control"]["full_helper_wall_ns"] - pair["candidate"]["full_helper_wall_ns"]
        pairs.append(pair)
    validate_pairs(pairs)
    return pairs


def validate_pairs(pairs: Any) -> None:
    require(isinstance(pairs, list) and len(pairs) == 4, "comparison requires four complete pairs")
    for index, (pair, order) in enumerate(zip(pairs, PAIR_ORDER, strict=True), 1):
        keys(pair, PAIR_KEYS, "pair")
        require(integer(pair["index"], positive=True) and pair["index"] == index and pair["order"] == order,
                "chronological pair order or index drifted")
        for arm in ("control", "candidate"):
            validate_leg(pair[arm], index)
        expected = pair["control"]["full_helper_wall_ns"] - pair["candidate"]["full_helper_wall_ns"]
        require(integer(pair["gain_ns"], signed=True) and pair["gain_ns"] == expected, "paired gain drifted")
    # Timings may differ; both arms and all legs must preserve every non-timing result.
    previous.validate_repeatability([inherited_sample(pair[arm], index)
        for index, pair in enumerate(pairs, 1) for arm in ("control", "candidate")])


def signed_median(values: list[int]) -> int:
    require(len(values) == 4 and all(integer(value, signed=True) for value in values),
            "signed median requires four i64 values")
    ordered = sorted(values)
    return (ordered[1] + ordered[2]) // 2


def gate(control: list[int], candidate: list[int]) -> tuple[dict[str, Any], str]:
    require(len(control) == len(candidate) == 4
            and all(integer(value, positive=True) for value in control + candidate), "gate walls invalid")
    gains = [a - b for a, b in zip(control, candidate, strict=True)]
    control_median = signed_median(control)
    candidate_median = signed_median(candidate)
    gain_median = signed_median(gains)
    required = max(FLOOR_NS, (control_median * FLOOR_PPM + 999_999) // 1_000_000)
    positive = sum(gain > 0 for gain in gains)
    aggregate = {"control_values_ns": control, "candidate_values_ns": candidate,
        "paired_gains_ns": gains, "control_median_ns": control_median,
        "candidate_median_ns": candidate_median, "median_gain_ns": gain_median,
        "positive_pairs": positive, "required_gain_ns": required,
        "historical_ceiling_ns": HISTORICAL_CEILING_NS,
        "gain_ppm": gain_median * 1_000_000 // control_median}
    scalar_domains(aggregate)
    decision = "MET" if positive == 4 and gain_median >= required and candidate_median <= HISTORICAL_CEILING_NS else "NOT_MET"
    return aggregate, decision


def aggregate_pairs(pairs: list[dict[str, Any]]) -> tuple[dict[str, Any], str]:
    validate_pairs(pairs)
    return gate([pair["control"]["full_helper_wall_ns"] for pair in pairs],
                [pair["candidate"]["full_helper_wall_ns"] for pair in pairs])


def fixed_request_record() -> dict[str, Any]:
    return {"model_bytes": previous.MODEL_BYTES, "model_sha256": previous.MODEL_SHA256,
        "pack_sha256": previous.EXPECTED_PACK_SHA256, "geometry_sha256": previous.EXPECTED_GEOMETRY_SHA256,
        "server_sha256": previous.EXPECTED_SERVER_SHA256, "align_revision": previous.EXPECTED_ALIGN_REVISION,
        "compiler_sha256": previous.EXPECTED_COMPILER_SHA256, "runtime_sha256": EXPECTED_RUNTIME_SHA256, "ggml_libraries": previous.EXPECTED_GGML_LIBRARIES,
        "ggml_headers": previous.EXPECTED_GGML_HEADERS, "task_id": "python-inclusive-range",
        "task_sha256": previous.EXPECTED_TASK_SHA256, "prompt_sha256": previous.EXPECTED_PROMPT_SHA256,
        "maximum_tokens": previous.FULL_TOKENS, "temperature_micros": previous.TEMPERATURE_MICROS,
        "seed": previous.SEED, "cache_budget_bytes": previous.BUDGET, "full_output_sha256": previous.FULL_OUTPUT_SHA256}


def environment_record() -> dict[str, Any]:
    return {**previous.EXPECTED_BASELINE_HOST, "host_fingerprint_sha256": previous.EXPECTED_BASELINE_HOST_SHA256,
        "c_compiler_sha256": previous.EXPECTED_C_COMPILER_SHA256,
        "c_compiler_version_sha256": previous.EXPECTED_C_COMPILER_VERSION_SHA256,
        "linker_search_sha256": previous.EXPECTED_LINKER_SEARCH_SHA256}


def validate_arms(control: Any, candidate: Any) -> None:
    for arm in (control, candidate):
        keys(arm, ARM_KEYS, "arm identity")
        for field, length in (("align_llm_head", 40), ("source_tree", 40), ("helper_sha256", 64), ("shim_sha256", 64)):
            require(transfer.is_lower_hex(arm[field], length), f"arm {field} invalid")
    require(control["align_llm_head"] == CONTROL_HEAD, "control revision drifted")
    require(candidate["align_llm_head"] != CONTROL_HEAD, "candidate revision equals control")
    require(all(control[field] != candidate[field] for field in ("source_tree", "shim_sha256")),
            "compiled arms were not distinct")
    if PUBLICATION_ONLY and EVALUATED_HEAD is not None:
        require(candidate["align_llm_head"] == EVALUATED_HEAD, "evaluated candidate revision drifted")
    validate_manifests(control["source_files"], candidate["source_files"])


def validate_elapsed(result: dict[str, Any]) -> None:
    elapsed = result["elapsed_ns"]
    total = sum(pair[arm]["full_helper_wall_ns"] for pair in result["pairs"] for arm in ("control", "candidate"))
    require(integer(elapsed, positive=True) and total <= elapsed <= CEILING_SECONDS * 1_000_000_000,
            "complete elapsed did not contain full walls within the 8-minute ceiling")


def validate_result(result: Any) -> None:
    keys(result, TOP_KEYS, "result")
    scalar_domains(result)
    require(result["schema_version"] == 1 and result["kind"] == KIND, "result schema identity drifted")
    validate_arms(result["control"], result["candidate"])
    same(result["boundary"], boundary_record(), "operation boundary")
    same(result["fixed_request"], fixed_request_record(), "fixed request")
    same(result["environment"], environment_record(), "host/toolchain environment")
    same(result["pair_order"], PAIR_ORDER, "pair schedule")
    aggregate, decision = aggregate_pairs(result["pairs"])
    keys(result["aggregate"], AGGREGATE_KEYS, "aggregate")
    same(result["aggregate"], aggregate, "paired aggregate")
    same(result["decision"], decision, "shipping decision")
    validate_elapsed(result)


def complete_result_after_cleanup(result: dict[str, Any], started: int) -> dict[str, Any]:
    result = {**result, "elapsed_ns": time.monotonic_ns() - started}
    validate_result(result)
    result["elapsed_ns"] = time.monotonic_ns() - started
    validate_elapsed(result)
    return result


def synthetic_result() -> dict[str, Any]:
    samples = previous.synthetic_samples([20_000_000_000] * 4)
    pairs = []
    for index, sample in enumerate(samples, 1):
        control = {"short": sample["conditioning"], "full": sample["full"],
                   "full_helper_wall_ns": 20_000_000_000, "isolation": sample["isolation"]}
        candidate = deepcopy(control)
        candidate["full_helper_wall_ns"] = 16_000_000_000
        pairs.append({"index": index, "order": PAIR_ORDER[index - 1], "control": control,
                      "candidate": candidate, "gain_ns": 4_000_000_000})
    source_files = [{"path": path, "bytes": 1, "sha256": "a" * 64} for path in MANIFEST_PATHS]
    changed = deepcopy(source_files)
    for row in changed:
        if row["path"] in ALLOWED_DELTA:
            row["sha256"] = "b" * 64
    control = {"align_llm_head": CONTROL_HEAD, "source_tree": "a" * 40, "source_files": source_files,
               "helper_sha256": "a" * 64, "shim_sha256": "c" * 64}
    candidate = {"align_llm_head": EVALUATED_HEAD or "b" * 40, "source_tree": "b" * 40,
                 "source_files": changed, "helper_sha256": "a" * 64, "shim_sha256": "d" * 64}
    aggregate, decision = aggregate_pairs(pairs)
    return {"schema_version": 1, "kind": KIND, "control": control, "candidate": candidate,
        "boundary": boundary_record(), "fixed_request": fixed_request_record(),
        "environment": environment_record(), "pair_order": list(PAIR_ORDER), "pairs": pairs,
        "aggregate": aggregate, "decision": decision, "elapsed_ns": 144_000_000_001}


def boundary_record() -> dict[str, Any]:
    return {"native_symbol": "align_ggml_stage_kv", "changed_region": "V_TRANSPOSE",
        "tile_lanes": 4, "tile_columns": 4, "fast_path": "AARCH64_NEON_BYTE_LOAD_STORE",
        "fallback": "SCALAR", "k_copy": "UNCHANGED", "validation": "UNCHANGED",
        "priming": "UNCHANGED", "execution": "NORMAL_UNSPLIT_PHASE_A"}


def manifest(tree: Path, inventory: dict[str, tuple[str, str]]) -> list[dict[str, Any]]:
    snapshot_identity(tree, inventory)
    return [{"path": path, "bytes": (tree / path).stat().st_size,
             "sha256": base.file_sha256(tree / path)} for path in sorted(inventory)]


def snapshot(processes: ProcessGroups, head: str, tree: Path, deadline: float,
             env: dict[str, str]) -> dict[str, Any]:
    inventory = materialize(processes, head, tree, deadline, env)
    return {"root": tree, "inventory": inventory, "identity": {
        "align_llm_head": head,
        "source_tree": git(processes, ["rev-parse", f"{head}^{{tree}}"], deadline, env).stdout.decode("ascii").strip(),
        "source_files": manifest(tree, inventory)}}


def shared_parts(data: bytes) -> tuple[bytes, bytes, bytes]:
    start = b"/* --- BEGIN R4.5 SHARED SHIM CONTRACT --- */"
    end = b"/* --- END R4.5 SHARED SHIM CONTRACT --- */"
    require(data.count(start) == data.count(end) == 1, "shared shim markers drifted")
    first = data.index(start)
    last = data.index(end, first) + len(end)
    return data[:first], data[first:last], data[last:]


def validate_native_sources(control: Path, candidate: Path) -> None:
    regions: dict[str, bytes] = {}
    for arm, tree in (("control", control), ("candidate", candidate)):
        real = shared_parts((tree / "scripts/ggml_shim.c").read_bytes())
        stub = shared_parts((tree / "scripts/ggml_shim_stub.c").read_bytes())
        require(real[1] == stub[1], f"{arm} real/stub shared regions differ")
        regions[arm] = real[1]
    require(regions["control"] != regions["candidate"], "native shared-region edit is empty")
    for path in ALLOWED_DELTA:
        old = shared_parts((control / path).read_bytes())
        new = shared_parts((candidate / path).read_bytes())
        require((old[0], old[2]) == (new[0], new[2]), "native edit escaped the shared contract region")


def measure_request(processes: ProcessGroups, built: dict[str, Any], paths: tuple[Path, ...],
                    maximum: int, deadline: float) -> tuple[dict[str, Any], int]:
    owner.verify_identities((("arm helper", built["helper"], built["helper_sha256"]),
                             ("arm shim", built["shim"], built["shim_sha256"])))
    model, pack, geometry, _, _, _ = paths
    started = time.monotonic_ns()
    completed = processes.run([str(built["helper"]), str(model), str(pack), str(geometry),
        diagnosis.PROMPT_TEXT, str(maximum), str(previous.SEED)], deadline=deadline,
        env=built["runtime_env"], cwd=built["root"])
    wall = time.monotonic_ns() - started
    record = strict_json(completed.stdout, "helper stdout")
    require(isinstance(record, dict), "helper record was not an object")
    scalar_domains(record)
    previous.validate_helper_record(record, maximum)
    require(integer(wall, positive=True) and wall >= record["phases"]["elapsed_ns"],
            "helper wall did not contain helper elapsed")
    return record, wall


def measure_leg(processes: ProcessGroups, built: dict[str, Any], paths: tuple[Path, ...],
                env: dict[str, str], deadline: float, index: int) -> dict[str, Any]:
    model, _, _, _, _, server = paths
    owner.require_no_matching_process(server, model, deadline, env)
    short, _ = measure_request(processes, built, paths, 2, deadline)
    owner.require_no_matching_process(server, model, deadline, env)
    try:
        full, wall = measure_request(processes, built, paths, previous.FULL_TOKENS, deadline)
    finally:
        owner.require_no_matching_process(server, model, deadline, env)
    leg = {"short": short, "full": full, "full_helper_wall_ns": wall,
           "isolation": {"matching_before": 0, "matching_between": 0, "matching_after": 0}}
    validate_leg(leg, index)
    return leg


def actual_external(processes: ProcessGroups, paths: tuple[Path, ...], compiler: Path,
                    c_compiler: Path, env: dict[str, str], linker_search: str,
                    deadline: float) -> tuple[dict[str, Any], dict[str, Any]]:
    # The inherited-shape collector validates actual task JSON, compiler and runtime,
    # server build, source assets, consumed headers/libraries, C toolchain and host.
    external = external_identity(processes, paths, compiler, c_compiler, env, linker_search, deadline)
    candidate = external["candidate"]
    task = external["task"]
    request = {**fixed_request_record(),
        **{key: candidate[key] for key in ("pack_sha256", "geometry_sha256", "align_revision",
                                           "compiler_sha256", "ggml_libraries", "ggml_headers")},
        **task, "runtime_sha256": external["runtime_sha256"],
        "server_sha256": base.file_sha256(paths[5]),
        "cache_budget_bytes": candidate["cache_budget_bytes"]}
    same(request, fixed_request_record(), "actual fixed request")
    same(external["environment"], environment_record(), "actual environment")
    return request, external["environment"]


def run_qualification(processes: ProcessGroups, paths: tuple[Path, ...], started: int,
                      deadline: float) -> dict[str, Any]:
    validate_imported_contract()
    env = transfer.phase.decision.decision_environment()
    env["GIT_NO_REPLACE_OBJECTS"] = "1"
    linker_search = transfer.phase.decision.validate_linker_search(env)
    if linker_search:
        env["LIBRARY_PATH"] = linker_search
    transfer.qualification_host(env, deadline)
    head = clean_head(processes, deadline, env)
    common = git_common_dir(processes, deadline, env)
    require_ancestry(processes, head, common, deadline, env)
    runner_digest = base.file_sha256(RUNNER_PATH)
    tracked = git(processes, ["show", f"{head}:scripts/run-olmoe-native-staging-boundary"], deadline, env).stdout
    require(base.bytes_sha256(tracked) == runner_digest, "runner differs from clean tracked head")
    model, _, _, include, library, server = paths
    owner.require_no_matching_process(server, model, deadline, env)
    compiler_output = processes.run([str(ROOT / "scripts/align-toolchain"), "ensure", "compiler"],
                                   deadline=deadline, env=env, maximum=300)
    compiler = Path(compiler_output.stdout.decode("utf-8").strip()).resolve()
    require(compiler.is_file() and os.access(compiler, os.X_OK), "managed pinned compiler unusable")
    c_name = shutil.which("cc", path=env.get("PATH"))
    require(c_name is not None, "default C compiler unavailable")
    c_compiler = Path(c_name).resolve()
    external = actual_external(processes, paths, compiler, c_compiler, env, linker_search, deadline)
    with tempfile.TemporaryDirectory(prefix="align-r8-native-staging-") as raw:
        work = Path(raw)
        snapshots = {"control": snapshot(processes, CONTROL_HEAD, work / "control", deadline, env),
                     "candidate": snapshot(processes, head, work / "candidate", deadline, env)}
        validate_manifests(snapshots["control"]["identity"]["source_files"],
                           snapshots["candidate"]["identity"]["source_files"])
        validate_native_sources(snapshots["control"]["root"], snapshots["candidate"]["root"])
        builds = {}
        for arm, source in snapshots.items():
            built = build_snapshot(processes, source["root"], compiler, include, library, env, deadline)
            built["identity"] = {**source["identity"], "helper_sha256": built["helper_sha256"],
                                  "shim_sha256": built["shim_sha256"]}
            builds[arm] = built
        validate_arms(builds["control"]["identity"], builds["candidate"]["identity"])
        pairs = measure_pairs(processes, builds, paths, env, deadline)
        measured, decision = aggregate_pairs(pairs)
        require(clean_head(processes, deadline, env) == head, "evaluated head changed")
        require_ancestry(processes, head, common, deadline, env)
        validate_imported_contract()
        require(base.file_sha256(RUNNER_PATH) == runner_digest, "runner changed during comparison")
        for arm, source in snapshots.items():
            same(manifest(source["root"], source["inventory"]), source["identity"]["source_files"], "final source manifest")
            same(source_inventory(processes, source["identity"]["align_llm_head"], deadline, env),
                 source["inventory"], "tracked source inventory")
            built = builds[arm]
            owner.verify_identities((("helper", built["helper"], built["helper_sha256"]),
                                     ("shim", built["shim"], built["shim_sha256"])))
        same(actual_external(processes, paths, compiler, c_compiler, env, linker_search, deadline), external, "final external identity")
        owner.require_no_matching_process(server, model, deadline, env)
        result = {"schema_version": 1, "kind": KIND, "control": builds["control"]["identity"],
            "candidate": builds["candidate"]["identity"], "boundary": boundary_record(),
            "fixed_request": external[0], "environment": external[1], "pair_order": list(PAIR_ORDER),
            "pairs": pairs, "aggregate": measured, "decision": decision,
            "elapsed_ns": time.monotonic_ns() - started}
        validate_result(result)
    return result


def verify_terminal_files(processes: ProcessGroups, head: str, deadline: float,
                          env: dict[str, str], *, root: Path = ROOT) -> None:
    paths = [*sorted(ALLOWED_DELTA), *CANDIDATE_ONLY_PATHS]
    require(not git(processes, ["diff", "--name-only", CONTROL_HEAD, head, "--", *paths],
                    deadline, env, cwd=root).stdout, "terminal native files differ from control")
    for path in ALLOWED_DELTA:
        current = root / path
        expected = git(processes, ["show", f"{CONTROL_HEAD}:{path}"], deadline, env, cwd=root).stdout
        require(current.is_file() and not current.is_symlink() and current.read_bytes() == expected,
                "terminal native source was not restored")
    for path in CANDIDATE_ONLY_PATHS:
        current = root / path
        require(not current.exists() and not current.is_symlink(), "removed native owner remains present")


def verify_publication_state(processes: ProcessGroups, deadline: float, env: dict[str, str]) -> None:
    head = git(processes, ["rev-parse", "HEAD"], deadline, env).stdout.decode("ascii").strip()
    require(not PUBLICATION_ONLY or EVALUATED_HEAD is not None, "publication lacks evaluated revision")
    require_ancestry(processes, head, git_common_dir(processes, deadline, env), deadline, env)
    if PUBLICATION_ONLY:
        with tempfile.TemporaryDirectory(prefix="align-native-removal-") as raw:
            control = snapshot(processes, CONTROL_HEAD, Path(raw) / "control", deadline, env)
            current = snapshot(processes, head, Path(raw) / "current", deadline, env)
            validate_manifests(control["identity"]["source_files"], current["identity"]["source_files"], restored=True)
        verify_terminal_files(processes, head, deadline, env)


def main() -> int:
    if sys.argv[1:] == ["--self-test"]:
        return self_test()
    require(len(sys.argv) == 1, "qualification accepts no arguments or --self-test")
    require(not PUBLICATION_ONLY, f"candidate was removed after NOT_MET; replay real qualification at evaluated commit {EVALUATED_HEAD}")
    paths = prerequisites()
    if paths is None:
        return 0
    started = time.monotonic_ns()
    deadline = time.monotonic() + CEILING_SECONDS
    with process_scope() as processes:
        result = run_qualification(processes, paths, started, deadline)
    result = complete_result_after_cleanup(result, started)
    print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))
    measured = result["aggregate"]
    print(f"{LABEL}: COMPLETE decision={result['decision']} control={measured['control_median_ns'] / 1e9:.3f}s "
          f"candidate={measured['candidate_median_ns'] / 1e9:.3f}s median_gain={measured['median_gain_ns'] / 1e9:.3f}s "
          f"elapsed={result['elapsed_ns'] / 1e9:.2f}s", file=sys.stderr)
    return 0


def expect_error(action: Any, label: str, error_type: type[BaseException] = Exception) -> BaseException:
    try:
        action()
    except error_type as error:
        return error
    raise NativeStagingError(f"{label}: invalid operation was accepted")


def self_test_sources() -> None:
    actual_hash = base.file_sha256
    for changed in SOURCE_PATHS:
        with mock.patch.object(base, "file_sha256", side_effect=lambda path: "0" * 64 if path == changed else actual_hash(path)):
            expect_error(validate_imported_contract, "source_mutation")
    with tempfile.TemporaryDirectory(prefix="align-native-source-owner-") as raw:
        compiler = Path(raw) / "alignc"
        runtime = compiler.parent / "libalign_runtime.a"
        runtime.write_bytes(b"pinned runtime")
        with mock.patch.object(sys.modules[__name__], "EXPECTED_RUNTIME_SHA256", base.file_sha256(runtime)):
            runtime_identity(compiler)
            runtime.write_bytes(b"changed runtime")
            expect_error(lambda: runtime_identity(compiler), "mutable runtime refusal")
            runtime.unlink()
            expect_error(lambda: runtime_identity(compiler), "missing runtime refusal")
        tree = Path(raw) / "source"
        (tree / "src").mkdir(parents=True)
        source = tree / "src/check.align"
        source.write_bytes(b"tracked\n")
        source.chmod(0o644)
        inventory = {"src/check.align": ("100644", hashlib.sha1(b"blob 8\0tracked\n").hexdigest())}
        snapshot_identity(tree, inventory)
        source.write_bytes(b"changed\n")
        expect_error(lambda: snapshot_identity(tree, inventory), "snapshot byte mutation")
        source.write_bytes(b"tracked\n")
        source.chmod(0o755)
        expect_error(lambda: snapshot_identity(tree, inventory), "snapshot mode mutation")
        source.chmod(0o644)
        (tree / "src/extra.align").write_text("extra")
        expect_error(lambda: snapshot_identity(tree, inventory), "snapshot inventory mutation")


def self_test_ancestry() -> None:
    env = transfer.phase.decision.decision_environment()
    env["GIT_NO_REPLACE_OBJECTS"] = "1"
    with tempfile.TemporaryDirectory(prefix="align-native-git-owner-") as raw, process_scope() as processes:
        root = Path(raw) / "repo"
        root.mkdir()
        deadline = time.monotonic() + 30
        def local(arguments: list[str], *, cwd: Path = root) -> subprocess.CompletedProcess[bytes]:
            return git(processes, arguments, deadline, env, cwd=cwd)
        local(["init", "-q"])
        config = ["-c", "user.name=Upload owner", "-c", "user.email=upload-owner@example.invalid"]
        local([*config, "commit", "--allow-empty", "-qm", "base"])
        first = clean_head(processes, deadline, env, cwd=root)
        local([*config, "commit", "--allow-empty", "-qm", "candidate"])
        head = clean_head(processes, deadline, env, cwd=root)
        common = git_common_dir(processes, deadline, env, cwd=root)
        require_ancestry(processes, head, common, deadline, env, cwd=root, ancestors=(first, head))
        expect_error(lambda: require_ancestry(processes, first, common, deadline, env, cwd=root, ancestors=(head,)),
                     "nonancestor refusal")
        expect_error(lambda: require_ancestry(processes, head, common / "wrong", deadline, env, cwd=root, ancestors=(first,)),
                     "changed common directory")
        linked = Path(raw) / "linked"
        local(["worktree", "add", "--quiet", "--detach", str(linked), head])
        try:
            require(git_common_dir(processes, deadline, env, cwd=linked) == common, "linked common directory")
            require_ancestry(processes, head, common, deadline, env, cwd=linked, ancestors=(first, head))
            (linked / "dirty").write_text("dirty")
            expect_error(lambda: clean_head(processes, deadline, env, cwd=linked), "dirty linked worktree")
            (linked / "dirty").unlink()
            local(["update-ref", f"refs/replace/{first}", head])
            try:
                expect_error(lambda: require_ancestry(processes, head, common, deadline, env, cwd=linked, ancestors=(first,)),
                             "linked replacement refusal")
            finally:
                local(["update-ref", "-d", f"refs/replace/{first}"])
            graft = common / "info/grafts"
            graft.parent.mkdir(exist_ok=True)
            graft.write_text("")
            try:
                expect_error(lambda: require_ancestry(processes, head, common, deadline, env, cwd=linked, ancestors=(first,)),
                             "linked graft refusal")
            finally:
                graft.unlink()
        finally:
            local(["worktree", "remove", "--force", str(linked)])


def self_test_process_groups() -> None:
    env = transfer.phase.decision.decision_environment()
    python = sys.executable
    old_run = owner.run_process
    old_handlers = {number: signal.getsignal(number) for number in (signal.SIGINT, signal.SIGTERM)}
    with process_scope() as processes:
        result = processes.run([python, "-c", "print('complete')"], deadline=time.monotonic() + 10, env=env)
        require(result.stdout == b"complete\n" and processes.active is None, "process success cleanup")
        failed = processes.run([python, "-c", "raise SystemExit(7)"], deadline=time.monotonic() + 10, env=env, check=False)
        require(failed.returncode == 7, "child failure status")
        expect_error(lambda: processes.run([python, "-c", "raise SystemExit(7)"],
                     deadline=time.monotonic() + 10, env=env), "child failure")
        expect_error(lambda: processes.run([python, "-c", "pass"], deadline=time.monotonic() - 1, env=env),
                     "expired invocation")
    require(owner.run_process is old_run and all(signal.getsignal(number) == handler for number, handler in old_handlers.items()),
            "process scope did not restore delegation/handlers")

    with tempfile.TemporaryDirectory(prefix="align-native-process-owner-") as raw:
        pid_file = Path(raw) / "pids"
        child_program = "import time; time.sleep(60)"
        # The direct child reaps its descendant after a group signal. The same descendant
        # must be killed on timeout and interruption; checking only the direct PID cannot pass.
        program = (
            "import os,signal,subprocess,sys,time\n"
            f"child=subprocess.Popen([sys.executable,'-c',{child_program!r}])\n"
            "def stop(number,frame):\n child.wait(timeout=3); raise SystemExit(0)\n"
            "signal.signal(signal.SIGTERM,stop)\n"
            f"open({str(pid_file)!r},'w').write(str(os.getpid())+' '+str(child.pid))\n"
            "time.sleep(60)\n"
        )
        with process_scope() as processes:
            expect_error(lambda: processes.run([python, "-c", program], deadline=time.monotonic() + 10,
                         maximum=0.3, env=env), "group timeout", subprocess.TimeoutExpired)
            require(processes.active is None, "timeout retained child")
        require(pid_file.is_file(), "timeout did not exercise a descendant")
        for value in pid_file.read_text().split():
            try:
                os.kill(int(value), 0)
            except ProcessLookupError:
                continue
            raise NativeStagingError("timeout left an owned process alive")
        pid_file.unlink()
        signal_program = program.replace("time.sleep(60)\n", "os.kill(os.getppid(),signal.SIGTERM)\ntime.sleep(60)\n")
        error = None
        try:
            with process_scope() as processes:
                processes.run([python, "-c", signal_program], deadline=time.monotonic() + 10, env=env)
        except SystemExit as caught:
            error = caught
        require(error is not None and error.code == 128 + signal.SIGTERM, "signal exit code drifted")
        for value in pid_file.read_text().split():
            try:
                os.kill(int(value), 0)
            except ProcessLookupError:
                continue
            raise NativeStagingError("signal left an owned process alive")
        require(owner.run_process is old_run, "signal did not restore delegated process owner")

        # Even a successful direct child must not leave a background descendant. Give
        # that descendant independent pipes so communicate cannot accidentally own it.
        orphan = (
            "import os,subprocess,sys\n"
            f"child=subprocess.Popen([sys.executable,'-c',{child_program!r}],"
            "stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)\n"
            f"open({str(pid_file)!r},'w').write(str(child.pid))\n"
        )
        with process_scope() as processes:
            error = expect_error(lambda: processes.run([python, "-c", orphan],
                         deadline=time.monotonic() + 10, env=env), "normal-exit descendant")
            require("surviving group descendants" in str(error), "normal-exit descendant was not detected")
        try:
            os.kill(int(pid_file.read_text()), 0)
        except ProcessLookupError:
            pass
        else:
            raise NativeStagingError("normal-exit cleanup left its descendant alive")

        # A direct child that ignores graceful termination must be killed and reaped.
        stubborn = ProcessGroups(cleanup_seconds=0.05)
        expect_error(lambda: stubborn.run([python, "-c",
            "import signal,time; signal.signal(signal.SIGTERM,signal.SIG_IGN); time.sleep(60)"],
            deadline=time.monotonic() + 10, maximum=0.2, env=env), "forced group kill", subprocess.TimeoutExpired)
        require(stubborn.active is None, "forced kill retained the child")

    # Simulate the signal landing during Popen, before its returned PID is attached.
    processes = ProcessGroups()
    actual_popen = subprocess.Popen
    launched = []
    def interrupted_launch(*args: Any, **kwargs: Any) -> Any:
        child = actual_popen(*args, **kwargs)
        launched.append(child)
        processes.interrupted(signal.SIGTERM, None)
        return child
    with mock.patch.object(subprocess, "Popen", side_effect=interrupted_launch):
        error = expect_error(lambda: processes.run([python, "-c", "import time; time.sleep(60)"],
                             deadline=time.monotonic() + 10, env=env), "signal launch race", SystemExit)
    require(error.code == 128 + signal.SIGTERM and processes.active is None and launched[0].poll() is not None,
            "signal launch race leaked a process")


def self_test_records() -> None:
    result = synthetic_result()
    validate_result(result)
    require(signed_median([-5, -4, -3, 100]) == -4, "signed median rounded toward zero")
    require(signed_median([MIN_I64, MIN_I64, MAX_I64, MAX_I64]) == -1,
            "signed median endpoint arithmetic drifted")
    ceiling = HISTORICAL_CEILING_NS
    # Absolute floor and historical equality both pass; a one-ns loss on either fails.
    require(gate([ceiling + FLOOR_NS] * 4, [ceiling] * 4)[1] == "MET", "gate equality failed")
    require(gate([ceiling + FLOOR_NS - 1] * 4, [ceiling] * 4)[1] == "NOT_MET", "below absolute floor passed")
    require(gate([ceiling + FLOOR_NS + 2] * 4, [ceiling + 1] * 4)[1] == "NOT_MET", "above historical ceiling passed")
    # Large alternating walls retain the historical candidate median but expose the
    # contemporary relative floor independently of the absolute floor.
    control = [10_000_000_000, 10_000_000_000, 40_000_000_000, 40_000_000_000]
    candidate = [9_000_000_000, 9_000_000_000, 9_000_000_000, 40_000_000_000 - 1]
    require(gate(control, candidate)[1] == "NOT_MET", "relative floor was not independently required")
    require(gate([20_000_000_000] * 4, [16_000_000_000] * 3 + [20_000_000_000])[1] == "NOT_MET",
            "zero paired saving passed")
    require(gate([20_000_000_000] * 4, [16_000_000_000] * 3 + [20_000_000_001])[1] == "NOT_MET",
            "negative paired saving passed")
    for invalid in (True, -1, 0, MAX_I64 + 1, 1.0):
        expect_error(lambda: gate([invalid] * 4, [1] * 4), "invalid gate wall accepted")
    require(integer(MAX_I64) and integer(MIN_I64, signed=True), "i64 endpoints rejected")
    require(not integer(MIN_I64 - 1, signed=True) and not integer(MAX_I64 + 1, signed=True),
            "i64 overflow accepted")
    for path, value in (
        (("schema_version",), True), (("kind",), "other"), (("pair_order",), ["BA"] * 4),
        (("pairs", 0, "index"), True), (("pairs", 0, "order"), "BA"),
        (("pairs", 0, "gain_ns"), 0), (("pairs", 0, "gain_ns"), MAX_I64 + 1),
        (("pairs", 0, "control", "full_helper_wall_ns"), 1),
        (("pairs", 0, "control", "isolation", "matching_between"), 1),
        (("pairs", 0, "candidate", "full", "lifetime", "contexts_freed"), 0),
        (("pairs", 0, "candidate", "full", "engine", "expert_cache_requests"), 1),
        (("pairs", 0, "candidate", "full", "output_sha256"), "0" * 64),
        (("pairs", 0, "candidate", "short", "token_ids"), [0]),
        (("pairs", 0, "candidate", "full", "phases", "elapsed_ns"), True),
        (("pairs", 0, "candidate", "full", "phases", "elapsed_ns"), -1),
        (("pairs", 0, "candidate", "full", "phases", "elapsed_ns"), MAX_I64 + 1),
        (("pairs", 0, "candidate", "full", "schema_version"), True),
        (("control", "align_llm_head"), "b" * 40),
        (("candidate", "shim_sha256"), "c" * 64),
        (("candidate", "source_tree"), "a" * 40),
        (("fixed_request", "compiler_sha256"), "0" * 64),
        (("fixed_request", "runtime_sha256"), "0" * 64),
        (("environment", "host_fingerprint_sha256"), "0" * 64),
        (("aggregate", "positive_pairs"), True), (("decision",), "NOT_MET"),
        (("elapsed_ns",), 144_000_000_000 - 1), (("elapsed_ns",), CEILING_SECONDS * 1_000_000_000 + 1),
    ):
        malformed = deepcopy(result)
        target = malformed
        for component in path[:-1]:
            target = target[component]
        target[path[-1]] = value
        expect_error(lambda: validate_result(malformed), f"malformed field accepted: {path}")
    for path in ((), ("control",), ("pairs", 0), ("pairs", 0, "candidate"), ("aggregate",)):
        for extra in (False, True):
            malformed = deepcopy(result)
            target = malformed
            for component in path:
                target = target[component]
            if extra:
                target["unexpected"] = 0
            else:
                del target[next(iter(target))]
            expect_error(lambda: validate_result(malformed), "incorrect exact keys accepted")
    malformed = deepcopy(result)
    malformed["pairs"].pop()
    expect_error(lambda: validate_result(malformed), "incomplete pair count accepted")
    for mutation in ("missing", "reverse", "outside", "empty"):
        malformed = deepcopy(result)
        rows = malformed["candidate"]["source_files"]
        if mutation == "missing":
            rows.pop()
        elif mutation == "reverse":
            rows.reverse()
        elif mutation == "outside":
            next(row for row in rows if row["path"] == HELPER_SOURCE)["sha256"] = "0" * 64
        else:
            malformed["candidate"]["source_files"] = deepcopy(malformed["control"]["source_files"])
        expect_error(lambda: validate_result(malformed), "incorrect source delta accepted")
    validate_manifests(result["control"]["source_files"], result["control"]["source_files"], restored=True)
    expect_error(lambda: validate_manifests(result["control"]["source_files"], result["candidate"]["source_files"], restored=True),
                 "unremoved production accepted")


def self_test_orchestration() -> None:
    module = sys.modules[__name__]
    result = synthetic_result()
    require(result["control"]["helper_sha256"] == result["candidate"]["helper_sha256"], "equal helper fixture drifted")
    validate_arms(result["control"], result["candidate"])
    different_helper = deepcopy(result["candidate"])
    different_helper["helper_sha256"] = "f" * 64
    validate_arms(result["control"], different_helper)
    one_shim_only = deepcopy(result["candidate"]["source_files"])
    for index, row in enumerate(one_shim_only):
        if row["path"] == "scripts/ggml_shim_stub.c":
            one_shim_only[index] = deepcopy(result["control"]["source_files"][index])
    expect_error(lambda: validate_manifests(result["control"]["source_files"], one_shim_only),
                 "both declared C paths must differ")
    counts = {"control": 0, "candidate": 0}
    calls = []
    def measured(_processes: Any, built: dict[str, Any], _paths: Any, maximum: int, _deadline: Any) -> tuple[Any, int]:
        arm = built["arm"]
        calls.append((arm, maximum))
        pair = result["pairs"][counts[arm]]
        if maximum == 2:
            return deepcopy(pair[arm]["short"]), 1
        counts[arm] += 1
        return deepcopy(pair[arm]["full"]), pair[arm]["full_helper_wall_ns"]
    def absent(*_args: Any) -> None:
        calls.append(("isolation", 0))
    builds = {arm: {"arm": arm} for arm in counts}
    with mock.patch.object(module, "measure_request", side_effect=measured), \
            mock.patch.object(owner, "require_no_matching_process", side_effect=absent):
        actual = measure_pairs(mock.Mock(), builds, (ROOT,) * 6, {}, 1)
    same(actual, result["pairs"], "actual paired dispatch")
    expected = []
    for order in PAIR_ORDER:
        for symbol in order:
            arm = ARM_NAMES[symbol]
            expected += [("isolation", 0), (arm, 2), ("isolation", 0), (arm, 128), ("isolation", 0)]
    same(calls, expected, "pair_order_and_conditioning")
    require(sum(name == "isolation" for name, _ in calls) == 24, "isolation count drifted")
    with mock.patch.object(owner, "require_no_matching_process", side_effect=NativeStagingError("contamination")), \
            mock.patch.object(module, "measure_request") as request:
        expect_error(lambda: measure_leg(mock.Mock(), {}, (ROOT,) * 6, {}, 1, 1), "contaminated leg")
        request.assert_not_called()

    for malformed in (b'{"x":1,"x":1}', b'{"x":{"y":0,"y":1}}', b'[{"x":0,"x":1}]',
                      b'{"x":NaN}', b'{"x":Infinity}', b'{"x":-Infinity}', b'{} {}', b'\xff'):
        expect_error(lambda: strict_json(malformed, "fixture"), "strict JSON")
    same(strict_json(json.dumps(result).encode(), "roundtrip"), result, "typed JSON roundtrip")
    processes = mock.Mock()
    processes.run.return_value = subprocess.CompletedProcess([], 0, b'{"schema_version":1,"schema_version":1}', b'')
    built = {"root": ROOT, "helper": ROOT / "fake-helper", "shim": ROOT / "fake-shim",
             "helper_sha256": "a" * 64, "shim_sha256": "b" * 64, "runtime_env": {}}
    with mock.patch.object(owner, "verify_identities"):
        error = expect_error(lambda: measure_request(processes, built, (ROOT,) * 6, 2, 1), "actual helper duplicate keys")
        require("duplicate JSON key" in str(error), "actual helper bypassed strict JSON")
    with mock.patch.object(Path, "read_bytes", return_value=b'{"id":"a","id":"b"}'):
        error = expect_error(lambda: actual_external(processes, (ROOT,) * 6, ROOT, ROOT, {}, "", 1), "actual task duplicate keys")
        require("duplicate JSON key" in str(error), "actual task bypassed strict JSON")

    # Map the already checked collector into the public fixed-request schema, retaining
    # the runtime archive identity as an explicit field rather than only a source constant.
    request = fixed_request_record()
    candidate = {name: request[name] for name in ("pack_sha256", "geometry_sha256", "align_revision",
                 "compiler_sha256", "ggml_libraries", "ggml_headers", "cache_budget_bytes")}
    task = {name: request[name] for name in ("task_id", "task_sha256", "prompt_sha256", "maximum_tokens",
            "temperature_micros", "seed", "full_output_sha256")}
    external = {"candidate": candidate, "task": task, "environment": environment_record(),
                "runtime_sha256": EXPECTED_RUNTIME_SHA256}
    with mock.patch.object(module, "external_identity", return_value=external), \
            mock.patch.object(base, "file_sha256", return_value=request["server_sha256"]):
        same(actual_external(processes, (ROOT,) * 6, ROOT, ROOT, {}, "", 1),
             (request, environment_record()), "inherited_identity")
        external["runtime_sha256"] = "0" * 64
        expect_error(lambda: actual_external(processes, (ROOT,) * 6, ROOT, ROOT, {}, "", 1), "runtime record drift")

    # Each isolated tree must reach an actual distinct build call, even if helper bytes
    # are equal. Validate the cwd, compiler entry and shim loader ownership at this seam.
    with tempfile.TemporaryDirectory(prefix="align-native-build-owner-") as raw:
        roots = [Path(raw) / name for name in ("control", "candidate")]
        invocations = []
        for tree in roots:
            tree.mkdir()
        def built_command(argv: list[str], **kwargs: Any) -> Any:
            tree = kwargs["cwd"]
            invocations.append((tree.name, tuple(argv)))
            if argv[0].endswith("build-ggml-shim"):
                shim_dir = Path(kwargs["env"]["ALIGN_LLM_GGML_SHIM_DIR"])
                shim_dir.mkdir()
                suffix = "dylib" if platform.system() == "Darwin" else "so"
                (shim_dir / f"libalign_ggml_shim.{suffix}").write_bytes(tree.name.encode())
            else:
                require(argv == ["/compiler", "build", HELPER_SOURCE], "isolated helper entry drifted")
                helper = tree / HELPER_NAME
                helper.write_bytes(b"same independent helper bytes")
                helper.chmod(0o755)
            return subprocess.CompletedProcess(argv, 0, b"", b"")
        process = mock.Mock()
        process.run.side_effect = built_command
        actual_builds = [build_snapshot(process, tree, Path("/compiler"), Path("/include"), Path("/library"), {}, 1)
                         for tree in roots]
        require(len(invocations) == 4 and [name for name, _ in invocations] == ["control", "control", "candidate", "candidate"],
                "isolated arms were not built independently")
        require(actual_builds[0]["helper_sha256"] == actual_builds[1]["helper_sha256"]
                and actual_builds[0]["shim_sha256"] != actual_builds[1]["shim_sha256"], "independent build hashes drifted")
        for built in actual_builds:
            require(built["runtime_env"]["DYLD_LIBRARY_PATH"] == str(built["root"] / "lib") + ":/library",
                    "runtime loader points at the wrong arm")


def self_test_terminal() -> None:
    module = sys.modules[__name__]
    result = synthetic_result()
    with tempfile.TemporaryDirectory(prefix="align-native-terminal-owner-") as raw:
        root = Path(raw)
        for path in ALLOWED_DELTA:
            target = root / path
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(b"control")
        def terminal_git(_processes: Any, arguments: list[str], *_args: Any, **_kwargs: Any) -> Any:
            return subprocess.CompletedProcess(arguments, 0, b"" if arguments[0] == "diff" else b"control", b"")
        with mock.patch.object(module, "git", side_effect=terminal_git):
            verify_terminal_files(mock.Mock(), "head", 1, {}, root=root)
            for path in ALLOWED_DELTA:
                target = root / path
                target.write_bytes(b"unrestored")
                expect_error(lambda: verify_terminal_files(mock.Mock(), "head", 1, {}, root=root), "unrestored native bytes")
                target.write_bytes(b"control")
            for path in CANDIDATE_ONLY_PATHS:
                target = root / path
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(b"retained owner")
                expect_error(lambda: verify_terminal_files(mock.Mock(), "head", 1, {}, root=root), "retained native owner")
                target.unlink()
            with mock.patch.object(module, "git", return_value=subprocess.CompletedProcess([], 0, b"changed", b"")):
                expect_error(lambda: verify_terminal_files(mock.Mock(), "head", 1, {}, root=root), "committed terminal drift")
        start = b"/* --- BEGIN R4.5 SHARED SHIM CONTRACT --- */"
        end = b"/* --- END R4.5 SHARED SHIM CONTRACT --- */"
        control, candidate = root / "control", root / "candidate"
        for tree, content in ((control, b"old"), (candidate, b"new")):
            for path in ALLOWED_DELTA:
                target = tree / path
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(path.encode() + start + content + end + b"suffix")
        validate_native_sources(control, candidate)
        path = candidate / "scripts/ggml_shim.c"
        valid = path.read_bytes()
        path.write_bytes(valid.replace(b"new", b"drift"))
        expect_error(lambda: validate_native_sources(control, candidate), "different shared edits")
        path.write_bytes(valid + b"escaped")
        expect_error(lambda: validate_native_sources(control, candidate), "change outside shared region")
        path.write_bytes((control / "scripts/ggml_shim.c").read_bytes())
        (candidate / "scripts/ggml_shim_stub.c").write_bytes((control / "scripts/ggml_shim_stub.c").read_bytes())
        expect_error(lambda: validate_native_sources(control, candidate), "empty native edit")

    with mock.patch.object(module, "PUBLICATION_ONLY", True), mock.patch.object(module, "EVALUATED_HEAD", "e" * 40), \
            mock.patch.object(sys, "argv", [str(RUNNER_PATH)]), mock.patch.object(module, "prerequisites") as prerequisites_call:
        error = expect_error(main, "publication replay refusal")
        require("e" * 40 in str(error), "publication refusal omitted replay revision")
        prerequisites_call.assert_not_called()
        malformed = deepcopy(result)
        expect_error(lambda: validate_result(malformed), "published result evaluated identity")
    with mock.patch.object(module, "PUBLICATION_ONLY", True), mock.patch.object(module, "EVALUATED_HEAD", None), \
            mock.patch.object(module, "git", return_value=subprocess.CompletedProcess([], 0, b"a" * 40, b"")):
        expect_error(lambda: verify_publication_state(mock.Mock(), 1, {}), "publication missing evaluated revision")
    with mock.patch.object(module, "EVALUATED_HEAD", "e" * 40), \
            mock.patch.object(module, "git_common_dir", return_value=ROOT), \
            mock.patch.object(Path, "exists", return_value=False):
        requested = []
        def ancestry_git(_processes: Any, arguments: list[str], *_args: Any, **_kwargs: Any) -> Any:
            requested.append(arguments)
            return subprocess.CompletedProcess(arguments, 1 if "e" * 40 in arguments else 0, b"", b"")
        with mock.patch.object(module, "git", side_effect=ancestry_git):
            expect_error(lambda: require_ancestry(mock.Mock(), "head", ROOT, 1, {}), "evaluated ancestry")
        require(any("e" * 40 in command for command in requested), "evaluated ancestor was not checked")

    ceiling = CEILING_SECONDS * 1_000_000_000
    with mock.patch.object(time, "monotonic_ns", return_value=ceiling):
        require(complete_result_after_cleanup(result, 0)["elapsed_ns"] == ceiling, "exact ceiling rejected")
    with mock.patch.object(time, "monotonic_ns", side_effect=[ceiling, ceiling + 1]):
        expect_error(lambda: complete_result_after_cleanup(result, 0), "late validation ceiling")
    with mock.patch.object(time, "monotonic_ns", return_value=ceiling + 1):
        expect_error(lambda: complete_result_after_cleanup(result, 0), "late cleanup ceiling")
    with mock.patch.object(module, "PUBLICATION_ONLY", False), mock.patch.object(module, "prerequisites", return_value=(ROOT,) * 6), \
            mock.patch.object(module, "run_qualification", return_value=result), \
            mock.patch.object(sys, "argv", [str(RUNNER_PATH)]), mock.patch("builtins.print") as printed:
        @contextmanager
        def failed_cleanup() -> Iterator[Any]:
            yield mock.Mock()
            raise NativeStagingError("cleanup failure")
        with mock.patch.object(module, "process_scope", failed_cleanup):
            expect_error(main, "cleanup_failure_no_document")
        printed.assert_not_called()
    with mock.patch.dict(os.environ, {}, clear=True), mock.patch("builtins.print") as printed:
        require(prerequisites() is None, "missing prerequisite did not return N/A")
    printed.assert_called_once_with(f"{LABEL}: N/A (ALIGN_LLM_OLMOE_MODEL unset)")
    with mock.patch.object(sys, "argv", [str(RUNNER_PATH), "--unknown"]):
        expect_error(main, "unknown argument")


def self_test() -> int:
    validate_imported_contract()
    self_test_records()
    self_test_orchestration()
    self_test_terminal()
    self_test_sources()
    self_test_ancestry()
    self_test_process_groups()
    with process_scope() as processes:
        env = transfer.phase.decision.decision_environment()
        env["GIT_NO_REPLACE_OBJECTS"] = "1"
        verify_publication_state(processes, time.monotonic() + 30, env)
    print(f"{LABEL} self-test: PASS")
    print("PASS equal_helper_hashes_allowed same_shim_rejected manifest_delta source_mutation inherited_identity")
    print("PASS pair_order_and_conditioning inherited_semantic_rejections all_four_positive signed_median_floor")
    print("PASS absolute_and_relative_floor historical_ceiling gate_boundaries strict_json_and_process_groups")
    print("PASS ancestry_linked_worktree evaluated_ancestry terminal_restoration_and_removal")
    print("PASS cleanup_failure_no_document cleanup_inclusive_ceiling")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as error:
        print(f"{LABEL}: FAIL {error}", file=sys.stderr)
        raise SystemExit(1)
