#!/usr/bin/env python3
"""Capture actual clean application source and independently replay its Git objects."""

import os
import pathlib
import shutil
import subprocess
import sys
import tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "scripts"))
import gpu_backend_recipe as recipe


def rejected(call, message):
    try:
        call()
    except recipe.RecipeError as error:
        assert message in str(error), (message, str(error))
    else:
        raise AssertionError("invalid source capture was accepted")


def main():
    git = shutil.which("git")
    assert git
    with tempfile.TemporaryDirectory(prefix="gpu-source-capture-") as raw:
        root = pathlib.Path(raw).resolve()
        environment = {"HOME": str(root), "LC_ALL": "C", "TMPDIR": str(root), "TZ": "UTC"}
        for object_format in ("sha1", "sha256"):
            source = root / object_format
            source.mkdir()

            def run(*args, cwd=source):
                return subprocess.run([git, *recipe.GIT_SAFE_OPTIONS, *args], cwd=cwd,
                                      env=environment, check=True, stdout=subprocess.PIPE,
                                      stderr=subprocess.PIPE).stdout

            run("init", "-q", "--object-format=" + object_format)
            run("config", "user.name", "Source Fixture")
            run("config", "user.email", "source@example.invalid")
            run("remote", "add", "origin", recipe.SOURCE_REPOSITORIES["align-llm"])
            (source / "nested").mkdir()
            (source / "nested" / "日本語 name").write_bytes(b"payload\n")
            (source / "same").write_bytes(b"payload\n")
            (source / "run").write_bytes(b"#!/bin/sh\nexit 0\n")
            (source / "run").chmod(0o755)
            (source / "alias").symlink_to("same")
            run("add", ".")
            run("-c", "commit.gpgsign=false", "commit", "-qm", "fixture")
            commit = run("rev-parse", "HEAD").decode().strip()

            def capture(path=source):
                return recipe.source_snapshot(path, git, environment, source_kind="align-llm", commit=commit)

            manifest, raw_manifest, raw_commit, blobs = capture()
            assert manifest["commit"] == commit and manifest["source_kind"] == "align-llm"
            assert manifest["object_format"] == object_format and len(blobs) == 3
            assert recipe.object_oid(object_format, b"commit", raw_commit) == commit
            assert recipe.build_tree_oid(object_format, manifest["files"]) == manifest["tree"]
            for row in manifest["files"]:
                expected = run("cat-file", "blob", row["git_oid"])
                assert blobs[row["sha256"]] == expected
            recipe.validate_captured_source(manifest, raw_manifest, raw_commit, blobs, "align-llm")

            linked = root / (object_format + " linked")
            run("worktree", "add", "--detach", str(linked), commit)
            assert (linked / ".git").is_file()
            assert capture(linked) == (manifest, raw_manifest, raw_commit, blobs)

            rejected(lambda: recipe.source_snapshot(source, git, environment, source_kind="align-llm"),
                     "exact commit")
            rejected(lambda: recipe.source_snapshot(source, git, environment, source_kind="align-llm",
                                                      commit="0" * len(commit)), "HEAD")
            (source / "unexpected").write_bytes(b"untracked")
            rejected(capture, "untracked")
            (source / "unexpected").unlink()
            exclude = pathlib.Path(run("rev-parse", "--git-path", "info/exclude").decode().strip())
            if not exclude.is_absolute():
                exclude = source / exclude
            with exclude.open("a") as output:
                output.write("\nignored-output\n")
            (source / "ignored-output").write_bytes(b"ignored")
            rejected(capture, "ignored")
            (source / "ignored-output").unlink()
            (source / "same").write_bytes(b"changed\n")
            rejected(capture, "modified")
            (source / "same").write_bytes(b"payload\n")

            # A worktree change after admission must not produce a valid snapshot.
            original = recipe.git_command
            def changed_after_listing(git_path, args, **kwargs):
                result = original(git_path, args, **kwargs)
                if args[0] == "ls-tree":
                    (source / "same").write_bytes(b"changed\n")
                return result
            recipe.git_command = changed_after_listing
            try:
                rejected(capture, "differs from its Git blob")
            finally:
                recipe.git_command = original
                (source / "same").write_bytes(b"payload\n")

            run("remote", "set-url", "origin", "https://example.invalid/other.git")
            rejected(capture, "origin")
            run("remote", "set-url", "origin", recipe.GGML_REPOSITORY)
            original_commit = recipe.GGML_COMMIT
            recipe.GGML_COMMIT = commit
            try:
                ggml = recipe.source_snapshot(source, git, environment)
                assert ggml[0]["source_kind"] == "ggml" and ggml[0]["commit"] == commit
                rejected(lambda: recipe.source_snapshot(source, git, environment, commit="0" * len(commit)),
                         "pinned ggml")
            finally:
                recipe.GGML_COMMIT = original_commit
    print("gpu source capture: PASS (both object formats, linked worktrees, closure and refusals)")


if __name__ == "__main__":
    main()
