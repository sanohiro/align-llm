# Section 3.3's arity set, verbatim from R5B: exactly four, five, six, eight, or nine operands, and
# **seven is `R5_ARITY`**. Section 3.1 is why the gap is load-bearing here too — a trailing
# `--backend` operand would have made every one of those counts ambiguous by one.
NO_DOCUMENT = [
    ("gf-arity-3", [ARM, PACK, GEOM]),
