    ("mf-force-slot-empty", "engine+slot-empty-pos", [ARM, PACK, GEOM, TOKENS], "R5_SLOT"),
    ("mf-force-residual", "engine+short-readback", [ARM, PACK, GEOM, TOKENS], "R5_RESIDUAL"),
