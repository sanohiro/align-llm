    # without a blob. `TRANSCRIPT` has used the same convention since R5B.
    ("ds-logits-dash", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, TRANSCRIPT, WIDTH, "-"], ""),
    # The capability itself: three steps over one plane, gated against the reference loop's own ids.
    ("ds-steps-3", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, TRANSCRIPT, WIDTH, "-", STEPS], ""),
    # A transcript one graph short of what `STEPS = 3` needs. Steps 1 and 2 compare normally and
