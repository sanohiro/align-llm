    # `5663d8f`: `exit 134`, no document, `index out of bounds: the len is 65537 but the index is
    # -9223372036854775808`, on this arm and on the other one. The transcript position is `-`
    # because this token list is not the one the checked-in transcript was captured for.
    ("mf-logits-nonfinite",
     [ARM, PACK, GEOM, "1,25,5", "-", SOURCE, "-", "3", path("model-logits-neg-inf.bin")],
     "R5_LOGITS_NONFINITE"),
