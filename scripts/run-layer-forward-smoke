     "R5_MEMBER_MISSING"),
    ("mf-shape", [ARM, path("model-pack-shape.alignpack"), GEOM, TOKENS], "R5_SHAPE"),
]

ENGINE_CASES = [
    ("mf-engine-ok", [ARM, PACK, GEOM, TOKENS], ""),
    ("mf-engine-reference", [ARM, PACK, GEOM, TOKENS, "-", SOURCE], ""),
    ("mf-engine-transcript", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, WIDE, WIDTH], ""),
    ("mf-engine-logits", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, WIDE, WIDTH, LOGITS], ""),
    ("mf-engine-runtime-width",
