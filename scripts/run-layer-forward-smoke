    ("mm-claim-nbytes-huge", [ARM, path("moe-model-pack-claim-nbytes.alignpack"), GEOM, TOKENS,
                              WIDTH], "R4_PACK_OFFSET"),
]

# Section 4.1's "a missing field" cell: one fixture per consumed `model` field, each of which must
