stdout_form = run([ARM, PACK, GEOM, TOKENS]).stdout.decode("utf-8").rstrip("\n")
run([ARM, PACK, GEOM, TOKENS, document_path])
with open(document_path, "r", encoding="utf-8") as handle:
    file_form = handle.read()
if normalize(stdout_form) != normalize(file_form):
    failures.append("mf-doc-stdout-identical: the stdout and file forms differ")
dash_form = run([ARM, PACK, GEOM, TOKENS, "-"]).stdout.decode("utf-8").rstrip("\n")
if normalize(dash_form) != normalize(stdout_form):
    failures.append("mf-doc-stdout-identical: the `-` form differs from the four-operand form")
repeats = {normalize(run([ARM, PACK, GEOM, TOKENS, "-", SOURCE, WIDE, WIDTH, LOGITS])
                     .stdout.decode("utf-8")) for _ in range(3)}
if len(repeats) != 1:
    failures.append("three consecutive runs produced %d distinct documents" % len(repeats))

forced_documents = {}
for name, force, operands, expected in FORCED_CASES:
    build_shim(force)
    forced_documents[name] = record(name, operands, expected)

build_shim(None)

unmarked = forced_documents.get("mf-force-no-mark-output")
if unmarked is not None and unmarked["oracle"]["verdict"] != "FAIL":
    failures.append("mf-force-no-mark-output: ggml_set_output was dropped and the oracle still "
                    "reported %r" % unmarked["oracle"]["verdict"])

# `r5c-metal-prefill.md` section 6, correction C19, all three branches at once: the transcript
# oracle's element comparison, its sum comparison, and the logits comparison's non-finite `primary`.
# The document still has `status: ok` — a non-finite element of the arm's own output is reported and
# never refused (section 3.8) — and every verdict that can see it says so.
SCALE_LIMIT_TEN_THOUSANDTHS = 1000000000000000
UNREPRESENTABLE = 9223372036854775807
infinite = forced_documents.get("mf-force-inf-readback")
if infinite is not None:
    oracle = infinite["oracle"]
    logits = infinite["oracle_logits"]
    if infinite["status"] != "ok" or oracle["verdict"] != "FAIL" \
            or oracle["max_abs_diff_ten_thousandths"] != SCALE_LIMIT_TEN_THOUSANDTHS \
            or oracle["max_sum_diff_millionths"] != UNREPRESENTABLE:
        failures.append("mf-force-inf-readback: a +inf activation resolved to %r -- a saturating "
                        "`as i64` is back and a non-finite element can pass" % oracle)
    if logits["verdict"] != "FAIL" \
            or logits["max_abs_diff_ten_thousandths"] != SCALE_LIMIT_TEN_THOUSANDTHS \
            or infinite["output"]["nonfinite_count"] < 1:
        failures.append("mf-force-inf-readback: a +inf logit resolved to %r with %d non-finite "
                        "elements" % (logits, infinite["output"]["nonfinite_count"]))
    # Correction C21: the golden carries `<nonfinite>` where a digest covers a NaN, so the digest
    # itself is asserted here instead -- it must still be produced, still be a digest, and the
    # runtime and reconciliation passes must still agree over the NaN-bearing tensors on this host.
    reference = infinite["reference"]
    if reference["verdict"] != "IDENTICAL" \
            or reference["nodes_identical"] != reference["nodes_compared"] \
            or reference["nodes_compared"] < 1:
        failures.append("mf-force-inf-readback: the runtime and reconciliation passes disagree "
                        "over a NaN-bearing tensor: %r" % reference)
    for label, value in (("output.sha256", infinite["output"]["sha256"]),
                         ("head.result_norm_sha256", infinite["head"]["result_norm_sha256"]),
                         ("schedule[-1].l_out_sha256",
                          infinite["schedule"][-1]["l_out_sha256"])):
        if len(value) != 64 or value.strip("0123456789abcdef") != "":
            failures.append("mf-force-inf-readback: %s is %r, not a digest"
                            % (label, value))

REQUIRED_CODES = {
    "R5_TOKENS", "R5_KV_WIDTH", "R5_GEOMETRY_UNREADABLE", "R5_GEOMETRY", "R4_PACK_UNREADABLE",
    "R4_PACK_TRUNCATED", "R5_BLOCK_MISSING", "R5_BLOCK_AMBIGUOUS", "R5_LAYER_COVERAGE",
    "R5_MEMBER_MISSING", "R5_SHAPE", "R5_GGML_UNAVAILABLE", "R5_TYPE_UNSUPPORTED",
    "R5_ALIGNMENT", "R5_GGML_INIT", "R5_SLOT", "R5_ALLOC", "R5_COMPUTE", "R5_RESIDUAL",
    "R5_SOURCE_UNREADABLE", "R5_SOURCE_DIVERGED", "R5_REFERENCE_MISMATCH", "R5_TRANSCRIPT",
    "R5_ORACLE_MISSING", "R5_ORACLE_SHAPE", "R5_ORACLE_TRUNCATED", "R5_LOGITS_UNREADABLE",
    "R5_LOGITS_SHAPE", "R5_LOGITS_NONFINITE",
}
missing_codes = REQUIRED_CODES - codes
if missing_codes:
    failures.append("codes never reached: %s" % ", ".join(sorted(missing_codes)))

ORDER = ([name for name, _, _ in STUB_CASES]
         + [name for name, _, _ in ENGINE_CASES]
         + [name for name, _, _, _ in FORCED_CASES])

if update:
    with open(golden_path, "w", encoding="utf-8") as handle:
        for name in ORDER:
            handle.write(json.dumps({"case": name, "document": produced[name]},
                                    separators=(",", ":"), ensure_ascii=False) + "\n")
    print("model forward smoke: golden rewritten with %d cases" % len(produced))
else:
    with open(golden_path, "r", encoding="utf-8") as handle:
        golden = [json.loads(line) for line in handle if line.strip()]
    if [row["case"] for row in golden] != ORDER:
        failures.append("the golden case list does not match the runner's case list")
    else:
        for row in golden:
            if produced.get(row["case"]) != row["document"]:
                failures.append("golden mismatch for %s: %s"
                                % (row["case"],
                                   describe_difference(row["document"],
                                                       produced.get(row["case"]))))

if failures:
    for line in failures:
        sys.stderr.write("model forward smoke: FAIL %s\n" % line)
    raise SystemExit(1)

print("model forward smoke: %d no-document cases (R5_ARITY, R5_PATH), %d documented cases, "
      "%d of the 33 codes reached, three oracles, and the whole two-layer model PASS"
      % (len(NO_DOCUMENT), len(ORDER), len(codes - {""}) + 2))
PY

# ---------------------------------------------------------------------------------------------
# R5C-METAL-PREFILL-ARM — the `--model-forward-gpu` arm over the same synthetic two-layer model
#
# `docs/specs/r5c-metal-prefill.md` section 5.1. This block extends the existing runner rather than
# adding a target: `layer-forward-smoke` is already a member of HOSTED_CHECK_TARGETS, so R5C adds
# rows to it and changes no aggregate membership and no check topology.
#
# Hosted, ggml-free, **GPU-free**, model-free, llama.cpp-free. The default stub is unavailable and
# stops the arm at step 20 exactly as it stops `--model-forward`; the `engine` build is available
# and has no GPU device, which is `R5C_GPU_UNAVAILABLE` at step 20a; and three `engine+gpu*` builds
# give it one, take its host-pointer capability away, and shrink its maximum buffer length, so all
# three of the arm's new codes and its whole successful path are reached on a host with no GPU.
# ---------------------------------------------------------------------------------------------

DYLD_LIBRARY_PATH="${shim_dir}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}" \
LD_LIBRARY_PATH="${shim_dir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
python3 - "${root_dir}" "${work_dir}" <<'PY'
import json
