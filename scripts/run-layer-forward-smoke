#!/usr/bin/env bash

set -euo pipefail

# R5A-DENSE-LAYER-FORWARD narrow durable owner (`docs/specs/r5a-dense-layer-forward.md` section
# 5.1). Hosted, ggml-free, model-free, in HOSTED_CHECK_TARGETS.
#
# It builds the **stub** shim and the `ggml-spike` executable, writes a synthetic tiny-geometry
# alignpack v1 corpus, an `R1_MODEL_IR` geometry document, and a synthetic `llama-eval-callback`
# transcript into a temporary tree, and runs the whole `--layer-forward` CLI over every fixture of
# section 4.6. Twenty-four of the twenty-six error codes are reached for real, **and both oracle
# verdicts**, without ggml, without a model, without a network, and without a reference tool.
#
# Ten shim builds are used by this block and each one is a real contract: the default stub is
# unavailable and stops the arm at step 17, and the nine `ALIGN_LLM_GGML_FORCE=engine*` builds turn
# on the deterministic single-precision engine of section 5.1 so steps 18 to 29 are reachable at all.
#
# `ALIGN_LLM_GGML_INCLUDE` is unset deliberately and unconditionally: this runner's contract is that
# it exercises the ggml-free build, so a developer's exported include path must not silently turn it
# into a different test.
#
# R5B-MODEL-PREFILL-FORWARD (`docs/specs/r5b-model-prefill-forward.md` section 5.1) extends this
# runner rather than adding a target: `layer-forward-smoke` is already a member of
# HOSTED_CHECK_TARGETS, so R5B adds rows to an existing target and changes no aggregate membership
# and no check topology. The second block below drives `--model-forward` over a synthetic
# **two-layer, thirty-two-token-vocabulary model** whose expected values come from the generator's
# own pure-Python whole-model forward pass.
#
#   ALIGN_LLM_LAYER_FORWARD_GOLDEN_UPDATE=1   rewrite the golden files instead of comparing to them

unset ALIGN_LLM_GGML_INCLUDE ALIGN_LLM_GGML_LIB ALIGN_LLM_GGML_FORCE
export PYTHONDONTWRITEBYTECODE=1

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
if [ "${ALIGN_LLM_OUTPUT_SUMMARY_ACTIVE:-0}" != 1 ]; then
  exec python3 "${root_dir}/scripts/run-output-summary" --phase layer-forward-smoke -- "$0" "$@"
fi
compiler="${ALIGNC:-${root_dir}/scripts/alignc}"

work_dir=$(mktemp -d)
# All three Python blocks below rebuild the shim with `ALIGN_LLM_GGML_FORCE=...` flavours, and each
# restores the ordinary stub on its own success path. An unhandled exception, a failed assertion, or
# a signal inside a forced-failure loop would otherwise leave a `-DALIGN_GGML_FORCE_*` library in
# place for whatever ran next — `r5a-dense-layer-forward.md` section 6, correction C22's rule,
# applied to this runner's own trap rather than only to `scripts/run-metal-forward`'s. This runner
# builds into `${work_dir}/lib` (below), so the trap is the second line of defence behind
# `rm -rf`; the guard keeps an exit that never built a shim from paying for a rebuild.
shim_built=0
cleanup() {
  status=$?
  if [ "${shim_built}" = 1 ]; then
    ALIGN_LLM_GGML_FORCE= "${root_dir}/scripts/build-ggml-shim" >/dev/null 2>&1 || true
  fi
  # R6-KV-PERSIST section 6 risk 2. `ds-kv-save-unwritable` needs a `0555` directory, and a
  # directory with no write bit cannot have its entries removed — so the mode is restored before
  # `rm -rf` rather than after a leaked tree is discovered. It is a no-op on every other run.
  chmod -R u+rwX "${work_dir}" >/dev/null 2>&1 || true
  rm -rf "${work_dir}"
  exit "${status}"
}
trap cleanup EXIT HUP INT TERM

# The four assertions that are not about a fixture (section 5.1).
real_region=$(sed -n '/BEGIN R4.5 SHARED SHIM CONTRACT/,/END R4.5 SHARED SHIM CONTRACT/p' \
  "${root_dir}/scripts/ggml_shim.c")
stub_region=$(sed -n '/BEGIN R4.5 SHARED SHIM CONTRACT/,/END R4.5 SHARED SHIM CONTRACT/p' \
  "${root_dir}/scripts/ggml_shim_stub.c")
if [ -z "${real_region}" ] || [ "${real_region}" != "${stub_region}" ]; then
  echo "layer forward smoke: FAIL the shared shim contract differs between the two C files" >&2
  exit 1
fi
if grep -q "malloc" "${root_dir}/scripts/ggml_shim.c" "${root_dir}/scripts/ggml_shim_stub.c"; then
  echo "layer forward smoke: FAIL a shim allocates; the shim owns no memory the document names" >&2
  exit 1
fi
# `grep -rl` reports matches in directory order, so the comparison needs a deterministic sort. It
# comes from `python3` rather than `sort`, because the fresh worker image ships a curated tool set
# (`image/fresh/Dockerfile`) that has no `sort` and this runner is a `capable-checks` member there.
sorted_paths() {
  python3 -c 'import sys; sys.stdout.write(" ".join(sorted(sys.stdin.read().split())))'
}
unsafe_files=$(cd "${root_dir}" \
  && grep -rlE '(^|[^A-Za-z_])unsafe[[:space:]]*\{' src/ | sorted_paths)
if [ "${unsafe_files}" != "src/ggml_ffi.align" ]; then
  echo "layer forward smoke: FAIL an unsafe block appears outside src/ggml_ffi.align: ${unsafe_files}" >&2
  exit 1
fi
extern_files=$(cd "${root_dir}" \
  && grep -rlE '^[[:space:]]*extern[[:space:]]+"C"' src/ | sorted_paths)
if [ "${extern_files}" != "src/ggml_ffi.align" ]; then
  echo "layer forward smoke: FAIL an extern block appears outside src/ggml_ffi.align: ${extern_files}" >&2
  exit 1
fi
# Section 2.6's constraint, asserted rather than remembered: `raw` is refused as a struct field and
# as an array element at this pin, and the node-slot store exists because of it. A future pin that
# lifts the refusal should delete the store, not quietly grow an aggregate here. The scan is over
# **record declarations**, not over the word: a parameter list legitimately names `raw` on every
# handle-taking wrapper, and `src/gguf.align` legitimately binds a local called `raw`.
python3 - "${root_dir}" <<'SCAN'
import os
import re
import sys

root = sys.argv[1]
record = re.compile(r"^(pub )?[A-Z][A-Za-z0-9_]* \{$")
field = re.compile(r"^  [a-z_][A-Za-z0-9_]*: (raw|array<raw>|array_builder<raw>),?$")
offenders = []
for name in sorted(os.listdir(os.path.join(root, "src"))):
    if not name.endswith(".align"):
        continue
    path = os.path.join("src", name)
    inside = False
    with open(os.path.join(root, path), "r", encoding="utf-8") as handle:
        for number, line in enumerate(handle, 1):
            line = line.rstrip("\n")
            if record.match(line):
                inside = True
                continue
            if inside and line == "}":
                inside = False
                continue
            if inside and field.match(line):
                offenders.append("%s:%d: %s" % (path, number, line.strip()))
            if "array<raw>" in line or "array_builder<raw>" in line:
                offenders.append("%s:%d: %s" % (path, number, line.strip()))
if offenders:
    for row in offenders:
        sys.stderr.write("layer forward smoke: FAIL a raw handle is aggregated: %s\n" % row)
    raise SystemExit(1)
SCAN

# The nine shims and the executable are built **into the temporary tree**, not into the work tree.
# The fresh worker permits the whole `capable-checks` aggregate to leave exactly one file, `main`,
# in `/workspace` (`scripts/fresh-align-compiler`), and this runner is one of its members; a
# `build/` directory or a `ggml-spike` binary left behind fails the aggregate after every check has
# passed, with no output naming the cause. `alignc` writes its executable next to the invocation, so
# the one file it does create in the work tree is moved out in the same step.
shim_dir=$(ALIGN_LLM_GGML_SHIM_DIR="${work_dir}/lib" "${root_dir}/scripts/build-ggml-shim")
export ALIGN_LLM_GGML_SHIM_DIR="${work_dir}/lib"
shim_built=1
# The compiler's warnings are captured rather than streamed **under the fresh worker**, exactly as
# `Makefile`'s own `check` and `build` targets do. `src/ggml_spike.align` imports every arm, so one
# build of it writes **179,363 bytes** of `huge struct copy` and `lossy conversion` warnings —
# measured, not estimated, and 29,460 B of it in 142 lines from `src/moe_decode_step.align` alone.
# The supervisor bounds the whole `capable-checks` child at 65,536 bytes per stream
# (`scripts/fresh-align-compiler` `MAX_STREAM_BYTES`), so **one** build already exceeds the budget
# by 2.7x and an overflow kills the child with no message naming the cause. That is why the capture
# below is not an optimization: it is the only reason this runner is a member of the aggregate.
# Developers outside the fresh worker still see every warning.
(
  cd "${root_dir}"
  export LIBRARY_PATH="${shim_dir}${LIBRARY_PATH:+:${LIBRARY_PATH}}"
  export DYLD_LIBRARY_PATH="${shim_dir}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}"
  export LD_LIBRARY_PATH="${shim_dir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
  if [ "${ALIGN_LLM_FRESH_COMPILER:-0}" = 1 ]; then
    diagnostic="${work_dir}/alignc-diagnostic.txt"
    if ! "${compiler}" build src/ggml_spike.align >/dev/null 2>"${diagnostic}"; then
      cat "${diagnostic}" >&2
      exit 1
    fi
    rm -f "${diagnostic}"
  else
    "${compiler}" build src/ggml_spike.align >/dev/null
  fi
  mv -f ggml_spike "${work_dir}/ggml-spike"
)

python3 "${root_dir}/scripts/layer_forward_fixture.py" "${work_dir}" --model --moe >/dev/null

DYLD_LIBRARY_PATH="${shim_dir}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}" \
LD_LIBRARY_PATH="${shim_dir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
python3 - "${root_dir}" "${work_dir}" <<'PY'
import json
import os
import subprocess
import sys

root_dir, work_dir = sys.argv[1:3]
binary = os.path.join(work_dir, "ggml-spike")
builder = os.path.join(root_dir, "scripts", "build-ggml-shim")
golden_path = os.path.join(root_dir, "scripts", "layer-forward-golden.jsonl")
# The arm is pointed at a **writable copy** of the checked-in excerpt, never at the checked-in path.
# `layer_forward` opens its transcript with `fs.open_rw`, because Align ships no read-only
# random-access `file` constructor (`docs/align-requests.md` Request 21). A read-only checkout --
# which is exactly what the fresh trusted worker mounts, root-owned and read by an unprivileged uid,
# and what a CI artifact directory normally is -- then refuses the open with `R5_TRANSCRIPT` detail
# `Denied` before a byte is parsed. R2A hit the same wall on its own checked-in excerpt and fixed it
# the same way. The copy changes nothing the case asserts: `transcript_path` is a placeholder in
# every golden, and the bytes are the checked-in bytes.
checked_in_excerpt = os.path.join(root_dir, "eval", "fixtures", "qwen2-blk0-6tok.txt")
excerpt = os.path.join(work_dir, "qwen2-blk0-6tok.txt")
with open(checked_in_excerpt, "rb") as handle:
    excerpt_bytes = handle.read()
with open(excerpt, "wb") as handle:
    handle.write(excerpt_bytes)
update = os.environ.get("ALIGN_LLM_LAYER_FORWARD_GOLDEN_UPDATE") == "1"

ARM = "--layer-forward"
PACK = os.path.join(work_dir, "pack.alignpack")
GEOM = os.path.join(work_dir, "geometry.json")
TOKENS = "3,17,5"
SOURCE = os.path.join(work_dir, "source.bin")
TRANSCRIPT = os.path.join(work_dir, "transcript.txt")


def path(name):
    return os.path.join(work_dir, name)


def geom(name):
    return os.path.join(work_dir, name + ".json")


# Cases whose operands are rejected before any file work: no document at all, non-zero exit.
NO_DOCUMENT = [
    ("lf-arity-4", [ARM, PACK, "0", GEOM]),
    ("lf-arity-9", [ARM, PACK, "0", GEOM, TOKENS, "-", SOURCE, TRANSCRIPT, "extra"]),
    ("lf-path-pack-empty", [ARM, "", "0", GEOM, TOKENS]),
    ("lf-path-geometry-empty", [ARM, PACK, "0", "", TOKENS]),
    ("lf-path-long", [ARM, "/" + ("a" * 5000), "0", GEOM, TOKENS]),
    ("lf-path-doc-empty", [ARM, PACK, "0", GEOM, TOKENS, ""]),
    ("lf-path-reference-empty", [ARM, PACK, "0", GEOM, TOKENS, "-", ""]),
    ("lf-arm-unknown-flag", ["--layer-backward", PACK, "0", GEOM, TOKENS]),
]

# `(name, operands, expected error_code)`. The expectation is asserted **beside** the golden so a
# regenerated golden cannot silently accept a different code (section 4.5's "tolerance is not
# silently widened" cell, applied to every row).
STUB_CASES = [
    ("lf-stub-unavailable", [ARM, PACK, "0", GEOM, TOKENS], "R5_GGML_UNAVAILABLE"),
    ("lf-index-negative", [ARM, PACK, "-1", GEOM, TOKENS], "R5_INDEX"),
    ("lf-index-nonnumeric", [ARM, PACK, "1x", GEOM, TOKENS], "R5_INDEX"),
    ("lf-index-leading-zero", [ARM, PACK, "01", GEOM, TOKENS], "R5_INDEX"),
    ("lf-index-plus", [ARM, PACK, "+0", GEOM, TOKENS], "R5_INDEX"),
    ("lf-index-oob", [ARM, PACK, "2", GEOM, TOKENS], "R5_INDEX"),
    ("lf-tokens-empty", [ARM, PACK, "0", GEOM, ""], "R5_TOKENS"),
    ("lf-tokens-trailing", [ARM, PACK, "0", GEOM, "1,"], "R5_TOKENS"),
    ("lf-tokens-space", [ARM, PACK, "0", GEOM, "1, 2"], "R5_TOKENS"),
    # R6-DECODE-KV-STEP1 section 2.7 lifts `MAX_PREFILL_TOKENS` from 6 to 8, so the
    # over-cap fixture is nine tokens rather than seven. The case asserts the cap, not
    # a particular number, and nine is one past the new one exactly as seven was one
    # past the old one. `src/layer_olmoe.align` keeps its own cap at 6, so the routed
    # block below still refuses seven.
    # R6-PREFIX-TTFT lifts `MAX_PREFILL_TOKENS` 32 -> 2048. **2049 repetitions of token id 1,
    # not an ascending list:** this geometry's `n_vocab` is 32, so an ascending list would be refused
    # as out-of-vocabulary and the case would stop being about the cap.
    ("lf-tokens-2049", [ARM, PACK, "0", GEOM, ",".join(["1"] * 2049)], "R5_TOKENS"),
    # The other half of that lift, and the reason it is safe. `llama-eval-callback` prints a
    # tensor's rows in full only while `ne1 <= 6`; above it prints three leading and three trailing
    # rows and the scan's `printed_count` clamps to six on **both** sides. A seven- or eight-token
    # prefill with a transcript would therefore compare six of seven rows and report `PASS` about a
    # row it never saw, so the oracle refuses itself. The same operands **without** a transcript are
    # `lf-tokens-eight-no-transcript` below and run to the arm's ordinary stopping point, which is
    # what makes this a refusal of the oracle and not of the arithmetic.
    ("lf-tokens-seven-transcript",
     [ARM, PACK, "0", GEOM, "1,2,3,4,5,6,7", "-", SOURCE, TRANSCRIPT], "R5_ORACLE_TRUNCATED"),
    ("lf-tokens-eight-no-transcript",
     [ARM, PACK, "0", GEOM, "1,2,3,4,5,6,7,8", "-", SOURCE], "R5_GGML_UNAVAILABLE"),
    ("lf-tokens-oob", [ARM, PACK, "0", GEOM, "1,32"], "R5_TOKENS"),
    ("lf-geometry-unreadable", [ARM, PACK, "0", path("absent.json"), TOKENS],
     "R5_GEOMETRY_UNREADABLE"),
    ("lf-geometry-not-json", [ARM, PACK, "0", TRANSCRIPT, TOKENS], "R5_GEOMETRY"),
    ("lf-geometry-kind", [ARM, PACK, "0", geom("geometry-kind"), TOKENS], "R5_GEOMETRY"),
    ("lf-geometry-version", [ARM, PACK, "0", geom("geometry-version"), TOKENS], "R5_GEOMETRY"),
    ("lf-geometry-arch", [ARM, PACK, "0", geom("geometry-arch"), TOKENS], "R5_GEOMETRY"),
    ("lf-geometry-rope-type", [ARM, PACK, "0", geom("geometry-rope-type"), TOKENS], "R5_GEOMETRY"),
    ("lf-geometry-rope-scaled", [ARM, PACK, "0", geom("geometry-rope-scaled"), TOKENS],
     "R5_GEOMETRY"),
    ("lf-geometry-rope-dims", [ARM, PACK, "0", geom("geometry-rope-dims"), TOKENS], "R5_GEOMETRY"),
    ("lf-geometry-inconsistent", [ARM, PACK, "0", geom("geometry-inconsistent"), TOKENS],
     "R5_GEOMETRY"),
    ("lf-geometry-head-kv", [ARM, PACK, "0", geom("geometry-head-kv"), TOKENS], "R5_GEOMETRY"),
    ("lf-geometry-expert", [ARM, PACK, "0", geom("geometry-expert"), TOKENS], "R5_GEOMETRY"),
    ("lf-pack-missing", [ARM, path("absent.alignpack"), "0", GEOM, TOKENS], "R4_PACK_UNREADABLE"),
    ("lf-pack-truncated", [ARM, path("pack-truncated.alignpack"), "0", GEOM, TOKENS],
     "R4_PACK_TRUNCATED"),
    ("lf-block-missing", [ARM, path("pack-no-mlp.alignpack"), "0", GEOM, TOKENS],
     "R5_BLOCK_MISSING"),
    ("lf-member-missing", [ARM, path("pack-no-bias.alignpack"), "0", GEOM, TOKENS],
     "R5_MEMBER_MISSING"),
    ("lf-shape", [ARM, path("pack-bad-shape.alignpack"), "0", GEOM, TOKENS], "R5_SHAPE"),
    ("lf-stride", [ARM, path("pack-bad-stride.alignpack"), "0", GEOM, TOKENS], "R5_SHAPE"),
]

# Section 4.1's "a missing field" cell: one fixture per consumed `model` field, each of which must
# be `R5_GEOMETRY` naming that field and nothing else. The corpus has written these fifteen
# documents since the first implementation and no case referenced one, so the cell's evidence was
# a file on disk rather than a run (section 6, correction C20).
GEOMETRY_MISSING = [
    "arch", "n_layer", "n_embd", "n_head", "n_head_kv", "head_dim", "n_ff", "n_vocab",
    "n_expert", "context_length", "rms_eps_bits",
    "rope-type", "rope-dim_count", "rope-freq_base_bits", "rope-scaling_type",
]
STUB_CASES.extend(("lf-geometry-missing-" + field,
                   [ARM, PACK, "0", geom("geometry-missing-" + field), TOKENS],
                   "R5_GEOMETRY")
                  for field in GEOMETRY_MISSING)

# The bit patterns that are legal eight-hex-digit strings and illegal floats. `rms_eps_bits`
# reaches `ggml_rms_norm`, which asserts `eps >= 0.0f` inside ggml, and `GGML_ASSERT` is `abort()`:
# each of these is a SIGABRT with no document, no error code, and no teardown unless step 7 refuses
# it first (section 6, correction C17). They are stub-reachable because the refusal is Align's.
GEOMETRY_BITS = [
    "eps-nan", "eps-neg-inf", "eps-negative", "eps-all-ones",
    "rope-base-nan", "rope-base-inf", "rope-base-negative", "rope-base-zero",
]
STUB_CASES.extend(("lf-geometry-" + name,
                   [ARM, PACK, "0", geom("geometry-" + name), TOKENS],
                   "R5_GEOMETRY")
                  for name in GEOMETRY_BITS)

# Everything from step 18 onward. The engine build answers the whole contract; the default stub
# stops at step 17 and cannot reach one of these rows.
ENGINE_CASES = [
    ("lf-engine-ok", [ARM, PACK, "0", GEOM, TOKENS], ""),
    ("lf-engine-layer-1", [ARM, PACK, "1", GEOM, TOKENS], "R5_BLOCK_MISSING"),
    ("lf-engine-type", [ARM, path("pack-bad-type.alignpack"), "0", GEOM, TOKENS],
     "R5_TYPE_UNSUPPORTED"),
    ("lf-engine-alignment", [ARM, path("pack-tight.alignpack"), "0", GEOM, TOKENS],
     "R5_ALIGNMENT"),
    ("lf-engine-reference", [ARM, PACK, "0", GEOM, TOKENS, "-", SOURCE], ""),
    ("lf-engine-source-diverged",
     [ARM, PACK, "0", GEOM, TOKENS, "-", path("source-diverged.bin")], "R5_SOURCE_DIVERGED"),
    ("lf-engine-source-short",
     [ARM, PACK, "0", GEOM, TOKENS, "-", path("source-short.bin")], "R5_SOURCE_UNREADABLE"),
    ("lf-engine-source-missing",
     [ARM, PACK, "0", GEOM, TOKENS, "-", path("absent.bin")], "R5_SOURCE_UNREADABLE"),
    ("lf-engine-transcript", [ARM, PACK, "0", GEOM, TOKENS, "-", SOURCE, TRANSCRIPT], ""),
    ("lf-engine-transcript-missing",
     [ARM, PACK, "0", GEOM, TOKENS, "-", SOURCE, path("transcript-missing.txt")],
     "R5_ORACLE_MISSING"),
    ("lf-engine-transcript-shape",
     [ARM, PACK, "0", GEOM, TOKENS, "-", SOURCE, path("transcript-shape.txt")],
     "R5_ORACLE_SHAPE"),
    ("lf-engine-transcript-perturbed",
     [ARM, PACK, "0", GEOM, TOKENS, "-", SOURCE, path("transcript-perturbed.txt")], ""),
    # A transcript whose records all match by name and shape and carry no value block at all, and
    # one whose `l_out-0` block alone is deleted. Both used to be a `PASS` over zero compared
    # elements (section 6, correction C19).
    ("lf-engine-transcript-headers",
     [ARM, PACK, "0", GEOM, TOKENS, "-", SOURCE, path("transcript-headers.txt")],
     "R5_ORACLE_MISSING"),
    ("lf-engine-transcript-novalues",
     [ARM, PACK, "0", GEOM, TOKENS, "-", SOURCE, path("transcript-novalues.txt")],
     "R5_ORACLE_MISSING"),
    ("lf-engine-transcript-garbage",
     [ARM, PACK, "0", GEOM, TOKENS, "-", SOURCE, path("transcript-garbage.txt")], "R5_TRANSCRIPT"),
    # The checked-in real-model excerpt. Every one of its twenty records is found by name, op, and —
    # for the attention output projection — source weight name, so the only thing left to disagree
    # is the shape, which is exactly what a tiny-geometry pack must disagree about. That makes this
    # a hosted regression on the oracle's **parsing** against real instrument formatting.
    ("lf-engine-transcript-excerpt", [ARM, PACK, "0", GEOM, TOKENS, "-", SOURCE, excerpt],
     "R5_ORACLE_SHAPE"),
]

FORCED_CASES = [
    ("lf-force-init", "engine+init", [ARM, PACK, "0", GEOM, TOKENS], "R5_GGML_INIT"),
    ("lf-force-alloc", "engine+alloc", [ARM, PACK, "0", GEOM, TOKENS], "R5_ALLOC"),
    ("lf-force-compute", "engine+compute", [ARM, PACK, "0", GEOM, TOKENS], "R5_COMPUTE"),
    ("lf-force-reference", "engine+reference", [ARM, PACK, "0", GEOM, TOKENS, "-", SOURCE],
     "R5_REFERENCE_MISMATCH"),
    ("lf-force-slot-range", "engine+slot-range", [ARM, PACK, "0", GEOM, TOKENS], "R5_SLOT"),
    ("lf-force-slot-empty", "engine+slot-empty", [ARM, PACK, "0", GEOM, TOKENS], "R5_SLOT"),
    # Section 5.6's named risk, made observable: the engine's `gallocr` reuses a dead
    # intermediate's block exactly as ggml's does, so a node `mark_outputs` forgot is overwritten
    # before it is read back. The run stays `ok` — a wrong number is data — and the oracle must say
    # `FAIL` (section 6, correction C18).
    ("lf-force-no-mark-output", "engine+no-mark-output",
     [ARM, PACK, "0", GEOM, TOKENS, "-", SOURCE, TRANSCRIPT], ""),
    # `r5c-metal-prefill.md` section 6, correction C19: a **computed** activation with no
    # ten-thousandths value, which no operand can produce because every fixture's inputs are finite
    # and the engine's kernels are closed over them. The shim makes the first element of every
    # readback `+inf` and leaves the tensor data alone, so the graph still computes what it computed
    # and only the bytes the oracle reads back carry the value. Before C19 the conversion saturated,
    # `0 - difference` wrapped to `i64`'s minimum against a transcript value of zero, and the run
    # reported `PASS` over an element that is not a number.
    ("lf-force-inf-readback", "engine+inf-readback",
     [ARM, PACK, "0", GEOM, TOKENS, "-", SOURCE, TRANSCRIPT], ""),
]

PLACEHOLDER = {"pack_path": "<pack>", "geometry_path": "<geometry>",
               "reference_path": "<reference>", "transcript_path": "<transcript>"}


# A golden mismatch used to print both whole documents. One of these is 8 KB on its own, the fresh
# worker supervisor bounds the aggregate child at 65,536 bytes per stream, and the controller shows
# only the last 8,192 bytes of a failed worker's stderr — so the one line naming the case scrolled
# out of the diagnostic and the failure was unreadable exactly where it mattered. Report the field
# paths that differ instead: it is what a reader needs, and it fits.
def describe_difference(expected_text, actual_text, limit=8):
    if actual_text is None:
        return "no document was produced"
    try:
        expected = json.loads(expected_text)
        actual = json.loads(actual_text)
    except Exception as error:  # noqa: BLE001 - the document is the thing under test
        return "the documents are not both JSON: %s" % error
    differences = []

    def walk(left, right, path):
        if len(differences) >= limit:
            return
        if type(left) is not type(right):
            differences.append("%s: %r != %r" % (path or ".", left, right))
        elif isinstance(left, dict):
            for key in sorted(set(left) | set(right)):
                if len(differences) >= limit:
                    return
                if key not in left:
                    differences.append("%s.%s: absent != %r" % (path, key, right[key]))
                elif key not in right:
                    differences.append("%s.%s: %r != absent" % (path, key, left[key]))
                else:
                    walk(left[key], right[key], "%s.%s" % (path, key))
        elif isinstance(left, list):
            if len(left) != len(right):
                differences.append("%s: %d entries != %d" % (path, len(left), len(right)))
                return
            for index in range(len(left)):
                if len(differences) >= limit:
                    return
                walk(left[index], right[index], "%s[%d]" % (path, index))
        elif left != right:
            differences.append("%s: %r != %r" % (path or ".", left, right))

    walk(expected, actual, "")
    if not differences:
        return "the documents differ only in text form"
    return "expected != actual at " + "; ".join(differences)


def normalize(text):
    document = json.loads(text)
    for key in document["timings"]:
        document["timings"][key] = 0
    for key, placeholder in PLACEHOLDER.items():
        if document[key]:
            document[key] = placeholder
    return json.dumps(document, separators=(",", ":"), ensure_ascii=False)


def build_shim(force):
    environment = dict(os.environ)
    environment.pop("ALIGN_LLM_GGML_INCLUDE", None)
    environment.pop("ALIGN_LLM_GGML_LIB", None)
    if force:
        environment["ALIGN_LLM_GGML_FORCE"] = force
    else:
        environment.pop("ALIGN_LLM_GGML_FORCE", None)
    subprocess.run([builder], check=True, capture_output=True, env=environment)


def run(operands):
    return subprocess.run([binary] + operands, capture_output=True, cwd=work_dir)


failures = []
produced = {}
codes = set()


def record(name, operands, expected):
    result = run(operands)
    if result.stdout == b"":
        failures.append("%s: no document (exit %d): %s"
                        % (name, result.returncode,
                           result.stderr.decode("utf-8", "replace")[-400:]))
        return None
    try:
        document = json.loads(result.stdout.decode("utf-8"))
    except Exception as error:  # noqa: BLE001 - the document is the thing under test
        failures.append("%s: the document is not valid JSON: %s" % (name, error))
        return None
    produced[name] = normalize(result.stdout.decode("utf-8"))
    codes.add(document["error_code"])
    if document["error_code"] != expected:
        failures.append("%s: expected error_code %r, got %r (%r)"
                        % (name, expected, document["error_code"], document["error_detail"]))
    expected_exit = 0 if document["status"] == "ok" else 1
    if (result.returncode == 0) != (expected_exit == 0):
        failures.append("%s: status %r but exit %d"
                        % (name, document["status"], result.returncode))
    if document["kind"] != "R5_LAYER_FORWARD" or document["schema_version"] != 1:
        failures.append("%s: wrong document identity %r/%r"
                        % (name, document["kind"], document["schema_version"]))
    # The golden corpus is generated from the stub engine's kernels, and whether `a * b + c` is
    # contracted into one fused multiply-add is a per-compiler, per-target choice: Apple clang on
    # arm64 contracts, GCC 13 on x86-64 does not, and twelve of these documents differ between the
    # two. `scripts/build-ggml-shim` passes `-ffp-contract=off`; this asserts that the library the
    # run actually loaded does not contract, which `align_ggml_fp_contract_off` answers from a
    # behavioural probe rather than from the build define (section 6, correction C15).
    #
    # `-ffp-contract=off` is **necessary but not sufficient** for a portable golden corpus. The stub
    # engine calls libm -- `expf` in soft-max and SiLU, `sinf`/`cosf` in RoPE, `powf` for the RoPE
    # theta scale -- and none of those four is required to be correctly rounded, so Apple libm and
    # glibc may differ in the last bit on some inputs. (`sqrtf` in RMS norm is exempt: IEEE-754
    # requires square root to be correctly rounded, so it cannot differ between conforming hosts.) This fixture's shapes make 770 such
    # calls over 73 distinct inputs, and every one of them was verified to agree bit for bit against
    # glibc 2.39. That is a measured property of this corpus, not a guarantee about libm: the
    # goldens below are the detector for any such divergence, and this flag is the diagnosis for the
    # one cause it can name.
    if not document["abi"]["fp_contract_off"]:
        failures.append("%s: the shim was not built with -ffp-contract=off; the goldens are not "
                        "reproducible across compilers" % name)
    return document


for name, operands in NO_DOCUMENT:
    result = run(operands)
    if result.returncode == 0:
        failures.append("%s: expected a non-zero exit, got 0" % name)
    if result.stdout != b"":
        failures.append("%s: expected no document, got %d bytes" % (name, len(result.stdout)))

# R4.5's arm is untouched: a first operand that is not a flag selects it, with its own document.
r45 = run([PACK, "1", "1"])
if r45.stdout == b"":
    failures.append("arm-r45-unchanged: the R4.5 arm produced no document")
else:
    kind = json.loads(r45.stdout.decode("utf-8"))["kind"]
    if kind != "R4_5_EXTERNAL_BUFFER":
        failures.append("arm-r45-unchanged: the R4.5 arm emitted %r" % kind)

for name, operands, expected in STUB_CASES:
    document = record(name, operands, expected)
    if document is None:
        continue
    lifetime = document["lifetime"]
    for key in ("ggml_buffers_created", "contexts_created", "backends_created",
                "gallocrs_created"):
        if lifetime[key] != 0:
            failures.append("%s: lifetime.%s is %d in a default stub build, not 0"
                            % (name, key, lifetime[key]))

build_shim("engine")
for name, operands, expected in ENGINE_CASES:
    document = record(name, operands, expected)
    if document is None:
        continue
    if document["status"] == "ok":
        if document["verdict"] != "EXTERNAL":
            failures.append("%s: verdict %r, not EXTERNAL" % (name, document["verdict"]))
        if document["graph"]["node_count"] != 32:
            failures.append("%s: graph.node_count %d, not 32"
                            % (name, document["graph"]["node_count"]))
        if len(document["members"]) != 13:
            failures.append("%s: %d members, not 13" % (name, len(document["members"])))
        if len(document["nodes"]) != 20:
            failures.append("%s: %d nodes, not 20" % (name, len(document["nodes"])))
        if not all(m["pointer_identity"] for m in document["members"]):
            failures.append("%s: a weight tensor is not at its own window offset" % name)
        if document["members"][0]["pread_count"] != 3:
            failures.append("%s: token_embd pread_count %d, not one per token"
                            % (name, document["members"][0]["pread_count"]))
        if any(m["pread_count"] != 1 for m in document["members"][1:]):
            failures.append("%s: a block member was not covered by exactly one pread" % name)
        excluded = [n["id"] for n in document["nodes"]
                    if n["oracle"] == "shape_incomparable"]
        if excluded != ["kq", "kq_soft_max"]:
            failures.append("%s: shape_incomparable nodes are %r" % (name, excluded))
        if not document["abi"]["slot_magic_ok"]:
            failures.append("%s: the slot store magic did not validate" % name)
        # Scanned from the store rather than derived from the node table, so it can disagree with
        # it. What a high-water mark can show is a **missing top slot**: the scan returns the
        # highest occupied index plus one, so a walk that skipped a slot below the top still leaves
        # 48 here and the goldens are what catch it (section 6, correction C16).
        if document["graph"]["slot_high_water"] != 48:
            failures.append("%s: slot_high_water %d, not the 48 slots the layer writes"
                            % (name, document["graph"]["slot_high_water"]))
        if document["graph"]["slot_capacity"] != 128:
            failures.append("%s: slot_capacity %d, not 128"
                            % (name, document["graph"]["slot_capacity"]))
        lifetime = document["lifetime"]
        if not lifetime["released_before_owner_scope_end"]:
            failures.append("%s: the teardown did not balance" % name)
        for created, freed in (("ggml_buffers_created", "ggml_buffers_freed"),
                               ("contexts_created", "contexts_freed"),
                               ("backends_created", "backends_freed"),
                               ("gallocrs_created", "gallocrs_freed")):
            if lifetime[created] != lifetime[freed]:
                failures.append("%s: %s %d != %s %d"
                                % (name, created, lifetime[created], freed, lifetime[freed]))

reference = produced and json.loads(run([ARM, PACK, "0", GEOM, TOKENS, "-", SOURCE]).stdout)
if reference:
    if reference["reference"]["verdict"] != "IDENTICAL":
        failures.append("lf-engine-reference: verdict %r" % reference["reference"]["verdict"])
    if reference["reference"]["nodes_compared"] != 20 \
            or reference["reference"]["nodes_identical"] != 20:
        failures.append("lf-engine-reference: %d/%d nodes identical"
                        % (reference["reference"]["nodes_identical"],
                           reference["reference"]["nodes_compared"]))

# Section 4.5's two oracle cells: an exact pass at zero, and a breach that is a `FAIL` verdict on a
# successful run rather than an error code.
passing = json.loads(run([ARM, PACK, "0", GEOM, TOKENS, "-", SOURCE, TRANSCRIPT]).stdout)
oracle = passing["oracle"]
if oracle["verdict"] != "PASS":
    failures.append("lf-engine-transcript: verdict %r, worst %r@%d, max_abs %d, max_sum %d"
                    % (oracle["verdict"], oracle["worst_node"], oracle["worst_element_index"],
                       oracle["max_abs_diff_ten_thousandths"], oracle["max_sum_diff_millionths"]))
if oracle["max_abs_diff_ten_thousandths"] != 0:
    failures.append("lf-engine-transcript: max_abs_diff_ten_thousandths %d, not 0"
                    % oracle["max_abs_diff_ten_thousandths"])
if oracle["nodes_expected"] != 18 or oracle["nodes_matched"] != 18:
    failures.append("lf-engine-transcript: %d/%d nodes matched"
                    % (oracle["nodes_matched"], oracle["nodes_expected"]))
if oracle["elements_compared"] <= 0:
    failures.append("lf-engine-transcript: zero elements compared with a PASS verdict")
if oracle["tolerance_ten_thousandths"] != 1:
    failures.append("lf-engine-transcript: tolerance widened to %d"
                    % oracle["tolerance_ten_thousandths"])

breached = json.loads(
    run([ARM, PACK, "0", GEOM, TOKENS, "-", SOURCE, path("transcript-perturbed.txt")]).stdout)
if breached["status"] != "ok" or breached["oracle"]["verdict"] != "FAIL":
    failures.append("lf-engine-transcript-perturbed: status %r verdict %r"
                    % (breached["status"], breached["oracle"]["verdict"]))
if breached["oracle"]["worst_node"] != "l_out":
    failures.append("lf-engine-transcript-perturbed: worst_node %r"
                    % breached["oracle"]["worst_node"])

# Both output forms emit byte-identical document bytes (section 3.3).
document_path = os.path.join(work_dir, "layer.json")
stdout_form = run([ARM, PACK, "0", GEOM, TOKENS]).stdout.decode("utf-8").rstrip("\n")
run([ARM, PACK, "0", GEOM, TOKENS, document_path])
with open(document_path, "r", encoding="utf-8") as handle:
    file_form = handle.read()
if normalize(stdout_form) != normalize(file_form):
    failures.append("the stdout and file forms differ")
dash_form = run([ARM, PACK, "0", GEOM, TOKENS, "-"]).stdout.decode("utf-8").rstrip("\n")
if normalize(dash_form) != normalize(stdout_form):
    failures.append("the `-` form differs from the five-operand form")

# Three consecutive runs of the same operands are byte-identical once the wall clock is normalised.
repeats = {normalize(run([ARM, PACK, "0", GEOM, TOKENS, "-", SOURCE, TRANSCRIPT])
                     .stdout.decode("utf-8")) for _ in range(3)}
if len(repeats) != 1:
    failures.append("three consecutive runs produced %d distinct documents" % len(repeats))

forced_documents = {}
for name, force, operands, expected in FORCED_CASES:
    build_shim(force)
    forced_documents[name] = record(name, operands, expected)

build_shim(None)

unmarked = forced_documents.get("lf-force-no-mark-output")
if unmarked is not None and unmarked["oracle"]["verdict"] != "FAIL":
    failures.append("lf-force-no-mark-output: ggml_set_output was dropped and the oracle still "
                    "reported %r -- the allocator is not reusing an unmarked node's memory, so "
                    "this owner cannot see a missing mark_outputs"
                    % unmarked["oracle"]["verdict"])

# `r5c-metal-prefill.md` section 6, correction C19. Both halves of the class are asserted: the
# element comparison resolves an unrepresentable activation to the scale limit, and the sum
# comparison — which covers the elements the transcript never printed — resolves it to the sentinel.
# Either one alone would leave the other's wrap unobserved.
SCALE_LIMIT_TEN_THOUSANDTHS = 1000000000000000
UNREPRESENTABLE = 9223372036854775807
infinite = forced_documents.get("lf-force-inf-readback")
if infinite is not None:
    oracle = infinite["oracle"]
    if infinite["status"] != "ok" or oracle["verdict"] != "FAIL" \
            or oracle["max_abs_diff_ten_thousandths"] != SCALE_LIMIT_TEN_THOUSANDTHS \
            or oracle["max_sum_diff_millionths"] != UNREPRESENTABLE:
        failures.append("lf-force-inf-readback: a +inf activation resolved to %r -- a saturating "
                        "`as i64` is back and a non-finite element can pass" % oracle)

REQUIRED_CODES = {
    "R5_INDEX", "R5_TOKENS", "R5_GEOMETRY_UNREADABLE", "R5_GEOMETRY", "R4_PACK_UNREADABLE",
    "R5_BLOCK_MISSING", "R5_MEMBER_MISSING", "R5_SHAPE", "R5_GGML_UNAVAILABLE",
    "R5_TYPE_UNSUPPORTED", "R5_ALIGNMENT", "R5_GGML_INIT", "R5_SLOT", "R5_ALLOC", "R5_COMPUTE",
    "R5_SOURCE_UNREADABLE", "R5_SOURCE_DIVERGED", "R5_REFERENCE_MISMATCH", "R5_TRANSCRIPT",
    "R5_ORACLE_MISSING", "R5_ORACLE_SHAPE", "R5_ORACLE_TRUNCATED",
}
missing_codes = REQUIRED_CODES - codes
if missing_codes:
    failures.append("codes never reached: %s" % ", ".join(sorted(missing_codes)))

ORDER = ([name for name, _, _ in STUB_CASES]
         + [name for name, _, _ in ENGINE_CASES]
         + [name for name, _, _, _ in FORCED_CASES])

if update:
    with open(golden_path, "w", encoding="utf-8") as handle:
        for name in ORDER:
            handle.write(json.dumps({"case": name, "document": produced[name]},
                                    separators=(",", ":"), ensure_ascii=False) + "\n")
    print("layer forward smoke: golden rewritten with %d cases" % len(produced))
else:
    with open(golden_path, "r", encoding="utf-8") as handle:
        golden = [json.loads(line) for line in handle if line.strip()]
    if [row["case"] for row in golden] != ORDER:
        failures.append("the golden case list does not match the runner's case list")
    else:
        for row in golden:
            if produced.get(row["case"]) != row["document"]:
                failures.append("golden mismatch for %s: %s"
                                % (row["case"],
                                   describe_difference(row["document"],
                                                       produced.get(row["case"]))))

if failures:
    for line in failures:
        sys.stderr.write("layer forward smoke: FAIL %s\n" % line)
    raise SystemExit(1)

# Section 4.6's count, as a number this runner produces rather than a claim: twenty-two codes are
# observed in a document, and `R5_ARITY` and `R5_PATH` are observed as the absence of one.
print("layer forward smoke: %d no-document cases (R5_ARITY, R5_PATH), %d documented cases, "
      "%d of the 26 codes reached, both oracles, and the shared shim contract PASS"
      % (len(NO_DOCUMENT), len(ORDER), len(codes - {""}) + 2))
PY

