# The generator's own greedy ids: one per line, `K` lines, the ids its own reference loop
# **consumed**. The arm derives step 1's token from its own prefill logits and every later step's
# from its own previous step (R6 section 2.1, R6-STEP-N section 3.2), and never takes any of them as
# an operand, so this file is what makes "the arm decoded the tokens the reference decoded" an
# assertion rather than a coincidence.
with open(path("model-decode-tokens.txt"), "r", encoding="utf-8") as handle:
    EXPECTED_TOKENS = [int(line) for line in handle.read().split()]
EXPECTED_TOKEN = EXPECTED_TOKENS[0]
# R6-STEP-N section 4.7. **The reference chain must be non-degenerate, and this block refuses to run
# if it is not.** Every per-step assertion below — `token_ids` against the reference, the
# `argmax`-to-next-`token_id` chain, and the distinct digests — is satisfied by an arm that decoded
# step 1 and then fed its own first token to every later step, so long as the reference ids are all
# equal. They are not equal by construction (`MODEL_DECODE_RESEEDED_ROWS`), and this is the guard
# that keeps them that way rather than trusting the generator.
if len(set(EXPECTED_TOKENS)) != len(EXPECTED_TOKENS):
    sys.stderr.write("decode step smoke: FAIL the reference decode loop is degenerate: %r\n"
                     % (EXPECTED_TOKENS,))
    raise SystemExit(1)

# R6-STEP-N section 2.2's arity rule: five, six, seven, nine, ten, or **eleven** operands. **Eight is
# still `R6_ARITY`** and the gap is the contract, inherited verbatim from `--model-forward`.
#
# `--decode-stepped` is not and will not be an arm. R6 used `--decode-steps` here, and R6-STEP-N
# would have turned that negative case positive had it shipped a second arm; it ships a `STEPS`
# operand instead, and the case moves to a flag that stays unknown.
NO_DOCUMENT = [
    ("ds-arity-3", [ARM, PACK, GEOM]),
    ("ds-arity-8", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, TRANSCRIPT]),
    # R6-KV-PERSIST section 5.3, R6-RESIDENT-WEIGHTS section 5.1, and R6-PREFIX-SUFFIX-PREFILL
    # section 5.2: the over-arity case moves up one position each time the grammar grows,
    # `ds-arity-12` -> `ds-arity-14` -> `ds-arity-15` -> `ds-arity-16` -> `ds-arity-17`. It is
    # `NO_DOCUMENT` and carries no golden row, so the move costs zero golden bytes. **Sixteen
    # operands is now legal** and is `ds-store-*` below: an unusable sixteenth operand owes the
    # caller a document or a path refusal naming it, and only a seventeenth is arity.
