# Available, and no device of type GPU in the registry: section 3.9 step 20a, the arm's own first
# code. Section 4.3's `gf-no-gpu` cell.
NO_GPU_CASES = [
    ("gf-no-gpu", [ARM, PACK, GEOM, TOKENS], "R5C_GPU_UNAVAILABLE"),
]

# A stub GPU device that otherwise behaves as R5B's engine: the arm's whole successful path, its
