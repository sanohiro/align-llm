PLACEHOLDER = {"pack_path": "<pack>", "geometry_path": "<geometry>",
               "reference_path": "<reference>", "transcript_path": "<transcript>",
               "logits_path": "<logits>"}


def describe_difference(expected_text, actual_text, limit=8):
    if actual_text is None:
        return "no document was produced"
    try:
        expected = json.loads(expected_text)
        actual = json.loads(actual_text)
    except Exception as error:  # noqa: BLE001 - the document is the thing under test
        return "the documents are not both JSON: %s" % error
    differences = []

    def walk(left, right, path_text):
        if len(differences) >= limit:
            return
        if type(left) is not type(right):
            differences.append("%s: %r != %r" % (path_text or ".", left, right))
        elif isinstance(left, dict):
            for key in sorted(set(left) | set(right)):
                if len(differences) >= limit:
                    return
                if key not in left:
                    differences.append("%s.%s: absent != %r" % (path_text, key, right[key]))
                elif key not in right:
                    differences.append("%s.%s: %r != absent" % (path_text, key, left[key]))
                else:
                    walk(left[key], right[key], "%s.%s" % (path_text, key))
        elif isinstance(left, list):
            if len(left) != len(right):
                differences.append("%s: %d entries != %d" % (path_text, len(left), len(right)))
                return
            for index in range(len(left)):
                if len(differences) >= limit:
                    return
                walk(left[index], right[index], "%s[%d]" % (path_text, index))
        elif left != right:
            differences.append("%s: %r != %r" % (path_text or ".", left, right))

    walk(expected, actual, "")
    if not differences:
        return "the documents differ only in text form"
    return "expected != actual at " + "; ".join(differences)


def normalize(text):
    """Every nanosecond field is zeroed, wherever it lives — and **nothing else is**.

    `routed`, `residency`, and every `*_bytes` and `*_ppm` field are deterministic and are the
    capability's claim, so a normalizer that reached them would erase the measurement it exists to
    protect. The per-step `compute_ns` array is the exact place a golden goes non-deterministic and
    it is reached by the same `_ns` rule."""
    document = json.loads(text)

    def scrub(node):
        if isinstance(node, dict):
            for key in node:
                if key.endswith("_ns") and isinstance(node[key], int):
                    node[key] = 0
                else:
                    scrub(node[key])
        elif isinstance(node, list):
            for item in node:
                scrub(item)

    scrub(document)
    # R6-MOE-RESIDENT-DENSE section 3.8. `fill_ns` is the only clock the `weights` object holds and
    # the `_ns` rule above already reached it; it is named here so the exemption list is explicit.
    # `resident_bytes`, `fill_pread_count`, `fill_bytes`, `step_dense_pack_bytes`,
    # `step_expert_pack_bytes`, `step_pack_bytes`, `wrap_count` and both wrap counters are
    # deliberately **not** normalized: they are deterministic and they are the claim.
    document["weights"]["fill_ns"] = 0
    for key, placeholder in PLACEHOLDER.items():
        if document[key]:
            document[key] = placeholder
    return json.dumps(document, separators=(",", ":"), ensure_ascii=False)


# R6-MOE-RESIDENT-DENSE section 4.1, **oracle D**. It is named D and not R deliberately: item 32's
# oracle R is the routing-identity oracle and keeps its name, and this document runs both.
#
# `normalize` plus the `weights` object and exactly ten field names, enumerated here rather than
# pattern-matched so the exclusion cannot quietly grow:
#
#   * `weights`, which is the capability's own report;
#   * `pack.reader_pread_count` / `reader_bytes_read`, which are the claim;
#   * `lifetime.ggml_buffers_created` / `_freed`, because the dense window's per-graph wrap is
#     replaced by one run-scope wrap counted in its own pair (section 4.3);
#   * the six `window.dense_*` and `window.reuse_count` fields, which describe a streamed window this
#     run does not have.
#
# What stays inside the comparison is the point: the **whole** `residency` object — including
# `expert_bytes_read`, which is precisely the number section 4.4 exists to protect — every
# `steps[i].token_id`, `routed.layers[]`, `residency.*` and `sha256`, `window.member_placements`,
# `window.claim_placements`, `window.pointer_identity_failures`, the head's logits, `graph` in full,
# `verdict`, and `error_code`/`error_detail`.
RESIDENT_EXCLUDED_BLOCKS = ("weights",)
RESIDENT_EXCLUDED_FIELDS = (
    ("pack", "reader_pread_count"), ("pack", "reader_bytes_read"),
    ("lifetime", "ggml_buffers_created"), ("lifetime", "ggml_buffers_freed"),
    ("window", "dense_bytes"), ("window", "dense_peak_block_index"),
    ("window", "dense_peak_block_kind"), ("window", "dense_peak_block_layer"),
    ("window", "dense_peak_block_bytes"), ("window", "reuse_count"),
)


def normalize_resident(text):
    document = json.loads(text)
    for block in RESIDENT_EXCLUDED_BLOCKS:
        document.pop(block, None)
    for block, field in RESIDENT_EXCLUDED_FIELDS:
        document[block].pop(field, None)
    return json.dumps(document, separators=(",", ":"), ensure_ascii=False)


def normalize_cache_semantics(text):
    """Remove only the cache transport/accounting fields before comparing with `dense`."""
    document = json.loads(normalize_resident(text))
    document["schema_version"] = 2
    document["residency"].pop("decode_expert_pread_bytes", None)
    for row in document["steps"]:
        residency = row["residency"]
        for field in ("expert_pread_bytes", "expert_read_amplification_ppm", "cache_hits",
                      "cache_misses", "cache_evictions", "cache_bytes_served",
                      "cache_miss_bytes", "cache_bytes_fetched"):
            residency.pop(field, None)
    return json.dumps(document, separators=(",", ":"), ensure_ascii=False)


def build_shim(force):
    environment = dict(os.environ)
    environment.pop("ALIGN_LLM_GGML_INCLUDE", None)
    environment.pop("ALIGN_LLM_GGML_LIB", None)
    if force:
        environment["ALIGN_LLM_GGML_FORCE"] = force
    else:
        environment.pop("ALIGN_LLM_GGML_FORCE", None)
    subprocess.run([builder], check=True, capture_output=True, env=environment)


def run(argv):
    return subprocess.run([binary] + argv, capture_output=True, cwd=work_dir)


failures = []
produced = {}
codes = set()


def record(name, argv, expected):
    result = run(argv)
    if result.stdout == b"":
        failures.append("%s: no document (exit %d): %s"
                        % (name, result.returncode,
                           result.stderr.decode("utf-8", "replace")[-400:]))
        return None
    try:
        document = json.loads(result.stdout.decode("utf-8"))
    except Exception as error:  # noqa: BLE001 - the document is the thing under test
        failures.append("%s: the document is not valid JSON: %s" % (name, error))
        return None
    produced[name] = normalize(result.stdout.decode("utf-8"))
    codes.add(document["error_code"])
    if document["error_code"] != expected:
        failures.append("%s: expected error_code %r, got %r (%r)"
                        % (name, expected, document["error_code"], document["error_detail"]))
    if (result.returncode == 0) != (document["status"] == "ok"):
        failures.append("%s: status %r but exit %d"
                        % (name, document["status"], result.returncode))
    weights = document.get("weights")
    cache_document = isinstance(weights, dict) and weights.get("mode") == "dense+lru"
    expected_schema = 3 if cache_document else 2
    if document["kind"] != "R6_MOE_DECODE_STEP" or document["schema_version"] != expected_schema:
        failures.append("%s: wrong document identity %r/%r"
                        % (name, document["kind"], document["schema_version"]))
    # R6-MOE-RESIDENT-DENSE section 3.8: the `weights` object is present in **every** document,
    # including one refused before a file is opened, so the mode a run took is never implicit. The
    # hazard it closes is a caller who wanted residency, forgot the operand, and read a document that
    # did not say so.
    if not isinstance(weights, dict) or weights.get("mode") not in ("stream", "dense", "dense+lru"):
        failures.append("%s: the document published no weights mode: %r" % (name, weights))
    elif weights["mode"] == "stream" and (weights["resident_bytes"] != 0
                                          or weights["fill_ns"] != 0
                                          or weights["fill_pread_count"] != 0
                                          or weights["fill_bytes"] != 0
                                          or weights["resident_wraps_created"] != 0
                                          or weights["resident_wraps_freed"] != 0):
        failures.append("%s: a streamed document published resident figures: %r" % (name, weights))
    if isinstance(weights, dict) \
            and weights["step_pack_bytes"] != (weights["step_dense_pack_bytes"]
                                               + weights["step_expert_pack_bytes"]):
        failures.append("%s: step_pack_bytes is not the sum of its two terms: %r" % (name, weights))
    if cache_document and not isinstance(weights.get("expert_cache"), dict):
        failures.append("%s: schema 3 published no expert_cache evidence: %r" % (name, weights))
    if not cache_document and isinstance(weights, dict) and "expert_cache" in weights:
        failures.append("%s: schema 2 unexpectedly published expert_cache: %r" % (name, weights))
    if not document["abi"]["fp_contract_off"]:
        failures.append("%s: the shim was not built with -ffp-contract=off; the goldens are not "
                        "reproducible across compilers" % name)
    # `decode.steps_requested` is published in **every** document, including one refused before the
    # count is validated, so the count is never implicit in the output.
    if document["decode"]["steps_requested"] <= 0 and "md-steps" not in name:
        failures.append("%s: decode.steps_requested is %d in a document that named a count"
                        % (name, document["decode"]["steps_requested"]))
    # A partial step publishes no object: the row count and the id list are the completed steps'.
    steps = document["steps"]
    if len(steps) != document["decode"]["steps_completed"]:
        failures.append("%s: %d steps[] objects against steps_completed %d"
                        % (name, len(steps), document["decode"]["steps_completed"]))
    if [row["token_id"] for row in steps] != document["decode"]["token_ids"]:
        failures.append("%s: decode.token_ids disagrees with steps[].token_id" % name)
    for index, row in enumerate(steps):
        if row["index"] != index + 1:
            failures.append("%s: steps[%d].index is %d" % (name, index, row["index"]))
    lifetime = document["lifetime"]
    if lifetime["graph_balance_failures"] != 0:
        failures.append("%s: %d graph balance failure(s)"
                        % (name, lifetime["graph_balance_failures"]))
    for created, freed in (("ggml_buffers_created", "ggml_buffers_freed"),
                           ("contexts_created", "contexts_freed"),
                           ("backends_created", "backends_freed"),
                           ("gallocrs_created", "gallocrs_freed")):
        if lifetime[created] != lifetime[freed]:
            failures.append("%s: %s %d != %s %d"
                            % (name, created, lifetime[created], freed, lifetime[freed]))
    return document


for name, argv in NO_DOCUMENT:
    result = run(argv)
    if result.returncode == 0:
        failures.append("%s: expected a non-zero exit, got 0" % name)
    if result.stdout != b"":
        failures.append("%s: expected no document, got %d bytes" % (name, len(result.stdout)))

# The six arms before this one are untouched: the first operand selects an arm and nothing else, and
# `--decode-step` still refuses an OLMoE geometry by name rather than computing it.
for label, arm, argv, kind in (
        ("arm-r5e-unchanged", "--moe-model-forward",
         [PACK, GEOM, TOKENS, WIDTH], "R5_MOE_MODEL_FORWARD"),
        ("arm-r6-unchanged", "--decode-step",
         [os.path.join(work_dir, "model-pack.alignpack"),
          os.path.join(work_dir, "geometry.json"), "3,17,5"], "R6_DECODE_STEP")):
    other = run([arm] + argv)
    if other.stdout == b"":
        failures.append("%s: the arm produced no document" % label)
    else:
        got = json.loads(other.stdout.decode("utf-8"))["kind"]
        if got != kind:
            failures.append("%s: the arm emitted %r" % (label, got))

# `--decode-step`'s OLMoE refusal keeps its meaning **byte for byte** and now has an answer.
arch_refusal = run(["--decode-step", PACK, GEOM, TOKENS])
if arch_refusal.stdout == b"":
    failures.append("arm-r6-arch-refusal: the dense arm produced no document")
else:
    refused = json.loads(arch_refusal.stdout.decode("utf-8"))
    if refused["error_code"] != "R6_ARCH_UNSUPPORTED" or refused["error_detail"] != "n_expert":
        failures.append("arm-r6-arch-refusal: %r/%r"
                        % (refused["error_code"], refused["error_detail"]))

for name, argv, expected in STUB_CASES:
    document = record(name, argv, expected)
    if document is None:
        continue
    lifetime = document["lifetime"]
    for key in ("ggml_buffers_created", "contexts_created", "backends_created",
                "gallocrs_created"):
        if lifetime[key] != 0:
            failures.append("%s: lifetime.%s is %d in a default stub build, not 0"
                            % (name, key, lifetime[key]))

build_shim("engine")
PLANE_BYTES = 2 * 2 * 8 * 2 * 4 * 4
COLUMN_BYTES = 2 * 4 * 4
PLANE_STRIDE = 8 * 2 * 4 * 4
for name, argv, expected in ENGINE_CASES:
    document = record(name, argv, expected)
    if document is None:
        continue
    plane = document["plane"]
    graph = document["graph"]
    # The plane's size and the three table row counts are published by the schedule, so a case that
    # is refused before the schedule runs reports zeros and is not asserted about here.
    if document["status"] != "ok":
        continue
    # Section 3.4's layout, at OLMoE's geometry and this corpus's width, asserted as arithmetic and
    # not as a remembered number.
    if plane["bytes"] != PLANE_BYTES or plane["stride"] != PLANE_STRIDE:
        failures.append("%s: plane %d bytes / stride %d, not %d/%d"
                        % (name, plane["bytes"], plane["stride"], PLANE_BYTES, PLANE_STRIDE))
    # Section 3.7's derived row counts, published rather than assumed: the decode phase-A table is
    # the prefill's thirty-five rows plus the two `CONCAT`s, and phase B is `2u + 8` in both.
    # `n_expert_used` is read from the document rather than assumed: the two deviation-3 cases run
    # the same pack at 6 and 8, and every count below that depends on `u` is written as its formula
    # so those cases assert the same relations at their own width instead of being skipped.
    used = document["model"]["n_expert_used"]
    if graph["table_rows_a"] != 35 or graph["table_rows_a_decode"] != 37 \
            or graph["table_rows_b"] != 2 * used + 8:
        failures.append("%s: tables %d/%d/%d, not 35/37/%d at n_expert_used %d"
                        % (name, graph["table_rows_a"], graph["table_rows_a_decode"],
                           graph["table_rows_b"], 2 * used + 8, used))
    if document["verdict"] != "EXTERNAL":
        failures.append("%s: verdict %r, not EXTERNAL" % (name, document["verdict"]))
    if document["selection"]["narrow_layer"] != -1 \
            or document["selection"]["narrow_index"] != -1:
        failures.append("%s: a decode graph does not narrow, so both fields must be -1: %r"
                        % (name, document["selection"]))
    if plane["source"] != "PREFILL":
        failures.append("%s: plane.source %r" % (name, plane["source"]))
    if plane["roundtrip_verdict"] != "IDENTICAL":
        failures.append("%s: oracle B is %r" % (name, plane["roundtrip_verdict"]))
    completed = document["decode"]["steps_completed"]
    if plane["columns_written"] != 3 + completed:
        failures.append("%s: columns_written %d, not T + %d"
                        % (name, plane["columns_written"], completed))
    # Oracle B's cumulative byte count: at step `k` the comparison covers the prefill's `T` columns,
    # every column a previous step wrote, **and** the column this step just wrote.
    expected_bytes = sum(2 * 2 * (3 + k) * COLUMN_BYTES for k in range(1, completed + 1))
    if plane["roundtrip_bytes_compared"] != expected_bytes:
        failures.append("%s: oracle B compared %d bytes, not the cumulative %d"
                        % (name, plane["roundtrip_bytes_compared"], expected_bytes))
    # Section 3.11's fail-closed relation, on every step of every successful case.
    for row in document["steps"]:
        residency = row["residency"]
        if document["weights"]["mode"] != "dense+lru" \
                and residency["expert_pread_bytes"] < residency["expert_bytes"]:
            failures.append("%s: step %d read %d bytes for a %d-byte claim"
                            % (name, row["index"], residency["expert_pread_bytes"],
                               residency["expert_bytes"]))
        if residency["expert_bytes_ppm"] != used * 1000000 // 8:
            failures.append("%s: step %d claims %d ppm, not the %d of 8 this geometry routes"
                            % (name, row["index"], residency["expert_bytes_ppm"], used))
        if residency["claim_planes_read"] != 2 * used * 3:
            failures.append("%s: step %d read %d claim planes, not 2 layers x %d experts x 3 roles"
                            % (name, row["index"], residency["claim_planes_read"], used))
    if document["decode"]["graph_count"] != (2 * 2 + 2) * completed:
        failures.append("%s: decode.graph_count %d, not %d per step"
                        % (name, document["decode"]["graph_count"], 2 * 2 + 2))

# Gate G, oracle R, oracle B, oracle T and the demand stream, all on the one case that runs the
# whole shape: three steps against a four-graph transcript with the prefill's own logits blob.
#
# Everything below reads `steps[0..2]` and the oracle objects directly, so a case that did not reach
# three completed steps has to be **reported and not indexed**: a `list index out of range` from this
# block would say a mutant was caught and would not say what caught it. `require` is that guard, and
# it is the one place the block gives up.
def require(name, steps_expected=3):
    if name not in produced:
        failures.append("%s: no document was produced, so the analysis below cannot run" % name)
    else:
        document = json.loads(produced[name])
        if document["status"] == "ok" and len(document["steps"]) == steps_expected:
            return document
        failures.append("%s: status %r, error_code %r, %d completed step(s) against %d expected; "
                        "the analysis below cannot run"
                        % (name, document["status"], document["error_code"],
                           len(document["steps"]), steps_expected))
    for line in failures:
        sys.stderr.write("moe decode step smoke: FAIL %s\n" % line)
    raise SystemExit(1)


full = require("md-oracle-full")
if full["decode"]["steps_completed"] != 3 or full["decode"]["steps_requested"] != 3:
    failures.append("md-oracle-full: %r" % (full["decode"],))
# Gate G. The ids the arm decoded are the ids the generator's own reference loop consumed, element
# for element — and they are **distinct**, so an arm that decoded step 1 and re-consumed its own
# first token forever cannot satisfy this.
if full["decode"]["token_ids"] != EXPECTED_IDS:
    failures.append("md-oracle-full: token_ids %r, not the reference loop's %r"
                    % (full["decode"]["token_ids"], EXPECTED_IDS))
if len(set(EXPECTED_IDS)) != len(EXPECTED_IDS):
    failures.append("md-oracle-full: the reference id chain is degenerate: %r" % (EXPECTED_IDS,))
if full["decode"]["n_past_first"] != 3 or full["decode"]["n_past_last"] != 5:
    failures.append("md-oracle-full: n_past %d..%d, not 3..5"
                    % (full["decode"]["n_past_first"], full["decode"]["n_past_last"]))
# Oracle R, per step, at full element-wise coverage: `ids_total == ids_printed_compared` is the
# claim this arm makes and R5E could not.
routing = full["routing_oracle"]
if routing["verdict"] != "MATCH":
    failures.append("md-oracle-full: routing %r" % (routing,))
if routing["ids_total"] != 18 or routing["ids_printed_compared"] != 18 \
        or routing["ids_printed_matched"] != 18:
    failures.append("md-oracle-full: routing coverage %d/%d/%d, not 2 layers x 3 slots x 3 steps"
                    % (routing["ids_total"], routing["ids_printed_compared"],
                       routing["ids_printed_matched"]))
if routing["steps_compared"] != 3 or routing["layers_matched"] != 6:
    failures.append("md-oracle-full: routing steps/layers %d/%d"
                    % (routing["steps_compared"], routing["layers_matched"]))
# Oracle T, per step, against transcript graphs 2, 3 and 4 — one for one, and said so on the wire.
oracle = full["oracle_decode"]
if oracle["verdict"] != "PASS" or oracle["steps_compared"] != 3:
    failures.append("md-oracle-full: oracle_decode %r" % (oracle,))
if oracle["instrument_graph_first"] != 2 or oracle["instrument_graph_last"] != 4:
    failures.append("md-oracle-full: instrument graphs %d..%d, not 2..4"
                    % (oracle["instrument_graph_first"], oracle["instrument_graph_last"]))
if oracle["elements_compared"] <= 0:
    failures.append("md-oracle-full: the transcript oracle compared nothing and still passed")
for row in full["steps"]:
    if row["oracle"]["instrument_graph"] != row["index"] + 1:
        failures.append("md-oracle-full: step %d was compared against graph %d"
                        % (row["index"], row["oracle"]["instrument_graph"]))
    if row["oracle"]["verdict"] != "PASS" or row["oracle"]["elements_compared"] <= 0:
        failures.append("md-oracle-full: step %d oracle %r" % (row["index"], row["oracle"]))
    if row["oracle"]["layers_matched"] != 2:
        failures.append("md-oracle-full: step %d compared %d layers"
                        % (row["index"], row["oracle"]["layers_matched"]))
# Gate G1, in the form the **hosted** corpus can carry. Byte identity is the gate's contract on the
# real model, where the reference blob is `llama-debug --save-logits`' own output and both sides are
# llama.cpp's arithmetic. Here the reference blob is the generator's pure-Python forward, which
# agrees with the engine shim's C kernels to every printed decimal and not to the last bit — the
# same `verdict: FAIL` with `max_abs_diff: 0` that `--moe-model-forward`'s own `mm-logits` has
# carried since R5E. What is asserted hosted is therefore what the hosted lane can prove: the
# comparison ran over the whole vocabulary, every element agrees, and the **argmax the id chain is
# rooted at** is the reference's.
logits_oracle = full["oracle_logits"]
if not logits_oracle["present"] or logits_oracle["elements_compared"] != 32:
    failures.append("md-oracle-full: gate G1 compared %r elements"
                    % logits_oracle["elements_compared"])
if logits_oracle["max_abs_diff_ten_thousandths"] != 0:
    failures.append("md-oracle-full: gate G1 max_abs %r"
                    % logits_oracle["max_abs_diff_ten_thousandths"])
if logits_oracle["argmax_primary"] != logits_oracle["argmax_reference"]:
    failures.append("md-oracle-full: gate G1 argmax %r != %r"
                    % (logits_oracle["argmax_primary"], logits_oracle["argmax_reference"]))
if logits_oracle["argmax_primary"] != EXPECTED_IDS[0]:
    failures.append("md-oracle-full: the id chain is not rooted at the prefill's own argmax: %r"
                    % logits_oracle["argmax_primary"])
if logits_oracle["top_k_set_agreement"] != 10:
    failures.append("md-oracle-full: gate G1 top-k set %r"
                    % logits_oracle["top_k_set_agreement"])
# **The demand stream**, against the generator's own independent routed decode loop.
for row, expect in zip(full["steps"], EXPECTED["rows"]):
    if row["n_past"] != expect["n_past"] or row["token_id"] != expect["token_id"]:
        failures.append("md-oracle-full: step %d is %d/%d, not %d/%d"
                        % (row["index"], row["n_past"], row["token_id"],
                           expect["n_past"], expect["token_id"]))
    if row["plane_column_written"] != expect["n_past"]:
        failures.append("md-oracle-full: step %d wrote column %d, not %d"
                        % (row["index"], row["plane_column_written"], expect["n_past"]))
    routed = row["routed"]
    if routed["layers"] != expect["layers"]:
        failures.append("md-oracle-full: step %d routed %r, not the generator's %r"
                        % (row["index"], routed["layers"], expect["layers"]))
    for field in ("keys_demanded", "new_keys", "new_bytes", "union_keys_after",
                  "union_bytes_after"):
        if routed[field] != expect[field]:
            failures.append("md-oracle-full: step %d routed.%s is %r, not the generator's %r"
                            % (row["index"], field, routed[field], expect[field]))
    for field in ("expert_bytes", "claim_planes_read"):
        if row["residency"][field] != expect[field]:
            failures.append("md-oracle-full: step %d residency.%s is %r, not the generator's %r"
                            % (row["index"], field, row["residency"][field], expect[field]))
    for layer_ids in routed["layers"]:
        if sorted(set(layer_ids)) != layer_ids:
            failures.append("md-oracle-full: step %d routed ids are not ascending and distinct: %r"
                            % (row["index"], layer_ids))
residency = full["residency"]
for field in ("decode_keys_demanded", "decode_keys_distinct", "decode_keys_in_prefill_union",
              "decode_distinct_keys_in_prefill_union", "decode_expert_bytes",
              "union_keys_final", "union_bytes_final", "step_reuse_per_mille"):
    if residency[field] != EXPECTED[field]:
        failures.append("md-oracle-full: residency.%s is %r, not the generator's %r"
                        % (field, residency[field], EXPECTED[field]))
# The union starts at the prefill's set and grows: the last step's `union_keys_after` is the run's
# final union, and the curve is monotone.
if full["steps"][-1]["routed"]["union_keys_after"] != residency["union_keys_final"]:
    failures.append("md-oracle-full: the union curve does not end at union_keys_final")
previous = 0
for row in full["steps"]:
    if row["routed"]["union_keys_after"] < previous:
        failures.append("md-oracle-full: the union curve is not monotone")
    previous = row["routed"]["union_keys_after"]
# The two accumulators are derived differently on purpose: `decode_keys_demanded` sums each step's
# per-layer routed count and `union_keys_final` is the cardinality of a real set, so their
# relationship is a measurement rather than a tautology.
if residency["decode_keys_demanded"] <= residency["union_keys_final"] - len(EXPECTED["prefill_keys"]):
    failures.append("md-oracle-full: the decode steps demanded no more keys than they added")
# Section 3.11's `step_reuse_per_mille` counts the decode steps' **own** distinct keys, and the
# quantity it is most easily confused with — and shipped as, before this repair — is the number of
# union keys the prefill did not already hold. This corpus is only a regression on the metric while
# those two numbers differ, so the difference is asserted rather than assumed.
prefill_relative = residency["union_keys_final"] - len(EXPECTED["prefill_keys"])
if residency["decode_keys_distinct"] == prefill_relative:
    failures.append("md-oracle-full: the corpus cannot separate section 3.11's decode-only distinct "
                    "count (%d) from the prefill-relative one (%d); the metric is untested here"
                    % (residency["decode_keys_distinct"], prefill_relative))
if residency["step_reuse_per_mille"] != (
        (residency["decode_keys_demanded"] - residency["decode_keys_distinct"]) * 1000
        // residency["decode_keys_demanded"]):
    failures.append("md-oracle-full: step_reuse_per_mille is not (demands - distinct) / demands")
# Section 12.3 finding 2 reports both prefill-union fractions, so both are published and each is
# bounded by the denominator it belongs to.
if not 0 <= residency["decode_distinct_keys_in_prefill_union"] <= residency["decode_keys_distinct"]:
    failures.append("md-oracle-full: the distinct prefill-union count is outside its denominator")
if not 0 <= residency["decode_keys_in_prefill_union"] <= residency["decode_keys_demanded"]:
    failures.append("md-oracle-full: the demand prefill-union count is outside its denominator")
# Section 4.4's oracle C′ fallback needs a per-step top ten, in `--moe-model-forward`'s own shape.
for row in full["steps"]:
    top = row["top_k"]
    if len(top) != 10:
        failures.append("md-oracle-full: step %d publishes %d top-k entries, not 10"
                        % (row["index"], len(top)))
    elif top[0]["index"] != row["argmax"]:
        failures.append("md-oracle-full: step %d top_k[0] is %r and argmax is %r"
                        % (row["index"], top[0]["index"], row["argmax"]))
    elif len(set(entry["index"] for entry in top)) != len(top):
        failures.append("md-oracle-full: step %d repeats an index in its top ten" % row["index"])

# `md-steps-3` runs the same three steps with **no** transcript and **no** logits blob, which is
# where the demand stream has to be identical and every oracle absent. The two documents differ in
# exactly the oracle blocks, which is what makes the measurement independent of the oracles.
# R6-OLMOE-DECODE deviation 3, hosted at both ends. `md-used-six` is inert by construction — at
# `TRUNCATION_PRINTED` the two mappings agree — and `md-used-eight` is the first width at which they
# do not: a build that dropped the `truncated` gate maps printed ordinals 3..7 of the eight-wide
# `ffn_moe_topk-L` row onto indices 5..9, so at most three ids of every eight can match and two of
# the indices are past the extent. The same case carries the axis-1 half of the fix: at
# `n_expert_used = 8` the three `MUL_MAT_ID` nodes and `ffn_moe_weights-L` have a **truncated** axis
# 1, whose rows map correctly only while the axis-1 marker is raised, so a build that never raised
# it fails oracle T on nodes the router never touched.
for used_variant, case_name in ((6, "md-used-six"), (8, "md-used-eight")):
    variant = require(case_name)
    with open(path("moe-model-decode-used-%d-routing.json" % used_variant), "r",
              encoding="utf-8") as handle:
        variant_expected = json.load(handle)
    ids_total = variant_expected["ids_total"]
    variant_routing = variant["routing_oracle"]
    if variant["decode"]["token_ids"] != variant_expected["token_ids"]:
        failures.append("%s: decoded %r, not the generator's %r"
                        % (case_name, variant["decode"]["token_ids"],
                           variant_expected["token_ids"]))
    if variant_routing["verdict"] != "MATCH":
        failures.append("%s: routing %r at step %d layer %d token %d slot %d"
                        % (case_name, variant_routing["verdict"],
                           variant_routing["first_difference_step"],
                           variant_routing["first_difference_layer"],
                           variant_routing["first_difference_token"],
                           variant_routing["first_difference_slot"]))
    if variant_routing["ids_total"] != ids_total \
            or variant_routing["ids_printed_compared"] != ids_total \
            or variant_routing["ids_printed_matched"] != ids_total:
        failures.append("%s: routing coverage %d/%d of %d is not element-wise complete at "
                        "n_expert_used %d"
                        % (case_name, variant_routing["ids_printed_matched"],
                           variant_routing["ids_printed_compared"], variant_routing["ids_total"],
                           used_variant))
    if variant["oracle_decode"]["verdict"] != "PASS":
        failures.append("%s: oracle T %r worst %r max_abs %d"
                        % (case_name, variant["oracle_decode"]["verdict"],
                           variant["oracle_decode"]["worst_node"],
                           variant["oracle_decode"]["max_abs_diff_ten_thousandths"]))
    if variant["plane"]["roundtrip_verdict"] != "IDENTICAL":
        failures.append("%s: oracle B %r" % (case_name, variant["plane"]["roundtrip_verdict"]))
    if [row["routed"]["layers"] for row in variant["steps"]] != variant_expected["layers"]:
        failures.append("%s: the routed demand stream is not the generator's" % case_name)
# Non-vacuity, read back from the generated transcript rather than assumed: the eight-wide case only
# discriminates while the router's slot axis is above `TRUNCATION_PRINTED` **and** the row carries
# no ellipsis, which is the emulated R2C print limit's whole effect.
with open(path("moe-model-decode-used-8-transcript.txt"), "r", encoding="utf-8") as handle:
    used_eight_lines = handle.read().split("\n")
topk_header = next((i for i, line in enumerate(used_eight_lines)
                    if line.startswith("common_debug_cb_eval:") and " ffn_moe_topk-0 " in line), -1)
if topk_header < 0:
    failures.append("md-used-eight: the transcript prints no ffn_moe_topk-0 block")
else:
    def row_values(row):
        inner = row.strip()
        return [piece.strip()
                for piece in inner[inner.index("[") + 1:inner.rindex("]")].split(",")
                if piece.strip()]

    topk_rows = [line for line in used_eight_lines[topk_header + 1:topk_header + 8]
                 if line.strip().startswith("[") and line.strip() != "["]
    if not topk_rows or any(len(row_values(row)) != 8 for row in topk_rows):
        failures.append("md-used-eight: ffn_moe_topk-0 is not printed eight wide: %r"
                        % (topk_rows[:1],))
    if any("..." in row for row in topk_rows):
        failures.append("md-used-eight: ffn_moe_topk-0 carries an ellipsis, so the direct-mapping "
                        "branch is not the one under test")
    weights_header = next((i for i, line in enumerate(used_eight_lines)
                           if line.startswith("common_debug_cb_eval:")
                           and " ffn_moe_weights-0 " in line), -1)
    if weights_header < 0 or not any(
            used_eight_lines[weights_header + offset].startswith("            ...")
            for offset in range(1, 12)):
        failures.append("md-used-eight: ffn_moe_weights-0 does not truncate its axis 1, so the "
                        "axis-1 marker is not under test")

quiet = require("md-steps-3")
if quiet["decode"]["token_ids"] != full["decode"]["token_ids"]:
    failures.append("md-steps-3: the ids depend on whether a transcript was supplied")
if [row["routed"] for row in quiet["steps"]] != [row["routed"] for row in full["steps"]]:
    failures.append("md-steps-3: the demand stream depends on whether a transcript was supplied")
if quiet["oracle_decode"]["present"] or quiet["routing_oracle"]["present"]:
    failures.append("md-steps-3: an absent transcript still reported an oracle")

# `md-engine-ok` is `STEPS` absent, which means one step and says so.
single = require("md-engine-ok", 1)
if single["decode"]["steps_requested"] != 1 or single["decode"]["steps_completed"] != 1:
    failures.append("md-engine-ok: an absent STEPS is %r" % (single["decode"],))
if single["steps"][0]["routed"] != full["steps"][0]["routed"]:
    failures.append("md-engine-ok: step 1 differs between N=1 and N=3")

# Oracle R disagreeing is data on a successful run.
mismatch = require("md-routing-mismatch")
if mismatch["status"] != "ok" or mismatch["routing_oracle"]["verdict"] != "MISMATCH":
    failures.append("md-routing-mismatch: %r / %r"
                    % (mismatch["status"], mismatch["routing_oracle"]["verdict"]))
if mismatch["routing_oracle"]["first_difference_step"] != 1:
    failures.append("md-routing-mismatch: first_difference_step %r"
                    % mismatch["routing_oracle"]["first_difference_step"])
if mismatch["decode"]["token_ids"] != EXPECTED_IDS:
    failures.append("md-routing-mismatch: a routing mismatch changed the decoded ids")

perturbed = require("md-transcript-perturbed")
if perturbed["status"] != "ok" or perturbed["oracle_decode"]["verdict"] != "FAIL":
    failures.append("md-transcript-perturbed: %r / %r"
                    % (perturbed["status"], perturbed["oracle_decode"]["verdict"]))
if perturbed["oracle_decode"]["worst_step"] != 1:
    failures.append("md-transcript-perturbed: the breach is in graph 2 and therefore step 1, not %r"
                    % perturbed["oracle_decode"]["worst_step"])

short = json.loads(produced["md-transcript-short-for-steps"])
if not short["error_detail"].startswith("step[3]"):
    failures.append("md-transcript-short-for-steps: detail %r does not name step 3"
                    % short["error_detail"])
if short["decode"]["steps_completed"] != 2 or len(short["steps"]) != 2:
    failures.append("md-transcript-short-for-steps: %d steps completed with %d objects"
                    % (short["decode"]["steps_completed"], len(short["steps"])))
if short["plane"]["columns_written"] != 5:
    failures.append("md-transcript-short-for-steps: columns_written %d, not T + 2"
                    % short["plane"]["columns_written"])
if short["plane"]["roundtrip_verdict"] == "IDENTICAL":
    failures.append("md-transcript-short-for-steps: an error document must never say IDENTICAL")

for name, force, argv, expected in FORCED_CASES:
    build_shim(force)
    record(name, argv, expected)

# The step locator, and the early-exit contract it names.
step2 = json.loads(produced["md-force-compute-step2"])
if not step2["error_detail"].startswith("step[2]"):
    failures.append("md-force-compute-step2: detail %r does not name step 2"
                    % step2["error_detail"])
if step2["decode"]["steps_completed"] != 1 or len(step2["steps"]) != 1:
    failures.append("md-force-compute-step2: %d steps completed with %d objects"
                    % (step2["decode"]["steps_completed"], len(step2["steps"])))
if step2["plane"]["columns_written"] != 4:
    failures.append("md-force-compute-step2: columns_written %d, not T + 1"
                    % step2["plane"]["columns_written"])
if len(step2["decode"]["token_ids"]) != 1:
    failures.append("md-force-compute-step2: %d ids for one completed step"
                    % len(step2["decode"]["token_ids"]))
if step2["residency"]["decode_keys_demanded"] != EXPECTED["rows"][0]["keys_demanded"]:
    failures.append("md-force-compute-step2: the residency aggregate counts an unpublished step")

# The two mutants that compute a finite wrong answer no shape check catches: both are successful
# runs whose transcript oracle fails, which is the whole reason oracle T is evaluated at every step.
for name in ("md-force-decode-position", "md-force-mask-offset"):
    mutant = json.loads(produced[name])
    if mutant["status"] != "ok" or mutant["oracle_decode"]["verdict"] != "FAIL":
        failures.append("%s: %r / %r"
                        % (name, mutant["status"], mutant["oracle_decode"]["verdict"]))

build_shim("engine")

# ---------------------------------------------------------------------------------------------
# R6-MOE-RESIDENT-DENSE: the residency assertions (sections 4.1 to 4.4, 5.1 and 5.2)
# ---------------------------------------------------------------------------------------------

# Absence is `-`, in bytes: fourteen operands whose last three are the defaults produce the same
# document as nine. This capability adds no default and changes no shipped invocation.
if produced["md-stub-unavailable"] != produced["mdr-arity-14"]:
    failures.append("mdr-arity-14: three default operands changed the document: %s"
                    % describe_difference(produced["md-stub-unavailable"],
                                          produced["mdr-arity-14"]))

# The refusal details, which the golden also carries but which are named here so a regenerated
# golden cannot silently accept a different one. `kv[save]` precedes `kv[load]`, and both precede
# `RESIDENT` — `mdr-kv-load-unsupported` also names an otherwise-refusable residency mode.
for name, detail in (("mdr-resident-unknown", "resident[extra]"),
                     ("mdr-resident-empty", "resident[]"),
                     ("mdr-resident-case", "resident[DENSE]"),
                     ("mdr-resident-weights-refused", "resident[weights]"),
                     ("mdr-resident-multibyte", MULTIBYTE_DETAIL),
                     ("mdr-kv-save-unsupported", "kv[save]"),
                     ("mdr-kv-load-unsupported", "kv[load]")):
    document = json.loads(produced[name])
    if document["error_detail"] != detail:
        failures.append("%s: detail %r, not %r" % (name, document["error_detail"], detail))
    if document["weights"]["mode"] != "stream":
        failures.append("%s: a refused document must still publish a mode: %r"
                        % (name, document["weights"]))

# Oracle D. One step and three steps, each `dense` leg against the streamed case it differs from in
# exactly the `RESIDENT` operand.
for streamed_case, resident_case in (("md-engine-ok", "mdr-resident-dense-1"),
                                     ("md-steps-3", "mdr-resident-dense-steps")):
    left = normalize_resident(produced[streamed_case])
    right = normalize_resident(produced[resident_case])
    if left != right:
        failures.append("oracle D (%s vs %s): %s"
                        % (streamed_case, resident_case, describe_difference(left, right)))

# R8-PARTIAL-LRU-CACHE: the cache changes transport and accounting only. The full three-step
# semantic document agrees with `dense` after the exact cache fields are removed.
cache_case = json.loads(produced["mdr-cache-lru-steps"])
cache_weights = cache_case["weights"]
cache = cache_weights["expert_cache"]
if normalize_cache_semantics(produced["mdr-resident-dense-steps"]) \
        != normalize_cache_semantics(produced["mdr-cache-lru-steps"]):
    failures.append("cache oracle D (dense vs dense+lru): %s"
                    % describe_difference(
                        normalize_cache_semantics(produced["mdr-resident-dense-steps"]),
                        normalize_cache_semantics(produced["mdr-cache-lru-steps"])))
if cache_case["schema_version"] != 3 or cache_weights["mode"] != "dense+lru":
    failures.append("cache document identity is not schema 3/dense+lru: %r" % cache_weights)
if cache["budget_bytes"] != 9216 or cache["capacity_bytes"] != 9216 \
        or cache["key_bytes"] != 1536 or cache["slot_count"] != 6:
    failures.append("cache geometry/accounting is not the fixture's 6-key budget: %r" % cache)
if cache["requests"] != cache["hits"] + cache["misses"] \
        or cache["requests"] != 27 or cache["hits"] <= 0 or cache["evictions"] <= 0 \
        or cache["resident_keys_final"] != 6 or cache["resident_keys_high_water"] != 6:
    failures.append("cache request/LRU counters do not prove hit plus eviction paths: %r" % cache)
if cache["bytes_served"] != cache["requests"] * cache["key_bytes"] \
        or cache["miss_bytes"] != cache["misses"] * cache["key_bytes"] \
        or cache["bytes_fetched"] != cache["miss_bytes"]:
    failures.append("cache byte counters do not reconcile on the unamplified fixture: %r" % cache)
step_cache = [row["residency"] for row in cache_case["steps"]]
for field, total in (("cache_hits", cache["hits"]), ("cache_misses", cache["misses"]),
                     ("cache_evictions", cache["evictions"]),
                     ("cache_bytes_served", cache["bytes_served"]),
                     ("cache_miss_bytes", cache["miss_bytes"]),
                     ("cache_bytes_fetched", cache["bytes_fetched"])):
    # Aggregate cache evidence also includes prefill, so each decode-only sum is bounded by it.
    if sum(row[field] for row in step_cache) > total:
        failures.append("cache step %s exceeds the run aggregate: %r" % (field, cache))
if cache_weights["step_expert_pack_bytes"] >= \
        json.loads(produced["mdr-resident-dense-steps"])["weights"]["step_expert_pack_bytes"]:
    failures.append("the cache did not reduce decode expert pack bytes: %r" % cache_weights)

# The staging boundary, from the legal side. A `dense` prefill of exactly `MAX_PREFILL_TOKENS` ids
# stages slot 2047 — the highest index `stage_embed_row` can be asked for — and the streamed twin makes
# the case an assertion about the **bytes** that slot carries rather than only about the run not
# being refused.
for name, argv, expected in BOUNDARY_CASES:
    record(name, argv, expected)

if STAGE_FULL not in produced:
    failures.append("%s: the staging-boundary case produced no document" % STAGE_FULL)
else:
    stage_full = json.loads(produced[STAGE_FULL])
    if stage_full["error_code"] != "" or stage_full["status"] != "ok":
        failures.append("%s: a %d-token dense prefill was refused: %r %r"
                        % (STAGE_FULL, len(STAGE_FULL_TOKENS.split(",")),
                           stage_full["error_code"], stage_full["error_detail"]))
    else:
        if stage_full["weights"]["mode"] != "dense" \
                or stage_full["weights"]["step_dense_pack_bytes"] != 0:
            failures.append("%s: %r" % (STAGE_FULL, stage_full["weights"]))
        if stage_full["decode"]["n_past_first"] != 2048 \
                or stage_full["plane"]["columns_written"] != 2048 + int(STAGE_FULL_STEPS):
            failures.append("%s: n_past_first %d and %d columns, not 2048 and %d"
                            % (STAGE_FULL, stage_full["decode"]["n_past_first"],
                               stage_full["plane"]["columns_written"],
                               2048 + int(STAGE_FULL_STEPS)))
        if stage_full["plane"]["roundtrip_verdict"] != "IDENTICAL":
            failures.append("%s: oracle B is %r at the staging boundary"
                            % (STAGE_FULL, stage_full["plane"]["roundtrip_verdict"]))
    stage_full_streamed = normalize_resident(normalize(
        run(mdr(tokens=STAGE_FULL_TOKENS, transcript="-", logits="-", width=STAGE_FULL_WIDTH,
                steps=STAGE_FULL_STEPS)).stdout.decode("utf-8")))
    if stage_full_streamed != normalize_resident(produced[STAGE_FULL]):
        failures.append("oracle D at the staging boundary (%s): %s"
                        % (STAGE_FULL,
                           describe_difference(stage_full_streamed,
                                               normalize_resident(produced[STAGE_FULL]))))

# Section 2.2's layout arithmetic on this fixture, spelled out so the golden's own
# `weights.resident_bytes` is a number with a derivation rather than a number that was observed. The
# synthetic container's `block_align` is 4,096 and every region starts on that boundary:
#
#   token_embd, the whole table   n_vocab 32 x n_embd 4 x 4 B = 512 B  -> 4,096 rounded up
#   the staging region            MAX_PREFILL_TOKENS 2048 x 32 B = 65,536 B
#   2 routed layers + the head    the rest
#
# The assertions are the structural properties that hold for **any** pack, so a fixture change moves
# the golden and not the reasoning. This is deliberately not a remembered constant: section 7 risk 4
# is the fixture co-derivation class, and a check that asserted a number the implementation also
# produced would prove nothing.
RESIDENT_BLOCK_ALIGN = 4096
RESIDENT_TABLE_BYTES = RESIDENT_BLOCK_ALIGN
RESIDENT_STAGE_BYTES = 2048 * 32

for case in ("mdr-resident-dense-1", "mdr-resident-dense-steps"):
    document = json.loads(produced[case])
    weights = document["weights"]
    window = document["window"]
    lifetime = document["lifetime"]
    steps_rows = document["steps"]
    if weights["mode"] != "dense":
        failures.append("%s: mode %r, not dense" % (case, weights["mode"]))
    # The claim, and the primary metric of section 3.8: a `dense` decode step reads **zero dense**
    # pack bytes. It is a counter and not a clock.
    if weights["step_dense_pack_bytes"] != 0:
        failures.append("%s: a dense run read %d dense pack bytes in its decode steps"
                        % (case, weights["step_dense_pack_bytes"]))
    # The co-primary invariant of section 4.4, and the whole reason this arm keeps streaming its
    # experts: the expert measurement must not move. `step_expert_pack_bytes` is the syscall side and
    # `steps[].residency.expert_pread_bytes` is where it comes from, so the two are reconciled here
    # rather than assumed to agree.
    if weights["step_expert_pack_bytes"] <= 0:
        failures.append("%s: a dense run read no expert bytes; the measurement this arm exists to "
                        "publish is gone: %r" % (case, weights))
    if weights["step_expert_pack_bytes"] != sum(row["residency"]["expert_pread_bytes"]
                                                for row in steps_rows):
        failures.append("%s: step_expert_pack_bytes %d is not the sum of the published steps' "
                        "expert_pread_bytes" % (case, weights["step_expert_pack_bytes"]))
    # And `step_pack_bytes` keeps `r6-resident-weights.md` section 3.5's exact meaning — pack bytes
    # read by decode steps only — so on this arm it is **not** zero in `dense` mode.
    if weights["step_pack_bytes"] != weights["step_expert_pack_bytes"]:
        failures.append("%s: step_pack_bytes %d should be exactly the expert term in dense mode"
                        % (case, weights["step_pack_bytes"]))
    # Section 4.3, oracle B at run scope: exactly one wrap created and exactly one freed, in a pair
    # separate from the per-graph pair so the per-graph check keeps its meaning. `wrap_count` is the
    # weight-region wraps of the whole run and is 1 where the streamed leg's is one per graph.
    if weights["wrap_count"] != 1 or weights["resident_wraps_created"] != 1 \
            or weights["resident_wraps_freed"] != 1:
        failures.append("%s: the run-scope wrap did not balance: %r" % (case, weights))
    if json.loads(produced["md-steps-3"])["weights"]["wrap_count"] <= 1:
        failures.append("the streamed leg wrapped its dense window %d times, so the hoist proves "
                        "nothing" % json.loads(produced["md-steps-3"])["weights"]["wrap_count"])
    if lifetime["graph_balance_failures"] != 0 \
            or not lifetime["released_before_owner_scope_end"]:
        failures.append("%s: the dense teardown did not balance: %r" % (case, lifetime))
    if lifetime["ggml_buffers_created"] != lifetime["ggml_buffers_freed"]:
        failures.append("%s: the per-graph buffer pair stopped balancing under the hoist: %r"
                        % (case, lifetime))
    # The fill happened once and read the dense set.
    if weights["fill_bytes"] <= 0 or weights["fill_pread_count"] <= 0:
        failures.append("%s: the region reported no fill: %r" % (case, weights))
    # Section 2.2, structurally: the region is the **sum** the layout walks, and a sum over every
    # graph cannot be below the maximum over the same graphs plus the two regions streaming never
    # holds at all.
    if weights["resident_bytes"] % RESIDENT_BLOCK_ALIGN != 0:
        failures.append("%s: the region is %d bytes, which is not a multiple of the container's own "
                        "block alignment (%d)"
                        % (case, weights["resident_bytes"], RESIDENT_BLOCK_ALIGN))
    if weights["resident_bytes"] < window["dense_bytes"] + RESIDENT_TABLE_BYTES \
            + RESIDENT_STAGE_BYTES:
        failures.append("%s: the region (%d) is below the streamed peak (%d) plus the table and the "
                        "stage" % (case, weights["resident_bytes"], window["dense_bytes"]))
    if weights["fill_bytes"] >= weights["resident_bytes"]:
        failures.append("%s: the fill (%d) is not below the region (%d); the staging region is "
                        "never filled from the pack"
                        % (case, weights["fill_bytes"], weights["resident_bytes"]))
    # Oracle P's new reach (section 4.2). In `dense` mode every dense placement is against the
    # region, so a run that silently fell back to a per-graph copy could not report zero here.
    if window["pointer_identity_failures"] != 0 or window["member_placements"] <= 0 \
            or window["claim_placements"] <= 0:
        failures.append("%s: %d placement failures over %d member and %d claim placements"
                        % (case, window["pointer_identity_failures"],
                           window["member_placements"], window["claim_placements"]))
    if document["verdict"] != "EXTERNAL":
        failures.append("%s: verdict %r, not EXTERNAL" % (case, document["verdict"]))

# Section 7 risk 1's regression, read off the forced build: a `dense` run that failed **before** the
# wrap existed created nothing, freed nothing, and must report a perfect teardown. A `created != 1`
# condition written unconditionally would fabricate a leak exactly here.
wrap_refused = json.loads(produced["mdr-force-resident-wrap"])
if wrap_refused["weights"]["mode"] != "dense" \
        or wrap_refused["weights"]["resident_wraps_created"] != 0 \
        or wrap_refused["weights"]["resident_wraps_freed"] != 0:
    failures.append("mdr-force-resident-wrap: %r" % (wrap_refused["weights"],))
if wrap_refused["weights"]["wrap_count"] != 0:
    failures.append("mdr-force-resident-wrap: a refused weight-region wrap was counted: %r"
                    % (wrap_refused["weights"],))
if wrap_refused["lifetime"]["graph_balance_failures"] != 0:
    failures.append("mdr-force-resident-wrap: a failure before the wrap existed reported %d "
                    "balance failure(s); the run-scope check is asserting presence, not balance"
                    % wrap_refused["lifetime"]["graph_balance_failures"])
# The region was filled and live when the wrap was refused, which is what makes this the early-exit
# window rather than an ordinary refusal.
if wrap_refused["weights"]["fill_bytes"] <= 0:
    failures.append("mdr-force-resident-wrap: the fill did not run, so this is not the early-exit "
                    "window the cell is about: %r" % (wrap_refused["weights"],))

build_shim("")

DECLARED_R6M_CODES = {
    "R6M_TOKENS", "R6M_GEOMETRY", "R6M_KV_WIDTH", "R6M_STEPS", "R6M_PLANE_UNAVAILABLE",
    "R6M_PLANE_WRITE", "R6M_PLANE_MISMATCH", "R6M_TRANSCRIPT", "R6M_ORACLE_MISSING",
    "R6M_GEOMETRY_UNREADABLE", "R6M_CLAIM_ACCOUNTING", "R6M_ROUTED_SHAPE",
    "R6M_RESIDENT", "R6M_RESIDENT_BUDGET", "R6M_KV_UNSUPPORTED",
}
# The four this block does not reach, each with its reason. `R6M_PLANE_UNAVAILABLE` and
# `R6M_PLANE_WRITE` are fail-closed guards on an arithmetic no input can produce — the plane's size
# is a function of a validated geometry and a validated width, and its span is checked against the
# node the table names. `R6M_CLAIM_ACCOUNTING` is the relation of section 3.11 and is likewise
# unreachable from an input: no operand can make the reader read fewer bytes than the claim.
# `R6M_ROUTED_SHAPE` is section 3.11's second such relation — `stage_carry_at` refuses a short
# `topk_image` with `R5E_CARRY` before compute, so no operand reaches the key arithmetic with a
# `routed[]` that is not exactly `n_layer * n_expert_used` long.
#
# `R6M_RESIDENT_BUDGET` joins them, and its reason is different in kind and is recorded rather than
# glossed. It guards `resident_bytes > model_forward.MAX_WINDOW_BYTES` (8 GiB) and the `-1` that
# `plan_resident_dense`'s checked arithmetic poisons an unrepresentable total with; this corpus's
# whole region is 114 KB and its member sizes come from the container, so no operand this block can
# write reaches either. Reaching it would need a lowered-limits entry point of its own — a second
# executable and a ceiling threaded through `execute` — which `docs/specs/r6-moe-resident-dense.md`
# section 13 item 6 records as a deviation and section 8 defers, on the terms
# `R4_WINDOW_UNAVAILABLE` already carries.
UNREACHED_R6M_CODES = {"R6M_PLANE_UNAVAILABLE", "R6M_PLANE_WRITE", "R6M_CLAIM_ACCOUNTING",
                       "R6M_ROUTED_SHAPE", "R6M_RESIDENT_BUDGET"}
INHERITED_CODES = {
    "R4_PACK_UNREADABLE", "R4_PACK_TRUNCATED", "R5_GGML_UNAVAILABLE", "R5_GEOMETRY", "R5_SHAPE",
    "R5D_CLAIM_MISSING", "R5_ALIGNMENT", "R5_TYPE_UNSUPPORTED", "R5_SOURCE_DIVERGED",
    "R5_SOURCE_UNREADABLE", "R5_LOGITS_SHAPE", "R5_LOGITS_UNREADABLE", "R5_LOGITS_NONFINITE",
    "R5_GGML_INIT", "R5_ALLOC", "R5_COMPUTE", "R5_SLOT", "R5D_EXPERT_ID", "R5E_CARRY",
    "R5_RESIDUAL",
}
DECLARED_R8_CODES = {"R8_CACHE_MODE", "R8_CACHE_BUDGET"}
reached = codes - {""}
expected_reached = (DECLARED_R6M_CODES - UNREACHED_R6M_CODES) | DECLARED_R8_CODES | INHERITED_CODES
if reached != expected_reached:
    if expected_reached - reached:
        failures.append("codes never reached: %s" % ", ".join(sorted(expected_reached - reached)))
    if reached - expected_reached:
        failures.append("codes reached that this block does not declare: %s"
                        % ", ".join(sorted(reached - expected_reached)))

ORDER = ([name for name, _, _ in STUB_CASES]
         + [name for name, _, _ in ENGINE_CASES]
         + [name for name, _, _, _ in FORCED_CASES])

if update:
    with open(golden_path, "w", encoding="utf-8") as handle:
        for name in ORDER:
            handle.write(json.dumps({"case": name, "document": produced[name]},
                                    separators=(",", ":"), ensure_ascii=False) + "\n")
    print("moe decode step smoke: golden rewritten with %d cases" % len(ORDER))
else:
    with open(golden_path, "r", encoding="utf-8") as handle:
        golden = [json.loads(line) for line in handle if line.strip()]
    if [row["case"] for row in golden] != ORDER:
        failures.append("the golden case list does not match the runner's case list")
    else:
        for row in golden:
            if produced.get(row["case"]) != row["document"]:
                failures.append("golden mismatch for %s: %s"
                                % (row["case"],
                                   describe_difference(row["document"],
                                                       produced.get(row["case"]))))

if failures:
    for line in failures:
        sys.stderr.write("moe decode step smoke: FAIL %s\n" % line)
    raise SystemExit(1)

print("moe decode step smoke: %d no-document cases (R6M_ARITY, R6M_PATH), %d documented cases, "
      "%d of the %d declared R6M_* codes and both R8 cache codes reached plus %d inherited codes, "
      "gate G against the "
      "reference loop's own ids, oracle R MATCH element-wise complete at %d of %d ids over three "
      "steps, oracle B IDENTICAL over %d cumulative bytes, oracle T PASS against transcript graphs "
      "2..4, and arm-r5e/r6-unchanged plus the dense arm's OLMoE refusal PASS"
      % (len(NO_DOCUMENT), len(ORDER), len(reached & DECLARED_R6M_CODES),
         len(DECLARED_R6M_CODES), len(reached & INHERITED_CODES),
         routing["ids_printed_matched"], routing["ids_total"],
         full["plane"]["roundtrip_bytes_compared"]))
PY
