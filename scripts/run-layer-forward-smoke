def kv(mutation):
    return path("model-kv-%s.akvp" % mutation)


def ds(save="-", load="-", width=WIDTH, geometry=GEOM, steps=STEPS, transcript=None, pack=None):
    """One thirteen-operand invocation. Every kv case is thirteen operands so that the two
    directions differ in nothing but which position holds the path."""
    return [ARM, PACK if pack is None else pack, geometry, TOKENS, "-", SOURCE,
            TRANSCRIPT if transcript is None else transcript, width, "-", steps, save, load]


