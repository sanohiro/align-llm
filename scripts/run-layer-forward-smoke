     [ARM, PACK, GEOM, TOKENS, "-", path("model-source-short.bin")], "R5_SOURCE_UNREADABLE"),
    ("mf-engine-source-missing",
     [ARM, PACK, GEOM, TOKENS, "-", path("absent.bin")], "R5_SOURCE_UNREADABLE"),
    ("mf-transcript-missing-layer",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, path("model-transcript-missing.txt"), WIDTH],
     "R5_ORACLE_MISSING"),
    ("mf-transcript-kv-width",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, path("model-transcript-kv-width.txt"), WIDTH],
     "R5_ORACLE_SHAPE"),
    ("mf-transcript-headers",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, path("model-transcript-headers.txt"), WIDTH],
     "R5_ORACLE_MISSING"),
    ("mf-transcript-novalues",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, path("model-transcript-novalues.txt"), WIDTH],
     "R5_ORACLE_MISSING"),
    ("mf-transcript-garbage",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, path("model-transcript-garbage.txt"), WIDTH],
     "R5_TRANSCRIPT"),
    ("mf-transcript-perturbed",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, path("model-transcript-perturbed.txt"), WIDTH], ""),
    # The checked-in real-model excerpt: thirty-five records swept from the qualification, parsed
    # for real against a two-layer fixture. Every record is found by name, op, and — for the
    # attention output projection — source weight name, so the grammar, the shape declarations, and
