STUB_CASES = [
    ("mf-stub-unavailable", [ARM, PACK, GEOM, TOKENS], "R5_GGML_UNAVAILABLE"),
    ("mf-tokens-empty", [ARM, PACK, GEOM, ""], "R5_TOKENS"),
    ("mf-tokens-trailing", [ARM, PACK, GEOM, "1,"], "R5_TOKENS"),
    ("mf-tokens-space", [ARM, PACK, GEOM, "1, 2"], "R5_TOKENS"),
    # R6 section 2.7: the cap is 8 now, so the over-cap fixture is nine tokens.
    # R6-PREFIX-TTFT lifts `MAX_PREFILL_TOKENS` 32 -> 2048. **2049 repetitions of token id 1,
    # not an ascending list:** this geometry's `n_vocab` is 32, so an ascending list would be refused
    # as out-of-vocabulary and the case would stop being about the cap.
    ("mf-tokens-2049", [ARM, PACK, GEOM, ",".join(["1"] * 2049)], "R5_TOKENS"),
    # R6 section 2.7's other half. Above six tokens the instrument prints three leading and three
    # trailing rows and `printed_count` clamps to six on both sides, so a transcript comparison at
    # `T = 7` would check six of seven rows and still report `PASS`. The oracle refuses itself. The
    # same eight-token prefill **without** a transcript is admitted, which is exactly what
    # `--decode-step`'s characterization pass runs: it supplies `-` in the transcript position.
    ("mf-tokens-seven-transcript",
     [ARM, PACK, GEOM, "1,2,3,4,5,6,7", "-", SOURCE, WIDE, WIDTH], "R5_ORACLE_TRUNCATED"),
    ("mf-tokens-eight-no-transcript",
