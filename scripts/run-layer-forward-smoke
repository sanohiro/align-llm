     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, excerpt, "256"], "R5_ORACLE_MISSING"),
    ("mf-logits-short",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, WIDE, WIDTH, path("model-logits-short.bin")],
