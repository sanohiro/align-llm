GPU_CASES = [
    ("gf-gpu-ok", [ARM, PACK, GEOM, TOKENS], ""),
    ("gf-gpu-reference", [ARM, PACK, GEOM, TOKENS, "-", SOURCE], ""),
    ("gf-gpu-transcript", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, WIDE, WIDTH], ""),
    ("gf-gpu-logits", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, WIDE, WIDTH, LOGITS], ""),
    ("gf-gpu-runtime-width",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, NARROW, "3", RUNTIME_LOGITS], ""),
    ("gf-gpu-alignment", [ARM, path("model-pack-tight.alignpack"), GEOM, TOKENS],
     "R5_ALIGNMENT"),
    ("gf-source-diverged",
     [ARM, PACK, GEOM, TOKENS, "-", path("model-source-diverged.bin")], "R5_SOURCE_DIVERGED"),
    # Section 3.7: the transcript's grammar, its matched node set, its element-count rule, and
    # `kq-L`'s declared `ne0` are errors on this arm exactly as they are on R5B's. Only the element
    # comparison is disabled, and section 4.4 asserts that below.
    ("gf-transcript-missing-layer",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, path("model-transcript-missing.txt"), WIDTH],
     "R5_ORACLE_MISSING"),
    ("gf-transcript-kv-width",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, path("model-transcript-kv-width.txt"), WIDTH],
     "R5_ORACLE_SHAPE"),
    ("gf-transcript-garbage",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, path("model-transcript-garbage.txt"), WIDTH],
     "R5_TRANSCRIPT"),
    # A transcript whose `l_out-0` values are perturbed. On R5B this is an `oracle.verdict` of
    # `FAIL`; here it must stay `N/A_DEVICE` with `status: ok`, which is the assertion that a future
    # silent re-enable of the element comparison is a diff (section 4.4).
    ("gf-transcript-perturbed",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, path("model-transcript-perturbed.txt"), WIDTH], ""),
    ("gf-logits-short",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, WIDE, WIDTH, path("model-logits-short.bin")],
     "R5_LOGITS_SHAPE"),
    ("gf-logits-missing",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, WIDE, WIDTH, path("absent.bin")],
     "R5_LOGITS_UNREADABLE"),
    # Section 4.4's "a real failure is not `WITHIN`" cell: a reference blob shifted by 1.0 keeps the
    # argmax and the whole top ten and is `FAIL` anyway, so the 6,000-ten-thousandth bound alone
    # cannot pass it.
    ("gf-logits-perturbed",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, NARROW, "3", path("model-logits-perturbed.bin")], ""),
    # Section 6, correction C12, on the arm the tolerance belongs to. `compare_logits` is shared, so
    # these three cover the same code as the `mf-logits-*` rows above; they run here because the
    # verdict they produce is the one this arm's 6,000-ten-thousandth bound would otherwise have
    # been asked to absorb, and because a wrapped magnitude aborted **both** arms before C12.
    # `MODEL_ABORT_TOKENS` and an `-inf` in element 0: the one input pair whose primary rounds to
    # exactly zero ten-thousandths against a saturated reference, which is what made
    # `0 - difference` wrap to `i64`'s minimum and index the histogram with it. Measured at
    # `5663d8f`: `exit 134`, no document, `index out of bounds: the len is 65537 but the index is
    # -9223372036854775808`, on this arm and on the other one. The transcript position is `-`
    # because this token list is not the one the checked-in transcript was captured for.
    ("gf-logits-nonfinite",
     [ARM, PACK, GEOM, "1,25,5", "-", SOURCE, "-", "3", path("model-logits-neg-inf.bin")],
     "R5_LOGITS_NONFINITE"),
    ("gf-logits-nan",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, NARROW, "3", path("model-logits-nan.bin")],
     "R5_LOGITS_NONFINITE"),
    ("gf-logits-huge",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, NARROW, "3", path("model-logits-huge.bin")], ""),
]

# The two remaining new codes, each from its own shim build (section 4.5).
FORCED_CASES = [
    ("gf-no-host-ptr", "engine+gpu+no-host-ptr", [ARM, PACK, GEOM, TOKENS], "R5C_NO_HOST_PTR"),
    ("gf-device-limit", "engine+gpu+max-buffer", [ARM, PACK, GEOM, TOKENS],
     "R5C_DEVICE_BUFFER_LIMIT"),
    # Section 4.3's cleanup cell: a failure inside the schedule still runs the full per-graph
    # teardown and the counters balance, which on Metal is the difference between a document and a
    # `SIGABRT` at exit (section 2.6).
    ("gf-teardown-partial", "engine+gpu+compute", [ARM, PACK, GEOM, TOKENS], "R5_COMPUTE"),
    # Section 6, correction C19, on the arm the tolerance belongs to. The transcript oracle's
    # element half is `N/A_DEVICE` here (section 3.7), so what this case covers that its `mf-` twin
    # cannot is the tolerance verdict's own non-finite `primary` branch under a bound that is meant
    # to admit a device's rounding and must not admit an infinity.
    ("gf-force-inf-readback", "engine+gpu+inf-readback",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, NARROW, "3", RUNTIME_LOGITS], ""),
]

PLACEHOLDER = {"pack_path": "<pack>", "geometry_path": "<geometry>",
               "reference_path": "<reference>", "transcript_path": "<transcript>",
               "logits_path": "<logits>"}


# `r5c-metal-prefill.md` section 6, correction C21: a digest over a NaN is not a portable golden.
# The forced readback injects one `+inf` into every readback, and this arm hands a readback to the
# next graph, so every element computed from that infinity is a NaN rather than an infinity.
# IEEE-754 fixes an infinity's encoding and does **not** fix a NaN's sign or payload: an invalid
# operation delivers x86-64 SSE's "real indefinite" `0xffc00000` and arm64's default NaN
# `0x7fc00000`. A `bit_sum` over such a tensor therefore differs by 2**31 per NaN element and a
# `sha256` differs outright between two conforming hosts, while every count, verdict, and code
# agrees -- which is what the x86-64 run of this corpus reported and the aarch64 run did not.
#
# Mask the digests over the arm's **own** NaN-bearing tensors and nothing else. `nonfinite_count`,
# every verdict, `reference.*` (the runtime and reconciliation passes still have to agree bit for
# bit on one host) and `oracle_logits.reference_*` (file bytes, not a computed value) stay in the
# golden, and the forced case asserts below that the masked fields are still present and are still
# digests. The threshold is one and not zero because exactly one non-finite element in a readback
# is the injected `+inf` itself, whose encoding is portable: the R5A corpus is twenty-one such
# tensors and stays byte-identical.
NONFINITE = "<nonfinite>"


def is_nan_bits(bits):
    return bits & 0x7FFFFFFF > 0x7F800000


def mask_nonfinite_digests(document):
    # An error document carries an empty schedule and a zeroed output, so every branch here is
    # guarded rather than assumed: the mask is applied to every document normalize sees.
    schedule = document["schedule"]
    for row in schedule:
        if row["nonfinite_count"] > 1:
            row["l_out_sha256"] = NONFINITE
            row["l_out_bit_sum"] = NONFINITE
    if schedule and schedule[-1]["nonfinite_count"] > 1:
        document["head"]["result_norm_sha256"] = NONFINITE
        document["head"]["result_norm_bit_sum"] = NONFINITE
    if document["output"]["nonfinite_count"] > 1:
        document["output"]["sha256"] = NONFINITE
        document["output"]["bit_sum"] = NONFINITE
    for entry in document["output"]["top_k"]:
        if is_nan_bits(entry["bits"]):
            entry["bits"] = NONFINITE


def normalize(text):
    document = json.loads(text)
    for key in document["timings"]:
        document["timings"][key] = 0
    for row in document["schedule"]:
        row["pread_ns"] = 0
        row["compute_ns"] = 0
    document["head"]["pread_ns"] = 0
    document["head"]["compute_ns"] = 0
    # The wrap is a measurement, not a golden: it is nanoseconds. `wrap_count` is asserted below
    # and stays in the golden, because how many times the window was handed to the device is a
    # contract and how long that took is not.
    document["window"]["wrap_ns"] = 0
    mask_nonfinite_digests(document)
    for key, placeholder in PLACEHOLDER.items():
        if document[key]:
            document[key] = placeholder
    return json.dumps(document, separators=(",", ":"), ensure_ascii=False)


def build_shim(force):
    environment = dict(os.environ)
    environment.pop("ALIGN_LLM_GGML_INCLUDE", None)
    environment.pop("ALIGN_LLM_GGML_LIB", None)
    if force:
        environment["ALIGN_LLM_GGML_FORCE"] = force
    else:
        environment.pop("ALIGN_LLM_GGML_FORCE", None)
    subprocess.run([builder], check=True, capture_output=True, env=environment)


def run(operands):
    return subprocess.run([binary] + operands, capture_output=True, cwd=work_dir)


failures = []
produced = {}
codes = set()


def record(name, operands, expected):
    result = run(operands)
    if result.stdout == b"":
        failures.append("%s: no document (exit %d): %s"
                        % (name, result.returncode,
                           result.stderr.decode("utf-8", "replace")[-400:]))
        return None
    try:
        document = json.loads(result.stdout.decode("utf-8"))
    except Exception as error:  # noqa: BLE001 - the document is the thing under test
        failures.append("%s: the document is not valid JSON: %s" % (name, error))
        return None
    produced[name] = normalize(result.stdout.decode("utf-8"))
    codes.add(document["error_code"])
    if document["error_code"] != expected:
        failures.append("%s: expected error_code %r, got %r (%r)"
                        % (name, expected, document["error_code"], document["error_detail"]))
    expected_exit = 0 if document["status"] == "ok" else 1
    if (result.returncode == 0) != (expected_exit == 0):
        failures.append("%s: status %r but exit %d"
                        % (name, document["status"], result.returncode))
    if document["kind"] != "R5_MODEL_FORWARD_GPU" or document["schema_version"] != 1:
        failures.append("%s: wrong document identity %r/%r"
                        % (name, document["kind"], document["schema_version"]))
    if not document["abi"]["fp_contract_off"]:
        failures.append("%s: the shim was not built with -ffp-contract=off" % name)
    # Section 3.8: `device.*` is read once, before the window is validated, so **every** document
    # carries the block — including an error document produced at step 21a.
    if "device" not in document or document["device"]["kind"] != "gpu":
        failures.append("%s: the device block is missing or not a gpu arm" % name)
    return document


for name, operands in NO_DOCUMENT:
    result = run(operands)
    if result.returncode == 0:
        failures.append("%s: expected a non-zero exit, got 0" % name)
    if result.stdout != b"":
        failures.append("%s: expected no document, got %d bytes" % (name, len(result.stdout)))

# Section 4.2's first cell, `arm-r5b-unchanged`, in three parts: the R5B arm still answers to its own
# flag, it still emits its own kind, and **its checked-in goldens are byte-identical** — which is the
# mechanical form of sections 3.1 and 3.2's promise that adding a device arm moves nothing in the arm
# it shares a schedule with. The two blocks above this one compare every one of those goldens; this
# asserts the files themselves have not been regenerated to make them agree.
r5b = run(["--model-forward", PACK, GEOM, TOKENS])
if r5b.stdout == b"":
    failures.append("arm-r5b-unchanged: the R5B arm produced no document")
else:
    r5b_document = json.loads(r5b.stdout.decode("utf-8"))
    if r5b_document["kind"] != "R5_MODEL_FORWARD" or r5b_document["schema_version"] != 1:
        failures.append("arm-r5b-unchanged: the R5B arm emitted %r/%r"
                        % (r5b_document["kind"], r5b_document["schema_version"]))
    for field in ("wrap_count", "wrap_ns"):
        if field in r5b_document["window"]:
            failures.append("arm-r5b-unchanged: window.%s leaked into R5_MODEL_FORWARD" % field)
    if "device" in r5b_document:
        failures.append("arm-r5b-unchanged: a device block leaked into R5_MODEL_FORWARD")
    if r5b_document["oracle_logits"]["tolerance_ten_thousandths"] != 5000:
        failures.append("arm-r5b-unchanged: R5B's logits tolerance moved to %d"
                        % r5b_document["oracle_logits"]["tolerance_ten_thousandths"])
for name, corpus in (("model-forward-golden.jsonl", model_golden),
                     ("layer-forward-golden.jsonl", layer_golden)):
    with open(corpus, "r", encoding="utf-8") as handle:
        rows = [json.loads(line) for line in handle if line.strip()]
    if not rows:
        failures.append("arm-r5b-unchanged: %s is empty" % name)
    for row in rows:
        document = json.loads(row["document"])
        if "device" in document or "wrap_count" in document.get("window", {}):
            failures.append("arm-r5b-unchanged: %s case %s carries a device-arm field"
                            % (name, row["case"]))

for name, operands, expected in STUB_CASES:
    document = record(name, operands, expected)
    if document is None:
        continue
    lifetime = document["lifetime"]
    for key in ("ggml_buffers_created", "contexts_created", "backends_created",
                "gallocrs_created"):
        if lifetime[key] != 0:
            failures.append("%s: lifetime.%s is %d in a default stub build, not 0"
                            % (name, key, lifetime[key]))
    if document["window"]["wrap_count"] != 0:
        failures.append("%s: the window was wrapped %d times without a device"
                        % (name, document["window"]["wrap_count"]))

build_shim("engine")
for name, operands, expected in NO_GPU_CASES:
    document = record(name, operands, expected)
    if document is None:
        continue
    if document["error_detail"] != "device":
        failures.append("%s: detail %r, not 'device'" % (name, document["error_detail"]))
    if document["verdict"] != "UNAVAILABLE":
        failures.append("%s: verdict %r" % (name, document["verdict"]))

build_shim("engine+gpu")
for name, operands, expected in GPU_CASES:
    document = record(name, operands, expected)
    if document is None:
        continue
    device = document["device"]
    if device["name"] != "stub-gpu" or device["type_id"] != 1:
        failures.append("%s: device %r" % (name, device))
    if not device["buffer_from_host_ptr"] or device["buffer_alignment"] != 32:
        failures.append("%s: device capabilities %r" % (name, device))
    # Section 6, correction C14: `window_fits` is tri-state. An error document raised before step
    # 21a carries `-1`, "not evaluated", and only a run that reached the check carries `0` or `1`.
    if device["window_fits"] not in (-1, 0, 1):
        failures.append("%s: window_fits %r is not the tri-state -1/0/1"
                        % (name, device["window_fits"]))
    if document["status"] != "ok":
        continue
    graph = document["graph"]
    if document["verdict"] != "EXTERNAL":
        failures.append("%s: verdict %r, not EXTERNAL" % (name, document["verdict"]))
    if graph["graph_count"] != 4 or graph["node_count_total"] != 68:
        failures.append("%s: graph %r" % (name, graph))
    if graph["slot_high_water"] != 52 or graph["slot_capacity"] != 128:
        failures.append("%s: slots %d/%d, not 52/128"
                        % (name, graph["slot_high_water"], graph["slot_capacity"]))
    if graph["backend_name"] != "stub-gpu":
        failures.append("%s: the backend came from the wrong device: %r"
                        % (name, graph["backend_name"]))
    window = document["window"]
    if window["member_placements"] != 27 or window["pointer_identity_failures"] != 0:
        failures.append("%s: %d placements, %d identity failures"
                        % (name, window["member_placements"],
                           window["pointer_identity_failures"]))
    # Section 4.3: the transfer is measured, and section 6 correction C7 is why the count is not
    # simply `graph_count`. The window is filled once per block — `reuse_count` — but it is wrapped
    # once per **graph run**, and at the reconciliation width every layer and the head run twice:
    # once at the runtime width and once at the declared one. One wrap per graph run is what the
    # deferred wrap-once optimization of section 5.4 would change and what section 3.10's per-graph
    # free keeps safe.
    selection = document["selection"]
    wide = selection["reconciliation_width"] > selection["attention_width"]
    layers = document["model"]["n_layer"]
    expected_wraps = 1 + 2 * (layers + 1) if wide else layers + 2
    if window["wrap_count"] != expected_wraps:
        failures.append("%s: %d wraps, not the %d graph runs this pass makes"
                        % (name, window["wrap_count"], expected_wraps))
    if window["reuse_count"] != 4:
        failures.append("%s: the window was filled %d times, not once per block"
                        % (name, window["reuse_count"]))
    if device["window_fits"] != 1 or window["bytes"] > device["buffer_max_size"]:
        failures.append("%s: window_fits %r against max %d"
                        % (name, device["window_fits"], device["buffer_max_size"]))
    if len(document["schedule"]) != 2:
        failures.append("%s: %d schedule rows, not 2" % (name, len(document["schedule"])))
    # Section 2.5: recorded, never gated. Hosted they are -1 and no case fails on them.
    for row in document["schedule"]:
        for field in ("l_out_max_abs_diff_ten_thousandths", "l_out_max_rel_diff_ppm",
                      "l_out_worst_index"):
            if row[field] != -1:
                failures.append("%s: schedule[%d].%s is %r, not the unmeasured -1"
                                % (name, row["layer"], field, row[field]))
    lifetime = document["lifetime"]
    if not lifetime["released_before_owner_scope_end"]:
        failures.append("%s: the teardown did not balance" % name)
    # Section 3.10: on Metal an unfreed device buffer is a process abort, not a leak, so the
    # per-graph balance is load-bearing rather than tidy.
    if lifetime["graph_balance_failures"] != 0:
        failures.append("%s: %d graph boundaries left a ggml object alive"
                        % (name, lifetime["graph_balance_failures"]))
    if lifetime["ggml_buffers_created"] != lifetime["ggml_buffers_freed"]:
        failures.append("%s: %d device buffers created, %d freed"
                        % (name, lifetime["ggml_buffers_created"],
                           lifetime["ggml_buffers_freed"]))

# Section 4.4's oracle cells.
reference = json.loads(produced["gf-gpu-reference"])["reference"]
if reference["verdict"] != "IDENTICAL" or reference["graphs_compared"] != 4 \
        or reference["nodes_identical"] != 37 or reference["nodes_compared"] != 37:
    failures.append("gf-gpu-reference: oracle 1 is bit-exact on a device arm too: %r" % reference)

# Oracle 2's structural half runs and its element half does not, and both halves are asserted so a
# future silent re-enable is a diff.
for case in ("gf-gpu-transcript", "gf-transcript-perturbed"):
    oracle = json.loads(produced[case])["oracle"]
    if oracle["verdict"] != "N/A_DEVICE" or oracle["elements_compared"] != 0:
        failures.append("%s: oracle %r" % (case, oracle))
    if oracle["layers_matched"] != 2 or oracle["layers_expected"] != 2:
        failures.append("%s: %d/%d layers matched by the pre-schedule scan"
                        % (case, oracle["layers_matched"], oracle["layers_expected"]))
if json.loads(produced["gf-transcript-perturbed"])["status"] != "ok":
    failures.append("gf-transcript-perturbed: a perturbed transcript must not fail a device arm")

# Section 3.7's tolerance, at both widths, and the guard that makes it something other than slack.
for case in ("gf-gpu-logits", "gf-gpu-runtime-width"):
    logits = json.loads(produced[case])["oracle_logits"]
    if logits["tolerance_ten_thousandths"] != 6000:
        failures.append("%s: the tolerance moved to %d"
                        % (case, logits["tolerance_ten_thousandths"]))
    if logits["verdict"] not in ("WITHIN", "IDENTICAL"):
        failures.append("%s: %r" % (case, logits))
    if logits["argmax_primary"] != logits["argmax_reference"] or logits["top_k_agreement"] != 10:
        failures.append("%s: argmax/top-k %r" % (case, logits))
    if logits["elements_over_half"] != 0:
        failures.append("%s: %d elements over half a unit"
                        % (case, logits["elements_over_half"]))
# Unlike R5B, the reconciliation width is a tolerance here and not byte-identity (section 3.2).
strict = json.loads(produced["gf-gpu-logits"])["oracle_logits"]
if strict["compared_pass"] != "reconciliation" or strict["verdict"] != "WITHIN":
    failures.append("gf-gpu-logits: the reconciliation pass must be a tolerance here: %r" % strict)
broken = json.loads(produced["gf-logits-perturbed"])
if broken["status"] != "ok" or broken["oracle_logits"]["verdict"] != "FAIL" \
        or broken["oracle_logits"]["argmax_primary"] \
        != broken["oracle_logits"]["argmax_reference"] \
        or broken["oracle_logits"]["top_k_agreement"] != 10:
    failures.append("gf-logits-perturbed: %r" % broken["oracle_logits"])

# Section 6, correction C12: an unrepresentable element can never be `WITHIN`, and a malformed
# reference is an input error with a document rather than a verdict.
for case in ("gf-logits-nonfinite", "gf-logits-nan"):
    document = json.loads(produced[case])
    if document["error_detail"] != "elements[1]":
        failures.append("%s: detail %r, not the count of non-finite reference elements"
                        % (case, document["error_detail"]))
    if document["oracle_logits"]["verdict"] != "-":
        failures.append("%s: a refused reference must publish no verdict, got %r"
                        % (case, document["oracle_logits"]["verdict"]))
huge = json.loads(produced["gf-logits-huge"])["oracle_logits"]
if huge["verdict"] != "FAIL" or huge["max_abs_diff_ten_thousandths"] <= 6000 \
        or huge["elements_over_half"] != 2 or huge["mean_abs_diff_ten_thousandths"] < 0:
    failures.append("gf-logits-huge: an out-of-range reference must not be WITHIN: %r" % huge)

# Both output forms emit byte-identical document bytes, and three consecutive runs agree — which is
# the hosted half of section 3.7's determinism contract.
document_path = os.path.join(work_dir, "model-gpu.json")
stdout_form = run([ARM, PACK, GEOM, TOKENS]).stdout.decode("utf-8").rstrip("\n")
run([ARM, PACK, GEOM, TOKENS, document_path])
with open(document_path, "r", encoding="utf-8") as handle:
    file_form = handle.read()
if normalize(stdout_form) != normalize(file_form):
    failures.append("gf-doc-stdout-identical: the stdout and file forms differ")
dash_form = run([ARM, PACK, GEOM, TOKENS, "-"]).stdout.decode("utf-8").rstrip("\n")
if normalize(dash_form) != normalize(stdout_form):
    failures.append("gf-doc-stdout-identical: the `-` form differs from the four-operand form")
# `gf-gpu-logits` above is the first of the three runs, so this costs two invocations rather than
# three and still compares three independent computations of the same 32 logits.
digests = {json.loads(produced["gf-gpu-logits"])["output"]["sha256"]}
digests |= {json.loads(run([ARM, PACK, GEOM, TOKENS, "-", SOURCE, WIDE, WIDTH, LOGITS])
                      .stdout.decode("utf-8"))["output"]["sha256"] for _ in range(2)}
if len(digests) != 1:
    failures.append("gf-determinism: three consecutive runs produced %d distinct logits digests"
                    % len(digests))

forced_documents = {}
for name, force, operands, expected in FORCED_CASES:
    build_shim(force)
    forced_documents[name] = record(name, operands, expected)

build_shim(None)

limit = forced_documents.get("gf-device-limit")
if limit is not None:
    if not re.fullmatch(r"window\[\d+\]/max\[1024\]", limit["error_detail"]):
        failures.append("gf-device-limit: detail %r does not name the window and the limit"
                        % limit["error_detail"])
    # Section 2.6: the check runs **before the first wrap**, because an oversize wrap segfaults
    # instead of returning null. A document that reports the refusal after wrapping once would mean
    # the guard is in the wrong place.
    if limit["window"]["wrap_count"] != 0:
        failures.append("gf-device-limit: the window was wrapped %d times before the limit check"
                        % limit["window"]["wrap_count"])
    if limit["device"]["window_fits"] != 0:
        failures.append("gf-device-limit: window_fits %r, not the evaluated 0 for a window over "
                        "the limit" % limit["device"]["window_fits"])
no_host = forced_documents.get("gf-no-host-ptr")
if no_host is not None:
    if no_host["device"]["buffer_from_host_ptr"]:
        failures.append("gf-no-host-ptr: the capability flag is still true")
    # Correction C14, and this case is what forced it: step 20b returns before step 21 reads the
    # alignment and before step 21a compares the window, so both fields must say so.
    if no_host["device"]["buffer_alignment"] != -1 or no_host["device"]["window_fits"] != -1:
        failures.append("gf-no-host-ptr: a step 20b document claims alignment %r and window_fits "
                        "%r, neither of which it evaluated"
                        % (no_host["device"]["buffer_alignment"],
                           no_host["device"]["window_fits"]))
gpu_absent = json.loads(produced["gf-no-gpu"])
if gpu_absent["device"]["buffer_alignment"] != -1 \
        or gpu_absent["device"]["window_fits"] != -1:
    failures.append("gf-no-gpu: a step 20a document claims device values it never read: %r"
                    % gpu_absent["device"])
teardown = forced_documents.get("gf-teardown-partial")
if teardown is not None:
    lifetime = teardown["lifetime"]
    if lifetime["ggml_buffers_created"] != lifetime["ggml_buffers_freed"] \
            or lifetime["contexts_created"] != lifetime["contexts_freed"] \
            or lifetime["gallocrs_created"] != lifetime["gallocrs_freed"]:
        failures.append("gf-teardown-partial: a compute failure left a ggml object alive: %r"
                        % lifetime)

# Section 6, correction C19. The tolerance verdict is not slack for an infinity: a non-finite
# element of the arm's **own** vector is reported by `output.nonfinite_count` and never refused
# (section 3.8), and it resolves to a magnitude fifteen orders above the 6,000-ten-thousandth bound
# rather than to a saturated difference the histogram cannot index.
infinite = forced_documents.get("gf-force-inf-readback")
if infinite is not None:
    logits = infinite["oracle_logits"]
    if infinite["status"] != "ok" or logits["verdict"] != "FAIL" \
            or logits["max_abs_diff_ten_thousandths"] != 1000000000000000 \
            or logits["elements_over_half"] < 1 \
            or logits["mean_abs_diff_ten_thousandths"] < 0 \
            or infinite["output"]["nonfinite_count"] < 1:
        failures.append("gf-force-inf-readback: a +inf logit resolved to %r with %d non-finite "
                        "elements" % (logits, infinite["output"]["nonfinite_count"]))
    # Correction C21: the golden carries `<nonfinite>` where a digest covers a NaN, so the digest
    # itself is asserted here instead -- it must still be produced, still be a digest, and the
    # runtime and reconciliation passes must still agree over the NaN-bearing tensors on this host.
    reference = infinite["reference"]
    if reference["verdict"] != "IDENTICAL" \
            or reference["nodes_identical"] != reference["nodes_compared"] \
            or reference["nodes_compared"] < 1:
        failures.append("gf-force-inf-readback: the runtime and reconciliation passes disagree "
                        "over a NaN-bearing tensor: %r" % reference)
    for label, value in (("output.sha256", infinite["output"]["sha256"]),
                         ("head.result_norm_sha256", infinite["head"]["result_norm_sha256"]),
                         ("schedule[-1].l_out_sha256",
                          infinite["schedule"][-1]["l_out_sha256"])):
        if len(value) != 64 or value.strip("0123456789abcdef") != "":
            failures.append("gf-force-inf-readback: %s is %r, not a digest"
                            % (label, value))

# Section 4.1's `gf-status-map` cell: every negative shim status maps to exactly one R5 code, and
# the mapping is total. The scan is over `src/ggml_ffi.align`'s own declarations, so a status added
# without a branch is a failure here rather than a silent `R5_ABI` at run time.
#
# `STATUS_OK` is success and `STATUS_ABI` is deliberately the fall-through: a status this repository
# does not know is `R5_ABI` rather than a silent success, which is precisely the drift the code
# exists to name. That fall-through is asserted to exist, so totality is a checked property and not
# a comment.
ffi = open(os.path.join(root_dir, "src", "ggml_ffi.align"), "r", encoding="utf-8").read()
statuses = set(re.findall(r"^pub (STATUS_[A-Z_]+) := (-?\d+)$", ffi, re.M))
if len(statuses) < 8:
    failures.append("gf-status-map: only %d shim statuses found; is the scan stale?"
                    % len(statuses))
mapper = ffi.split("pub fn r5_code_for(")[1].split("\n}")[0]
unmapped = sorted(name for name, _ in statuses
                  if name not in ("STATUS_OK", "STATUS_ABI") and name not in mapper)
if unmapped:
    failures.append("gf-status-map: %s have no branch in r5_code_for" % ", ".join(unmapped))
if not mapper.rstrip().endswith('return "R5_ABI"'):
    failures.append("gf-status-map: r5_code_for is not total; an unknown status would fall through "
                    "to something other than R5_ABI")

REQUIRED_CODES = {
    "R5_TOKENS", "R5_KV_WIDTH", "R5_GEOMETRY_UNREADABLE", "R5_GEOMETRY", "R4_PACK_UNREADABLE",
    "R5_GGML_UNAVAILABLE", "R5_ALIGNMENT", "R5_COMPUTE", "R5_SOURCE_DIVERGED", "R5_TRANSCRIPT",
    "R5_ORACLE_MISSING", "R5_ORACLE_SHAPE", "R5_LOGITS_UNREADABLE", "R5_LOGITS_SHAPE",
    "R5_LOGITS_NONFINITE",
    "R5C_GPU_UNAVAILABLE", "R5C_NO_HOST_PTR", "R5C_DEVICE_BUFFER_LIMIT",
}
missing_codes = REQUIRED_CODES - codes
if missing_codes:
    failures.append("codes never reached: %s" % ", ".join(sorted(missing_codes)))

ORDER = ([name for name, _, _ in STUB_CASES]
         + [name for name, _, _ in NO_GPU_CASES]
         + [name for name, _, _ in GPU_CASES]
         + [name for name, _, _, _ in FORCED_CASES])

if update:
    with open(golden_path, "w", encoding="utf-8") as handle:
        for name in ORDER:
            handle.write(json.dumps({"case": name, "document": produced[name]},
                                    separators=(",", ":"), ensure_ascii=False) + "\n")
    print("gpu forward smoke: golden rewritten with %d cases" % len(produced))
else:
    with open(golden_path, "r", encoding="utf-8") as handle:
        golden = [json.loads(line) for line in handle if line.strip()]
    if [row["case"] for row in golden] != ORDER:
        failures.append("the golden case list does not match the runner's case list")
    else:
        for row in golden:
            if produced.get(row["case"]) != row["document"]:
                failures.append("golden mismatch for %s:\n  expected %s\n  actual   %s"
                                % (row["case"], row["document"], produced.get(row["case"])))

if failures:
    for line in failures:
        sys.stderr.write("gpu forward smoke: FAIL %s\n" % line)
    raise SystemExit(1)

print("gpu forward smoke: %d no-document cases (R5_ARITY, R5_PATH), %d documented cases, "
      "%d codes reached including all three R5C_*, three oracles, arm-r5b-unchanged, and the whole "
      "two-layer model on a stub GPU device PASS"
      % (len(NO_DOCUMENT), len(ORDER), len(codes - {""}) + 2))
PY

# ---------------------------------------------------------------------------------------------
# R5D-MOE-LAYER-FORWARD — the `--moe-layer-forward` arm over the synthetic routed olmoe layer
#
# `docs/specs/r5d-moe-layer-forward.md` section 5.1 extends this runner rather than adding a
# target, for R5B's and R5C's reason: `layer-forward-smoke` is already a member of
# HOSTED_CHECK_TARGETS, so a fourth block changes no aggregate membership and no check topology.
#
# The corpus is `scripts/layer_forward_fixture.py --moe`: a two-layer olmoe container with
# `n_expert` 8 and `n_expert_used` 3, all F32, and a **pure-Python second implementation** of the
# whole routed layer — the router, the descending argsort, the Align-side top-k slice,
# `mul_mat_id`'s per-`(token, slot)` dot product, and the slot-ordered reduction — whose values the
# synthetic transcript carries. Both new oracles are therefore reachable with no ggml and no model,
# and the routing-identity oracle reaches **full** print coverage here, which the real model's
# eight-slot axis cannot.
# ---------------------------------------------------------------------------------------------

DYLD_LIBRARY_PATH="${shim_dir}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}" \
LD_LIBRARY_PATH="${shim_dir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
python3 - "${root_dir}" "${work_dir}" <<'PY'
import json
import os
import subprocess
import sys

root_dir, work_dir = sys.argv[1:3]
binary = os.path.join(work_dir, "ggml-spike")
builder = os.path.join(root_dir, "scripts", "build-ggml-shim")
golden_path = os.path.join(root_dir, "scripts", "moe-layer-forward-golden.jsonl")
# The arm is pointed at a **writable copy** of the checked-in excerpt, never at the checked-in
# path: `moe_layer_forward` opens its transcript with `fs.open_rw`, because Align ships no
# read-only random-access `file` constructor (`docs/align-requests.md` Request 21), and a read-only
# checkout would refuse the open with `R5_TRANSCRIPT` detail `Denied` before a byte is parsed.
checked_in_excerpt = os.path.join(root_dir, "eval", "fixtures", "olmoe-blk0-6tok.txt")
excerpt = os.path.join(work_dir, "olmoe-blk0-6tok.txt")
with open(checked_in_excerpt, "rb") as handle:
    excerpt_bytes = handle.read()
with open(excerpt, "wb") as handle:
    handle.write(excerpt_bytes)
update = os.environ.get("ALIGN_LLM_LAYER_FORWARD_GOLDEN_UPDATE") == "1"

ARM = "--moe-layer-forward"
PACK = os.path.join(work_dir, "moe-pack.alignpack")
GEOM = os.path.join(work_dir, "moe-geometry.json")
TOKENS = "0,1,8"
SOURCE = os.path.join(work_dir, "moe-source.bin")
TRANSCRIPT = os.path.join(work_dir, "moe-transcript.txt")

# The generator's own second implementation of the routing decision. The document is asserted
# against **this**, not against itself: a routing that is internally consistent and wrong is the
# single most dangerous failure mode in this design (section 3.6).
with open(os.path.join(work_dir, "moe-routing.json"), "r", encoding="utf-8") as handle:
    EXPECTED_ROUTING = json.load(handle)


def path(name):
    return os.path.join(work_dir, name)


NO_DOCUMENT = [
    ("moe-arity-four", [ARM, PACK, GEOM]),
    ("moe-arity-nine", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, TRANSCRIPT, "extra"]),
    ("moe-path-pack-empty", [ARM, "", GEOM, TOKENS]),
    ("moe-path-geometry-empty", [ARM, PACK, "", TOKENS]),
    ("moe-path-long", [ARM, "/" + ("a" * 5000), GEOM, TOKENS]),
    ("moe-path-doc-empty", [ARM, PACK, GEOM, TOKENS, ""]),
    ("moe-path-reference-empty", [ARM, PACK, GEOM, TOKENS, "-", ""]),
    ("moe-arm-unknown-flag", ["--moe-layer-backward", PACK, GEOM, TOKENS]),
]

STUB_CASES = [
    ("moe-stub-unavailable", [ARM, PACK, GEOM, TOKENS], "R5_GGML_UNAVAILABLE"),
    ("moe-tokens-empty", [ARM, PACK, GEOM, ""], "R5_TOKENS"),
    ("moe-tokens-trailing", [ARM, PACK, GEOM, "1,"], "R5_TOKENS"),
    ("moe-tokens-space", [ARM, PACK, GEOM, "1, 2"], "R5_TOKENS"),
    ("moe-tokens-seven", [ARM, PACK, GEOM, "1,2,3,4,5,6,7"], "R5_TOKENS"),
    ("moe-tokens-vocab", [ARM, PACK, GEOM, "1,32"], "R5_TOKENS"),
    ("moe-geometry-absent", [ARM, PACK, path("absent.json"), TOKENS], "R5_GEOMETRY_UNREADABLE"),
    ("moe-geometry-not-json", [ARM, PACK, TRANSCRIPT, TOKENS], "R5_GEOMETRY"),
    ("moe-pack-missing", [ARM, path("absent.alignpack"), GEOM, TOKENS], "R4_PACK_UNREADABLE"),
    ("moe-pack-truncated", [ARM, path("moe-pack-truncated.alignpack"), GEOM, TOKENS],
     "R4_PACK_TRUNCATED"),
    ("moe-block-missing", [ARM, path("moe-pack-no-router.alignpack"), GEOM, TOKENS],
     "R5_BLOCK_MISSING"),
    ("moe-block-ambiguous", [ARM, path("moe-pack-ambiguous.alignpack"), GEOM, TOKENS],
     "R5_BLOCK_AMBIGUOUS"),
    ("moe-member-missing", [ARM, path("moe-pack-no-qnorm.alignpack"), GEOM, TOKENS],
     "R5_MEMBER_MISSING"),
    ("moe-router-shape", [ARM, path("moe-pack-router-shape.alignpack"), GEOM, TOKENS],
     "R5D_ROUTER_SHAPE"),
    ("moe-shape", [ARM, path("moe-pack-shape.alignpack"), GEOM, TOKENS], "R5_SHAPE"),
    # Section 3.8 step 12: expert coverage is checked **before phase A runs**, because discovering
    # a missing expert after the router has chosen it would make a container defect look like a
    # routing defect. The default stub reaches it, which is the proof it is before step 16.
    ("moe-expert-block-missing", [ARM, path("moe-pack-no-expert.alignpack"), GEOM, TOKENS],
     "R5D_CLAIM_MISSING"),
]

# Section 4.1's "a missing field" cell: one fixture per consumed `model` field, each of which must
# be `R5_GEOMETRY` naming that field and nothing else.
GEOMETRY_MISSING = [
    "arch", "n_layer", "n_embd", "n_head", "n_head_kv", "head_dim", "n_ff_exp", "n_vocab",
    "n_expert", "n_expert_used", "context_length", "rms_eps_bits",
    "rope-type", "rope-dim_count", "rope-freq_base_bits", "rope-scaling_type",
]
STUB_CASES.extend(("moe-geometry-missing-" + field,
                   [ARM, PACK, path("moe-geometry-missing-" + field + ".json"), TOKENS],
                   "R5_GEOMETRY")
                  for field in GEOMETRY_MISSING)

# One fixture per precondition of steps 5 to 8, including the two the routed arm owns:
# `n_expert_used` above `n_expert`, and an `n_expert_used` the node-slot store cannot hold.
GEOMETRY_BROKEN = [
    "kind", "version", "arch", "rope-type", "rope-scaled", "rope-dims", "inconsistent",
    "head-kv", "expert-zero", "expert-used-high", "expert-used-huge",
    "eps-nan", "eps-negative", "rope-base-zero", "rope-base-inf",
]
STUB_CASES.extend(("moe-geometry-" + name,
                   [ARM, PACK, path("moe-geometry-" + name + ".json"), TOKENS],
                   "R5_GEOMETRY")
                  for name in GEOMETRY_BROKEN)

