# R6-MOE-RESIDENT-DENSE section 5.3's staging-boundary cell, and the dense arm's
# `ds-resident-stage-full` case verbatim in shape at R6-PREFIX-TTFT's 2048-token boundary. This
# corpus's `n_vocab` is 32, so the prompt repeats `0..31` sixty-four times: every id is valid, and
# slot 2047 carries a real row. The width is `T + N` exactly, the minimum this arm accepts.
#
# **It carries no golden row, on the class R6-RESIDENT-WEIGHTS deviation 9 measured.** A 32-token
# prefill's accumulations differ in the last bit between macOS/arm64 and Linux/x86_64, so pinning its
# digests would make the golden a statement about the machine that regenerated it. It is asserted
# instead by oracle D against its own streamed twin, which is a within-host comparison and therefore
# correct on every platform, plus `record()`'s document-identity assertions and the structural block
# below.
STAGE_FULL = "mdr-resident-stage-full"
STAGE_FULL_TOKENS = ",".join(str(identifier % 32) for identifier in range(2048))
STAGE_FULL_WIDTH = "2049"
STAGE_FULL_STEPS = "1"
BOUNDARY_CASES = [
