binary = os.path.join(work_dir, "ggml-spike")
builder = os.path.join(root_dir, "scripts", "build-ggml-shim")
golden_path = os.path.join(root_dir, "scripts", "moe-layer-forward-golden.jsonl")
# The arm is pointed at a **writable copy** of the checked-in excerpt, never at the checked-in
# path: `moe_layer_forward` opens its transcript with `fs.open_rw`, because Align ships no
# read-only random-access `file` constructor (`docs/align-requests.md` Request 21), and a read-only
# checkout would refuse the open with `R5_TRANSCRIPT` detail `Denied` before a byte is parsed.
checked_in_excerpt = os.path.join(root_dir, "eval", "fixtures", "olmoe-blk0-6tok.txt")
excerpt = os.path.join(work_dir, "olmoe-blk0-6tok.txt")
with open(checked_in_excerpt, "rb") as handle:
    excerpt_bytes = handle.read()
with open(excerpt, "wb") as handle:
    handle.write(excerpt_bytes)
update = os.environ.get("ALIGN_LLM_LAYER_FORWARD_GOLDEN_UPDATE") == "1"

ARM = "--moe-layer-forward"
