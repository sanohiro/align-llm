# R6-PREFIX-KEY section 5.1. The store's own block: **one `STORE` directory per case**, a miss that
# writes and a hit that reads, and the pair compared by oracle K below. Order is the contract — a
# miss must run before the hit that follows it, and `record` runs this list in order — and every
# case is a **separate process**, so the hit reads a container the runner's own earlier process
# wrote and not one it is still holding.
#
# Every activation here stays at three tokens or fewer: `ds-store-miss`/`-hit` are this block's
# three-token prompt and the suffix pair is item 33's `T_prefix = 2`, `S = 1`. The store's own
# golden surface — `store.key`, `store.container_bytes` — is **digests and integers only** and has
# no floating-point input, so it is platform-independent by construction (section 5.3).
STORE_CASES = [
    # The two rows the whole capability turns on. Identical argv; the only difference is that the
    # first one found no file.
    ("ds-store-miss", ds(store=STORE_DIR), ""),
    ("ds-store-hit", ds(store=STORE_DIR), ""),
    # `STORE` + `SUFFIX`, both directions. This is the combination item 33 refused and section 2.5
    # reverses **narrowly**: the caller still cannot express "prefill then suffix", and the miss
    # reaches it only because a keyed miss must persist a `T_prefix`-column plane before continuing.
    # These two are `ds-suffix-1`'s operands with `STORE` in place of `KV_LOAD`, so the comparison
    # below is a comparison of the provenance and of nothing else.
    ("ds-store-suffix-miss",
     ds(tokens=SUFFIX_PREFIX_TOKENS, suffix=SUFFIX_ONE, store=STORE_SUFFIX_DIR), ""),
    ("ds-store-suffix-hit",
     ds(tokens=SUFFIX_PREFIX_TOKENS, suffix=SUFFIX_ONE, store=STORE_SUFFIX_DIR), ""),
    # The `RESIDENT` composition. Oracle K on this pair and oracle R against `ds-store-hit`, whose
    # argv differs in exactly the `RESIDENT` operand and the (unpublished) store directory.
    ("ds-store-resident-miss", ds(store=STORE_RESIDENT_DIR, resident="weights"), ""),
    ("ds-store-resident-hit", ds(store=STORE_RESIDENT_DIR, resident="weights"), ""),
]

# Section 5.2's refusal matrix for the store. Every row asserts its code, its detail, and what the
# `store` object publishes while refusing — which is the point of publishing it in every document.
#
# `ds-suffix-no-load` above is the unchanged row of the widened rule: `SUFFIX` with **neither**
# `KV_LOAD` nor `STORE` is still `R6_KV_ARGS suffix[no_load]`.
STORE_REFUSALS = [
    # Step 2d, both details, in the operands' own order.
    ("ds-store-with-save", ds(save=KV_ABSENT, store=STORE_DIR), "R6_KV_ARGS", "store[with_save]"),
    ("ds-store-with-load", ds(load=KV_GOOD, store=STORE_DIR), "R6_KV_ARGS", "store[with_load]"),
    # Precedence: 2d precedes every numeric parse, so a conflicting provenance is refused before
    # `STEPS` is looked at and before any directory is touched.
    ("ds-store-with-save-bad-steps", ds(save=KV_ABSENT, store=STORE_DIR, steps="0"),
     "R6_KV_ARGS", "store[with_save]"),
    # Precedence: L0 follows step 6, because `kv_width` is **in the preimage** — deriving the key
    # earlier would key on an unvalidated number. The document carries `key: "-"` and
    # `outcome: "absent"`, which says the refusal preceded key derivation.
    ("ds-store-narrow-width", ds(store=STORE_DIR, width="3"), "R6_KV_WIDTH", "kv_width[3]"),
    # W5. One code for three causes the pin cannot separate (Request 53): a directory that does not
    # exist, and a path that is a regular file, are the same refusal and the detail names the
    # **operand** rather than guessing the cause. Both pay a full prefill first, which section 2.6
    # records as a deliberate cost rather than an oversight.
    ("ds-store-unwritable", ds(store=STORE_ABSENT_DIR), "R6_KV_UNWRITABLE", "store[create]"),
    ("ds-store-file-not-dir", ds(store=STORE_FILE), "R6_KV_UNWRITABLE", "store[create]"),
    # W5 at the **other** call site, which is the one this capability moved. A keyed miss with a
    # suffix saves before the suffix pass (section 12, D14), so its create failure is reported from
    # a site no prior capability could reach — `SUFFIX` was illegal beside `KV_SAVE`. The row pins
    # that the same code and the same detail come out of it and that the run is **refused there**:
    # the suffix pass does not run, no step runs, and the arm does not continue with a prefix it
    # could not persist. Without it the moved site's failure branch has no regression at all.
    ("ds-store-suffix-unwritable",
     ds(tokens=SUFFIX_PREFIX_TOKENS, suffix=SUFFIX_ONE, store=STORE_ABSENT_DIR),
     "R6_KV_UNWRITABLE", "store[create]"),
    # **A miss is only a missing file.** A file that exists at the key path is loaded through L1–L14
    # and every failure there is that check's refusal — never a silent re-prefill. Three of them,
    # built by placing a container at a key path it does not describe.
    ("ds-store-hit-corrupt-plane", ds(store=STORE_CORRUPT_DIR), "R6_KV_DIGEST", "plane"),
    ("ds-store-hit-wrong-tokens", ds(store=STORE_WRONG_TOKENS_DIR), "R6_KV_TOKENS", "2"),
    ("ds-store-hit-wrong-pack", ds(store=STORE_WRONG_PACK_DIR), "R6_KV_IDENTITY", "pack"),
]

ENGINE_CASES = ENGINE_CASES + [(name, operands, code) for name, operands, code, _, _, _
                               in KV_REFUSALS] \
    + STORE_CASES + [(name, operands, code) for name, operands, code, _ in STORE_REFUSALS]

# Section 5.2 and section 11.1 correction 13's bound, approached from the side no refusal reaches.
# `slot` is bounded by `tokens.count` at both `stage_embed_row` call sites, so a prompt of exactly
# `MAX_PREFILL_TOKENS` ids stages slot 2047 — the highest index any caller can produce — and the
# corpus stops containing only three-token prompts. On this fixture the stage's 2048 x 32 B of rows
# occupy 65,536 bytes; what the case pins
# is the **token count**, and a destination bound one row too tight would turn this legal run into
# `R5_SHAPE`.
#
# **It carries no golden row, and the reason is a measured one.** The golden is committed and
# compared byte for byte on macOS/arm64 and on Linux/x86_64, and the earlier 32-token prefill's `l_out` and
# logits digests differ between them in the last bit (`.schedule[0].l_out_bit_sum` 538248184962
# against 538248184963 on the first CI run of this case) — long accumulations and 32 rows of `exp`
# reach a host difference the three-token corpus never does. Pinning a host-specific digest would
# make the golden a statement about the machine that regenerated it. The case is asserted instead by
# oracle R against its streamed twin, which is a **within-host** comparison and therefore correct on
# every platform, plus `record()`'s document-identity assertions and the structural block below.
#
# R6-PREFIX-SUFFIX-PREFILL section 5.7 adds the second member for the same measured reason at a much
# smaller size. `ds-suffix-2`'s single-shot comparand is a **four**-token prefill, and its
# `.schedule[1].l_out_bit_sum` is 12689786356 on macOS/arm64 against 12689786355 on Linux/x86_64,
# with `.schedule[1].l_out_sha256` differing with it. Four tokens, not thirty-two: the host boundary
# this fixture's arithmetic reaches is far lower than the staging case suggested, and section 6
# risk 4's five-column reasoning is wrong as stated. What the case exists for is unaffected, and for
# exactly the oracle-R argument above: oracle S compares `ds-suffix-2` against it **within one host**
# and is therefore correct on every platform, and `record()`'s document-identity assertions still
# run. Every other new row in this capability — including the five-token single-shot and the three
# suffix successes — was byte-identical on both hosts in the run that found this, so only the
# measured case moves.
#
# MF-SINGLE-TOKEN-LOGITS adds the third and fourth members, and moves the boundary again: the
# **decode step after a two-token prefill** differs across hosts. `ds-suffix-single-shot-2` and the
# `T_prefix = 1` suffix run it is the comparand for both publish `.steps[0].bit_sum` 71850835819 on
# macOS/arm64 against 71850835587 on Linux/x86_64, with `.steps[0].sha256` differing with it, found
# by this capability's first hosted CI run. Two tokens, not four -- and the drift is in the decode
# step rather than in the prefill, which is why `ds-suffix-save-prefix-one` and `ds-tokens-one`,
# whose prefill is **one** token, stay pinned and were byte-identical on both hosts. The pair is
# asserted exactly as `ds-suffix-2` is: oracle S compares the two **within one host**, oracle C''
# compares the suffix run against `--model-forward` on the same host, and `record()`'s
# document-identity assertions run. They are documented cases without golden rows.
BOUNDARY_CASES = [
    (STAGE_FULL, ds(tokens=STAGE_FULL_TOKENS, transcript="-", width=STAGE_FULL_WIDTH,
                    steps=STAGE_FULL_STEPS, resident="weights"), ""),
    (SUFFIX_SINGLE_SHOT_4, ds(tokens=SUFFIX_FULL_FOUR, transcript="-"), ""),
    # The comparand first, so oracle S below always finds a document that already exists. Both need
    # `ds-suffix-save-prefix-one`'s container, which `ENGINE_CASES` above wrote.
    ("ds-suffix-single-shot-2", ds(tokens=SUFFIX_FULL_TWO, transcript="-"), ""),
    ("ds-suffix-prefix-one",
     ds(load=KV_PREFIX_ONE, tokens=SUFFIX_PREFIX_ONE, suffix=SUFFIX_ONE, transcript="-"), ""),
    # R6-PREFIX-TTFT: save the two-token prefix, compare the exact 2,048-token sequence as a
    # single-shot run, then continue the saved plane with 2,046 suffix tokens. These carry no
    # cross-host golden; oracle S and C'' compare them within one host below.
    ("ds-suffix-save-prefix-cap",
     ds(save=KV_PREFIX_CAP, tokens=SUFFIX_PREFIX_TOKENS, transcript="-", width=SUFFIX_CAP_WIDTH,
        steps="1", resident="weights"), ""),
    ("ds-suffix-single-shot-cap",
     ds(tokens=SUFFIX_FULL_CAP, transcript="-", width=SUFFIX_CAP_WIDTH, steps="1",
        resident="weights"), ""),
    ("ds-suffix-at-cap",
     ds(load=KV_PREFIX_CAP, tokens=SUFFIX_PREFIX_TOKENS, suffix=SUFFIX_AT_CAP, transcript="-",
        width=SUFFIX_CAP_WIDTH, steps="1", resident="weights"), ""),
]
# MF-SINGLE-TOKEN-LOGITS sections 1 and 4. `decode_step`'s prefill is `model_forward`'s, so the
# one-token gather reaches this arm too -- and this is the arm where the defect was **not** silent:
# `stage_embed_row` stages the right row, `compare_source` expected row 0, and a one-token non-zero
# resident run with a REFERENCE reported `R5_SOURCE_DIVERGED` over a correct window. The pair is
# oracle R's shape: the two invocations differ in exactly the `RESIDENT` operand, so the streamed
# leg and the resident leg must produce the same document and both must complete.
ONE_TOKEN_CASES = [
    ("ds-tokens-one", ds(tokens="3", transcript="-"), ""),
    ("ds-tokens-one-resident", ds(tokens="3", transcript="-", resident="weights"), ""),
]

FORCED_CASES = [
    ("ds-force-init", "engine+init", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", WIDTH],
     "R5_GGML_INIT"),
    ("ds-force-alloc", "engine+alloc", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", WIDTH],
     "R5_ALLOC"),
    ("ds-force-compute", "engine+compute", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", WIDTH],
     "R5_COMPUTE"),
    ("ds-force-slot-range", "engine+slot-range", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", WIDTH],
     "R5_SLOT"),
    # Section 4.5's `ds-stub-concat-axis` cell. A wrong concat axis is not producible from any
    # operand the decode table can supply — `dim` is a compiled-in column of the row, 1 for K and 0
    # for V — so the refusal is exercised by a build rather than reasoned about.
    ("ds-force-concat-axis", "engine+concat-axis",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", WIDTH], "R5_SHAPE"),
    # Section 4.2's `plane failure` row and oracle B's own shipped regression. The build shifts the
    # staged past K by one lane inside slot 64, which only the decode graph writes: every shape stays
    # valid and the graph computes a plausible answer, and the bytes it consumed no longer equal the
    # bytes the prefill wrote. Without this case `R6_PLANE_MISMATCH` is reachable only by mutating
    # the source, which is evidence that lives in a table rather than in a run.
    ("ds-force-plane-stage-offset", "engine+plane-stage-offset",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", WIDTH], "R6_PLANE_MISMATCH"),
    # Section 11.1's "positions are `[n_past]`" and "mask `{KV_WIDTH, 1}` with offset" rows, which
    # until now cited source mutations. Both are oracle A failures rather than refusals — the run is
    # `status: ok` with a `FAIL` verdict — so both supply the transcript, and the assertions below
    # the table are what make them regressions rather than golden rows.
    ("ds-force-decode-position", "engine+decode-position",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, TRANSCRIPT, WIDTH], ""),
    ("ds-force-mask-offset", "engine+mask-offset",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, TRANSCRIPT, WIDTH], ""),
    # R6-STEP-N section 4.1's `failure` cell: the axis this capability adds. The build fails compute
    # once the past-K upload has grown, so step 1 completes and step 2 does not, and the document
    # publishes what step 1 did — which is the whole point of the per-step failure contract.
    ("ds-force-compute-step2", "engine+compute-step2",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", WIDTH, "-", STEPS], "R5_COMPUTE"),
    # R6-STEP-N section 4.2's `failure -- round trip` cell. The step's own written column is shifted
    # by one lane, and oracle B reports column `T` — which is what proves the **new** column is
    # compared and not only the past ones.
    ("ds-force-writeback-offset", "engine+writeback-offset",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", WIDTH], "R6_PLANE_MISMATCH"),
    # R6-RESIDENT-WEIGHTS section 5.1's early-exit cell, restored by section 11.1 correction 12.
    # The design named this case and the first implementation retired it as "unnecessary", on the
    # reasoning that no early `return` exists between the arena's construction and the converged
    # teardown. That reasoning was right about control flow and wrong about the **invariant**: a
    # resident run can still *fail* in that window — the fill can raise `R4_PACK_UNREADABLE`, or the
    # wrap itself can be refused — and the run-scope balance check has to stay silent when it does.
    # `buffer_from_host` refusing is the one way an input can reach that window, and the run it
    # produces has a filled, live arena, no wrap, and one teardown ahead of it.
    # R6-PREFIX-SUFFIX-PREFILL section 4.1's `failure` cell. The build refuses the compute of any
    # graph with more than one column at `n_past > 0`, which is the suffix pass and nothing else, so
    # the document it produces is a statement about a partial **pass**: no completion, no counts, no
    # step, the loaded plane's own column count, and the **container's** `output`.
    ("ds-force-compute-suffix", "engine+compute-suffix",
     ds(load=KV_PREFIX, tokens=SUFFIX_PREFIX_TOKENS, suffix=SUFFIX_THREE, transcript="-",
        steps=SUFFIX_STEPS_THREE),
     "R5_COMPUTE"),
    # Section 4.2's `failure -- round trip` cell. The pass's written bytes are shifted one lane, and
    # oracle B reports column `T_prefix` — which is what proves the **first suffix** column is
    # compared and not only the loaded ones.
    ("ds-force-suffix-writeback-offset", "engine+suffix-writeback-offset",
     ds(load=KV_PREFIX, tokens=SUFFIX_PREFIX_TOKENS, suffix=SUFFIX_THREE, transcript="-",
        steps=SUFFIX_STEPS_THREE),
     "R6_PLANE_MISMATCH"),
    ("ds-force-resident-wrap", "engine+resident-wrap",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", WIDTH, "-", STEPS, "-", "-", "weights"],
     "R5_GGML_INIT"),
]


def describe_difference(expected_text, actual_text, limit=8):
    if actual_text is None:
        return "no document was produced"
    try:
        expected = json.loads(expected_text)
        actual = json.loads(actual_text)
    except Exception as error:  # noqa: BLE001 - the document is the thing under test
        return "the documents are not both JSON: %s" % error
    differences = []

    def walk(left, right, path):
        if len(differences) >= limit:
            return
        if type(left) is not type(right):
            differences.append("%s: %r != %r" % (path or ".", left, right))
        elif isinstance(left, dict):
            for key in sorted(set(left) | set(right)):
                if len(differences) >= limit:
                    return
                if key not in left:
                    differences.append("%s.%s: absent != %r" % (path, key, right[key]))
                elif key not in right:
                    differences.append("%s.%s: %r != absent" % (path, key, left[key]))
                else:
                    walk(left[key], right[key], "%s.%s" % (path, key))
        elif isinstance(left, list):
            if len(left) != len(right):
                differences.append("%s: %d entries != %d" % (path, len(left), len(right)))
                return
            for index in range(len(left)):
                if len(differences) >= limit:
                    return
                walk(left[index], right[index], "%s[%d]" % (path, index))
        elif left != right:
            differences.append("%s: %r != %r" % (path or ".", left, right))

    walk(expected, actual, "")
    if not differences:
        return "the documents differ only in text form"
    return "expected != actual at " + "; ".join(differences)


PLACEHOLDER = {"pack_path": "<pack>", "geometry_path": "<geometry>",
               "reference_path": "<reference>", "transcript_path": "<transcript>",
               "logits_path": "<logits>"}


def normalize(text):
    document = json.loads(text)
    for key in document["timings"]:
        document["timings"][key] = 0
    for row in document["schedule"]:
        row["pread_ns"] = 0
        row["compute_ns"] = 0
    document["head"]["pread_ns"] = 0
    document["head"]["compute_ns"] = 0
    document["decode"]["compute_ns"] = 0
    # R6-STEP-N section 2.9, and section 6 risk 5's named prior failure class: a **per-step** timing
    # array is the exact place a golden goes non-deterministic, so every row's own `compute_ns` is
    # zeroed as well as the loop's sum.
    for row in document["steps"]:
        row["compute_ns"] = 0
    document["plane"]["readback_ns"] = 0
    document["plane"]["upload_ns"] = 0
    # R6-KV-PERSIST section 2.9: two single intervals and one labelled diagnostic, all wall clock.
    document["kv"]["write_ns"] = 0
    document["kv"]["read_ns"] = 0
    # R6-RESIDENT-WEIGHTS section 3.5. `fill_ns` is the only clock the `weights` object holds and it
    # is zeroed here. `fill_pread_count`, `fill_bytes`, `resident_bytes`, and `step_pack_bytes` are
    # deliberately **not** normalized: they are deterministic and they are the claim.
    document["weights"]["fill_ns"] = 0
    # R6-PREFIX-SUFFIX-PREFILL section 2.9. `compute_ns` is the only clock the `suffix` object holds.
    # The other ten fields are deliberately **not** normalized: they are deterministic and they are
    # the contract — `columns_written` is what a partial pass must not advance, `sequence_length` is
    # what a reader compares against a single-shot run's `selection.token_count`, and `pack_bytes` is
    # exactly zero on the resident leg.
    document["suffix"]["compute_ns"] = 0
    # R6-PREFIX-KEY section 2.9. `lookup_ns` is the only clock the `store` object holds. `key`,
    # `outcome`, `saved`, and `container_bytes` are deliberately **not** normalized: the key is a
    # digest over exact bytes, the other three are exact, and all four are the contract.
    document["store"]["lookup_ns"] = 0
    for key, placeholder in PLACEHOLDER.items():
        if document[key]:
            document[key] = placeholder
    # Section 6 risk 2's temp-path class. The `kv` object publishes no path by contract, but
    # `R6_KV_EXISTS` and `R6_KV_CLEANUP_FAILED` name the destination in `error_detail` — which is a
    # `mktemp -d` path and would make the golden a function of this run's temporary directory. It is
    # replaced by a placeholder here, exactly as the five top-level path fields are, and the case
    # table below asserts the placeholder so the substitution cannot hide a wrong detail.
    #
    # **This substitution covers `KV_SAVE`/`KV_LOAD` runs only.** A store run's own cleanup failure
    # reports the operand — `R6_KV_UNWRITABLE store[create]`'s sibling `store[cleanup]`, section 12
    # D16 — because a derived name is the arm's own and section 2.7 publishes no path anywhere. That
    # detail needs no normalization, which is the point of mapping it in the arm rather than here.
    if document["error_detail"].startswith(work_dir):
        document["error_detail"] = "<path>"
    return json.dumps(document, separators=(",", ":"), ensure_ascii=False)


# R6-KV-PERSIST section 3, oracle Q. `normalize` plus the keys that are **counts of work the load
# path legitimately did not do**, and nothing else. What remains inside the comparison is the point:
# `decode` in full including `token_ids`, every object of `steps[]` including each step's `sha256`,
# `argmax`, `n_past`, `plane_column_written`, and complete `oracle` sub-object;
# `plane.columns_written`, `roundtrip_verdict`, `roundtrip_bytes_compared`, and every
# `first_mismatch_*`; `output` and `oracle_logits`; `oracle_decode` in full; and `model`,
# `selection`, `window`'s sizes, `head`'s digests, and `abi`.
# `weights` joins the excluded blocks for the same reason `pack.reader_*` and `window.reuse_count`
# are already excluded: a load run skips the prefill, so it wraps fewer windows and reads fewer pack
# bytes. Its own contents are asserted for every case in `record` and, for the resident legs, by
# oracle R below.
PERSIST_EXCLUDED_BLOCKS = ("kv", "graph", "schedule", "timings", "lifetime", "reference",
                           "weights")
PERSIST_EXCLUDED_FIELDS = (
    # The prefill's own graph, absent by design on a load run.
    ("plane", "source"), ("plane", "readback_ns"), ("plane", "upload_ns"),
    ("head", "node_count"), ("head", "pread_ns"), ("head", "compute_ns"),
    # Pack reads and window fills the prefill performed and the load did not.
    ("pack", "reader_pread_count"), ("pack", "reader_bytes_read"),
    ("window", "reuse_count"), ("window", "member_placements"),
)


# R6-RESIDENT-WEIGHTS section 4.1, oracle R. `normalize` plus the four things residency is
# **supposed** to change and nothing else, enumerated here rather than pattern-matched so that the
# exclusion cannot quietly grow:
#
#   * the `weights` object, which is the capability's own report;
#   * `pack.reader_pread_count` / `pack.reader_bytes_read`, which are the claim;
#   * `lifetime.ggml_buffers_created` / `lifetime.ggml_buffers_freed`, because the weight wrap is
#     hoisted to run scope and counted in its own pair (section 4.3). The design document's
#     section 4.1 enumerated only the first two; the lifetime pair is a deviation recorded in
#     section 5 of that document, and it is *narrow* — the per-graph pair still balances, and
#     `weights.resident_wraps_created`/`_freed` are asserted to be exactly one each.
#
# What stays inside the comparison is the point: every decoded token id, every per-step oracle
# result and digest, the plane in full including oracle B's byte count, the head's logits and
# digest, `window.pointer_identity_failures` and `member_placements`, `window.reuse_count`,
# `graph` in full, `verdict`, and `error_code`/`error_detail`.
RESIDENT_EXCLUDED_BLOCKS = ("weights",)
RESIDENT_EXCLUDED_FIELDS = (
    ("pack", "reader_pread_count"), ("pack", "reader_bytes_read"),
    ("lifetime", "ggml_buffers_created"), ("lifetime", "ggml_buffers_freed"),
)


def normalize_resident(text):
    document = json.loads(text)
    for block in RESIDENT_EXCLUDED_BLOCKS:
        document.pop(block, None)
    for block, field in RESIDENT_EXCLUDED_FIELDS:
        document[block].pop(field, None)
    return json.dumps(document, separators=(",", ":"), ensure_ascii=False)


# R6-PREFIX-SUFFIX-PREFILL section 3.2, oracle S. `normalize` plus the keys that are **counts of
# work the two runs legitimately did differently**, and nothing else. The design fixed a list of
# seven blocks and eleven fields; four more fields were needed and each one is a recorded finding
# with a **compensating assertion** rather than a quiet addition (section 11, findings 1 and 2),
# because a growing exclusion list is how an equality oracle stops being one:
#
#   * `selection.tokens`, `selection.narrow_index`, `selection.attention_width` describe the
#     `TOKENS` operand, which is the prefix on one side and the whole list on the other. Compensated
#     by the loop below, which asserts the prefix's list **plus the suffix ids** equals the
#     single-shot's, and that both documents' `narrow_index`/`attention_width` are the arithmetic of
#     their own `token_count`.
#   * `plane.roundtrip_bytes_compared` cannot agree: the suffix run verifies the plane once more
#     than the single-shot run does, before its first decode step. Compensated by the exact
#     identity `suffix == single + 2 * n_layer * (T + S) * n_head_kv * head_dim * 4`.
#   * `window.residual_bytes` is `n_embd * TOKENS.count * 4`, the prefill's own reservation.
#     Compensated by asserting that arithmetic on both sides.
#
# What remains inside the comparison is the point: `output` in full — the suffix pass's own logits
# against the single-shot prefill's, which is oracle C'' inside oracle S; `oracle_logits` in full;
# `decode` in full including `token_ids`; every object of `steps[]` including each step's `sha256`,
# `argmax`, `n_past`, `plane_column_written`, and complete `oracle` sub-object;
# `plane.columns_written`, `roundtrip_verdict`, and every `first_mismatch_*`; `oracle_decode` in
# full; and `model`, `head`, `abi`, `weights`, `verdict`, and `error_code`/`error_detail`.
SUFFIX_EXCLUDED_BLOCKS = ("kv", "suffix", "graph", "schedule", "timings", "lifetime", "reference")
SUFFIX_EXCLUDED_FIELDS = (
    ("plane", "source"), ("plane", "readback_ns"), ("plane", "upload_ns"),
    ("plane", "roundtrip_bytes_compared"),
    ("selection", "token_count"), ("selection", "tokens"), ("selection", "narrow_index"),
    ("selection", "attention_width"),
    ("head", "node_count"), ("head", "pread_ns"), ("head", "compute_ns"),
    ("pack", "reader_pread_count"), ("pack", "reader_bytes_read"),
    ("window", "reuse_count"), ("window", "member_placements"), ("window", "residual_bytes"),
)


def normalize_suffix(text):
    document = json.loads(normalize(text))
    for block in SUFFIX_EXCLUDED_BLOCKS:
        document.pop(block, None)
    for block, field in SUFFIX_EXCLUDED_FIELDS:
        document[block].pop(field, None)
    return json.dumps(document, separators=(",", ":"), ensure_ascii=False)


def normalize_persist(text):
    document = json.loads(normalize(text))
    for block in PERSIST_EXCLUDED_BLOCKS:
        document.pop(block, None)
    for block, field in PERSIST_EXCLUDED_FIELDS:
        document[block].pop(field, None)
    return json.dumps(document, separators=(",", ":"), ensure_ascii=False)


# R6-PREFIX-KEY section 3.1, **oracle K — the capability's acceptance rule**: a hit and the miss that
# filled it are the same run. It is oracle Q's comparison plus exactly three fields, and that is not
# a widening: a keyed miss **is** a save run and a keyed hit **is** a load run, so the blocks oracle Q
# excludes are excluded here for the same reason — a load run skips the prefill, so it builds no
# prefill graph, reads fewer pack bytes, and fills fewer windows. Section 3.1's own exclusion list
# names `kv.*` and `pack.reader_*` as "the counters item 30 already excludes", which is that set.
#
# The three added are the store's own report and nothing else:
#
#   * `store.outcome`  miss -> hit, which is the thing being tested;
#   * `store.saved`    1 -> 0, likewise;
#   * `store.lookup_ns` a clock, already zeroed by `normalize` and popped here so the exclusion is
#     stated where a reader looks for it.
#
# **`store.key` and `store.container_bytes` stay inside the comparison**, which is what makes the
# oracle catch a key that varies between runs and a container written with the wrong layout.
STORE_EXCLUDED_FIELDS = (("store", "outcome"), ("store", "saved"), ("store", "lookup_ns"))


def normalize_store(text):
    document = json.loads(normalize_persist(text))
    for block, field in STORE_EXCLUDED_FIELDS:
        document[block].pop(field, None)
    return json.dumps(document, separators=(",", ":"), ensure_ascii=False)


def build_shim(force):
    environment = dict(os.environ)
    environment.pop("ALIGN_LLM_GGML_INCLUDE", None)
    environment.pop("ALIGN_LLM_GGML_LIB", None)
    if force:
        environment["ALIGN_LLM_GGML_FORCE"] = force
    else:
        environment.pop("ALIGN_LLM_GGML_FORCE", None)
    subprocess.run([builder], check=True, capture_output=True, env=environment)


def run(operands, environment=None):
    return subprocess.run([binary] + operands, capture_output=True, cwd=work_dir, env=environment)


def read_container(container, kind=None, tokens=TOKENS, quiet=True):
    """`scripts/kv_plane_reader.py`, always as a **subprocess and never imported**
    (`scripts/run-alignpack-smoke`'s rule): a shared interpreter state would let the two
    implementations agree by accident. `quiet=False` is R6-PREFIX-KEY's own use: the report carries
    the reader's independently derived `key`, which oracle D compares against the file's name."""
    command = ["python3", READER, "--plane", container, "--pack", PACK, "--geometry", GEOM,
               "--tokens", tokens]
    if quiet:
        command += ["--quiet"]
    if kind is not None:
        command += ["--expect-reject", kind]
    return subprocess.run(command, capture_output=True, cwd=work_dir)


# The eleven fields of section 2.9's `suffix` object. Asserted as a **set** on every document, so a
# field added or dropped without moving this list is a failure rather than a silently smaller object.
SUFFIX_FIELDS = ("requested", "completed", "token_count", "n_past_base", "sequence_length",
                 "columns_written", "first_column", "graph_count", "node_count", "pack_bytes",
                 "compute_ns")

# The six fields of R6-PREFIX-KEY section 2.7's `store` object, asserted as a **set** on every
# document for the same reason: a field added or dropped without moving this list is a failure rather
# than a silently smaller object.
STORE_FIELDS = ("requested", "key", "outcome", "saved", "container_bytes", "lookup_ns")

failures = []
produced = {}
codes = set()


def record(name, operands, expected):
    result = run(operands)
    if result.stdout == b"":
        failures.append("%s: no document (exit %d): %s"
                        % (name, result.returncode,
                           result.stderr.decode("utf-8", "replace")[-400:]))
        return None
    try:
        document = json.loads(result.stdout.decode("utf-8"))
    except Exception as error:  # noqa: BLE001 - the document is the thing under test
        failures.append("%s: the document is not valid JSON: %s" % (name, error))
        return None
    produced[name] = normalize(result.stdout.decode("utf-8"))
    codes.add(document["error_code"])
    if document["error_code"] != expected:
        failures.append("%s: expected error_code %r, got %r (%r)"
                        % (name, expected, document["error_code"], document["error_detail"]))
    expected_exit = 0 if document["status"] == "ok" else 1
    if (result.returncode == 0) != (expected_exit == 0):
        failures.append("%s: status %r but exit %d"
                        % (name, document["status"], result.returncode))
    if document["kind"] != "R6_DECODE_STEP" or document["schema_version"] != 6:
        failures.append("%s: wrong document identity %r/%r"
                        % (name, document["kind"], document["schema_version"]))
    # R6-RESIDENT-WEIGHTS section 3.5: the `weights` object is present in **every** document,
    # including one refused before a file is opened, so the mode a run took is never implicit. The
    # hazard it closes is a caller who wanted residency, forgot the operand, and read a document
    # that did not say so.
    weights = document.get("weights")
    if not isinstance(weights, dict) or weights.get("mode") not in ("stream", "resident"):
        failures.append("%s: the document published no weights mode: %r" % (name, weights))
    elif weights["mode"] == "stream" and (weights["resident_bytes"] != 0
                                          or weights["fill_ns"] != 0
                                          or weights["fill_pread_count"] != 0
                                          or weights["fill_bytes"] != 0
                                          or weights["resident_wraps_created"] != 0
                                          or weights["resident_wraps_freed"] != 0):
        failures.append("%s: a streamed document published resident figures: %r" % (name, weights))
    # R6-PREFIX-SUFFIX-PREFILL section 2.9: the `suffix` object is present in **every** document with
    # **one shape at every arity**, including one refused before a file is opened, so the suffix a
    # run was asked for is never implicit. The hazard it closes is a caller who wanted a suffix,
    # forgot the operand, and read a document that did not say so — and, since schema 5, a reader who
    # cannot otherwise tell whether `output` describes the container's vector or this run's own pass.
    #
    # The last clause is section 6 risk 3's guard against a **vacuous** completion: a pass that
    # published `completed` without having written its own columns.
    suffix = document.get("suffix")
    if not isinstance(suffix, dict) or sorted(suffix) != sorted(SUFFIX_FIELDS):
        failures.append("%s: the document published no suffix object: %r" % (name, suffix))
    elif not suffix["requested"] and (suffix["token_count"] != 0 or suffix["completed"] != 0
                                      or suffix["n_past_base"] != -1
                                      or suffix["sequence_length"] != -1
                                      or suffix["columns_written"] != -1
                                      or suffix["first_column"] != -1
                                      or suffix["graph_count"] != 0 or suffix["node_count"] != 0
                                      or suffix["pack_bytes"] != 0):
        failures.append("%s: a document with no suffix published suffix figures: %r"
                        % (name, suffix))
    elif suffix["completed"] and suffix["columns_written"] != suffix["sequence_length"]:
        failures.append("%s: a completed suffix wrote %d columns, not its own sequence length %d"
                        % (name, suffix["columns_written"], suffix["sequence_length"]))
    # R6-PREFIX-KEY section 2.7: the `store` object is present in **every** document, including one
    # refused before the key was derived, so "this run missed" is never silent and a caller who
    # mistyped the directory reads a document that says which run they got. The clauses below are the
    # object's own consistency: a run that asked for no store publishes nothing about one, `saved` is
    # `1` only on a **complete** write (which no hit and no refusal can claim), and a run refused
    # before L0 publishes `key: "-"`, which is itself information.
    store = document.get("store")
    if not isinstance(store, dict) or sorted(store) != sorted(STORE_FIELDS):
        failures.append("%s: the document published no store object: %r" % (name, store))
    elif not store["requested"] and (store["key"] != "-" or store["outcome"] != "absent"
                                     or store["saved"] != 0 or store["container_bytes"] != 0
                                     or store["lookup_ns"] != 0):
        failures.append("%s: a document with no store published store figures: %r" % (name, store))
    elif store["outcome"] not in ("absent", "hit", "miss"):
        failures.append("%s: store.outcome is %r" % (name, store["outcome"]))
    elif store["saved"] and store["outcome"] != "miss":
        failures.append("%s: a %r run claimed it saved: %r" % (name, store["outcome"], store))
    elif (store["key"] == "-") != (store["outcome"] == "absent"):
        failures.append("%s: store.key and store.outcome disagree: %r" % (name, store))
    elif store["key"] != "-" and len(store["key"]) != 64:
        failures.append("%s: store.key is %r" % (name, store["key"]))
    if not document["abi"]["fp_contract_off"]:
        failures.append("%s: the shim was not built with -ffp-contract=off" % name)
    # R6-STEP-N section 2.8, on **every** document including the error ones: the loop-level
    # aggregates are aggregates over the completed steps, and a partial step contributes no row and
    # therefore no counts. Without this a document could report work that no published row accounts
    # for, which is the same defect as a half-filled row wearing a different name.
    rows = document["steps"]
    decode = document["decode"]
    if decode["steps_completed"] != len(rows):
        failures.append("%s: steps_completed %d with %d rows"
                        % (name, decode["steps_completed"], len(rows)))
    if decode["node_count"] != sum(row["node_count"] for row in rows):
        failures.append("%s: decode.node_count %d is not the sum of the %d published rows"
                        % (name, decode["node_count"], len(rows)))
    # `n_layer + 2` graphs per step on this geometry: the embedding gather, both layers, the head.
    if decode["graph_count"] != 4 * len(rows):
        failures.append("%s: decode.graph_count %d, not 4 x %d completed steps"
                        % (name, decode["graph_count"], len(rows)))
    if (decode["slot_high_water"] > 0) != bool(rows):
        failures.append("%s: slot_high_water %d with %d completed steps"
                        % (name, decode["slot_high_water"], len(rows)))
    return document


for name, operands in NO_DOCUMENT:
    result = run(operands)
    if result.returncode == 0:
        failures.append("%s: expected a non-zero exit, got 0" % name)
    if result.stdout != b"":
        failures.append("%s: expected no document, got %d bytes" % (name, len(result.stdout)))

# R6-KV-PERSIST section 5.2's three destination cases need a filesystem state rather than a file
# with a defect in it. All three live under `work_dir`; the `0555` directory is restored to writable
# by the shell trap before `rm -rf`, so it cannot survive this runner.
with open(KV_OCCUPIED, "wb") as handle:
    handle.write(b"not a container")
OCCUPIED_BEFORE = open(KV_OCCUPIED, "rb").read()
os.symlink(KV_OCCUPIED, KV_OCCUPIED_LINK)
os.makedirs(KV_READONLY_DIR, exist_ok=True)
os.chmod(KV_READONLY_DIR, 0o555)

# R6-PREFIX-KEY section 5.1's setup. **The arm creates no store**, so the runner does — which is the
# contract and not a convenience: a directory is a namespace, and an arm that mints namespaces from a
# path operand is one typo from populating `/tmp/tyop/` (section 2.4, Request 53).
#
# `STORE_ABSENT_DIR` is deliberately **not** created and `STORE_FILE` is a regular file: both are
# `R6_KV_UNWRITABLE store[create]`, which is the assertion that the three causes are not
# distinguished at this pin.
for directory in (STORE_DIR, STORE_SUFFIX_DIR, STORE_RESIDENT_DIR, STORE_STABLE_DIR,
                  STORE_CORRUPT_DIR, STORE_WRONG_TOKENS_DIR, STORE_WRONG_PACK_DIR,
                  STORE_KEY_TOKENS_DIR, STORE_KEY_WIDTH_DIR, STORE_KEY_GEOMETRY_DIR,
                  STORE_KEY_PACK_DIR):
    os.makedirs(directory, exist_ok=True)
with open(STORE_FILE, "wb") as handle:
    handle.write(b"a store is a directory")

# The geometry and pack variants the key-determinism rows need. Each changes **exactly one preimage
# field** and nothing the arm would otherwise refuse:
#
#   * the geometry file gains one byte of insignificant JSON whitespace, so `geometry_sha256` moves
#     while every geometry integer stays what it was;
#   * the pack's stored `source_header_region_sha256` has its first byte flipped, so
#     `source_header_region_sha256` moves while the container the arm stages is unchanged. Nothing
#     on this arm recomputes that digest — `--pack-verify` is the arm that does — so the run
#     succeeds and only the key differs.
with open(GEOM, "rb") as handle:
    GEOMETRY_IMAGE = handle.read()
with open(STORE_KEY_GEOMETRY, "wb") as handle:
    handle.write(GEOMETRY_IMAGE.replace(b"{", b"{ ", 1))
with open(PACK, "rb") as handle:
    PACK_IMAGE = bytearray(handle.read())
PACK_DIGEST_AT = struct.unpack_from("<Q", PACK_IMAGE, PACK_SOURCE_RECORD_OFFSET_AT)[0] \
    + PACK_SOURCE_DIGEST_IN_RECORD
PACK_IMAGE[PACK_DIGEST_AT] = PACK_IMAGE[PACK_DIGEST_AT] ^ 0x01
with open(STORE_KEY_PACK, "wb") as handle:
    handle.write(bytes(PACK_IMAGE))

# The three `hit-but-broken` rows, built by placing a container **at the key path of a run that will
# ask for it** and then breaking it in place — which is the only way to reach them, and is exactly
# the point: the key addresses a file that may be anything. The name comes from this block's own
# preimage implementation, so a name the arm would not have chosen is itself a failure of oracle D.
STORE_EXPECTED_KEY = key_from_inputs(PACK, GEOM, [3, 17, 5], int(WIDTH))
with open(KV_GOOD, "rb") as handle:
    STORE_GOOD_IMAGE = handle.read()
GOOD_PLANE_OFFSET = struct.unpack_from("<Q", STORE_GOOD_IMAGE, 88)[0]
GOOD_IDENTITY_OFFSET = struct.unpack_from("<Q", STORE_GOOD_IMAGE, 64)[0]
corrupt = bytearray(STORE_GOOD_IMAGE)
corrupt[GOOD_PLANE_OFFSET] = corrupt[GOOD_PLANE_OFFSET] ^ 0x40
with open(store_file(STORE_CORRUPT_DIR, STORE_EXPECTED_KEY), "wb") as handle:
    handle.write(bytes(corrupt))
wrong_pack = bytearray(STORE_GOOD_IMAGE)
wrong_pack[GOOD_IDENTITY_OFFSET] = wrong_pack[GOOD_IDENTITY_OFFSET] ^ 0x01
with open(store_file(STORE_WRONG_PACK_DIR, STORE_EXPECTED_KEY), "wb") as handle:
    handle.write(bytes(wrong_pack))
# A container whose ids are **not** this run's, carried to the key path of a run whose ids are:
# reaching it for real needs a SHA-256 collision, so the file is placed by hand and the refusal is
# `R6_KV_TOKENS` naming the first id that disagrees.
shutil.copyfile(kv("tokens-id"), store_file(STORE_WRONG_TOKENS_DIR, STORE_EXPECTED_KEY))

# The R5B arm is untouched: its own flag still selects it and it still emits its own document.
r5b = run(["--model-forward", PACK, GEOM, TOKENS])
if r5b.stdout == b"":
    failures.append("arm-r5b-unchanged: the R5B arm produced no document")
elif json.loads(r5b.stdout.decode("utf-8"))["kind"] != "R5_MODEL_FORWARD":
    failures.append("arm-r5b-unchanged: the R5B arm emitted the wrong kind")

for name, operands, expected in STUB_CASES:
    document = record(name, operands, expected)
    if document is None:
        continue
    lifetime = document["lifetime"]
    for key in ("ggml_buffers_created", "contexts_created", "backends_created",
                "gallocrs_created"):
        if lifetime[key] != 0:
            failures.append("%s: lifetime.%s is %d in a default stub build, not 0"
                            % (name, key, lifetime[key]))
    # Section 4.2's early-exit cell: a run that never reached a graph publishes no plane and no
    # round-trip verdict, so an error document can never claim `IDENTICAL` over zero bytes.
    if document["plane"]["roundtrip_verdict"] != "-" or document["plane"]["layers"] != 0:
        failures.append("%s: an error document published a plane: %r" % (name, document["plane"]))

build_shim("engine")
for name, operands, expected in ENGINE_CASES:
    document = record(name, operands, expected)
    if document is None:
        continue
    if document["status"] != "ok":
        continue
    graph = document["graph"]
    decode = document["decode"]
    plane = document["plane"]
    if document["verdict"] != "EXTERNAL":
        failures.append("%s: verdict %r, not EXTERNAL" % (name, document["verdict"]))
    # Section 2.2's size arithmetic on this case's own width. R6-PREFIX-TTFT adds legal persisted
    # widths 64 and 1,536 to this loop, so deriving from the document prevents the old width-8
    # fixture from becoming a hidden second cap.
    expected_stride = document["selection"]["reconciliation_width"] \
        * document["model"]["n_head_kv"] * document["model"]["head_dim"] * 4
    expected_plane = document["model"]["n_layer"] * 2 * expected_stride
    if plane["bytes"] != expected_plane or plane["stride"] != expected_stride:
        failures.append("%s: plane %d bytes, stride %d, not %d/%d"
                        % (name, plane["bytes"], plane["stride"], expected_plane,
                           expected_stride))
    steps_requested = decode["steps_requested"]
    rows = document["steps"]
    # R6-PREFIX-SUFFIX-PREFILL section 5.1. Every assertion below was written against this block's
    # three-token prompt and is now derived from **this case's own operands** instead: the decode
    # loop starts at `T_prefix + S` and the plane grows from there. At `S = 0` every expression is
    # the three-token one character for character, and the derivation is what lets one loop assert a
    # prefix-plus-suffix run and a single-shot run with the same code.
    prompt_ids = [int(value) for value in operands[3].split(",")] if operands[3] else []
    # The fifteenth **operand** is `args[14]` in the arm's own argv, which is index 13 here: this
    # list does not carry the program name that argv does, only the arm flag.
    case_suffix_ids = ([] if len(operands) < 14 or operands[13] == "-"
                       else [int(value) for value in operands[13].split(",")])
    sequence_ids = prompt_ids + case_suffix_ids
    base = len(sequence_ids)
    # R6-STEP-N section 2.4: the plane holds `T + S + N` columns on a complete run, grown one column
    # per step **in place** — the buffer was `KV_WIDTH` columns wide from the start.
    if plane["layers"] != 2 or plane["columns_written"] != base + steps_requested:
        failures.append("%s: the plane holds %d layers and %d columns, not 2 and %d + %d"
                        % (name, plane["layers"], plane["columns_written"], base, steps_requested))
    # Oracle B, cumulative and inclusive of each step's own new column: at step `k` it compares
    # `2 tensors * 2 layers * (T + S + k) columns * 1 head * 4 lanes * 4 bytes`, plus — on a suffix
    # run — the pass's own verification over all `T_prefix + S` columns before the first step.
    expected_bytes = sum(2 * 2 * (base + k) * 1 * 4 * 4 for k in range(1, steps_requested + 1))
    if case_suffix_ids:
        expected_bytes = expected_bytes + 2 * 2 * base * 1 * 4 * 4
    if plane["roundtrip_verdict"] != "IDENTICAL" \
            or plane["roundtrip_bytes_compared"] != expected_bytes:
        failures.append("%s: oracle B is %r over %d bytes, not %d"
                        % (name, plane["roundtrip_verdict"], plane["roundtrip_bytes_compared"],
                           expected_bytes))
    if plane["first_mismatch_layer"] != -1 or plane["first_mismatch_tensor"] != "-" \
            or plane["first_mismatch_step"] != -1:
        failures.append("%s: a passing run named a mismatch: %r" % (name, plane))
    # The loop's shape. `token_ids` duplicates `steps[i].token_id` on purpose so the gate can read
    # one array without walking objects; that the two agree is asserted rather than assumed.
    if decode["steps_completed"] != steps_requested or len(rows) != steps_requested:
        failures.append("%s: %d of %d steps completed with %d rows"
                        % (name, decode["steps_completed"], steps_requested, len(rows)))
    elif decode["token_ids"] != [row["token_id"] for row in rows]:
        failures.append("%s: token_ids %r do not match steps[].token_id %r"
                        % (name, decode["token_ids"], [row["token_id"] for row in rows]))
    elif sequence_ids == [3, 17, 5] and decode["token_ids"] != EXPECTED_TOKENS[:steps_requested]:
        # The reference loop's ids are the **sequence** `3,17,5`'s, however the arm reached it: a
        # single-shot prefill, a container reload, or a prefix plus a suffix. Three routes, one
        # chain, and the fixture's own file is what says so.
        failures.append("%s: decoded %r, not the reference loop's %r"
                        % (name, decode["token_ids"], EXPECTED_TOKENS[:steps_requested]))
    if decode["n_past_first"] != base or decode["n_past_last"] != base + steps_requested - 1:
        failures.append("%s: n_past runs %d..%d, not %d..%d"
                        % (name, decode["n_past_first"], decode["n_past_last"], base,
                           base + steps_requested - 1))
    if rows and rows[0]["token_id"] != document["output"]["argmax"]:
        failures.append("%s: the chain's root %d is not the prefill's argmax %d"
                        % (name, rows[0]["token_id"], document["output"]["argmax"]))
    for index, row in enumerate(rows):
        # Every step writes exactly one column, at `n_past`, and reads the ones before it.
        if row["index"] != index + 1 or row["n_past"] != base + index \
                or row["plane_column_written"] != base + index:
            failures.append("%s: steps[%d] is %r" % (name, index, row))
        if index + 1 < len(rows) and row["argmax"] != rows[index + 1]["token_id"]:
            failures.append("%s: steps[%d] produced %d and steps[%d] consumed %d — the chain broke"
                            % (name, index, row["argmax"], index + 1, rows[index + 1]["token_id"]))
        if row["element_count"] != 32 or row["nonfinite_count"] != 0:
            failures.append("%s: steps[%d] has %d logits, %d non-finite"
                            % (name, index, row["element_count"], row["nonfinite_count"]))
        # 1 + 36 + 38 + 3: the decode graph issues two more rows per layer than the prefill — one
        # `CONCAT` on K and one on V — at `t = 1`.
        if row["node_count"] != 78:
            failures.append("%s: steps[%d] node_count %d, not 1 + 36 + 38 + 3"
                            % (name, index, row["node_count"]))
    if len({row["sha256"] for row in rows}) != len(rows) \
            or document["output"]["sha256"] in {row["sha256"] for row in rows}:
        failures.append("%s: two steps produced the same logits, or a step reproduced the prefill's"
                        % name)
    # Section 2.3: the two plane slots sit above the decode table's own node slots, so the arm's
    # high-water is 66 against a capacity of 128 — and the prefill arm's stays 52.
    if decode["slot_high_water"] != 66 or graph["slot_capacity"] != 128:
        failures.append("%s: slots %d/%d, not 66/128"
                        % (name, decode["slot_high_water"], graph["slot_capacity"]))
    # R6-KV-PERSIST section 1.1. A load run **skips the prefill entirely**, so it builds no prefill
    # graph and publishes none: the two prefill-shaped assertions below are the decode loop's
    # neighbours and do not apply to it. Everything above — the plane, oracle B, the id chain, the
    # per-step shape — does apply and is asserted on both paths unchanged.
    if plane["source"] == "LOADED":
        if graph["node_count_total"] != 0 or graph["graph_count"] != 0:
            failures.append("%s: a load run published a prefill graph: %r" % (name, graph))
        continue
    # The prefill runs at the declared width, so it issues R5B's reconciliation graph: 1 + 34 + 36
    # + 3. The decode graph issues two more rows per layer — one `CONCAT` on K and one on V — at
    # `t = 1`: 1 + 36 + 38 + 3.
    if graph["node_count_total"] != 74:
        failures.append("%s: prefill node_count_total %d, not 1 + 34 + 36 + 3"
                        % (name, graph["node_count_total"]))
    # `decode.node_count` and `decode.graph_count` are **sums** over the loop at schema 2.
    if decode["node_count"] != 78 * steps_requested:
        failures.append("%s: decode node_count %d, not %d x (1 + 36 + 38 + 3)"
                        % (name, decode["node_count"], steps_requested))
    if decode["graph_count"] != 4 * steps_requested or graph["graph_count"] != 4:
        failures.append("%s: %d prefill graphs and %d decode graphs, not 4 and %d"
                        % (name, graph["graph_count"], decode["graph_count"], 4 * steps_requested))
    lifetime = document["lifetime"]
    if not lifetime["released_before_owner_scope_end"]:
        failures.append("%s: the teardown did not balance" % name)
    if lifetime["graph_balance_failures"] != 0:
        failures.append("%s: %d graph boundaries left a ggml object alive"
                        % (name, lifetime["graph_balance_failures"]))
    for created, freed in (("ggml_buffers_created", "ggml_buffers_freed"),
                           ("contexts_created", "contexts_freed"),
                           ("backends_created", "backends_freed"),
                           ("gallocrs_created", "gallocrs_freed")):
        if lifetime[created] != lifetime[freed]:
            failures.append("%s: %s %d != %s %d"
                            % (name, created, lifetime[created], freed, lifetime[freed]))

# Oracle A. Every comparable node of the transcript's **second** graph, at one ten-thousandth, over
# both layers plus the head — against a pure-Python decode step that shares none of the engine's
# code. `max_abs_diff` is zero here and the tolerance is not consulted, which is the strongest form
# the hosted corpus can take.
for case_name, expect_steps in (("ds-engine-transcript", 1), ("ds-steps-3", 3)):
    stepped = json.loads(produced[case_name])
    oracle = stepped["oracle_decode"]
    if oracle["verdict"] != "PASS" or oracle["max_abs_diff_ten_thousandths"] != 0:
        failures.append("%s: %r" % (case_name, oracle))
    if oracle["layers_matched"] != 2 or oracle["nodes_matched"] != oracle["nodes_expected"]:
        failures.append("%s: %d/%d layers, %d/%d nodes"
                        % (case_name, oracle["layers_matched"], oracle["layers_expected"],
                           oracle["nodes_matched"], oracle["nodes_expected"]))
    if oracle["elements_compared"] <= 0:
        failures.append("%s: zero elements compared with a PASS verdict" % case_name)
    if oracle["tolerance_ten_thousandths"] != 1 or oracle["instrument_graph_first"] != 2 \
            or oracle["instrument_graph_last"] != expect_steps + 1 \
            or oracle["steps_compared"] != expect_steps:
        failures.append("%s: the decode oracle did not run over graphs 2..%d at 1e-4: %r"
                        % (case_name, expect_steps + 1, oracle))
    # R6-STEP-N section 3.4's structural gate, at **every** step: none of it can pass vacuously.
    # A mis-aligned graph skip, a truncated transcript, a dropped layer, and the empty comparison
    # each fail one of these four.
    for index, row in enumerate(stepped["steps"]):
        step_oracle = row["oracle"]
        if step_oracle["instrument_graph"] != index + 2:
            failures.append("%s: steps[%d] compared graph %d, not %d"
                            % (case_name, index, step_oracle["instrument_graph"], index + 2))
        if step_oracle["nodes_matched"] != step_oracle["nodes_expected"] \
                or step_oracle["layers_matched"] != 2 \
                or step_oracle["elements_compared"] <= 0 \
                or step_oracle["verdict"] != "PASS":
            failures.append("%s: steps[%d] oracle %r" % (case_name, index, step_oracle))

# A transcript one graph short of `STEPS`: steps 1 and 2 compare and step 3 is refused by name.
short = json.loads(produced["ds-transcript-short-for-steps"])
if not short["error_detail"].startswith("step[3]") or short["decode"]["steps_completed"] != 2:
    failures.append("ds-transcript-short-for-steps: %r after %d steps"
                    % (short["error_detail"], short["decode"]["steps_completed"]))

breached = json.loads(produced["ds-transcript-perturbed"])
if breached["status"] != "ok" or breached["oracle_decode"]["verdict"] != "FAIL" \
        or breached["oracle_decode"]["worst_layer"] != 0 \
        or breached["oracle_decode"]["worst_node"] != "l_out":
    failures.append("ds-transcript-perturbed: status %r %r"
                    % (breached["status"], breached["oracle_decode"]))

# The prefill half is R5B's, and this is the assertion that says so in bytes: the same pack, the
# same tokens, and the same declared width produce the **same** logits digest through
# `--model-forward` and through `--decode-step`. Section 4.4's non-regression cell.
mf = run(["--model-forward", PACK, GEOM, TOKENS, "-", SOURCE, path("model-transcript.txt"), WIDTH])
mf_document = json.loads(mf.stdout.decode("utf-8"))
ds_document = json.loads(produced["ds-engine-ok"])
if mf_document["output"]["sha256"] != ds_document["output"]["sha256"]:
    failures.append("ds-prefill-matches-r5b: --model-forward %r != --decode-step %r"
                    % (mf_document["output"]["sha256"], ds_document["output"]["sha256"]))
if mf_document["graph"]["slot_high_water"] != 52:
    failures.append("ds-prefill-slots-unmoved: the prefill arm's high-water moved to %d, not 52"
                    % mf_document["graph"]["slot_high_water"])
# Section 3.2: the decode step is **not** the prefill's final position. If these agreed, the decode
# graph would be recomputing the prompt.
if not ds_document["steps"]:
    failures.append("ds-step-differs: the run published no step at all")
elif ds_document["steps"][0]["sha256"] == ds_document["output"]["sha256"]:
    failures.append("ds-step-differs: the decode logits equal the prefill's")

# Both output forms emit byte-identical document bytes, and three consecutive runs agree.
document_path = os.path.join(work_dir, "decode.json")
stdout_form = run([ARM, PACK, GEOM, TOKENS]).stdout.decode("utf-8").rstrip("\n")
run([ARM, PACK, GEOM, TOKENS, document_path])
with open(document_path, "r", encoding="utf-8") as handle:
    file_form = handle.read()
if normalize(stdout_form) != normalize(file_form):
    failures.append("ds-doc-stdout-identical: the stdout and file forms differ")
repeats = {normalize(run([ARM, PACK, GEOM, TOKENS, "-", SOURCE, TRANSCRIPT, WIDTH])
                     .stdout.decode("utf-8")) for _ in range(3)}
if len(repeats) != 1:
    failures.append("three consecutive runs produced %d distinct documents" % len(repeats))

# MF-SINGLE-TOKEN-LOGITS section 4, under the engine shim the block above built and outside
# `ENGINE_CASES`, whose plane and token assertions are arithmetic on the three-token prompt.
for name, operands, expected in ONE_TOKEN_CASES:
    document = record(name, operands, expected)
    if document is None:
        continue
    if document["status"] != "ok":
        failures.append("%s: a one-token prefill was refused: %r %r"
                        % (name, document["error_code"], document["error_detail"]))
        continue
    one_token_plane = document["plane"]
    if one_token_plane["columns_written"] != 1 + int(STEPS):
        failures.append("%s: the plane holds %d columns, not T + %s"
                        % (name, one_token_plane["columns_written"], STEPS))
    if one_token_plane["roundtrip_verdict"] != "IDENTICAL":
        failures.append("%s: oracle B is %r over a one-token prefill"
                        % (name, one_token_plane["roundtrip_verdict"]))
    if document["decode"]["steps_completed"] != int(STEPS):
        failures.append("%s: %d of %s steps completed"
                        % (name, document["decode"]["steps_completed"], STEPS))

# ---------------------------------------------------------------------------------------------
# R6-RESIDENT-WEIGHTS section 4: oracle R, oracle P's new reach, and oracle B at run scope
#
# The design document's section 5.6 predicted that the hosted lane could not compare the two legs
# numerically, because it runs without ggml. That prediction is wrong in this repository's favour
# and the correction is recorded rather than quietly enjoyed: the hosted lane runs the **engine**
# shim, a deterministic ggml-free kernel set, and it computes real numbers from whatever address
# the weights were placed at. Oracle R is therefore a hosted oracle here and not only a capable-host
# one, and the resident leg is compared field by field against the streamed leg it differs from in
# exactly one operand.
# ---------------------------------------------------------------------------------------------

# Absence is `-`, in bytes: fourteen operands whose last is the default produce the same document as
# thirteen. This capability adds no default and changes no shipped invocation.
if produced["ds-kv-args-dash-dash"] != produced["ds-resident-dash"]:
    failures.append("ds-resident-dash: a `-` fourteenth operand changed the document: %s"
                    % describe_difference(produced["ds-kv-args-dash-dash"],
                                          produced["ds-resident-dash"]))

# Oracle R. One step and three steps.
for streamed_case, resident_case in (("ds-resident-stream-1", "ds-resident-weights-1"),
                                     ("ds-kv-args-dash-dash", "ds-resident-weights-steps"),
                                     ("ds-tokens-one", "ds-tokens-one-resident")):
    left = normalize_resident(produced[streamed_case])
    right = normalize_resident(produced[resident_case])
    if left != right:
        failures.append("oracle R (%s vs %s): %s"
                        % (streamed_case, resident_case, describe_difference(left, right)))

# The staging boundary, pinned from the legal side. A resident prefill of exactly
# `MAX_PREFILL_TOKENS` ids stages slot 2047, the highest index `stage_embed_row` can be asked for, and
# the twin below makes the case an assertion about the **bytes** that slot carries rather than only
# about the run not being refused: the streamed leg reads all 2048 rows out of the pack, the resident
# leg copies them out of the arena's table, and oracle R says the two produce the same document.
# The case runs here, under the engine shim the block above built, and not in `ENGINE_CASES`: it
# carries no golden row (see `BOUNDARY_CASES`), and every assertion in that loop is arithmetic on
# the three-token prompt and the width of 8 this block otherwise uses throughout. The loop also
# produces `SUFFIX_SINGLE_SHOT_4`, oracle S's four-token comparand, which is out of the golden for
# the same cross-platform reason and is asserted by the suffix block below; it must be produced
# before that block runs, which is why it is here and not after it.
for name, operands, expected in BOUNDARY_CASES:
    record(name, operands, expected)

if STAGE_FULL not in produced:
    failures.append("%s: the staging-boundary case produced no document" % STAGE_FULL)
else:
    stage_full = json.loads(produced[STAGE_FULL])
    if stage_full["error_code"] != "" or stage_full["status"] != "ok":
        failures.append("%s: a %d-token resident prefill was refused: %r %r"
                        % (STAGE_FULL, len(STAGE_FULL_TOKENS.split(",")),
                           stage_full["error_code"], stage_full["error_detail"]))
    else:
        if stage_full["weights"]["mode"] != "resident" \
                or stage_full["weights"]["step_pack_bytes"] != 0:
            failures.append("%s: %r" % (STAGE_FULL, stage_full["weights"]))
        # The prompt reached the graph at its full length: `n_past` before the first decode step is
        # the prompt's own token count, and the plane holds `T + N` columns after it.
        if stage_full["decode"]["n_past_first"] != 2048 \
                or stage_full["plane"]["columns_written"] != 2048 + int(STAGE_FULL_STEPS):
            failures.append("%s: n_past_first %d and %d columns, not 2048 and %d"
                            % (STAGE_FULL, stage_full["decode"]["n_past_first"],
                               stage_full["plane"]["columns_written"],
                               2048 + int(STAGE_FULL_STEPS)))
        if stage_full["plane"]["roundtrip_verdict"] != "IDENTICAL":
            failures.append("%s: oracle B is %r at the staging boundary"
                            % (STAGE_FULL, stage_full["plane"]["roundtrip_verdict"]))
    stage_full_streamed = normalize_resident(normalize(
        run(ds(tokens=STAGE_FULL_TOKENS, transcript="-", width=STAGE_FULL_WIDTH,
               steps=STAGE_FULL_STEPS)).stdout.decode("utf-8")))
    if stage_full_streamed != normalize_resident(produced[STAGE_FULL]):
        failures.append("oracle R at the staging boundary (%s): %s"
                        % (STAGE_FULL,
                           describe_difference(stage_full_streamed,
                                               normalize_resident(produced[STAGE_FULL]))))

# Section 3.2's layout arithmetic on this fixture, spelled out so the golden's own
# `weights.resident_bytes` is a number with a derivation rather than a number that was observed.
# The synthetic container's `block_align` is 4,096 and every region starts on that boundary:
#
#   token_embd, whole table   n_vocab 32 x n_embd 4 x 4 B = 512 B   -> 4,096 rounded up
#   the staging region        MAX_PREFILL_TOKENS 2048 x 32 B = 65,536 B
#   2 layers + the head       the rest
#
# R6-PREFIX-TTFT adds 61,440 B to the earlier 114,688 B total. The golden carries the exact total;
# the assertions below are the structural properties that hold for **any** pack, so a fixture
# change moves the golden and not the reasoning.
RESIDENT_BLOCK_ALIGN = 4096
RESIDENT_TABLE_BYTES = RESIDENT_BLOCK_ALIGN
RESIDENT_STAGE_BYTES = 2048 * 32

for case in ("ds-resident-weights-1", "ds-resident-weights-steps"):
    document = json.loads(produced[case])
    weights = document["weights"]
    window = document["window"]
    lifetime = document["lifetime"]
    if weights["mode"] != "resident":
        failures.append("%s: mode %r, not resident" % (case, weights["mode"]))
    # The claim, and the primary metric of section 3.4: a resident decode step reads **zero** pack
    # bytes. It is a counter and not a clock.
    if weights["step_pack_bytes"] != 0:
        failures.append("%s: a resident run read %d pack bytes in its decode steps"
                        % (case, weights["step_pack_bytes"]))
    # Section 4.3, oracle B at run scope: exactly one wrap created and exactly one freed, in a pair
    # that is separate from the per-graph pair so the per-graph check keeps its meaning.
    if weights["wrap_count"] != 1 or weights["resident_wraps_created"] != 1 \
            or weights["resident_wraps_freed"] != 1:
        failures.append("%s: the run-scope wrap did not balance: %r" % (case, weights))
    if lifetime["graph_balance_failures"] != 0 \
            or not lifetime["released_before_owner_scope_end"]:
        failures.append("%s: the resident teardown did not balance: %r" % (case, lifetime))
    if lifetime["ggml_buffers_created"] != lifetime["ggml_buffers_freed"]:
        failures.append("%s: the per-graph buffer pair stopped balancing under the hoist: %r"
                        % (case, lifetime))
    # The fill happened once and read the whole arena.
    if weights["fill_bytes"] <= 0 or weights["fill_pread_count"] <= 0:
        failures.append("%s: the arena reported no fill: %r" % (case, weights))
    if weights["resident_bytes"] <= window["bytes"]:
        failures.append("%s: the arena (%d) is not larger than the streamed peak (%d) — a sum "
                        "cannot be below a maximum"
                        % (case, weights["resident_bytes"], window["bytes"]))
    if weights["resident_bytes"] % RESIDENT_BLOCK_ALIGN != 0:
        failures.append("%s: the arena is %d bytes, which is not a multiple of the container's "
                        "own block alignment (%d)"
                        % (case, weights["resident_bytes"], RESIDENT_BLOCK_ALIGN))
    # A sum over every graph cannot be below the maximum over the same graphs plus the two regions
    # streaming never holds at all.
    if weights["resident_bytes"] < window["bytes"] + RESIDENT_TABLE_BYTES + RESIDENT_STAGE_BYTES:
        failures.append("%s: the arena (%d) is below the streamed peak (%d) plus the table and the "
                        "stage" % (case, weights["resident_bytes"], window["bytes"]))
    if weights["resident_bytes"] <= RESIDENT_TABLE_BYTES + RESIDENT_STAGE_BYTES:
        failures.append("%s: the arena (%d) does not even hold the table and the stage"
                        % (case, weights["resident_bytes"]))
    # Oracle P's new reach (section 4.2). In resident mode every placement is against the arena, so
    # a run that silently fell back to a copy could not report zero here.
    if window["pointer_identity_failures"] != 0 or window["member_placements"] <= 0:
        failures.append("%s: %d of %d placements missed their arena offset"
                        % (case, window["pointer_identity_failures"], window["member_placements"]))
    if document["verdict"] != "EXTERNAL":
        failures.append("%s: verdict %r, not EXTERNAL" % (case, document["verdict"]))

# The streamed leg's own figures, so that the zero above is a difference and not a constant.
for case in ("ds-resident-stream-1", "ds-kv-args-dash-dash"):
    weights = json.loads(produced[case])["weights"]
    if weights["mode"] != "stream" or weights["resident_bytes"] != 0 \
            or weights["resident_wraps_created"] != 0:
        failures.append("%s: a streamed run reported residency: %r" % (case, weights))
    if weights["step_pack_bytes"] <= 0:
        failures.append("%s: a streamed run read no pack bytes in its decode steps: %r"
                        % (case, weights))

# The refusals name the operand they refused, bounded, and publish `weights.mode` while doing it.
for case, detail in (("ds-resident-unknown", "resident[extra]"),
                     ("ds-resident-empty", "resident[]"),
                     ("ds-resident-case", "resident[WEIGHTS]"),
                     ("ds-resident-unknown-and-missing", "resident[extra]"),
                     ("ds-resident-multibyte", MULTIBYTE_RESIDENT_DETAIL)):
    document = json.loads(produced[case])
    if document["error_detail"] != detail:
        failures.append("%s: error_detail %r, not %r" % (case, document["error_detail"], detail))
    if document["weights"]["mode"] != "stream":
        failures.append("%s: a refused run claimed residency: %r" % (case, document["weights"]))

# ---------------------------------------------------------------------------------------------
# R6-KV-PERSIST section 3: oracle P, oracle Q, the refusal matrix, and the writer's determinism
#
# Everything here runs against the **engine** shim, before the forced-failure loop rebuilds it.
# ---------------------------------------------------------------------------------------------

# Rule 2. The save run writes, and what it wrote is exactly section 2.3.5's synthetic row.
saved = json.loads(produced["ds-kv-save-ok"])
if saved["kv"]["verdict"] != "SAVED" or saved["kv"]["destination"] != "WRITTEN" \
        or saved["plane"]["source"] != "PREFILL":
    failures.append("ds-kv-save-ok: %r / %r" % (saved["kv"], saved["plane"]["source"]))
if (saved["kv"]["total_bytes"], saved["kv"]["plane_offset"], saved["kv"]["plane_bytes"],
        saved["kv"]["logits_bytes"], saved["kv"]["header_bytes"]) != (4608, 4096, 512, 128, 192):
    failures.append("ds-kv-save-ok: the container's layout is %r, not section 2.3.5's synthetic row"
                    % saved["kv"])
if saved["kv"]["columns_persisted"] != saved["selection"]["token_count"] \
        or saved["kv"]["token_count"] != saved["selection"]["token_count"] \
        or saved["kv"]["plane_bytes"] != saved["plane"]["bytes"] \
        or saved["kv"]["prefill_argmax"] != saved["output"]["argmax"]:
    failures.append("ds-kv-save-ok: the header disagrees with the run it describes: %r"
                    % saved["kv"])
if not os.path.exists(KV_SAVE):
    failures.append("ds-kv-save-ok: no container at the destination")
else:
    stat = os.stat(KV_SAVE)
    if stat.st_size != saved["kv"]["total_bytes"]:
        failures.append("ds-kv-save-ok: the file is %d bytes and the header says %d"
                        % (stat.st_size, saved["kv"]["total_bytes"]))
    # Section 2.3's region-order property 4: padding is **written**, not left as a hole, so the
    # allocated size cannot be short of the logical size. A sparse container would report fewer
    # blocks than bytes and would make the qualification's disk-headroom figure false.
    if stat.st_blocks * 512 < stat.st_size:
        failures.append("ds-kv-save-ok: the container is sparse: %d blocks for %d bytes"
                        % (stat.st_blocks, stat.st_size))
    reader = read_container(KV_SAVE)
    if reader.returncode != 0:
        failures.append("ds-kv-save-ok: the independent reader refused the container: %s"
                        % reader.stderr.decode("utf-8", "replace").strip())

# Oracle P, legs 1 and 3, and rule 3. A **separate process** loaded the file, and the digests the
# load run republishes are the ones the save run wrote.
loaded = json.loads(produced["ds-kv-load-ok"])
if loaded["kv"]["verdict"] != "LOADED" or loaded["plane"]["source"] != "LOADED" \
        or loaded["kv"]["destination"] != "-":
    failures.append("ds-kv-load-ok: %r / %r" % (loaded["kv"], loaded["plane"]["source"]))
for field in ("plane_sha256", "logits_sha256", "tokens_sha256", "geometry_sha256",
              "source_header_region_sha256", "total_bytes", "plane_offset", "plane_bytes",
              "columns_persisted", "prefill_argmax", "pack_total_bytes"):
    if saved["kv"][field] != loaded["kv"][field]:
        failures.append("ds-kv-load-ok: kv.%s is %r on the save run and %r on the load run"
                        % (field, saved["kv"][field], loaded["kv"][field]))
# Oracle P, leg 2: the plane the loaded run's **graphs consumed** matches the loaded plane, through
# a different node than the digest — and over the same 960 B `ds-steps-3` reports.
expected_roundtrip = sum(2 * 2 * (3 + k) * 1 * 4 * 4 for k in range(1, 4))
if loaded["plane"]["roundtrip_verdict"] != "IDENTICAL" \
        or loaded["plane"]["roundtrip_bytes_compared"] != expected_roundtrip \
        or loaded["plane"]["columns_written"] != 3 + 3:
    failures.append("ds-kv-load-ok: oracle B is %r over %d bytes with %d columns"
                    % (loaded["plane"]["roundtrip_verdict"],
                       loaded["plane"]["roundtrip_bytes_compared"],
                       loaded["plane"]["columns_written"]))
# Rule 5. Gate G survives the round trip: `output` is republished byte-identically from the
# persisted vector, so `oracle_logits` is available on the load path and the id chain's root is the
# container's own `prefill_argmax`.
if loaded["output"]["sha256"] != saved["output"]["sha256"] \
        or loaded["output"]["argmax"] != loaded["kv"]["prefill_argmax"] \
        or loaded["decode"]["token_ids"][0] != loaded["kv"]["prefill_argmax"]:
    failures.append("ds-kv-load-ok: the persisted vector did not republish `output`: %r / %r"
                    % (loaded["output"]["argmax"], loaded["kv"]["prefill_argmax"]))
if loaded["decode"]["token_ids"] != EXPECTED_TOKENS[:3]:
    failures.append("ds-kv-load-ok: decoded %r, not the reference loop's %r"
                    % (loaded["decode"]["token_ids"], EXPECTED_TOKENS[:3]))

# The fixture-written container: a third implementation of the format, loaded and decoded.
from_fixture = json.loads(produced["ds-kv-load-fixture"])
if from_fixture["plane"]["source"] != "LOADED" \
        or from_fixture["decode"]["token_ids"] != EXPECTED_TOKENS[:3] \
        or from_fixture["plane"]["roundtrip_verdict"] != "IDENTICAL":
    failures.append("ds-kv-load-fixture: %r / %r"
                    % (from_fixture["decode"]["token_ids"], from_fixture["plane"]))
if read_container(KV_GOOD).returncode != 0:
    failures.append("ds-kv-load-fixture: the reader refused the fixture's own container")

# R6-PREFIX-TTFT's reader-policy expansion and token-region arithmetic. The independent reader
# reports the offsets it derived from each file; this block derives them again from the contract,
# not from the fixture generator. Count 2,048 is reader-only because a decode step would require
# column 2,049, beyond that fixture's intentionally exact width.
for label, container, count in (("expanded-33", KV_EXPANDED_33, 33),
                                ("expanded-corpus", KV_EXPANDED_CORPUS, 369),
                                ("expanded-2048", KV_EXPANDED_2048, 2048)):
    expanded = read_container(container, tokens=",".join(["1"] * count), quiet=False)
    if expanded.returncode != 0:
        failures.append("ds-kv-%s: independent reader refused: %s"
                        % (label, expanded.stderr.decode("utf-8", "replace").strip()))
        continue
    reported = {}
    for line in expanded.stdout.decode("utf-8").splitlines():
        fields = line.split(None, 1)
        if len(fields) == 2:
            reported[fields[0]] = fields[1]
    stream_bytes = count * 4
    identity_offset = ((192 + stream_bytes + 7) // 8) * 8
    logits_offset = identity_offset + 192
    plane_offset = ((logits_offset + 32 * 4 + 4095) // 4096) * 4096
    expected_layout = {
        "token_stream_bytes": stream_bytes,
        "identity_offset": identity_offset,
        "logits_offset": logits_offset,
        "plane_offset": plane_offset,
        "token_count": count,
    }
    for field, expected in expected_layout.items():
        if reported.get(field) != str(expected):
            failures.append("ds-kv-%s: %s is %r, not %d"
                            % (label, field, reported.get(field), expected))

for case, count in (("ds-kv-load-expanded-33", 33),
                    ("ds-kv-load-expanded-corpus", 369)):
    expanded = json.loads(produced[case])
    if expanded["status"] != "ok" or expanded["kv"]["token_count"] != count \
            or expanded["selection"]["token_count"] != count \
            or expanded["decode"]["n_past_first"] != count \
            or expanded["plane"]["columns_written"] != count + 1 \
            or expanded["plane"]["source"] != "LOADED" \
            or expanded["plane"]["roundtrip_verdict"] != "IDENTICAL":
        failures.append("%s: expanded persisted run did not continue at %d: %r / %r / %r"
                        % (case, count, expanded["kv"], expanded["decode"], expanded["plane"]))

# Oracle Q. The two runs are the same run.
if normalize_persist(produced["ds-kv-save-ok"]) != normalize_persist(produced["ds-kv-load-ok"]):
    failures.append("ds-kv-roundtrip: %s"
                    % describe_difference(normalize_persist(produced["ds-kv-save-ok"]),
                                          normalize_persist(produced["ds-kv-load-ok"])))
# Section 6 risk 7's guard against a vacuous oracle: the comparison must still hold the things that
# would change if one loaded lane were wrong.
witness = json.loads(normalize_persist(produced["ds-kv-load-ok"]))
if "decode" not in witness or "steps" not in witness or not witness["steps"] \
        or "sha256" not in witness["steps"][0] or "output" not in witness \
        or "oracle_logits" not in witness or "roundtrip_bytes_compared" not in witness["plane"]:
    failures.append("ds-kv-roundtrip: the exclusion list emptied the comparison: %r"
                    % sorted(witness))

# Section 5.2. Every refusal names its own code **and** its own detail, the independent reader
# reaches its own coarse kind on the same file, no container is left behind, and the pre-existing
# file at an occupied destination is byte-unchanged.
# W1 to W4 run **after** step 10, so a refusal on the save path has already computed and verified a
# prefill plane and says so. Every other row in the matrix is refused before the plane exists.
KV_AFTER_PREFILL = {"ds-kv-save-unwritable"}

for name, _, code, detail, container, kind in KV_REFUSALS:
    document = json.loads(produced[name])
    if document["error_code"] != code or document["error_detail"] != detail:
        failures.append("%s: %r/%r, not %r/%r"
                        % (name, document["error_code"], document["error_detail"], code, detail))
    after_prefill = name in KV_AFTER_PREFILL
    expected_source = "PREFILL" if after_prefill else "-"
    expected_columns = 3 if after_prefill else 0
    if document["plane"]["source"] != expected_source or document["kv"]["verdict"] != "-" \
            or document["kv"]["destination"] != "-":
        failures.append("%s: a refused run published a plane source %r and %r"
                        % (name, document["plane"]["source"], document["kv"]))
    # Whatever the plane's provenance, **no step ran**: no row, no id, and never `IDENTICAL`.
    if document["decode"]["steps_completed"] != 0 or document["steps"] \
            or document["decode"]["token_ids"] \
            or document["plane"]["columns_written"] != expected_columns \
            or document["plane"]["roundtrip_verdict"] == "IDENTICAL":
        failures.append("%s: a refused run published loop state: %r / %r"
                        % (name, document["decode"], document["plane"]))
    if os.path.exists(KV_UNWRITABLE):
        failures.append("%s: a refused run left a container in the read-only directory" % name)
    if open(KV_OCCUPIED, "rb").read() != OCCUPIED_BEFORE:
        failures.append("%s: the pre-existing destination file was modified" % name)
    if container is not None:
        outcome = read_container(container, kind)
        if outcome.returncode != 0:
            failures.append("%s: the independent reader did not reject %s as %s: %s"
                            % (name, os.path.basename(container), kind,
                               outcome.stderr.decode("utf-8", "replace").strip()))

# The reader's own early exit: a `--plane` that names nothing exits 1 having read nothing further.
missing_reader = read_container(KV_ABSENT)
if missing_reader.returncode != 1 or not missing_reader.stderr:
    failures.append("ds-kv-reader-missing: exit %d with %d bytes of diagnostic"
                    % (missing_reader.returncode, len(missing_reader.stderr)))

# Rule 7, determinism of the **writer**, by double write rather than by a checked-in hex golden
# (section 3, and `docs/specs/r4-alignpack-layer-major.md` section 7.2's decision inherited with its
# reasons). Two saves of identical inputs to two destinations, then the same save again under a
# perturbed environment.
run(ds(save=KV_DETERMINISM_A))
run(ds(save=KV_DETERMINISM_B))
perturbed = dict(os.environ)
perturbed.update({"TZ": "Pacific/Kiritimati", "LANG": "de_DE.UTF-8", "LC_ALL": "de_DE.UTF-8",
                  "SOURCE_DATE_EPOCH": "1", "PWD": "/"})
run(ds(save=KV_DETERMINISM_C), environment=perturbed)
digests = {}
for label, container in (("a", KV_DETERMINISM_A), ("b", KV_DETERMINISM_B),
                         ("c", KV_DETERMINISM_C), ("first", KV_SAVE)):
    if not os.path.exists(container):
        failures.append("ds-kv-determinism: %s was not written" % label)
        continue
    with open(container, "rb") as handle:
        digests[label] = hashlib.sha256(handle.read()).hexdigest()
if len(set(digests.values())) != 1:
    failures.append("ds-kv-determinism: four writes produced %d distinct containers: %r"
                    % (len(set(digests.values())), digests))

# Three consecutive load runs of one container are byte-identical after `normalize`.
load_repeats = {normalize(run(ds(load=KV_GOOD)).stdout.decode("utf-8")) for _ in range(3)}
if len(load_repeats) != 1:
    failures.append("ds-kv-load-determinism: three load runs produced %d distinct documents"
                    % len(load_repeats))

# ---------------------------------------------------------------------------------------------
# R6-PREFIX-SUFFIX-PREFILL section 3: oracle S, oracle C'', oracle B over `T_prefix + S`, and the
# suffix pass's accounting
#
# **Oracle S is the capability's headline oracle: a suffix run and a single-shot prefill of
# `TOKENS ++ SUFFIX` are the same run.** Not close to it — byte-identical logits, byte-identical
# decoded ids, and a byte-identical document outside the fixed exclusion list above. A one-lane
# error anywhere in the suffix pass — a mask row off by one, a position off by one, a write-back at
# the wrong column, a concat on the wrong axis — changes `output.sha256` and therefore
# `steps[0].token_id` and every step after it.
#
# Oracle C'' is retained **in addition to** oracle S, which contains it, for two reasons: oracle S
# compares two `--decode-step` runs and would pass if both were wrong in the same way, while C''
# compares against a **different arm** built from the prefill row table rather than the decode one;
# and C'' is the oracle that fails informatively when oracle S fails, because it isolates the suffix
# pass's logits from the loop that follows.
# ---------------------------------------------------------------------------------------------

SUFFIX_ORACLE = [
    # case, single-shot comparand, prefix ids, suffix ids, the whole list, N, width
    # `T_prefix = 1`: the split MF-SINGLE-TOKEN-LOGITS reopened, and the narrowest one the operand
    # grammar allows.
    ("ds-suffix-prefix-one", "ds-suffix-single-shot-2", [3], [5], SUFFIX_FULL_TWO, 3, WIDTH),
    ("ds-suffix-1", "ds-kv-args-dash-dash", [3, 17], [5], "3,17,5", 3, WIDTH),
    ("ds-suffix-2", SUFFIX_SINGLE_SHOT_4, [3, 17], [5, 9], SUFFIX_FULL_FOUR, 3, WIDTH),
    ("ds-suffix-3", "ds-suffix-single-shot", [3, 17], [5, 9, 27], SUFFIX_FULL_FIVE,
     int(SUFFIX_STEPS_THREE), WIDTH),
    ("ds-suffix-at-cap", "ds-suffix-single-shot-cap", [3, 17], [5] * 2046, SUFFIX_FULL_CAP,
     1, SUFFIX_CAP_WIDTH),
]

for case, comparand, prefix_ids, suffix_ids, whole, step_count, suffix_width in SUFFIX_ORACLE:
    if case not in produced or comparand not in produced:
        failures.append("%s: the suffix case or its comparand produced no document" % case)
        continue
    left = normalize_suffix(produced[case])
    right = normalize_suffix(produced[comparand])
    if case == "ds-suffix-at-cap":
        # The tiny fixture's largest streamed layer block is 49,152 bytes, while gathering the
        # 2,048-row embedding for the single-shot resident run needs 65,536 bytes. The suffix run
        # loads only two prefix rows before continuing, so it keeps the layer-sized window. This is
        # a planner high-water difference, not a semantic difference in the prefill result. Remove
        # only the five fields that identify that high-water block, and compensate with exact
        # assertions below; every other window field remains in oracle S.
        left_document = json.loads(left)
        right_document = json.loads(right)
        left_window = left_document["window"]
        right_window = right_document["window"]
        expected_embedding_bytes = right_document["model"]["n_embd"] * len(suffix_ids + prefix_ids) * 4
        if left_window["bytes"] != left_window["peak_block_bytes"] \
                or left_window["peak_block_kind"] != 1 \
                or left_window["peak_block_layer"] < 0:
            failures.append("%s: the suffix run did not retain its streamed layer high-water: %r"
                            % (case, left_window))
        if right_window["bytes"] != expected_embedding_bytes \
                or right_window["peak_block_bytes"] != expected_embedding_bytes \
                or right_window["peak_block_index"] \
                != right_document["selection"]["embedding_block_index"] \
                or right_window["peak_block_kind"] != 0 \
                or right_window["peak_block_layer"] != -1:
            failures.append("%s: the single-shot run did not expose its embedding high-water: %r"
                            % (comparand, right_window))
        if left_window["bytes"] >= right_window["bytes"]:
            failures.append("%s: the suffix layer window %d is not smaller than the single-shot "
                            "embedding window %d"
                            % (case, left_window["bytes"], right_window["bytes"]))
        for field in ("bytes", "peak_block_index", "peak_block_kind", "peak_block_layer",
                      "peak_block_bytes"):
            left_window.pop(field)
            right_window.pop(field)
        left = json.dumps(left_document, separators=(",", ":"), ensure_ascii=False)
        right = json.dumps(right_document, separators=(",", ":"), ensure_ascii=False)
    if left != right:
        failures.append("oracle S (%s vs %s): %s"
                        % (case, comparand, describe_difference(left, right)))
    document = json.loads(produced[case])
    single = json.loads(produced[comparand])
    model = document["model"]
    prefix_count = len(prefix_ids)
    sequence = prefix_count + len(suffix_ids)
    # The compensations for the four fields this runner had to add to the design's exclusion list.
    # Each one asserts the *relationship* the exclusion removed, so nothing is merely dropped.
    if document["suffix"]["sequence_length"] != single["selection"]["token_count"]:
        failures.append("%s: sequence_length %d is not the single-shot run's token_count %d"
                        % (case, document["suffix"]["sequence_length"],
                           single["selection"]["token_count"]))
    if document["selection"]["tokens"] + suffix_ids != single["selection"]["tokens"]:
        failures.append("%s: %r ++ %r is not the single-shot run's %r"
                        % (case, document["selection"]["tokens"], suffix_ids,
                           single["selection"]["tokens"]))
    for label, side in ((case, document), (comparand, single)):
        selection = side["selection"]
        if selection["narrow_index"] != selection["token_count"] - 1 \
                or selection["attention_width"] != selection["token_count"]:
            failures.append("%s: selection is not the arithmetic of its own token_count: %r"
                            % (label, selection))
        if side["window"]["residual_bytes"] != model["n_embd"] * selection["token_count"] * 4:
            failures.append("%s: residual_bytes %d is not n_embd x token_count x 4"
                            % (label, side["window"]["residual_bytes"]))
    # Oracle B's own term, exactly: the suffix run verifies the plane over all `T_prefix + S`
    # columns once, before its first decode step, and agrees with the single-shot run everywhere
    # else. This is the assertion that makes the excluded byte count a difference with a derivation.
    extra = 2 * model["n_layer"] * sequence * model["n_head_kv"] * model["head_dim"] * 4
    if document["plane"]["roundtrip_bytes_compared"] \
            != single["plane"]["roundtrip_bytes_compared"] + extra:
        failures.append("%s: oracle B compared %d bytes, not the single-shot run's %d plus %d"
                        % (case, document["plane"]["roundtrip_bytes_compared"],
                           single["plane"]["roundtrip_bytes_compared"], extra))
    # Section 3.7 rule 6: the suffix pass's accounting, asserted exactly rather than described.
    suffix = document["suffix"]
    if suffix["requested"] != 1 or suffix["completed"] != 1 \
            or suffix["token_count"] != len(suffix_ids) \
            or suffix["n_past_base"] != prefix_count \
            or suffix["first_column"] != prefix_count \
            or suffix["columns_written"] != sequence \
            or suffix["graph_count"] != model["n_layer"] + 2 \
            or suffix["node_count"] <= 0:
        failures.append("%s: the suffix pass's accounting is %r" % (case, suffix))
    if suffix["n_past_base"] != document["kv"]["columns_persisted"] \
            or suffix["n_past_base"] != document["kv"]["token_count"] \
            or suffix["n_past_base"] != document["selection"]["token_count"]:
        failures.append("%s: the pass's base %d disagrees with the container it continued: %r"
                        % (case, suffix["n_past_base"], document["kv"]))
    if document["plane"]["columns_written"] != sequence + step_count \
            or document["plane"]["roundtrip_verdict"] != "IDENTICAL" \
            or document["plane"]["source"] != "LOADED":
        failures.append("%s: the plane holds %r" % (case, document["plane"]))
    # Section 2.9's hazard, turned into a test rather than a paragraph: on a **completed** suffix
    # pass `output` describes the pass's own logits and not the container's vector, which is still
    # published in `kv`. `ds-kv-load-ok` above asserts the other side of the same distinction.
    #
    # The **digest** and not the argmax: two different logit vectors can share an argmax by
    # coincidence and `ds-suffix-2` is exactly that case, so an argmax comparison would make this
    # assertion a statement about the fixture. The argmax distinction is asserted once below, on the
    # cases where the two genuinely differ, so the reader-facing symptom is covered too.
    if document["output"]["sha256"] == document["kv"]["logits_sha256"]:
        failures.append("%s: `output` is still the container's persisted vector" % case)
    # Oracle C''. `--model-forward` at `TOKENS,SUFFIX` and the same width, built from the **prefill**
    # row table, must produce logits byte-identical to the suffix run's `output.sha256`.
    # The exact-cap row is resident because this tiny F32 pack's 65,536-byte gathered embedding is
    # larger than its 49,152-byte streamed layer window. The real measured pack has the opposite
    # relationship, and oracle S above compares the complete resident result. `--model-forward`
    # has no resident operand, so C'' remains the four short-shape rows it has always owned.
    if case != "ds-suffix-at-cap":
        forward = run(["--model-forward", PACK, GEOM, whole, "-", SOURCE, "-", suffix_width])
        forward_document = json.loads(forward.stdout.decode("utf-8"))
        if forward_document["output"]["sha256"] != document["output"]["sha256"]:
            failures.append("oracle C'' (%s): --model-forward at %s is %r, the suffix pass is %r"
                            % (case, whole, forward_document["output"]["sha256"],
                               document["output"]["sha256"]))

# Section 6 risk 2's guard, and the reason the four additions above are findings rather than edits:
# **a growing exclusion list is how an equality oracle stops being one.** The witness asserts that
# the comparison still holds the things that would change if any one lane of the suffix pass were
# wrong — the pass's own logits, the decoded ids, every step's digest, the plane's verdict and column
# count, and the external logits oracle. Widening the list to cover any of them fails here rather
# than passing silently.
#
# The guard is on the **fields**, not on the blocks that hold them: an exclusion of
# `("decode", "token_ids")` leaves `decode` present and would pass a block-level check while
# removing the one field a wrong suffix lane moves first.
witness = json.loads(normalize_suffix(produced["ds-suffix-3"]))
if "decode" not in witness or "steps" not in witness or not witness["steps"] \
        or "sha256" not in witness["steps"][0] or "n_past" not in witness["steps"][0] \
        or "plane_column_written" not in witness["steps"][0] \
        or "token_ids" not in witness["decode"] \
        or "n_past_first" not in witness["decode"] \
        or "n_past_last" not in witness["decode"] \
        or "steps_completed" not in witness["decode"] \
        or "output" not in witness \
        or "sha256" not in witness["output"] or "argmax" not in witness["output"] \
        or "oracle_logits" not in witness \
        or "verdict" not in witness["oracle_logits"] \
        or "byte_identical" not in witness["oracle_logits"] \
        or "oracle_decode" not in witness \
        or "columns_written" not in witness["plane"] \
        or "roundtrip_verdict" not in witness["plane"]:
    failures.append("oracle S: the exclusion list emptied the comparison: %r"
                    % {block: sorted(value) for block, value in sorted(witness.items())
                       if isinstance(value, dict)})

# The reader-facing half of the same hazard: on at least one case `output.argmax` differs from the
# container's `kv.prefill_argmax`, so a reader who learned `output` from R6-KV-PERSIST is told by a
# **test** and not by a paragraph that a completed suffix run republishes it.
if not [case for case, _, _, _, _, _, _ in SUFFIX_ORACLE
        if json.loads(produced[case])["output"]["argmax"]
        != json.loads(produced[case])["kv"]["prefill_argmax"]]:
    failures.append("no suffix case moved output.argmax away from the container's prefill_argmax")

# The suffix ids must not be degenerate: if the last two of `3,17,5,9,27` changed nothing, every
# assertion above would be satisfied by an arm that ignored them. Two prompts, two answers.
if json.loads(produced["ds-suffix-single-shot"])["output"]["sha256"] \
        == json.loads(produced["ds-engine-ok"])["output"]["sha256"]:
    failures.append("ds-suffix-single-shot: the five-token prompt reproduced the three-token one")

# Section 3.7 rule 8. Three consecutive suffix runs are byte-identical after `normalize`.
suffix_repeats = {normalize(run(ds(load=KV_PREFIX, tokens=SUFFIX_PREFIX_TOKENS,
                                   suffix=SUFFIX_THREE, transcript="-",
                                   steps=SUFFIX_STEPS_THREE)).stdout.decode("utf-8"))
                  for _ in range(3)}
if len(suffix_repeats) != 1:
    failures.append("ds-suffix-determinism: three suffix runs produced %d distinct documents"
                    % len(suffix_repeats))

# Oracle R's third pair, and the `RESIDENT` composition: `ds-suffix-3` plus one operand. The suffix
# pass reads **zero** pack bytes when the weights are resident, which is R6-RESIDENT-WEIGHTS'
# primary metric extended to the one pass this capability adds, and non-zero when they are streamed.
def normalize_resident_suffix(text):
    """Oracle R over a suffix leg. `normalize_resident` plus `suffix.pack_bytes`, which is the
    resident capability's own primary metric extended to the one pass this capability adds — the
    same reason the `weights` block is already excluded. It is compensated immediately below by the
    two assertions that give the exclusion its meaning: exactly 0 resident and above 0 streamed."""
    document = json.loads(normalize_resident(text))
    document["suffix"].pop("pack_bytes", None)
    return json.dumps(document, separators=(",", ":"), ensure_ascii=False)


left = normalize_resident_suffix(produced["ds-suffix-3"])
right = normalize_resident_suffix(produced["ds-suffix-resident"])
if left != right:
    failures.append("oracle R (ds-suffix-3 vs ds-suffix-resident): %s"
                    % describe_difference(left, right))
if json.loads(produced["ds-suffix-resident"])["suffix"]["pack_bytes"] != 0:
    failures.append("ds-suffix-resident: the resident suffix pass read %d pack bytes"
                    % json.loads(produced["ds-suffix-resident"])["suffix"]["pack_bytes"])
if json.loads(produced["ds-suffix-3"])["suffix"]["pack_bytes"] <= 0:
    failures.append("ds-suffix-3: the streamed suffix pass read no pack bytes")

# The refusal matrix's details, named exactly. The codes are asserted by `record`; these are the
# details, which is what makes a refusal a diagnosis a caller can act on. This tuple is the whole
# suffix refusal matrix of R6-PREFIX-SUFFIX-PREFILL section 5.6 -- every documented case except
# `ds-arity-16`, which publishes no document at all -- and the summary below counts it rather than
# `STUB_CASES` membership, so a case added to the matrix without a detail here cannot inflate the
# printed claim. `ds-suffix-tokens-mismatch` is why membership is the wrong witness: it rides in
# `KV_REFUSALS` and never appears in `STUB_CASES`.
SUFFIX_REFUSAL_DETAILS = (("ds-suffix-no-load", "suffix[no_load]"),
                          ("ds-suffix-and-save", "suffix[no_load]"),
                          ("ds-suffix-no-load-bad-steps", "suffix[no_load]"),
                          ("ds-suffix-empty", "suffix[]"),
                          ("ds-suffix-garbage", "suffix[x]"),
                          ("ds-suffix-multibyte", MULTIBYTE_SUFFIX_DETAIL),
                          ("ds-suffix-trailing", "suffix[5,]"),
                          ("ds-suffix-over-vocab", "token[0]"),
                          ("ds-suffix-over-cap", "sequence[2049]"),
                          ("ds-suffix-over-cap-and-narrow", "sequence[2049]"),
                          ("ds-suffix-and-bad-tokens", "token[2048]"),
                          ("ds-suffix-narrow-width", "kv_width[6]"),
                          ("ds-suffix-tokens-mismatch", "count[3]"))
for case, detail in SUFFIX_REFUSAL_DETAILS:
    refused = json.loads(produced[case])
    if refused["error_detail"] != detail:
        failures.append("%s: error_detail %r, not %r" % (case, refused["error_detail"], detail))
    if refused["suffix"]["requested"] != 1 or refused["suffix"]["completed"] != 0 \
            or refused["decode"]["steps_completed"] != 0 or refused["steps"] \
            or refused["plane"]["roundtrip_verdict"] == "IDENTICAL":
        failures.append("%s: a refused suffix run published loop state: %r / %r"
                        % (case, refused["suffix"], refused["plane"]))

# ---------------------------------------------------------------------------------------------
# R6-PREFIX-KEY section 3: oracle K, oracle D, the refusal matrix, and the store's own arithmetic
#
# Everything here runs against the **engine** shim, before the forced-failure loop rebuilds it.
# ---------------------------------------------------------------------------------------------

store_miss = json.loads(produced["ds-store-miss"])
store_hit = json.loads(produced["ds-store-hit"])
STORE_CONTAINER = store_file(STORE_DIR, STORE_EXPECTED_KEY)

# The miss wrote, at the name the arm chose, and it is the **only** thing in the caller's directory:
# the arm writes nothing else into a store and creates nothing else anywhere.
if store_miss["store"]["outcome"] != "miss" or store_miss["store"]["saved"] != 1 \
        or store_miss["kv"]["verdict"] != "SAVED" or store_miss["plane"]["source"] != "PREFILL":
    failures.append("ds-store-miss: %r / %r" % (store_miss["store"], store_miss["kv"]["verdict"]))
if store_hit["store"]["outcome"] != "hit" or store_hit["store"]["saved"] != 0 \
        or store_hit["kv"]["verdict"] != "LOADED" or store_hit["plane"]["source"] != "LOADED":
    failures.append("ds-store-hit: %r / %r" % (store_hit["store"], store_hit["kv"]["verdict"]))
if sorted(os.listdir(STORE_DIR)) != [STORE_EXPECTED_KEY + ".akvp"]:
    failures.append("ds-store-miss: the store holds %r" % sorted(os.listdir(STORE_DIR)))
elif os.stat(STORE_CONTAINER).st_size != store_miss["store"]["container_bytes"]:
    failures.append("ds-store-miss: the container is %d bytes and the document says %d"
                    % (os.stat(STORE_CONTAINER).st_size, store_miss["store"]["container_bytes"]))

# **Oracle D**, three agreements over one byte layout in three languages (section 3.2). The arm
# published `store.key`; this block recomputed it from the **document's** own digests and scalars;
# and `scripts/kv_plane_reader.py` recomputed it from the **container's** header and identity record
# and asserted the file it was handed is named for it. A preimage that drifts in any one of the three
# is caught by the other two.
for case, document in (("ds-store-miss", store_miss), ("ds-store-hit", store_hit)):
    if document["store"]["key"] != STORE_EXPECTED_KEY:
        failures.append("%s: store.key %r is not the operands' own key %r"
                        % (case, document["store"]["key"], STORE_EXPECTED_KEY))
    if key_from_document(document) != document["store"]["key"]:
        failures.append("%s: the key recomputed from the document is %r, the arm published %r"
                        % (case, key_from_document(document), document["store"]["key"]))
if not os.path.exists(STORE_CONTAINER):
    # The arm keyed something this block's own preimage does not derive, so every assertion below
    # is about a file that is not there. Report that once rather than crashing on the first read:
    # a key that drifts is oracle D's headline failure and it deserves a sentence, not a traceback.
    for line in failures:
        sys.stderr.write("decode step smoke: FAIL %s\n" % line)
    sys.stderr.write("decode step smoke: FAIL ds-store-miss: no container at the key this block "
                     "derives (%s); the store holds %r\n"
                     % (STORE_EXPECTED_KEY, sorted(os.listdir(STORE_DIR))))
    raise SystemExit(1)
named = read_container(STORE_CONTAINER, quiet=False)
if named.returncode != 0:
    failures.append("ds-store-key-name: the independent reader refused the stored container: %s"
                    % named.stderr.decode("utf-8", "replace").strip())
else:
    reader_key = [line.split()[1] for line in named.stdout.decode("utf-8").splitlines()
                  if line.startswith("key ")]
    if reader_key != [STORE_EXPECTED_KEY]:
        failures.append("ds-store-key-name: the reader derived %r, the name is %r"
                        % (reader_key, STORE_EXPECTED_KEY))
# The reader's own new verdict, on a valid container carried to a name that is not its key. This is
# the row that makes the name part of the format's meaning rather than a convention.
RENAMED = store_file(STORE_STABLE_DIR, "0" * 64)
shutil.copyfile(STORE_CONTAINER, RENAMED)
if read_container(RENAMED, "KEY").returncode != 0:
    failures.append("ds-store-key-name: the reader accepted a container at the wrong name")
os.remove(RENAMED)

# **Oracle K — the acceptance rule.** A hit and the miss that filled it are the same run outside
# three store fields and oracle Q's own exclusion list, which is what "using the cache changes
# nothing but the cost" means as an assertion.
for label, first, second in (("ds-store-oracle-k", "ds-store-miss", "ds-store-hit"),
                             ("ds-store-oracle-k-suffix", "ds-store-suffix-miss",
                              "ds-store-suffix-hit"),
                             ("ds-store-oracle-k-resident", "ds-store-resident-miss",
                              "ds-store-resident-hit")):
    if normalize_store(produced[first]) != normalize_store(produced[second]):
        failures.append("%s: %s" % (label, describe_difference(normalize_store(produced[first]),
                                                               normalize_store(produced[second]))))
# The guard against a vacuous oracle: the comparison must still hold everything that would change if
# one loaded lane, one column, or one derived key were wrong.
witness = json.loads(normalize_store(produced["ds-store-hit"]))
if "decode" not in witness or not witness.get("steps") \
        or "sha256" not in witness["steps"][0] or "output" not in witness \
        or "oracle_logits" not in witness or "roundtrip_bytes_compared" not in witness["plane"] \
        or witness["store"].get("key") != STORE_EXPECTED_KEY \
        or witness["store"].get("container_bytes") != store_miss["store"]["container_bytes"]:
    failures.append("ds-store-oracle-k: the exclusion list emptied the comparison: %r"
                    % sorted(witness))

# `ds-store-vs-kv-save`. The container a miss writes is **byte-identical** to the one `KV_SAVE`
# writes for the same prompt, which is what makes "the `akvp` v1 format is byte-unchanged" a verified
# statement rather than a claim about the diff.
with open(STORE_CONTAINER, "rb") as handle:
    stored_digest = hashlib.sha256(handle.read()).hexdigest()
with open(KV_SAVE, "rb") as handle:
    saved_digest = hashlib.sha256(handle.read()).hexdigest()
if stored_digest != saved_digest:
    failures.append("ds-store-vs-kv-save: the store's container is %s and KV_SAVE's is %s"
                    % (stored_digest, saved_digest))

# `ds-store-suffix-vs-kv-save`, and it is the row that pins **when** a keyed miss saves. A miss with
# a suffix must persist the **prefill** plane — `T_prefix` columns, the rest zero — before the suffix
# pass writes into it. Persisting afterwards produces a container whose plane carries `T_prefix + S`
# columns under a header declaring `columns_persisted = T_prefix`: it round-trips through the arm
# (its own digest covers what it wrote), it is **not** byte-identical to the `KV_SAVE` container of
# the same prefix, and the independent reader refuses it as `ZEROTAIL`. Both halves are asserted
# here, against the container `ds-suffix-save-prefix` wrote for the same two ids at the same width.
STORE_SUFFIX_KEY = key_from_inputs(PACK, GEOM, [3, 17], int(WIDTH))
STORE_SUFFIX_CONTAINER = store_file(STORE_SUFFIX_DIR, STORE_SUFFIX_KEY)
if json.loads(produced["ds-store-suffix-miss"])["store"]["key"] != STORE_SUFFIX_KEY \
        or not os.path.exists(STORE_SUFFIX_CONTAINER):
    failures.append("ds-store-suffix-vs-kv-save: no container at the prefix's key %r; the store "
                    "holds %r" % (STORE_SUFFIX_KEY, sorted(os.listdir(STORE_SUFFIX_DIR))))
else:
    with open(STORE_SUFFIX_CONTAINER, "rb") as handle:
        keyed_prefix_digest = hashlib.sha256(handle.read()).hexdigest()
    with open(KV_PREFIX, "rb") as handle:
        explicit_prefix_digest = hashlib.sha256(handle.read()).hexdigest()
    if keyed_prefix_digest != explicit_prefix_digest:
        failures.append("ds-store-suffix-vs-kv-save: the keyed container is %s and the KV_SAVE "
                        "container of the same prefix is %s — the miss persisted the wrong plane"
                        % (keyed_prefix_digest, explicit_prefix_digest))
    reader_prefix = read_container(STORE_SUFFIX_CONTAINER, tokens=SUFFIX_PREFIX_TOKENS)
    if reader_prefix.returncode != 0:
        failures.append("ds-store-suffix-vs-kv-save: the independent reader refused the keyed "
                        "prefix container: %s"
                        % reader_prefix.stderr.decode("utf-8", "replace").strip())

# `ds-store-no-suffix` and `ds-store-suffix`. A keyed miss **is** the save run and a keyed hit **is**
# the load run: both are compared against the documents item 29 and item 33 already pin, outside the
# `store` object the caller did not ask for on the other side.
def without_store(text):
    document = json.loads(normalize_persist(text))
    document.pop("store", None)
    return json.dumps(document, separators=(",", ":"), ensure_ascii=False)


for label, keyed, comparand in (("ds-store-no-suffix-miss", "ds-store-miss", "ds-kv-save-ok"),
                                ("ds-store-no-suffix-hit", "ds-store-hit", "ds-kv-load-ok"),
                                ("ds-store-suffix", "ds-store-suffix-hit", "ds-suffix-1")):
    if without_store(produced[keyed]) != without_store(produced[comparand]):
        failures.append("%s: %s" % (label,
                                    describe_difference(without_store(produced[comparand]),
                                                        without_store(produced[keyed]))))

# **Oracle S on both store legs** (section 3.3): the keyed run and a single-shot prefill of
# `TOKENS ++ SUFFIX` are the same run — which is what ties the store to arithmetic rather than to
# itself. Item 33's own exclusion set plus the `store` block, which is the operand under test on one
# side and absent on the other; everything else it keeps, it keeps.
#
# The **miss** leg matters most and is the one the real-model qualification also runs: a miss
# prefills `T_prefix`, saves that plane, and *then* runs the suffix pass, so it is the only path on
# which the reversal recorded in section 2.5 is exercised end to end.
#
# One field beyond item 33's set has to go, and it gets a **compensating assertion** rather than a
# quiet addition: `weights.wrap_count` counts one streamed window wrap per graph, and a **miss** runs
# one graph set more than a single-shot — its own prefill of `T_prefix`, which is the whole point of
# a miss. Item 33's pairs never met this because a *load* run builds no prefill graph, so its suffix
# pass exactly replaces the single-shot's prefill. The exact identity is asserted below.
def normalize_suffix_store(text):
    document = json.loads(normalize_suffix(text))
    document.pop("store", None)
    document["weights"].pop("wrap_count", None)
    return json.dumps(document, separators=(",", ":"), ensure_ascii=False)


STORE_SUFFIX_SINGLE_SHOT = "ds-kv-args-dash-dash"
for label, extra_graph_sets in (("ds-store-suffix-miss", 1), ("ds-store-suffix-hit", 0)):
    if normalize_suffix_store(produced[label]) != normalize_suffix_store(
            produced[STORE_SUFFIX_SINGLE_SHOT]):
        failures.append("oracle S (%s): %s"
                        % (label,
                           describe_difference(
                               normalize_suffix_store(produced[STORE_SUFFIX_SINGLE_SHOT]),
                               normalize_suffix_store(produced[label]))))
    # The compensating assertion, exact rather than approximate: `n_layer + 2` graphs per set on this
    # geometry — the embedding gather, both layers, and the head.
    keyed_wraps = json.loads(produced[label])["weights"]["wrap_count"]
    single_wraps = json.loads(produced[STORE_SUFFIX_SINGLE_SHOT])["weights"]["wrap_count"]
    if keyed_wraps != single_wraps + extra_graph_sets * (2 + 2):
        failures.append("oracle S (%s): %d window wraps against the single-shot run's %d, not "
                        "%d extra graph set(s)" % (label, keyed_wraps, single_wraps,
                                                   extra_graph_sets))

# Oracle R over the store's own legs: `ds-store-hit` and `ds-store-resident-hit` differ in the
# `RESIDENT` operand and in a store directory no document publishes, so residency must change
# nothing but the `weights` object and the counters section 4.1 of R6-RESIDENT-WEIGHTS enumerates.
#
# It is `normalize_resident` alone and **not** oracle K's wider set: both legs are hits, so both
# loaded and neither prefilled, and the whole `store` object — key, outcome, saved, container bytes
# — stays inside the comparison.
left = normalize_resident(produced["ds-store-hit"])
right = normalize_resident(produced["ds-store-resident-hit"])
if left != right:
    failures.append("oracle R (ds-store-hit vs ds-store-resident-hit): %s"
                    % describe_difference(left, right))

# Section 5.2's refusal matrix. Each row names its own code and detail, and each publishes a `store`
# object that says how far the run got: `key: "-"` and `outcome: "absent"` for everything refused
# before L0, and a real key with `outcome: "hit"`/`"miss"` for the four that reached it.
STORE_REFUSAL_STATE = {
    "ds-store-with-save": ("-", "absent", "-"),
    "ds-store-with-load": ("-", "absent", "-"),
    "ds-store-with-save-bad-steps": ("-", "absent", "-"),
    "ds-store-narrow-width": ("-", "absent", "-"),
    "ds-store-unwritable": (STORE_EXPECTED_KEY, "miss", "PREFILL"),
    "ds-store-file-not-dir": (STORE_EXPECTED_KEY, "miss", "PREFILL"),
    # The suffix row keys the **prefix** — `3,17` and not `3,17,5` — which is the whole content of
    # "a store is keyed on what is shared": the suffix is not in the preimage and its absence here
    # is asserted rather than assumed.
    "ds-store-suffix-unwritable": (STORE_SUFFIX_KEY, "miss", "PREFILL"),
    "ds-store-hit-corrupt-plane": (STORE_EXPECTED_KEY, "hit", "-"),
    "ds-store-hit-wrong-tokens": (STORE_EXPECTED_KEY, "hit", "-"),
    "ds-store-hit-wrong-pack": (STORE_EXPECTED_KEY, "hit", "-"),
}
for name, _, code, detail in STORE_REFUSALS:
    refused = json.loads(produced[name])
    if refused["error_code"] != code or refused["error_detail"] != detail:
        failures.append("%s: %r/%r, not %r/%r"
                        % (name, refused["error_code"], refused["error_detail"], code, detail))
    key, outcome, source = STORE_REFUSAL_STATE[name]
    if refused["store"]["requested"] != 1 or refused["store"]["key"] != key \
            or refused["store"]["outcome"] != outcome or refused["store"]["saved"] != 0:
        failures.append("%s: a refused store run published %r" % (name, refused["store"]))
    if refused["plane"]["source"] != source:
        failures.append("%s: a refused store run published a plane source %r"
                        % (name, refused["plane"]["source"]))
    # **Never a silent re-prefill.** Whatever the refusal, no step ran and no verdict was claimed.
    if refused["decode"]["steps_completed"] != 0 or refused["steps"] \
            or refused["decode"]["token_ids"] \
            or refused["plane"]["roundtrip_verdict"] == "IDENTICAL":
        failures.append("%s: a refused store run published loop state: %r / %r"
                        % (name, refused["decode"], refused["plane"]))
# The moved call site's own assertion, and the reason `ds-store-suffix-unwritable` is a row rather
# than a second copy of `ds-store-unwritable`: the suffix was **requested and not completed**, so the
# arm refused at the save that now precedes the pass (section 12, D14) instead of running the pass
# and reporting the failure afterwards. The key it published is the **prefix**'s, `3,17` — the same
# `f8881c20…` `ds-store-suffix-miss` writes — which is what a store keyed on the shared prefix means.
suffix_unwritable = json.loads(produced["ds-store-suffix-unwritable"])
if suffix_unwritable["suffix"]["requested"] != 1 or suffix_unwritable["suffix"]["completed"] != 0 \
        or suffix_unwritable["suffix"]["graph_count"] != 0:
    failures.append("ds-store-suffix-unwritable: the suffix pass ran before the store refusal: %r"
                    % suffix_unwritable["suffix"])
if suffix_unwritable["store"]["key"] != STORE_SUFFIX_KEY:
    failures.append("ds-store-suffix-unwritable: keyed %r, not the prefix's %r"
                    % (suffix_unwritable["store"]["key"], STORE_SUFFIX_KEY))

# The three broken containers are **still there and still broken**: a hit that failed did not
# replace, delete, or re-prefill over the file it refused.
for directory in (STORE_CORRUPT_DIR, STORE_WRONG_TOKENS_DIR, STORE_WRONG_PACK_DIR):
    if sorted(os.listdir(directory)) != [STORE_EXPECTED_KEY + ".akvp"]:
        failures.append("ds-store-hit-broken: %s holds %r"
                        % (os.path.basename(directory), sorted(os.listdir(directory))))
if os.path.exists(STORE_ABSENT_DIR):
    failures.append("ds-store-unwritable: the arm created the store directory")
with open(STORE_FILE, "rb") as handle:
    if handle.read() != b"a store is a directory":
        failures.append("ds-store-file-not-dir: the arm wrote over the caller's file")

# Section 3.2's determinism rows: **one preimage field changed, a different key**, four ways. Each
# runs against its own empty store, so each is a miss that writes under its own name; none carries a
# golden row, because what they assert is the key and the key is asserted here.
STORE_KEY_CASES = [
    ("ds-store-key-tokens", ds(tokens=STORE_KEY_TOKENS, store=STORE_KEY_TOKENS_DIR,
                               transcript="-"),
     [3, 17, 9], int(WIDTH), PACK, GEOM),
    # No transcript on the width row: the instrument's own graphs pin `KV_WIDTH` at 8 and oracle A'
    # would refuse the run at a different width before the key it is here to compare was compared.
    ("ds-store-key-width", ds(width=STORE_KEY_WIDTH, store=STORE_KEY_WIDTH_DIR, transcript="-"),
     [3, 17, 5], int(STORE_KEY_WIDTH), PACK, GEOM),
    ("ds-store-key-geometry", ds(geometry=STORE_KEY_GEOMETRY, store=STORE_KEY_GEOMETRY_DIR),
     [3, 17, 5], int(WIDTH), PACK, STORE_KEY_GEOMETRY),
    ("ds-store-key-pack", ds(pack=STORE_KEY_PACK, store=STORE_KEY_PACK_DIR),
     [3, 17, 5], int(WIDTH), STORE_KEY_PACK, GEOM),
]
store_keys = {"ds-store-miss": STORE_EXPECTED_KEY}
for name, operands, ids, width, pack_path, geometry_path in STORE_KEY_CASES:
    result = run(operands)
    if result.stdout == b"":
        failures.append("%s: no document (exit %d)" % (name, result.returncode))
        continue
    document = json.loads(result.stdout.decode("utf-8"))
    if document["error_code"] != "" or document["store"]["outcome"] != "miss":
        failures.append("%s: %r / %r" % (name, document["error_code"], document["store"]))
        continue
    store_keys[name] = document["store"]["key"]
    expected = key_from_inputs(pack_path, geometry_path, ids, width)
    if document["store"]["key"] != expected \
            or key_from_document(document) != document["store"]["key"]:
        failures.append("%s: the arm keyed %r, the operands derive %r, the document derives %r"
                        % (name, document["store"]["key"], expected, key_from_document(document)))
if len(set(store_keys.values())) != len(store_keys):
    failures.append("ds-store-key: %d preimages produced %d distinct keys: %r"
                    % (len(store_keys), len(set(store_keys.values())), store_keys))

# `ds-store-key-stable`: a different working directory, a different `STORE`, and a different
# `DOCUMENT` — **none of which is in the preimage** — produce the same key and the same container.
stable_document = path("store-stable-document.json")
stable_operands = [ARM, PACK, GEOM, TOKENS, stable_document, SOURCE, TRANSCRIPT, WIDTH, "-", STEPS,
                   "-", "-", "-", "-", STORE_STABLE_DIR]
stable = subprocess.run([binary] + stable_operands, capture_output=True, cwd=root_dir)
if stable.returncode != 0:
    failures.append("ds-store-key-stable: exit %d: %s"
                    % (stable.returncode, stable.stderr.decode("utf-8", "replace")[-300:]))
else:
    with open(stable_document, "r", encoding="utf-8") as handle:
        stable_json = json.load(handle)
    if stable_json["store"]["key"] != STORE_EXPECTED_KEY \
            or stable_json["store"]["outcome"] != "miss":
        failures.append("ds-store-key-stable: %r, not a miss at %r"
                        % (stable_json["store"], STORE_EXPECTED_KEY))
    with open(store_file(STORE_STABLE_DIR, STORE_EXPECTED_KEY), "rb") as handle:
        if hashlib.sha256(handle.read()).hexdigest() != stored_digest:
            failures.append("ds-store-key-stable: the container differs from the first store's")

# Section 4.8's cleanup cell. Every store directory this block created holds **only** `<64-hex>.akvp`
# files, and the arm created no directory of its own: it never lists a store, so anything else in one
# would have to have been written by the arm, and the whole point of the naming rule is that it
# writes exactly one name. The directories themselves are removed with the runner's `mktemp -d` tree
# by the shell trap above, which is where every other fixture in this runner is freed.
STORE_NAME_SHAPE = re.compile(r"^[0-9a-f]{64}\.akvp$")
for directory in (STORE_DIR, STORE_SUFFIX_DIR, STORE_RESIDENT_DIR, STORE_STABLE_DIR,
                  STORE_CORRUPT_DIR, STORE_WRONG_TOKENS_DIR, STORE_WRONG_PACK_DIR,
                  STORE_KEY_TOKENS_DIR, STORE_KEY_WIDTH_DIR, STORE_KEY_GEOMETRY_DIR,
                  STORE_KEY_PACK_DIR):
    entries = sorted(os.listdir(directory))
    if not entries or any(not STORE_NAME_SHAPE.match(entry) for entry in entries):
        failures.append("ds-store-teardown: %s holds %r"
                        % (os.path.basename(directory), entries))
if os.path.exists(STORE_ABSENT_DIR) or not os.path.isfile(STORE_FILE):
    failures.append("ds-store-teardown: the arm created or replaced a caller-owned path")

for name, force, operands, expected in FORCED_CASES:
    build_shim(force)
    record(name, operands, expected)

build_shim(None)

# Oracle B's shipped regression, asserted beside its golden row: the code alone would not say that
# the document also names the layer, the tensor, and the column, which is what makes the diagnosis
# usable. Section 4.2.
# R6-STEP-N section 2.8's per-step failure contract, asserted in full: the document publishes what
# step 1 completed and says nothing about the step that did not.
partial = json.loads(produced["ds-force-compute-step2"])
if partial["status"] != "error" or partial["error_code"] != "R5_COMPUTE" \
        or not partial["error_detail"].startswith("step[2]"):
    failures.append("ds-force-compute-step2: %r %r"
                    % (partial["error_code"], partial["error_detail"]))
if partial["decode"]["steps_requested"] != 3 or partial["decode"]["steps_completed"] != 1 \
        or len(partial["steps"]) != 1 or len(partial["decode"]["token_ids"]) != 1:
    failures.append("ds-force-compute-step2: a partial step published a row: %r"
                    % partial["decode"])
if partial["plane"]["columns_written"] != 4:
    failures.append("ds-force-compute-step2: %d columns written, not T + 1"
                    % partial["plane"]["columns_written"])
if partial["plane"]["roundtrip_verdict"] == "IDENTICAL":
    failures.append("ds-force-compute-step2: an error document claimed IDENTICAL")

# R6-STEP-N section 4.2. The write-back's own regression: oracle B names column `T`, which is the
# column this step wrote, and is the evidence that the new column is compared and not only the past.
shifted = json.loads(produced["ds-force-writeback-offset"])
if shifted["plane"]["first_mismatch_column"] != 3 \
        or shifted["plane"]["first_mismatch_tensor"] != "k" \
        or shifted["plane"]["first_mismatch_layer"] != 0 \
        or shifted["plane"]["first_mismatch_step"] != 1 \
        or shifted["error_detail"] != "step[1]layer[0]tensor[k]col[3]":
    failures.append("ds-force-writeback-offset: oracle B did not name the new column: %r %r"
                    % (shifted["plane"], shifted["error_detail"]))

# R6-PREFIX-SUFFIX-PREFILL section 2.8's per-pass failure contract, asserted in full. Both forced
# builds fail **inside the suffix pass**, and both must publish the same six things: no completion,
# the loaded plane's own column count, zero counts, no step, never `IDENTICAL`, and the
# **container's** `output` — which is the field whose behaviour changed on this operand combination
# and which a pass that produced no logits cannot replace.
for case, code, detail in (
        ("ds-force-compute-suffix", "R5_COMPUTE", "suffix[]layer[0]status[2]"),
        ("ds-force-suffix-writeback-offset", "R6_PLANE_MISMATCH",
         "suffix[]layer[0]tensor[k]col[2]")):
    partial_suffix = json.loads(produced[case])
    if partial_suffix["status"] != "error" or partial_suffix["error_code"] != code \
            or partial_suffix["error_detail"] != detail:
        failures.append("%s: %r / %r, not %r / %r"
                        % (case, partial_suffix["error_code"], partial_suffix["error_detail"],
                           code, detail))
    suffix = partial_suffix["suffix"]
    if suffix["requested"] != 1 or suffix["completed"] != 0 or suffix["token_count"] != 3 \
            or suffix["n_past_base"] != 2 or suffix["sequence_length"] != 5 \
            or suffix["columns_written"] != 2 or suffix["graph_count"] != 0 \
            or suffix["node_count"] != 0 or suffix["pack_bytes"] != 0:
        failures.append("%s: a partial pass published a completion: %r" % (case, suffix))
    if partial_suffix["plane"]["columns_written"] != 2 \
            or partial_suffix["plane"]["roundtrip_verdict"] == "IDENTICAL":
        failures.append("%s: a partial pass advanced the plane: %r" % (case, partial_suffix["plane"]))
    if partial_suffix["decode"]["steps_completed"] != 0 or partial_suffix["steps"] \
            or partial_suffix["decode"]["token_ids"]:
        failures.append("%s: a partial pass ran a decode step: %r"
                        % (case, partial_suffix["decode"]))
    # Section 2.8: `output` is the **container's** persisted vector on a failed pass, which is what
    # an ordinary load run publishes. This is the assertion that says the digest is taken before the
    # pass and replaced only by a completed one.
    if partial_suffix["output"]["argmax"] != partial_suffix["kv"]["prefill_argmax"]:
        failures.append("%s: a failed pass replaced `output` with something: %r / %r"
                        % (case, partial_suffix["output"]["argmax"],
                           partial_suffix["kv"]["prefill_argmax"]))
    if not partial_suffix["lifetime"]["released_before_owner_scope_end"] \
            or partial_suffix["lifetime"]["graph_balance_failures"] != 0:
        failures.append("%s: the teardown after a partial pass did not balance: %r"
                        % (case, partial_suffix["lifetime"]))

# Section 4.2: oracle B names column `T_prefix` — the **first suffix** column — which is the
# evidence that the columns this pass wrote are compared and not only the columns it loaded.
shifted_suffix = json.loads(produced["ds-force-suffix-writeback-offset"])["plane"]
if shifted_suffix["first_mismatch_column"] != 2 or shifted_suffix["first_mismatch_tensor"] != "k" \
        or shifted_suffix["first_mismatch_layer"] != 0 \
        or shifted_suffix["first_mismatch_step"] != -1:
    failures.append("ds-force-suffix-writeback-offset: oracle B did not name the first suffix "
                    "column: %r" % shifted_suffix)

# R6-RESIDENT-WEIGHTS section 11.1 correction 12's regression, and the one case in this corpus
# where a **resident** run fails. Everything asserted here was wrong before the correction: the
# run-scope balance check read `created != 1 || freed != 1`, so a run that created no wrap because
# it never got one reported a balance failure and `released_before_owner_scope_end: false` — a
# fabricated leak on a run whose teardown was perfect. The pack code is not reachable here for the
# reason section 5.9 deviation 4 records about `R6_RESIDENT_BUDGET` — a container whose members
# validate cannot make a later `pread` short — so the wrap's own refusal stands for the whole
# window, which is the same window and the same invariant.
unwrapped = json.loads(produced["ds-force-resident-wrap"])
if unwrapped["error_detail"] != "resident_buffer":
    failures.append("ds-force-resident-wrap: error_detail %r, not the refused wrap"
                    % unwrapped["error_detail"])
if unwrapped["weights"]["mode"] != "resident":
    failures.append("ds-force-resident-wrap: a resident run that failed published mode %r"
                    % unwrapped["weights"]["mode"])
# The fill ran to completion before the wrap was asked for, so the arena was live and full when the
# run failed. Without this the case would prove nothing about the window it is here to cover.
if unwrapped["weights"]["fill_bytes"] <= 0 or unwrapped["weights"]["fill_pread_count"] <= 0 \
        or unwrapped["weights"]["resident_bytes"] <= 0:
    failures.append("ds-force-resident-wrap: the arena was not filled before the wrap was refused:"
                    " %r" % unwrapped["weights"])
if unwrapped["weights"]["resident_wraps_created"] != 0 \
        or unwrapped["weights"]["resident_wraps_freed"] != 0:
    failures.append("ds-force-resident-wrap: a refused wrap was counted: %r"
                    % unwrapped["weights"])
if unwrapped["weights"]["wrap_count"] != 0:
    failures.append("ds-force-resident-wrap: a refused weight-region wrap was counted: %r"
                    % unwrapped["weights"])
# The finding itself: nothing was created, so nothing leaked, and the document must say so.
if unwrapped["lifetime"]["graph_balance_failures"] != 0 \
        or not unwrapped["lifetime"]["released_before_owner_scope_end"]:
    failures.append("ds-force-resident-wrap: a failure before the wrap fabricated a leak: %r"
                    % unwrapped["lifetime"])
for created, freed in (("ggml_buffers_created", "ggml_buffers_freed"),
                       ("contexts_created", "contexts_freed"),
                       ("backends_created", "backends_freed"),
                       ("gallocrs_created", "gallocrs_freed")):
    if unwrapped["lifetime"][created] != unwrapped["lifetime"][freed]:
        failures.append("ds-force-resident-wrap: %s != %s: %r"
                        % (created, freed, unwrapped["lifetime"]))

staged = json.loads(produced["ds-force-plane-stage-offset"])["plane"]
if staged["roundtrip_verdict"] != "MISMATCH" or staged["first_mismatch_layer"] != 0 \
        or staged["first_mismatch_tensor"] != "k" or staged["first_mismatch_column"] != 0:
    failures.append("ds-force-plane-stage-offset: oracle B did not name the mismatch: %r" % staged)

# Oracle A's two shipped regressions. Both runs succeed — nothing is malformed — and the verdict is
# what refuses them, which is the only form these two failures can take: a token roped at position 0
# and a mask that hides the decoded token's own column are both arithmetically well-formed.
for name in ("ds-force-decode-position", "ds-force-mask-offset"):
    mutated = json.loads(produced[name])
    if mutated["status"] != "ok" or mutated["oracle_decode"]["verdict"] != "FAIL" \
            or mutated["oracle_decode"]["max_abs_diff_ten_thousandths"] <= 1:
        failures.append("%s: oracle A did not refuse the mutation: %r"
                        % (name, mutated["oracle_decode"]))
    if mutated["plane"]["roundtrip_verdict"] != "IDENTICAL":
        failures.append("%s: oracle B moved; the mutation was not confined to the graph: %r"
                        % (name, mutated["plane"]))

REQUIRED_CODES = {
    "R6_TOKENS", "R6_GEOMETRY", "R6_GEOMETRY_UNREADABLE", "R6_ARCH_UNSUPPORTED", "R6_KV_WIDTH",
    "R6_TRANSCRIPT", "R6_ORACLE_MISSING", "R6_PLANE_MISMATCH", "R4_PACK_UNREADABLE",
    "R5_BLOCK_MISSING",
    "R5_LAYER_COVERAGE", "R5_MEMBER_MISSING", "R5_SHAPE", "R5_GGML_UNAVAILABLE",
    "R5_TYPE_UNSUPPORTED", "R5_ALIGNMENT", "R5_GGML_INIT", "R5_SLOT", "R5_ALLOC", "R5_COMPUTE",
    "R5_SOURCE_DIVERGED", "R5_LOGITS_SHAPE", "R5_LOGITS_UNREADABLE", "R6_STEPS",
    # R6-KV-PERSIST section 2.6's whole vocabulary except `R6_KV_WRITE_FAILED`, which section 4.1
    # marks **deferred as a case**: reaching it needs a filesystem that accepts a create and refuses
    # a write, which alignpack reaches only through an opt-in `hdiutil` volume, and the correct move
    # is to reuse that mechanism rather than build a second one. `R6_KV_CLEANUP_FAILED` and
    # `R6_KV_SIZE_MISMATCH` sit behind it on the same path and are deferred with it.
    "R6_KV_ARGS", "R6_KV_TOO_LARGE", "R6_KV_EXISTS", "R6_KV_UNREADABLE", "R6_KV_UNWRITABLE",
    "R6_KV_TRUNCATED", "R6_KV_MAGIC", "R6_KV_VERSION", "R6_KV_HEADER", "R6_KV_RESERVED",
    "R6_KV_REGION", "R6_KV_GEOMETRY", "R6_KV_IDENTITY", "R6_KV_TOKENS", "R6_KV_NPAST",
    "R6_KV_DIGEST",
    # R6-PREFIX-SUFFIX-PREFILL section 2.7's one new code. `R6_KV_ARGS` and `R6_KV_WIDTH` are
    # already required above and this capability adds a second and a third reason to reach each.
    "R6_SUFFIX",
}
missing_codes = REQUIRED_CODES - codes
if missing_codes:
    failures.append("codes never reached: %s" % ", ".join(sorted(missing_codes)))

ORDER = ([name for name, _, _ in STUB_CASES]
         + [name for name, _, _ in ENGINE_CASES]
         + [name for name, _, _, _ in FORCED_CASES]
         + [name for name, _, _ in ONE_TOKEN_CASES])

if update:
    with open(golden_path, "w", encoding="utf-8") as handle:
        for name in ORDER:
            handle.write(json.dumps({"case": name, "document": produced[name]},
                                    separators=(",", ":"), ensure_ascii=False) + "\n")
    # `ORDER` and not `produced`: `BOUNDARY_CASES` runs and is asserted but carries no golden row,
    # so the two counts differ on purpose and the message must report the rows written.
    print("decode step smoke: golden rewritten with %d cases" % len(ORDER))
else:
    with open(golden_path, "r", encoding="utf-8") as handle:
        golden = [json.loads(line) for line in handle if line.strip()]
    if [row["case"] for row in golden] != ORDER:
        failures.append("the golden case list does not match the runner's case list")
    else:
        for row in golden:
            if produced.get(row["case"]) != row["document"]:
                failures.append("golden mismatch for %s: %s"
                                % (row["case"],
                                   describe_difference(row["document"],
                                                       produced.get(row["case"]))))

if failures:
    for line in failures:
        sys.stderr.write("decode step smoke: FAIL %s\n" % line)
    raise SystemExit(1)

print("decode step smoke: prefix+suffix -- oracle S byte-identical on %d splits against their "
      "single-shot runs outside %d excluded groups, oracle C'' byte-identical against "
      "--model-forward on each, oracle B IDENTICAL over T_prefix + S columns before the first step, "
      "%d refusals each naming its own detail, two forced builds publishing a partial pass, and the "
      "RESIDENT leg reading zero pack bytes"
      % (len(SUFFIX_ORACLE), len(SUFFIX_EXCLUDED_BLOCKS) + len(SUFFIX_EXCLUDED_FIELDS),
         len(SUFFIX_REFUSAL_DETAILS)))
print("decode step smoke: %d no-document cases (R6_ARITY, R6_PATH), %d documented cases (%d with a "
      "golden row), %d codes reached, oracle A' PASS against transcript graphs 2..4 at three step "
      "offsets, oracle B IDENTICAL over the whole plane including every written-back column, three "
      "steps decoding the reference loop's own ids, a resident prefill at the staging boundary, and "
      "arm-r5b-unchanged PASS"
      % (len(NO_DOCUMENT), len(ORDER) + len(BOUNDARY_CASES), len(ORDER), len(codes - {""})))
print("decode step smoke: prefix key -- %d store cases, oracle K byte-identical on %d hit/miss "
      "pairs outside %d excluded groups, oracle D agreeing three ways over one 152-byte preimage, "
      "oracle S byte-identical on both the hit and the miss leg against the single-shot run, "
      "%d keys distinct on one changed field each, a keyed container byte-identical to KV_SAVE's, "
      "%d refusals each naming its own detail, and three hit-but-broken containers refused rather "
      "than re-prefilled"
      % (len(STORE_CASES) + len(STORE_REFUSALS), 3,
         len(PERSIST_EXCLUDED_BLOCKS) + len(PERSIST_EXCLUDED_FIELDS)
         + len(STORE_EXCLUDED_FIELDS),
         len(store_keys), len(STORE_REFUSALS)))
print("decode step smoke: akvp v1 -- %d refusal cases each asserting the arm's code and detail and "
      "the independent reader's own kind over %d reject kinds, a %d-byte container written and "
      "reloaded in a separate process, a fixture-written container loaded and decoded to the same "
      "ids, oracle Q byte-identical outside %d excluded groups, and four writes producing one "
      "digest"
      % (len(KV_REFUSALS), len({kind for _, _, _, _, _, kind in KV_REFUSALS if kind}),
         saved["kv"]["total_bytes"],
         len(PERSIST_EXCLUDED_BLOCKS) + len(PERSIST_EXCLUDED_FIELDS)))
PY

# ---------------------------------------------------------------------------------------------
# R6-OLMOE-DECODE — the `--moe-decode-step` arm over the synthetic two-layer routed model
#
# `docs/specs/r6-olmoe-decode.md` sections 5.6 and 6.1. This block extends the existing runner
# rather than adding a target, for R5B's, R5C's, R5D's, R5E's and R6's reason: `layer-forward-smoke`
# is already a member of HOSTED_CHECK_TARGETS, so a **seventh** block changes no aggregate
# membership and no check topology, and `scripts/check-gate-topology`'s byte-literal EXPECTED does
# not move.
#
# Hosted, ggml-free, model-free, llama.cpp-free. The corpus is `layer_forward_fixture.py --moe
# --model` extended with a routed decode loop: a pure-Python routed decode step per iteration at
# `n_past = T + k - 1` over the KV plane the routed prefill produced and each step grew, and a
# transcript holding **four graphs** exactly as `llama-eval-callback -n 3` emits them. Every oracle
# is reachable with no ggml and no model — oracle R against transcript graph `k + 1` at three
# offsets, oracle B over the plane's own bytes including each step's newly written column, oracle T
# against the same graphs, gate G against the reference loop's own ids, and the claim accounting
# against the fixture's own routing.
#
# `n_expert_used = 3 <= 6` keeps the routing oracle's element-wise coverage complete even against a
# compact-axis printer, so this block does **not** depend on the R2C patch — the property that lets
# a hosted owner gate a capability whose real oracle needs a patched instrument.
#
# **Hosted `K` is 3 and not 16 on purpose**, R6-STEP-N's reason unchanged: the loop's correctness is
# a property of the second iteration, and sixteen synthetic steps buy nothing the third does not.
# ---------------------------------------------------------------------------------------------

DYLD_LIBRARY_PATH="${shim_dir}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}" \
LD_LIBRARY_PATH="${shim_dir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
python3 - "${root_dir}" "${work_dir}" <<'PY'
import json
import os
import subprocess
import sys

root_dir, work_dir = sys.argv[1:3]
binary = os.path.join(work_dir, "ggml-spike")
builder = os.path.join(root_dir, "scripts", "build-ggml-shim")
golden_path = os.path.join(root_dir, "scripts", "moe-decode-step-golden.jsonl")
update = (os.environ.get("ALIGN_LLM_LAYER_FORWARD_GOLDEN_UPDATE") == "1"
          or os.environ.get("ALIGN_LLM_MOE_DECODE_STEP_GOLDEN_UPDATE") == "1")

ARM = "--moe-decode-step"
PACK = os.path.join(work_dir, "moe-model-pack.alignpack")
GEOM = os.path.join(work_dir, "moe-model-geometry.json")
TOKENS = "3,17,16"
WIDTH = "8"
STEPS = "3"
SOURCE = os.path.join(work_dir, "moe-model-source.bin")
TRANSCRIPT = os.path.join(work_dir, "moe-model-decode-transcript.txt")
LOGITS = os.path.join(work_dir, "moe-model-logits.bin")

# The generator's own second implementation of the routed decode loop. The document is asserted
# against **this**, not against itself: a demand stream that is internally consistent and wrong is
# the single most dangerous failure mode in this design.
with open(os.path.join(work_dir, "moe-model-decode-routing.json"), "r", encoding="utf-8") as handle:
    EXPECTED = json.load(handle)
with open(os.path.join(work_dir, "moe-model-decode-tokens.txt"), "r", encoding="utf-8") as handle:
    EXPECTED_IDS = [int(line) for line in handle if line.strip()]


def path(name):
    return os.path.join(work_dir, name)


# The operand shape is `--decode-step`'s, position for position:
#   ARM PACK GEOMETRY TOKENS DOCUMENT REFERENCE TRANSCRIPT KV_WIDTH LOGITS STEPS
FULL = [ARM, PACK, GEOM, TOKENS, "-", SOURCE, TRANSCRIPT, WIDTH, LOGITS, STEPS]


def operands(document="-", reference=SOURCE, transcript=TRANSCRIPT, width=WIDTH, logits=LOGITS,
             steps=STEPS, pack=PACK, geometry=GEOM, tokens=TOKENS):
    return [ARM, pack, geometry, tokens, document, reference, transcript, width, logits, steps]


# R6-MOE-RESIDENT-DENSE section 3.2. The fourteen-operand form: the ten above plus `KV_SAVE`,
# `KV_LOAD`, and `RESIDENT` at positions 11, 12 and 13 — the same indices the dense arm uses, so a
# command line cannot be silently reordered between the two arms. KV persistence is **not
# implemented on this arm**, so the two reserved positions must both be `-`; every `mdr-*` case
# below is therefore some `operands(...)` call plus exactly three operands, and a streamed and a
# `dense` leg differ in nothing but the last one.
def mdr(resident="-", kv_save="-", kv_load="-", **rest):
    return operands(**rest) + [kv_save, kv_load, resident]


KV_UNSUPPORTED = os.path.join(work_dir, "moe-kv-unsupported.akvp")

# Section 13 item 15's payload and the exact detail it must produce. `bounded_detail` runs **twice**
# on this path — once inside `resident_detail` over the operand, once inside `fail` over the wrapped
# result — and each cut backs off over continuation bytes (`0x80..0xBF`) to a UTF-8 lead byte. The
# first cut lands at 254 bytes (`"a" * 245` plus three `\u3042`); the second, over the 264-byte
# `resident[...]`, lands at 254 again and keeps the nine-byte prefix and the 245 ASCII bytes. The
# expected string is written out rather than recomputed because *where* the cut lands is the thing
# under test.
MULTIBYTE_OPERAND = "a" * 245 + "\u3042" * 20
MULTIBYTE_DETAIL = "resident[" + "a" * 245


# Cases whose operands are rejected before any file work: no document at all, non-zero exit.
NO_DOCUMENT = [
    ("md-arity-4", [ARM, PACK, GEOM]),
    # **Eight is `R6M_ARITY`**, inherited verbatim from `--decode-step`'s rule and for its reason:
    # `KV_WIDTH` travels with the transcript, so a transcript without a width refuses itself.
    ("md-arity-8", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, TRANSCRIPT]),
    # Twelve and above are `R6M_ARITY` too, with positions 11, 12 and 13 reserved for `KV_SAVE`,
    # `KV_LOAD` and `RESIDENT` at the same indices the dense arm uses.
    ("md-arity-12", FULL + ["extra"]),
    # R6-MOE-RESIDENT-DENSE section 3.1. The arity set is {5, 6, 7, 9, 10, 11, 14}: fourteen is now
    # legal and thirteen and fifteen are not. Thirteen would be an invocation that stopped inside the
    # two reserved KV placeholders — a caller who meant something this arm cannot do — and fifteen is
    # one operand past the grammar. Both present as `NO_DOCUMENT`, exactly as four, eight and twelve
    # do, because there is no `R6M_ARITY` constant in the source: the arity guard is lexical.
    ("mdr-arity-13", FULL + ["-", "-"]),
    ("mdr-arity-15", FULL + ["-", "-", "dense", "extra"]),
    ("md-path-pack-empty", [ARM, "", GEOM, TOKENS]),
    ("md-path-geometry-empty", [ARM, PACK, "", TOKENS]),
    ("md-path-doc-empty", [ARM, PACK, GEOM, TOKENS, ""]),
