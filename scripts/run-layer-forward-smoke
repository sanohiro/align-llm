     [ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE, path("moe-model-transcript-novalues.txt")],
     "R5_ORACLE_MISSING"),
    ("mm-transcript-garbage",
     [ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE, path("moe-model-transcript-garbage.txt")],
     "R5_TRANSCRIPT"),
    # A transcript whose block sums are gone. It is a **successful** run with `oracle.verdict: PASS`
    # -- every printed element still matches -- and thirty of thirty-one sum comparisons never
    # happened. `oracle.sums_expected` against `sums_matched` is the only place that is visible.
    ("mm-transcript-nosums",
     [ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE, path("moe-model-transcript-nosums.txt")], ""),
    ("mm-transcript-nonintegral",
     [ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE, path("moe-model-transcript-nonintegral.txt")],
     "R2_EXPERT_ID_NOT_INTEGRAL"),
    # Oracle 3 disagreeing is a **successful run**, and oracle 2 is still evaluated and reported.
    ("mm-routing-mismatch",
     [ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE, path("moe-model-transcript-routing.txt")], ""),
    # The checked-in real-model excerpt. Every record is found by name and op, so the only thing
    # left to disagree is the shape, which is exactly what a tiny-geometry pack must disagree about.
    ("mm-transcript-excerpt", [ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE, excerpt],
     "R5_ORACLE_SHAPE"),
    ("mm-logits", [ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE, TRANSCRIPT, LOGITS], ""),
    ("mm-logits-short",
     [ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE, TRANSCRIPT,
      path("moe-model-logits-short.bin")], "R5_LOGITS_SHAPE"),
    ("mm-logits-missing",
     [ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE, TRANSCRIPT, path("absent.bin")],
     "R5_LOGITS_UNREADABLE"),
    ("mm-logits-nonfinite",
     [ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE, TRANSCRIPT,
      path("moe-model-logits-neg-inf.bin")], "R5_LOGITS_NONFINITE"),
    ("mm-logits-nan",
     [ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE, TRANSCRIPT,
      path("moe-model-logits-nan.bin")], "R5_LOGITS_NONFINITE"),
    ("mm-logits-huge",
     [ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE, TRANSCRIPT,
      path("moe-model-logits-huge.bin")], ""),
    ("mm-logits-perturbed",
     [ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE, TRANSCRIPT,
      path("moe-model-logits-perturbed.bin")], ""),
    # The runtime width, with `-` in the transcript position: the `-` form is what lets the **arm**,
    # not the runner, produce the runtime-width `WITHIN` verdict against the same reference blob.
    ("mm-logits-runtime-width",
     [ARM, PACK, GEOM, TOKENS, RUNTIME, "-", SOURCE, "-",
      path("moe-model-logits-runtime.bin")], ""),
    ("mm-logits-order-swap",
     [ARM, PACK, GEOM, TOKENS, RUNTIME, "-", SOURCE, "-",
      path("moe-model-logits-order-swap.bin")], ""),
]

FORCED_CASES = [
    ("mm-force-init", "engine+init", [ARM, PACK, GEOM, TOKENS, WIDTH], "R5_GGML_INIT"),
    ("mm-force-alloc", "engine+alloc", [ARM, PACK, GEOM, TOKENS, WIDTH], "R5_ALLOC"),
    ("mm-force-compute", "engine+compute", [ARM, PACK, GEOM, TOKENS, WIDTH], "R5_COMPUTE"),
    ("mm-force-slot-range", "engine+slot-range", [ARM, PACK, GEOM, TOKENS, WIDTH], "R5_SLOT"),
    ("mm-force-reference", "engine+reference", [ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE],
     "R5_REFERENCE_MISMATCH"),
    # Section 2.3's bug class, made observable: a routing that names a plane the stack does not
    # have, and a routing whose two slots of one token name the same expert. Neither is producible
    # from an input, because the argsort kernel writes a permutation by construction.
    ("mm-force-routing-id-range", "engine+moe-argsort-range", [ARM, PACK, GEOM, TOKENS, WIDTH],
     "R5D_EXPERT_ID"),
    ("mm-force-routing-id-repeat", "engine+moe-argsort-repeat", [ARM, PACK, GEOM, TOKENS, WIDTH],
     "R5D_EXPERT_ID"),
    # The residual invariant and the carried-length arm of `R5E_CARRY`, neither of which any input
    # can produce because both lengths come from the same node table.
    ("mm-force-residual-short", "engine+moe-residual-short", [ARM, PACK, GEOM, TOKENS, WIDTH],
     "R5_RESIDUAL"),
    ("mm-force-carry-short", "engine+moe-carry-short", [ARM, PACK, GEOM, TOKENS, WIDTH],
     "R5E_CARRY"),
]
# MF-SINGLE-TOKEN-LOGITS section 1. `moe_model_forward` carries its own copy of both predicates over
# its own builder, so the one-token gather is a defect of this arm too and is pinned on this arm's
# own corpus rather than inferred from the dense one.
ONE_TOKEN_CASES = [
    ("mm-tokens-one", [ARM, PACK, GEOM, "3", WIDTH, "-", SOURCE], ""),
]

PLACEHOLDER = {"pack_path": "<pack>", "geometry_path": "<geometry>",
               "reference_path": "<reference>", "transcript_path": "<transcript>",
               "logits_path": "<logits>"}


def describe_difference(expected_text, actual_text, limit=8):
    if actual_text is None:
        return "no document was produced"
    try:
        expected = json.loads(expected_text)
        actual = json.loads(actual_text)
    except Exception as error:  # noqa: BLE001 - the document is the thing under test
        return "the documents are not both JSON: %s" % error
    differences = []

    def walk(left, right, path_text):
        if len(differences) >= limit:
            return
        if type(left) is not type(right):
            differences.append("%s: %r != %r" % (path_text or ".", left, right))
        elif isinstance(left, dict):
            for key in sorted(set(left) | set(right)):
                if len(differences) >= limit:
                    return
                if key not in left:
                    differences.append("%s.%s: absent != %r" % (path_text, key, right[key]))
                elif key not in right:
                    differences.append("%s.%s: %r != absent" % (path_text, key, left[key]))
                else:
                    walk(left[key], right[key], "%s.%s" % (path_text, key))
        elif isinstance(left, list):
            if len(left) != len(right):
                differences.append("%s: %d entries != %d" % (path_text, len(left), len(right)))
                return
            for index in range(len(left)):
                if len(differences) >= limit:
                    return
                walk(left[index], right[index], "%s[%d]" % (path_text, index))
        elif left != right:
            differences.append("%s: %r != %r" % (path_text or ".", left, right))

    walk(expected, actual, "")
    if not differences:
        return "the documents differ only in text form"
    return "expected != actual at " + "; ".join(differences)


def normalize(text):
    """Every nanosecond field is zeroed, wherever it lives. R5E publishes five of them **per
    schedule row** as well as nine in `timings` and two in `head`, so a normalizer that only
    reached the `timings` object would leave thirty-two wall-clock numbers in the golden."""
    document = json.loads(text)

    def scrub(node):
        if isinstance(node, dict):
            for key in node:
                if key.endswith("_ns") and isinstance(node[key], int):
                    node[key] = 0
                else:
                    scrub(node[key])
        elif isinstance(node, list):
            for item in node:
                scrub(item)

    scrub(document)
    for key, placeholder in PLACEHOLDER.items():
        if document[key]:
            document[key] = placeholder
    return json.dumps(document, separators=(",", ":"), ensure_ascii=False)


def build_shim(force):
    environment = dict(os.environ)
    environment.pop("ALIGN_LLM_GGML_INCLUDE", None)
    environment.pop("ALIGN_LLM_GGML_LIB", None)
    if force:
        environment["ALIGN_LLM_GGML_FORCE"] = force
    else:
        environment.pop("ALIGN_LLM_GGML_FORCE", None)
    subprocess.run([builder], check=True, capture_output=True, env=environment)


def run(operands):
    return subprocess.run([binary] + operands, capture_output=True, cwd=work_dir)


failures = []
produced = {}
codes = set()


def record(name, operands, expected):
    result = run(operands)
    if result.stdout == b"":
        failures.append("%s: no document (exit %d): %s"
                        % (name, result.returncode,
                           result.stderr.decode("utf-8", "replace")[-400:]))
        return None
    try:
        document = json.loads(result.stdout.decode("utf-8"))
    except Exception as error:  # noqa: BLE001 - the document is the thing under test
        failures.append("%s: the document is not valid JSON: %s" % (name, error))
        return None
    produced[name] = normalize(result.stdout.decode("utf-8"))
    codes.add(document["error_code"])
    if document["error_code"] != expected:
        failures.append("%s: expected error_code %r, got %r (%r)"
                        % (name, expected, document["error_code"], document["error_detail"]))
    expected_exit = 0 if document["status"] == "ok" else 1
    if (result.returncode == 0) != (expected_exit == 0):
        failures.append("%s: status %r but exit %d"
                        % (name, document["status"], result.returncode))
    if document["kind"] != "R5_MOE_MODEL_FORWARD" or document["schema_version"] != 1:
        failures.append("%s: wrong document identity %r/%r"
                        % (name, document["kind"], document["schema_version"]))
    if not document["abi"]["fp_contract_off"]:
        failures.append("%s: the shim was not built with -ffp-contract=off; the goldens are not "
                        "reproducible across compilers" % name)
    # Cleanup is asserted on **every** document -- stub, engine and forced alike -- and not only on
    # the successful engine cases, because the cases that stop early are exactly the ones whose
    # teardown path a leak would hide. `released_before_owner_scope_end` is deliberately not
    # asserted here: a case that stops before any ggml object exists reports it false and asserts
    # zero creations instead (section 7.2).
    lifetime = document.get("lifetime")
    if lifetime is not None:
        if lifetime["phase_balance_failures"] != 0:
            failures.append("%s: %d phase balance failure(s)"
                            % (name, lifetime["phase_balance_failures"]))
        for created, freed in (("ggml_buffers_created", "ggml_buffers_freed"),
                               ("contexts_created", "contexts_freed"),
                               ("backends_created", "backends_freed"),
                               ("gallocrs_created", "gallocrs_freed")):
            if lifetime[created] != lifetime[freed]:
                failures.append("%s: %s %d != %s %d"
                                % (name, created, lifetime[created], freed, lifetime[freed]))
    return document


for name, operands in NO_DOCUMENT:
    result = run(operands)
    if result.returncode == 0:
        failures.append("%s: expected a non-zero exit, got 0" % name)
    if result.stdout != b"":
        failures.append("%s: expected no document, got %d bytes" % (name, len(result.stdout)))

# The four arms before this one are untouched: the first operand selects an arm and nothing else.
for label, arm, operands, kind in (
        ("arm-r5a-unchanged", "--layer-forward",
         [os.path.join(work_dir, "pack.alignpack"), "0",
          os.path.join(work_dir, "geometry.json"), "3,17,5"], "R5_LAYER_FORWARD"),
        ("arm-r5b-unchanged", "--model-forward",
         [os.path.join(work_dir, "model-pack.alignpack"),
          os.path.join(work_dir, "geometry.json"), "3,17,5"], "R5_MODEL_FORWARD"),
        ("arm-r5d-unchanged", "--moe-layer-forward",
         [os.path.join(work_dir, "moe-pack.alignpack"),
          os.path.join(work_dir, "moe-geometry.json"), "0,1,8"], "R5_MOE_LAYER_FORWARD")):
    other = run([arm] + operands)
    if other.stdout == b"":
        failures.append("%s: the arm produced no document" % label)
    else:
        got = json.loads(other.stdout.decode("utf-8"))["kind"]
        if got != kind:
            failures.append("%s: the arm emitted %r" % (label, got))

for name, operands, expected in STUB_CASES:
    document = record(name, operands, expected)
    if document is None:
        continue
    lifetime = document["lifetime"]
    for key in ("ggml_buffers_created", "contexts_created", "backends_created",
                "gallocrs_created"):
        if lifetime[key] != 0:
            failures.append("%s: lifetime.%s is %d in a default stub build, not 0"
                            % (name, key, lifetime[key]))

build_shim("engine")
for name, operands, expected in ENGINE_CASES:
    document = record(name, operands, expected)
    if document is None or document["status"] != "ok":
        continue
    schedule = document["schedule"]
    residency = document["residency"]
    window = document["window"]
    graph = document["graph"]
    if document["verdict"] != "EXTERNAL":
        failures.append("%s: verdict %r, not EXTERNAL" % (name, document["verdict"]))
    if len(schedule) != 2:
        failures.append("%s: %d schedule rows, not 2" % (name, len(schedule)))
        continue
    # The schedule, against the generator's own independent forward of the same routed model.
    for row, expect in zip(schedule, EXPECTED["layers"]):
        for field in ("routed", "routed_count", "expert_ids", "compact_ids", "claim_bytes",
                      "t_out"):
            if row[field] != expect[field]:
                failures.append("%s: schedule[%d].%s is %r, not the generator's %r"
                                % (name, row["layer"], field, row[field], expect[field]))
        flat = [slot for token in row["compact_ids"] for slot in token]
        if sorted(set(flat)) != list(range(row["routed_count"])):
            failures.append("%s: schedule[%d].compact_ids is not a bijection onto [0, %d)"
                            % (name, row["layer"], row["routed_count"]))
        for token, ids in enumerate(row["expert_ids"]):
            if len(set(ids)) != len(ids):
                failures.append("%s: schedule[%d].expert_ids[%d] repeats an expert"
                                % (name, row["layer"], token))
            for slot, expert in enumerate(ids):
                if row["routed"][row["compact_ids"][token][slot]] != expert:
                    failures.append("%s: schedule[%d].compact_ids[%d][%d] does not name expert %d"
                                    % (name, row["layer"], token, slot, expert))
    # The narrowing: `T_in` is the token count at every layer and `T_out` is 1 at the last.
    if schedule[0]["t_in"] != 3 or schedule[0]["t_out"] != 3:
        failures.append("%s: layer 0 is %d->%d, not 3->3"
                        % (name, schedule[0]["t_in"], schedule[0]["t_out"]))
    if schedule[1]["t_in"] != 3 or schedule[1]["t_out"] != 1:
        failures.append("%s: the narrowing did not land inside the last layer: %d->%d"
                        % (name, schedule[1]["t_in"], schedule[1]["t_out"]))
    if schedule[1]["l_out_ne1"] != 1 or schedule[0]["l_out_ne1"] != 3:
        failures.append("%s: l_out_ne1 %d/%d, not 3/1"
                        % (name, schedule[0]["l_out_ne1"], schedule[1]["l_out_ne1"]))
    if document["selection"]["narrow_layer"] != 1 or document["selection"]["narrow_index"] != 2:
        failures.append("%s: narrow_layer/index %r" % (name, document["selection"]))
    if document["selection"]["expert_block_count"] != 16:
        failures.append("%s: expert_block_count %d, not 16"
                        % (name, document["selection"]["expert_block_count"]))
    # The residency measurement, against the generator's own arithmetic.
    for field in ("expert_bytes_read", "expert_bytes_in_model", "planes_read", "planes_in_model",
                  "keys_demanded", "cumulative_expert_bytes"):
        if residency[field] != EXPECTED[field]:
            failures.append("%s: residency.%s is %r, not the generator's %r"
                            % (name, field, residency[field], EXPECTED[field]))
    # Within one prefill no `(layer, expert)` key is demanded twice, which is the finding that says
    # a residency policy needs a multi-prefill consumer before any hit rate is a measurement.
    if residency["keys_demanded"] != residency["keys_distinct"]:
        failures.append("%s: keys_demanded %d != keys_distinct %d inside one prefill"
                        % (name, residency["keys_demanded"], residency["keys_distinct"]))
    if residency["cumulative_expert_bytes"][-1] != residency["expert_bytes_read"]:
        failures.append("%s: the union curve does not end at expert_bytes_read" % name)
    if residency["expert_bytes_read_ppm"] != 562500:
        failures.append("%s: expert_bytes_read_ppm %d, not the 562,500 of nine keys of sixteen"
                        % (name, residency["expert_bytes_read_ppm"]))
    # The claim window is reserved for the **arithmetic** bound and refilled per layer.
    if window["claim_u_max"] != 8:
        failures.append("%s: claim_u_max %d, not min(n_expert, n_expert_used * T) = 8"
                        % (name, window["claim_u_max"]))
    if window["claim_bytes"] != 12288 or window["claim_peak_use_bytes"] != 9216 \
            or window["claim_peak_use_layer"] != 0:
        failures.append("%s: claim window %r" % (name, window))
    if window["reuse_count"] != 6:
        failures.append("%s: reuse_count %d, not one per window fill across both windows"
                        % (name, window["reuse_count"]))
    if window["member_placements"] != 21 or window["claim_placements"] != 6:
        failures.append("%s: placements %d/%d, not 21 dense and 6 stacked"
                        % (name, window["member_placements"], window["claim_placements"]))
    if window["pointer_identity_failures"] != 0:
        failures.append("%s: a weight tensor is not at its own window offset" % name)
    if window["carried_bytes"] != 2 * 8 * 3 * 4 + 8 * 3 * 4 + 2 * 3 * 3 * 4:
        failures.append("%s: carried_bytes %d is not the five carried tensors"
                        % (name, window["carried_bytes"]))
    # Section 3.6's four table row counts, and ggml's own node counts beside them.
    if graph["graph_count"] != 6 or graph["table_rows_a"] != 35 or graph["table_rows_b"] != 14:
        failures.append("%s: graph shape %d graphs, tables %d+%d, not 6/35/14"
                        % (name, graph["graph_count"], graph["table_rows_a"],
                           graph["table_rows_b"]))
    if graph["embed_node_count"] != 1 or graph["head_node_count"] != 3:
        failures.append("%s: end graphs are %d and %d nodes"
                        % (name, graph["embed_node_count"], graph["head_node_count"]))
    # The two `node_when == 1` narrowing rows are issued only at the last layer, and the three
    # `node_when == 2` width rows at both layers because `KV_WIDTH > token_count`.
    if schedule[1]["node_count_a"] - schedule[0]["node_count_a"] != 2:
        failures.append("%s: the last layer is %d phase-A nodes against %d, not two more"
                        % (name, schedule[1]["node_count_a"], schedule[0]["node_count_a"]))
    if schedule[0]["node_count_b"] != schedule[1]["node_count_b"]:
        failures.append("%s: phase B is not width- and narrowing-independent" % name)
    if graph["slot_capacity"] != 128:
        failures.append("%s: slot_capacity %d, not 128" % (name, graph["slot_capacity"]))
    if document["output"]["element_count"] != 32:
        failures.append("%s: output.element_count %d, not n_vocab"
                        % (name, document["output"]["element_count"]))
    if not document["abi"]["slot_magic_ok"]:
        failures.append("%s: the slot store magic did not validate" % name)
    lifetime = document["lifetime"]
    if not lifetime["released_before_owner_scope_end"] or lifetime["phase_balance_failures"] != 0:
        failures.append("%s: the teardown did not balance at every phase boundary" % name)
    for created, freed in (("ggml_buffers_created", "ggml_buffers_freed"),
                           ("contexts_created", "contexts_freed"),
                           ("backends_created", "backends_freed"),
                           ("gallocrs_created", "gallocrs_freed")):
        if lifetime[created] != lifetime[freed]:
            failures.append("%s: %s %d != %s %d"
                            % (name, created, lifetime[created], freed, lifetime[freed]))

reference = json.loads(run([ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE]).stdout)
if reference["reference"]["verdict"] != "IDENTICAL":
    failures.append("mm-engine-reference: verdict %r" % reference["reference"]["verdict"])
if reference["reference"]["graphs_compared"] != 6:
    failures.append("mm-engine-reference: %d graphs compared, not 6"
                    % reference["reference"]["graphs_compared"])
if reference["reference"]["nodes_compared"] != reference["reference"]["nodes_identical"] \
        or reference["reference"]["nodes_compared"] != 1 + 14 * 2 + 2:
    failures.append("mm-engine-reference: %d/%d of 31 nodes identical"
                    % (reference["reference"]["nodes_identical"],
                       reference["reference"]["nodes_compared"]))

# MF-SINGLE-TOKEN-LOGITS section 4. Outside `ENGINE_CASES` because every assertion in that loop is
# the generator's three-token routing: a one-token prompt routes differently by construction, and
# what this case pins is the embedding row the gather read.
for name, operands, expected in ONE_TOKEN_CASES:
    document = record(name, operands, expected)
    if document is None:
        continue
    if document["status"] != "ok":
        failures.append("%s: a one-token prefill was refused: %r %r"
                        % (name, document["error_code"], document["error_detail"]))
        continue
    one_token_schedule = document["schedule"]
    if len(one_token_schedule) != 2:
        failures.append("%s: %d schedule rows, not 2" % (name, len(one_token_schedule)))
    elif one_token_schedule[0]["t_in"] != 1 or one_token_schedule[0]["t_out"] != 1 \
            or one_token_schedule[1]["t_in"] != 1 or one_token_schedule[1]["t_out"] != 1:
        failures.append("%s: a one-token prefill is %r wide"
                        % (name, [(row["t_in"], row["t_out"]) for row in one_token_schedule]))
    one_token_reference = document["reference"]
    if one_token_reference["verdict"] != "IDENTICAL" \
            or one_token_reference["nodes_identical"] != one_token_reference["nodes_compared"] \
            or one_token_reference["nodes_compared"] < 1:
        failures.append("%s: oracle 1 over a one-token prefill is %r"
                        % (name, one_token_reference))

# Section 4.4's oracle cells: an exact pass, full routing coverage, and a breach that is a verdict
# on a successful run rather than an error code.
passing = json.loads(run([ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE, TRANSCRIPT]).stdout)
oracle = passing["oracle"]
routing_oracle = passing["routing_oracle"]
if oracle["verdict"] != "PASS":
    failures.append("mm-engine-transcript: verdict %r, worst %r@%d in layer %d, max_abs %d, "
                    "max_sum %d"
                    % (oracle["verdict"], oracle["worst_node"], oracle["worst_element_index"],
                       oracle["worst_layer"], oracle["max_abs_diff_ten_thousandths"],
                       oracle["max_sum_diff_millionths"]))
if oracle["nodes_expected"] != 31 or oracle["nodes_matched"] != 31:
    failures.append("mm-engine-transcript: %d/%d nodes matched"
                    % (oracle["nodes_matched"], oracle["nodes_expected"]))
if oracle["layers_expected"] != 2 or oracle["layers_matched"] != 2:
    failures.append("mm-engine-transcript: %d/%d layers matched"
                    % (oracle["layers_matched"], oracle["layers_expected"]))
if oracle["elements_compared"] != 606:
    failures.append("mm-engine-transcript: %d elements compared, not 606"
                    % oracle["elements_compared"])
if oracle["instrument_kv_width"] != 8:
    failures.append("mm-engine-transcript: instrument_kv_width %d, not the declared operand"
                    % oracle["instrument_kv_width"])
# Every compared node is contracted to carry a block sum, so a complete transcript matches all
# thirty-one of them. The counters exist because a *missing* sum was previously indistinguishable
# from a matching one.
if oracle["sums_expected"] != 31 or oracle["sums_matched"] != 31:
    failures.append("mm-engine-transcript: block sums %d of %d matched"
                    % (oracle["sums_matched"], oracle["sums_expected"]))
if oracle["tolerance_ten_thousandths"] != 1 or oracle["sum_tolerance_millionths"] != 1000 \
        or oracle["sum_tolerance_relative_ppm"] != 10:
    failures.append("mm-engine-transcript: a tolerance was widened: %r" % oracle)
if routing_oracle["verdict"] != "MATCH":
    failures.append("mm-engine-transcript: routing %r, first difference layer %d token %d slot %d"
                    % (routing_oracle["verdict"], routing_oracle["first_difference_layer"],
                       routing_oracle["first_difference_token"],
                       routing_oracle["first_difference_slot"]))
# Section 5.1: at `n_expert_used = 3` the slot axis is 3, so every id is printed and this corpus is
# the only place the routing oracle's **full** coverage is reachable across a whole model.
if routing_oracle["ids_total"] != 12 or routing_oracle["ids_printed_compared"] != 12 \
        or routing_oracle["ids_printed_matched"] != 12:
    failures.append("mm-engine-transcript: routing coverage %d/%d of %d is not element-wise "
                    "complete at n_expert_used 3"
                    % (routing_oracle["ids_printed_matched"],
                       routing_oracle["ids_printed_compared"], routing_oracle["ids_total"]))
if routing_oracle["sums_expected"] != 2 or routing_oracle["sums_matched"] != 2:
    failures.append("mm-engine-transcript: routing sums %r" % routing_oracle)

breached = json.loads(
    run([ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE,
         path("moe-model-transcript-perturbed.txt")]).stdout)
if breached["status"] != "ok" or breached["oracle"]["verdict"] != "FAIL":
    failures.append("mm-transcript-perturbed: status %r verdict %r"
                    % (breached["status"], breached["oracle"]["verdict"]))
if breached["oracle"]["worst_layer"] != 0 or breached["oracle"]["worst_node"] != "l_out":
    failures.append("mm-transcript-perturbed: worst %r in layer %d"
                    % (breached["oracle"]["worst_node"], breached["oracle"]["worst_layer"]))
if breached["routing_oracle"]["verdict"] != "MATCH":
    failures.append("mm-transcript-perturbed: a float breach moved the routing verdict")

stripped = json.loads(
    run([ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE,
         path("moe-model-transcript-nosums.txt")]).stdout)
if stripped["status"] != "ok" or stripped["oracle"]["verdict"] != "PASS":
    failures.append("mm-transcript-nosums: status %r verdict %r"
                    % (stripped["status"], stripped["oracle"]["verdict"]))
if stripped["oracle"]["sums_expected"] != 31 or stripped["oracle"]["sums_matched"] != 1:
    failures.append("mm-transcript-nosums: %d of %d block sums compared -- a transcript that lost "
                    "its sums is not distinguishable from a complete one"
                    % (stripped["oracle"]["sums_matched"], stripped["oracle"]["sums_expected"]))

mismatched = json.loads(
    run([ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE,
         path("moe-model-transcript-routing.txt")]).stdout)
if mismatched["status"] != "ok" or mismatched["routing_oracle"]["verdict"] != "MISMATCH":
    failures.append("mm-routing-mismatch: status %r routing %r"
                    % (mismatched["status"], mismatched["routing_oracle"]["verdict"]))
if mismatched["oracle"]["verdict"] == "-" or mismatched["oracle"]["elements_compared"] <= 0:
    failures.append("mm-routing-mismatch: oracle 2 was skipped: %r" % mismatched["oracle"])
if mismatched["routing_oracle"]["first_difference_layer"] != 1:
    failures.append("mm-routing-mismatch: the first difference names layer %d, not 1"
                    % mismatched["routing_oracle"]["first_difference_layer"])

# Section 3.7's logits table. At the reconciliation width the generator's pure-Python second
# implementation agrees with the engine to **zero ten-thousandths** and not bit-for-bit, exactly as
# `--model-forward`'s own synthetic case does, so the hosted verdict is `FAIL` with
# `max_abs_diff_ten_thousandths: 0` and `IDENTICAL` stays the real model's cell (section 6).
recon = json.loads(run([ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE, TRANSCRIPT, LOGITS]).stdout)
if recon["oracle_logits"]["compared_pass"] != "reconciliation":
    failures.append("mm-logits: compared_pass %r" % recon["oracle_logits"]["compared_pass"])
if recon["oracle_logits"]["max_abs_diff_ten_thousandths"] != 0:
    failures.append("mm-logits: %d ten-thousandths against the generator's own forward"
                    % recon["oracle_logits"]["max_abs_diff_ten_thousandths"])
if recon["oracle_logits"]["argmax_primary"] != recon["oracle_logits"]["argmax_reference"]:
    failures.append("mm-logits: argmax %d != %r"
                    % (recon["oracle_logits"]["argmax_primary"],
                       recon["oracle_logits"]["argmax_reference"]))
if recon["oracle_logits"]["tolerance_ten_thousandths"] != 5000:
    failures.append("mm-logits: the runtime bound was widened to %d"
                    % recon["oracle_logits"]["tolerance_ten_thousandths"])

within = json.loads(
    run([ARM, PACK, GEOM, TOKENS, RUNTIME, "-", SOURCE, "-",
         path("moe-model-logits-runtime.bin")]).stdout)
if within["oracle_logits"]["verdict"] != "WITHIN" \
        or within["oracle_logits"]["compared_pass"] != "runtime":
    failures.append("mm-logits-runtime-width: %r" % within["oracle_logits"])
if within["oracle_logits"]["top_k_set_agreement"] != 10:
    failures.append("mm-logits-runtime-width: top ten set agreement %d"
                    % within["oracle_logits"]["top_k_set_agreement"])
if within["oracle"]["verdict"] != "-":
    failures.append("mm-logits-runtime-width: `-` in the transcript position still ran oracle 2")

# The order clause is **reported, not required**: a reference whose ranks are permuted inside the
# top ten is `WITHIN` with `top_k_order_agreement < 10` and `top_k_set_agreement == 10`.
swapped = json.loads(
    run([ARM, PACK, GEOM, TOKENS, RUNTIME, "-", SOURCE, "-",
         path("moe-model-logits-order-swap.bin")]).stdout)
if swapped["oracle_logits"]["verdict"] != "WITHIN":
    failures.append("mm-logits-order-swap: verdict %r" % swapped["oracle_logits"]["verdict"])
if swapped["oracle_logits"]["top_k_set_agreement"] != 10 \
        or swapped["oracle_logits"]["top_k_order_agreement"] >= 10:
    failures.append("mm-logits-order-swap: set %d order %d -- the two are not distinguished"
                    % (swapped["oracle_logits"]["top_k_set_agreement"],
                       swapped["oracle_logits"]["top_k_order_agreement"]))

# A real failure is not `WITHIN`: a reference shifted by 1.0 keeps the argmax and the top ten and is
# still refused, so the tolerance alone cannot pass it.
shifted = json.loads(
    run([ARM, PACK, GEOM, TOKENS, RUNTIME, "-", SOURCE, "-",
         path("moe-model-logits-perturbed.bin")]).stdout)
if shifted["oracle_logits"]["verdict"] != "FAIL" \
        or shifted["oracle_logits"]["argmax_primary"] \
        != shifted["oracle_logits"]["argmax_reference"]:
    failures.append("mm-logits-perturbed-runtime: %r" % shifted["oracle_logits"])

# Both output forms emit byte-identical document bytes (section 3.3).
document_path = os.path.join(work_dir, "moe-model.json")
stdout_form = run([ARM, PACK, GEOM, TOKENS, WIDTH]).stdout.decode("utf-8").rstrip("\n")
run([ARM, PACK, GEOM, TOKENS, WIDTH, document_path])
with open(document_path, "r", encoding="utf-8") as handle:
    file_form = handle.read()
if normalize(stdout_form) != normalize(file_form):
    failures.append("mm-doc-stdout-identical: the stdout and file forms differ")
dash_form = run([ARM, PACK, GEOM, TOKENS, WIDTH, "-"]).stdout.decode("utf-8").rstrip("\n")
if normalize(dash_form) != normalize(stdout_form):
    failures.append("mm-doc-stdout-identical: the `-` form differs from the five-operand form")

repeats = {normalize(run([ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE, TRANSCRIPT, LOGITS])
                     .stdout.decode("utf-8")) for _ in range(3)}
if len(repeats) != 1:
    failures.append("three consecutive runs produced %d distinct documents" % len(repeats))

forced_documents = {}
for name, force, operands, expected in FORCED_CASES:
    build_shim(force)
    forced_documents[name] = record(name, operands, expected)

build_shim(None)

# `R5D_EXPERT_ID`'s detail names the exact `(layer, token, slot)`, and `R5E_CARRY`'s the exact
# carried input, because "an id is out of range", "two slots of one token name the same expert" and
# "a carried length disagrees" are three different bugs.
for case, wanted in (("mm-force-routing-id-range", "layer[0]token[0]slot[0]"),
                     ("mm-force-routing-id-repeat", "layer[0]token[0]slot[1]"),
                     ("mm-force-carry-short", "layer[0]input[ffn_norm]"),
                     ("mm-force-residual-short", "layer[0]")):
    document = forced_documents.get(case)
    if document is not None and document["error_detail"] != wanted:
        failures.append("%s: detail %r, not %r" % (case, document["error_detail"], wanted))

# The denominator, fixed here and nowhere else: the codes `docs/specs/r5e-moe-model-prefill.md`
# section 3.9 declares under an `R5*` prefix -- R5A's and R5B's re-raised rows, R5D's four, and
# R5E's four. `R5_INDEX` is **not** in it: section 3.9's inherited-code row named it and the arm
# emits it nowhere (section 6, correction C17). The container's own `R4_PACK_*` family, `R4_5_SLICE`
# and `R2_EXPERT_ID_NOT_INTEGRAL` are inherited contracts owned by `alignpack-smoke` and R2A, and
# are counted separately below.
DECLARED_R5_CODES = {
    "R5E_ARITY", "R5E_PATH", "R5E_CARRY", "R5E_CLAIM_OVERFLOW",
    "R5D_ROUTER_SHAPE", "R5D_EXPERT_ID", "R5D_CLAIM_BUDGET", "R5D_CLAIM_MISSING",
    "R5_TOKENS", "R5_KV_WIDTH", "R5_GEOMETRY", "R5_GEOMETRY_UNREADABLE",
    "R5_BLOCK_MISSING", "R5_BLOCK_AMBIGUOUS", "R5_LAYER_COVERAGE", "R5_MEMBER_MISSING",
    "R5_SHAPE", "R5_WINDOW_BUDGET", "R5_GGML_UNAVAILABLE", "R5_ABI", "R5_TYPE_UNSUPPORTED",
    "R5_GGML_INIT", "R5_SLOT", "R5_ALLOC", "R5_COMPUTE", "R5_ALIGNMENT", "R5_RESIDUAL",
    "R5_SOURCE_UNREADABLE", "R5_SOURCE_DIVERGED", "R5_REFERENCE_MISMATCH", "R5_TRANSCRIPT",
    "R5_ORACLE_MISSING", "R5_ORACLE_SHAPE", "R5_ORACLE_TRUNCATED",
    "R5_LOGITS_UNREADABLE", "R5_LOGITS_SHAPE", "R5_LOGITS_NONFINITE",
}
# The four this block does not reach, each with the reason section 4.5 records. `R5_ABI` needs a
# drifted ggml; the other three are fail-closed guards on arithmetic no input can produce.
UNREACHED_R5_CODES = {"R5_ABI", "R5E_CLAIM_OVERFLOW", "R5_WINDOW_BUDGET", "R5D_CLAIM_BUDGET"}
# Inherited codes the block also reaches, counted and asserted but outside the R5* denominator.
INHERITED_CODES = {"R4_PACK_UNREADABLE", "R4_PACK_TRUNCATED", "R4_PACK_OFFSET", "R4_5_SLICE",
                   "R2_EXPERT_ID_NOT_INTEGRAL"}
# `R5E_ARITY` and `R5E_PATH` produce no document, so they are reached by the `NO_DOCUMENT` list
# rather than by a document's `error_code`.
reached = (codes - {""}) | {"R5E_ARITY", "R5E_PATH"}
expected_reached = (DECLARED_R5_CODES - UNREACHED_R5_CODES) | INHERITED_CODES
if reached != expected_reached:
    if expected_reached - reached:
        failures.append("codes never reached: %s"
                        % ", ".join(sorted(expected_reached - reached)))
    if reached - expected_reached:
        failures.append("codes reached that this block does not declare: %s"
                        % ", ".join(sorted(reached - expected_reached)))

ORDER = ([name for name, _, _ in STUB_CASES]
         + [name for name, _, _ in ENGINE_CASES]
         + [name for name, _, _, _ in FORCED_CASES]
         + [name for name, _, _ in ONE_TOKEN_CASES])

if update:
    with open(golden_path, "w", encoding="utf-8") as handle:
        for name in ORDER:
            handle.write(json.dumps({"case": name, "document": produced[name]},
                                    separators=(",", ":"), ensure_ascii=False) + "\n")
    print("moe model forward smoke: golden rewritten with %d cases" % len(produced))
else:
    with open(golden_path, "r", encoding="utf-8") as handle:
        golden = [json.loads(line) for line in handle if line.strip()]
    if [row["case"] for row in golden] != ORDER:
        failures.append("the golden case list does not match the runner's case list")
    else:
        for row in golden:
            if produced.get(row["case"]) != row["document"]:
                failures.append("golden mismatch for %s: %s"
                                % (row["case"],
                                   describe_difference(row["document"],
                                                       produced.get(row["case"]))))

if failures:
    for line in failures:
        sys.stderr.write("moe model forward smoke: FAIL %s\n" % line)
    raise SystemExit(1)

print("moe model forward smoke: %d no-document cases (R5E_ARITY, R5E_PATH), %d documented cases, "
      "%d of the %d declared R5* codes reached plus %d inherited R4/R2 codes, all four oracles, the "
      "routing identity element-wise complete over a whole model, and arm-r5a/r5b/r5d-unchanged PASS"
      % (len(NO_DOCUMENT), len(ORDER),
         len(reached & DECLARED_R5_CODES), len(DECLARED_R5_CODES),
         len(reached & INHERITED_CODES)))
PY

# ---------------------------------------------------------------------------------------------
# R6-DECODE-KV-STEP1 and R6-STEP-N — the `--decode-step` arm over the same synthetic two-layer model
#
# `docs/specs/r6-decode-kv-step1.md` section 5.1 and `docs/specs/r6-step-n.md` section 5. This block
# extends the existing runner rather than adding a target: `layer-forward-smoke` is already a member
# of HOSTED_CHECK_TARGETS, so both capabilities add rows to it and change no aggregate membership and
# no check topology.
#
# Hosted, ggml-free, model-free, llama.cpp-free. The corpus is `layer_forward_fixture.py --model`
# extended with a **loop of three calls**: a pure-Python decode step per iteration at
# `n_past = T + k - 1` over the KV plane the prefill produced and each step grew, and a transcript
# holding **four graphs** exactly as `llama-eval-callback -n 3` emits them. Every oracle is therefore
# reachable with no ggml and no model — oracle A' against transcript graph `k + 1` at three different
# offsets, oracle B over the plane's own bytes including each step's newly written column.
# ---------------------------------------------------------------------------------------------

DYLD_LIBRARY_PATH="${shim_dir}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}" \
LD_LIBRARY_PATH="${shim_dir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
python3 - "${root_dir}" "${work_dir}" <<'PY'
import hashlib
import json
import os
import re
import shutil
import struct
import subprocess
import sys

root_dir, work_dir = sys.argv[1:3]
binary = os.path.join(work_dir, "ggml-spike")
builder = os.path.join(root_dir, "scripts", "build-ggml-shim")
golden_path = os.path.join(root_dir, "scripts", "decode-step-golden.jsonl")
update = os.environ.get("ALIGN_LLM_LAYER_FORWARD_GOLDEN_UPDATE") == "1"

ARM = "--decode-step"


def path(name):
    return os.path.join(work_dir, name)


def geom(name):
    return os.path.join(work_dir, name + ".json")


PACK = path("model-pack.alignpack")
GEOM = path("geometry.json")
TOKENS = "3,17,5"
SOURCE = path("model-source.bin")
TRANSCRIPT = path("model-decode-transcript.txt")
SHORT_TRANSCRIPT = path("model-decode-transcript-short-for-steps.txt")
LOGITS = path("model-logits.bin")
WIDTH = "8"
STEPS = "3"

# R6-RESIDENT-WEIGHTS section 5.2's staging-boundary case, moved to R6-PREFIX-TTFT's 2048-token
# boundary. This geometry's `n_vocab` is 32, so the prompt repeats `0..31` sixty-four times: every
# id is valid, and slot 2047 still carries the row for id 31 rather than an all-zero accident. The
# width is `T + N` exactly, the minimum `--decode-step` accepts.
STAGE_FULL = "ds-resident-stage-full"
STAGE_FULL_TOKENS = ",".join(str(identifier % 32) for identifier in range(2048))
STAGE_FULL_WIDTH = "2049"
STAGE_FULL_STEPS = "1"

# R6-KV-PERSIST section 5.1. Every container this block writes lands under the runner's own
# `mktemp -d` tree: the checkout is read-only under the fresh worker and nothing is written inside
# it. Section 6 risk 2's whole member list is closed here — physical paths, a refusal before any
# reclaim trap, `-L` as well as `-e`, and the `chmod -R u+rwX` the shell trap above performs.
READER = os.path.join(root_dir, "scripts", "kv_plane_reader.py")
KV_SAVE = path("kv-saved.akvp")
KV_DETERMINISM_A = path("kv-determinism-a.akvp")
KV_DETERMINISM_B = path("kv-determinism-b.akvp")
KV_DETERMINISM_C = path("kv-determinism-c.akvp")
KV_OCCUPIED = path("kv-occupied.akvp")
KV_OCCUPIED_LINK = path("kv-occupied-link.akvp")
KV_READONLY_DIR = path("kv-readonly")
KV_UNWRITABLE = os.path.join(KV_READONLY_DIR, "kv.akvp")
KV_ABSENT = path("kv-absent.akvp")
KV_GOOD = path("model-kv-good.akvp")
KV_EXPANDED_33 = path("model-kv-expanded-33.akvp")
KV_EXPANDED_CORPUS = path("model-kv-expanded-corpus.akvp")
KV_EXPANDED_2048 = path("model-kv-expanded-2048.akvp")
KV_EXPANDED_2049 = path("model-kv-expanded-2049.akvp")
KV_FOREIGN = path("model-kv-foreign-geometry.akvp")
KV_HUGE = geom("geometry-kv-too-large")
KV_ZERO_IDENTITY_PACK = path("model-pack-zero-identity.alignpack")
KV_IDENTITY_ABSENT_DEST = path("kv-identity-absent.akvp")

# R6-PREFIX-SUFFIX-PREFILL section 5.1. One container, written by the arm's own save direction for
# the **prefix** `3,17`, and continued by three different suffixes. Two of the three single-shot
# comparands are new documents and the third is `ds-kv-args-dash-dash`, which already exists as a
# golden row — so "three routes to one state produce one document" is checked rather than stated.
#
# `T_prefix = 2` on all three, and **`T_prefix = 1` is a fourth split** since MF-SINGLE-TOKEN-LOGITS
# (roadmap item 36) fixed the one-token gather this capability originally refused around: the bound
# it shipped, `R6_SUFFIX prefix[<n>]`, is gone and `ds-suffix-prefix-one` is a passing oracle-S run
# rather than a refusal -- asserted from `BOUNDARY_CASES`, without a golden row, for the measured
# cross-host reason recorded there. The closure cells `T_prefix = 1` does not carry — `S >= 2` and a suffix
# column attending to an earlier suffix column — are still carried by `ds-suffix-2` and
# `ds-suffix-3` at `T_prefix = 2`.
KV_PREFIX = path("kv-prefix.akvp")
# MF-SINGLE-TOKEN-LOGITS (roadmap item 36) lifted the `T_prefix >= 2` bound, so the one-token prefix
# gets its own container and its own two-token single-shot comparand.
KV_PREFIX_ONE = path("kv-prefix-one.akvp")
KV_PREFIX_CAP = path("kv-prefix-cap.akvp")
SUFFIX_PREFIX_ONE = "3"
SUFFIX_FULL_TWO = "3,5"
SUFFIX_PREFIX_TOKENS = "3,17"
SUFFIX_ONE = "5"
SUFFIX_TWO = "5,9"
SUFFIX_THREE = "5,9,27"
SUFFIX_FULL_FOUR = "3,17,5,9"
# Named because it lives in `BOUNDARY_CASES` and is referenced by oracle S from there.
SUFFIX_SINGLE_SHOT_4 = "ds-suffix-single-shot-4"
SUFFIX_FULL_FIVE = "3,17,5,9,27"
SUFFIX_STEPS_THREE = "2"
# R6-PREFIX-TTFT's exact legal sequence boundary. Repeating one in-vocabulary suffix id keeps this
# about `T_prefix + S`, not about the fixture's 32-token vocabulary.
SUFFIX_AT_CAP = ",".join(["5"] * 2046)
SUFFIX_FULL_CAP = SUFFIX_PREFIX_TOKENS + "," + SUFFIX_AT_CAP
SUFFIX_CAP_WIDTH = "2049"

# `docs/specs/r6-moe-resident-dense.md` section 13 item 15's payload, and the two exact details it
# must produce here. `bounded_detail` cut its operand at a fixed **byte** index, so an operand whose
# byte 256 fell inside a multibyte scalar aborted the process inside the slice and `--decode-step`
# produced no document where it owes a refusal. 245 ASCII bytes put byte 256 on the third byte of
# the fourth `\u3042`. The helper now backs off over continuation bytes (`0x80..0xBF`) to a lead
# byte, and it runs **twice** on each of these paths — once inside `resident_detail`/`suffix_detail`
# over the operand, once inside `fail` over the wrapped result. The first cut lands at 254 bytes
# (`"a" * 245` plus three `\u3042`); over `resident[...]` the second lands at 254 and keeps only the
# nine-byte prefix and the ASCII, while over the shorter `suffix[...]` prefix it lands at 255 and
# keeps one whole `\u3042` — which is the boundary itself, asserted rather than described. Both
# strings are written out because *where* the cut lands is the thing under test.
MULTIBYTE_OPERAND = "a" * 245 + "\u3042" * 20
MULTIBYTE_RESIDENT_DETAIL = "resident[" + "a" * 245
MULTIBYTE_SUFFIX_DETAIL = "suffix[" + "a" * 245 + "\u3042"


# R6-PREFIX-KEY (`docs/specs/r6-prefix-key-corpus.md` sections 5.1 and 5.2). Every store is a
# directory **the caller creates**: the arm never creates one, never lists one, and writes nothing
# into it but `<64-hex>.akvp`. All of them live under the runner's own `mktemp -d` tree.
STORE_DIR = path("store")
STORE_SUFFIX_DIR = path("store-suffix")
STORE_RESIDENT_DIR = path("store-resident")
STORE_STABLE_DIR = path("store-stable")
STORE_ABSENT_DIR = path("store-absent")
STORE_FILE = path("store-not-a-directory")
STORE_CORRUPT_DIR = path("store-corrupt")
STORE_WRONG_TOKENS_DIR = path("store-wrong-tokens")
STORE_WRONG_PACK_DIR = path("store-wrong-pack")
STORE_KEY_TOKENS_DIR = path("store-key-tokens")
STORE_KEY_WIDTH_DIR = path("store-key-width")
STORE_KEY_GEOMETRY_DIR = path("store-key-geometry")
STORE_KEY_PACK_DIR = path("store-key-pack")
STORE_KEY_TOKENS = "3,17,9"
STORE_KEY_WIDTH = "16"
STORE_KEY_GEOMETRY = geom("geometry-key-variant")
STORE_KEY_PACK = path("model-pack-key-variant.alignpack")

# Section 3.2, oracle D — **this is the third implementation of section 2.3's 152-byte preimage**,
# beside `src/kv_plane.align`'s `derive_key` and `scripts/kv_plane_reader.py`'s. It is written from
# the specification and takes its inputs from the **document** the arm published, which is what makes
# "the key is a function of the published digests" a test rather than a claim.
KEY_VERSION = 1
KEY_PREIMAGE_BYTES = 152
PACK_SOURCE_RECORD_OFFSET_AT = 80
PACK_TOTAL_BYTES_AT = 24
PACK_SOURCE_DIGEST_IN_RECORD = 48


def store_key(source_hex, geometry_hex, ids, kv_width, pack_total_bytes,
              plane_layout_version=1, element_type=0, format_version=1):
    stream = b"".join(struct.pack("<I", int(value)) for value in ids)
    preimage = b"".join([
        bytes.fromhex(source_hex),
        bytes.fromhex(geometry_hex),
        hashlib.sha256(stream).digest(),
        struct.pack("<Q", pack_total_bytes),
        struct.pack("<I", kv_width),
        struct.pack("<I", len(ids)),
        struct.pack("<I", plane_layout_version),
        struct.pack("<I", element_type),
        struct.pack("<I", format_version),
        struct.pack("<I", KEY_VERSION),
        b"\0" * 24,
    ])
    assert len(preimage) == KEY_PREIMAGE_BYTES, len(preimage)
    return hashlib.sha256(preimage).hexdigest()


def key_from_document(document):
    """Section 2.7's contract: the key is recomputable from the document alone, because `kv`
    publishes the three digests and the four scalars and `selection` publishes the width."""
    kv_object = document["kv"]
    return store_key(kv_object["source_header_region_sha256"], kv_object["geometry_sha256"],
                     document["selection"]["tokens"],
                     document["selection"]["reconciliation_width"],
                     kv_object["pack_total_bytes"],
                     kv_object["plane_layout_version"], 0, kv_object["format_version"])


def key_from_inputs(pack_path, geometry_path, ids, kv_width):
    """The same preimage from the **operands** rather than from a document, used only to place a
    container at a key path before any run has produced one (the three `hit-but-broken` rows). It is
    asserted equal to `key_from_document` wherever both exist, so it cannot drift silently."""
    with open(pack_path, "rb") as handle:
        raw = handle.read()
    total = struct.unpack_from("<Q", raw, PACK_TOTAL_BYTES_AT)[0]
    record = struct.unpack_from("<Q", raw, PACK_SOURCE_RECORD_OFFSET_AT)[0]
    at = record + PACK_SOURCE_DIGEST_IN_RECORD
    with open(geometry_path, "rb") as handle:
        geometry = handle.read()
    return store_key(raw[at:at + 32].hex(), hashlib.sha256(geometry).hexdigest(), ids, kv_width,
                     total)


def store_file(directory, key):
    return os.path.join(directory, key + ".akvp")


def kv(mutation):
    return path("model-kv-%s.akvp" % mutation)


def ds(save="-", load="-", width=WIDTH, geometry=GEOM, steps=STEPS, transcript=None, pack=None,
       resident=None, tokens=None, suffix=None, store=None):
    """One thirteen-operand invocation, or a fourteen-operand one when `resident` is given. Every kv
    case is thirteen operands so that the two directions differ in nothing but which position holds
    the path; every R6-RESIDENT-WEIGHTS case is the *same* thirteen plus one operand, so the
    streamed and resident legs differ in nothing but that operand. `pack` is R6-KV-PERSIST's own
    axis: a container whose identity record the arm must refuse. `tokens` is the staging boundary's
    axis and nothing else uses it: every other case runs this block's three-token prompt."""
    operands = [ARM, PACK if pack is None else pack, geometry,
                TOKENS if tokens is None else tokens, "-", SOURCE,
                TRANSCRIPT if transcript is None else transcript, width, "-", steps, save, load]
    # R6-PREFIX-SUFFIX-PREFILL section 2.2. `SUFFIX` is `args[14]`, so a case that supplies it also
    # supplies `RESIDENT`'s position — with the default `-` unless the case names one, which is what
    # makes the streamed and resident suffix legs differ in exactly that operand.
    if resident is not None or suffix is not None or store is not None:
        operands.append("-" if resident is None else resident)
    # R6-PREFIX-KEY section 2.2. `STORE` is `args[15]`, so a case that supplies it also supplies
    # `SUFFIX`'s position — with the default `-` unless the case names one. `args.len() == 16` with
    # `STORE` of `-` is exactly `args.len() == 15`, so nothing below changes an existing meaning.
    if suffix is not None or store is not None:
        operands.append("-" if suffix is None else suffix)
    if store is not None:
        operands.append(store)
    return operands


