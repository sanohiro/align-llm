# The generator's own greedy ids: one per line, `K` lines, the ids its own reference loop
# **consumed**. The arm derives step 1's token from its own prefill logits and every later step's
# from its own previous step (R6 section 2.1, R6-STEP-N section 3.2), and never takes any of them as
# an operand, so this file is what makes "the arm decoded the tokens the reference decoded" an
# assertion rather than a coincidence.
with open(path("model-decode-tokens.txt"), "r", encoding="utf-8") as handle:
    EXPECTED_TOKENS = [int(line) for line in handle.read().split()]
EXPECTED_TOKEN = EXPECTED_TOKENS[0]
# R6-STEP-N section 4.7. **The reference chain must be non-degenerate, and this block refuses to run
# if it is not.** Every per-step assertion below — `token_ids` against the reference, the
# `argmax`-to-next-`token_id` chain, and the distinct digests — is satisfied by an arm that decoded
# step 1 and then fed its own first token to every later step, so long as the reference ids are all
# equal. They are not equal by construction (`MODEL_DECODE_RESEEDED_ROWS`), and this is the guard
# that keeps them that way rather than trusting the generator.
if len(set(EXPECTED_TOKENS)) != len(EXPECTED_TOKENS):
    sys.stderr.write("decode step smoke: FAIL the reference decode loop is degenerate: %r\n"
                     % (EXPECTED_TOKENS,))
    raise SystemExit(1)

# R6-STEP-N section 2.2's arity rule: five, six, seven, nine, ten, or **eleven** operands. **Eight is
# still `R6_ARITY`** and the gap is the contract, inherited verbatim from `--model-forward`.
#
# `--decode-stepped` is not and will not be an arm. R6 used `--decode-steps` here, and R6-STEP-N
# would have turned that negative case positive had it shipped a second arm; it ships a `STEPS`
# operand instead, and the case moves to a flag that stays unknown.
NO_DOCUMENT = [
    ("ds-arity-3", [ARM, PACK, GEOM]),
    ("ds-arity-8", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, TRANSCRIPT]),
    # R6-KV-PERSIST section 5.3: `ds-arity-14` replaces `ds-arity-12` as the over-arity case. Both
    # are `NO_DOCUMENT` and carry no golden row, so the move costs zero golden bytes.
    ("ds-arity-14",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, TRANSCRIPT, WIDTH, LOGITS, STEPS, "-", "-", "extra"]),
    ("ds-path-kv-save-empty",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, TRANSCRIPT, WIDTH, LOGITS, STEPS, "", "-"]),
    ("ds-path-kv-load-empty",
     [ARM, PACK, GEOM, TOKENS, "-", SOURCE, TRANSCRIPT, WIDTH, LOGITS, STEPS, "-", ""]),
    ("ds-path-pack-empty", [ARM, "", GEOM, TOKENS]),
    ("ds-path-geometry-empty", [ARM, PACK, "", TOKENS]),
    ("ds-path-long", [ARM, "/" + ("a" * 5000), GEOM, TOKENS]),
    ("ds-path-doc-empty", [ARM, PACK, GEOM, TOKENS, ""]),
    ("ds-path-reference-empty", [ARM, PACK, GEOM, TOKENS, "-", ""]),
    ("ds-path-logits-empty", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, TRANSCRIPT, WIDTH, ""]),
    ("ds-arm-unknown-flag", ["--decode-stepped", PACK, GEOM, TOKENS]),
]

# Steps 3 to 8 of section 2.8, in order, against the **default** stub: the whole reader, the
# geometry, the width, the container, the coverage rule, and every member record run for real
# without ggml, and the arm stops at step 9 with `R5_GGML_UNAVAILABLE`.
#
# `KV_WIDTH` has no default at any arity, so every case below nine operands is refused at step 6
# with `kv_width[-1]`; that is what "fail-closed" means for an arm whose lower bound is `T + 1`.
STUB_CASES = [
    ("ds-stub-unavailable", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", WIDTH],
     "R5_GGML_UNAVAILABLE"),
    ("ds-tokens-empty", [ARM, PACK, GEOM, ""], "R6_TOKENS"),
    ("ds-tokens-trailing", [ARM, PACK, GEOM, "1,"], "R6_TOKENS"),
    # R6-STEP-N section 2.5's lift, 8 -> 32. **33 repetitions of token id 1, not `1,2,...,33`:** the
    # hosted geometry's `n_vocab` is 32, so an ascending list would be refused as out-of-vocabulary
    # and the case would stop being about the cap.
    ("ds-tokens-33", [ARM, PACK, GEOM, ",".join(["1"] * 33)], "R6_TOKENS"),
    ("ds-tokens-oob", [ARM, PACK, GEOM, "1,32"], "R6_TOKENS"),
    # Step 3b (R6-STEP-N section 2.3). Parse, then range, then the cap; the plane bound is step 6's
    # and raises `R6_KV_WIDTH`, which is what `ds-kv-width-narrow-for-steps` below asserts.
    ("ds-steps-empty", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", WIDTH, "-", ""], "R6_STEPS"),
    ("ds-steps-zero", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", WIDTH, "-", "0"], "R6_STEPS"),
    ("ds-steps-negative", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", WIDTH, "-", "-1"],
     "R6_STEPS"),
    ("ds-steps-trailing", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", WIDTH, "-", "3,"],
     "R6_STEPS"),
    ("ds-steps-over-max", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", WIDTH, "-", "65"],
     "R6_STEPS"),
    # The precedence assertion: `STEPS` is decided before `KV_WIDTH`, because `N` must be a number
    # before `T + N` is one. Both operands are invalid here and the code is `R6_STEPS`.
    ("ds-steps-zero-and-narrow", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", "2", "-", "0"],
     "R6_STEPS"),
    ("ds-geometry-unreadable", [ARM, PACK, path("absent.json"), TOKENS],
     "R6_GEOMETRY_UNREADABLE"),
    ("ds-geometry-not-json", [ARM, PACK, TRANSCRIPT, TOKENS], "R6_GEOMETRY"),
    ("ds-geometry-arch", [ARM, PACK, geom("geometry-arch"), TOKENS], "R6_GEOMETRY"),
    ("ds-geometry-missing-n_layer", [ARM, PACK, geom("geometry-missing-n_layer"), TOKENS],
     "R6_GEOMETRY"),
    # Section 1.3's declared non-goal, given a code that says so rather than the generic one.
    ("ds-arch-unsupported", [ARM, PACK, geom("geometry-expert"), TOKENS], "R6_ARCH_UNSUPPORTED"),
    ("ds-kv-width-absent", [ARM, PACK, GEOM, TOKENS], "R6_KV_WIDTH"),
    ("ds-kv-width-empty", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", ""], "R6_KV_WIDTH"),
    ("ds-kv-width-negative", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", "-1"], "R6_KV_WIDTH"),
    # The lower bound is `T + 1` and not `T`: the decode step's own column has to fit.
    ("ds-kv-width-equal-t", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", "3"], "R6_KV_WIDTH"),
    # The generalised bound: `T + N <= KV_WIDTH`. At `T = 3` and `N = 3` a width of 5 is one column
    # short, and the code is `R6_KV_WIDTH` rather than `R6_STEPS` because "the plane is too narrow
    # for this run" is a sentence R6 already owns.
    ("ds-kv-width-narrow-for-steps", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", "5", "-", STEPS],
     "R6_KV_WIDTH"),
    ("ds-kv-width-over-max", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", "4097"], "R6_KV_WIDTH"),
    ("ds-pack-missing", [ARM, path("absent.alignpack"), GEOM, TOKENS, "-", SOURCE, "-", WIDTH],
     "R4_PACK_UNREADABLE"),
    ("ds-block-missing-output",
     [ARM, path("model-pack-no-output.alignpack"), GEOM, TOKENS, "-", SOURCE, "-", WIDTH],
     "R5_BLOCK_MISSING"),
    ("ds-coverage-gap",
     [ARM, path("model-pack-coverage.alignpack"), GEOM, TOKENS, "-", SOURCE, "-", WIDTH],
     "R5_LAYER_COVERAGE"),
    ("ds-member-missing",
     [ARM, path("model-pack-member-missing.alignpack"), GEOM, TOKENS, "-", SOURCE, "-", WIDTH],
     "R5_MEMBER_MISSING"),
    ("ds-shape", [ARM, path("model-pack-shape.alignpack"), GEOM, TOKENS, "-", SOURCE, "-", WIDTH],
     "R5_SHAPE"),
]

ENGINE_CASES = [
    ("ds-engine-ok", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, "-", WIDTH], ""),
    ("ds-engine-transcript", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, TRANSCRIPT, WIDTH], ""),
    ("ds-engine-logits", [ARM, PACK, GEOM, TOKENS, "-", SOURCE, TRANSCRIPT, WIDTH, LOGITS], ""),
