PLACEHOLDER = {"pack_path": "<pack>", "geometry_path": "<geometry>",
               "reference_path": "<reference>", "transcript_path": "<transcript>",
               "logits_path": "<logits>"}


def describe_difference(expected_text, actual_text, limit=8):
    if actual_text is None:
        return "no document was produced"
    try:
        expected = json.loads(expected_text)
        actual = json.loads(actual_text)
    except Exception as error:  # noqa: BLE001 - the document is the thing under test
        return "the documents are not both JSON: %s" % error
    differences = []

    def walk(left, right, path_text):
        if len(differences) >= limit:
            return
        if type(left) is not type(right):
            differences.append("%s: %r != %r" % (path_text or ".", left, right))
        elif isinstance(left, dict):
            for key in sorted(set(left) | set(right)):
                if len(differences) >= limit:
                    return
                if key not in left:
                    differences.append("%s.%s: absent != %r" % (path_text, key, right[key]))
                elif key not in right:
                    differences.append("%s.%s: %r != absent" % (path_text, key, left[key]))
                else:
                    walk(left[key], right[key], "%s.%s" % (path_text, key))
        elif isinstance(left, list):
            if len(left) != len(right):
                differences.append("%s: %d entries != %d" % (path_text, len(left), len(right)))
                return
            for index in range(len(left)):
                if len(differences) >= limit:
                    return
                walk(left[index], right[index], "%s[%d]" % (path_text, index))
        elif left != right:
            differences.append("%s: %r != %r" % (path_text or ".", left, right))

    walk(expected, actual, "")
    if not differences:
        return "the documents differ only in text form"
    return "expected != actual at " + "; ".join(differences)


def normalize(text):
    """Every nanosecond field is zeroed, wherever it lives. R5E publishes five of them **per
    schedule row** as well as nine in `timings` and two in `head`, so a normalizer that only
    reached the `timings` object would leave thirty-two wall-clock numbers in the golden."""
    document = json.loads(text)

    def scrub(node):
        if isinstance(node, dict):
            for key in node:
                if key.endswith("_ns") and isinstance(node[key], int):
                    node[key] = 0
                else:
                    scrub(node[key])
        elif isinstance(node, list):
            for item in node:
                scrub(item)

    scrub(document)
    for key, placeholder in PLACEHOLDER.items():
        if document[key]:
            document[key] = placeholder
    return json.dumps(document, separators=(",", ":"), ensure_ascii=False)


def build_shim(force):
    environment = dict(os.environ)
    environment.pop("ALIGN_LLM_GGML_INCLUDE", None)
    environment.pop("ALIGN_LLM_GGML_LIB", None)
    if force:
        environment["ALIGN_LLM_GGML_FORCE"] = force
    else:
        environment.pop("ALIGN_LLM_GGML_FORCE", None)
    subprocess.run([builder], check=True, capture_output=True, env=environment)


def run(operands):
    return subprocess.run([binary] + operands, capture_output=True, cwd=work_dir)


failures = []
produced = {}
codes = set()


def record(name, operands, expected):
    result = run(operands)
    if result.stdout == b"":
        failures.append("%s: no document (exit %d): %s"
                        % (name, result.returncode,
                           result.stderr.decode("utf-8", "replace")[-400:]))
        return None
    try:
        document = json.loads(result.stdout.decode("utf-8"))
    except Exception as error:  # noqa: BLE001 - the document is the thing under test
        failures.append("%s: the document is not valid JSON: %s" % (name, error))
        return None
    produced[name] = normalize(result.stdout.decode("utf-8"))
    codes.add(document["error_code"])
    if document["error_code"] != expected:
        failures.append("%s: expected error_code %r, got %r (%r)"
                        % (name, expected, document["error_code"], document["error_detail"]))
    expected_exit = 0 if document["status"] == "ok" else 1
    if (result.returncode == 0) != (expected_exit == 0):
        failures.append("%s: status %r but exit %d"
                        % (name, document["status"], result.returncode))
    if document["kind"] != "R5_MOE_MODEL_FORWARD" or document["schema_version"] != 1:
        failures.append("%s: wrong document identity %r/%r"
                        % (name, document["kind"], document["schema_version"]))
    if not document["abi"]["fp_contract_off"]:
        failures.append("%s: the shim was not built with -ffp-contract=off; the goldens are not "
                        "reproducible across compilers" % name)
    return document


for name, operands in NO_DOCUMENT:
    result = run(operands)
    if result.returncode == 0:
        failures.append("%s: expected a non-zero exit, got 0" % name)
    if result.stdout != b"":
        failures.append("%s: expected no document, got %d bytes" % (name, len(result.stdout)))

# The four arms before this one are untouched: the first operand selects an arm and nothing else.
for label, arm, operands, kind in (
        ("arm-r5a-unchanged", "--layer-forward",
         [os.path.join(work_dir, "pack.alignpack"), "0",
          os.path.join(work_dir, "geometry.json"), "3,17,5"], "R5_LAYER_FORWARD"),
        ("arm-r5b-unchanged", "--model-forward",
         [os.path.join(work_dir, "model-pack.alignpack"),
          os.path.join(work_dir, "geometry.json"), "3,17,5"], "R5_MODEL_FORWARD"),
        ("arm-r5d-unchanged", "--moe-layer-forward",
         [os.path.join(work_dir, "moe-pack.alignpack"),
          os.path.join(work_dir, "moe-geometry.json"), "0,1,8"], "R5_MOE_LAYER_FORWARD")):
    other = run([arm] + operands)
    if other.stdout == b"":
        failures.append("%s: the arm produced no document" % label)
    else:
        got = json.loads(other.stdout.decode("utf-8"))["kind"]
        if got != kind:
            failures.append("%s: the arm emitted %r" % (label, got))

for name, operands, expected in STUB_CASES:
    document = record(name, operands, expected)
    if document is None:
        continue
    lifetime = document["lifetime"]
    for key in ("ggml_buffers_created", "contexts_created", "backends_created",
                "gallocrs_created"):
        if lifetime[key] != 0:
            failures.append("%s: lifetime.%s is %d in a default stub build, not 0"
                            % (name, key, lifetime[key]))

build_shim("engine")
for name, operands, expected in ENGINE_CASES:
    document = record(name, operands, expected)
    if document is None or document["status"] != "ok":
        continue
    schedule = document["schedule"]
    residency = document["residency"]
    window = document["window"]
    graph = document["graph"]
    if document["verdict"] != "EXTERNAL":
        failures.append("%s: verdict %r, not EXTERNAL" % (name, document["verdict"]))
    if len(schedule) != 2:
        failures.append("%s: %d schedule rows, not 2" % (name, len(schedule)))
        continue
    # The schedule, against the generator's own independent forward of the same routed model.
    for row, expect in zip(schedule, EXPECTED["layers"]):
        for field in ("routed", "routed_count", "expert_ids", "compact_ids", "claim_bytes",
                      "t_out"):
            if row[field] != expect[field]:
                failures.append("%s: schedule[%d].%s is %r, not the generator's %r"
                                % (name, row["layer"], field, row[field], expect[field]))
        flat = [slot for token in row["compact_ids"] for slot in token]
        if sorted(set(flat)) != list(range(row["routed_count"])):
            failures.append("%s: schedule[%d].compact_ids is not a bijection onto [0, %d)"
                            % (name, row["layer"], row["routed_count"]))
        for token, ids in enumerate(row["expert_ids"]):
            if len(set(ids)) != len(ids):
                failures.append("%s: schedule[%d].expert_ids[%d] repeats an expert"
                                % (name, row["layer"], token))
            for slot, expert in enumerate(ids):
                if row["routed"][row["compact_ids"][token][slot]] != expert:
                    failures.append("%s: schedule[%d].compact_ids[%d][%d] does not name expert %d"
                                    % (name, row["layer"], token, slot, expert))
    # The narrowing: `T_in` is the token count at every layer and `T_out` is 1 at the last.
    if schedule[0]["t_in"] != 3 or schedule[0]["t_out"] != 3:
        failures.append("%s: layer 0 is %d->%d, not 3->3"
                        % (name, schedule[0]["t_in"], schedule[0]["t_out"]))
    if schedule[1]["t_in"] != 3 or schedule[1]["t_out"] != 1:
        failures.append("%s: the narrowing did not land inside the last layer: %d->%d"
                        % (name, schedule[1]["t_in"], schedule[1]["t_out"]))
    if schedule[1]["l_out_ne1"] != 1 or schedule[0]["l_out_ne1"] != 3:
        failures.append("%s: l_out_ne1 %d/%d, not 3/1"
                        % (name, schedule[0]["l_out_ne1"], schedule[1]["l_out_ne1"]))
    if document["selection"]["narrow_layer"] != 1 or document["selection"]["narrow_index"] != 2:
        failures.append("%s: narrow_layer/index %r" % (name, document["selection"]))
    if document["selection"]["expert_block_count"] != 16:
        failures.append("%s: expert_block_count %d, not 16"
                        % (name, document["selection"]["expert_block_count"]))
    # The residency measurement, against the generator's own arithmetic.
    for field in ("expert_bytes_read", "expert_bytes_in_model", "planes_read", "planes_in_model",
                  "keys_demanded", "cumulative_expert_bytes"):
        if residency[field] != EXPECTED[field]:
            failures.append("%s: residency.%s is %r, not the generator's %r"
                            % (name, field, residency[field], EXPECTED[field]))
    # Within one prefill no `(layer, expert)` key is demanded twice, which is the finding that says
    # a residency policy needs a multi-prefill consumer before any hit rate is a measurement.
    if residency["keys_demanded"] != residency["keys_distinct"]:
        failures.append("%s: keys_demanded %d != keys_distinct %d inside one prefill"
                        % (name, residency["keys_demanded"], residency["keys_distinct"]))
    if residency["cumulative_expert_bytes"][-1] != residency["expert_bytes_read"]:
        failures.append("%s: the union curve does not end at expert_bytes_read" % name)
    if residency["expert_bytes_read_ppm"] != 562500:
        failures.append("%s: expert_bytes_read_ppm %d, not the 562,500 of nine keys of sixteen"
                        % (name, residency["expert_bytes_read_ppm"]))
    # The claim window is reserved for the **arithmetic** bound and refilled per layer.
    if window["claim_u_max"] != 8:
        failures.append("%s: claim_u_max %d, not min(n_expert, n_expert_used * T) = 8"
                        % (name, window["claim_u_max"]))
    if window["claim_bytes"] != 12288 or window["claim_peak_use_bytes"] != 9216 \
            or window["claim_peak_use_layer"] != 0:
        failures.append("%s: claim window %r" % (name, window))
    if window["reuse_count"] != 6:
        failures.append("%s: reuse_count %d, not one per window fill across both windows"
                        % (name, window["reuse_count"]))
    if window["member_placements"] != 21 or window["claim_placements"] != 6:
        failures.append("%s: placements %d/%d, not 21 dense and 6 stacked"
                        % (name, window["member_placements"], window["claim_placements"]))
    if window["pointer_identity_failures"] != 0:
        failures.append("%s: a weight tensor is not at its own window offset" % name)
    if window["carried_bytes"] != 2 * 8 * 3 * 4 + 8 * 3 * 4 + 2 * 3 * 3 * 4:
        failures.append("%s: carried_bytes %d is not the five carried tensors"
                        % (name, window["carried_bytes"]))
    # Section 3.6's four table row counts, and ggml's own node counts beside them.
    if graph["graph_count"] != 6 or graph["table_rows_a"] != 35 or graph["table_rows_b"] != 14:
        failures.append("%s: graph shape %d graphs, tables %d+%d, not 6/35/14"
                        % (name, graph["graph_count"], graph["table_rows_a"],
                           graph["table_rows_b"]))
    if graph["embed_node_count"] != 1 or graph["head_node_count"] != 3:
        failures.append("%s: end graphs are %d and %d nodes"
                        % (name, graph["embed_node_count"], graph["head_node_count"]))
    # The two `node_when == 1` narrowing rows are issued only at the last layer, and the three
    # `node_when == 2` width rows at both layers because `KV_WIDTH > token_count`.
    if schedule[1]["node_count_a"] - schedule[0]["node_count_a"] != 2:
        failures.append("%s: the last layer is %d phase-A nodes against %d, not two more"
                        % (name, schedule[1]["node_count_a"], schedule[0]["node_count_a"]))
    if schedule[0]["node_count_b"] != schedule[1]["node_count_b"]:
        failures.append("%s: phase B is not width- and narrowing-independent" % name)
    if graph["slot_capacity"] != 128:
        failures.append("%s: slot_capacity %d, not 128" % (name, graph["slot_capacity"]))
    if document["output"]["element_count"] != 32:
        failures.append("%s: output.element_count %d, not n_vocab"
                        % (name, document["output"]["element_count"]))
    if not document["abi"]["slot_magic_ok"]:
        failures.append("%s: the slot store magic did not validate" % name)
    lifetime = document["lifetime"]
    if not lifetime["released_before_owner_scope_end"] or lifetime["phase_balance_failures"] != 0:
        failures.append("%s: the teardown did not balance at every phase boundary" % name)
    for created, freed in (("ggml_buffers_created", "ggml_buffers_freed"),
                           ("contexts_created", "contexts_freed"),
                           ("backends_created", "backends_freed"),
                           ("gallocrs_created", "gallocrs_freed")):
        if lifetime[created] != lifetime[freed]:
            failures.append("%s: %s %d != %s %d"
                            % (name, created, lifetime[created], freed, lifetime[freed]))

reference = json.loads(run([ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE]).stdout)
if reference["reference"]["verdict"] != "IDENTICAL":
    failures.append("mm-engine-reference: verdict %r" % reference["reference"]["verdict"])
if reference["reference"]["graphs_compared"] != 6:
    failures.append("mm-engine-reference: %d graphs compared, not 6"
                    % reference["reference"]["graphs_compared"])
if reference["reference"]["nodes_compared"] != reference["reference"]["nodes_identical"] \
        or reference["reference"]["nodes_compared"] != 1 + 14 * 2 + 2:
    failures.append("mm-engine-reference: %d/%d of 31 nodes identical"
                    % (reference["reference"]["nodes_identical"],
                       reference["reference"]["nodes_compared"]))

# Section 4.4's oracle cells: an exact pass, full routing coverage, and a breach that is a verdict
# on a successful run rather than an error code.
passing = json.loads(run([ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE, TRANSCRIPT]).stdout)
oracle = passing["oracle"]
routing_oracle = passing["routing_oracle"]
if oracle["verdict"] != "PASS":
    failures.append("mm-engine-transcript: verdict %r, worst %r@%d in layer %d, max_abs %d, "
                    "max_sum %d"
                    % (oracle["verdict"], oracle["worst_node"], oracle["worst_element_index"],
                       oracle["worst_layer"], oracle["max_abs_diff_ten_thousandths"],
                       oracle["max_sum_diff_millionths"]))
if oracle["nodes_expected"] != 31 or oracle["nodes_matched"] != 31:
    failures.append("mm-engine-transcript: %d/%d nodes matched"
                    % (oracle["nodes_matched"], oracle["nodes_expected"]))
if oracle["layers_expected"] != 2 or oracle["layers_matched"] != 2:
    failures.append("mm-engine-transcript: %d/%d layers matched"
                    % (oracle["layers_matched"], oracle["layers_expected"]))
if oracle["elements_compared"] != 606:
    failures.append("mm-engine-transcript: %d elements compared, not 606"
                    % oracle["elements_compared"])
if oracle["instrument_kv_width"] != 8:
    failures.append("mm-engine-transcript: instrument_kv_width %d, not the declared operand"
                    % oracle["instrument_kv_width"])
if oracle["tolerance_ten_thousandths"] != 1 or oracle["sum_tolerance_millionths"] != 1000 \
        or oracle["sum_tolerance_relative_ppm"] != 10:
    failures.append("mm-engine-transcript: a tolerance was widened: %r" % oracle)
if routing_oracle["verdict"] != "MATCH":
    failures.append("mm-engine-transcript: routing %r, first difference layer %d token %d slot %d"
                    % (routing_oracle["verdict"], routing_oracle["first_difference_layer"],
                       routing_oracle["first_difference_token"],
                       routing_oracle["first_difference_slot"]))
# Section 5.1: at `n_expert_used = 3` the slot axis is 3, so every id is printed and this corpus is
# the only place the routing oracle's **full** coverage is reachable across a whole model.
if routing_oracle["ids_total"] != 12 or routing_oracle["ids_printed_compared"] != 12 \
        or routing_oracle["ids_printed_matched"] != 12:
    failures.append("mm-engine-transcript: routing coverage %d/%d of %d is not element-wise "
                    "complete at n_expert_used 3"
                    % (routing_oracle["ids_printed_matched"],
                       routing_oracle["ids_printed_compared"], routing_oracle["ids_total"]))
if routing_oracle["sums_expected"] != 2 or routing_oracle["sums_matched"] != 2:
    failures.append("mm-engine-transcript: routing sums %r" % routing_oracle)

breached = json.loads(
    run([ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE,
         path("moe-model-transcript-perturbed.txt")]).stdout)
if breached["status"] != "ok" or breached["oracle"]["verdict"] != "FAIL":
    failures.append("mm-transcript-perturbed: status %r verdict %r"
                    % (breached["status"], breached["oracle"]["verdict"]))
if breached["oracle"]["worst_layer"] != 0 or breached["oracle"]["worst_node"] != "l_out":
    failures.append("mm-transcript-perturbed: worst %r in layer %d"
                    % (breached["oracle"]["worst_node"], breached["oracle"]["worst_layer"]))
if breached["routing_oracle"]["verdict"] != "MATCH":
    failures.append("mm-transcript-perturbed: a float breach moved the routing verdict")

mismatched = json.loads(
    run([ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE,
         path("moe-model-transcript-routing.txt")]).stdout)
if mismatched["status"] != "ok" or mismatched["routing_oracle"]["verdict"] != "MISMATCH":
    failures.append("mm-routing-mismatch: status %r routing %r"
                    % (mismatched["status"], mismatched["routing_oracle"]["verdict"]))
if mismatched["oracle"]["verdict"] == "-" or mismatched["oracle"]["elements_compared"] <= 0:
    failures.append("mm-routing-mismatch: oracle 2 was skipped: %r" % mismatched["oracle"])
if mismatched["routing_oracle"]["first_difference_layer"] != 1:
    failures.append("mm-routing-mismatch: the first difference names layer %d, not 1"
                    % mismatched["routing_oracle"]["first_difference_layer"])

# Section 3.7's logits table. At the reconciliation width the generator's pure-Python second
# implementation agrees with the engine to **zero ten-thousandths** and not bit-for-bit, exactly as
# `--model-forward`'s own synthetic case does, so the hosted verdict is `FAIL` with
# `max_abs_diff_ten_thousandths: 0` and `IDENTICAL` stays the real model's cell (section 6).
recon = json.loads(run([ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE, TRANSCRIPT, LOGITS]).stdout)
if recon["oracle_logits"]["compared_pass"] != "reconciliation":
    failures.append("mm-logits: compared_pass %r" % recon["oracle_logits"]["compared_pass"])
if recon["oracle_logits"]["max_abs_diff_ten_thousandths"] != 0:
    failures.append("mm-logits: %d ten-thousandths against the generator's own forward"
                    % recon["oracle_logits"]["max_abs_diff_ten_thousandths"])
if recon["oracle_logits"]["argmax_primary"] != recon["oracle_logits"]["argmax_reference"]:
    failures.append("mm-logits: argmax %d != %r"
                    % (recon["oracle_logits"]["argmax_primary"],
                       recon["oracle_logits"]["argmax_reference"]))
if recon["oracle_logits"]["tolerance_ten_thousandths"] != 5000:
    failures.append("mm-logits: the runtime bound was widened to %d"
                    % recon["oracle_logits"]["tolerance_ten_thousandths"])

within = json.loads(
    run([ARM, PACK, GEOM, TOKENS, RUNTIME, "-", SOURCE, "-",
         path("moe-model-logits-runtime.bin")]).stdout)
if within["oracle_logits"]["verdict"] != "WITHIN" \
        or within["oracle_logits"]["compared_pass"] != "runtime":
    failures.append("mm-logits-runtime-width: %r" % within["oracle_logits"])
if within["oracle_logits"]["top_k_set_agreement"] != 10:
    failures.append("mm-logits-runtime-width: top ten set agreement %d"
                    % within["oracle_logits"]["top_k_set_agreement"])
if within["oracle"]["verdict"] != "-":
    failures.append("mm-logits-runtime-width: `-` in the transcript position still ran oracle 2")

# The order clause is **reported, not required**: a reference whose ranks are permuted inside the
# top ten is `WITHIN` with `top_k_order_agreement < 10` and `top_k_set_agreement == 10`.
swapped = json.loads(
    run([ARM, PACK, GEOM, TOKENS, RUNTIME, "-", SOURCE, "-",
         path("moe-model-logits-order-swap.bin")]).stdout)
if swapped["oracle_logits"]["verdict"] != "WITHIN":
    failures.append("mm-logits-order-swap: verdict %r" % swapped["oracle_logits"]["verdict"])
if swapped["oracle_logits"]["top_k_set_agreement"] != 10 \
        or swapped["oracle_logits"]["top_k_order_agreement"] >= 10:
    failures.append("mm-logits-order-swap: set %d order %d -- the two are not distinguished"
                    % (swapped["oracle_logits"]["top_k_set_agreement"],
                       swapped["oracle_logits"]["top_k_order_agreement"]))

# A real failure is not `WITHIN`: a reference shifted by 1.0 keeps the argmax and the top ten and is
# still refused, so the tolerance alone cannot pass it.
shifted = json.loads(
    run([ARM, PACK, GEOM, TOKENS, RUNTIME, "-", SOURCE, "-",
         path("moe-model-logits-perturbed.bin")]).stdout)
if shifted["oracle_logits"]["verdict"] != "FAIL" \
        or shifted["oracle_logits"]["argmax_primary"] \
        != shifted["oracle_logits"]["argmax_reference"]:
    failures.append("mm-logits-perturbed-runtime: %r" % shifted["oracle_logits"])

# Both output forms emit byte-identical document bytes (section 3.3).
document_path = os.path.join(work_dir, "moe-model.json")
stdout_form = run([ARM, PACK, GEOM, TOKENS, WIDTH]).stdout.decode("utf-8").rstrip("\n")
run([ARM, PACK, GEOM, TOKENS, WIDTH, document_path])
with open(document_path, "r", encoding="utf-8") as handle:
    file_form = handle.read()
if normalize(stdout_form) != normalize(file_form):
    failures.append("mm-doc-stdout-identical: the stdout and file forms differ")
dash_form = run([ARM, PACK, GEOM, TOKENS, WIDTH, "-"]).stdout.decode("utf-8").rstrip("\n")
if normalize(dash_form) != normalize(stdout_form):
    failures.append("mm-doc-stdout-identical: the `-` form differs from the five-operand form")

repeats = {normalize(run([ARM, PACK, GEOM, TOKENS, WIDTH, "-", SOURCE, TRANSCRIPT, LOGITS])
                     .stdout.decode("utf-8")) for _ in range(3)}
if len(repeats) != 1:
    failures.append("three consecutive runs produced %d distinct documents" % len(repeats))

forced_documents = {}
for name, force, operands, expected in FORCED_CASES:
    build_shim(force)
    forced_documents[name] = record(name, operands, expected)

build_shim(None)

# `R5D_EXPERT_ID`'s detail names the exact `(layer, token, slot)`, and `R5E_CARRY`'s the exact
# carried input, because "an id is out of range", "two slots of one token name the same expert" and
# "a carried length disagrees" are three different bugs.
for case, wanted in (("mm-force-routing-id-range", "layer[0]token[0]slot[0]"),
                     ("mm-force-routing-id-repeat", "layer[0]token[0]slot[1]"),
                     ("mm-force-carry-short", "layer[0]input[ffn_norm]"),
                     ("mm-force-residual-short", "layer[0]")):
    document = forced_documents.get(case)
    if document is not None and document["error_detail"] != wanted:
        failures.append("%s: detail %r, not %r" % (case, document["error_detail"], wanted))

REQUIRED_CODES = {
    "R5_TOKENS", "R5_KV_WIDTH", "R5_GEOMETRY_UNREADABLE", "R5_GEOMETRY", "R4_PACK_UNREADABLE",
    "R4_PACK_TRUNCATED", "R5_BLOCK_MISSING", "R5_BLOCK_AMBIGUOUS", "R5_LAYER_COVERAGE",
    "R5_MEMBER_MISSING", "R5_SHAPE", "R5_GGML_UNAVAILABLE", "R5_TYPE_UNSUPPORTED",
    "R5_ALIGNMENT", "R5_GGML_INIT", "R5_SLOT", "R5_ALLOC", "R5_COMPUTE", "R5_RESIDUAL",
    "R5_SOURCE_UNREADABLE", "R5_SOURCE_DIVERGED", "R5_REFERENCE_MISMATCH", "R5_TRANSCRIPT",
    "R5_ORACLE_MISSING", "R5_ORACLE_SHAPE", "R2_EXPERT_ID_NOT_INTEGRAL", "R4_5_SLICE",
    "R5_LOGITS_SHAPE", "R5_LOGITS_UNREADABLE", "R5_LOGITS_NONFINITE",
    "R5D_ROUTER_SHAPE", "R5D_EXPERT_ID", "R5D_CLAIM_MISSING", "R5E_CARRY",
}
missing_codes = REQUIRED_CODES - codes
if missing_codes:
    failures.append("codes never reached: %s" % ", ".join(sorted(missing_codes)))

ORDER = ([name for name, _, _ in STUB_CASES]
         + [name for name, _, _ in ENGINE_CASES]
         + [name for name, _, _, _ in FORCED_CASES])

if update:
    with open(golden_path, "w", encoding="utf-8") as handle:
        for name in ORDER:
            handle.write(json.dumps({"case": name, "document": produced[name]},
                                    separators=(",", ":"), ensure_ascii=False) + "\n")
    print("moe model forward smoke: golden rewritten with %d cases" % len(produced))
else:
    with open(golden_path, "r", encoding="utf-8") as handle:
        golden = [json.loads(line) for line in handle if line.strip()]
    if [row["case"] for row in golden] != ORDER:
        failures.append("the golden case list does not match the runner's case list")
    else:
        for row in golden:
            if produced.get(row["case"]) != row["document"]:
                failures.append("golden mismatch for %s: %s"
                                % (row["case"],
                                   describe_difference(row["document"],
                                                       produced.get(row["case"]))))

if failures:
    for line in failures:
        sys.stderr.write("moe model forward smoke: FAIL %s\n" % line)
    raise SystemExit(1)

print("moe model forward smoke: %d no-document cases (R5E_ARITY, R5E_PATH), %d documented cases, "
      "%d codes reached, all four oracles, the routing identity element-wise complete over a whole "
      "model, and arm-r5a/r5b/r5d-unchanged PASS"
      % (len(NO_DOCUMENT), len(ORDER), len(codes - {""}) + 2))
PY
