#!/usr/bin/env bash
set -euo pipefail

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)

python3 - "${root_dir}" <<'PY'
import importlib.util
import os
import pathlib
import subprocess
import sys
import tempfile

root = pathlib.Path(sys.argv[1])
path = root / "scripts" / "gpu_backend_recipe.py"
spec = importlib.util.spec_from_file_location("gpu_backend_recipe", path)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)

metal = module.plan("metal")
cuda = module.plan("cuda")

assert metal["ggml_commit"] == "bb4caa7540188872173c44d161602d9271386413"
assert metal["target"] == {"os": "macos", "arch": "aarch64", "gpu_architectures": ["apple_m1"]}
assert cuda["target"] == {"os": "linux", "arch": "x86_64", "gpu_architectures": ["sm_89"]}
assert metal["build_argv_suffix"] == ["--target", "ggml", "--parallel", "4"]
assert cuda["build_argv_suffix"] == metal["build_argv_suffix"]

metal_flags = metal["configure_flags"]
cuda_flags = cuda["configure_flags"]
for required in (
    "-DBUILD_SHARED_LIBS=ON",
    "-DGGML_BACKEND_DL=ON",
    "-DGGML_NATIVE=OFF",
    "-DGGML_CPU=OFF",
    "-DGGML_BLAS=OFF",
    "-DGGML_OPENMP=OFF",
):
    assert required in metal_flags and required in cuda_flags
assert "-DGGML_METAL=ON" in metal_flags
assert "-DGGML_METAL_EMBED_LIBRARY=ON" in metal_flags
assert "-DCMAKE_INSTALL_RPATH=@loader_path" in metal_flags
assert "-DGGML_CUDA=ON" in cuda_flags
assert "-DGGML_CUDA_GRAPHS=ON" in cuda_flags
assert "-DGGML_CUDA_FA=ON" in cuda_flags
assert "-DGGML_CUDA_FORCE_MMQ=OFF" in cuda_flags
assert "-DGGML_CUDA_FORCE_CUBLAS=OFF" in cuda_flags
assert "-DGGML_CUDA_NCCL=OFF" in cuda_flags
assert "-DCMAKE_CUDA_ARCHITECTURES=89" in cuda_flags
assert "-DCMAKE_INSTALL_RPATH=$ORIGIN" in cuda_flags
assert len(metal_flags) == len(set(metal_flags))
assert len(cuda_flags) == len(set(cuda_flags))

with tempfile.TemporaryDirectory(prefix="gpu-backend-recipe-smoke-") as raw_temporary:
    temporary = pathlib.Path(raw_temporary)
    driver = temporary / "driver"
    driver.write_text('#!/bin/sh\nprintf "%s\\n" "${0##*/}"\n')
    driver.chmod(0o755)
    alias = temporary / "cc"
    alias.symlink_to(driver)
    original_path = os.environ.get("PATH", "")
    os.environ["PATH"] = str(temporary) + os.pathsep + original_path
    try:
        for selection in ("cc", str(alias)):
            admitted = module.resolve_executable(selection, "CC")
            assert subprocess.check_output([admitted, "--version"]) == b"cc\n"
    finally:
        os.environ["PATH"] = original_path
    executable = str(pathlib.Path(sys.executable).resolve())
    fake_tools = {
        "git": executable,
        "cmake": executable,
        "ninja": executable,
        "cc": executable,
        "cxx": executable,
        "platform": executable,
    }
    environment = module.isolated_environment(fake_tools, temporary / "environment")
    assert set(environment) == {
        "CC", "CXX", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_NOSYSTEM", "GIT_GRAFT_FILE",
        "GIT_NO_REPLACE_OBJECTS", "GIT_OPTIONAL_LOCKS", "GIT_PAGER", "GIT_TERMINAL_PROMPT",
        "HOME", "LC_ALL", "PATH", "TMPDIR", "TZ",
    }
    for rejected_name in ("CFLAGS", "CXXFLAGS", "LDFLAGS", "CMAKE_TOOLCHAIN_FILE", "GIT_DIR"):
        assert rejected_name not in environment

    publication = temporary / "publication"
    publication.mkdir()
    stage = publication / "stage"
    stage.mkdir()
    (stage / "marker").write_text("candidate")
    destination = publication / "result"
    module.rename_noreplace(stage, destination)
    assert not stage.exists() and (destination / "marker").read_text() == "candidate"

    occupied_stage = publication / "occupied-stage"
    occupied_stage.mkdir()
    (occupied_stage / "marker").write_text("candidate")
    occupied = publication / "occupied"
    occupied.mkdir()
    (occupied / "marker").write_text("existing")
    try:
        module.rename_noreplace(occupied_stage, occupied)
    except module.RecipeError as error:
        assert "occupied" in str(error)
    else:
        raise AssertionError("atomic publication replaced an occupied destination")
    assert (occupied / "marker").read_text() == "existing"
    assert (occupied_stage / "marker").read_text() == "candidate"

    source_root = temporary / "source"
    source_root.mkdir()
    try:
        module.build("metal", source_root, source_root / "output")
    except module.RecipeError as error:
        assert "outside the source checkout" in str(error)
    else:
        raise AssertionError("an output inside the source checkout was accepted")

    artifacts_root = temporary / "artifacts"
    artifacts_root.mkdir()
    first = artifacts_root / "first"
    second = artifacts_root / "second"
    first.write_bytes(b"abc")
    second.write_bytes(b"def")
    retained = temporary / "retained"
    retained.mkdir()
    original_bound = module.MAX_BUNDLE_ARTIFACT_BYTES
    module.MAX_BUNDLE_ARTIFACT_BYTES = 5
    try:
        module.copy_artifacts([
            ("shared_library", "first", first),
            ("shared_library", "second", second),
        ], retained)
    except module.RecipeError as error:
        assert "aggregate exceeds" in str(error)
    else:
        raise AssertionError("an oversized artifact aggregate was accepted")
    finally:
        module.MAX_BUNDLE_ARTIFACT_BYTES = original_bound

    oversized = artifacts_root / "oversized"
    oversized.write_bytes(b"123456")
    per_artifact = temporary / "per-artifact"
    per_artifact.mkdir()
    module.MAX_BUNDLE_ARTIFACT_BYTES = 5
    try:
        module.copy_artifacts([
            ("shared_library", "oversized", oversized),
        ], per_artifact)
    except module.RecipeError as error:
        assert "size is outside" in str(error)
    else:
        raise AssertionError("an oversized artifact was accepted")
    finally:
        module.MAX_BUNDLE_ARTIFACT_BYTES = original_bound

    repository = temporary / "repository"
    repository.mkdir()
    git = module.resolve_executable("git", "git")

    def run_git(*arguments):
        return subprocess.run(
            [git, *arguments], cwd=repository, check=True,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        ).stdout
    run_git("init", "-q")
    run_git("config", "user.name", "GPU Recipe")
    run_git("config", "user.email", "gpu-recipe@example.invalid")
    run_git("remote", "add", "origin", module.GGML_REPOSITORY)
    (repository / "source.txt").write_text("safe\n")
    run_git("add", "source.txt")
    run_git("commit", "-q", "-m", "safe")
    safe_commit = run_git("rev-parse", "HEAD").decode().strip()
    original_commit = module.GGML_COMMIT
    module.GGML_COMMIT = safe_commit
    marker = temporary / "fsmonitor-ran"
    fsmonitor = temporary / "fsmonitor"
    fsmonitor.write_text(f"#!/bin/sh\ntouch '{marker}'\nexit 0\n")
    fsmonitor.chmod(0o755)
    run_git("config", "core.fsmonitor", str(fsmonitor))
    source_environment = module.isolated_environment(fake_tools, temporary / "source-environment")
    try:
        module.require_source(repository, git, source_environment)
        assert not marker.exists()
        (repository / "source.txt").write_text("replacement\n")
        run_git("add", "source.txt")
        run_git("commit", "-q", "-m", "replacement")
        replacement = run_git("rev-parse", "HEAD").decode().strip()
        run_git("reset", "--hard", safe_commit)
        run_git("replace", safe_commit, replacement)
        marker.unlink(missing_ok=True)
        try:
            module.require_source(repository, git, source_environment)
        except module.RecipeError as error:
            assert "replacement refs" in str(error)
        else:
            raise AssertionError("a Git replacement ref was accepted")
        assert not marker.exists()
    finally:
        module.GGML_COMMIT = original_commit

print("gpu backend recipe smoke: PASS")
PY
