#!/usr/bin/env python3
"""Focused owner regression for the hosted Align compiler bundle."""

from __future__ import annotations

import hashlib
import importlib.machinery
import importlib.util
import json
import os
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path
from types import ModuleType


REPOSITORY = Path(__file__).resolve().parent.parent
HELPER = REPOSITORY / "scripts/ci-align-bundle"
BASE_ENVIRONMENT = {
    "PATH": "/usr/bin:/bin",
    "LANG": "C",
    "LC_ALL": "C",
    "PYTHONDONTWRITEBYTECODE": "1",
}
sys.dont_write_bytecode = True


def require(condition: bool, message: str) -> None:
    if not condition:
        raise RuntimeError(message)


def load_helper() -> ModuleType:
    loader = importlib.machinery.SourceFileLoader("align_llm_ci_align_bundle_test", str(HELPER))
    specification = importlib.util.spec_from_loader(loader.name, loader)
    if specification is None:
        raise RuntimeError("cannot load ci-align-bundle")
    module = importlib.util.module_from_spec(specification)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


def run(*arguments: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        (sys.executable, str(HELPER), *arguments),
        cwd=REPOSITORY,
        env=BASE_ENVIRONMENT,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=30,
        check=False,
    )


def run_raw(*arguments: str) -> subprocess.Popen[str]:
    return subprocess.Popen(
        (sys.executable, str(HELPER), *arguments),
        cwd=REPOSITORY,
        env=BASE_ENVIRONMENT,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )


def git(repository: Path, *arguments: str) -> str:
    result = subprocess.run(
        ("/usr/bin/git", "-C", str(repository), *arguments),
        env=BASE_ENVIRONMENT,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=True,
    )
    return result.stdout.strip()


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for block in iter(lambda: source.read(65_536), b""):
            digest.update(block)
    return digest.hexdigest()


def write_sources(root: Path, align_repository: Path, marker: Path) -> Path:
    source = root / "native-source"
    source.mkdir()
    llvm_c = source / "llvm.c"
    llvm_c.write_text("int llvm_stub(void) { return 0; }\n", encoding="ascii")
    llvm = source / "libLLVM.so.22.1"
    subprocess.run(
        (
            "/usr/bin/cc",
            "-shared",
            "-fPIC",
            "-Wl,-soname,libLLVM.so.22.1",
            "-o",
            str(llvm),
            str(llvm_c),
        ),
        env=BASE_ENVIRONMENT,
        check=True,
    )
    compiler_c = source / "alignc.c"
    marker_literal = json.dumps(str(marker))
    compiler_c.write_text(
        "#include <stdio.h>\n"
        "extern int llvm_stub(void);\n"
        "int main(int argc, char **argv) {\n"
        f"  FILE *marker = fopen({marker_literal}, \"a\");\n"
        "  if (marker != NULL) fclose(marker);\n"
        "  if (llvm_stub() != 0 || argc != 2) return 2;\n"
        "  puts(\"alignc 0.0.0-test\");\n"
        "  return 0;\n"
        "}\n",
        encoding="ascii",
    )
    release = align_repository / "target/release"
    release.mkdir(parents=True)
    subprocess.run(
        (
            "/usr/bin/cc",
            "-o",
            str(release / "alignc"),
            str(compiler_c),
            "-L",
            str(source),
            "-Wl,--no-as-needed",
            "-l:libLLVM.so.22.1",
        ),
        env=BASE_ENVIRONMENT,
        check=True,
    )
    (release / "libalign_runtime.a").write_bytes(b"deterministic test runtime archive\n")
    return llvm


def common(directory: Path, revision: str) -> list[str]:
    return [
        "--directory",
        str(directory),
        "--align-revision",
        revision,
        "--image-version",
        "20260720.247.2",
        "--runner-os",
        "Linux",
        "--runner-arch",
        "X64",
        "--rust-version",
        "1.96.0",
        "--llvm-major",
        "22",
    ]


def create_arguments(directory: Path, revision: str, repository: Path, llvm: Path) -> list[str]:
    return [
        "create",
        *common(directory, revision),
        "--align-repo",
        str(repository),
        "--llvm-library",
        str(llvm),
    ]


def replace_option(arguments: list[str], option: str, value: str) -> list[str]:
    changed = list(arguments)
    changed[changed.index(option) + 1] = value
    return changed


def expected_manifest(bundle: Path, revision: str) -> bytes:
    files = []
    for name, mode in (
        ("alignc", 0o755),
        ("libalign_runtime.a", 0o644),
        ("libLLVM.so.22.1", 0o644),
    ):
        path = bundle / name
        files.append(
            {
                "name": name,
                "size": path.stat().st_size,
                "mode": mode,
                "sha256": sha256(path),
            }
        )
    value = {
        "schema_version": 1,
        "align_revision": revision,
        "image_version": "20260720.247.2",
        "runner_os": "Linux",
        "runner_arch": "X64",
        "rust_version": "1.96.0",
        "llvm_major": 22,
        "bundle_bytes": sum(item["size"] for item in files),
        "files": files,
    }
    return (json.dumps(value, separators=(",", ":")) + "\n").encode("ascii")


def copy_bundle(source: Path, root: Path, name: str) -> Path:
    target = root / name
    shutil.copytree(source, target)
    return target


def require_rejected_before_execution(
    directory: Path,
    revision: str,
    marker: Path,
    message: str,
) -> None:
    marker.unlink(missing_ok=True)
    result = run("verify", *common(directory, revision))
    require(result.returncode == 1 and result.stderr.startswith("ci-align-bundle:"), message)
    require(not marker.exists(), message + " executed the rejected compiler")


def test_bundle() -> None:
    helper = load_helper()
    with tempfile.TemporaryDirectory(prefix="align-llm-ci-bundle-") as temporary:
        root = Path(temporary)
        align_repository = root / "align"
        align_repository.mkdir()
        git(align_repository, "init", "-q")
        git(align_repository, "config", "user.email", "owner@example.invalid")
        git(align_repository, "config", "user.name", "Bundle Owner")
        (align_repository / ".gitignore").write_text("/target/\n", encoding="ascii")
        (align_repository / "README.md").write_text("fixture\n", encoding="ascii")
        git(align_repository, "add", ".gitignore", "README.md")
        git(align_repository, "commit", "-q", "-m", "Create exact fixture")
        revision = git(align_repository, "rev-parse", "HEAD")
        marker = root / "executed"
        llvm = write_sources(root, align_repository, marker)
        bundle = root / "bundle"

        key = run("key", *common(bundle, revision))
        expected_key = (
            f"path={bundle}\n"
            f"key=hosted-align-bundle-g1-{revision}-20260720.247.2-"
            "Linux-X64-rust-1.96.0-llvm-22\n"
        )
        require(
            key.returncode == 0 and key.stdout == expected_key and not key.stderr,
            "cache identity output changed",
        )
        require(not bundle.exists(), "key mode touched the bundle path")

        created = run(*create_arguments(bundle, revision, align_repository, llvm))
        bundle_bytes = sum(
            (bundle / name).stat().st_size
            for name in ("alignc", "libalign_runtime.a", "libLLVM.so.22.1")
        )
        require(
            created.returncode == 0
            and created.stdout == f"created bundle: {bundle} ({bundle_bytes} bytes)\n"
            and not created.stderr,
            "bundle creation failed",
        )
        require(
            {entry.name for entry in bundle.iterdir()}
            == {"alignc", "libalign_runtime.a", "libLLVM.so.22.1", "manifest.json"},
            "bundle inventory changed",
        )
        require(
            stat.S_IMODE((bundle / "alignc").stat().st_mode) == 0o755
            and stat.S_IMODE((bundle / "libalign_runtime.a").stat().st_mode) == 0o644
            and stat.S_IMODE((bundle / "libLLVM.so.22.1").stat().st_mode) == 0o644,
            "bundle modes changed",
        )
        require(
            (bundle / "manifest.json").read_bytes() == expected_manifest(bundle, revision),
            "semantic-to-byte manifest golden changed",
        )
        marker.unlink(missing_ok=True)
        verified = run("verify", *common(bundle, revision))
        require(
            verified.returncode == 0
            and verified.stdout == f"verified bundle: {bundle} ({bundle_bytes} bytes)\n"
            and not verified.stderr
            and marker.exists(),
            "complete bundle verification failed",
        )

        spaced = copy_bundle(bundle, root, "bundle with space")
        marker.unlink(missing_ok=True)
        spaced_result = run("verify", *common(spaced, revision))
        require(
            spaced_result.returncode == 0 and marker.exists(),
            "supported line-safe bundle path failed loader admission",
        )

        extra = copy_bundle(bundle, root, "invalid-extra")
        (extra / "unexpected").write_bytes(b"caller owned")
        require_rejected_before_execution(extra, revision, marker, "extra entry was accepted")

        symlink = copy_bundle(bundle, root, "invalid-symlink")
        (symlink / "alignc").unlink()
        (symlink / "alignc").symlink_to(bundle / "alignc")
        require_rejected_before_execution(symlink, revision, marker, "symlink was accepted")

        wrong_mode = copy_bundle(bundle, root, "invalid-mode")
        (wrong_mode / "alignc").chmod(0o700)
        require_rejected_before_execution(wrong_mode, revision, marker, "wrong mode was accepted")

        wrong_manifest_mode = copy_bundle(bundle, root, "invalid-manifest-mode")
        (wrong_manifest_mode / "manifest.json").chmod(0o600)
        require_rejected_before_execution(
            wrong_manifest_mode,
            revision,
            marker,
            "wrong manifest mode was accepted",
        )

        corrupt = copy_bundle(bundle, root, "invalid-checksum")
        with (corrupt / "libalign_runtime.a").open("ab") as target:
            target.write(b"corruption")
        require_rejected_before_execution(corrupt, revision, marker, "corrupt bytes were accepted")

        trailing = copy_bundle(bundle, root, "invalid-trailing")
        with (trailing / "manifest.json").open("ab") as target:
            target.write(b"\n")
        require_rejected_before_execution(trailing, revision, marker, "trailing data was accepted")

        duplicate = copy_bundle(bundle, root, "invalid-duplicate")
        raw = (duplicate / "manifest.json").read_text(encoding="ascii")
        raw = raw.replace('{"schema_version":1,', '{"schema_version":1,"schema_version":1,', 1)
        (duplicate / "manifest.json").write_text(raw, encoding="ascii")
        require_rejected_before_execution(duplicate, revision, marker, "duplicate field was accepted")

        reordered = copy_bundle(bundle, root, "invalid-order")
        value = json.loads((reordered / "manifest.json").read_bytes())
        reordered_value = {"align_revision": value["align_revision"], "schema_version": 1}
        reordered_value.update({key: item for key, item in value.items() if key not in reordered_value})
        (reordered / "manifest.json").write_text(
            json.dumps(reordered_value, separators=(",", ":")) + "\n",
            encoding="ascii",
        )
        require_rejected_before_execution(reordered, revision, marker, "reordered fields were accepted")

        oversized = copy_bundle(bundle, root, "invalid-oversized")
        (oversized / "manifest.json").write_bytes(b" " * (helper.MAX_MANIFEST_BYTES + 1))
        require_rejected_before_execution(oversized, revision, marker, "oversized manifest was accepted")

        loader_failure = copy_bundle(bundle, root, "invalid-loader")
        shutil.copyfile("/bin/true", loader_failure / "alignc")
        (loader_failure / "alignc").chmod(0o755)
        (loader_failure / "manifest.json").write_bytes(expected_manifest(loader_failure, revision))
        require_rejected_before_execution(
            loader_failure,
            revision,
            marker,
            "compiler without the admitted LLVM dependency was accepted",
        )

        wrong_identity = run("verify", *common(bundle, "f" * 40))
        require(wrong_identity.returncode == 1, "wrong manifest identity was accepted")

        invalid_arguments = (
            ["key", *common(Path("relative"), revision)],
            ["key", *common(root / "bad:path", revision)],
            replace_option(["key", *common(root / "invalid-revision", revision)], "--align-revision", "A" * 40),
            replace_option(["key", *common(root / "invalid-token", revision)], "--runner-os", "Linux/bad"),
            replace_option(["key", *common(root / "long-token", revision)], "--runner-os", "L" * 65),
            replace_option(["key", *common(root / "zero-major", revision)], "--llvm-major", "0"),
            replace_option(["key", *common(root / "wide-major", revision)], "--llvm-major", "65536"),
            replace_option(["key", *common(root / "noncanonical-major", revision)], "--llvm-major", "022"),
            ["key", *common(root / "create-only", revision), "--align-repo", str(align_repository)],
            ["create", *common(root / "missing-source-options", revision)],
        )
        for arguments in invalid_arguments:
            invalid = run(*arguments)
            require(
                invalid.returncode == 2
                and not invalid.stdout
                and invalid.stderr.startswith("ci-align-bundle:"),
                f"invalid arguments escaped usage failure: {arguments}",
            )

        existing_directory = root / "existing-directory"
        existing_directory.mkdir()
        caller_file = existing_directory / "caller"
        caller_file.write_bytes(b"retain")
        existing_file = root / "existing-file"
        existing_file.write_bytes(b"retain")
        dangling = root / "existing-dangling"
        dangling.symlink_to("missing")
        for existing in (existing_directory, existing_file, dangling):
            collision = run(*create_arguments(existing, revision, align_repository, llvm))
            require(collision.returncode == 1, f"existing target was accepted: {existing.name}")
        require(
            caller_file.read_bytes() == b"retain"
            and existing_file.read_bytes() == b"retain"
            and dangling.is_symlink(),
            "existing caller-owned target was changed",
        )

        dirty_target = root / "dirty-target"
        dirty = align_repository / "dirty"
        dirty.write_bytes(b"untracked")
        dirty_result = run(*create_arguments(dirty_target, revision, align_repository, llvm))
        require(
            dirty_result.returncode == 1 and not dirty_target.exists(),
            "dirty Align checkout was accepted",
        )
        dirty.unlink()

        wrong_revision_target = root / "wrong-revision-target"
        wrong_revision = run(
            *create_arguments(wrong_revision_target, "f" * 40, align_repository, llvm)
        )
        require(
            wrong_revision.returncode == 1 and not wrong_revision_target.exists(),
            "create accepted the wrong external checkout identity",
        )

        wrong_llvm = root / "libLLVM-wrong-name.so"
        shutil.copyfile(llvm, wrong_llvm)
        wrong_llvm_target = root / "wrong-llvm-target"
        wrong_llvm_result = run(
            *create_arguments(wrong_llvm_target, revision, align_repository, wrong_llvm)
        )
        require(
            wrong_llvm_result.returncode == 1 and not wrong_llvm_target.exists(),
            "create accepted the wrong LLVM SONAME filename",
        )

        compiler = align_repository / "target/release/alignc"
        real_compiler = compiler.with_name("alignc.real")
        compiler.rename(real_compiler)
        compiler.symlink_to(real_compiler.name)
        symlink_target = root / "source-symlink-target"
        source_symlink = run(*create_arguments(symlink_target, revision, align_repository, llvm))
        require(
            source_symlink.returncode == 1 and not symlink_target.exists(),
            "symlink source was accepted",
        )
        compiler.unlink()
        real_compiler.rename(compiler)

        race_target = root / "race"
        race_arguments = create_arguments(race_target, revision, align_repository, llvm)
        first = run_raw(*race_arguments)
        second = run_raw(*race_arguments)
        first_output = first.communicate(timeout=30)
        second_output = second.communicate(timeout=30)
        require(
            sorted((first.returncode, second.returncode)) == [0, 1],
            f"concurrent create result changed: {first_output!r} {second_output!r}",
        )
        race_verify = run("verify", *common(race_target, revision))
        require(race_verify.returncode == 0, "concurrent create did not leave one valid target")
        require(
            not list(root.glob(".race.staging-*")),
            "concurrent create left an owned staging directory",
        )

        injected_target = root / "injected-failure"
        identity = helper.Identity(
            directory=injected_target,
            align_revision=revision,
            image_version="20260720.247.2",
            runner_os="Linux",
            runner_arch="X64",
            rust_version="1.96.0",
            llvm_major=22,
        )
        original_copyfile = helper.shutil.copyfile
        copy_count = 0

        def fail_second_copy(*arguments: object, **keywords: object) -> object:
            nonlocal copy_count
            copy_count += 1
            if copy_count == 2:
                raise OSError("injected copy failure")
            return original_copyfile(*arguments, **keywords)

        helper.shutil.copyfile = fail_second_copy
        try:
            try:
                helper.create_bundle(identity, str(align_repository), str(llvm))
            except OSError as error:
                require(str(error) == "injected copy failure", "copy failure changed")
            else:
                raise RuntimeError("injected copy failure was ignored")
        finally:
            helper.shutil.copyfile = original_copyfile
        require(
            not injected_target.exists() and not list(root.glob(".injected-failure.staging-*")),
            "partial bundle cleanup failed",
        )

        cleanup_target = root / "cleanup-failure"
        cleanup_identity = helper.Identity(
            directory=cleanup_target,
            align_revision=revision,
            image_version="20260720.247.2",
            runner_os="Linux",
            runner_arch="X64",
            rust_version="1.96.0",
            llvm_major=22,
        )
        original_rmtree = helper.shutil.rmtree

        def fail_copy(*arguments: object, **keywords: object) -> object:
            raise OSError("injected construction failure")

        def fail_cleanup(*arguments: object, **keywords: object) -> object:
            raise OSError("injected cleanup failure")

        helper.shutil.copyfile = fail_copy
        helper.shutil.rmtree = fail_cleanup
        try:
            try:
                helper.create_bundle(cleanup_identity, str(align_repository), str(llvm))
            except helper.BundleError as error:
                require(str(error) == "bundle staging cleanup failed", "cleanup failure changed")
            else:
                raise RuntimeError("injected cleanup failure was ignored")
        finally:
            helper.shutil.copyfile = original_copyfile
            helper.shutil.rmtree = original_rmtree
        cleanup_stages = list(root.glob(".cleanup-failure.staging-*"))
        require(
            not cleanup_target.exists() and len(cleanup_stages) == 1,
            "cleanup failure established a target or lost its owned diagnostic state",
        )
        original_rmtree(cleanup_stages[0])


def main() -> int:
    test_bundle()
    require(not (REPOSITORY / "scripts/__pycache__").exists(), "bundle owner created bytecode")
    print("scripts/test-ci-align-bundle: all cases passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
