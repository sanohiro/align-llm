#!/usr/bin/env python3
"""Verify G1 candidate linking through one authenticated absolute C driver."""

from __future__ import annotations

import hashlib
import json
import os
import pathlib
import stat
import subprocess
import sys
import tempfile


ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "scripts"))

import gpu_qualification_run as qualification_run  # noqa: E402


def executable(argument: str, label: str) -> pathlib.Path:
    path = pathlib.Path(argument)
    try:
        resolved = path.resolve(strict=True)
        metadata = resolved.stat()
    except OSError as error:
        raise AssertionError(f"{label} is unavailable") from error
    if not resolved.is_absolute() or not stat.S_ISREG(metadata.st_mode) \
            or not os.access(resolved, os.X_OK):
        raise AssertionError(f"{label} is not an absolute executable")
    return resolved


def digest_token(name: str, path: pathlib.Path) -> str:
    return f"<{name}>:sha256:{hashlib.sha256(path.read_bytes()).hexdigest()}"


def build_driver_proxy(
    compiler: pathlib.Path,
    source: pathlib.Path,
    proxy: pathlib.Path,
    marker: pathlib.Path,
    library_root: pathlib.Path,
) -> None:
    compiler_literal = json.dumps(str(compiler))
    marker_literal = json.dumps(str(marker))
    library_literal = json.dumps(str(library_root))
    source.write_text(
        "#include <errno.h>\n"
        "#include <fcntl.h>\n"
        "#include <stdlib.h>\n"
        "#include <string.h>\n"
        "#include <unistd.h>\n"
        "extern char **environ;\n"
        "int main(int argc, char **argv) {\n"
        "  int count = 0;\n"
        f"  int fd = open({marker_literal}, O_WRONLY | O_CREAT | O_APPEND, 0600);\n"
        "  if (fd < 0) return 92;\n"
        "  while (environ[count] != 0) {\n"
        "    size_t length = strlen(environ[count]);\n"
        "    if (write(fd, environ[count], length) != (ssize_t) length ||\n"
        "        write(fd, \"\\n\", 1) != 1) return 92;\n"
        "    count += 1;\n"
        "  }\n"
        "  if (close(fd) != 0) return 92;\n"
        "  if (getenv(\"HOME\") == 0 || getenv(\"TMPDIR\") == 0 ||\n"
        "      getenv(\"LC_ALL\") == 0 || strcmp(getenv(\"LC_ALL\"), \"C\") != 0 ||\n"
        "      getenv(\"TZ\") == 0 || strcmp(getenv(\"TZ\"), \"UTC\") != 0 ||\n"
        "      getenv(\"PATH\") != 0 || getenv(\"CC\") != 0 ||\n"
        "      getenv(\"LIBRARY_PATH\") != 0 || getenv(\"DYLD_LIBRARY_PATH\") != 0 ||\n"
        "      getenv(\"LD_LIBRARY_PATH\") != 0) return 91;\n"
        "  char **selected = calloc((size_t) argc + 8, sizeof(char *));\n"
        "  if (selected == 0) return 94;\n"
        "  for (int at = 0; at < argc; at++) selected[at] = argv[at];\n"
        f"  selected[0] = (char *) {compiler_literal};\n"
        "  selected[argc] = (char *) \"-L\";\n"
        f"  selected[argc + 1] = (char *) {library_literal};\n"
        "  selected[argc + 2] = (char *) \"-Xlinker\";\n"
        "  selected[argc + 3] = (char *) \"-rpath\";\n"
        "  selected[argc + 4] = (char *) \"-Xlinker\";\n"
        f"  selected[argc + 5] = (char *) {library_literal};\n"
        "  selected[argc + 6] = (char *) \"-B/usr/bin\";\n"
        f"  execv({compiler_literal}, selected);\n"
        "  return errno == 0 ? 93 : errno;\n"
        "}\n",
        encoding="utf-8",
    )
    completed = subprocess.run(
        [str(compiler), str(source), "-o", str(proxy)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if completed.returncode != 0:
        raise AssertionError(completed.stderr.decode(errors="replace"))


def main() -> None:
    if len(sys.argv) != 3:
        raise SystemExit("usage: run-gpu-explicit-driver-smoke ALIGNC CC")
    alignc = executable(sys.argv[1], "managed Align compiler")
    cc = executable(sys.argv[2], "C compiler")
    copier = executable("/bin/cp", "fixture copier")

    with tempfile.TemporaryDirectory(prefix="gpu-explicit-driver-") as raw_temporary:
        temporary = pathlib.Path(raw_temporary)
        home = temporary / "home"
        scratch = temporary / "scratch"
        home.mkdir(mode=0o700)
        scratch.mkdir(mode=0o700)
        state = qualification_run.PreparationState(
            pathlib.Path(__file__), name="gpu-runtime-qualify", version="fixture",
        )
        runtime = alignc.parent / "libalign_runtime.a"
        copied_compiler = scratch / "alignc"
        copied_runtime = scratch / "libalign_runtime.a"
        compiler_token = digest_token("compiler-input", alignc)
        runtime_token = digest_token("runtime-input", runtime)
        copier_token = digest_token("copy-tool", copier)
        commands = []
        for original, token, copied, name in (
            (alignc, compiler_token, copied_compiler, "alignc"),
            (runtime, runtime_token, copied_runtime, "align-runtime"),
        ):
            commands.append(qualification_run.PreparationCommand(
                (str(copier), str(original), copied.name),
                (copier_token, token, copied.name),
                {copier_token: copier, token: original}, copied, name, "fixture",
            ))

        proxy_source = scratch / "driver.c"
        proxy = scratch / "selected-cc"
        marker = scratch / "selected-cc.invoked"
        build_driver_proxy(cc, proxy_source, proxy, marker, scratch)
        selected_token = digest_token("selected-driver", proxy)

        shim_source = ROOT / "scripts" / "ggml_shim_stub.c"
        shim_token = digest_token("shim-source", shim_source)
        cc_token = selected_token
        suffix = "dylib" if sys.platform == "darwin" else "so"
        shim = scratch / f"libalign_ggml_shim.{suffix}"
        shim_flags = [
            "-shared", "-fPIC", "-O2", "-ffp-contract=off", "-DALIGN_GGML_FP_CONTRACT_OFF=1",
            "-Wall", "-Wextra", "-Werror",
        ]
        if sys.platform == "darwin":
            shim_flags.extend(["-Xlinker", "-install_name", "-Xlinker", f"@rpath/{shim.name}"])
        else:
            shim_flags.append("-B/usr/bin")
        commands.append(qualification_run.PreparationCommand(
            tuple([str(proxy), *shim_flags, str(shim_source), "-o", shim.name, "-lm"]),
            tuple([cc_token, *shim_flags, shim_token, "-o", shim.name, "-lm"]),
            {cc_token: proxy, shim_token: shim_source}, shim, "align-ggml-shim", "fixture",
        ))

        # The copied compiler has the admitted source digest; its adjacent archive is materialized
        # before either real Align invocation. Both candidates actually call the newly built shim.
        copied_token = digest_token("align-compiler", alignc)
        source_text = (
            'extern "C" link("align_ggml_shim") { fn align_ggml_available() -> i32 }\n'
            'fn main() { unsafe { print(align_ggml_available()) } }\n'
        )
        for name in ("candidate", "cpu_reference"):
            source = scratch / f"{name}.align"
            source.write_text(source_text, encoding="utf-8")
            source_token = digest_token(f"{name.replace('_', '-')}-source", source)
            commands.append(qualification_run.PreparationCommand(
                (str(copied_compiler), "build", str(source), "--profile", "dev", "--cc", str(proxy)),
                (copied_token, "build", source_token, "--profile", "dev", "--cc", selected_token),
                {copied_token: copied_compiler, source_token: source, selected_token: proxy},
                scratch / name, name.replace("_", "-"), "fixture",
            ))
        qualification_run.run_preparation(state, commands, cwd=scratch, home=home, temporary=scratch)
        assert state.complete, (
            state.failure_ordinal, state.failure_detail,
            state.failed_result.stderr.retained.decode(errors="replace") if state.failed_result else "unstarted",
        )
        assert state.identities["align_compiler"]["sha256"] == hashlib.sha256(alignc.read_bytes()).hexdigest()
        assert state.identities["align_runtime"]["sha256"] == hashlib.sha256(runtime.read_bytes()).hexdigest()
        assert all(identity["state"] == "available" for identity in state.identities.values())
        assert all(command["environment"] == [
            "HOME=<home>:owned", "LC_ALL=C", "TMPDIR=<tmp>:owned", "TZ=UTC",
        ] for command in state.commands)
        marker_environment = marker.read_text(encoding="utf-8").splitlines()
        names = [entry.split("=", 1)[0] for entry in marker_environment]
        # macOS can synthesize the Core Foundation locale cache after exec.
        assert set(names) - {"__CF_USER_TEXT_ENCODING"} == {"HOME", "LC_ALL", "TMPDIR", "TZ"}
        assert names.count("HOME") == 3
        for name in ("candidate", "cpu_reference"):
            candidate = scratch / name
            token = digest_token("case-binary", candidate)
            result = qualification_run.run_owned_command(
                kind="case", physical_argv=[str(candidate)], logical_argv=[token],
                mappings={token: candidate}, cwd=scratch, home=home, temporary=scratch,
                timeout_seconds=5,
            )
            assert result.terminal == "PASS", result.stderr.retained.decode(errors="replace")
            assert result.stdout.retained == b"0\n"

    print("gpu explicit C-driver preparation smoke: PASS")


if __name__ == "__main__":
    main()
