#!/usr/bin/env python3
"""Exercise FRESH-IMAGE crypto, admission, sealed-fd, and ELF build ownership."""

from __future__ import annotations

import errno
import hashlib
import os
import signal
import struct
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path


REPOSITORY = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPOSITORY / "scripts"))
sys.path.insert(0, str(REPOSITORY / "image" / "fresh" / "control"))

from fresh_image_control import (  # noqa: E402
    ControlError,
    _mode_from_arguments,
    _normalize_absolute,
    _normalize_relative,
    _open_regular,
    _read_sealed,
    _reject_environment,
    _sealed_memfd,
)
import fresh_image_control as control  # noqa: E402
from fresh_manifest import serialized_digest  # noqa: E402


def rejected(callback: object) -> None:
    try:
        callback()  # type: ignore[operator]
    except ControlError:
        return
    raise AssertionError("case was accepted")


def rejected_os(callback: object) -> None:
    try:
        callback()  # type: ignore[operator]
    except OSError:
        return
    raise AssertionError("OS-level case was accepted")


def revision_rejected(callback: object) -> None:
    try:
        callback()  # type: ignore[operator]
    except ControlError as error:
        assert error.category == "REVISION"
        assert error.phase == "revision"
        return
    raise AssertionError("revision case was accepted")


def boundary_worker_presence_case(temporary: Path) -> None:
    project = temporary / "boundary-project"
    scripts = project / "scripts"
    scripts.mkdir(parents=True)
    project_fd = os.open(project, os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
    worker = scripts / "run-json-scan-row-ownership-adoption"
    try:
        revision_rejected(lambda: control._boundary_worker_presence(project_fd))
        worker.write_bytes(b"worker bytes must not be consumed")
        worker.chmod(0o755)
        revision_rejected(lambda: control._boundary_worker_presence(project_fd))
        worker.unlink()
        os.symlink("missing-worker", worker)
        revision_rejected(lambda: control._boundary_worker_presence(project_fd))
        worker.unlink()
        os.mkfifo(worker, 0o755)
        started = time.monotonic()
        revision_rejected(lambda: control._boundary_worker_presence(project_fd))
        assert time.monotonic() - started < 1.0
    finally:
        os.close(project_fd)


def boundary_runtime_binding_case(temporary: Path) -> None:
    dispatcher = temporary / "runtime-dispatcher"
    raw = b"runtime dispatcher bytes"
    dispatcher.write_bytes(raw)
    dispatcher.chmod(0o755)
    tree = {
        "kind": "file",
        "mode": "0755",
        "staged_mode": "0755",
        "size": len(raw),
        "sha256": hashlib.sha256(raw).hexdigest(),
        "entries": [],
    }
    binding = {
        "source": str(dispatcher),
        "target": str(dispatcher),
        "kind": "file",
        "manifest": tree,
        "manifest_sha256": serialized_digest(tree),
    }
    descriptor, _, _ = control._runtime_file_binding(
        {"runtime_bindings": [binding]}, str(dispatcher), owner=os.geteuid()
    )
    os.close(descriptor)

    wrong_tree = dict(tree)
    wrong_tree["size"] = len(raw) + 1
    wrong_binding = dict(binding)
    wrong_binding["manifest"] = wrong_tree
    wrong_binding["manifest_sha256"] = serialized_digest(wrong_tree)
    try:
        control._runtime_file_binding(
            {"runtime_bindings": [wrong_binding]}, str(dispatcher), owner=os.geteuid()
        )
    except ControlError as error:
        assert error.category == "TRUST"
        assert error.phase == "supervisor"
    else:
        raise AssertionError("runtime binding with a wrong declared size was accepted")


def boundary_manifest_error_case() -> None:
    try:
        control._load_boundary_manifest(b"{}\n")
    except ControlError as error:
        assert error.category == "TRUST"
        assert error.phase == "supervisor"
        return
    raise AssertionError("malformed boundary manifest was accepted")


def boundary_child_lifecycle_case(temporary: Path) -> None:
    source = temporary / "boundary-child.c"
    source.write_text(
        "#include <signal.h>\n"
        "#include <unistd.h>\n"
        "#ifndef CASE\n"
        "#define CASE 0\n"
        "#endif\n"
        "int main(void) {\n"
        "#if CASE == 1\n"
        "    for (;;) pause();\n"
        "#elif CASE == 2\n"
        "    raise(SIGTERM);\n"
        "#endif\n"
        "    return 0;\n"
        "}\n",
        encoding="ascii",
    )
    compiler = os.environ.get("CC", "cc")
    helpers = []
    for case in (0, 1, 2):
        helper = temporary / f"boundary-child-{case}"
        subprocess.run(
            [compiler, "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror", f"-DCASE={case}", "-o", str(helper), str(source)],
            check=True,
        )
        helpers.append((case, helper))

    saved: dict[int, int] = {}
    targets = (4, 6, 8, 14, 18)
    for target in targets:
        try:
            saved[target] = os.dup(target)
        except OSError:
            pass
    project = temporary / "boundary-dispatch-project"
    align = temporary / "boundary-dispatch-align"
    project.mkdir()
    align.mkdir()
    old_timeout = control.BOUNDARY_TIMEOUT_SECONDS
    control.BOUNDARY_TIMEOUT_SECONDS = 0.1
    try:
        for case, helper in helpers:
            project_source = os.open(project, os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
            os.dup2(project_source, 4, inheritable=True)
            if project_source != 4:
                os.close(project_source)
            align_source = os.open(align, os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
            os.dup2(align_source, 18, inheritable=True)
            if align_source != 18:
                os.close(align_source)
            _sealed_memfd("boundary-image", b"image", 6)
            _sealed_memfd("boundary-manifest", b"manifest", 8)
            dispatcher_source = os.open(helper, os.O_RDONLY | os.O_CLOEXEC)
            os.dup2(dispatcher_source, 14, inheritable=True)
            if dispatcher_source != 14:
                os.close(dispatcher_source)
            original_waitpid = control.os.waitpid
            interrupted = True

            def waitpid_with_interrupt(pid: int, options: int) -> tuple[int, int]:
                nonlocal interrupted
                if interrupted:
                    interrupted = False
                    raise InterruptedError
                return original_waitpid(pid, options)

            if case == 0:
                control.os.waitpid = waitpid_with_interrupt  # type: ignore[assignment]
            try:
                status, stdout, stderr, valid = control._boundary_dispatch(
                    project_fd=4,
                    image_fd=6,
                    manifest_fd=8,
                    dispatcher_fd=14,
                    align_fd=18,
                    align_repo_absolute=str(align),
                    align_repo_relative="../" + align.name,
                )
            finally:
                control.os.waitpid = original_waitpid  # type: ignore[assignment]
            assert status is not None
            assert stdout == b""
            assert stderr == b""
            if case == 0:
                assert valid
                assert os.WIFEXITED(status)
                assert os.WEXITSTATUS(status) == 0
            else:
                assert not valid
    finally:
        control.BOUNDARY_TIMEOUT_SECONDS = old_timeout
        for target in targets:
            try:
                os.close(target)
            except OSError:
                pass
            if target in saved:
                os.dup2(saved[target], target, inheritable=True)
                os.close(saved[target])


def boundary_direct_vector_case(temporary: Path, dispatcher: Path) -> None:
    root = temporary / "boundary-direct"
    project = root / "project"
    align = root / "align"
    project.mkdir(parents=True)
    align.mkdir()
    saved: dict[int, int] = {}
    targets = (4, 6, 8, 14, 18)
    for target in targets:
        try:
            saved[target] = os.dup(target)
        except OSError:
            pass
    try:
        project_source = os.open(project, os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
        os.dup2(project_source, 4, inheritable=True)
        if project_source != 4:
            os.close(project_source)
        align_source = os.open(align, os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
        os.dup2(align_source, 18, inheritable=True)
        if align_source != 18:
            os.close(align_source)
        _sealed_memfd("align-llm-image", b"image", 6)
        _sealed_memfd("align-llm-manifest", b"manifest", 8)
        dispatcher_source = os.open(dispatcher, os.O_RDONLY | os.O_CLOEXEC)
        os.dup2(dispatcher_source, 14, inheritable=True)
        if dispatcher_source != 14:
            os.close(dispatcher_source)
        arguments = [
            "--mode",
            "ordinary-adoption-boundary",
            "--project-root-fd",
            "4",
            "--image-attestation-fd",
            "6",
            "--manifest-fd",
            "8",
            "--align-repo-root-fd",
            "18",
            "--align-repo-absolute",
            str(align),
            "--align-repo-relative",
            "../align",
        ]
        for argv0 in ("request6-adoption-boundary-entrypoint", "wrong-name"):
            result = subprocess.run(
                [argv0, *arguments],
                cwd=project,
                env=dict(control.CHILD_ENVIRONMENT),
                executable=str(dispatcher),
                pass_fds=targets,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
            )
            assert result.returncode == 1
            assert result.stdout == b""
            assert result.stderr == b"json-scan adoption: ERROR input\n"
    finally:
        for target in targets:
            try:
                os.close(target)
            except OSError:
                pass
            if target in saved:
                os.dup2(saved[target], target, inheritable=True)
                os.close(saved[target])


def build(output: Path) -> dict[str, str]:
    result = subprocess.run(
        [
            sys.executable,
            str(REPOSITORY / "scripts" / "build-fresh-image-control"),
            "--output-dir",
            str(output),
        ],
        env={"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "LC_ALL": "C"},
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=True,
    )
    values = {}
    for line in result.stdout.decode("ascii").splitlines():
        digest, name = line.split("  ", 1)
        values[name] = digest
    return values


def has_elf_interpreter(path: Path) -> bool:
    raw = path.read_bytes()
    if raw[:6] != b"\x7fELF\x02\x01":
        raise AssertionError("launcher is not ELF64 little-endian")
    program_offset = struct.unpack_from("<Q", raw, 32)[0]
    entry_size = struct.unpack_from("<H", raw, 54)[0]
    entry_count = struct.unpack_from("<H", raw, 56)[0]
    return any(
        struct.unpack_from("<I", raw, program_offset + index * entry_size)[0] == 3
        for index in range(entry_count)
    )


def forwarder_descriptor_case(temporary: Path) -> None:
    helper = temporary / "forwarder-helper"
    helper.write_text(
        "#!/usr/bin/python3\n"
        "import os\n"
        "for value in os.environ['EXPECTED_OPEN'].split(','):\n"
        "    os.fstat(int(value))\n"
        "for value in os.environ['EXPECTED_CLOSED'].split(','):\n"
        "    try:\n"
        "        os.fstat(int(value))\n"
        "    except OSError:\n"
        "        continue\n"
        "    raise SystemExit(1)\n",
        encoding="utf-8",
    )
    helper.chmod(0o755)
    forwarder = temporary / "bwrap-forwarder"
    compiler = os.environ.get("CC", "cc")
    subprocess.run(
        [
            compiler,
            "-std=c11",
            "-O2",
            "-Wall",
            "-Wextra",
            "-Werror",
            f'-DTOOL_TARGET="{helper}"',
            "-DTOOL_BWRAP_FORWARDER=1",
            "-o",
            str(forwarder),
            str(REPOSITORY / "image" / "fresh" / "tool-forwarder.c"),
        ],
        check=True,
    )
    opened = [os.open(temporary, os.O_PATH | os.O_CLOEXEC) for _ in range(5)]
    try:
        bind_fd, lower_fd, upper_fd, userns_fd, rejected_fd = opened
        environment = {
            "EXPECTED_OPEN": ",".join(str(value) for value in opened[:4]),
            "EXPECTED_CLOSED": str(rejected_fd),
        }
        result = subprocess.run(
            [
                str(forwarder),
                "--bind-fd",
                str(bind_fd),
                "/bind",
                "--userns",
                str(userns_fd),
                "--overlay-src",
                f"/proc/self/fd/{lower_fd}",
                "--overlay",
                f"/proc/self/fd/{upper_fd}",
                str(temporary),
                "/workspace",
                "--",
                f"/proc/self/fd/{rejected_fd}",
            ],
            env=environment,
            pass_fds=tuple(opened),
            close_fds=True,
            check=False,
        )
        assert result.returncode == 0
    finally:
        for descriptor in reversed(opened):
            os.close(descriptor)


def cgroup_membership_case(temporary: Path) -> None:
    leaf = temporary / "control-cgroup-membership"
    leaf.mkdir(mode=0o700)
    leaf_fd = os.open(leaf, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    original_read = control._control_cgroup_file_read
    try:
        values = {"cgroup.procs": b"17\n23\n", "cgroup.threads": b"23\n17\n"}
        control._control_cgroup_file_read = lambda _fd, name, _limit=4096: values[name]
        assert control._control_cgroup_members(leaf_fd, "cgroup.procs") == (17, 23)
        rejected_os(lambda: control._control_cgroup_empty(leaf_fd))
        for raw in (b"0\n", b"bad\n", b"7\n7\n"):
            control._control_cgroup_file_read = lambda _fd, _name, _limit=4096, raw=raw: raw
            rejected_os(lambda: control._control_cgroup_members(leaf_fd, "cgroup.procs"))
    finally:
        control._control_cgroup_file_read = original_read
        os.close(leaf_fd)


def cgroup_removal_case(temporary: Path) -> None:
    parent = temporary / "control-cgroup-removal"
    parent.mkdir(mode=0o700)
    parent_fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    original_empty = control._control_cgroup_empty
    control._control_cgroup_empty = lambda _fd: None
    try:
        leaf_name = "control-cgroup-leaf"
        leaf = parent / leaf_name
        leaf.mkdir(mode=0o700)
        leaf_fd = os.open(leaf, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        value = os.fstat(leaf_fd)
        identity = (
            value.st_dev,
            value.st_ino,
            stat.S_IFMT(value.st_mode),
            stat.S_IMODE(value.st_mode),
            value.st_uid,
        )
        control._control_remove_cgroup_leaf(parent_fd, leaf_fd, leaf_name, identity)
        assert not leaf.exists()
        os.close(leaf_fd)

        leaf.mkdir(mode=0o700)
        leaf_fd = os.open(leaf, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        value = os.fstat(leaf_fd)
        identity = (
            value.st_dev,
            value.st_ino,
            stat.S_IFMT(value.st_mode),
            stat.S_IMODE(value.st_mode),
            value.st_uid,
        )
        saved = parent / (leaf_name + "-saved")
        leaf.rename(saved)
        leaf.mkdir(mode=0o700)
        rejected_os(
            lambda: control._control_remove_cgroup_leaf(
                parent_fd, leaf_fd, leaf_name, identity
            )
        )
        assert leaf.exists()
        saved.rmdir()
        leaf.rmdir()
        os.close(leaf_fd)
    finally:
        control._control_cgroup_empty = original_empty
        os.close(parent_fd)
        parent.rmdir()


def cgroup_launch_failure_case(temporary: Path) -> None:
    parent = temporary / "control-cgroup-launch-failure"
    parent.mkdir(mode=0o700)
    parent_fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    leaf_name = "control-cgroup-launch-leaf"
    leaf = parent / leaf_name
    leaf.mkdir(mode=0o700)
    leaf_fd = os.open(leaf, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    value = os.fstat(leaf_fd)
    identity = (
        value.st_dev,
        value.st_ino,
        stat.S_IFMT(value.st_mode),
        stat.S_IMODE(value.st_mode),
        value.st_uid,
    )
    original_lease = control._control_cgroup_lease
    original_empty = control._control_cgroup_empty
    original_populated = control._control_cgroup_populated
    original_popen = control.subprocess.Popen

    def fail_popen(*_arguments: object, **_keywords: object) -> None:
        raise OSError("synthetic child launch failure")

    control._control_cgroup_lease = lambda: (parent_fd, leaf_fd, leaf_name, identity)
    control._control_cgroup_empty = lambda _fd: None
    control._control_cgroup_populated = lambda _fd: False
    control.subprocess.Popen = fail_popen  # type: ignore[assignment]
    try:
        rejected_os(
            lambda: control._run_controlled_child(
                ["/missing-control-child"], environment={}, timeout=1
            )
        )
        assert not leaf.exists()
        assert not _fd_open(parent_fd)
        assert not _fd_open(leaf_fd)
    finally:
        control._control_cgroup_lease = original_lease
        control._control_cgroup_empty = original_empty
        control._control_cgroup_populated = original_populated
        control.subprocess.Popen = original_popen
        if _fd_open(leaf_fd):
            os.close(leaf_fd)
        if _fd_open(parent_fd):
            os.close(parent_fd)
        if leaf.exists():
            leaf.rmdir()
        parent.rmdir()


def cgroup_changed_group_termination_case() -> None:
    class ExitedProcess:
        pid = 424242

        @staticmethod
        def poll():
            return 0

        @staticmethod
        def wait(*, timeout):
            return 0

    original_populated = control._control_cgroup_populated
    original_matches = control._control_cgroup_matches
    original_write = control._control_cgroup_file_write
    original_reap = control._control_reap_descendants
    original_monotonic = control.time.monotonic
    writes = []
    try:
        populated = iter((True, True, False))
        reaped = iter((False, True))
        control._control_cgroup_populated = lambda _fd: next(populated)
        control._control_cgroup_matches = lambda *_arguments: True
        control._control_cgroup_file_write = (
            lambda fd, name, raw: writes.append((fd, name, raw))
        )
        control._control_reap_descendants = lambda _deadline, _process: next(reaped)
        control.time.monotonic = lambda: 0.0
        forced = control._control_terminate(
            ExitedProcess(),
            start="unchanged",
            group=999999,
            parent_fd=70,
            leaf_fd=71,
            leaf_name="owned-leaf",
            identity=(1, 2, stat.S_IFDIR, 0o700, os.geteuid()),
        )
        assert forced
        assert writes == [(71, "cgroup.kill", b"1\n")]
    finally:
        control._control_cgroup_populated = original_populated
        control._control_cgroup_matches = original_matches
        control._control_cgroup_file_write = original_write
        control._control_reap_descendants = original_reap
        control.time.monotonic = original_monotonic


def cgroup_descendant_reap_case() -> None:
    class DirectProcess:
        pid = 424242
        returncode = None

    original_waitpid = control.os.waitpid
    control._control_set_subreaper()
    process = subprocess.Popen(
        [
            sys.executable,
            "-I",
            "-B",
            "-c",
            "import os,time; pid=os.fork(); "
            "os._exit(0) if pid else (os.setsid(), time.sleep(0.05), os._exit(0))",
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        close_fds=True,
    )
    process.wait(timeout=2)
    assert control._control_reap_descendants(control.time.monotonic() + 2, process)

    states = iter(((515151, 0), ChildProcessError()))
    try:
        def waitpid(_pid: int, _options: int) -> tuple[int, int]:
            state = next(states)
            if isinstance(state, BaseException):
                raise state
            return state

        control.os.waitpid = waitpid
        assert control._control_reap_descendants(
            control.time.monotonic() + 1, DirectProcess()
        )
    finally:
        control.os.waitpid = original_waitpid


def controlled_child_drain_cases() -> None:
    original_lease = control._control_cgroup_lease
    original_empty = control._control_cgroup_empty
    original_write = control._control_cgroup_file_write
    original_membership = control._control_cgroup_child_membership
    original_populated = control._control_cgroup_populated
    original_matches = control._control_cgroup_matches
    original_reap = control._control_reap_descendants
    original_cleanup = control._control_cleanup_lease

    def run_case(*, persistent: bool) -> list[tuple[int, str, bytes]]:
        parent_fd = os.open("/dev/null", os.O_RDONLY | os.O_CLOEXEC)
        leaf_fd = os.open("/dev/null", os.O_RDONLY | os.O_CLOEXEC)
        writes: list[tuple[int, str, bytes]] = []
        try:
            control._control_cgroup_lease = lambda: (
                parent_fd,
                leaf_fd,
                "owned-leaf",
                (1, 2, stat.S_IFDIR, 0o700, os.geteuid()),
            )
            control._control_cgroup_empty = lambda _fd: None
            control._control_cgroup_file_write = (
                lambda fd, name, raw: writes.append((fd, name, raw))
            )
            control._control_cgroup_child_membership = lambda _fd, _pid: None
            if persistent:
                populated = iter((True, True, False))
                reaped = iter((False, True))
            else:
                populated = iter((True, False, False))
                reaped = iter((True, True))
            control._control_cgroup_populated = lambda _fd: next(populated)
            control._control_cgroup_matches = lambda *_arguments: True
            control._control_reap_descendants = (
                lambda _deadline, _process: next(reaped)
            )
            control._control_cleanup_lease = lambda *_arguments: None
            if persistent:
                try:
                    control._run_controlled_child(
                        ["/bin/true"], environment={}, timeout=5
                    )
                except OSError as error:
                    assert error.errno == errno.ECHILD
                else:
                    raise AssertionError("forced descendant termination was accepted")
            else:
                result = control._run_controlled_child(
                    ["/bin/true"], environment={}, timeout=5
                )
                assert result.returncode == 0
            return writes
        finally:
            os.close(leaf_fd)
            os.close(parent_fd)

    try:
        natural_writes = run_case(persistent=False)
        assert not any(name == "cgroup.kill" for _, name, _ in natural_writes)
        forced_writes = run_case(persistent=True)
        assert any(
            name == "cgroup.kill" and raw == b"1\n"
            for _, name, raw in forced_writes
        )
    finally:
        control._control_cgroup_lease = original_lease
        control._control_cgroup_empty = original_empty
        control._control_cgroup_file_write = original_write
        control._control_cgroup_child_membership = original_membership
        control._control_cgroup_populated = original_populated
        control._control_cgroup_matches = original_matches
        control._control_reap_descendants = original_reap
        control._control_cleanup_lease = original_cleanup


def controlled_double_fork_forced_case(temporary: Path) -> None:
    marker = temporary / "control-double-fork-pid"
    child = temporary / "control-double-fork.py"
    child.write_text(
        "import os,signal,sys,time\n"
        "marker=sys.argv[1]\n"
        "pid=os.fork()\n"
        "if pid:\n"
        "    deadline=time.monotonic()+2\n"
        "    while not os.path.exists(marker) and time.monotonic()<deadline:\n"
        "        time.sleep(0.01)\n"
        "    os._exit(0 if os.path.exists(marker) else 2)\n"
        "os.setsid()\n"
        "with open(marker, 'w', encoding='ascii') as output:\n"
        "    output.write(str(os.getpid()))\n"
        "for descriptor in (0, 1, 2):\n"
        "    try:\n"
        "        os.close(descriptor)\n"
        "    except OSError:\n"
        "        pass\n"
        "signal.signal(signal.SIGTERM, signal.SIG_IGN)\n"
        "while True:\n"
        "    signal.pause()\n",
        encoding="ascii",
    )
    original_lease = control._control_cgroup_lease
    original_empty = control._control_cgroup_empty
    original_write = control._control_cgroup_file_write
    original_membership = control._control_cgroup_child_membership
    original_populated = control._control_cgroup_populated
    original_matches = control._control_cgroup_matches
    original_cleanup = control._control_cleanup_lease
    original_setrlimit = control.resource.setrlimit
    parent_fd = os.open("/dev/null", os.O_RDONLY | os.O_CLOEXEC)
    leaf_fd = os.open("/dev/null", os.O_RDONLY | os.O_CLOEXEC)
    writes: list[tuple[int, str, bytes]] = []

    def descendant_pid() -> int | None:
        try:
            return int(marker.read_text(encoding="ascii"))
        except (FileNotFoundError, ValueError):
            return None

    def descendant_running() -> bool:
        pid = descendant_pid()
        if pid is None:
            return False
        try:
            raw = Path(f"/proc/{pid}/stat").read_bytes()
        except FileNotFoundError:
            return False
        close = raw.rfind(b")")
        return close >= 0 and raw[close + 2 : close + 3] != b"Z"

    def cgroup_write(fd: int, name: str, raw: bytes) -> None:
        writes.append((fd, name, raw))
        if name == "cgroup.kill":
            pid = descendant_pid()
            assert pid is not None
            os.kill(pid, signal.SIGKILL)

    control._control_set_subreaper()
    try:
        control._control_cgroup_lease = lambda: (
            parent_fd,
            leaf_fd,
            "owned-leaf",
            (1, 2, stat.S_IFDIR, 0o700, os.geteuid()),
        )
        control._control_cgroup_empty = lambda _fd: None
        control._control_cgroup_file_write = cgroup_write
        control._control_cgroup_child_membership = lambda _fd, _pid: None
        control._control_cgroup_populated = lambda _fd: descendant_running()
        control._control_cgroup_matches = lambda *_arguments: True
        control._control_cleanup_lease = lambda *_arguments: None
        control.resource.setrlimit = lambda *_arguments: None
        try:
            result = control._run_controlled_child(
                [sys.executable, "-I", "-B", str(child), str(marker)],
                environment={},
                timeout=5,
            )
        except OSError as error:
            assert error.errno == errno.ECHILD
        else:
            raise AssertionError(
                "session-breaking persistent descendant was accepted: "
                f"returncode={result.returncode} pid={descendant_pid()} "
                f"running={descendant_running()} writes={writes!r} "
                f"stderr={result.stderr!r}"
            )
        assert any(
            name == "cgroup.kill" and raw == b"1\n"
            for _, name, raw in writes
        )
        assert not descendant_running()
        try:
            control.os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            pass
        else:
            raise AssertionError("persistent descendant was not completely reaped")
    finally:
        pid = descendant_pid()
        if pid is not None:
            if descendant_running():
                try:
                    os.kill(pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
            try:
                os.waitpid(pid, 0)
            except ChildProcessError:
                pass
        control._control_cgroup_lease = original_lease
        control._control_cgroup_empty = original_empty
        control._control_cgroup_file_write = original_write
        control._control_cgroup_child_membership = original_membership
        control._control_cgroup_populated = original_populated
        control._control_cgroup_matches = original_matches
        control._control_cleanup_lease = original_cleanup
        control.resource.setrlimit = original_setrlimit
        os.close(leaf_fd)
        os.close(parent_fd)


def subreaper_cases() -> None:
    original_cdll = control.ctypes.CDLL
    original_bootstrap_verify = control._bootstrap_verify
    original_require = control._control_require_subreaper
    control._control_set_subreaper()
    control._control_require_subreaper()

    class MissingSubreaper:
        @staticmethod
        def prctl(option, argument, *_unused):
            assert option == control.PR_GET_CHILD_SUBREAPER
            pointer = control.ctypes.cast(
                argument, control.ctypes.POINTER(control.ctypes.c_int)
            )
            pointer.contents.value = 0
            return 0

    class FailedSet:
        @staticmethod
        def prctl(option, *_arguments):
            assert option == control.PR_SET_CHILD_SUBREAPER
            return -1

    try:
        control.ctypes.CDLL = lambda *_arguments, **_keywords: MissingSubreaper()
        rejected_os(control._control_require_subreaper)
        control.ctypes.CDLL = lambda *_arguments, **_keywords: FailedSet()
        rejected_os(control._control_set_subreaper)
        control.ctypes.CDLL = original_cdll
        control._bootstrap_verify = lambda **_keywords: (b"", b"", b"{}\n", {})

        def missing_after_exec() -> None:
            raise OSError(errno.EPERM, "synthetic exec-preservation failure")

        control._control_require_subreaper = missing_after_exec
        try:
            control.bootstrap("build", self_fd=10)
        except ControlError as error:
            assert (error.category, error.phase) == ("PLATFORM", "platform")
        else:
            raise AssertionError("bootstrap accepted missing inherited subreaper state")
    finally:
        control.ctypes.CDLL = original_cdll
        control._bootstrap_verify = original_bootstrap_verify
        control._control_require_subreaper = original_require


def controller_runtime_tool_precedence_case() -> None:
    original_reject_environment = control._reject_environment
    original_regular_snapshot = control._regular_snapshot
    original_read_sealed = control._read_sealed
    original_verify_image = control._verify_image_envelope
    original_set_subreaper = control._control_set_subreaper
    original_git_identity = control._git_identity
    original_validate = control.validate_manifest_bytes
    original_runtime_tree = control._runtime_tree
    original_open = control._open_regular
    tool_opens = []
    git_calls = []
    manifest = {
        "runtime_bindings": [{"source": "/invalid-runtime", "manifest": {}}],
        "tools": [{"name": "invalid-tool", "path": "/invalid-tool"}],
    }
    try:
        control._reject_environment = lambda _environment, *, mode: "../align"
        control._regular_snapshot = lambda *_arguments, **_keywords: b"supervisor"
        control._read_sealed = lambda *_arguments, **_keywords: b"image envelope"
        control._verify_image_envelope = lambda *_arguments, **_keywords: (
            {},
            b"bootstrap",
            b"manifest",
            b"synthetic manifest",
        )
        control._control_set_subreaper = lambda: None
        control._git_identity = lambda *_arguments, **_keywords: git_calls.append(
            "project git"
        )
        control.validate_manifest_bytes = lambda _raw: manifest

        def invalid_runtime(_path: str):
            raise ControlError("TOOL", "tools", "invalid runtime")

        control._runtime_tree = invalid_runtime
        control._open_regular = lambda *_arguments, **_keywords: tool_opens.append("tool")
        try:
            control.supervise(["--mode", "build"], self_fd=10, image_fd=11)
        except ControlError as error:
            assert (error.category, error.phase) == ("TOOL", "tools")
        else:
            raise AssertionError("invalid runtime and tool inputs were accepted")
        assert not tool_opens
        assert not git_calls
    finally:
        control._reject_environment = original_reject_environment
        control._regular_snapshot = original_regular_snapshot
        control._read_sealed = original_read_sealed
        control._verify_image_envelope = original_verify_image
        control._control_set_subreaper = original_set_subreaper
        control._git_identity = original_git_identity
        control.validate_manifest_bytes = original_validate
        control._runtime_tree = original_runtime_tree
        control._open_regular = original_open


def retained_runtime_file_cases() -> None:
    original_validate = control.validate_manifest_bytes
    path = "/usr/bin/zipinfo"
    raw = Path(path).read_bytes()
    assert Path(path).stat().st_nlink > 1
    node = {
        "kind": "dir",
        "entries": [
            {
                "name": "zipinfo",
                "kind": "file",
                "mode": "0755",
                "size": len(raw),
                "sha256": control.sha256_hex(raw),
                "entries": [],
            }
        ],
    }
    manifest = {
        "runtime_bindings": [{"source": "/usr/bin", "manifest": node}],
    }
    try:
        control.validate_manifest_bytes = lambda _raw: manifest
        descriptor = control._retained_runtime_file(b"manifest", path)
        try:
            os.lseek(descriptor, 0, os.SEEK_SET)
            assert os.read(descriptor, len(raw) + 1) == raw
        finally:
            os.close(descriptor)
        node["entries"][0]["sha256"] = "0" * 64
        try:
            control._retained_runtime_file(b"manifest", path)
        except ControlError as error:
            assert (error.category, error.phase) == ("TOOL", "tools")
        else:
            raise AssertionError("changed retained runtime file was accepted")
    finally:
        control.validate_manifest_bytes = original_validate


def main() -> int:
    assert _normalize_relative("../align") == "../align"
    assert _normalize_relative("a/./b/../c") == "a/c"
    for invalid in ("", "/align", ".", "a/..", "\x00"):
        rejected(lambda value=invalid: _normalize_relative(value))
    assert _mode_from_arguments(["make", "--no-print-directory", "ci"]) == "ci"
    assert _mode_from_arguments(["--mode", "build"]) == "build"
    assert _mode_from_arguments(["--mode", "self-test"]) == "self-test"
    assert _mode_from_arguments(["--mode", "ordinary-adoption-boundary"]) == (
        "ordinary-adoption-boundary"
    )
    assert _normalize_absolute("/work/align") == "/work/align"
    for invalid in (
        "",
        "align",
        "/work/../align",
        "/work//align",
        "/work/\x01align",
        "/work/\udcff",
    ):
        rejected(lambda value=invalid: _normalize_absolute(value))
    for invalid in (
        [],
        ["make", "ci"],
        ["make", "--no-print-directory", "ci", "extra"],
        ["--mode", "ci"],
    ):
        rejected(lambda value=invalid: _mode_from_arguments(value))
    assert _reject_environment({}, mode="ci") == "../align"
    rejected(lambda: _reject_environment({"ALIGNC": "/tmp/alignc"}, mode="ci"))
    rejected(lambda: _reject_environment({"MAKEFLAGS": "-n"}, mode="ci"))
    rejected(
        lambda: _reject_environment(
            {"ALIGN_REPO": "/work/align", "BOUNDARY_EXTRA": "1"},
            mode="ordinary-adoption-boundary",
        )
    )
    rejected(
        lambda: _reject_environment({"ALIGN_REPO": "../align"}, mode="self-test")
    )
    with tempfile.TemporaryDirectory(prefix="fresh-image-membership-") as name:
        temporary = Path(name)
        boundary_worker_presence_case(temporary)
        boundary_runtime_binding_case(temporary)
        boundary_manifest_error_case()
        boundary_child_lifecycle_case(temporary)
        cgroup_membership_case(temporary)
        cgroup_removal_case(temporary)
        cgroup_launch_failure_case(temporary)
        cgroup_changed_group_termination_case()
        cgroup_descendant_reap_case()
        controlled_child_drain_cases()
        controlled_double_fork_forced_case(temporary)
        subreaper_cases()
        controller_runtime_tool_precedence_case()
    retained_runtime_file_cases()

    original = os.dup(31) if _fd_open(31) else None
    try:
        _sealed_memfd("fresh-image-test", b"abc", 31)
        assert _read_sealed(31, limit=3) == b"abc"
        rejected(lambda: _read_sealed(31, limit=2))
    finally:
        os.close(31)
        if original is not None:
            os.dup2(original, 31)
            os.close(original)

    with tempfile.TemporaryDirectory(prefix="fresh-image-build-a-") as first_name:
        with tempfile.TemporaryDirectory(prefix="fresh-image-build-b-") as second_name:
            first = Path(first_name)
            second = Path(second_name)
            forwarder_descriptor_case(first)
            assert build(first) == build(second)
            boundary_direct_vector_case(first, first / "request6-adoption-boundary-entrypoint")
            for name in (
                "fresh-supervise",
                "fresh-bootstrap",
                "request6-adoption-boundary-entrypoint",
            ):
                assert (first / name).read_bytes() == (second / name).read_bytes()
                assert (first / name).read_bytes().startswith(b"\x7fELF")
            assert not has_elf_interpreter(first / "fresh-supervise")
            assert not has_elf_interpreter(
                first / "request6-adoption-boundary-entrypoint"
            )
            fifo = first / "worker-fifo"
            os.mkfifo(fifo, 0o755)
            started = time.monotonic()
            rejected(
                lambda: _open_regular(
                    str(fifo), limit=4_194_304, exact_mode=0o755
                )
            )
            assert time.monotonic() - started < 1.0
            signing_seed = first / "offline-seed"
            signing_seed.write_bytes(b"s" * 32)
            signing_seed.chmod(0o400)
            signer_manifest = first / "signer-manifest"
            signer_manifest.write_bytes(b"{}\n")
            signer_manifest.chmod(0o444)
            signer_started = time.monotonic()
            signer_fifo = subprocess.run(
                [
                    sys.executable,
                    str(REPOSITORY / "scripts" / "fresh-image-attest"),
                    "--image-digest",
                    "sha256:" + "1" * 64,
                    "--provenance-digest",
                    "sha256:" + "2" * 64,
                    "--supervisor",
                    str(fifo),
                    "--bootstrap",
                    str(first / "fresh-bootstrap"),
                    "--manifest",
                    str(signer_manifest),
                    "--image-signing-seed",
                    str(signing_seed),
                    "--output",
                    str(first / "fifo-attestation"),
                ],
                env={
                    "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
                    "LC_ALL": "C",
                    "PYTHONDONTWRITEBYTECODE": "1",
                },
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
                timeout=2,
            )
            assert signer_fifo.returncode != 0
            assert time.monotonic() - signer_started < 1.0
            injected = subprocess.run(
                [str(first / "fresh-supervise")],
                env={"LD_PRELOAD": "/nonexistent/fresh-image-injection.so"},
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
            )
            assert injected.returncode == 1
            assert injected.stdout == b""
            assert injected.stderr == b"fresh compiler: ERROR ARGUMENT input\n"
            for environment in (
                {"LD_DEBUG": "libs"},
                {"GLIBC_TUNABLES": "glibc.malloc.check=1"},
                {"PYTHONHASHSEED": "1"},
            ):
                rejected_environment = subprocess.run(
                    [str(first / "fresh-supervise"), "--mode", "self-test"],
                    env=environment,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    check=False,
                )
                assert rejected_environment.returncode == 1
                assert rejected_environment.stdout == b""
                assert (
                    rejected_environment.stderr
                    == b"fresh compiler: ERROR ARGUMENT input\n"
                )
            injected_option = subprocess.run(
                [
                    str(first / "fresh-supervise"),
                    "--embedded-self-fd",
                    "10",
                    "--mode",
                    "self-test",
                ],
                env={},
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
            )
            assert injected_option.returncode == 1
            assert injected_option.stdout == b""
            assert injected_option.stderr == b"fresh compiler: ERROR ARGUMENT input\n"
            result = subprocess.run(
                [str(first / "fresh-supervise"), "--mode", "self-test"],
                env={},
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
            )
            assert result.returncode == 1
            assert result.stdout == b""
            assert result.stderr == b"fresh compiler: ERROR TRUST supervisor\n"
            boundary = subprocess.run(
                [
                    str(first / "request6-adoption-boundary-entrypoint"),
                    "--mode",
                    "ordinary-adoption-boundary",
                ],
                env={
                    "PATH": "/usr/bin:/bin",
                    "LC_ALL": "C",
                    "LANG": "C",
                    "HOME": "/nonexistent",
                    "TMPDIR": "/tmp",
                },
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
            )
            assert boundary.returncode == 1
            assert boundary.stdout == b""
            assert boundary.stderr == b"json-scan adoption: ERROR input\n"

    print("fresh image control smoke: PASS")
    return 0


def _fd_open(fd: int) -> bool:
    try:
        os.fstat(fd)
        return True
    except OSError:
        return False


if __name__ == "__main__":
    raise SystemExit(main())
