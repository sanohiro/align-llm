#!/usr/bin/env python3
"""Exercise FRESH-IMAGE crypto, admission, sealed-fd, and ELF build ownership."""

from __future__ import annotations

import os
import struct
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path


REPOSITORY = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPOSITORY / "scripts"))
sys.path.insert(0, str(REPOSITORY / "image" / "fresh" / "control"))

from fresh_image_control import (  # noqa: E402
    ControlError,
    _mode_from_arguments,
    _normalize_relative,
    _open_regular,
    _read_sealed,
    _reject_environment,
    _sealed_memfd,
)
import fresh_image_control as control  # noqa: E402


def rejected(callback: object) -> None:
    try:
        callback()  # type: ignore[operator]
    except ControlError:
        return
    raise AssertionError("case was accepted")


def rejected_os(callback: object) -> None:
    try:
        callback()  # type: ignore[operator]
    except OSError:
        return
    raise AssertionError("OS-level case was accepted")


def build(output: Path) -> dict[str, str]:
    result = subprocess.run(
        [
            sys.executable,
            str(REPOSITORY / "scripts" / "build-fresh-image-control"),
            "--output-dir",
            str(output),
        ],
        env={"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "LC_ALL": "C"},
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=True,
    )
    values = {}
    for line in result.stdout.decode("ascii").splitlines():
        digest, name = line.split("  ", 1)
        values[name] = digest
    return values


def has_elf_interpreter(path: Path) -> bool:
    raw = path.read_bytes()
    if raw[:6] != b"\x7fELF\x02\x01":
        raise AssertionError("launcher is not ELF64 little-endian")
    program_offset = struct.unpack_from("<Q", raw, 32)[0]
    entry_size = struct.unpack_from("<H", raw, 54)[0]
    entry_count = struct.unpack_from("<H", raw, 56)[0]
    return any(
        struct.unpack_from("<I", raw, program_offset + index * entry_size)[0] == 3
        for index in range(entry_count)
    )


def forwarder_descriptor_case(temporary: Path) -> None:
    helper = temporary / "forwarder-helper"
    helper.write_text(
        "#!/usr/bin/python3\n"
        "import os\n"
        "for value in os.environ['EXPECTED_OPEN'].split(','):\n"
        "    os.fstat(int(value))\n"
        "for value in os.environ['EXPECTED_CLOSED'].split(','):\n"
        "    try:\n"
        "        os.fstat(int(value))\n"
        "    except OSError:\n"
        "        continue\n"
        "    raise SystemExit(1)\n",
        encoding="utf-8",
    )
    helper.chmod(0o755)
    forwarder = temporary / "bwrap-forwarder"
    compiler = os.environ.get("CC", "cc")
    subprocess.run(
        [
            compiler,
            "-std=c11",
            "-O2",
            "-Wall",
            "-Wextra",
            "-Werror",
            f'-DTOOL_TARGET="{helper}"',
            "-DTOOL_BWRAP_FORWARDER=1",
            "-o",
            str(forwarder),
            str(REPOSITORY / "image" / "fresh" / "tool-forwarder.c"),
        ],
        check=True,
    )
    opened = [os.open(temporary, os.O_PATH | os.O_CLOEXEC) for _ in range(5)]
    try:
        bind_fd, lower_fd, upper_fd, userns_fd, rejected_fd = opened
        environment = {
            "EXPECTED_OPEN": ",".join(str(value) for value in opened[:4]),
            "EXPECTED_CLOSED": str(rejected_fd),
        }
        result = subprocess.run(
            [
                str(forwarder),
                "--bind-fd",
                str(bind_fd),
                "/bind",
                "--userns",
                str(userns_fd),
                "--overlay-src",
                f"/proc/self/fd/{lower_fd}",
                "--overlay",
                f"/proc/self/fd/{upper_fd}",
                str(temporary),
                "/workspace",
                "--",
                f"/proc/self/fd/{rejected_fd}",
            ],
            env=environment,
            pass_fds=tuple(opened),
            close_fds=True,
            check=False,
        )
        assert result.returncode == 0
    finally:
        for descriptor in reversed(opened):
            os.close(descriptor)


def cgroup_membership_case(temporary: Path) -> None:
    leaf = temporary / "control-cgroup-membership"
    leaf.mkdir(mode=0o700)
    leaf_fd = os.open(leaf, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    original_read = control._control_cgroup_file_read
    try:
        values = {"cgroup.procs": b"17\n23\n", "cgroup.threads": b"23\n17\n"}
        control._control_cgroup_file_read = lambda _fd, name, _limit=4096: values[name]
        assert control._control_cgroup_members(leaf_fd, "cgroup.procs") == (17, 23)
        rejected_os(lambda: control._control_cgroup_empty(leaf_fd))
        for raw in (b"0\n", b"bad\n", b"7\n7\n"):
            control._control_cgroup_file_read = lambda _fd, _name, _limit=4096, raw=raw: raw
            rejected_os(lambda: control._control_cgroup_members(leaf_fd, "cgroup.procs"))
    finally:
        control._control_cgroup_file_read = original_read
        os.close(leaf_fd)


def cgroup_removal_case(temporary: Path) -> None:
    parent = temporary / "control-cgroup-removal"
    parent.mkdir(mode=0o700)
    parent_fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    original_empty = control._control_cgroup_empty
    control._control_cgroup_empty = lambda _fd: None
    try:
        leaf_name = "control-cgroup-leaf"
        leaf = parent / leaf_name
        leaf.mkdir(mode=0o700)
        leaf_fd = os.open(leaf, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        value = os.fstat(leaf_fd)
        identity = (
            value.st_dev,
            value.st_ino,
            stat.S_IFMT(value.st_mode),
            stat.S_IMODE(value.st_mode),
            value.st_uid,
        )
        control._control_remove_cgroup_leaf(parent_fd, leaf_fd, leaf_name, identity)
        assert not leaf.exists()
        os.close(leaf_fd)

        leaf.mkdir(mode=0o700)
        leaf_fd = os.open(leaf, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        value = os.fstat(leaf_fd)
        identity = (
            value.st_dev,
            value.st_ino,
            stat.S_IFMT(value.st_mode),
            stat.S_IMODE(value.st_mode),
            value.st_uid,
        )
        saved = parent / (leaf_name + "-saved")
        leaf.rename(saved)
        leaf.mkdir(mode=0o700)
        rejected_os(
            lambda: control._control_remove_cgroup_leaf(
                parent_fd, leaf_fd, leaf_name, identity
            )
        )
        assert leaf.exists()
        saved.rmdir()
        leaf.rmdir()
        os.close(leaf_fd)
    finally:
        control._control_cgroup_empty = original_empty
        os.close(parent_fd)
        parent.rmdir()


def cgroup_launch_failure_case(temporary: Path) -> None:
    parent = temporary / "control-cgroup-launch-failure"
    parent.mkdir(mode=0o700)
    parent_fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    leaf_name = "control-cgroup-launch-leaf"
    leaf = parent / leaf_name
    leaf.mkdir(mode=0o700)
    leaf_fd = os.open(leaf, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    value = os.fstat(leaf_fd)
    identity = (
        value.st_dev,
        value.st_ino,
        stat.S_IFMT(value.st_mode),
        stat.S_IMODE(value.st_mode),
        value.st_uid,
    )
    original_lease = control._control_cgroup_lease
    original_empty = control._control_cgroup_empty
    original_populated = control._control_cgroup_populated
    original_popen = control.subprocess.Popen

    def fail_popen(*_arguments: object, **_keywords: object) -> None:
        raise OSError("synthetic child launch failure")

    control._control_cgroup_lease = lambda: (parent_fd, leaf_fd, leaf_name, identity)
    control._control_cgroup_empty = lambda _fd: None
    control._control_cgroup_populated = lambda _fd: False
    control.subprocess.Popen = fail_popen  # type: ignore[assignment]
    try:
        rejected_os(
            lambda: control._run_controlled_child(
                ["/missing-control-child"], environment={}, timeout=1
            )
        )
        assert not leaf.exists()
        assert not _fd_open(parent_fd)
        assert not _fd_open(leaf_fd)
    finally:
        control._control_cgroup_lease = original_lease
        control._control_cgroup_empty = original_empty
        control._control_cgroup_populated = original_populated
        control.subprocess.Popen = original_popen
        if _fd_open(leaf_fd):
            os.close(leaf_fd)
        if _fd_open(parent_fd):
            os.close(parent_fd)
        if leaf.exists():
            leaf.rmdir()
        parent.rmdir()


def main() -> int:
    assert _normalize_relative("../align") == "../align"
    assert _normalize_relative("a/./b/../c") == "a/c"
    for invalid in ("", "/align", ".", "a/..", "\x00"):
        rejected(lambda value=invalid: _normalize_relative(value))
    assert _mode_from_arguments(["make", "--no-print-directory", "ci"]) == "ci"
    assert _mode_from_arguments(["--mode", "build"]) == "build"
    assert _mode_from_arguments(["--mode", "self-test"]) == "self-test"
    for invalid in (
        [],
        ["make", "ci"],
        ["make", "--no-print-directory", "ci", "extra"],
        ["--mode", "ci"],
    ):
        rejected(lambda value=invalid: _mode_from_arguments(value))
    assert _reject_environment({}, mode="ci") == "../align"
    rejected(lambda: _reject_environment({"ALIGNC": "/tmp/alignc"}, mode="ci"))
    rejected(lambda: _reject_environment({"MAKEFLAGS": "-n"}, mode="ci"))
    rejected(
        lambda: _reject_environment({"ALIGN_REPO": "../align"}, mode="self-test")
    )
    with tempfile.TemporaryDirectory(prefix="fresh-image-membership-") as name:
        cgroup_membership_case(Path(name))
        cgroup_removal_case(Path(name))
        cgroup_launch_failure_case(Path(name))

    original = os.dup(31) if _fd_open(31) else None
    try:
        _sealed_memfd("fresh-image-test", b"abc", 31)
        assert _read_sealed(31, limit=3) == b"abc"
        rejected(lambda: _read_sealed(31, limit=2))
    finally:
        os.close(31)
        if original is not None:
            os.dup2(original, 31)
            os.close(original)

    with tempfile.TemporaryDirectory(prefix="fresh-image-build-a-") as first_name:
        with tempfile.TemporaryDirectory(prefix="fresh-image-build-b-") as second_name:
            first = Path(first_name)
            second = Path(second_name)
            forwarder_descriptor_case(first)
            assert build(first) == build(second)
            for name in ("fresh-supervise", "fresh-bootstrap"):
                assert (first / name).read_bytes() == (second / name).read_bytes()
                assert (first / name).read_bytes().startswith(b"\x7fELF")
            assert not has_elf_interpreter(first / "fresh-supervise")
            fifo = first / "worker-fifo"
            os.mkfifo(fifo, 0o755)
            started = time.monotonic()
            rejected(
                lambda: _open_regular(
                    str(fifo), limit=4_194_304, exact_mode=0o755
                )
            )
            assert time.monotonic() - started < 1.0
            signing_seed = first / "offline-seed"
            signing_seed.write_bytes(b"s" * 32)
            signing_seed.chmod(0o400)
            signer_manifest = first / "signer-manifest"
            signer_manifest.write_bytes(b"{}\n")
            signer_manifest.chmod(0o444)
            signer_started = time.monotonic()
            signer_fifo = subprocess.run(
                [
                    sys.executable,
                    str(REPOSITORY / "scripts" / "fresh-image-attest"),
                    "--image-digest",
                    "sha256:" + "1" * 64,
                    "--provenance-digest",
                    "sha256:" + "2" * 64,
                    "--supervisor",
                    str(fifo),
                    "--bootstrap",
                    str(first / "fresh-bootstrap"),
                    "--manifest",
                    str(signer_manifest),
                    "--image-signing-seed",
                    str(signing_seed),
                    "--output",
                    str(first / "fifo-attestation"),
                ],
                env={
                    "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
                    "LC_ALL": "C",
                    "PYTHONDONTWRITEBYTECODE": "1",
                },
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
                timeout=2,
            )
            assert signer_fifo.returncode != 0
            assert time.monotonic() - signer_started < 1.0
            injected = subprocess.run(
                [str(first / "fresh-supervise")],
                env={"LD_PRELOAD": "/nonexistent/fresh-image-injection.so"},
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
            )
            assert injected.returncode == 1
            assert injected.stdout == b""
            assert injected.stderr == b"fresh compiler: ERROR ARGUMENT input\n"
            for environment in (
                {"LD_DEBUG": "libs"},
                {"GLIBC_TUNABLES": "glibc.malloc.check=1"},
                {"PYTHONHASHSEED": "1"},
            ):
                rejected_environment = subprocess.run(
                    [str(first / "fresh-supervise"), "--mode", "self-test"],
                    env=environment,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    check=False,
                )
                assert rejected_environment.returncode == 1
                assert rejected_environment.stdout == b""
                assert (
                    rejected_environment.stderr
                    == b"fresh compiler: ERROR ARGUMENT input\n"
                )
            injected_option = subprocess.run(
                [
                    str(first / "fresh-supervise"),
                    "--embedded-self-fd",
                    "10",
                    "--mode",
                    "self-test",
                ],
                env={},
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
            )
            assert injected_option.returncode == 1
            assert injected_option.stdout == b""
            assert injected_option.stderr == b"fresh compiler: ERROR ARGUMENT input\n"
            result = subprocess.run(
                [str(first / "fresh-supervise"), "--mode", "self-test"],
                env={},
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
            )
            assert result.returncode == 1
            assert result.stdout == b""
            assert result.stderr == b"fresh compiler: ERROR TRUST supervisor\n"

    print("fresh image control smoke: PASS")
    return 0


def _fd_open(fd: int) -> bool:
    try:
        os.fstat(fd)
        return True
    except OSError:
        return False


if __name__ == "__main__":
    raise SystemExit(main())
