PREDECESSOR_PATH = ROOT / "scripts/run-olmoe-exact-safe-decode-boundaries"
PREDECESSOR_LOADER = SourceFileLoader(
    "olmoe_exact_safe_for_expert_phase_b_operation_diagnosis", str(PREDECESSOR_PATH)
)
PREDECESSOR_SPEC = importlib.util.spec_from_loader(
    PREDECESSOR_LOADER.name, PREDECESSOR_LOADER
)
if PREDECESSOR_SPEC is None or PREDECESSOR_SPEC.loader is None:
    raise RuntimeError("cannot load the exact-safe decode owner")
previous = importlib.util.module_from_spec(PREDECESSOR_SPEC)
sys.modules[PREDECESSOR_LOADER.name] = previous
PREDECESSOR_SPEC.loader.exec_module(previous)

base = previous.base
diagnosis = previous.diagnosis
owner = previous.owner
transfer = previous.transfer
compute = previous.compute

ARTIFACT_KIND = "R8_OLMOE_EXPERT_PHASE_B_OPERATION_DIAGNOSIS"
MODEL_BYTES = 4_213_512_192
MODEL_SHA256 = "4ddc0e53159ed512b8dd67914a66e27bc618f694672ba43a9a0454eabd9c684f"
SERVER_BUILD = "build 10566, commit bb4caa754"
BUDGET = 975_175_680
SEED = 5
FULL_TOKENS = 128
TEMPERATURE_MICROS = 300_000
FULL_OUTPUT_SHA256 = "aac1d1158144da0b3afd4f4cdff7c10df240adaa85529b8a21839a0c89777e52"
REPETITIONS = 4
CEILING_SECONDS = 8 * 60
BASELINE_VALUES_NS = [
    17_714_825_083, 16_684_315_166, 17_132_135_334, 21_189_618_042,
]
BASELINE_MEDIAN_NS = 17_423_480_208
FLOOR_PPM = 50_000
FLOOR_NS = 871_174_011

EXPECTED_ALIGN_REVISION = previous.EXPECTED_ALIGN_REVISION
EXPECTED_COMPILER_SHA256 = previous.EXPECTED_COMPILER_SHA256
EXPECTED_PACK_SHA256 = previous.EXPECTED_PACK_SHA256
