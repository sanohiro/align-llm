#!/usr/bin/env bash
set -euo pipefail
if [ "$#" != 3 ]; then
  printf '%s\n' 'usage: run-gpu-prefill-graph-cache-smoke GGML_SOURCE GGML_LIB GPU_PLUGIN' >&2
  exit 2
fi
root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
source_dir=$(realpath -- "$1")
library_dir=$(realpath -- "$2")
plugin=$(realpath -- "$3")
test -f "$source_dir/ggml/include/ggml.h"
test -f "$plugin"
work_dir=$(mktemp -d)
trap 'rm -r -- "$work_dir"' EXIT
for mode in ordinary open publish reserve bind; do
  flags=()
  case "$mode" in
    open) flags+=(-DALIGN_GPU_FORCE_PREFILL_CACHE_OPEN=1) ;;
    publish) flags+=(-DALIGN_GPU_FORCE_PREFILL_CACHE_PUBLISH=1) ;;
    reserve) flags+=(-DALIGN_GPU_FORCE_WORKSPACE_RETAIN_RESERVE=1) ;;
    bind) flags+=(-DALIGN_GPU_FORCE_WORKSPACE_RETAIN_BIND=1) ;;
  esac
  "${CC:-cc}" -std=c11 -O2 -Wall -Wextra -Werror -ffp-contract=off \
    -DALIGN_GGML_FP_CONTRACT_OFF=1 "${flags[@]}" \
    -I"$source_dir/ggml/include" "$root_dir/scripts/gpu_prefill_graph_cache_smoke.c" \
    -L"$library_dir" -Wl,-rpath,"$library_dir" -lggml -lggml-base -lm -ldl \
    -o "$work_dir/$mode"
  "$work_dir/$mode" "$plugin"
done
