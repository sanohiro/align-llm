#!/usr/bin/env bash
set -euo pipefail

# G1's focused OLMoE resident planner and loader owner. The GPU stub exercises the exact whole
# dense tensors and every expert plane without requiring GPU hardware.

unset ALIGN_LLM_GGML_INCLUDE ALIGN_LLM_GGML_LIB ALIGN_LLM_GGML_FORCE
unset ALIGN_GPU_LOAD_PREAD_PATH ALIGN_GPU_LOAD_PREAD_LOG
unset ALIGN_GPU_LOAD_PREAD_MODE DYLD_INSERT_LIBRARIES LD_PRELOAD

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
compiler="${ALIGNC:-${root_dir}/scripts/alignc}"
work_dir=$(mktemp -d)
work_dir=$(CDPATH= cd -- "${work_dir}" && pwd -P)
gpu_shim="${work_dir}/gpu-shim"
executable="${work_dir}/runtime-olmoe-load-smoke"
pread_observer="${work_dir}/gpu-load-pread-observer.dylib"
pread_validator="${work_dir}/gpu-load-pread-validator"

cleanup() {
  status=$?
  rm -rf "${work_dir}"
  exit "${status}"
}
trap cleanup EXIT HUP INT TERM

ALIGN_LLM_GGML_FORCE=engine+gpu ALIGN_LLM_GGML_SHIM_DIR="${gpu_shim}" \
  "${root_dir}/scripts/build-ggml-shim" >/dev/null
python3 "${root_dir}/scripts/layer_forward_fixture.py" "${work_dir}" --model --moe >/dev/null

case "$(uname -s)" in
  Darwin)
    cc -dynamiclib -O2 -Wall -Wextra -Werror \
      "${root_dir}/scripts/gpu_load_pread_observer.c" -o "${pread_observer}"
    ;;
  Linux)
    pread_observer="${work_dir}/gpu-load-pread-observer.so"
    cc -shared -fPIC -O2 -Wall -Wextra -Werror \
      "${root_dir}/scripts/gpu_load_pread_observer.c" -ldl -o "${pread_observer}"
    ;;
  *)
    printf '%s\n' "gpu olmoe load smoke: FAIL unsupported host: $(uname -s)" >&2
    exit 1
    ;;
esac

cc -O2 -Wall -Wextra -Werror \
  "${root_dir}/scripts/gpu_load_pread_validator.c" -o "${pread_validator}"

(
  cd "${root_dir}"
  export LIBRARY_PATH="${gpu_shim}${LIBRARY_PATH:+:${LIBRARY_PATH}}"
  "${compiler}" build src/runtime_olmoe_load_smoke.align >/dev/null
  mv runtime_olmoe_load_smoke "${executable}"
)

export DYLD_LIBRARY_PATH="${gpu_shim}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}"
export LD_LIBRARY_PATH="${gpu_shim}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

run_case() {
  mode=$1
  log=$2
  expected_status=$3
  rm -f "${log}"
  set +e
  if [ "$(uname -s)" = "Darwin" ]; then
    output=$(
      ALIGN_GPU_LOAD_PREAD_PATH="${work_dir}/moe-model-pack.alignpack" \
      ALIGN_GPU_LOAD_PREAD_LOG="${log}" \
      ALIGN_GPU_LOAD_PREAD_MODE="${mode}" \
      DYLD_INSERT_LIBRARIES="${pread_observer}" \
      "${executable}" \
        "${work_dir}/moe-model-pack.alignpack" \
        "${work_dir}/moe-model-pack-no-head.alignpack" \
        "${work_dir}/moe-model-pack-no-expert.alignpack" \
        "${work_dir}/moe-model-pack-shape.alignpack" \
        "${work_dir}/moe-model-pack-truncated.alignpack"
    )
  else
    output=$(
      ALIGN_GPU_LOAD_PREAD_PATH="${work_dir}/moe-model-pack.alignpack" \
      ALIGN_GPU_LOAD_PREAD_LOG="${log}" \
      ALIGN_GPU_LOAD_PREAD_MODE="${mode}" \
      LD_PRELOAD="${pread_observer}" \
      "${executable}" \
        "${work_dir}/moe-model-pack.alignpack" \
        "${work_dir}/moe-model-pack-no-head.alignpack" \
        "${work_dir}/moe-model-pack-no-expert.alignpack" \
        "${work_dir}/moe-model-pack-shape.alignpack" \
        "${work_dir}/moe-model-pack-truncated.alignpack"
    )
  fi
  status=$?
  set -e
  if [ "${expected_status}" = "nonzero" ]; then
    if [ "${status}" -eq 0 ]; then
      printf '%s\n' "gpu olmoe load smoke: FAIL mode=${mode} status=${status}; output: ${output}" >&2
      exit 1
    fi
  elif [ "${status}" -ne "${expected_status}" ]; then
    printf '%s\n' "gpu olmoe load smoke: FAIL mode=${mode} status=${status}; output: ${output}" >&2
    exit 1
  fi
  if [ "${expected_status}" = "0" ] && [ "${output}" != "runtime olmoe load smoke: PASS" ]; then
    printf '%s\n' "gpu olmoe load smoke: FAIL mode=${mode} output: ${output}" >&2
    exit 1
  fi
}

validate_log() {
  log=$1
  mode=$2
  "${pread_validator}" olmoe "${work_dir}/moe-model-pack.alignpack" "${log}" 4096 "${mode}"
}

run_case none "${work_dir}/olmoe-pread-baseline.log" 0
validate_log "${work_dir}/olmoe-pread-baseline.log" none
run_case short "${work_dir}/olmoe-pread-short.log" 0
validate_log "${work_dir}/olmoe-pread-short.log" short
run_case zero "${work_dir}/olmoe-pread-zero.log" nonzero
validate_log "${work_dir}/olmoe-pread-zero.log" zero
run_case error "${work_dir}/olmoe-pread-error.log" nonzero
validate_log "${work_dir}/olmoe-pread-error.log" error

printf '%s\n' "gpu olmoe load smoke: PASS"
