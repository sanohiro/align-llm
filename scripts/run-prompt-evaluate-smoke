        and ".prepared." not in align_boundary
        and "cleanup_optional" not in align_boundary,
        "Align evaluator process/result carrier boundary changed",
    )
    verify_compact_overflow_boundary()
    verify_descendant_cleanup_boundary()
    verify_workspace_ownership_boundary()
