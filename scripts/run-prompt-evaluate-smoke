            stdout = text("DIAGNOSTIC_STDOUT", f"stdout-{number}", "")
            stderr = text("DIAGNOSTIC_STDERR", f"stderr-{number}", "")
            context = bind({
                "schema_version": 1, "artifact_kind": "CONTEXT_SOURCES", "task_id": task_id,
                "patch_evaluation": empty, "failure_memory_jsonl": memory,
                "diagnostic_stdout": stdout, "diagnostic_stderr": stderr, "content_sha256": "",
            })
            context_path = f"artifacts/context-{number}.json"
            store(project, context_path, context)
            task = bind({
                "schema_version": 1, "artifact_kind": "PROMPT_EVALUATION_TASK", "task_id": task_id,
                "repo_id": "inclusive-range", "repo_revision": source_head,
                "repo_path": "eval/fixtures/python-inclusive-range-v1/repository", "require_clean_repo": False,
