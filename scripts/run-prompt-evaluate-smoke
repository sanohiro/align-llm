#!/usr/bin/env python3
"""Build a two-task fixed corpus and verify the evaluator-produced artifact pair."""

from __future__ import annotations

import copy
import hashlib
import importlib.util
import json
import os
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path


SOURCE = Path(__file__).resolve().parent.parent
ALIGNC = SOURCE / "scripts" / "alignc"
GIT = Path("/usr/bin/git")
PYTHON = Path("/usr/bin/python3").resolve(strict=True)


def canonical(value):
    return json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode()


def canonical_digest_item(value):
    if isinstance(value, dict):
        return {key: canonical_digest_item(child) for key, child in value.items() if child is not None}
    if isinstance(value, list):
        return [canonical_digest_item(child) for child in value]
    return value


def bind(value):
    value["content_sha256"] = ""
    value["content_sha256"] = hashlib.sha256(canonical(canonical_digest_item(value))).hexdigest()
    return value


def store(project: Path, relative: str, value):
    path = project / relative
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(canonical(value))
    return value


def text(kind: str, identifier: str, value: str):
    return bind({
        "schema_version": 1, "artifact_kind": kind, "artifact_id": identifier,
        "text": value, "content_sha256": "",
    })


def variant(identifier: str, candidate: str, base, repo, learned: str):
    return bind({
        "schema_version": 1, "artifact_kind": "PROMPT_VARIANT", "variant_id": identifier,
        "base_prompt": base, "repo_prompt": repo, "learned_prompt_append": learned,
        "context_policy": {
            "include_patch_evaluation": False, "include_failure_memory": False,
            "include_diagnostics": False, "max_patch_evaluation_bytes": 0,
            "max_failure_events": 0, "max_failure_context_bytes": 0,
            "max_diagnostic_bytes_per_stream": 0,
        },
        "candidate_id": candidate, "content_sha256": "",
    })


def reference(kind: str, path: str, identifier: str, digest: str):
    return {"artifact_kind": kind, "path": path, "artifact_id": identifier, "content_sha256": digest}


def raw_digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def git_head(path: Path) -> str:
    return subprocess.run(
        [str(GIT), "-C", str(path), "rev-parse", "HEAD"], text=True,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True,
    ).stdout.strip()


def require(condition, message):
    if not condition:
        raise RuntimeError(message)


def verify_compact_overflow_boundary() -> None:
    module_path = SOURCE / "scripts" / "prompt-evaluate.py"
    spec = importlib.util.spec_from_file_location("prompt_evaluate_boundary", module_path)
    require(spec is not None and spec.loader is not None, "evaluator helper could not be loaded")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    streaming = {"payload": "\\\"\n\u00e9" * 400_000, "optional": None, "content_sha256": ""}
    chunks = list(module.canonical_chunks(streaming, omit_mapping_none=True))
    require(
        max(map(len, chunks)) <= module.CANONICAL_STRING_CHUNK * 6
        and b"".join(chunks) == canonical(canonical_digest_item(streaming)),
        "canonical digest stream changed bytes or exceeded its chunk bound",
    )
    expected_streaming_digest = hashlib.sha256(b"".join(chunks)).hexdigest()
    original_digest_bytes = module.canonical_digest_bytes
    try:
        module.canonical_digest_bytes = lambda _value: (_ for _ in ()).throw(
            RuntimeError("whole digest materialization was used")
        )
        module.bind(streaming)
    finally:
        module.canonical_digest_bytes = original_digest_bytes
    require(
        streaming["content_sha256"] == expected_streaming_digest,
        "result binding did not use the bounded canonical digest stream",
    )
    request_record = bind({
        "schema_version": 1,
        "artifact_kind": "WORKSPACE_PREFLIGHT_REQUEST",
        "content_sha256": "",
    })
    result_record = bind({
        "schema_version": 1,
        "artifact_kind": "WORKSPACE_PREFLIGHT_RESULT",
        "content_sha256": "",
    })
    attestation = bind({
        "schema_version": 1,
        "artifact_kind": "RUN_SNAPSHOT_ATTESTATION",
        "content_sha256": "",
    })
    oversized = {
        "evaluation_id": "overflow-evaluation",
        "scope": {"scope": "retained"},
        "sample_count": 2,
        "workspace_preflight_request": request_record,
        "workspace_preflight": result_record,
        "snapshot_requests": [],
        "snapshot_results": [],
        "input_snapshots": [],
        "snapshot_attestations": [attestation],
        "tasks": [{"padding": "x" * 128}],
        "rows": [],
        "task_aggregates": [],
        "serious_regression_reasons": [],
    }
    expected_inputs = [{"retained": False}]
    require(not module.canonical_fits(oversized, 32), "oversized-result detector accepted a cap breach")
    crossing = copy.deepcopy(oversized)
    crossing["tasks"][0]["padding"] = "x" * 4096
    unbound_size = len(module.canonical(crossing))
    bound_crossing_cap = unbound_size + 16
    require(
        module.canonical_fits(crossing, bound_crossing_cap),
        "digest-crossing fixture did not fit before binding",
    )
    original_result_limit = module.RESULT_LIMIT
    with tempfile.TemporaryDirectory(prefix="prompt-result-bound-") as directory:
        result_path = Path(directory) / "result.json"
        evidence_path = Path(directory) / "evidence.json"
        try:
            module.RESULT_LIMIT = bound_crossing_cap
            persisted, _ = module.write_prepared_pair(result_path, evidence_path, crossing, {}, [])
        finally:
            module.RESULT_LIMIT = original_result_limit
        require(
            persisted["error_code"] == "RESULT_TOO_LARGE"
            and len(result_path.read_bytes()) <= bound_crossing_cap,
            "final digest expansion did not select the compact result",
        )
    module.compact_oversized_result(oversized, expected_inputs)
    trace_preimage = (
        f"1 WORKSPACE_PREFLIGHT_REQUEST {request_record['content_sha256']}\n"
        f"2 WORKSPACE_PREFLIGHT_RESULT {result_record['content_sha256']}\n"
        f"3 RUN_SNAPSHOT_ATTESTATION {attestation['content_sha256']}\n"
    ).encode()
    trace = oversized["trace_failure"]
    require(
        oversized["status"] == "ERROR"
        and oversized["error_code"] == "RESULT_TOO_LARGE"
        and oversized["scope"] == {"scope": "retained"}
        and oversized["tasks"] == []
        and oversized["rows"] == []
        and oversized["environment"] is None
        and trace["attempted_invocation_count"] == 1
        and trace["trace_record_count"] == 3
        and trace["trace_digest_sha256"] == hashlib.sha256(trace_preimage).hexdigest()
        and expected_inputs == [],
        "compact oversized-result envelope changed",
    )


def verify_descendant_cleanup_boundary() -> None:
    module_path = SOURCE / "scripts" / "prompt-evaluate.py"
    spec = importlib.util.spec_from_file_location("prompt_evaluate_descendants", module_path)
    require(spec is not None and spec.loader is not None, "evaluator helper could not be loaded")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    source = module_path.read_text()
    require(
        module.nested_owner_timeout(30_000_000_000) == 35_000_000_000
        and module.SNAPSHOT_HELPER_OUTER_TIMEOUT_NS >= 2 * 12_000_000_000 + module.CHILD_CLEANUP_MARGIN_NS
        and module.SOURCE_VERIFIER_OUTER_TIMEOUT_NS >= 9 * 12_000_000_000 + module.CHILD_CLEANUP_MARGIN_NS
        and source.count("nested_owner_timeout(task[\"timeout_ns\"])") == 1
        and "nested_owner_timeout(max(task[\"timeout_ns\"], provider_timeout_ns))" in source
        and "SOURCE_VERIFIER_OUTER_TIMEOUT_NS" in source,
        "nested child owners lost their cleanup/report deadline margin",
    )
    original_cleanup = module.cleanup_process_group
    cleanup_calls = 0

    def counted_cleanup(process, maximum_seconds=2.0):
        nonlocal cleanup_calls
        cleanup_calls += 1
        return original_cleanup(process, maximum_seconds)

    module.cleanup_process_group = counted_cleanup
    with tempfile.TemporaryDirectory(prefix="prompt-descendant-") as directory:
        marker = Path(directory) / "survived"
        child = f"import pathlib,time;time.sleep(0.6);pathlib.Path({str(marker)!r}).write_text('x')"
        parent = (
            "import subprocess,sys,time;"
            f"subprocess.Popen([sys.executable,'-c',{child!r}]);"
            "time.sleep(5)"
        )
        try:
            module.run_child([sys.executable, "-c", parent], SOURCE, {}, 200_000_000, 0)
            raise RuntimeError("timed child unexpectedly completed")
        except module.ChildBoundaryError as failure:
            require(failure.reason == "TIMEOUT", "descendant fixture returned the wrong failure")
        require(cleanup_calls == 1, "timed evaluator child cleanup was not exactly once")
        time.sleep(0.8)
        require(not marker.exists(), "timed evaluator child left a live descendant")

        cleanup_calls = 0
        marker = Path(directory) / "post-exit-survived"
        child = f"import pathlib,time;time.sleep(0.6);pathlib.Path({str(marker)!r}).write_text('x')"
        parent = (
            "import subprocess,sys;"
            f"subprocess.Popen([sys.executable,'-c',{child!r}],"
            "stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)"
        )
        try:
            module.run_child([sys.executable, "-c", parent], SOURCE, {}, 2_000_000_000, 0)
            raise RuntimeError("parent with a live descendant unexpectedly completed")
        except module.ChildBoundaryError as failure:
            require(failure.reason == "PROCESS", "post-exit descendant returned the wrong failure")
        require(cleanup_calls == 1, "post-exit evaluator child cleanup was not exactly once")
        time.sleep(0.8)
        require(not marker.exists(), "successful evaluator parent left a live descendant")


def verify_workspace_ownership_boundary() -> None:
    module_path = SOURCE / "scripts" / "prompt-evaluate.py"
    spec = importlib.util.spec_from_file_location("prompt_evaluate_ownership", module_path)
    require(spec is not None and spec.loader is not None, "evaluator helper could not be loaded")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    with tempfile.TemporaryDirectory(prefix="prompt-ownership-") as directory:
        root = Path(directory)
        current = [root / f"current-{kind}.json" for kind in ("variant", "rendered", "request", "measurement")]
        future = root / "future-variant.json"
        require(
            module.invocation_workspace_entries(*current) == sorted(path.name for path in current)
            and future.name not in module.invocation_workspace_entries(*current),
            "workspace admission was not limited to the exact current invocation",
        )
        stale = root / "retired.json"
        stale.write_text("owned")
        owned = {stale}
        require(module.retire_owned_path(stale, owned) and not owned, "removed path retained stale ownership")
        stale.write_text("competitor")
        require(module.retire_owned_path(stale, owned), "retired path did not remain retired")
        require(not module.cleanup_owned_paths(owned), "empty ownership set reported a survivor")
        require(stale.read_text() == "competitor", "retired ownership removed a competing replacement")


def copy_runtime(project: Path) -> None:
    for relative in (
        "scripts/prompt-evaluate.py", "scripts/prompt-fixed-adapter.py", "scripts/prompt-snapshot-helper.py",
        "scripts/prompt-source-verifier.py", "eval/runners/run-coding-task.py",
        "eval/tasks/coding-v1/python-inclusive-range/task.json",
        "eval/baselines/patches/python-inclusive-range.patch",
        "eval/baselines/patches/python-inclusive-range-parent.patch",
    ):
        destination = project / relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(SOURCE / relative, destination)
    shutil.copytree(
        SOURCE / "eval/fixtures/python-inclusive-range-v1",
        project / "eval/fixtures/python-inclusive-range-v1",
    )


def main() -> int:
    align_boundary = (SOURCE / "src/prompt_evaluate.align").read_text()
    require("command.timeout_ns" not in align_boundary, "Align evaluator armed an outer child deadline")
    verify_compact_overflow_boundary()
    verify_descendant_cleanup_boundary()
    verify_workspace_ownership_boundary()
    with tempfile.TemporaryDirectory(prefix="prompt-evaluate-") as directory:
        root = Path(directory)
        project = root / "project"
        project.mkdir()
        copy_runtime(project)
        workspace = project / "workspace"
        workspace.mkdir()

        adapter_runtime = "PYTHON:" + raw_digest(project / "scripts/prompt-fixed-adapter.py")
        snapshot_runtime = "PYTHON:" + raw_digest(project / "scripts/prompt-snapshot-helper.py")
        git_digest = raw_digest(GIT)
        python_digest = raw_digest(PYTHON)
        source_helper_digest = raw_digest(project / "scripts/prompt-source-verifier.py")

        control = bind({
            "schema_version": 1, "artifact_kind": "EVALUATION_PROVIDER_CONTROL",
            "provider_control_id": "fixture-control", "provider_kind": "FIXTURE",
            "endpoint": "fixture://inclusive-range", "endpoint_id": "fixture-endpoint",
            "model": "inclusive-range-v1", "api_key_env": None, "tokenize_endpoint": None,
            "timeout_ns": 2_000_000_000, "max_response_bytes": 65_536, "content_sha256": "",
        })
        store(project, "artifacts/provider-control.json", control)
        generation = bind({
            "schema_version": 1, "artifact_kind": "GENERATION_POLICY",
            "generation_policy_id": "fixture-generation", "evaluation_provider_kind": "FIXTURE",
            "evaluation_provider_endpoint_id": "fixture-endpoint",
            "evaluation_provider_model": "inclusive-range-v1",
            "provider_control_sha256": control["content_sha256"], "provider_service_revision": "fixture-v1",
            "max_prompt_bytes": 65_536, "max_tokens": 1_024, "temperature_micros": 0,
            "seed_mode": "PAIRED_FIXED", "seed_base": 100, "content_sha256": "",
        })
        store(project, "artifacts/generation-policy.json", generation)
        acceptance = bind({
            "schema_version": 1, "artifact_kind": "PROMPT_ACCEPTANCE_POLICY", "policy_id": "fixture-acceptance",
            "minimum_task_count": 2, "minimum_samples_per_variant": 2,
            "minimum_completion_gain_count": 1, "minimum_time_improvement_ppm": 1,
            "maximum_time_regression_ppm": 100_000, "maximum_repair_loop_regression_count": 0,
            "content_sha256": "",
        })
        store(project, "artifacts/acceptance.json", acceptance)
        environment_policy = bind({
            "schema_version": 1, "artifact_kind": "ENVIRONMENT_POLICY", "policy_id": "fixture-environment",
            "allowed_variables": [
                {"name": "LANG", "non_secret_value": "C", "source": "FIXED", "precedence": 0},
                {"name": "LC_ALL", "non_secret_value": "C", "source": "FIXED", "precedence": 1},
                {"name": "PATH", "non_secret_value": "/usr/bin:/bin", "source": "FIXED", "precedence": 2},
                {"name": "PYTHONDONTWRITEBYTECODE", "non_secret_value": "1", "source": "FIXED", "precedence": 3},
                {"name": "PYTHONNOUSERSITE", "non_secret_value": "1", "source": "FIXED", "precedence": 4},
            ],
            "executable_paths": ["/usr/bin/python3"], "locale": "C", "content_sha256": "",
        })
        store(project, "artifacts/environment.json", environment_policy)
        source_policy = bind({
            "schema_version": 1, "artifact_kind": "PROMPT_SOURCE_VERIFIER_POLICY", "policy_id": "fixture-source",
            "helper_path": "scripts/prompt-source-verifier.py", "helper_sha256": source_helper_digest,
            "helper_runtime": f"CPYTHON:{python_digest}:{source_helper_digest}",
            "interpreter_sha256": python_digest, "git_executable_sha256": git_digest,
            "content_sha256": "",
        })
        store(project, "artifacts/source-policy.json", source_policy)

        align_revision = (SOURCE / ".align-revision").read_text().strip()
        source_head = git_head(SOURCE)
        corpus_revision = bind({
            "schema_version": 1, "artifact_kind": "CORPUS_REVISION", "source_kind": "GIT_COMMIT",
            "source_repository_id": "align-llm-fixture", "source_sha256": source_head, "content_sha256": "",
        })
        base = text("BASE_PROMPT", "base-v1", "Return a minimal correct patch.")
        repo = text("REPO_PROMPT", "repo-v1", "Respect the repository validation command.")
        parent_variant = variant("parent-v1", "baseline", base, repo, "")
        candidate_variant = variant("candidate-v1", "candidate", base, repo, "Include the inclusive stop value.")
        scope = bind({
            "schema_version": 1, "artifact_kind": "PROMPT_SCOPE", "repo_id": "inclusive-range",
            "repo_profile_revision": "fixture-v1", "align_revision": align_revision,
            "corpus_id": "prompt-fixed-v1", "corpus_revision": corpus_revision,
            "evaluation_provider_kind": "FIXTURE", "evaluation_provider_model": "inclusive-range-v1",
            "generation_policy_sha256": generation["content_sha256"],
            "acceptance_policy_sha256": acceptance["content_sha256"],
            "base_prompt_sha256": base["content_sha256"], "repo_prompt_sha256": repo["content_sha256"],
            "content_sha256": "",
        })
        activation = bind({
            "schema_version": 1, "artifact_kind": "PROMPT_ACTIVATION", "activation_id": "baseline-v1/activation",
            "operation": "BASELINE", "scope": scope, "parent_activation_id": "",
            "parent_activation_sha256": "", "effective_variant": parent_variant,
            "accepted_evaluation_id": "", "accepted_evaluation_sha256": "",
            "rollback_target_activation_id": "", "rollback_target_activation_sha256": "",
            "decision_reason": "", "content_sha256": "",
        })
        parent = bind({
            "schema_version": 1, "artifact_kind": "PROMPT_ACTIVATION_RESULT", "decision_id": "baseline-v1",
            "status": "BASELINED", "error_code": "NONE", "error": "", "activation": activation,
            "content_sha256": "",
        })
        store(project, "artifacts/parent.json", parent)
        parent_reference = reference(
            "PROMPT_ACTIVATION_RESULT", "artifacts/parent.json", "baseline-v1", parent["content_sha256"]
        )
        experiment = bind({
            "schema_version": 1, "artifact_kind": "PROMPT_EXPERIMENT_RESULT", "experiment_id": "experiment-v1",
            "status": "PROPOSED", "error_code": "NONE", "error": "", "parent_activation": parent_reference,
            "scope": scope, "opportunity": reference("OPPORTUNITY", "artifacts/opportunity.json", "opportunity-v1", "a" * 64),
            "proposal_provider_kind": "LOCAL_OPENAI", "proposal_provider_endpoint_id": "fixture-proposal",
            "proposal_provider_model": "fixture-proposal", "proposal_elapsed_ns": 0,
            "proposal_status_code": None, "proposal_summary": "deterministic candidate",
            "candidate_variant": candidate_variant, "bounded_provider_output": "", "content_sha256": "",
        })
        store(project, "artifacts/experiment.json", experiment)

        artifact_paths = (
            "scripts/prompt-fixed-adapter.py", "scripts/prompt-snapshot-helper.py",
            "eval/runners/run-coding-task.py", "eval/tasks/coding-v1/python-inclusive-range/task.json",
            "eval/baselines/patches/python-inclusive-range.patch",
            "eval/baselines/patches/python-inclusive-range-parent.patch",
        )
        expectations = [
            {"path": relative, "kind": "FILE", "expected_sha256": raw_digest(project / relative)}
            for relative in artifact_paths
        ]
        task_files = []
        for number in (1, 2):
            task_id = f"inclusive-range-{number}"
            prompt = text("TASK_PROMPT", f"task-prompt-{number}", "Fix inclusive_total so the stop value is included.")
            prompt_path = f"artifacts/task-prompt-{number}.json"
            store(project, prompt_path, prompt)
            empty = text("PATCH_EVALUATION", f"patch-{number}", "")
            memory = text("FAILURE_MEMORY_JSONL", f"memory-{number}", "")
            stdout = text("DIAGNOSTIC_STDOUT", f"stdout-{number}", "")
            stderr = text("DIAGNOSTIC_STDERR", f"stderr-{number}", "")
            context = bind({
                "schema_version": 1, "artifact_kind": "CONTEXT_SOURCES", "task_id": task_id,
                "patch_evaluation": empty, "failure_memory_jsonl": memory,
                "diagnostic_stdout": stdout, "diagnostic_stderr": stderr, "content_sha256": "",
            })
            context_path = f"artifacts/context-{number}.json"
            store(project, context_path, context)
            task = bind({
                "schema_version": 1, "artifact_kind": "PROMPT_EVALUATION_TASK", "task_id": task_id,
                "repo_id": "inclusive-range", "repo_revision": source_head,
                "repo_path": "eval/fixtures/python-inclusive-range-v1/repository", "require_clean_repo": False,
                "cmd": "/usr/bin/python3", "argv": ["/usr/bin/python3", "scripts/prompt-fixed-adapter.py"],
                "snapshot_cmd": "/usr/bin/python3",
                "snapshot_argv": ["/usr/bin/python3", "scripts/prompt-snapshot-helper.py"],
                "measurement_adapter_runtime": adapter_runtime, "snapshot_helper_runtime": snapshot_runtime,
                "cwd": ".", "timeout_ns": 30_000_000_000, "task_prompt_path": prompt_path,
                "context_sources_path": context_path, "generation_policy_path": "artifacts/generation-policy.json",
                "provider_control_path": "artifacts/provider-control.json",
                "environment_policy_path": "artifacts/environment.json", "artifacts": expectations,
                "regression_limits": {
                    "maximum_unrelated_diff_count": 0, "maximum_patch_size_bytes": 16_384,
                    "maximum_public_api_change_count": 0, "maximum_repair_loops": 2,
                    "maximum_benchmark_regression_ppm": None,
                },
                "content_sha256": "",
            })
            task_path = f"artifacts/task-{number}.json"
            store(project, task_path, task)
            task_files.append(task_path)
        corpus = bind({
            "schema_version": 1, "artifact_kind": "PROMPT_EVALUATION_CORPUS", "corpus_id": "prompt-fixed-v1",
            "corpus_revision": corpus_revision, "task_files": task_files, "content_sha256": "",
        })
        store(project, "artifacts/corpus.json", corpus)
        preflight = bind({
            "schema_version": 1, "artifact_kind": "WORKSPACE_PREFLIGHT_REQUEST",
            "evaluation_id": "evaluation-v1", "project_root": str(project), "workspace_path": str(workspace),
            "content_sha256": "",
        })
        store(project, "artifacts/preflight.json", preflight)
        request = {
            "schema_version": 1, "artifact_kind": "PROMPT_EVALUATE_REQUEST", "evaluation_id": "evaluation-v1",
            "project_root": str(project), "experiment_path": "artifacts/experiment.json",
            "parent_activation_path": "artifacts/parent.json", "corpus_path": "artifacts/corpus.json",
            "sample_count": 2, "acceptance_policy_path": "artifacts/acceptance.json",
            "workspace_path": str(workspace), "workspace_preflight_path": "artifacts/preflight.json",
            "verifier_align_llm_repository_path": str(SOURCE), "verifier_align_llm_commit": source_head,
            "verifier_align_repository_path": str((SOURCE / "../align").resolve()),
            "verifier_align_revision": align_revision, "verifier_corpus_source_path": str(SOURCE),
            "verifier_corpus_source_kind": "GIT_COMMIT",
            "verifier_corpus_source_repository_id": "align-llm-fixture",
            "verifier_corpus_source_sha256": source_head,
            "verifier_source_policy_path": "artifacts/source-policy.json",
            "verifier_source_policy_sha256": source_policy["content_sha256"],
            "verifier_python_executable_path": str(PYTHON),
            "verifier_git_executable_path": str(GIT), "evaluation_evidence_path": "evidence.json",
        }
        request_path = project / "evaluate-request.json"
        request_path.write_bytes(canonical(request))
        result_path = project / "result.json"
        evidence_path = project / "evidence.json"
        build_root = root / "build"
        build_root.mkdir()
        built = subprocess.run(
            [str(ALIGNC), "build", str(SOURCE / "src/main.align")], cwd=build_root,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
        require(built.returncode == 0, f"evaluator command did not compile: {built.stderr.decode()[-4096:]}")

        source_child_marker = project / "source-child-ran"
        marker_helper = project / "scripts/source-verifier-marker.py"
        marker_helper.write_text(
            "from pathlib import Path\n"
            f"Path({str(source_child_marker)!r}).write_text('ran')\n"
        )
        marker_helper_digest = raw_digest(marker_helper)
        marker_policy = dict(source_policy)
        marker_policy["helper_path"] = "scripts/source-verifier-marker.py"
        marker_policy["helper_sha256"] = marker_helper_digest
        marker_policy["helper_runtime"] = f"CPYTHON:{python_digest}:{marker_helper_digest}"
        bind(marker_policy)
        store(project, "artifacts/source-policy.json", marker_policy)
        source_invalid_base = dict(request)
        source_invalid_base["verifier_source_policy_sha256"] = marker_policy["content_sha256"]

        def require_source_invalid(value, name: str, expected_code: str):
            invalid_result_path = project / name
            request_path.write_bytes(canonical(value))
            completed = subprocess.run(
                [str(build_root / "main"), "prompt", "evaluate", str(request_path), name],
                cwd=project, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
            )
            result_value = json.loads(invalid_result_path.read_text()) if invalid_result_path.exists() else None
            require(
                completed.returncode != 0
                and result_value is not None
                and result_value["status"] == "INVALID_INPUT"
                and result_value["error_code"] == expected_code
                and not evidence_path.exists()
                and not source_child_marker.exists()
                and not any(os.scandir(workspace)),
                f"source declaration {name} crossed the child boundary: {result_value!r}",
            )
            invalid_result_path.unlink()

        missing_manifest = dict(source_invalid_base)
        missing_manifest["verifier_corpus_source_kind"] = "FILE_SET"
        missing_manifest["verifier_corpus_source_repository_id"] = ""
        missing_manifest["verifier_corpus_source_sha256"] = "a" * 64
        require_source_invalid(missing_manifest, "missing-manifest-result.json", "INVALID_PATH")

        null_manifest = {}
        for key, child in source_invalid_base.items():
            null_manifest[key] = child
            if key == "verifier_corpus_source_kind":
                null_manifest["verifier_corpus_file_set_manifest_path"] = None
        null_manifest["verifier_corpus_source_kind"] = "FILE_SET"
        null_manifest["verifier_corpus_source_repository_id"] = ""
        null_manifest["verifier_corpus_source_sha256"] = "a" * 64
        require_source_invalid(null_manifest, "null-manifest-result.json", "INVALID_PATH")

