        def require_source_invalid(value, name: str, expected_code: str):
            invalid_result_path = project / name
            request_path.write_bytes(canonical(value))
            completed = subprocess.run(
                [str(build_root / "main"), "prompt", "evaluate", str(request_path), name],
                cwd=project, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
            )
            result_value = json.loads(invalid_result_path.read_text()) if invalid_result_path.exists() else None
            require(
                completed.returncode != 0
                and result_value is not None
                and result_value["status"] == "INVALID_INPUT"
                and result_value["error_code"] == expected_code
                and not evidence_path.exists()
                and not source_child_marker.exists()
                and not any(os.scandir(workspace)),
                f"source declaration {name} crossed the child boundary: {result_value!r}",
            )
            invalid_result_path.unlink()

