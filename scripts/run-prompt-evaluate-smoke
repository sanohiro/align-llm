#!/usr/bin/env python3
"""Build a two-task fixed corpus and verify the evaluator-produced artifact pair."""

from __future__ import annotations

import copy
import hashlib
import importlib.util
import json
import os
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path


SOURCE = Path(__file__).resolve().parent.parent
ALIGNC = SOURCE / "scripts" / "alignc"
GIT = Path("/usr/bin/git")
PYTHON = Path("/usr/bin/python3").resolve(strict=True)


def canonical(value):
    return json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode()


def canonical_digest_item(value):
    if isinstance(value, dict):
        return {key: canonical_digest_item(child) for key, child in value.items() if child is not None}
    if isinstance(value, list):
        return [canonical_digest_item(child) for child in value]
    return value


def bind(value):
    value["content_sha256"] = ""
    value["content_sha256"] = hashlib.sha256(canonical(canonical_digest_item(value))).hexdigest()
    return value


def store(project: Path, relative: str, value):
    path = project / relative
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(canonical(value))
    return value


def text(kind: str, identifier: str, value: str):
    return bind({
        "schema_version": 1, "artifact_kind": kind, "artifact_id": identifier,
        "text": value, "content_sha256": "",
    })


def variant(identifier: str, candidate: str, base, repo, learned: str):
    return bind({
        "schema_version": 1, "artifact_kind": "PROMPT_VARIANT", "variant_id": identifier,
        "base_prompt": base, "repo_prompt": repo, "learned_prompt_append": learned,
        "context_policy": {
            "include_patch_evaluation": False, "include_failure_memory": False,
            "include_diagnostics": False, "max_patch_evaluation_bytes": 0,
            "max_failure_events": 0, "max_failure_context_bytes": 0,
            "max_diagnostic_bytes_per_stream": 0,
        },
        "candidate_id": candidate, "content_sha256": "",
    })


def reference(kind: str, path: str, identifier: str, digest: str):
    return {"artifact_kind": kind, "path": path, "artifact_id": identifier, "content_sha256": digest}


def raw_digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def file_expectation_digest(project: Path, relative: str) -> str:
    path = project / relative
    metadata = path.stat()
    mode = f"{stat.S_IFMT(metadata.st_mode) | stat.S_IMODE(metadata.st_mode):06o}"
    return hashlib.sha256(
        f"{mode} {relative}".encode() + b"\0F " + raw_digest(path).encode() + b"\n"
    ).hexdigest()


def git_head(path: Path) -> str:
    return subprocess.run(
        [str(GIT), "-C", str(path), "rev-parse", "HEAD"], text=True,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True,
    ).stdout.strip()


def require(condition, message):
    if not condition:
        raise RuntimeError(message)


def load_result(path: Path, label: str):
    try:
        return json.loads(path.read_text())
    except OSError as error:
        raise RuntimeError(f"{label} did not publish a result artifact") from error


def verify_compact_overflow_boundary() -> None:
    module_path = SOURCE / "scripts" / "prompt-evaluate.py"
    spec = importlib.util.spec_from_file_location("prompt_evaluate_boundary", module_path)
    require(spec is not None and spec.loader is not None, "evaluator helper could not be loaded")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    streaming = {"payload": "\\\"\n\u00e9" * 400_000, "optional": None, "content_sha256": ""}
    chunks = list(module.canonical_chunks(streaming, omit_mapping_none=True))
    require(
        max(map(len, chunks)) <= module.CANONICAL_STRING_CHUNK * 6
        and b"".join(chunks) == canonical(canonical_digest_item(streaming)),
        "canonical digest stream changed bytes or exceeded its chunk bound",
    )
    expected_streaming_digest = hashlib.sha256(b"".join(chunks)).hexdigest()
    original_digest_bytes = module.canonical_digest_bytes
    try:
        module.canonical_digest_bytes = lambda _value: (_ for _ in ()).throw(
            RuntimeError("whole digest materialization was used")
        )
        module.bind(streaming)
    finally:
        module.canonical_digest_bytes = original_digest_bytes
    require(
        streaming["content_sha256"] == expected_streaming_digest,
        "result binding did not use the bounded canonical digest stream",
    )
    request_record = bind({
        "schema_version": 1,
        "artifact_kind": "WORKSPACE_PREFLIGHT_REQUEST",
        "content_sha256": "",
    })
    result_record = bind({
        "schema_version": 1,
        "artifact_kind": "WORKSPACE_PREFLIGHT_RESULT",
        "content_sha256": "",
    })
    attestation = bind({
        "schema_version": 1,
        "artifact_kind": "RUN_SNAPSHOT_ATTESTATION",
        "content_sha256": "",
    })
    oversized = {
        "evaluation_id": "overflow-evaluation",
        "scope": {"scope": "retained"},
        "sample_count": 2,
        "workspace_preflight_request": request_record,
        "workspace_preflight": result_record,
        "snapshot_requests": [],
        "snapshot_results": [],
        "input_snapshots": [],
        "snapshot_attestations": [attestation],
        "tasks": [{"padding": "x" * 128}],
        "rows": [],
        "task_aggregates": [],
        "serious_regression_reasons": [],
    }
    expected_inputs = [{"retained": False}]
    require(not module.canonical_fits(oversized, 32), "oversized-result detector accepted a cap breach")
    crossing = copy.deepcopy(oversized)
    crossing["tasks"][0]["padding"] = "x" * 4096
    unbound_size = len(module.canonical(crossing))
    bound_crossing_cap = unbound_size + 16
    require(
        module.canonical_fits(crossing, bound_crossing_cap),
        "digest-crossing fixture did not fit before binding",
    )
    original_result_limit = module.RESULT_LIMIT
    try:
        module.RESULT_LIMIT = bound_crossing_cap
        persisted, _ = module.prepare_pair(crossing, {}, [])
    finally:
        module.RESULT_LIMIT = original_result_limit
    require(
        persisted["error_code"] == "RESULT_TOO_LARGE"
        and len(module.canonical(persisted)) <= bound_crossing_cap,
        "final digest expansion did not select the compact result",
    )
    module.compact_oversized_result(oversized, expected_inputs)
    trace_preimage = (
        f"1 WORKSPACE_PREFLIGHT_REQUEST {request_record['content_sha256']}\n"
        f"2 WORKSPACE_PREFLIGHT_RESULT {result_record['content_sha256']}\n"
        f"3 RUN_SNAPSHOT_ATTESTATION {attestation['content_sha256']}\n"
    ).encode()
    trace = oversized["trace_failure"]
    require(
        oversized["status"] == "ERROR"
        and oversized["error_code"] == "RESULT_TOO_LARGE"
        and oversized["scope"] == {"scope": "retained"}
        and oversized["tasks"] == []
        and oversized["rows"] == []
        and oversized["environment"] is None
        and trace["attempted_invocation_count"] == 1
        and trace["trace_record_count"] == 3
        and trace["trace_digest_sha256"] == hashlib.sha256(trace_preimage).hexdigest()
        and expected_inputs == [],
        "compact oversized-result envelope changed",
    )


def verify_descendant_cleanup_boundary() -> None:
    module_path = SOURCE / "scripts" / "prompt-evaluate.py"
    spec = importlib.util.spec_from_file_location("prompt_evaluate_descendants", module_path)
    require(spec is not None and spec.loader is not None, "evaluator helper could not be loaded")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    source = module_path.read_text()
    require(
        module.nested_owner_timeout(30_000_000_000) == 35_000_000_000
        and module.SNAPSHOT_HELPER_OUTER_TIMEOUT_NS >= 2 * 12_000_000_000 + module.CHILD_CLEANUP_MARGIN_NS
        and module.SOURCE_VERIFIER_OUTER_TIMEOUT_NS >= 9 * 12_000_000_000 + module.CHILD_CLEANUP_MARGIN_NS
        and source.count("nested_owner_timeout(task[\"timeout_ns\"])") == 1
        and "nested_owner_timeout(max(task[\"timeout_ns\"], provider_timeout_ns))" in source
        and "SOURCE_VERIFIER_OUTER_TIMEOUT_NS" in source,
        "nested child owners lost their cleanup/report deadline margin",
    )
    original_cleanup = module.cleanup_process_group
    cleanup_calls = 0

    def counted_cleanup(process, maximum_seconds=2.0):
        nonlocal cleanup_calls
        cleanup_calls += 1
        return original_cleanup(process, maximum_seconds)

    module.cleanup_process_group = counted_cleanup
    with tempfile.TemporaryDirectory(prefix="prompt-descendant-") as directory:
        marker = Path(directory) / "survived"
        child = f"import pathlib,time;time.sleep(0.6);pathlib.Path({str(marker)!r}).write_text('x')"
        parent = (
            "import subprocess,sys,time;"
            f"subprocess.Popen([sys.executable,'-c',{child!r}],start_new_session=True);"
            "time.sleep(5)"
        )
        try:
            module.run_child([sys.executable, "-c", parent], SOURCE, {}, 200_000_000, 0)
            raise RuntimeError("timed child unexpectedly completed")
        except module.ChildBoundaryError as failure:
            require(failure.reason == "TIMEOUT", "descendant fixture returned the wrong failure")
        require(cleanup_calls == 1, "timed evaluator child cleanup was not exactly once")
        time.sleep(0.8)
        require(not marker.exists(), "timed evaluator child left a live descendant")

        cleanup_calls = 0
        marker = Path(directory) / "post-exit-survived"
        child = f"import pathlib,time;time.sleep(0.6);pathlib.Path({str(marker)!r}).write_text('x')"
        parent = (
            "import subprocess,sys;"
            f"subprocess.Popen([sys.executable,'-c',{child!r}],"
            "stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)"
        )
        try:
            module.run_child([sys.executable, "-c", parent], SOURCE, {}, 2_000_000_000, 0)
            raise RuntimeError("parent with a live descendant unexpectedly completed")
        except module.ChildBoundaryError as failure:
            require(failure.reason == "PROCESS", "post-exit descendant returned the wrong failure")
        require(cleanup_calls == 1, "post-exit evaluator child cleanup was not exactly once")
        time.sleep(0.8)
        require(not marker.exists(), "successful evaluator parent left a live descendant")


def verify_workspace_ownership_boundary() -> None:
    module_path = SOURCE / "scripts" / "prompt-evaluate.py"
    spec = importlib.util.spec_from_file_location("prompt_evaluate_ownership", module_path)
    require(spec is not None and spec.loader is not None, "evaluator helper could not be loaded")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    with tempfile.TemporaryDirectory(prefix="prompt-ownership-") as directory:
        root = Path(directory)
        current = [root / f"current-{kind}.json" for kind in ("variant", "rendered", "request", "measurement")]
        future = root / "future-variant.json"
        require(
            module.invocation_workspace_entries(*current) == sorted(path.name for path in current)
            and future.name not in module.invocation_workspace_entries(*current),
            "workspace admission was not limited to the exact current invocation",
        )
        stale = root / "retired.json"
        stale.write_text("owned")
        owned = {stale}
        require(module.retire_owned_path(stale, owned) and not owned, "removed path retained stale ownership")
        stale.write_text("competitor")
        require(module.retire_owned_path(stale, owned), "retired path did not remain retired")
        require(not module.cleanup_owned_paths(owned), "empty ownership set reported a survivor")
        require(stale.read_text() == "competitor", "retired ownership removed a competing replacement")
        occupied = root / "occupied-result.json"
        occupied.write_text("competitor")
        try:
            module.create_owned_output(occupied, owned)
            raise RuntimeError("occupied child result path was created")
        except FileExistsError:
            pass
        require(not owned and occupied.read_text() == "competitor", "child result collision acquired ownership")
        created = root / "created-result.json"
        descriptor = module.create_owned_output(created, owned)
        require(created in owned, "successful child result creation did not acquire ownership")
        os.close(descriptor)
        require(module.retire_owned_path(created, owned) and not owned, "child result ownership did not retire")
        created.write_text("late competitor")
        require(module.cleanup_owned_paths(owned) == [] and created.read_text() == "late competitor",
                "retired child result name removed a late competitor")


def verify_source_envelope_boundary() -> None:
    module_path = SOURCE / "scripts" / "prompt-evaluate.py"
    spec = importlib.util.spec_from_file_location("prompt_evaluate_source_envelope", module_path)
    require(spec is not None and spec.loader is not None, "evaluator helper could not be loaded")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    unavailable = {
        "schema_version": 1,
        "artifact_kind": "PROMPT_SOURCE_VERIFIER_RESULT",
        "status": "UNAVAILABLE",
        "error_code": "GIT_UNAVAILABLE",
        "error": "fixed Git command is unavailable",
        "align_llm_reachability": "UNVERIFIED",
        "align_llm_observed_head": None,
        "align_reachability": "UNVERIFIED",
        "align_observed_revision": None,
        "corpus_reachability": "UNVERIFIED",
        "corpus_observed_source_sha256": None,
        "content_sha256": "a" * 64,
    }
    require(module.valid_source_observation(unavailable), "canonical unavailable source envelope was rejected")
    mutations = []
    for name, value in (
        ("error_code", "OTHER"),
        ("error", ""),
        ("error", "x" * 4097),
        ("align_llm_reachability", "VERIFIED"),
        ("align_llm_observed_head", "a" * 40),
        ("align_reachability", "VERIFIED"),
        ("align_observed_revision", "b" * 40),
        ("corpus_reachability", "VERIFIED"),
        ("corpus_observed_source_sha256", "c" * 64),
    ):
        changed = dict(unavailable)
        changed[name] = value
        mutations.append(changed)
    reordered = dict(unavailable)
    reordered["status"] = reordered.pop("status")
    mutations.append(reordered)
    extra = dict(unavailable)
    extra["unexpected"] = None
    mutations.append(extra)
    require(
        all(not module.valid_source_observation(value) for value in mutations),
        "malformed unavailable source envelope was accepted",
    )


def verify_reviewed_execution_boundary() -> None:
    module_path = SOURCE / "scripts" / "prompt-evaluate.py"
    spec = importlib.util.spec_from_file_location("prompt_evaluate_reviewed_execution", module_path)
    require(spec is not None and spec.loader is not None, "evaluator helper could not be loaded")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)

    environment_probe = module.bind({
        "schema_version": 1, "artifact_kind": "ENVIRONMENT_PROBE", "producer": "SNAPSHOT_HELPER",
        "os": "linux", "os_release": "test", "architecture": "x86_64", "cpu": "test",
        "logical_cpu_count": 1, "gpu": "none", "runtime_identity": "PYTHON:test",
        "content_sha256": "",
    })
    artifact_digest = {"path": "input", "mode": "100644", "byte_count": 1, "sha256": "a" * 64}
    snapshot = module.bind({
        "schema_version": 1, "artifact_kind": "SNAPSHOT_RESULT", "task_id": "task",
        "status": "MATCH", "error_code": "NONE", "error": "",
        "environment_probe": environment_probe, "artifact_digests": [artifact_digest],
        "content_sha256": "",
    })
    with tempfile.TemporaryDirectory(prefix="prompt-snapshot-binding-") as directory:
        project = Path(directory)
        (project / "input").write_text("x")
        (project / "extra").write_text("y")
        snapshot_request = {
            "static_expectations": [{"path": "input", "kind": "FILE", "expected_sha256": "b" * 64}],
            "additional_files": ["extra"],
        }
        snapshot["artifact_digests"].append({
            "path": "extra", "mode": "100644", "byte_count": 1, "sha256": "c" * 64,
        })
        module.bind(snapshot)
        require(
            module.valid_snapshot_result(snapshot, "task", snapshot_request, project),
            "canonical snapshot result was rejected",
        )
        empty = copy.deepcopy(snapshot)
        empty["artifact_digests"] = []
        module.bind(empty)
        require(
            not module.valid_snapshot_result(empty, "task", snapshot_request, project),
            "empty snapshot observation was accepted",
        )
        for label, digests in (
            ("missing", snapshot["artifact_digests"][:-1]),
            ("extra", snapshot["artifact_digests"] + [{
                "path": "unrelated", "mode": "100644", "byte_count": 1, "sha256": "d" * 64,
            }]),
            ("reordered", list(reversed(snapshot["artifact_digests"]))),
            ("unrelated", [snapshot["artifact_digests"][0], {
                "path": "unrelated", "mode": "100644", "byte_count": 1, "sha256": "d" * 64,
            }]),
        ):
            malformed_digests = copy.deepcopy(snapshot)
            malformed_digests["artifact_digests"] = digests
            module.bind(malformed_digests)
            require(
                not module.valid_snapshot_result(malformed_digests, "task", snapshot_request, project),
                f"{label} snapshot digest array was accepted",
            )
        for mutation in ("missing", "extra", "reordered"):
            malformed = dict(snapshot)
            if mutation == "missing":
                malformed.pop("environment_probe")
            elif mutation == "extra":
                malformed["unexpected"] = None
            else:
                malformed["status"] = malformed.pop("status")
            module.bind(malformed)
            require(
                not module.valid_snapshot_result(malformed, "task", snapshot_request, project),
                f"semantically malformed {mutation} snapshot result was accepted",
            )
    malformed_measurement = module.bind({
        "schema_version": 1, "artifact_kind": "TASK_MEASUREMENT", "status": "PASS",
        "content_sha256": "",
    })
    require(
        not module.valid_task_measurement(
            malformed_measurement, {"task_id": "task"}, "b" * 64,
            {"task_id": "task", "sample_index": 1, "paired_seed": 7}, 1, 7,
        ),
        "semantically incomplete measurement was accepted",
    )

    policy = {
        "allowed_variables": [
            {"name": "LANG", "non_secret_value": "C", "source": "EXPLICIT_POLICY", "precedence": 0},
            {"name": "LC_ALL", "non_secret_value": "C", "source": "EXPLICIT_POLICY", "precedence": 1},
        ],
        "executable_paths": ["/usr/bin/python3"],
        "locale": "C",
    }
    require(module.child_environment(policy) == {"LANG": "C", "LC_ALL": "C"}, "valid environment policy changed")
    for label, mutate in (
        ("non-ASCII name", lambda value: value["allowed_variables"][0].update(name="LÄNG")),
        ("ambient source", lambda value: value["allowed_variables"][0].update(source="AMBIENT")),
        ("locale disagreement", lambda value: value["allowed_variables"][1].update(non_secret_value="C.UTF-8")),
        ("executable aggregate", lambda value: value.update(executable_paths=["/" + "x" * 4095] * 17)),
    ):
        invalid = copy.deepcopy(policy)
        mutate(invalid)
        try:
            module.child_environment(invalid)
            raise RuntimeError(f"{label} environment policy was accepted")
        except module.EvaluationError:
            pass

    with tempfile.TemporaryDirectory(prefix="prompt-automatic-inputs-") as directory:
        project = Path(directory)
        request = {
            "experiment_path": "inputs/experiment.json",
            "parent_activation_path": "inputs/parent.json",
            "corpus_path": "inputs/corpus.json",
            "acceptance_policy_path": "inputs/acceptance.json",
            "workspace_preflight_path": "inputs/preflight.json",
            "verifier_source_policy_path": "inputs/source-policy.json",
        }
        task_file = "inputs/task.json"
        task = {
            "generation_policy_path": "inputs/generation.json",
            "provider_control_path": "inputs/provider.json",
            "environment_policy_path": "inputs/environment.json",
            "task_prompt_path": "inputs/task-prompt.json",
            "context_sources_path": "inputs/context.json",
        }
        expected = sorted({
            *request.values(), ".align-revision", task_file, *task.values(),
        }, key=os.fsencode)
        for relative in expected:
            path = project / relative
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(relative)
        observed = module.automatic_snapshot_files(request, task_file, task, project)
        require(observed == expected, "automatic identity-bearing snapshot set changed")
        for relative in observed:
            path = project / relative
            original = path.read_bytes()
            before = raw_digest(path)
            path.write_bytes(original + b"x")
            require(raw_digest(path) != before, f"automatic snapshot input mutation was invisible: {relative}")
            path.write_bytes(original)

    require(
        module.classify_task_drift(environment_probe, [artifact_digest], environment_probe, [artifact_digest]) == "NONE",
        "stable cross-invocation task identity drifted",
    )
    changed_probe = dict(environment_probe)
    changed_probe["runtime_identity"] = "PYTHON:changed"
    module.bind(changed_probe)
    require(
        module.classify_task_drift(changed_probe, [artifact_digest], environment_probe, [artifact_digest])
        == "ENVIRONMENT_DRIFT",
        "cross-invocation environment drift was not classified",
    )
    changed_artifact = dict(artifact_digest)
    changed_artifact["sha256"] = "b" * 64
    require(
        module.classify_task_drift(environment_probe, [changed_artifact], environment_probe, [artifact_digest])
        == "INPUT_DRIFT",
        "cross-invocation input drift was not classified",
    )
    require(len(module.validated_task_files([f"task-{index}" for index in range(64)])) == 64,
            "exact task-file count cap was rejected")
    try:
        module.validated_task_files([f"task-{index}" for index in range(65)])
        raise RuntimeError("task-file count cap plus one was accepted")
    except module.EvaluationError:
        pass

    with tempfile.TemporaryDirectory(prefix="prompt-reviewed-source-") as directory:
        root = Path(directory)
        project = root / "project"
        source = root / "source"
        for base in (project, source):
            (base / "scripts").mkdir(parents=True)
            (base / "scripts/prompt-fixed-adapter.py").write_text("reviewed adapter")
            (base / "scripts/prompt-snapshot-helper.py").write_text("reviewed snapshot")
        tasks = [{
            "argv": ["/usr/bin/python3", "scripts/prompt-fixed-adapter.py"],
            "snapshot_argv": ["/usr/bin/python3", "scripts/prompt-snapshot-helper.py"],
            "artifacts": [
            {"path": "scripts/prompt-fixed-adapter.py", "kind": "FILE",
             "expected_sha256": file_expectation_digest(project, "scripts/prompt-fixed-adapter.py")},
            {"path": "scripts/prompt-snapshot-helper.py", "kind": "FILE",
             "expected_sha256": file_expectation_digest(project, "scripts/prompt-snapshot-helper.py")},
            ],
        }]
        request = {"verifier_corpus_source_path": str(source)}
        module.verify_task_source_membership(request, tasks, project)
        (project / "workspace/scripts").mkdir(parents=True)
        (project / "workspace/scripts/prompt-fixed-adapter.py").write_text("cwd-controlled adapter")
        command_task = {
            "cmd": "/usr/bin/python3",
            "argv": ["/usr/bin/python3", "scripts/prompt-fixed-adapter.py"],
            "measurement_adapter_runtime": "PYTHON:" + raw_digest(project / "scripts/prompt-fixed-adapter.py"),
        }
        argv, retained = module.command(command_task, "argv", project)
        try:
            require(
                argv[1] == retained.process_path()
                and retained.sha256() == raw_digest(project / "scripts/prompt-fixed-adapter.py"),
                "task helper was resolved relative to its task cwd",
            )
        finally:
            retained.close()
        (project / "scripts/prompt-fixed-adapter.py").write_text("attacker-controlled adapter")
        try:
            module.verify_task_source_membership(request, tasks, project)
            raise RuntimeError("project-local task code escaped reviewed-source membership")
        except module.EvaluationError:
            pass

    with tempfile.TemporaryDirectory(prefix="prompt-tree-caps-") as directory:
        project = Path(directory)
        exact_entries = project / "exact-entries"
        exact_entries.mkdir()
        for index in range(127):
            (exact_entries / f"entry-{index:03d}").write_bytes(b"")
        _, entry_count, byte_count = module.bounded_declared_tree(project, "exact-entries")
        require(entry_count == 128 and byte_count == 0, "exact TREE entry cap was rejected")
        (exact_entries / "entry-127").write_bytes(b"")
        try:
            module.bounded_declared_tree(project, "exact-entries")
            raise RuntimeError("TREE entry cap plus one was accepted")
        except module.EvaluationError:
            pass

        exact_bytes = project / "exact-bytes"
        exact_bytes.mkdir()
        payload = exact_bytes / "payload"
        payload.write_bytes(b"x" * module.ARTIFACT_LIMIT)
        _, entry_count, byte_count = module.bounded_declared_tree(project, "exact-bytes")
        require(entry_count == 2 and byte_count == module.ARTIFACT_LIMIT,
                "exact TREE byte cap was rejected")
        payload.write_bytes(b"x" * (module.ARTIFACT_LIMIT + 1))
        try:
            module.bounded_declared_tree(project, "exact-bytes")
            raise RuntimeError("TREE byte cap plus one was accepted")
        except module.EvaluationError:
            pass


def file_set_manifest(root: Path, paths: list[str]) -> bytes:
    records = []
    for relative in paths:
        path = root / relative
        metadata = path.stat()
        mode = stat.S_IFMT(metadata.st_mode) | stat.S_IMODE(metadata.st_mode)
        raw_path = relative.encode()
        records.append(
            f"{mode:o} {len(raw_path)} ".encode() + raw_path + b"\0F "
            + raw_digest(path).encode() + b"\n"
        )
    return b"ALIGN-LLM-CORPUS-FILE-SET-V1\n" + str(len(records)).encode() + b"\n" + b"".join(records)


def verify_strict_source_membership_boundary() -> None:
    module_path = SOURCE / "scripts/prompt-evaluate.py"
    spec = importlib.util.spec_from_file_location("prompt_evaluate_strict_source", module_path)
    require(spec is not None and spec.loader is not None, "strict source evaluator could not be loaded")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    def fixture_run_child(argv, cwd, environment, timeout_ns, cap, pass_fds=()):
        completed = subprocess.run(
            argv, cwd=cwd, env=dict(environment), stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, pass_fds=pass_fds,
            timeout=timeout_ns / 1_000_000_000, check=False,
        )
        if len(completed.stdout) > cap or len(completed.stderr) > cap:
            raise module.ChildBoundaryError("OUTPUT")
        return completed
    module.run_child = fixture_run_child
    with tempfile.TemporaryDirectory(prefix="prompt-strict-source-") as directory:
        root = Path(directory)
        source = root / "source"
        project = root / "project"
        for relative, text_value in (
            ("scripts/prompt-fixed-adapter.py", "reviewed adapter"),
            ("scripts/prompt-snapshot-helper.py", "reviewed snapshot"),
            ("tasks/task.json", "reviewed task"),
        ):
            path = source / relative
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(text_value)
        subprocess.run([str(GIT), "init", "-q", str(source)], check=True)
        subprocess.run([str(GIT), "-C", str(source), "add", "."], check=True)
        subprocess.run(
            [str(GIT), "-C", str(source), "-c", "user.name=fixture", "-c", "user.email=fixture@example.invalid",
             "commit", "-qm", "fixture"],
            check=True,
        )
        revision = subprocess.run(
            [str(GIT), "-C", str(source), "rev-parse", "HEAD"], text=True,
            stdout=subprocess.PIPE, check=True,
        ).stdout.strip()
        shutil.copytree(source, project, ignore=shutil.ignore_patterns(".git"))
        tasks = [{
            "argv": ["/usr/bin/python3", "scripts/prompt-fixed-adapter.py"],
            "snapshot_argv": ["/usr/bin/python3", "scripts/prompt-snapshot-helper.py"],
            "artifacts": [
                {"path": relative, "kind": "FILE", "expected_sha256": file_expectation_digest(project, relative)}
                for relative in ("scripts/prompt-fixed-adapter.py", "scripts/prompt-snapshot-helper.py")
            ],
        }]
        trust = {"corpus_reachability": "VERIFIED"}
        request = {
            "verifier_corpus_source_path": str(source), "verifier_corpus_source_kind": "GIT_COMMIT",
            "verifier_corpus_source_sha256": revision, "verifier_git_executable_path": str(GIT),
        }
        policy = {"git_executable_sha256": raw_digest(GIT)}
        environment = {"LANG": "C", "LC_ALL": "C"}
        module.verify_task_source_membership(
            request, tasks, project, ["tasks/task.json"], policy, trust, environment,
        )
        tracked_path = "scripts/prompt-fixed-adapter.py"
        for base in (source, project):
            (base / tracked_path).write_text("mutable source tree adapter")
        mutable_tasks = copy.deepcopy(tasks)
        mutable_tasks[0]["artifacts"][0]["expected_sha256"] = file_expectation_digest(project, tracked_path)
        try:
            module.verify_task_source_membership(
                request, mutable_tasks, project, ["tasks/task.json"], policy, trust, environment,
            )
            raise RuntimeError("dirty source-tree bytes were accepted as the committed Git blob")
        except module.EvaluationError:
            pass
        for base in (source, project):
            (base / tracked_path).write_text("reviewed adapter")
        for base in (source, project):
            (base / "scripts/ignored.py").write_text("ignored helper")
        ignored_tasks = copy.deepcopy(tasks)
        ignored_tasks[0]["argv"][1] = "scripts/ignored.py"
        ignored_tasks[0]["artifacts"].append({
            "path": "scripts/ignored.py", "kind": "FILE",
            "expected_sha256": file_expectation_digest(project, "scripts/ignored.py"),
        })
        try:
            module.verify_task_source_membership(
                request, ignored_tasks, project, ["tasks/task.json"], policy, trust, environment,
            )
            raise RuntimeError("ignored Git helper was accepted as reviewed source")
        except module.EvaluationError:
            pass
        for base in (source, project):
            (base / "tasks/untracked.json").write_text("untracked task")
        try:
            module.verify_task_source_membership(
                request, tasks, project, ["tasks/untracked.json"], policy, trust, environment,
            )
            raise RuntimeError("untracked Git task manifest was accepted")
        except module.EvaluationError:
            pass

        members = [
            "scripts/prompt-fixed-adapter.py", "scripts/prompt-snapshot-helper.py", "tasks/task.json",
        ]
        manifest = root / "corpus.files"
        manifest.write_bytes(file_set_manifest(source, members))
        file_set_request = {
            "verifier_corpus_source_path": str(source), "verifier_corpus_source_kind": "FILE_SET",
            "verifier_corpus_source_sha256": raw_digest(manifest),
            "verifier_corpus_file_set_manifest_path": str(manifest),
        }
        module.verify_task_source_membership(
            file_set_request, tasks, project, ["tasks/task.json"], None, trust, None,
        )
        manifest.write_bytes(file_set_manifest(source, members[1:]))
        file_set_request["verifier_corpus_source_sha256"] = raw_digest(manifest)
        try:
            module.verify_task_source_membership(
                file_set_request, tasks, project, ["tasks/task.json"], None, trust, None,
            )
            raise RuntimeError("unlisted file-set helper was accepted")
        except module.EvaluationError:
            pass
        manifest.write_bytes(file_set_manifest(source, members))
        file_set_request["verifier_corpus_source_sha256"] = raw_digest(manifest)
        project_adapter = project / "scripts/prompt-fixed-adapter.py"
        original_mode = stat.S_IMODE(project_adapter.stat().st_mode)
        project_adapter.chmod(0o755)
        try:
            module.verify_task_source_membership(
                file_set_request, tasks, project, ["tasks/task.json"], None, trust, None,
            )
            raise RuntimeError("reviewed source mode mismatch was accepted")
        except module.EvaluationError:
            pass
        finally:
            project_adapter.chmod(original_mode)
        manifest.write_bytes(file_set_manifest(source, members[:-1]))
        file_set_request["verifier_corpus_source_sha256"] = raw_digest(manifest)
        try:
            module.verify_task_source_membership(
                file_set_request, tasks, project, ["tasks/task.json"], None, trust, None,
            )
            raise RuntimeError("unlisted file-set task manifest was accepted")
        except module.EvaluationError:
            pass


def verify_complete_score_boundary() -> None:
    module_path = SOURCE / "scripts/prompt-evaluate.py"
    spec = importlib.util.spec_from_file_location("prompt_evaluate_score", module_path)
    require(spec is not None and spec.loader is not None, "score evaluator could not be loaded")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    task = {
        "task_id": "task", "regression_limits": {
            "maximum_unrelated_diff_count": 0, "maximum_patch_size_bytes": 1_000,
            "maximum_public_api_change_count": 0, "maximum_repair_loops": 2,
            "maximum_benchmark_regression_ppm": None,
        },
    }
    policy = {
        "maximum_repair_loop_regression_count": 0, "maximum_time_regression_ppm": 100_000,
        "minimum_completion_gain_count": 1, "minimum_time_improvement_ppm": 100_000,
        "minimum_task_count": 1, "minimum_samples_per_variant": 1,
    }
    trust = {name: "VERIFIED" for name in (
        "align_llm_reachability", "align_reachability", "corpus_reachability",
    )}
    environment = {"core": {"logical_cpu_count": 1}}

    def measurement(status: str) -> dict:
        passed = status == "PASS"
        return {
            "status": status, "build_status": "PASS" if passed else "FAIL",
            "test_status": "PASS" if passed else "FAIL", "repair_loop_count": 0,
            "unrelated_diff_count": 0, "patch_size_bytes": 1, "public_api_change_count": 0,
            "benchmark_regression_ppm": None, "seed_attestation": {"result": "APPLIED"},
        }

    def rows(parent: str, candidate: str, parent_time: int = 100, candidate_time: int = 100) -> list[dict]:
        return [
            {"task_id": "task", "sample_index": 1, "variant": "PARENT",
             "time_to_passing_patch_ns": parent_time if parent == "PASS" else None,
             "measurement": measurement(parent)},
            {"task_id": "task", "sample_index": 1, "variant": "CANDIDATE",
             "time_to_passing_patch_ns": candidate_time if candidate == "PASS" else None,
             "measurement": measurement(candidate)},
        ]

    improved = module.complete_score([task], rows("FAIL", "PASS"), 1, policy, trust, environment, {"provider_kind": "LIVE"})
    unchanged = module.complete_score([task], rows("PASS", "PASS"), 1, policy, trust, environment, {"provider_kind": "FIXTURE"})
    faster = module.complete_score([task], rows("PASS", "PASS", 100, 50), 1, policy, trust, environment, {"provider_kind": "LIVE"})
    regressed = module.complete_score([task], rows("PASS", "FAIL"), 1, policy, trust, environment, {"provider_kind": "LIVE"})
    task_limited_rows = rows("PASS", "PASS")
    task_limited_rows[1]["measurement"]["patch_size_bytes"] = 1_001
    task_limited = module.complete_score(
        [task], task_limited_rows, 1, policy, trust, environment, {"provider_kind": "LIVE"},
    )
    corpus_limited_rows = rows("PASS", "PASS")
    corpus_limited_rows[1]["measurement"]["repair_loop_count"] = 1
    corpus_limited = module.complete_score(
        [task], corpus_limited_rows, 1, policy, trust, environment, {"provider_kind": "LIVE"},
    )
    require(improved[0] == "IMPROVED" and improved[1], "completion improvement was not gate eligible")
    require(unchanged[0] == "NO_IMPROVEMENT" and not unchanged[1], "unchanged score was improved")
    require(faster[0] == "IMPROVED" and faster[1], "time improvement was not gate eligible")
    require(
        regressed[0] == "SERIOUS_REGRESSION"
        and [item["code"] for item in regressed[4]][:3] == ["PASS_TO_FAIL", "BUILD", "TEST"],
        "serious regression reason ordering changed",
    )
    require(task_limited[4][0]["code"] == "PATCH_SIZE", "task limit regression was not scored")
    require(
        corpus_limited[4][0]["task_id"] == "CORPUS"
        and corpus_limited[4][0]["code"] == "REPAIR_LOOPS",
        "corpus limit regression was not scored first",
    )


def copy_runtime(project: Path) -> None:
    for relative in (
        ".align-revision",
        "scripts/prompt-evaluate.py", "scripts/prompt-fixed-adapter.py", "scripts/prompt-snapshot-helper.py",
        "scripts/prompt-source-verifier.py", "eval/runners/run-coding-task.py",
        "eval/tasks/coding-v1/python-inclusive-range/task.json",
        "eval/baselines/patches/python-inclusive-range.patch",
        "eval/baselines/patches/python-inclusive-range-parent.patch",
    ):
        destination = project / relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(SOURCE / relative, destination)
    shutil.copytree(
        SOURCE / "eval/fixtures/python-inclusive-range-v1",
        project / "eval/fixtures/python-inclusive-range-v1",
    )


