        require(
            result_path.exists(),
            f"cross-invocation drift did not publish: stdout={cross_invocation.stdout!r}; "
            f"stderr={cross_invocation.stderr!r}",
        )
        cross_invocation_result = load_result(result_path, "cross-invocation environment drift")
        require(
            cross_invocation.returncode != 0
            and cross_invocation_result["error_code"] == "ENVIRONMENT_DRIFT"
            and cross_invocation_result["snapshot_attestations"][-1]["status"] == "PRECHECK_DRIFT"
            and evidence_path.exists(),
            "stable-between-invocation environment drift was scored",
        )
        result_path.unlink()
        evidence_path.unlink()
        for task_path, task_document in zip(task_files, original_task_documents):
            store(project, task_path, task_document)

        malformed_snapshot_helper = project / "scripts/malformed-snapshot-helper.py"
        malformed_snapshot_source = (project / "scripts/prompt-snapshot-helper.py").read_text().replace(
            "            result = snapshot(request)\n",
            "            result = snapshot(request)\n"
            "            result.pop('environment_probe')\n"
            "            bind_digest(result)\n",
            1,
        )
        require(
            malformed_snapshot_source != (project / "scripts/prompt-snapshot-helper.py").read_text(),
            "malformed snapshot result fixture did not patch",
        )
        malformed_snapshot_helper.write_text(malformed_snapshot_source)
        malformed_snapshot_helper.chmod(0o755)
        reviewed_malformed_snapshot = reviewed_source / "scripts/malformed-snapshot-helper.py"
        reviewed_malformed_snapshot.write_text(malformed_snapshot_source)
        reviewed_malformed_snapshot.chmod(0o755)
        malformed_snapshot_digest = raw_digest(malformed_snapshot_helper)
        for task_path in task_files:
            task_document = json.loads((project / task_path).read_text())
            task_document["snapshot_argv"] = ["/usr/bin/python3", "scripts/malformed-snapshot-helper.py"]
            task_document["snapshot_helper_runtime"] = "PYTHON:" + malformed_snapshot_digest
            task_document["artifacts"].append({
                "path": "scripts/malformed-snapshot-helper.py", "kind": "FILE",
                "expected_sha256": file_expectation_digest(project, "scripts/malformed-snapshot-helper.py"),
            })
            bind(task_document)
            store(project, task_path, task_document)
        malformed_snapshot = subprocess.run(
            [str(build_root / "main"), "prompt", "evaluate", str(request_path), "result.json"],
            cwd=project, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
        malformed_snapshot_result = load_result(result_path, "malformed snapshot result")
        require(
            malformed_snapshot.returncode != 0
            and malformed_snapshot_result["error_code"] == "SNAPSHOT_ERROR"
            and malformed_snapshot_result["snapshot_attestations"][0]["status"] == "PRECHECK_FAILED"
            and evidence_path.exists(),
            "digest-valid malformed snapshot result suppressed its terminal pair",
        )
        result_path.unlink()
        evidence_path.unlink()
        for task_path, task_document in zip(task_files, original_task_documents):
            store(project, task_path, task_document)

        drifting_adapter = project / "scripts/drifting-adapter.py"
        drifted_task_prompt = project / "artifacts/task-prompt-1.json"
        original_task_prompt = drifted_task_prompt.read_bytes()
        drifting_source = (project / "scripts/prompt-fixed-adapter.py").read_text().replace(
            "        else:\n            write_retained_result(values.result, values.result_fd, result)\n        return 0\n",
            "        else:\n            write_retained_result(values.result, values.result_fd, result)\n"
            f"        with Path({str(drifted_task_prompt)!r}).open('ab') as stream:\n"
            "            stream.write(b'\\n')\n"
            "        return 0\n",
            1,
        )
        require(drifting_source != (project / "scripts/prompt-fixed-adapter.py").read_text(), "drift fixture did not patch")
        drifting_adapter.write_text(drifting_source)
        drifting_adapter.chmod(0o755)
        reviewed_drifting_adapter = reviewed_source / "scripts/drifting-adapter.py"
        reviewed_drifting_adapter.write_text(drifting_source)
        reviewed_drifting_adapter.chmod(0o755)
        drifting_digest = raw_digest(drifting_adapter)
        for task_path in task_files:
            task_document = json.loads((project / task_path).read_text())
            task_document["argv"] = ["/usr/bin/python3", "scripts/drifting-adapter.py"]
            task_document["measurement_adapter_runtime"] = "PYTHON:" + drifting_digest
            task_document["artifacts"].append({
                "path": "scripts/drifting-adapter.py", "kind": "FILE",
                "expected_sha256": file_expectation_digest(project, "scripts/drifting-adapter.py"),
            })
            bind(task_document)
            store(project, task_path, task_document)
        drifted = subprocess.run(
            [str(build_root / "main"), "prompt", "evaluate", str(request_path), "result.json"],
            cwd=project, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
        require(
            result_path.exists(),
            f"snapshot drift did not publish: stdout={drifted.stdout!r}; stderr={drifted.stderr!r}",
        )
        drift_result = load_result(result_path, "snapshot drift")
        require(
            drifted.returncode != 0
            and drift_result["error_code"] == "INPUT_DRIFT"
            and drift_result["snapshot_attestations"][0]["status"] == "POSTCHECK_DRIFT",
            "postcheck drift did not retain its terminal attestation",
        )
        drift_verified = subprocess.run(
            [str(ALIGNC), "run", str(SOURCE / "src/prompt_evaluate_smoke.align"), str(result_path), str(evidence_path)],
            text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
        require(
            drift_verified.returncode == 0 and drift_verified.stdout.strip() == "NONCOMPLETE_ERROR",
            "postcheck drift pair did not pass strict verification",
        )
        result_path.unlink()
        evidence_path.unlink()
        drifted_task_prompt.write_bytes(original_task_prompt)
        for task_path, task_document in zip(task_files, original_task_documents):
            store(project, task_path, task_document)

        error_adapter = project / "scripts/error-adapter.py"
        error_source = (project / "scripts/prompt-fixed-adapter.py").read_text().replace(
            "    bind_digest(value)\n    return value\n\n\ndef write_exclusive",
            "    value.update(status='ERROR', failure_kind='ADAPTER', build_status='ERROR', "
            "test_status='NOT_RUN', generation_to_passing_patch_ns=None, "
            "diagnostic_summary='adapter terminal error')\n"
            "    bind_digest(value)\n    return value\n\n\ndef write_exclusive",
            1,
        )
        require(error_source != (project / "scripts/prompt-fixed-adapter.py").read_text(), "error fixture did not patch")
        error_adapter.write_text(error_source)
        error_adapter.chmod(0o755)
        reviewed_error_adapter = reviewed_source / "scripts/error-adapter.py"
        reviewed_error_adapter.write_text(error_source)
        reviewed_error_adapter.chmod(0o755)
        error_digest = raw_digest(error_adapter)
        for task_path in task_files:
            task_document = json.loads((project / task_path).read_text())
            task_document["argv"] = ["/usr/bin/python3", "scripts/error-adapter.py"]
            task_document["measurement_adapter_runtime"] = "PYTHON:" + error_digest
            task_document["artifacts"].append({
                "path": "scripts/error-adapter.py", "kind": "FILE",
                "expected_sha256": file_expectation_digest(project, "scripts/error-adapter.py"),
            })
            bind(task_document)
            store(project, task_path, task_document)
        adapter_error = subprocess.run(
            [str(build_root / "main"), "prompt", "evaluate", str(request_path), "result.json"],
            cwd=project, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
        adapter_error_result = load_result(result_path, "adapter error")
        require(
            adapter_error.returncode != 0
            and adapter_error_result["error_code"] == "ADAPTER_RESULT"
            and len(adapter_error_result["rows"]) == 1
            and adapter_error_result["rows"][0]["measurement"]["status"] == "ERROR"
            and adapter_error_result["snapshot_attestations"][0]["status"] == "COMPLETE",
            "terminal adapter measurement did not retain its valid row",
        )
        adapter_error_verified = subprocess.run(
            [str(ALIGNC), "run", str(SOURCE / "src/prompt_evaluate_smoke.align"), str(result_path), str(evidence_path)],
            text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
        require(
            adapter_error_verified.returncode == 0 and adapter_error_verified.stdout.strip() == "NONCOMPLETE_ERROR",
            "terminal adapter row did not pass strict prefix verification",
        )
        result_path.unlink()
        evidence_path.unlink()
        for task_path, task_document in zip(task_files, original_task_documents):
            store(project, task_path, task_document)

        malformed_adapter = project / "scripts/malformed-adapter.py"
        malformed_adapter_source = (project / "scripts/prompt-fixed-adapter.py").read_text().replace(
            "        result = measurement(request, rendered, policy, control)\n",
            "        result = measurement(request, rendered, policy, control)\n"
            "        result.pop('generation_request')\n"
            "        bind_digest(result)\n",
            1,
        )
        require(
            malformed_adapter_source != (project / "scripts/prompt-fixed-adapter.py").read_text(),
            "malformed measurement fixture did not patch",
        )
        malformed_adapter.write_text(malformed_adapter_source)
        malformed_adapter.chmod(0o755)
        reviewed_malformed_adapter = reviewed_source / "scripts/malformed-adapter.py"
        reviewed_malformed_adapter.write_text(malformed_adapter_source)
        reviewed_malformed_adapter.chmod(0o755)
        malformed_adapter_digest = raw_digest(malformed_adapter)
        for task_path in task_files:
            task_document = json.loads((project / task_path).read_text())
            task_document["argv"] = ["/usr/bin/python3", "scripts/malformed-adapter.py"]
            task_document["measurement_adapter_runtime"] = "PYTHON:" + malformed_adapter_digest
            task_document["artifacts"].append({
                "path": "scripts/malformed-adapter.py", "kind": "FILE",
                "expected_sha256": file_expectation_digest(project, "scripts/malformed-adapter.py"),
            })
            bind(task_document)
            store(project, task_path, task_document)
        malformed_measurement = subprocess.run(
            [str(build_root / "main"), "prompt", "evaluate", str(request_path), "result.json"],
            cwd=project, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
        malformed_measurement_result = load_result(result_path, "malformed measurement result")
        require(
            malformed_measurement.returncode != 0
            and malformed_measurement_result["error_code"] == "ADAPTER_RESULT"
            and malformed_measurement_result["snapshot_attestations"][0]["status"] == "ADAPTER_FAILED"
            and evidence_path.exists(),
            "digest-valid malformed measurement suppressed its terminal pair",
        )
        result_path.unlink()
        evidence_path.unlink()
        for task_path, task_document in zip(task_files, original_task_documents):
            store(project, task_path, task_document)

        cleanup_counter = root / "cleanup-retirement-count"
        cleanup_evaluator = project / "scripts/prompt-evaluate.py"
        cleanup_evaluator_source = cleanup_evaluator.read_text().replace(
            "    if path not in owned_paths:\n"
            "        return True\n",
            "    if path not in owned_paths:\n"
            "        return True\n"
            "    if path.name.endswith('-snapshot-result.json'):\n"
            f"        counter = Path({str(cleanup_counter)!r})\n"
            "        count = int(counter.read_text()) + 1 if counter.exists() else 1\n"
            "        counter.write_text(str(count))\n"
            "        if count >= 2:\n"
            "            return False\n",
            1,
        )
        require(cleanup_evaluator_source != cleanup_evaluator.read_text(), "cleanup evaluator fixture did not patch")
        cleanup_evaluator.write_text(cleanup_evaluator_source)
        cleanup_failed = subprocess.run(
            [str(build_root / "main"), "prompt", "evaluate", str(request_path), "result.json"],
            cwd=project, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
        require(
            cleanup_failed.returncode != 0
            and not result_path.exists()
            and not evidence_path.exists()
            and not cleanup_counter.exists()
            and not any(workspace.iterdir()),
            "modified evaluator crossed the outer reviewed-source boundary",
        )
        shutil.copy2(SOURCE / "scripts/prompt-evaluate.py", cleanup_evaluator)

        replacement_marker = root / "replacement-evaluator-ran"
        retained_race = subprocess.Popen(
            [str(build_root / "main"), "prompt", "evaluate", str(request_path), "result.json"],
            cwd=project, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
        child_seen = False
        deadline = time.monotonic() + 10
        children_path = Path(f"/proc/{retained_race.pid}/task/{retained_race.pid}/children")
        while retained_race.poll() is None and time.monotonic() < deadline:
            try:
                child_seen = bool(children_path.read_text().strip())
            except OSError:
                child_seen = False
            if child_seen:
                break
            time.sleep(0.005)
        require(child_seen, "outer evaluator launch was not observable for retained-source replacement")
        cleanup_evaluator.write_text(
            "from pathlib import Path\n"
            f"Path({str(replacement_marker)!r}).write_text('replacement ran')\n"
            "raise SystemExit(99)\n"
        )
        retained_stdout, retained_stderr = retained_race.communicate(timeout=120)
        require(
            retained_race.returncode == 0 and result_path.exists() and evidence_path.exists()
            and not replacement_marker.exists(),
            f"replacement evaluator crossed retained-source launch: stdout={retained_stdout!r}; "
            f"stderr={retained_stderr!r}",
        )
        result_path.unlink()
        evidence_path.unlink()
        shutil.copy2(SOURCE / "scripts/prompt-evaluate.py", cleanup_evaluator)

        completed = subprocess.run(
            [str(build_root / "main"), "prompt", "evaluate", str(request_path), "result.json"],
            cwd=project, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
        require(completed.returncode == 0, f"evaluator failed: {completed.stderr.decode(errors='replace')}")
        require(b"PUBLISHED" in completed.stdout and not completed.stderr, "evaluator command did not publish")
        result = load_result(result_path, "successful evaluation")
        require(result["status"] == "IMPROVED" and result["gate_eligible"] is False, "fixture result status changed")
        require([row["variant"] for row in result["rows"]] == [
            "PARENT", "CANDIDATE", "CANDIDATE", "PARENT",
            "PARENT", "CANDIDATE", "CANDIDATE", "PARENT",
        ], "paired execution order changed")
        verified = subprocess.run(
            [str(ALIGNC), "run", str(SOURCE / "src/prompt_evaluate_smoke.align"), str(result_path), str(evidence_path)],
            text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
        require(
            verified.returncode == 0,
            f"strict evaluator verification failed (stage {verified.stdout.strip()}): {verified.stderr[-4096:]}",
        )
        require(
            verified.stdout.strip() == "COMPLETE_INELIGIBLE",
            f"fixture evaluation was not lifecycle-consumable: {verified.stdout.strip()}",
        )
        accept_request = {
            "schema_version": 1, "artifact_kind": "PROMPT_ACCEPT_REQUEST", "decision_id": "accept-v1",
            "project_root": str(project), "evaluation_path": "result.json",
            "parent_activation_path": "artifacts/parent.json", "evaluation_evidence_path": "evidence.json",
        }
        accept_request_path = project / "accept-request.json"
        accept_request_path.write_bytes(canonical(accept_request))
        accept_result_path = project / "accept-result.json"
        accepted = subprocess.run(
            [str(build_root / "main"), "prompt", "accept", str(accept_request_path), str(accept_result_path)],
            cwd=project, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
        accept_result = json.loads(accept_result_path.read_text()) if accept_result_path.exists() else {}
        require(
            accepted.returncode != 0 and b"INELIGIBLE" in accepted.stdout,
            f"lifecycle did not consume fixture result: result={accept_result!r} stdout={accepted.stdout!r} stderr={accepted.stderr[-2048:]!r}",
        )
        require(accept_result["status"] == "INELIGIBLE", "lifecycle ineligibility artifact changed")
        original_result = result_path.read_bytes()
        original_evidence = evidence_path.read_bytes()
        collision = subprocess.run(
            [str(build_root / "main"), "prompt", "evaluate", str(request_path), "result.json"],
            cwd=project, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
        require(collision.returncode != 0, "occupied evaluation outputs were accepted")
        require(result_path.read_bytes() == original_result, "occupied result was replaced")
        require(evidence_path.read_bytes() == original_evidence, "occupied evidence was replaced")
        require(not any(os.scandir(workspace)), "evaluator left workspace artifacts")
        require(not list(project.glob("*.prepared.*")), "evaluator left prepared artifacts")
        require(not list(project.glob("*.tmp.*")), "evaluator left publication artifacts")

        result_path.unlink()
        evidence_path.unlink()
        noisy_adapter = project / "scripts/noisy-adapter.py"
        noisy_adapter.write_text("#!/usr/bin/python3\nimport sys\nsys.stdout.write('x')\n")
        noisy_adapter.chmod(0o755)
        reviewed_noisy_adapter = reviewed_source / "scripts/noisy-adapter.py"
        reviewed_noisy_adapter.write_text(noisy_adapter.read_text())
        reviewed_noisy_adapter.chmod(0o755)
        noisy_digest = raw_digest(noisy_adapter)
        for task_path in task_files:
            task_document = json.loads((project / task_path).read_text())
            task_document["argv"] = ["/usr/bin/python3", "scripts/noisy-adapter.py"]
            task_document["measurement_adapter_runtime"] = "PYTHON:" + noisy_digest
            task_document["artifacts"].append({
                "path": "scripts/noisy-adapter.py", "kind": "FILE",
                "expected_sha256": file_expectation_digest(project, "scripts/noisy-adapter.py"),
            })
            bind(task_document)
            store(project, task_path, task_document)
        over_cap = subprocess.run(
            [str(build_root / "main"), "prompt", "evaluate", str(request_path), "result.json"],
            cwd=project, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
        require(over_cap.returncode != 0, "adapter stdout cap breach was accepted")
        cap_result = load_result(result_path, "adapter output cap")
        require(
            cap_result["status"] == "ERROR" and cap_result["error_code"] == "ADAPTER_PROCESS_OUTPUT",
            "cap breach did not publish its terminal error",
        )
        cap_verified = subprocess.run(
            [str(ALIGNC), "run", str(SOURCE / "src/prompt_evaluate_smoke.align"), str(result_path), str(evidence_path)],
            text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
        require(
            cap_verified.returncode == 0 and cap_verified.stdout.strip() == "NONCOMPLETE_ERROR",
            "cap breach pair did not pass strict prefix verification",
        )
        require(not any(os.scandir(workspace)), "cap breach left workspace artifacts")
        require(not list(project.glob("*.prepared.*")), "cap breach left prepared artifacts")
        result_path.unlink()
        evidence_path.unlink()

        noisy_adapter.write_text("#!/usr/bin/python3\nimport time\ntime.sleep(15)\n")
        reviewed_noisy_adapter.write_text(noisy_adapter.read_text())
        timeout_digest = raw_digest(noisy_adapter)
        for task_path in task_files:
            task_document = json.loads((project / task_path).read_text())
            task_document["measurement_adapter_runtime"] = "PYTHON:" + timeout_digest
            task_document["timeout_ns"] = 500_000_000
            task_document["artifacts"][-1]["expected_sha256"] = file_expectation_digest(
                project, "scripts/noisy-adapter.py"
            )
            bind(task_document)
            store(project, task_path, task_document)
        started = time.monotonic()
        timed_out = subprocess.run(
            [str(build_root / "main"), "prompt", "evaluate", str(request_path), "result.json"],
            cwd=project, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
        elapsed = time.monotonic() - started
        require(timed_out.returncode != 0 and elapsed < 10, "adapter timeout was not bounded")
        timeout_result = load_result(result_path, "adapter timeout")
        require(
            timeout_result["status"] == "ERROR" and timeout_result["error_code"] == "ADAPTER_TIMEOUT",
            "timeout did not publish its terminal error",
        )
        timeout_verified = subprocess.run(
            [str(ALIGNC), "run", str(SOURCE / "src/prompt_evaluate_smoke.align"), str(result_path), str(evidence_path)],
            text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
        require(
            timeout_verified.returncode == 0 and timeout_verified.stdout.strip() == "NONCOMPLETE_ERROR",
            "timeout pair did not pass strict prefix verification",
        )
        require(not any(os.scandir(workspace)), "timeout left workspace artifacts")
        require(not list(project.glob("*.prepared.*")), "timeout left prepared artifacts")

    print("prompt evaluate: PASS")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, json.JSONDecodeError, subprocess.CalledProcessError) as error:
        print(f"prompt evaluate: FAIL: {error}", file=sys.stderr)
        raise SystemExit(1)
