#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
compiler="${ALIGNC:-${project_root}/scripts/alignc}"
scratch="$(mktemp -d)"
scratch="$(cd "$scratch" && pwd -P)"
complete=0
owner_pid=""
cleanup() { status=$?; if [[ -n "$owner_pid" ]]; then kill -TERM "$owner_pid" 2>/dev/null || true; wait "$owner_pid" || true; fi; if [[ "$complete" == 1 ]]; then rm -rf "$scratch"; else printf 'Git member fixture preserved: %s\n' "$scratch" >&2; fi; exit "$status"; }
trap cleanup EXIT
mkdir "$scratch/image"
cp "$(command -v git)" "$scratch/image/git"
sha() { shasum -a 256 | cut -d ' ' -f 1; }
image_hash="$(sha < "$scratch/image/git")"
"$compiler" check-per-unit "$project_root/src/prompt_git_member_smoke.align"
(cd "$scratch" && "$compiler" build "$project_root/src/prompt_git_member_smoke.align")
owner="$scratch/prompt_git_member_smoke"
if [[ "$(uname -s)" != Linux ]]; then "$owner" Darwin "$scratch/image" "$image_hash" - - - - - -; complete=1; exit; fi
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
export GIT_AUTHOR_NAME=fixture GIT_AUTHOR_EMAIL=fixture@example.invalid GIT_COMMITTER_NAME=fixture GIT_COMMITTER_EMAIL=fixture@example.invalid
zero="$(printf '%064d' 0)"
for format in sha1 sha256; do
  repo="$scratch/$format"
  git init -q --initial-branch=main --object-format="$format" "$repo"
  printf abc > "$repo/a"
  printf xyz > "$repo/line"$'\n'"name"
  dd if=/dev/zero of="$repo/exact" bs=2097152 count=1 2>/dev/null
  cp "$repo/exact" "$repo/over"; printf x >> "$repo/over"
  chmod 644 "$repo/"*
  git -C "$repo" add .; git -C "$repo" commit -qm initial
  revision="$(git -C "$repo" rev-parse HEAD)"
  git -C "$repo" worktree add -q -b linked "$repo-linked"
  for location in "$repo" "$repo-linked"; do
    "$owner" Linux "$scratch/image" "$image_hash" "$location" "$revision" a 100644 "$(sha < "$repo/a")" true
    "$owner" Linux "$scratch/image" "$image_hash" "$location" "$revision" missing 100644 "$zero" false
    "$owner" Linux "$scratch/image" "$image_hash" "$location" "$revision" a 100755 "$(sha < "$repo/a")" false
    "$owner" Linux "$scratch/image" "$image_hash" "$location" "$revision" a 100644 "$zero" false
  done
  "$owner" Linux "$scratch/image" "$image_hash" "$repo" "$revision" $'line\nname' 100644 "$(sha < "$repo/line"$'\n'"name")" true
  "$owner" Linux "$scratch/image" "$image_hash" "$repo" "$revision" exact 100644 "$(sha < "$repo/exact")" true
  "$owner" Linux "$scratch/image" "$image_hash" "$repo" "$revision" over 100644 "$zero" cap
  "$owner" Linux "$scratch/image" "$image_hash" "$repo" "$revision" a 100644 "$zero" expired
  "$owner" Linux "$scratch/image" "$image_hash" "$repo" BAD a 100644 "$zero" error
  "$owner" Linux "$scratch/image" "$image_hash" "$repo" "$revision" ../a 100644 "$zero" error
  "$owner" Linux "$scratch/image" "$image_hash" "$repo" "$revision" a 120000 "$zero" error
done
cat > "$scratch/backend.c" <<'C'
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
int main(int argc,char **argv) {
  char mode[64]={0}; FILE *f=fopen(".git/member-case","r"); if(!f)return 8; fgets(mode,sizeof(mode),f); fclose(f);
  if(getenv("MEMBER_SECRET") || !getenv("GIT_NO_LAZY_FETCH") || strcmp(getenv("GIT_NO_LAZY_FETCH"),"1"))return 9;
  if(argc<19 || strcmp(argv[16],"-c") || strcmp(argv[17],"advice.graftFileDeprecated=false"))return 10;
  if(!strcmp(mode,"timeout") || !strcmp(mode,"cancel")) { FILE *ready=fopen(".git/member-ready","w"); if(ready)fclose(ready); sleep(20); return 0; }
  if(!strcmp(mode,"nonzero"))return 7;
  if(!strcmp(mode,"postconfig")) { FILE *c=fopen(".git/config","a"); if(!c)return 11; fputs("\n[core]\nfsmonitor = unsafe\n",c); fclose(c); return 0; }
  if(!strcmp(mode,"stderr"))fprintf(stderr,"failure");
  if(argc>18 && !strcmp(argv[18],"ls-tree")) {
    if(!strcmp(mode,"empty"))return 0;
    if(!strcmp(mode,"malformed")){printf("bad");return 0;}
    printf("100644 blob aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\ta%c",0);
    if(!strcmp(mode,"multiple"))printf("100644 blob aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\ta%c",0);
  } else { printf("abc"); }
  return 0;
}
C
cc "$scratch/backend.c" -o "$scratch/image/git"
image_hash="$(sha < "$scratch/image/git")"
repo="$scratch/sha1"; revision="$(git -C "$repo" rev-parse HEAD)"
for case in controlled empty malformed multiple nonzero stderr timeout; do
  printf %s "$case" > "$repo/.git/member-case"
  case "$case" in controlled) expected=true;; empty|malformed|multiple) expected=false;; nonzero) expected=stopped;; stderr) expected=error;; timeout) expected=timeout;; esac
  MEMBER_SECRET=must-not-propagate "$owner" Linux "$scratch/image" "$image_hash" "$repo" "$revision" a 100644 "$(sha < "$repo/a")" "$expected"
done
printf postconfig > "$repo/.git/member-case"
cp "$repo/.git/config" "$scratch/config"
"$owner" Linux "$scratch/image" "$image_hash" "$repo" "$revision" a 100644 "$zero" error
# The new forbidden configuration also refuses before launch.
"$owner" Linux "$scratch/image" "$image_hash" "$repo" "$revision" a 100644 "$zero" error
cp "$scratch/config" "$repo/.git/config"
printf cancel > "$repo/.git/member-case"
rm -f "$repo/.git/member-ready"
"$owner" Linux "$scratch/image" "$image_hash" "$repo" "$revision" a 100644 "$zero" cancel &
owner_pid=$!
for attempt in $(seq 1 200); do
  if [[ -e "$repo/.git/member-ready" ]]; then break; fi
  sleep 0.01
done
test -e "$repo/.git/member-ready"
kill -TERM "$owner_pid"
wait "$owner_pid"
owner_pid=""
complete=1
printf 'Git membership smoke PASS\n'
