#!/usr/bin/env bash
# Reproduce the independent real-capture Metal Q4_0 down split-K screen.
set -euo pipefail

: "${GGML_INCLUDE:?set GGML_INCLUDE to the pinned ggml/include directory}"
: "${GGML_BUNDLE:?set GGML_BUNDLE to the pinned ggml Metal bundle}"
: "${CAPTURE_DIR:?set CAPTURE_DIR to the real native FFN capture directory}"

root_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
test -f "${GGML_INCLUDE}/ggml.h"
test -f "${GGML_BUNDLE}/libggml-metal.so"
for layer in 03 23; do
  test -f "${CAPTURE_DIR}/${layer}-down.bin"
  test -f "${CAPTURE_DIR}/${layer}-gated.bin"
  test -f "${CAPTURE_DIR}/${layer}-output.bin"
done
scratch_dir="$(mktemp -d)"
trap 'rm -rf -- "${scratch_dir}"' EXIT

clang++ -O3 -std=c++17 -Wall -Wextra -Werror -fobjc-arc \
  -framework Foundation -framework Metal \
  -I "${GGML_INCLUDE}" -L "${GGML_BUNDLE}" \
  -Wl,-rpath,"${GGML_BUNDLE}" \
  "${root_dir}/scripts/bench-metal-q4-down-split.mm" \
  -lggml -lggml-base -o "${scratch_dir}/bench-metal-q4-down-split"

DYLD_LIBRARY_PATH="${GGML_BUNDLE}" "${scratch_dir}/bench-metal-q4-down-split" \
  "${GGML_BUNDLE}/libggml-metal.so" "${CAPTURE_DIR}"
