PREDECESSOR_LOADER = SourceFileLoader(
    "olmoe_exact_safe_for_post_optimization_diagnosis", str(PREDECESSOR_PATH)
)
PREDECESSOR_SPEC = importlib.util.spec_from_loader(
    PREDECESSOR_LOADER.name, PREDECESSOR_LOADER
)
if PREDECESSOR_SPEC is None or PREDECESSOR_SPEC.loader is None:
    raise RuntimeError("cannot load the exact-safe decode owner")
previous = importlib.util.module_from_spec(PREDECESSOR_SPEC)
sys.modules[PREDECESSOR_LOADER.name] = previous
PREDECESSOR_SPEC.loader.exec_module(previous)

base = previous.base
diagnosis = previous.diagnosis
ARTIFACT_KIND = "R8_OLMOE_POST_OPTIMIZATION_REMAINING_DECODE_DIAGNOSIS"
PREDECESSOR_ARTIFACT_KIND = "R8_OLMOE_EXACT_SAFE_DECODE_BOUNDARIES"
CEILING_SECONDS = 8 * 60
INHERITED_CLEANUP_SECONDS = 50
DELEGATE_TIMEOUT_SECONDS = CEILING_SECONDS + INHERITED_CLEANUP_SECONDS
BASELINE_VALUES_NS = [17_714_825_083, 16_684_315_166, 17_132_135_334, 21_189_618_042]
BASELINE_MEDIAN_NS = 17_423_480_208
FLOOR_PPM = 50_000
FLOOR_NS = 871_174_011


def unique_paths(paths: tuple[Path, ...]) -> tuple[Path, ...]:
    result: list[Path] = []
    for path in paths:
        if path not in result:
            result.append(path)
    return tuple(result)


SOURCE_PATHS = unique_paths((PREDECESSOR_PATH, *previous.SOURCE_PATHS))
