#!/usr/bin/env python3
"""Exercise atomic local kit assembly through real retained-root admission."""

import dataclasses
import importlib.machinery
import os
import pathlib
import sys
import tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "scripts"))
import gpu_qualification_kit as kit
from gpu_backend_recipe import RecipeError
from gpu_qualification_input import admit


def rejected(call, message=None):
    try:
        call()
    except (RecipeError, OSError) as error:
        if message is not None:
            assert message in str(error), (message, str(error))
    else:
        raise AssertionError("invalid kit was published")


def main():
    loader = importlib.machinery.SourceFileLoader("kit_fixture", str(ROOT / "scripts/run-gpu-input-admission-smoke"))
    fixture = loader.load_module()
    with tempfile.TemporaryDirectory(prefix="gpu-kit-") as raw:
        root = pathlib.Path(raw).resolve()
        original = root / "input"
        original.mkdir()
        fixture.materialize(original)
        admitted = admit(original / "profile.json")
        sources = tuple(kit.CapturedSource(source.manifest, source.manifest_raw, source.commit_raw, source.blobs)
                        for source in (admitted.align_source, admitted.ggml_source))
        files = {name: original / name for name in admitted.files
                 if name != "profile.json" and not name.startswith("source/")}
        # Both generated bytes and copied external files use the same final admission path.
        calibration = admitted.records["profile"]["models"][0]["calibration_path"]
        files[calibration] = (original / calibration).read_bytes()

        def assemble(name="output", supplied=files, captures=sources):
            return kit.assemble_kit(output=root / name, profile_raw=admitted.profile_raw,
                                    sources=captures, files=supplied)

        output = assemble()
        replay = admit(output)
        assert replay.records == admitted.records and set(replay.files) == set(admitted.files)
        assert output.parent.stat().st_mode & 0o077 == 0
        for name in replay.files:
            target = output.parent / name
            assert target.read_bytes() == (original / name).read_bytes()
            assert target.stat().st_nlink == 1 and not target.is_symlink()
            assert (target.stat().st_dev, target.stat().st_ino) != \
                ((original / name).stat().st_dev, (original / name).stat().st_ino)
        rejected(assemble, "new absolute path")
        occupied = root / "occupied"
        occupied.symlink_to(output.parent, target_is_directory=True)
        rejected(lambda: assemble("occupied"), "new absolute path")
        assert occupied.is_symlink() and output.exists()

        for index, (supplied, message) in enumerate((
            ({name: value for name, value in files.items() if name != "inputs/qwen2.geometry"}, "absent"),
            (files | {"extra": b"extra"}, "referenced closure"),
            (files | {"inputs/qwen2.model": b"wrong"}, "digest does not match"),
            (files | {"profile.json": b"wrong"}, "reserved"),
            (files | {"source/new": b"wrong"}, "reserved"),
            (files | {"../escape": b"wrong"}, "invalid component"),
            (files | {"inputs": b"wrong"}, "prefix collision"),
        )):
            name = f"failed-{index}"
            rejected(lambda: assemble(name, supplied), message)
            assert not (root / name).exists() and not list(root.glob(f".{name}.kit-*"))
        broken = dataclasses.replace(sources[0], blobs={})
        rejected(lambda: assemble("bad-source", captures=(broken, sources[1])), "blob closure")
        assert not list(root.glob(".bad-source.kit-*"))

        # Bound the copy read itself, and force growth after the first chunk was consumed.
        large = root / "large"
        large.write_bytes(b"x" * (kit.COPY_CHUNK * 2 + 19))
        copied = root / "copied"
        original_read = kit.os.read
        lengths = []
        def tracked_read(descriptor, count):
            lengths.append(count)
            return original_read(descriptor, count)
        kit.os.read = tracked_read
        try:
            kit._copy(large, copied)
        finally:
            kit.os.read = original_read
        assert copied.read_bytes() == large.read_bytes() and max(lengths) == kit.COPY_CHUNK
        assert len(lengths) >= 4
        def grow_input(descriptor, count):
            data = original_read(descriptor, count)
            if data:
                with large.open("ab") as stream:
                    stream.write(b"growth")
            return data
        kit.os.read = grow_input
        try:
            rejected(lambda: kit._copy(large, root / "changed"), "grew")
        finally:
            kit.os.read = original_read

        original_copy = kit._copy
        def failed_copy(*args):
            raise OSError("forced kit copy failure")
        kit._copy = failed_copy
        try:
            rejected(lambda: assemble("copy-failure"), "forced kit copy")
            assert not (root / "copy-failure").exists() and not list(root.glob(".copy-failure.kit-*"))
        finally:
            kit._copy = original_copy
        original_rename = kit.rename_noreplace
        def occupied_during_publication(stage, destination):
            destination.mkdir()
            (destination / "keep").write_bytes(b"existing")
            original_rename(stage, destination)
        kit.rename_noreplace = occupied_during_publication
        try:
            rejected(lambda: assemble("race"))
            assert (root / "race/keep").read_bytes() == b"existing"
            assert not list(root.glob(".race.kit-*"))
        finally:
            kit.rename_noreplace = original_rename
        admitted.recheck()
    print("gpu kit assembly: PASS (admission, bounded copy, no-replace publication and cleanup)")


if __name__ == "__main__":
    main()
