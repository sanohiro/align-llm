#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
compiler="${ALIGNC:-${project_root}/scripts/alignc}"
scratch="$(mktemp -d)"
scratch="$(cd "${scratch}" && pwd -P)"
complete=0
owner_pid=""
cleanup() {
  status=$?
  if [[ -n "${owner_pid}" ]]; then kill -TERM "${owner_pid}" 2>/dev/null || true; wait "${owner_pid}" || true; fi
  if [[ "${complete}" == 1 ]]; then rm -rf "${scratch}"; else printf 'source Git fixture preserved: %s\n' "${scratch}" >&2; fi
  exit "${status}"
}
trap cleanup EXIT
mkdir "${scratch}/image"
cp "$(command -v git)" "${scratch}/image/git"
hash="$(shasum -a 256 "${scratch}/image/git" | awk '{print $1}')"
"${compiler}" check-per-unit "${project_root}/src/prompt_source_git_smoke.align"
(cd "${scratch}" && "${compiler}" build "${project_root}/src/prompt_source_git_smoke.align")
owner="${scratch}/prompt_source_git_smoke"
platform="$(uname -s)"
if [[ "${platform}" != Linux ]]; then
  "${owner}" "${platform}" "${scratch}/image" "${hash}" - - - -
  complete=1
  exit 0
fi
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_NO_REPLACE_OBJECTS=1
export GIT_AUTHOR_NAME=fixture GIT_AUTHOR_EMAIL=fixture@example.invalid GIT_COMMITTER_NAME=fixture GIT_COMMITTER_EMAIL=fixture@example.invalid
for format in sha1 sha256; do
  repository="${scratch}/${format}"
  git init -q --initial-branch=main --object-format="${format}" "${repository}"
  printf 'payload\n' > "${repository}/a"
  git -C "${repository}" add a
  git -C "${repository}" commit -qm initial
  head="$(git -C "${repository}" rev-parse HEAD)"
  mismatch="${head//[0-9a-f]/0}"
  linked="${scratch}/${format}-linked"
  git -C "${repository}" worktree add -q -b linked "${linked}"
  for location in "${repository}" "${linked}"; do
    "${owner}" Linux "${scratch}/image" "${hash}" "${location}" "${head}" "${head}" clean
    "${owner}" Linux "${scratch}/image" "${hash}" "${location}" "${mismatch}" "${head}" mismatch
    printf dirty >> "${location}/a"
    "${owner}" Linux "${scratch}/image" "${hash}" "${location}" "${head}" "${head}" dirty
    git -C "${location}" checkout -- a
  done
  git -C "${repository}" update-ref "refs/replace/${head}" "${head}"
  git -C "${repository}" pack-refs --all
  rmdir "${repository}/.git/refs/replace" 2>/dev/null || true
  test ! -e "${repository}/.git/refs/replace"
  "${owner}" Linux "${scratch}/image" "${hash}" "${repository}" "${head}" "${head}" packed
  git -C "${repository}" update-ref -d "refs/replace/${head}"
  git -C "${repository}" config core.fsmonitor "!touch ${scratch}/must-not-exist"
  "${owner}" Linux "${scratch}/image" "${hash}" "${repository}" "${head}" "${head}" config
  test ! -e "${scratch}/must-not-exist"
done
cat > "${scratch}/backend.c" <<'C'
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <signal.h>
extern char **environ;
int main(int argc, char **argv) {
  const char *fixed[]={"git","--no-pager","-C",NULL,"-c","core.useReplaceRefs=false","-c","core.alternateRefsCommand=","-c","core.fsmonitor=false","-c","core.hooksPath=/dev/null","-c","credential.helper=","-c","diff.external="};
  if(argc<19) return 91;
  for(int i=0;i<16;i++) if(i!=3 && strcmp(argv[i],fixed[i])) return 92;
  char cwd[4097]; if(!getcwd(cwd,sizeof cwd)||strcmp(cwd,argv[3]))return 93;
  const char *env[]={"LANG=C","LC_ALL=C","GIT_CONFIG_NOSYSTEM=1","GIT_CONFIG_GLOBAL=/dev/null","GIT_CONFIG_SYSTEM=/dev/null","GIT_OPTIONAL_LOCKS=0","GIT_TERMINAL_PROMPT=0","GIT_PAGER=cat","GIT_NO_REPLACE_OBJECTS=1","GIT_GRAFT_FILE=/dev/null","GIT_NO_LAZY_FETCH=1"};
  int count=0;for(char **p=environ;*p;p++){int found=0;count++;for(int i=0;i<11;i++)if(!strcmp(*p,env[i]))found++;if(found!=1)return 94;}if(count!=11)return 95;
  int operation=-1;
  if(argc==19&&!strcmp(argv[16],"for-each-ref")&&!strcmp(argv[17],"--format=%(refname)%00")&&!strcmp(argv[18],"refs/replace/"))operation=0;
  if(argc==19&&!strcmp(argv[16],"rev-parse")&&!strcmp(argv[17],"--verify")&&!strcmp(argv[18],"HEAD"))operation=1;
  if(argc==20&&!strcmp(argv[16],"status")&&!strcmp(argv[17],"--porcelain=v1")&&!strcmp(argv[18],"-z")&&!strcmp(argv[19],"--untracked-files=all"))operation=2;
  if(operation<0)return 96;
  FILE *log=fopen("../queries","a");if(!log)return 97;fprintf(log,"%d\n",operation);fclose(log);
  char mode[32];FILE *input=fopen("owner-mode","r");if(!input||!fgets(mode,sizeof mode,input))return 98;fclose(input);mode[strcspn(mode,"\n")]=0;
  if(!strcmp(mode,"nonzero"))return 7;
  if(!strcmp(mode,"oversized")){for(int i=0;i<262145;i++)putchar('x');return 0;}
  if(!strcmp(mode,"timeout")||!strcmp(mode,"cancel")){FILE *ready=fopen("../ready","w");if(!ready)return 99;fclose(ready);alarm(15);for(;;)pause();}
  if(operation==1){if(!strcmp(mode,"malformed"))puts("not-a-revision");else puts("1111111111111111111111111111111111111111");}
  if(operation==2&&!strcmp(mode,"postconfig")){FILE *config=fopen(".git/config","w");if(!config)return 100;fputs("[core]\nfsmonitor = forbidden\n",config);fclose(config);}
  return 0;
}
C
mkdir "${scratch}/controlled-image"
cc "${scratch}/backend.c" -o "${scratch}/controlled-image/git"
controlled_hash="$(shasum -a 256 "${scratch}/controlled-image/git" | awk '{print $1}')"
head=1111111111111111111111111111111111111111
for mode in controlled malformed nonzero oversized timeout cancel invalid-revision expired postconfig config; do
  root="${scratch}/case-${mode}/root"
  mkdir -p "${root}/.git"
  printf '%s\n' "${mode}" > "${root}/owner-mode"
  if [[ "${mode}" == config ]]; then printf '[core]\nfsmonitor = forbidden\n' > "${root}/.git/config"; fi
  expected="${head}"
  if [[ "${mode}" == invalid-revision ]]; then expected=ABC; fi
  if [[ "${mode}" == cancel ]]; then
    "${owner}" Linux "${scratch}/controlled-image" "${controlled_hash}" "${root}" "${expected}" "${head}" "${mode}" &
    owner_pid=$!
    ready=0
    for ((attempt=0;attempt<200;attempt++)); do
      if [[ -e "${scratch}/case-${mode}/ready" ]]; then ready=1; break; fi
      if ! kill -0 "${owner_pid}" 2>/dev/null; then break; fi
      sleep 0.01
    done
    [[ "${ready}" == 1 ]]
    kill -TERM "${owner_pid}"
    wait "${owner_pid}"
    owner_pid=""
  else
    "${owner}" Linux "${scratch}/controlled-image" "${controlled_hash}" "${root}" "${expected}" "${head}" "${mode}"
  fi
  case "${mode}" in
    controlled|postconfig) printf '0\n1\n2\n' > "${scratch}/expected-queries" ;;
    malformed) printf '0\n1\n' > "${scratch}/expected-queries" ;;
    invalid-revision|expired|config) test ! -e "${scratch}/case-${mode}/queries"; continue ;;
    *) printf '0\n' > "${scratch}/expected-queries" ;;
  esac
  cmp "${scratch}/expected-queries" "${scratch}/case-${mode}/queries"
done
complete=1
printf 'source Git: real SHA1/SHA256 ordinary/linked + controlled query/environment/cleanup PASS\n'
