print("moe model forward qualification: wall %.3f ms, reference compute %.3f ms, oracle %.3f ms"
      % (timings["elapsed_ns"] / 1e6, timings["reference_compute_ns"] / 1e6,
         timings["oracle_ns"] / 1e6))
print("moe model forward qualification: %d graphs, %d ggml nodes (tables %d + %d), activation peak "
      "%d B, slot high water %d/%d"
      % (graph["graph_count"], graph["node_count_total"], graph["table_rows_a"],
         graph["table_rows_b"], graph["activation_bytes_peak"], graph["slot_high_water"],
         graph["slot_capacity"]))
print("moe model forward qualification: pack reader %d preads for %d bytes; reference arm %d preads "
      "for %d bytes"
      % (d["pack"]["reader_pread_count"], d["pack"]["reader_bytes_read"],
         reference["pread_count"], reference["bytes_read"]))
print("moe model forward qualification: dense window %d B, claim window %d B reserved at U_max %d, "
      "peak use %d B at layer %d"
      % (window["dense_bytes"], window["claim_bytes"], window["claim_u_max"],
         window["claim_peak_use_bytes"], window["claim_peak_use_layer"]))
print("moe model forward qualification: peak resident weight bytes %d against %d for the model — "
      "%.2f%%"
      % (window["dense_bytes"] + window["claim_bytes"], residency["model_bytes"],
         100.0 * (window["dense_bytes"] + window["claim_bytes"]) / residency["model_bytes"]))
print("moe model forward qualification: **residency** %d/%d expert bytes = %d ppm (%.2f%%), "
      "%d/%d planes, %d/%d keys"
      % (residency["expert_bytes_read"], residency["expert_bytes_in_model"],
         residency["expert_bytes_read_ppm"],
         100.0 * residency["expert_bytes_read"] / residency["expert_bytes_in_model"],
         residency["planes_read"], residency["planes_in_model"],
         residency["keys_demanded"], 16 * model["n_expert"]))
print("moe model forward qualification: whole prefill %d/%d bytes = %.2f%% of the container"
      % (residency["total_bytes_read"], residency["model_bytes"],
         100.0 * residency["total_bytes_read"] / residency["model_bytes"]))
for row in schedule:
    print("moe model forward qualification: L%-2d U=%-2d claim %10d B (%5.1f%%) cumulative %10d B "
          "(%5.2f%%) down=%s A/B %d/%d nodes  sum=%d"
          % (row["layer"], row["routed_count"], row["claim_bytes"],
             100.0 * row["routed_count"] / model["n_expert"],
             residency["cumulative_expert_bytes"][row["layer"]],
             100.0 * residency["cumulative_expert_bytes"][row["layer"]]
             / residency["expert_bytes_in_model"],
             "Q6_K" if row["ffn_down_exps_ggml_type"] == 14 else "Q4_K",
             row["node_count_a"], row["node_count_b"], row["l_out_f32_sum_millionths"]))
    print("moe model forward qualification:      routed %s"
          % ",".join(str(e) for e in row["routed"]))
print("moe model forward qualification: self-reference %s (%d/%d nodes byte-identical over %d "
      "graphs)"
      % (reference["verdict"], reference["nodes_identical"], reference["nodes_compared"],
         reference["graphs_compared"]))
print("moe model forward qualification: routing identity %s, %d/%d printed ids over %d slots, "
      "%d/%d block sums"
      % (routing_oracle["verdict"], routing_oracle["ids_printed_matched"],
         routing_oracle["ids_printed_compared"], routing_oracle["ids_total"],
         routing_oracle["sums_matched"], routing_oracle["sums_expected"]))
print("moe model forward qualification: transcript %s, %d/%d layers, %d/%d nodes, %d elements, "
      "max |d| %d ten-thousandths, max |dsum| %d millionths"
      % (oracle["verdict"], oracle["layers_matched"], oracle["layers_expected"],
         oracle["nodes_matched"], oracle["nodes_expected"], oracle["elements_compared"],
         oracle["max_abs_diff_ten_thousandths"], oracle["max_sum_diff_millionths"]))
