#!/usr/bin/env python3
"""Exercise private source reconstruction from an admitted G1 input package."""

from __future__ import annotations

import importlib.machinery
import pathlib
import os
import sys
import tempfile


ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "scripts"))

import gpu_backend_recipe as recipe  # noqa: E402
import gpu_qualification_input as qualification_input  # noqa: E402
import gpu_qualification_source as qualification_source  # noqa: E402


def fixture_module():
    path = ROOT / "scripts" / "run-gpu-input-admission-smoke"
    loader = importlib.machinery.SourceFileLoader("gpu_input_fixture_source", str(path))
    return loader.load_module()


def expect_rejected(call, message: str) -> None:
    try:
        call()
    except recipe.RecipeError as error:
        assert message in str(error), (message, str(error))
    else:
        raise AssertionError(f"source materialization unexpectedly passed: {message}")


fixture = fixture_module()
with tempfile.TemporaryDirectory(prefix="gpu-source-materialization-") as raw_temporary:
    temporary = pathlib.Path(raw_temporary)
    input_root = temporary / "input"
    input_root.mkdir()
    fixture.materialize(input_root)
    admitted = qualification_input.admit(input_root / "profile.json")

    private_parent = temporary / "private"
    private_parent.mkdir(mode=0o700)
    sources = qualification_source.materialize(admitted, private_parent)
    assert sources.root.stat().st_mode & 0o077 == 0
    for source_input, destination in (
        (admitted.align_source, sources.align_llm),
        (admitted.ggml_source, sources.ggml),
    ):
        rows = source_input.manifest["files"]
        assert isinstance(rows, list)
        for row in rows:
            assert isinstance(row, dict)
            target = destination / str(row["path"])
            if row["mode"] == "120000":
                assert target.is_symlink()
            else:
                assert target.read_bytes() == source_input.blobs[str(row["sha256"])]
    # Recheck after native children using the same owner; never follow a replaced source root
    # or block on a FIFO introduced after initial source materialization.
    qualification_source._verify_tree(admitted.align_source, sources.align_llm)
    row = next(row for row in admitted.align_source.manifest["files"] if row["mode"] != "120000")
    target = sources.align_llm / row["path"]
    original_data, original_mode = target.read_bytes(), target.stat().st_mode
    target.unlink()
    os.mkfifo(target)
    expect_rejected(lambda: qualification_source._verify_tree(admitted.align_source, sources.align_llm), "mode differs")
    target.unlink()
    target.write_bytes(original_data)
    target.chmod(original_mode)
    target.write_bytes(original_data + b"mutated")
    expect_rejected(lambda: qualification_source._verify_tree(admitted.align_source, sources.align_llm), "bound")
    target.write_bytes(original_data)
    extra = sources.align_llm / "unexpected-empty-directory"
    extra.mkdir()
    expect_rejected(lambda: qualification_source._verify_tree(admitted.align_source, sources.align_llm), "directory closure")
    extra.rmdir()
    moved = sources.align_llm.with_name("moved-app")
    sources.align_llm.rename(moved)
    sources.align_llm.symlink_to(moved, target_is_directory=True)
    expect_rejected(lambda: qualification_source._verify_tree(admitted.align_source, sources.align_llm), "cannot be read")
    sources.align_llm.unlink()
    moved.rename(sources.align_llm)
    qualification_source._verify_tree(admitted.align_source, sources.align_llm)
    sources.cleanup()
    assert not sources.root.exists()

    occupied_parent = temporary / "occupied-parent"
    occupied_parent.mkdir(mode=0o700)
    (occupied_parent / "source").write_text("occupied")
    expect_rejected(
        lambda: qualification_source.materialize(admitted, occupied_parent),
        "output is occupied",
    )

    public_parent = temporary / "public"
    public_parent.mkdir(mode=0o755)
    expect_rejected(
        lambda: qualification_source.materialize(admitted, public_parent),
        "not a private directory",
    )

    changed_parent = temporary / "changed-parent"
    changed_parent.mkdir(mode=0o700)
    profile = input_root / "profile.json"
    original = profile.read_bytes()
    original_materialize = qualification_source.materialize_source

    def mutate_after_first(manifest, blobs, destination):
        original_materialize(manifest, blobs, destination)
        if destination.name == "align-llm":
            profile.write_bytes(original + b" ")

    qualification_source.materialize_source = mutate_after_first
    expect_rejected(
        lambda: qualification_source.materialize(admitted, changed_parent),
        "record framing is invalid",
    )
    assert not (changed_parent / "source").exists()
    profile.write_bytes(original)

print("gpu source materialization smoke: ok")
