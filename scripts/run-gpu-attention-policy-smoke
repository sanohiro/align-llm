#!/usr/bin/env python3
"""Run the real pinned-backend Flash owner using already admitted local build artifacts."""
import os
from pathlib import Path
import subprocess
import sys
import tempfile

from gpu_backend_recipe import GGML_COMMIT

if len(sys.argv) != 4:
    raise SystemExit('usage: run-gpu-attention-policy-smoke GGML_SOURCE CORE_LIBRARY_DIRECTORY BACKEND_PLUGIN')
source, libraries, plugin = (Path(value).resolve(strict=True) for value in sys.argv[1:])
root = Path(__file__).resolve().parents[1]
revision = subprocess.check_output(['git', '-C', str(source), 'rev-parse', 'HEAD'], text=True).strip()
if revision != GGML_COMMIT or subprocess.check_output(['git', '-C', str(source), 'status', '--porcelain']):
    raise SystemExit('attention owner requires the clean pinned ggml source')
environment = {key: value for key, value in os.environ.items() if not key.startswith('GGML_')}
with tempfile.TemporaryDirectory(prefix='gpu-attention-policy-') as temporary:
    executable = Path(temporary) / 'owner'
    command = [os.environ.get('CC', 'cc'), '-std=c11', '-O2', '-Wall', '-Wextra', '-Werror',
        '-ffp-contract=off', '-DALIGN_GGML_FP_CONTRACT_OFF=1', '-I' + str(source / 'ggml/include'),
        str(root / 'scripts/gpu_attention_policy_smoke.c'), '-L' + str(libraries),
        '-Wl,-rpath,' + str(libraries), '-lggml', '-lggml-base', '-lm', '-o', str(executable)]
    if sys.platform != 'darwin':
        command += ['-ldl']
    subprocess.run(command, check=True, env=environment)
    subprocess.run([str(executable), str(plugin)], check=True, env=environment, timeout=60)
