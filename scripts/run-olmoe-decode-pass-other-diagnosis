    "total_ns", "plane_roundtrip_compare_ns", "graph_member_spec_ns",
    "layer_step_accounting_ns", "other_ns",
}
BUCKET_ORDER = (
    "PLANE_ROUNDTRIP_COMPARE", "GRAPH_MEMBER_SPEC", "LAYER_STEP_ACCOUNTING",
    "OTHER_PASS_REMAINDER",
)
