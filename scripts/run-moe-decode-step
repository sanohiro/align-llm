#!/usr/bin/env bash

set -euo pipefail

# R6-OLMOE-DECODE named focused qualification (`docs/specs/r6-olmoe-decode.md` section 6.2).
# **Opt-in and capable-only.** It is in neither HOSTED_CHECK_TARGETS nor CAPABLE_ONLY_CHECK_TARGETS
# and in no aggregate, exactly as the five existing `*-qualification` targets are not.
#
#   ALIGN_LLM_GGML_INCLUDE                directory holding ggml.h, ggml-alloc.h, ggml-backend.h
#   ALIGN_LLM_GGML_LIB                    directory holding libggml and libggml-base
#   ALIGN_LLM_GGUF_MODEL                  the **olmoe** GGUF these decode steps are read from
#   ALIGN_LLM_LLAMA_EVAL_CALLBACK         path to `llama-eval-callback`, **R2C-patched**
#   ALIGN_LLM_LLAMA_DEBUG                 path to `llama-debug`
#   ALIGN_LLM_MOE_DECODE_STEP_TMPDIR      where the pack is written; defaults to TMPDIR
#   ALIGN_LLM_DECODE_STEPS                `N`; defaults to 16 and is the documented cost fallback
#   ALIGN_LLM_MOE_DECODE_STEP_PROMPTS     how many of the four prompts to run; defaults to 4
#
# When any of the **first five** is unset, when the model or either instrument is absent, when the
# model is not an olmoe container, when `numpy` is not importable, or when the free space is under
# the pack's size plus 2 GiB, it prints one explicit N/A line naming the missing input and exits 0.
# The three below them are optional and have defaults, so none is ever an N/A condition — the
# scratch location in particular **selects a location** and never skips the run.
#
# **The instrument must be the R2C-patched build.** Full router axes are what make oracle R
# element-wise complete at 8 of 8 slots; an unpatched instrument prints six of eight and the
# coverage assertion below fails rather than silently passing over a narrower comparison.
#
# What it does, in order:
#
#   1. cell **G-P1**: measures `token_embd.weight`'s printed-fingerprint collision classes once, so
#      gate G is claimed over a vocabulary whose injectivity was measured in this run;
#   2. per prompt: captures both instruments with the exact flag set section 4.1 fixes, asserts the
#      tokenizer's ids, asserts the transcript holds exactly `N + 1` graphs, and cross-checks the
#      two instruments against each other **before** the arm runs, so an instrument skew is reported
#      as an instrument skew and not as a failing oracle;
#   3. runs `ggml-spike --moe-decode-step` three times and requires the three documents to be
#      identical after normalization;
#   4. asserts section 4.6's acceptance rule in full: gate G, oracle R, oracle B, oracle T, and the
#      claim accounting;
#   5. runs oracle C′ at `k ∈ {1, ⌈N/2⌉, N}` as whole `--moe-model-forward` prefills at `T + k`
#      tokens, and reports `IDENTICAL` or the measured bound rather than assuming either;
#   6. prints the demand-stream table section 5 of the design records.
#
# Everything is removed on every exit path including a signal.

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
compiler="${ALIGNC:-${root_dir}/scripts/alignc}"

na() {
  printf '%s\n' "moe decode step qualification: N/A $1"
  exit 0
}

[ -n "${ALIGN_LLM_GGML_INCLUDE:-}" ] || na "ALIGN_LLM_GGML_INCLUDE is unset"
[ -n "${ALIGN_LLM_GGML_LIB:-}" ] || na "ALIGN_LLM_GGML_LIB is unset"
[ -n "${ALIGN_LLM_GGUF_MODEL:-}" ] || na "ALIGN_LLM_GGUF_MODEL is unset"
[ -n "${ALIGN_LLM_LLAMA_EVAL_CALLBACK:-}" ] || na "ALIGN_LLM_LLAMA_EVAL_CALLBACK is unset"
[ -n "${ALIGN_LLM_LLAMA_DEBUG:-}" ] || na "ALIGN_LLM_LLAMA_DEBUG is unset"
[ -d "${ALIGN_LLM_GGML_INCLUDE}" ] || na "ALIGN_LLM_GGML_INCLUDE is not a directory"
[ -d "${ALIGN_LLM_GGML_LIB}" ] || na "ALIGN_LLM_GGML_LIB is not a directory"
[ -f "${ALIGN_LLM_GGUF_MODEL}" ] || na "ALIGN_LLM_GGUF_MODEL is not a file"
command -v "${ALIGN_LLM_LLAMA_EVAL_CALLBACK}" >/dev/null 2>&1 \
  || [ -x "${ALIGN_LLM_LLAMA_EVAL_CALLBACK}" ] \
  || na "ALIGN_LLM_LLAMA_EVAL_CALLBACK is not executable"
command -v "${ALIGN_LLM_LLAMA_DEBUG}" >/dev/null 2>&1 \
  || [ -x "${ALIGN_LLM_LLAMA_DEBUG}" ] \
  || na "ALIGN_LLM_LLAMA_DEBUG is not executable"
# Gate G's injectivity measurement dequantizes 50,304 rows and needs `numpy`. A gate claimed without
# it would be a gate over a vocabulary nobody measured, so its absence is an N/A and never a pass.
python3 -c 'import numpy' >/dev/null 2>&1 || na "numpy is not importable by python3"

steps="${ALIGN_LLM_DECODE_STEPS:-16}"
case "${steps}" in
  ''|*[!0-9]*) echo "moe decode step qualification: FAIL ALIGN_LLM_DECODE_STEPS=${steps}" >&2
               exit 1 ;;
esac
[ "${steps}" -ge 1 ] || { echo "moe decode step qualification: FAIL STEPS < 1" >&2; exit 1; }
prompt_limit="${ALIGN_LLM_MOE_DECODE_STEP_PROMPTS:-4}"

model_bytes=$(wc -c < "${ALIGN_LLM_GGUF_MODEL}" | tr -d ' ')
scratch_root="${ALIGN_LLM_MOE_DECODE_STEP_TMPDIR:-${TMPDIR:-/tmp}}"
[ -d "${scratch_root}" ] || na "the scratch root ${scratch_root} does not exist"
free_kib=$(df -Pk "${scratch_root}" | awk 'NR == 2 { print $4 }')
need_kib=$(( model_bytes / 1024 + 2097152 ))
if [ "${free_kib}" -lt "${need_kib}" ]; then
  na "free space under ${scratch_root} is ${free_kib} KiB, below the ${need_kib} KiB the pack needs"
fi

work_dir=$(mktemp -d "${scratch_root%/}/align-r6m-XXXXXX")
shim_built=0
cleanup() {
  status=$?
  if [ "${shim_built}" = 1 ]; then
    ALIGN_LLM_GGML_FORCE= "${root_dir}/scripts/build-ggml-shim" >/dev/null 2>&1 || true
  fi
  rm -rf "${work_dir}"
  exit "${status}"
}
trap cleanup EXIT HUP INT TERM

echo "moe decode step qualification: reading the geometry of ${ALIGN_LLM_GGUF_MODEL}"
"${root_dir}/main" --model-ir "${ALIGN_LLM_GGUF_MODEL}" "${work_dir}/geometry.json" >/dev/null
arch=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["model"]["arch"])' \
  "${work_dir}/geometry.json")
[ "${arch}" = "olmoe" ] || na "ALIGN_LLM_GGUF_MODEL is not an olmoe model"

# ---------------------------------------------------------------------------------------------
# Cell G-P1 (section 5.7). Gate G's load-bearing measurement, taken **once** and before any arm
# runs: the collision classes of this model's printed `token_embd.weight` fingerprints. The gate is
# then claimed over a vocabulary whose injectivity was measured in this run, and a decoded id inside
# a colliding class is refused per step rather than silently gated on an ambiguous fingerprint.
# ---------------------------------------------------------------------------------------------
echo "moe decode step qualification: cell G-P1 -- measuring token_embd.weight's fingerprints"
python3 "${root_dir}/scripts/decode_step_fingerprint.py" "${ALIGN_LLM_GGUF_MODEL}" \
  "${work_dir}/fingerprints.json"

echo "moe decode step qualification: packing ${ALIGN_LLM_GGUF_MODEL} into ${work_dir}"
"${root_dir}/main" --pack "${ALIGN_LLM_GGUF_MODEL}" "${work_dir}/model.alignpack" \
  "${work_dir}/pack.json" >/dev/null

shim_dir=$(ALIGN_LLM_GGML_FORCE= "${root_dir}/scripts/build-ggml-shim")
shim_built=1
(
  cd "${root_dir}"
  LIBRARY_PATH="${shim_dir}${LIBRARY_PATH:+:${LIBRARY_PATH}}" \
  DYLD_LIBRARY_PATH="${shim_dir}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}" \
  LD_LIBRARY_PATH="${shim_dir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
  "${compiler}" build src/ggml_spike.align >/dev/null
  mv -f ggml_spike ggml-spike
)
export DYLD_LIBRARY_PATH="${shim_dir}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}"
export LD_LIBRARY_PATH="${shim_dir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

KV_WIDTH=256

# Four prompts, each at most six tokens. The first is R5E's own; the other three were chosen here and
# their ids were **measured once and recorded**, which is what the design asked for — an expected id
# list the assertion can be made against rather than one this runner invents. Six is the cap the
# **oracle** imposes on a prefill that is compared (`R5_ORACLE_TRUNCATED`), and this arm's prefill is
# not compared — but oracle C′ re-runs it through `--moe-model-forward`, so keeping every prompt at
# or below six keeps that arm's own transcript refusal irrelevant to this qualification.
#
# The expected id list is asserted **before** the arm runs. A tokenizer change is then a named
# failure rather than a silent refusal or, worse, a run over a different sequence.
PROMPTS=(
  "def add(a, b|1545,823,9,66,13,270"
  "The capital of|510,5347,273"
  "import os|2948,7684"
  "return x +|2309,1269,559"
)
if [ "${prompt_limit}" -lt "${#PROMPTS[@]}" ]; then
  PROMPTS=("${PROMPTS[@]:0:${prompt_limit}}")
fi

# Section 4.1's flag set, contractual and not an invocation detail: build 10566 defaults to
# `-fa auto`, an f16 KV cache, and repacked quantized weights, and none of those three is the graph
# this arm computes. `--temp 0 -s 0` makes the sampler greedy and the run reproducible, which is
# what makes "the ids llama.cpp itself produces" a fact rather than a sample.
capture() {
  local prompt="$1" tag="$2"
  "${ALIGN_LLM_LLAMA_EVAL_CALLBACK}" -m "${ALIGN_LLM_GGUF_MODEL}" -p "${prompt}" \
    -n "${steps}" -t 4 -ngl 0 -fa off -ctk f32 -ctv f32 -nr -c 512 --temp 0 -s 0 \
    > "${work_dir}/${tag}-transcript.txt" 2> "${work_dir}/${tag}-transcript.log"
  "${ALIGN_LLM_LLAMA_DEBUG}" -m "${ALIGN_LLM_GGUF_MODEL}" -p "${prompt}" \
    -n 1 -t 4 -ngl 0 -fa off -ctk f32 -ctv f32 -nr -c 512 --temp 0 -s 0 \
    --save-logits --logits-output-dir "${work_dir}/${tag}-lg" \
    > "${work_dir}/${tag}-debug.log" 2>&1
}

rows_json="${work_dir}/rows.jsonl"
: > "${rows_json}"

index=0
for entry in "${PROMPTS[@]}"; do
  index=$(( index + 1 ))
  prompt="${entry%%|*}"
  expected_ids="${entry##*|}"
  tag="p${index}"
  echo "moe decode step qualification: prompt ${index}/${#PROMPTS[@]} -- capturing both instruments" \
    "at -n ${steps}"
  capture "${prompt}" "${tag}"

  logits_bin=$(ls "${work_dir}/${tag}-lg"/*.bin 2>/dev/null | grep -v -- '-tokens\.bin$' | head -1 \
    || true)
  tokens_bin=$(ls "${work_dir}/${tag}-lg"/*-tokens.bin 2>/dev/null | head -1 || true)
  if [ -z "${logits_bin}" ] || [ -z "${tokens_bin}" ]; then
    echo "moe decode step qualification: FAIL llama-debug exited 0 and wrote no logits or tokens" \
      "file for prompt ${index}" >&2
    tail -20 "${work_dir}/${tag}-debug.log" >&2 || true
    exit 1
  fi

  tokens=$(python3 - "${work_dir}/${tag}-transcript.log" <<'IDS'
import re
import sys

with open(sys.argv[1], "r", encoding="utf-8", errors="replace") as handle:
    lines = handle.read().split("\n")
at = next(i for i, line in enumerate(lines) if "number of input tokens" in line)
count = int(re.search(r"number of input tokens = (\d+)", lines[at]).group(1))
print(",".join(line.split()[-1] for line in lines[at + 1:at + 1 + count]))
IDS
)
  if [ "${tokens}" != "${expected_ids}" ]; then
    echo "moe decode step qualification: FAIL the tokenizer produced ${tokens} for" \
      "'${prompt}', not the recorded ${expected_ids}" >&2
    exit 1
  fi

  # Rule 9 of section 4.6, checked **before** the arm runs: the transcript must hold exactly
  # `N + 1` graphs. Fewer means llama.cpp stopped early (EOS) and the prompt is refused rather than
  # compared over a shorter run — the runner's graph count is this capability's EOS detector.
  graphs=$(grep -c 'common_debug_cb_eval:.* embd = ' "${work_dir}/${tag}-transcript.txt" || true)
  if [ "${graphs}" != "$(( steps + 1 ))" ]; then
    echo "moe decode step qualification: FAIL prompt ${index} produced ${graphs} graphs, not" \
      "$(( steps + 1 )); llama.cpp stopped early and this prompt cannot be compared at N=${steps}" >&2
    exit 1
  fi

  python3 - "${work_dir}/${tag}-transcript.txt" "${logits_bin}" "${tokens_bin}" "${tokens}" <<'PY'
import struct
import sys

transcript, logits_path, tokens_path, expected = sys.argv[1:5]
with open(logits_path, "rb") as handle:
    raw = handle.read()
values = struct.unpack("<%df" % (len(raw) // 4), raw)
total = 0.0
for value in values:
    total = struct.unpack("<f", struct.pack("<f", total + value))[0]
printed = None
seen = False
with open(transcript, "r", encoding="utf-8", errors="replace") as handle:
    for line in handle:
        if line.startswith("common_debug_cb_eval:") and " result_output = " in line:
            seen = True
            continue
        if seen and line.strip().startswith("sum ="):
            printed = float(line.strip().split("=")[1])
            break
failures = []
if printed is None:
    failures.append("the transcript prints no sum for result_output")
elif abs(printed - total) > 1e-3 * max(1.0, abs(printed)):
    failures.append("the two instruments disagree: transcript %r, logits %r" % (printed, total))
with open(tokens_path, "rb") as handle:
    token_raw = handle.read()
ids = ",".join(str(v) for v in struct.unpack("<%di" % (len(token_raw) // 4), token_raw))
if ids != expected:
    failures.append("llama-debug tokenized %r, the transcript %r" % (ids, expected))
if failures:
    for line in failures:
        sys.stderr.write("moe decode step qualification: FAIL %s\n" % line)
    raise SystemExit(1)
print("moe decode step qualification: the two instruments agree (result_output sum %.6f)" % total)
PY

  # Three consecutive runs, and the acceptance rule's determinism clause: the three documents must
  # be identical after `normalize`, which zeroes every `*_ns` field and nothing else. `routed`,
  # `residency`, and every byte and ppm figure stay inside the comparison, because they are the
  # claim.
  for repeat in 1 2 3; do
    echo "moe decode step qualification: prompt ${index} run ${repeat}/3 -- N=${steps}," \
      "KV_WIDTH=${KV_WIDTH}"
    /usr/bin/time -p "${root_dir}/ggml-spike" --moe-decode-step \
      "${work_dir}/model.alignpack" "${work_dir}/geometry.json" "${tokens}" \
      "${work_dir}/${tag}-run${repeat}.json" "${ALIGN_LLM_GGUF_MODEL}" \
      "${work_dir}/${tag}-transcript.txt" "${KV_WIDTH}" "${logits_bin}" "${steps}" \
      > "${work_dir}/${tag}-run${repeat}.out" 2> "${work_dir}/${tag}-run${repeat}.time" || {
        status=$?
        cat "${work_dir}/${tag}-run${repeat}.time" >&2 || true
        python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));
print("error_code", d["error_code"], "detail", d["error_detail"])' \
          "${work_dir}/${tag}-run${repeat}.json" >&2 || true
        exit "${status}"
      }
    grep -E '^real' "${work_dir}/${tag}-run${repeat}.time" \
      | sed "s/^/moe decode step qualification: prompt ${index} run ${repeat} /" || true
  done

  # Oracle C′ (section 4.4), at `k in {1, ceil(N/2), N}`: a whole `--moe-model-forward` prefill at
  # `TOKENS,d_1..d_k` and the same `KV_WIDTH`, whose logits digest must reproduce `steps[k].sha256`.
  # It is a **five-operand** invocation with no reference and no transcript: the source comparison
  # and the transcript oracle are the decode run's, and repeating them here would add a gigabyte of
  # GGUF reads per checkpoint for no new proposition.
  half=$(( (steps + 1) / 2 ))
  checkpoints="1 ${half} ${steps}"
  for k in ${checkpoints}; do
    prefix=$(python3 - "${work_dir}/${tag}-run1.json" "${k}" "${tokens}" <<'PY'
import json
import sys

document = json.load(open(sys.argv[1]))
k = int(sys.argv[2])
ids = document["decode"]["token_ids"][:k]
print(sys.argv[3] + "," + ",".join(str(i) for i in ids))
PY
)
    "${root_dir}/ggml-spike" --moe-model-forward "${work_dir}/model.alignpack" \
      "${work_dir}/geometry.json" "${prefix}" "${KV_WIDTH}" \
      "${work_dir}/${tag}-self-${k}.json" >/dev/null
  done

  python3 - "${work_dir}" "${tag}" "${index}" "${steps}" "${tokens}" "${KV_WIDTH}" \
      "${checkpoints}" "${rows_json}" <<'PY'
import json
import os
import sys

work_dir, tag, index, steps, tokens, width, checkpoints, rows_json = sys.argv[1:9]
steps = int(steps)
width = int(width)
prompt_index = int(index)
failures = []


def load(name):
    with open(os.path.join(work_dir, name), "r", encoding="utf-8") as handle:
        return json.load(handle)


def normalize(document):
    def scrub(node):
        if isinstance(node, dict):
            for key in node:
                if key.endswith("_ns") and isinstance(node[key], int):
                    node[key] = 0
                else:
                    scrub(node[key])
        elif isinstance(node, list):
            for item in node:
                scrub(item)
    scrub(document)
    return json.dumps(document, separators=(",", ":"), sort_keys=True)


documents = [load("%s-run%d.json" % (tag, r)) for r in (1, 2, 3)]
d = documents[0]
shapes = {normalize(json.loads(json.dumps(one))) for one in documents}
if len(shapes) != 1:
    failures.append("the three runs are not identical after normalize")


def want(label, got, expected):
    if got != expected:
        failures.append("%s: %r, expected %r" % (label, got, expected))


want("status", d["status"], "ok")
want("verdict", d["verdict"], "EXTERNAL")
want("kind", d["kind"], "R6_MOE_DECODE_STEP")
want("schema_version", d["schema_version"], 1)

model = d["model"]
want("model.arch", model["arch"], "olmoe")
want("model.n_layer", model["n_layer"], 16)
want("model.n_expert", model["n_expert"], 64)
want("model.n_expert_used", model["n_expert_used"], 8)
# Section 2.2: a decode graph does not narrow, so both fields publish -1 rather than being omitted.
want("selection.narrow_layer", d["selection"]["narrow_layer"], -1)
want("selection.narrow_index", d["selection"]["narrow_index"], -1)
want("selection.attention_width", d["selection"]["attention_width"], width)

# --- Rule 1, gate G ---------------------------------------------------------------------------
decode = d["decode"]
want("decode.steps_requested", decode["steps_requested"], steps)
want("decode.steps_completed", decode["steps_completed"], steps)
want("decode.token_ids length", len(decode["token_ids"]), steps)
want("oracle_logits.verdict (gate G1)", d["oracle_logits"]["verdict"], "IDENTICAL")
if not d["oracle_logits"]["byte_identical"]:
    failures.append("gate G1: the prefill's logits are not byte-identical to llama-debug's")

with open(os.path.join(work_dir, "fingerprints.json"), "r", encoding="utf-8") as handle:
    fingerprints = json.load(handle)
colliding = set(fingerprints["colliding_ids"])
non_degenerate = set(fingerprints["colliding_ids_that_are_not_all_zero"])
hit = [i for i in decode["token_ids"] if i in colliding]
if hit:
    failures.append("gate G2: prompt %s decoded %r, which are members of a measured collision "
                    "class; the gate does not hold over them and section 4.2's G3 is the declared "
                    "response" % (index, hit))

# --- Rule 2, oracle R -------------------------------------------------------------------------
routing = d["routing_oracle"]
want("routing_oracle.verdict", routing["verdict"], "MATCH")
want("routing_oracle.steps_compared", routing["steps_compared"], steps)
want("routing_oracle.layers_matched", routing["layers_matched"], 16 * steps)
want("routing_oracle.ids_total", routing["ids_total"], 128 * steps)
want("routing_oracle.ids_printed_compared", routing["ids_printed_compared"], 128 * steps)
want("routing_oracle.ids_printed_matched", routing["ids_printed_matched"], 128 * steps)

# --- Rule 3, oracle B -------------------------------------------------------------------------
plane = d["plane"]
want("plane.roundtrip_verdict", plane["roundtrip_verdict"], "IDENTICAL")
want("plane.source", plane["source"], "PREFILL")
token_count = len(tokens.split(","))
want("plane.bytes", plane["bytes"], 16 * 2 * width * 16 * 128 * 4)
want("plane.columns_written", plane["columns_written"], token_count + steps)
expected_roundtrip = sum(2 * 16 * (token_count + k) * 16 * 128 * 4 for k in range(1, steps + 1))
want("plane.roundtrip_bytes_compared", plane["roundtrip_bytes_compared"], expected_roundtrip)

# --- Rule 5 and 6, oracle T -------------------------------------------------------------------
oracle = d["oracle_decode"]
want("oracle_decode.steps_compared", oracle["steps_compared"], steps)
want("oracle_decode.instrument_graph_first", oracle["instrument_graph_first"], 2)
want("oracle_decode.instrument_graph_last", oracle["instrument_graph_last"], steps + 1)
want("oracle_decode.instrument_kv_width", oracle["instrument_kv_width"], width)
want("oracle_decode.layers_matched", oracle["layers_matched"], 16 * steps)
want("oracle_decode.tolerance_ten_thousandths", oracle["tolerance_ten_thousandths"], 1)
if oracle["elements_compared"] <= 0:
    failures.append("oracle T compared nothing and still reported %r" % oracle["verdict"])
for row in d["steps"]:
    if row["oracle"]["instrument_graph"] != row["index"] + 1:
        failures.append("step %d was compared against graph %d"
                        % (row["index"], row["oracle"]["instrument_graph"]))
    if row["oracle"]["nodes_matched"] != 227:
        failures.append("step %d matched %d comparable nodes, not 227"
                        % (row["index"], row["oracle"]["nodes_matched"]))
    if row["oracle"]["layers_matched"] != 16:
        failures.append("step %d compared %d layers, not 16"
                        % (row["index"], row["oracle"]["layers_matched"]))
    if row["oracle"]["elements_compared"] <= 0:
        failures.append("step %d compared no elements" % row["index"])
# Rule 6: oracle T is numerically admitted at step 1 only; steps 2..N are characterization and their
# maxima are reported rather than gated.
step_one = d["steps"][0]["oracle"]
if step_one["verdict"] != "PASS" and step_one["max_abs_diff_ten_thousandths"] > 5000:
    failures.append("oracle T at step 1: %r with max_abs %d, outside R6's admission rule"
                    % (step_one["verdict"], step_one["max_abs_diff_ten_thousandths"]))

# --- Rule 7, the claim accounting -------------------------------------------------------------
block_align = d["pack"]["block_align"]
for row in d["steps"]:
    residency = row["residency"]
    routed = row["routed"]
    if residency["expert_bytes"] != 487587840:
        failures.append("step %d claims %d expert bytes, not the 487,587,840 section 2.3 derives"
                        % (row["index"], residency["expert_bytes"]))
    if residency["expert_bytes_ppm"] != 125000:
        failures.append("step %d is %d ppm, not the exact 125,000"
                        % (row["index"], residency["expert_bytes_ppm"]))
    if routed["keys_demanded"] != 128:
        failures.append("step %d demanded %d keys, not 16 layers x 8"
                        % (row["index"], routed["keys_demanded"]))
    if residency["claim_planes_read"] != 384:
        failures.append("step %d read %d claim planes, not 128 x 3"
                        % (row["index"], residency["claim_planes_read"]))
    if len(routed["layers"]) != 16 or any(len(x) != 8 for x in routed["layers"]):
        failures.append("step %d routed %r" % (row["index"], [len(x) for x in routed["layers"]]))
    if residency["expert_pread_bytes"] < residency["expert_bytes"]:
        failures.append("step %d read %d bytes for a %d-byte claim"
                        % (row["index"], residency["expert_pread_bytes"],
                           residency["expert_bytes"]))
    ceiling = residency["expert_bytes"] + residency["claim_planes_read"] * block_align
    if residency["expert_pread_bytes"] > ceiling:
        failures.append("step %d read %d bytes, above the %d the chunk granularity allows"
                        % (row["index"], residency["expert_pread_bytes"], ceiling))

# --- Oracle C', on the branch the measurement selects ------------------------------------------
self_rows = []
for k in [int(x) for x in checkpoints.split()]:
    reference = load("%s-self-%d.json" % (tag, k))
    step = d["steps"][k - 1]
    if reference["status"] != "ok":
        failures.append("oracle C' at k=%d: the self-reference prefill failed with %r"
                        % (k, reference["error_code"]))
        continue
    identical = reference["output"]["sha256"] == step["sha256"]
    same_argmax = reference["output"]["argmax"] == step["argmax"]
    self_rows.append({"k": k, "identical": identical, "argmax": same_argmax,
                      "prefill_sha": reference["output"]["sha256"],
                      "step_sha": step["sha256"],
                      "prefill_argmax": reference["output"]["argmax"],
                      "step_argmax": step["argmax"]})
    # Section 4.4 writes both branches in advance and this run selects one. What is required either
    # way is argmax equality: a self-reference that disagreed about the token would mean the decode
    # loop and the prefill compute different models, which no tolerance excuses.
    if not same_argmax:
        failures.append("oracle C' at k=%d: the prefill's argmax %r is not the step's %r"
                        % (k, reference["output"]["argmax"], step["argmax"]))

# --- The demand stream, which is the deliverable -----------------------------------------------
residency = d["residency"]
row = {
    "prompt": prompt_index,
    "tokens": tokens,
    "token_ids": decode["token_ids"],
    "steps": steps,
    "routing_matched": routing["ids_printed_matched"],
    "routing_total": routing["ids_total"],
    "step_expert_bytes": d["steps"][0]["residency"]["expert_bytes"],
    "step_expert_pread_bytes": [r["residency"]["expert_pread_bytes"] for r in d["steps"]],
    "amplification_ppm": [r["residency"]["expert_read_amplification_ppm"] for r in d["steps"]],
    "union_keys": [r["routed"]["union_keys_after"] for r in d["steps"]],
    "union_bytes": [r["routed"]["union_bytes_after"] for r in d["steps"]],
    "new_keys": [r["routed"]["new_keys"] for r in d["steps"]],
    "new_bytes": [r["routed"]["new_bytes"] for r in d["steps"]],
    "prefill_expert_bytes": residency["prefill_expert_bytes"],
    "decode_expert_bytes": residency["decode_expert_bytes"],
    "decode_expert_pread_bytes": residency["decode_expert_pread_bytes"],
    "union_keys_final": residency["union_keys_final"],
    "union_bytes_final": residency["union_bytes_final"],
    "decode_keys_demanded": residency["decode_keys_demanded"],
    "decode_keys_in_prefill_union": residency["decode_keys_in_prefill_union"],
    "step_reuse_per_mille": residency["step_reuse_per_mille"],
    "claim_decode_peak_use_bytes": d["window"]["claim_decode_peak_use_bytes"],
    "claim_bytes": d["window"]["claim_bytes"],
    "elapsed_ns": d["timings"]["elapsed_ns"],
    "compute_ns": d["timings"]["compute_ns"],
    "decode_compute_ns": d["timings"]["decode_compute_ns"],
    "pread_ns": d["timings"]["pread_ns"],
    "claim_pread_ns": d["timings"]["claim_pread_ns"],
    "first_token_ns": d["timings"]["first_token_ns"],
    "oracle_max_abs": oracle["max_abs_diff_ten_thousandths"],
    "step_oracle_max_abs": [r["oracle"]["max_abs_diff_ten_thousandths"] for r in d["steps"]],
    "self_reference": self_rows,
    "table_rows_a_decode": d["graph"]["table_rows_a_decode"],
    "slot_high_water": d["graph"]["slot_high_water"],
    "graph_count": d["decode"]["graph_count"],
    "fingerprint_collisions": len(non_degenerate),
}
with open(rows_json, "a", encoding="utf-8") as handle:
    handle.write(json.dumps(row, separators=(",", ":")) + "\n")

if failures:
    for line in failures:
        sys.stderr.write("moe decode step qualification: FAIL prompt %s %s\n" % (index, line))
    raise SystemExit(1)
mean_new = sum(row["new_bytes"]) / float(len(row["new_bytes"]))
print("moe decode step qualification: prompt %s PASS -- %d ids gated, routing %d/%d, oracle B %d "
      "bytes, union %d keys / %d bytes, marginal mean %.1f MB against a %.1f MB streamed step"
      % (index, len(decode["token_ids"]), routing["ids_printed_matched"], routing["ids_total"],
         plane["roundtrip_bytes_compared"], residency["union_keys_final"],
         residency["union_bytes_final"], mean_new / 1e6,
         d["steps"][0]["residency"]["expert_bytes"] / 1e6))
PY
done

python3 - "${rows_json}" "${work_dir}/fingerprints.json" "${steps}" <<'PY'
import json
import sys

rows = [json.loads(line) for line in open(sys.argv[1]) if line.strip()]
fingerprints = json.load(open(sys.argv[2]))
steps = int(sys.argv[3])
print("")
print("moe decode step qualification: cell G-P1 -- %d rows of %s, %d distinct fingerprints, "
      "%d collision class(es) covering %d ids, %d of them not all-zero (%r)"
      % (fingerprints["n_vocab"], fingerprints["ggml_type"], fingerprints["distinct_fingerprints"],
         fingerprints["collision_classes"], fingerprints["colliding_id_count"],
         len(fingerprints["colliding_ids_that_are_not_all_zero"]),
         fingerprints["colliding_ids_that_are_not_all_zero"]))
print("")
print("| prompt | ids | routing | step bytes | pread | ampl ppm | union keys | union bytes | "
      "marginal MB | in prefill | reuse ppm | elapsed s |")
print("| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |")
for row in rows:
    marginal = sum(row["new_bytes"]) / float(len(row["new_bytes"]))
    print("| %d | %s | %d/%d | %d | %d | %d | %d | %d | %.1f | %d/%d | %d | %.2f |"
          % (row["prompt"], ",".join(str(i) for i in row["token_ids"][:4]) + "...",
             row["routing_matched"], row["routing_total"], row["step_expert_bytes"],
             row["step_expert_pread_bytes"][0], row["amplification_ppm"][0],
             row["union_keys_final"], row["union_bytes_final"], marginal / 1e6,
             row["decode_keys_in_prefill_union"], row["decode_keys_demanded"],
             row["step_reuse_per_mille"], row["elapsed_ns"] / 1e9))
print("")
for row in rows:
    print("moe decode step qualification: prompt %d union curve %s"
          % (row["prompt"], " -> ".join(str(v) for v in row["union_keys"])))
    print("moe decode step qualification: prompt %d marginal bytes %s"
          % (row["prompt"], " ".join(str(v) for v in row["new_bytes"])))
    for entry in row["self_reference"]:
        print("moe decode step qualification: prompt %d oracle C' at k=%d %s (argmax %d vs %d)"
              % (row["prompt"], entry["k"],
                 "IDENTICAL" if entry["identical"] else "NOT byte-identical",
                 entry["prefill_argmax"], entry["step_argmax"]))
print("")
print("moe decode step qualification: %d prompt(s) x %d steps PASS -- gate G, oracle R at %d of %d "
      "ids, oracle B, oracle T, and the claim accounting"
      % (len(rows), steps, sum(r["routing_matched"] for r in rows),
         sum(r["routing_total"] for r in rows)))
