#!/usr/bin/env bash

set -euo pipefail

# R6-OLMOE-DECODE named focused qualification (`docs/specs/r6-olmoe-decode.md` section 6.2).
# **Opt-in and capable-only.** It is in neither HOSTED_CHECK_TARGETS nor CAPABLE_ONLY_CHECK_TARGETS
# and in no aggregate, exactly as the five existing `*-qualification` targets are not.
#
#   ALIGN_LLM_GGML_INCLUDE                directory holding ggml.h, ggml-alloc.h, ggml-backend.h
#   ALIGN_LLM_GGML_LIB                    directory holding libggml and libggml-base
#   ALIGN_LLM_GGUF_MODEL                  the **olmoe** GGUF these decode steps are read from
#   ALIGN_LLM_LLAMA_EVAL_CALLBACK         path to `llama-eval-callback`, **R2C-patched**
#   ALIGN_LLM_LLAMA_DEBUG                 path to `llama-debug`
#   ALIGN_LLM_MOE_DECODE_STEP_TMPDIR      where the pack is written; defaults to TMPDIR
#   ALIGN_LLM_DECODE_STEPS                `N`; defaults to 16 and is the documented cost fallback
#   ALIGN_LLM_MOE_DECODE_STEP_PROMPTS     how many of the four prompts to run; defaults to 4
#   ALIGN_LLM_MOE_RESIDENT_DENSE          `0` skips the `dense` leg and prints one explicit N/A line
#
# When any of the **first five** is unset, when the model or either instrument is absent, when the
# model is not an olmoe container, when `numpy` is not importable, or when the free space is under
# the pack's size plus 2 GiB, it prints one explicit N/A line naming the missing input and exits 0.
# The three below them are optional and have defaults, so none is ever an N/A condition — the
# scratch location in particular **selects a location** and never skips the run.
#
# **The instrument must be the R2C-patched build.** Full router axes are what make oracle R
# element-wise complete at 8 of 8 slots; an unpatched instrument prints six of eight and the
# coverage assertion below fails rather than silently passing over a narrower comparison.
#
# What it does, in order:
#
#   1. cell **G-P1**: measures `token_embd.weight`'s printed-fingerprint collision classes once, so
#      gate G is claimed over a vocabulary whose injectivity was measured in this run;
#   2. compares the arm's `libggml-base` against `llama-debug`'s by resolved object identity, and
#      reports `llama-eval-callback`'s without enforcing it (deviation 4);
#   3. per prompt: captures both instruments with the exact flag set section 4.1 fixes, asserts the
#      tokenizer's ids, asserts the transcript holds exactly `N + 1` graphs, and cross-checks the
#      two instruments against each other **before** the arm runs, so an instrument skew is reported
#      as an instrument skew and not as a failing oracle;
#   4. runs `ggml-spike --moe-decode-step` three times and requires the three documents to be
#      identical after normalization;
#   5. asserts section 4.6's acceptance rule in full: gate G, oracle R, oracle B, oracle T, oracle
#      C′, and the claim accounting;
#   6. runs oracle C′ at `k ∈ {1, ⌈N/2⌉, N}` as whole `--moe-model-forward` prefills at `T + k`
#      tokens and applies section 4.4's pre-committed rule — `IDENTICAL`, or `WITHIN` at 5000
#      ten-thousandths with argmax and top-ten set equality — rather than assuming either branch;
#   7. prints the demand-stream table section 5 of the design records.
#
# Everything is removed on every exit path including a signal.

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
compiler="${ALIGNC:-${root_dir}/scripts/alignc}"

na() {
  printf '%s\n' "moe decode step qualification: N/A $1"
  exit 0
}

[ -n "${ALIGN_LLM_GGML_INCLUDE:-}" ] || na "ALIGN_LLM_GGML_INCLUDE is unset"
[ -n "${ALIGN_LLM_GGML_LIB:-}" ] || na "ALIGN_LLM_GGML_LIB is unset"
[ -n "${ALIGN_LLM_GGUF_MODEL:-}" ] || na "ALIGN_LLM_GGUF_MODEL is unset"
[ -n "${ALIGN_LLM_LLAMA_EVAL_CALLBACK:-}" ] || na "ALIGN_LLM_LLAMA_EVAL_CALLBACK is unset"
[ -n "${ALIGN_LLM_LLAMA_DEBUG:-}" ] || na "ALIGN_LLM_LLAMA_DEBUG is unset"
[ -d "${ALIGN_LLM_GGML_INCLUDE}" ] || na "ALIGN_LLM_GGML_INCLUDE is not a directory"
[ -d "${ALIGN_LLM_GGML_LIB}" ] || na "ALIGN_LLM_GGML_LIB is not a directory"
[ -f "${ALIGN_LLM_GGUF_MODEL}" ] || na "ALIGN_LLM_GGUF_MODEL is not a file"
command -v "${ALIGN_LLM_LLAMA_EVAL_CALLBACK}" >/dev/null 2>&1 \
  || [ -x "${ALIGN_LLM_LLAMA_EVAL_CALLBACK}" ] \
  || na "ALIGN_LLM_LLAMA_EVAL_CALLBACK is not executable"
command -v "${ALIGN_LLM_LLAMA_DEBUG}" >/dev/null 2>&1 \
  || [ -x "${ALIGN_LLM_LLAMA_DEBUG}" ] \
  || na "ALIGN_LLM_LLAMA_DEBUG is not executable"
# Gate G's injectivity measurement dequantizes 50,304 rows and needs `numpy`. A gate claimed without
# it would be a gate over a vocabulary nobody measured, so its absence is an N/A and never a pass.
python3 -c 'import numpy' >/dev/null 2>&1 || na "numpy is not importable by python3"

steps="${ALIGN_LLM_DECODE_STEPS:-16}"
case "${steps}" in
  ''|*[!0-9]*) echo "moe decode step qualification: FAIL ALIGN_LLM_DECODE_STEPS=${steps}" >&2
               exit 1 ;;
esac
[ "${steps}" -ge 1 ] || { echo "moe decode step qualification: FAIL STEPS < 1" >&2; exit 1; }
prompt_limit="${ALIGN_LLM_MOE_DECODE_STEP_PROMPTS:-4}"

# R6-MOE-RESIDENT-DENSE section 5.6's skip switch, on the pattern `ALIGN_LLM_RESIDENT_WEIGHTS=0`
# established. It removes the second leg entirely and prints one explicit `N/A` line; it never
# silently degrades a claim.
#
# **No physical-memory preflight ships and none is needed** (section 3.9). `scripts/run-decode-step`
# refuses its resident leg below 12 GiB because a failed 4.68 GB reservation aborts the process
# inside the runtime's `Vec` growth; here the region is 311 MB on a run that already reserves 347 MB
# of windows plus plane, so a preflight would be a gate that cannot fire.
RESIDENT_LEG=1
resident_na=""
if [ "${ALIGN_LLM_MOE_RESIDENT_DENSE:-1}" = "0" ]; then
  RESIDENT_LEG=0
  resident_na="ALIGN_LLM_MOE_RESIDENT_DENSE=0"
fi

model_bytes=$(wc -c < "${ALIGN_LLM_GGUF_MODEL}" | tr -d ' ')
scratch_root="${ALIGN_LLM_MOE_DECODE_STEP_TMPDIR:-${TMPDIR:-/tmp}}"
[ -d "${scratch_root}" ] || na "the scratch root ${scratch_root} does not exist"
free_kib=$(df -Pk "${scratch_root}" | awk 'NR == 2 { print $4 }')
need_kib=$(( model_bytes / 1024 + 2097152 ))
if [ "${free_kib}" -lt "${need_kib}" ]; then
  na "free space under ${scratch_root} is ${free_kib} KiB, below the ${need_kib} KiB the pack needs"
fi

work_dir=$(mktemp -d "${scratch_root%/}/align-r6m-XXXXXX")
shim_built=0
cleanup() {
  status=$?
  if [ "${shim_built}" = 1 ]; then
    ALIGN_LLM_GGML_FORCE= "${root_dir}/scripts/build-ggml-shim" >/dev/null 2>&1 || true
  fi
  rm -rf "${work_dir}"
  exit "${status}"
}
trap cleanup EXIT HUP INT TERM

echo "moe decode step qualification: reading the geometry of ${ALIGN_LLM_GGUF_MODEL}"
"${root_dir}/main" --model-ir "${ALIGN_LLM_GGUF_MODEL}" "${work_dir}/geometry.json" >/dev/null
arch=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["model"]["arch"])' \
  "${work_dir}/geometry.json")
[ "${arch}" = "olmoe" ] || na "ALIGN_LLM_GGUF_MODEL is not an olmoe model"

# ---------------------------------------------------------------------------------------------
# Cell G-P1 (section 5.7). Gate G's load-bearing measurement, taken **once** and before any arm
# runs: the collision classes of this model's printed `token_embd.weight` fingerprints. The gate is
# then claimed over a vocabulary whose injectivity was measured in this run, and a decoded id inside
# a colliding class is refused per step rather than silently gated on an ambiguous fingerprint.
# ---------------------------------------------------------------------------------------------
echo "moe decode step qualification: cell G-P1 -- measuring token_embd.weight's fingerprints"
python3 "${root_dir}/scripts/decode_step_fingerprint.py" "${ALIGN_LLM_GGUF_MODEL}" \
  "${work_dir}/fingerprints.json"

echo "moe decode step qualification: packing ${ALIGN_LLM_GGUF_MODEL} into ${work_dir}"
"${root_dir}/main" --pack "${ALIGN_LLM_GGUF_MODEL}" "${work_dir}/model.alignpack" \
  "${work_dir}/pack.json" >/dev/null

shim_dir=$(ALIGN_LLM_GGML_FORCE= "${root_dir}/scripts/build-ggml-shim")
shim_built=1
(
  cd "${root_dir}"
  LIBRARY_PATH="${shim_dir}${LIBRARY_PATH:+:${LIBRARY_PATH}}" \
  DYLD_LIBRARY_PATH="${shim_dir}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}" \
  LD_LIBRARY_PATH="${shim_dir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
  "${compiler}" build src/ggml_spike.align >/dev/null
  mv -f ggml_spike ggml-spike
)
# `ALIGN_LLM_GGML_LIB` joins the loader path, not only the link path. Section 15's recommended
# configuration points it at the **instrument's own** ggml, which is a build directory and is on no
# default loader path, and the shim records that ggml's install names verbatim — `@rpath/libggml.0.dylib`
# with no `LC_RPATH`, on this platform. Without this the arm aborts in `dyld` before its first
# instruction, which is a configuration failure reported as a crash.
export DYLD_LIBRARY_PATH="${shim_dir}:${ALIGN_LLM_GGML_LIB}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}"
export LD_LIBRARY_PATH="${shim_dir}:${ALIGN_LLM_GGML_LIB}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

# The per-prompt cross-check below compares the **two instruments** against each other. It says
# nothing about whether the arm's ggml is either instrument's, and that is a real gap: the arm links
# whatever `ALIGN_LLM_GGML_LIB` names and each instrument links whatever it was built against.
#
# ggml publishes no build identifier this runner can read, so the strongest cheap statement is
# **object identity of the shared library both sides load**, resolved through every symlink.
#
#   * against `llama-debug` this is a **hard** check. Gate G1 is a byte comparison against that
#     binary's `--save-logits` blob, so the arm and it must be the same arithmetic, and a
#     disagreement is a named refusal rather than a failing oracle.
#   * against `llama-eval-callback` it is **reported and never enforced**. Section 13 deviation 4:
#     the R2C instrument is a source build with `GGML_BLAS`/`GGML_ACCELERATE` on and it links its
#     ggml statically, so this check cannot resolve one and would refuse a configuration the design
#     accepted. Oracle T's tolerance is what covers that pair, and section 15 records the fix.
#
# Where the loader listing cannot be read at all the check **fails open** and says so on one line,
# because an unverifiable property reported as verified is worse than an unverified one that is named.
ggml_identity() {
  local binary="$1" resolved="" lister=""
  resolved=$(command -v "${binary}" 2>/dev/null || printf '%s' "${binary}")
  if command -v otool >/dev/null 2>&1; then
    lister="otool -L"
  elif command -v ldd >/dev/null 2>&1; then
    lister="ldd"
  else
    return 0
  fi
  # `pipefail` is on and `grep` exits 1 on no match, which is the **normal** outcome for a
  # statically linked instrument. The `|| true` keeps "no dynamic libggml" an answer rather than an
  # abort; an empty result is what the caller reads as unresolved.
  local found=""
  found=$(${lister} "${resolved}" 2>/dev/null \
    | grep -oE '(@[a-z_]+/|/[^ ]*)?libggml-base[^ ]*\.(so|dylib)[^ ]*' | head -1 || true)
  # A build directory's binaries name their libraries through `@rpath`/`@loader_path`, which is not
  # a filesystem path. Both resolve to the binary's own directory for a tree laid out the way every
  # llama.cpp build lays one out, and resolving them is what makes this check answer at all for the
  # configuration the qualification of record uses.
  case "${found}" in
    @rpath/*|@loader_path/*|@executable_path/*)
      found="$(dirname -- "${resolved}")/${found#*/}" ;;
  esac
  printf '%s' "${found}"
}

real_path() {
  python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$1"
}

arm_ggml=$(ls "${ALIGN_LLM_GGML_LIB}"/libggml-base.*dylib "${ALIGN_LLM_GGML_LIB}"/libggml-base.*so* \
  2>/dev/null | head -1 || true)
debug_ggml=$(ggml_identity "${ALIGN_LLM_LLAMA_DEBUG}")
if [ -n "${arm_ggml}" ] && [ -n "${debug_ggml}" ] && [ -e "${debug_ggml}" ]; then
  arm_real=$(real_path "${arm_ggml}")
  debug_real=$(real_path "${debug_ggml}")
  if [ "${arm_real}" = "${debug_real}" ]; then
    echo "moe decode step qualification: the arm and llama-debug load the same libggml-base" \
      "(${arm_real})"
  else
    echo "moe decode step qualification: FAIL the arm links ${arm_real} and llama-debug links" \
      "${debug_real}; gate G1 is a byte comparison and a ggml skew across it is exactly the class" \
      "no downstream oracle can see" >&2
    exit 1
  fi
else
  echo "moe decode step qualification: the arm's ggml could NOT be checked against llama-debug's" \
    "(arm '${arm_ggml:-unresolved}', llama-debug '${debug_ggml:-unresolved}'); this check FAILS" \
    "OPEN and gate G1's byte identity is the only thing standing behind that pair"
fi
callback_ggml=$(ggml_identity "${ALIGN_LLM_LLAMA_EVAL_CALLBACK}")
echo "moe decode step qualification: llama-eval-callback links libggml-base" \
  "'${callback_ggml:-statically, or not resolvable}' -- reported, never enforced (deviation 4)"

KV_WIDTH=256

# ---------------------------------------------------------------------------------------------
# R6-MOE-RESIDENT-DENSE section 5.6's two ported helpers. `scripts/run-moe-decode-step` has neither
# today; both are `scripts/run-decode-step`'s, unchanged.
# ---------------------------------------------------------------------------------------------

# `vm_stat` on Darwin, `/proc/vmstat` on Linux: the compressor counters section 3.7 measurement risk
# 3 requires to be recorded before and after every timed run. At a 574 MB peak this arm is far below
# the pressure the dense arm measured, but the risk is not zero and it is not assumed away — and
# **nothing is discarded or retaken** on the strength of it, because a mitigation that silently drops
# the runs it dislikes is a filter on the measurement.
compressor_state() {
  if [ -r /proc/vmstat ]; then
    awk '/^(pswpin|pswpout|nr_zswpout)/ { printf "%s=%s ", $1, $2 }' /proc/vmstat
  elif command -v vm_stat >/dev/null 2>&1; then
    vm_stat | awk -F: '/Pages stored in compressor|Pages occupied by compressor|Swapouts/ {
      gsub(/^ +| +$|\./, "", $2); gsub(/ /, "_", $1); printf "%s=%s ", $1, $2 }'
  else
    printf 'unavailable'
  fi
  printf '\n'
}

# Process start to exit around one whole invocation. It is a **diagnostic** beside
# `timings.elapsed_ns`, which is the arm's own interval and is what the claim of section 3.7 is made
# on; no rate, speedup, or per-token figure is derived from either.
time_invocation() {
  destination="$1"
  shift
  python3 -c '
import subprocess
import sys
import time

destination = sys.argv[1]
started = time.monotonic_ns()
result = subprocess.run(sys.argv[2:], capture_output=True)
elapsed = time.monotonic_ns() - started
with open(destination, "a", encoding="utf-8") as handle:
    handle.write("%d\n" % elapsed)
sys.exit(result.returncode)
' "${destination}" "$@"
}

# Four prompts, each at most six tokens. The first is R5E's own; the other three were chosen here and
# their ids were **measured once and recorded**, which is what the design asked for — an expected id
# list the assertion can be made against rather than one this runner invents. Six is the cap the
# **oracle** imposes on a prefill that is compared (`R5_ORACLE_TRUNCATED`), and this arm's prefill is
# not compared — but oracle C′ re-runs it through `--moe-model-forward`, so keeping every prompt at
# or below six keeps that arm's own transcript refusal irrelevant to this qualification.
#
# The expected id list is asserted **before** the arm runs. A tokenizer change is then a named
# failure rather than a silent refusal or, worse, a run over a different sequence.
PROMPTS=(
  "def add(a, b|1545,823,9,66,13,270"
  "The capital of|510,5347,273"
  "import os|2948,7684"
  "return x +|2309,1269,559"
)
if [ "${prompt_limit}" -lt "${#PROMPTS[@]}" ]; then
  PROMPTS=("${PROMPTS[@]:0:${prompt_limit}}")
fi

# Section 4.1's flag set, contractual and not an invocation detail: build 10566 defaults to
# `-fa auto`, an f16 KV cache, and repacked quantized weights, and none of those three is the graph
# this arm computes. `--temp 0 -s 0` makes the sampler greedy and the run reproducible, which is
# what makes "the ids llama.cpp itself produces" a fact rather than a sample.
capture() {
  local prompt="$1" tag="$2"
  "${ALIGN_LLM_LLAMA_EVAL_CALLBACK}" -m "${ALIGN_LLM_GGUF_MODEL}" -p "${prompt}" \
    -n "${steps}" -t 4 -ngl 0 -fa off -ctk f32 -ctv f32 -nr -c 512 --temp 0 -s 0 \
    > "${work_dir}/${tag}-transcript.txt" 2> "${work_dir}/${tag}-transcript.log"
  "${ALIGN_LLM_LLAMA_DEBUG}" -m "${ALIGN_LLM_GGUF_MODEL}" -p "${prompt}" \
    -n 1 -t 4 -ngl 0 -fa off -ctk f32 -ctv f32 -nr -c 512 --temp 0 -s 0 \
    --save-logits --logits-output-dir "${work_dir}/${tag}-lg" \
    > "${work_dir}/${tag}-debug.log" 2>&1
}

rows_json="${work_dir}/rows.jsonl"
: > "${rows_json}"

index=0
for entry in "${PROMPTS[@]}"; do
  index=$(( index + 1 ))
  prompt="${entry%%|*}"
  expected_ids="${entry##*|}"
  tag="p${index}"
  echo "moe decode step qualification: prompt ${index}/${#PROMPTS[@]} -- capturing both instruments" \
    "at -n ${steps}"
  capture "${prompt}" "${tag}"

  logits_bin=$(ls "${work_dir}/${tag}-lg"/*.bin 2>/dev/null | grep -v -- '-tokens\.bin$' | head -1 \
    || true)
  tokens_bin=$(ls "${work_dir}/${tag}-lg"/*-tokens.bin 2>/dev/null | head -1 || true)
  if [ -z "${logits_bin}" ] || [ -z "${tokens_bin}" ]; then
    echo "moe decode step qualification: FAIL llama-debug exited 0 and wrote no logits or tokens" \
      "file for prompt ${index}" >&2
    tail -20 "${work_dir}/${tag}-debug.log" >&2 || true
    exit 1
  fi

  tokens=$(python3 - "${work_dir}/${tag}-transcript.log" <<'IDS'
import re
import sys

with open(sys.argv[1], "r", encoding="utf-8", errors="replace") as handle:
    lines = handle.read().split("\n")
at = next(i for i, line in enumerate(lines) if "number of input tokens" in line)
count = int(re.search(r"number of input tokens = (\d+)", lines[at]).group(1))
print(",".join(line.split()[-1] for line in lines[at + 1:at + 1 + count]))
IDS
)
  if [ "${tokens}" != "${expected_ids}" ]; then
    echo "moe decode step qualification: FAIL the tokenizer produced ${tokens} for" \
      "'${prompt}', not the recorded ${expected_ids}" >&2
    exit 1
  fi

  # Rule 9 of section 4.6, checked **before** the arm runs: the transcript must hold exactly
  # `N + 1` graphs. Fewer means llama.cpp stopped early (EOS) and the prompt is refused rather than
  # compared over a shorter run — the runner's graph count is this capability's EOS detector.
  graphs=$(grep -c 'common_debug_cb_eval:.* embd = ' "${work_dir}/${tag}-transcript.txt" || true)
  if [ "${graphs}" != "$(( steps + 1 ))" ]; then
    echo "moe decode step qualification: FAIL prompt ${index} produced ${graphs} graphs, not" \
      "$(( steps + 1 )); llama.cpp stopped early and this prompt cannot be compared at N=${steps}" >&2
    exit 1
  fi

  python3 - "${work_dir}/${tag}-transcript.txt" "${logits_bin}" "${tokens_bin}" "${tokens}" <<'PY'
import struct
import sys

transcript, logits_path, tokens_path, expected = sys.argv[1:5]
with open(logits_path, "rb") as handle:
    raw = handle.read()
values = struct.unpack("<%df" % (len(raw) // 4), raw)
total = 0.0
for value in values:
    total = struct.unpack("<f", struct.pack("<f", total + value))[0]
printed = None
seen = False
with open(transcript, "r", encoding="utf-8", errors="replace") as handle:
    for line in handle:
        if line.startswith("common_debug_cb_eval:") and " result_output = " in line:
            seen = True
            continue
        if seen and line.strip().startswith("sum ="):
            printed = float(line.strip().split("=")[1])
            break
failures = []
if printed is None:
    failures.append("the transcript prints no sum for result_output")
elif abs(printed - total) > 1e-3 * max(1.0, abs(printed)):
    failures.append("the two instruments disagree: transcript %r, logits %r" % (printed, total))
with open(tokens_path, "rb") as handle:
    token_raw = handle.read()
ids = ",".join(str(v) for v in struct.unpack("<%di" % (len(token_raw) // 4), token_raw))
if ids != expected:
    failures.append("llama-debug tokenized %r, the transcript %r" % (ids, expected))
if failures:
    for line in failures:
        sys.stderr.write("moe decode step qualification: FAIL %s\n" % line)
    raise SystemExit(1)
print("moe decode step qualification: the two instruments agree (result_output sum %.6f)" % total)
PY

  # Three consecutive runs, and the acceptance rule's determinism clause: the three documents must
  # be identical after `normalize`, which zeroes every `*_ns` field and nothing else. `routed`,
  # `residency`, and every byte and ppm figure stay inside the comparison, because they are the
  # claim.
  for repeat in 1 2 3; do
    echo "moe decode step qualification: prompt ${index} run ${repeat}/3 -- N=${steps}," \
      "KV_WIDTH=${KV_WIDTH}"
    /usr/bin/time -p "${root_dir}/ggml-spike" --moe-decode-step \
      "${work_dir}/model.alignpack" "${work_dir}/geometry.json" "${tokens}" \
      "${work_dir}/${tag}-run${repeat}.json" "${ALIGN_LLM_GGUF_MODEL}" \
      "${work_dir}/${tag}-transcript.txt" "${KV_WIDTH}" "${logits_bin}" "${steps}" \
      > "${work_dir}/${tag}-run${repeat}.out" 2> "${work_dir}/${tag}-run${repeat}.time" || {
        status=$?
        cat "${work_dir}/${tag}-run${repeat}.time" >&2 || true
        python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));
print("error_code", d["error_code"], "detail", d["error_detail"])' \
          "${work_dir}/${tag}-run${repeat}.json" >&2 || true
        exit "${status}"
      }
    grep -E '^real' "${work_dir}/${tag}-run${repeat}.time" \
      | sed "s/^/moe decode step qualification: prompt ${index} run ${repeat} /" || true
  done

  # R6-MOE-RESIDENT-DENSE. The `dense` leg: the **same** invocation plus the two reserved `-` KV
  # placeholders and `RESIDENT=dense`, so the two legs differ in exactly one operand and oracle D
  # below compares documents that differ in nothing else. Three runs, because the acceptance rule's
  # determinism clause applies to this leg too.
  if [ "${RESIDENT_LEG}" = 1 ]; then
    for repeat in 1 2 3; do
      echo "moe decode step qualification: prompt ${index} dense run ${repeat}/3 -- N=${steps}," \
        "KV_WIDTH=${KV_WIDTH}, RESIDENT=dense"
      /usr/bin/time -p "${root_dir}/ggml-spike" --moe-decode-step \
        "${work_dir}/model.alignpack" "${work_dir}/geometry.json" "${tokens}" \
        "${work_dir}/${tag}-dense${repeat}.json" "${ALIGN_LLM_GGUF_MODEL}" \
        "${work_dir}/${tag}-transcript.txt" "${KV_WIDTH}" "${logits_bin}" "${steps}" \
        "-" "-" "dense" \
        > "${work_dir}/${tag}-dense${repeat}.out" \
        2> "${work_dir}/${tag}-dense${repeat}.time" || {
          status=$?
          cat "${work_dir}/${tag}-dense${repeat}.time" >&2 || true
          python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));
print("error_code", d["error_code"], "detail", d["error_detail"])' \
            "${work_dir}/${tag}-dense${repeat}.json" >&2 || true
          exit "${status}"
        }
      grep -E '^real' "${work_dir}/${tag}-dense${repeat}.time" \
        | sed "s/^/moe decode step qualification: prompt ${index} dense run ${repeat} /" || true
    done
  fi

  # Oracle C′ (section 4.4), at `k in {1, ceil(N/2), N}`: a whole `--moe-model-forward` prefill at
  # `TOKENS,d_1..d_k` and the same `KV_WIDTH`, whose logits digest must reproduce `steps[k].sha256`.
  # It is a **five-operand** invocation with no reference and no transcript: the source comparison
  # and the transcript oracle are the decode run's, and repeating them here would add a gigabyte of
  # GGUF reads per checkpoint for no new proposition.
  half=$(( (steps + 1) / 2 ))
  checkpoints="1 ${half} ${steps}"
  for k in ${checkpoints}; do
    prefix=$(python3 - "${work_dir}/${tag}-run1.json" "${k}" "${tokens}" <<'PY'
import json
import sys

document = json.load(open(sys.argv[1]))
k = int(sys.argv[2])
ids = document["decode"]["token_ids"][:k]
print(sys.argv[3] + "," + ",".join(str(i) for i in ids))
PY
)
    "${root_dir}/ggml-spike" --moe-model-forward "${work_dir}/model.alignpack" \
      "${work_dir}/geometry.json" "${prefix}" "${KV_WIDTH}" \
      "${work_dir}/${tag}-self-${k}.json" >/dev/null
  done

  python3 - "${work_dir}" "${tag}" "${index}" "${steps}" "${tokens}" "${KV_WIDTH}" \
      "${checkpoints}" "${rows_json}" "${RESIDENT_LEG}" "${work_dir}/pack.json" <<'PY'
import json
import os
import struct
import sys

work_dir, tag, index, steps, tokens, width, checkpoints, rows_json = sys.argv[1:9]
resident_leg = sys.argv[9] == "1"
pack_document_path = sys.argv[10]
steps = int(steps)
width = int(width)
prompt_index = int(index)
failures = []


def load(name):
    with open(os.path.join(work_dir, name), "r", encoding="utf-8") as handle:
        return json.load(handle)


def normalize(document):
    def scrub(node):
        if isinstance(node, dict):
            for key in node:
                if key.endswith("_ns") and isinstance(node[key], int):
                    node[key] = 0
                else:
                    scrub(node[key])
        elif isinstance(node, list):
            for item in node:
                scrub(item)
    scrub(document)
    return json.dumps(document, separators=(",", ":"), sort_keys=True)


documents = [load("%s-run%d.json" % (tag, r)) for r in (1, 2, 3)]
d = documents[0]
shapes = {normalize(json.loads(json.dumps(one))) for one in documents}
if len(shapes) != 1:
    failures.append("the three runs are not identical after normalize")


def want(label, got, expected):
    if got != expected:
        failures.append("%s: %r, expected %r" % (label, got, expected))


want("status", d["status"], "ok")
want("verdict", d["verdict"], "EXTERNAL")
want("kind", d["kind"], "R6_MOE_DECODE_STEP")
want("schema_version", d["schema_version"], 2)

model = d["model"]
want("model.arch", model["arch"], "olmoe")
want("model.n_layer", model["n_layer"], 16)
want("model.n_expert", model["n_expert"], 64)
want("model.n_expert_used", model["n_expert_used"], 8)
# Section 2.2: a decode graph does not narrow, so both fields publish -1 rather than being omitted.
want("selection.narrow_layer", d["selection"]["narrow_layer"], -1)
want("selection.narrow_index", d["selection"]["narrow_index"], -1)
want("selection.attention_width", d["selection"]["attention_width"], width)

# --- Rule 1, gate G ---------------------------------------------------------------------------
decode = d["decode"]
want("decode.steps_requested", decode["steps_requested"], steps)
want("decode.steps_completed", decode["steps_completed"], steps)
want("decode.token_ids length", len(decode["token_ids"]), steps)
want("oracle_logits.verdict (gate G1)", d["oracle_logits"]["verdict"], "IDENTICAL")
if not d["oracle_logits"]["byte_identical"]:
    failures.append("gate G1: the prefill's logits are not byte-identical to llama-debug's")

with open(os.path.join(work_dir, "fingerprints.json"), "r", encoding="utf-8") as handle:
    fingerprints = json.load(handle)
colliding = set(fingerprints["colliding_ids"])
non_degenerate = set(fingerprints["colliding_ids_that_are_not_all_zero"])
hit = [i for i in decode["token_ids"] if i in colliding]
if hit:
    failures.append("gate G2: prompt %s decoded %r, which are members of a measured collision "
                    "class; the gate does not hold over them and section 4.2's G3 is the declared "
                    "response" % (index, hit))

# --- Rule 2, oracle R -------------------------------------------------------------------------
routing = d["routing_oracle"]
want("routing_oracle.verdict", routing["verdict"], "MATCH")
want("routing_oracle.steps_compared", routing["steps_compared"], steps)
want("routing_oracle.layers_matched", routing["layers_matched"], 16 * steps)
want("routing_oracle.ids_total", routing["ids_total"], 128 * steps)
want("routing_oracle.ids_printed_compared", routing["ids_printed_compared"], 128 * steps)
want("routing_oracle.ids_printed_matched", routing["ids_printed_matched"], 128 * steps)

# --- Rule 3, oracle B -------------------------------------------------------------------------
plane = d["plane"]
want("plane.roundtrip_verdict", plane["roundtrip_verdict"], "IDENTICAL")
want("plane.source", plane["source"], "PREFILL")
token_count = len(tokens.split(","))
want("plane.bytes", plane["bytes"], 16 * 2 * width * 16 * 128 * 4)
want("plane.columns_written", plane["columns_written"], token_count + steps)
expected_roundtrip = sum(2 * 16 * (token_count + k) * 16 * 128 * 4 for k in range(1, steps + 1))
want("plane.roundtrip_bytes_compared", plane["roundtrip_bytes_compared"], expected_roundtrip)

# --- Rule 5 and 6, oracle T -------------------------------------------------------------------
oracle = d["oracle_decode"]
want("oracle_decode.steps_compared", oracle["steps_compared"], steps)
want("oracle_decode.instrument_graph_first", oracle["instrument_graph_first"], 2)
want("oracle_decode.instrument_graph_last", oracle["instrument_graph_last"], steps + 1)
want("oracle_decode.instrument_kv_width", oracle["instrument_kv_width"], width)
want("oracle_decode.layers_matched", oracle["layers_matched"], 16 * steps)
want("oracle_decode.tolerance_ten_thousandths", oracle["tolerance_ten_thousandths"], 1)
if oracle["elements_compared"] <= 0:
    failures.append("oracle T compared nothing and still reported %r" % oracle["verdict"])
for row in d["steps"]:
    if row["oracle"]["instrument_graph"] != row["index"] + 1:
        failures.append("step %d was compared against graph %d"
                        % (row["index"], row["oracle"]["instrument_graph"]))
    if row["oracle"]["nodes_matched"] != 227:
        failures.append("step %d matched %d comparable nodes, not 227"
                        % (row["index"], row["oracle"]["nodes_matched"]))
    if row["oracle"]["layers_matched"] != 16:
        failures.append("step %d compared %d layers, not 16"
                        % (row["index"], row["oracle"]["layers_matched"]))
    if row["oracle"]["elements_compared"] <= 0:
        failures.append("step %d compared no elements" % row["index"])
# Rule 6: oracle T is numerically admitted at step 1 only; steps 2..N are characterization and their
# maxima are reported rather than gated.
step_one = d["steps"][0]["oracle"]
if step_one["verdict"] != "PASS" and step_one["max_abs_diff_ten_thousandths"] > 5000:
    failures.append("oracle T at step 1: %r with max_abs %d, outside R6's admission rule"
                    % (step_one["verdict"], step_one["max_abs_diff_ten_thousandths"]))

# --- Rule 7, the claim accounting -------------------------------------------------------------
block_align = d["pack"]["block_align"]
for row in d["steps"]:
    residency = row["residency"]
    routed = row["routed"]
    if residency["expert_bytes"] != 487587840:
        failures.append("step %d claims %d expert bytes, not the 487,587,840 section 2.3 derives"
                        % (row["index"], residency["expert_bytes"]))
    if residency["expert_bytes_ppm"] != 125000:
        failures.append("step %d is %d ppm, not the exact 125,000"
                        % (row["index"], residency["expert_bytes_ppm"]))
    if routed["keys_demanded"] != 128:
        failures.append("step %d demanded %d keys, not 16 layers x 8"
                        % (row["index"], routed["keys_demanded"]))
    if residency["claim_planes_read"] != 384:
        failures.append("step %d read %d claim planes, not 128 x 3"
                        % (row["index"], residency["claim_planes_read"]))
    if len(routed["layers"]) != 16 or any(len(x) != 8 for x in routed["layers"]):
        failures.append("step %d routed %r" % (row["index"], [len(x) for x in routed["layers"]]))
    if residency["expert_pread_bytes"] < residency["expert_bytes"]:
        failures.append("step %d read %d bytes for a %d-byte claim"
                        % (row["index"], residency["expert_pread_bytes"],
                           residency["expert_bytes"]))
    ceiling = residency["expert_bytes"] + residency["claim_planes_read"] * block_align
    if residency["expert_pread_bytes"] > ceiling:
        failures.append("step %d read %d bytes, above the %d the chunk granularity allows"
                        % (row["index"], residency["expert_pread_bytes"], ceiling))

# --- R6-MOE-RESIDENT-DENSE: the region, oracle D, the primary metric, the expert invariant ------
#
# Everything in this section is computed from the **pack document's own member table** and from the
# two legs' documents. Nothing reads the arm's `weights.resident_bytes` to decide what to expect,
# which is section 7 risk 4's fixture co-derivation class stated as a rule.
resident_rows = {}
if resident_leg:
    with open(pack_document_path, "r", encoding="utf-8") as handle:
        pack_document = json.load(handle)

    block_align = pack_document["format"]["block_align"]
    MAX_TENSOR_ALIGNMENT = 64
    MAX_PREFILL_TOKENS = 32
    step_align = max(block_align, MAX_TENSOR_ALIGNMENT)

    def align_up(value, alignment):
        remainder = value % alignment
        return value if remainder == 0 else value + (alignment - remainder)

    # An independent walk of the 147 dense member records: every member of every block whose `kind`
    # is not `ExpertBlock`, laid out by section 2.2's rule --
    # `[token_embd table][embed stage][layer 0 .. n-1][head]`, `align_up`-ing each region to
    # `max(block_align, MAX_TENSOR_ALIGNMENT)`.
    dense_blocks = [b for b in pack_document["blocks"] if b["kind"] != "ExpertBlock"]
    dense_members = [m for b in dense_blocks for m in b["members"]]
    dense_member_bytes = sum(m["nbytes"] for m in dense_members)
    embed_member = next(m for m in dense_members if m["role"] == "token_embd")
    row_bytes = embed_member["nbytes"] // embed_member["dims"][1]
    table_bytes = align_up(embed_member["nbytes"], step_align)
    stage_bytes = align_up(row_bytes * MAX_PREFILL_TOKENS, step_align)
    n_layer = d["model"]["n_layer"]
    layer_bytes = []
    for layer in range(n_layer):
        window = 0
        for block in dense_blocks:
            if block["layer"] != layer:
                continue
            for member in block["members"]:
                window += align_up(member["nbytes"], block_align)
        layer_bytes.append(align_up(window, step_align))
    head_block = next(b for b in dense_blocks
                      if b["layer"] < 0 and not any(m["role"] == "token_embd"
                                                    for m in b["members"]))
    head_window = sum(align_up(m["nbytes"], block_align) for m in head_block["members"])
    head_bytes = align_up(head_window, step_align)
    expected_region = table_bytes + stage_bytes + sum(layer_bytes) + head_bytes
    expected_fill = dense_member_bytes

    dense_documents = [load("%s-dense%d.json" % (tag, r)) for r in (1, 2, 3)]
    dense_shapes = {normalize(json.loads(json.dumps(one))) for one in dense_documents}
    if len(dense_shapes) != 1:
        failures.append("the three dense runs are not identical after normalize")
    dense = dense_documents[0]
    if dense["status"] != "ok" or dense["error_code"] != "":
        failures.append("the dense leg failed with %r / %r"
                        % (dense["error_code"], dense["error_detail"]))

    weights = dense["weights"]
    streamed_weights = d["weights"]

    # Clause 10, the primary metric. A counter, not a clock, identical across runs.
    if weights["mode"] != "dense" or streamed_weights["mode"] != "stream":
        failures.append("the two legs report modes %r and %r"
                        % (streamed_weights["mode"], weights["mode"]))
    if weights["step_dense_pack_bytes"] != 0:
        failures.append("MRD primary: the dense leg read %d dense pack bytes in its decode steps"
                        % weights["step_dense_pack_bytes"])
    if streamed_weights["step_dense_pack_bytes"] <= 0:
        failures.append("MRD primary: the streamed leg read %d dense pack bytes, so the comparison "
                        "is vacuous" % streamed_weights["step_dense_pack_bytes"])
    # The streamed leg's own figure is arithmetic on the published per-step demand, so it is checked
    # against `steps[].residency.dense_bytes` rather than against a remembered constant.
    expected_streamed_dense = sum(row["residency"]["dense_bytes"] for row in d["steps"])
    if streamed_weights["step_dense_pack_bytes"] != expected_streamed_dense:
        failures.append("MRD primary: the streamed leg read %d dense pack bytes against a published "
                        "demand of %d" % (streamed_weights["step_dense_pack_bytes"],
                                          expected_streamed_dense))

    # Section 4.4, the co-primary invariant: the measurement this arm exists to publish must not
    # move. Every row, both legs, byte for byte.
    if weights["step_expert_pack_bytes"] != streamed_weights["step_expert_pack_bytes"]:
        failures.append("MRD invariant: step_expert_pack_bytes %d in the dense leg against %d "
                        "streamed" % (weights["step_expert_pack_bytes"],
                                      streamed_weights["step_expert_pack_bytes"]))
    if weights["step_pack_bytes"] != weights["step_expert_pack_bytes"]:
        failures.append("MRD: step_pack_bytes %d is not the expert term alone in dense mode"
                        % weights["step_pack_bytes"])
    for leg_name, leg in (("stream", d), ("dense", dense)):
        for row in leg["steps"]:
            residency = row["residency"]
            if residency["expert_bytes"] != 487587840 \
                    or residency["expert_pread_bytes"] != 487587840 \
                    or residency["expert_read_amplification_ppm"] != 0 \
                    or residency["expert_bytes_ppm"] != 125000 \
                    or residency["claim_planes_read"] != 384 \
                    or row["routed"]["keys_demanded"] != 128:
                failures.append("MRD invariant: %s leg step %d moved the expert measurement: %r"
                                % (leg_name, row["index"], residency))
            if residency["dense_bytes"] != 253078656 or residency["total_bytes"] != 740666496:
                failures.append("MRD invariant: %s leg step %d changed an arithmetic field: "
                                "dense_bytes %d, total_bytes %d"
                                % (leg_name, row["index"], residency["dense_bytes"],
                                   residency["total_bytes"]))

    # Section 2.2, reproduced independently and asserted against the published figure.
    if weights["resident_bytes"] != expected_region:
        failures.append("MRD region: the arm published %d B and an independent walk of the pack "
                        "document's %d dense member records computes %d B"
                        % (weights["resident_bytes"], len(dense_members), expected_region))
    if weights["fill_bytes"] != expected_fill:
        failures.append("MRD fill: the arm read %d B and the dense member sum is %d B"
                        % (weights["fill_bytes"], expected_fill))
    if weights["fill_pread_count"] <= 0:
        failures.append("MRD fill: the region reported no pread")
    # Section 3.4's wrap table: one run-scope wrap for the whole run against one per weight-region
    # graph streamed.
    if weights["wrap_count"] != 1 or weights["resident_wraps_created"] != 1 \
            or weights["resident_wraps_freed"] != 1:
        failures.append("MRD wrap: the run-scope wrap did not balance: %r" % (weights,))
    if streamed_weights["wrap_count"] <= 1:
        failures.append("MRD wrap: the streamed leg wrapped its dense window %d times, so the "
                        "hoist proves nothing" % streamed_weights["wrap_count"])
    # Clause 7, oracle P, on the dense leg: every dense placement is against the region.
    if dense["window"]["pointer_identity_failures"] != 0 \
            or dense["window"]["member_placements"] <= 0 \
            or dense["window"]["claim_placements"] <= 0:
        failures.append("MRD oracle P: %d failures over %d member and %d claim placements"
                        % (dense["window"]["pointer_identity_failures"],
                           dense["window"]["member_placements"],
                           dense["window"]["claim_placements"]))
    # Clause 8, oracle B at run scope, on both legs.
    for leg_name, leg in (("stream", d), ("dense", dense)):
        lifetime = leg["lifetime"]
        if lifetime["graph_balance_failures"] != 0 \
                or not lifetime["released_before_owner_scope_end"]:
            failures.append("MRD oracle B: the %s leg's teardown did not balance: %r"
                            % (leg_name, lifetime))

    # --- Oracle D (section 4.1). The two legs' whole normalized documents, byte-identical outside
    # the `weights` object and exactly ten enumerated field names. Everything else is compared,
    # including the entire `residency` object -- which is the point, because
    # `residency.expert_bytes_read` is the number section 4.4 exists to protect and it is **inside**
    # the compared set, not the excluded one.
    RESIDENT_EXCLUDED_BLOCKS = ("weights",)
    RESIDENT_EXCLUDED_FIELDS = (
        ("pack", "reader_pread_count"), ("pack", "reader_bytes_read"),
        ("lifetime", "ggml_buffers_created"), ("lifetime", "ggml_buffers_freed"),
        ("window", "dense_bytes"), ("window", "dense_peak_block_index"),
        ("window", "dense_peak_block_kind"), ("window", "dense_peak_block_layer"),
        ("window", "dense_peak_block_bytes"), ("window", "reuse_count"),
    )

    def normalize_resident(document):
        document = json.loads(normalize(json.loads(json.dumps(document))))
        for block in RESIDENT_EXCLUDED_BLOCKS:
            document.pop(block, None)
        for block, field in RESIDENT_EXCLUDED_FIELDS:
            document[block].pop(field, None)
        return json.dumps(document, separators=(",", ":"), sort_keys=True)

    left = normalize_resident(d)
    right = normalize_resident(dense)
    if left != right:
        # The whole documents are 8 KB each; print the first divergence rather than both.
        left_doc = json.loads(left)
        right_doc = json.loads(right)
        notes = []

        def walk(a, b, at):
            if len(notes) >= 6:
                return
            if type(a) is not type(b):
                notes.append("%s: %r != %r" % (at or ".", a, b))
            elif isinstance(a, dict):
                for key in sorted(set(a) | set(b)):
                    if key not in a:
                        notes.append("%s.%s: absent != %r" % (at, key, b[key]))
                    elif key not in b:
                        notes.append("%s.%s: %r != absent" % (at, key, a[key]))
                    else:
                        walk(a[key], b[key], "%s.%s" % (at, key))
            elif isinstance(a, list):
                if len(a) != len(b):
                    notes.append("%s: %d entries != %d" % (at, len(a), len(b)))
                else:
                    for i in range(len(a)):
                        walk(a[i], b[i], "%s[%d]" % (at, i))
            elif a != b:
                notes.append("%s: %r != %r" % (at or ".", a, b))

        walk(left_doc, right_doc, "")
        failures.append("MRD oracle D: the two legs diverge at " + "; ".join(notes))

    resident_rows = {
        "resident_bytes": weights["resident_bytes"],
        "expected_region": expected_region,
        "dense_member_count": len(dense_members),
        "dense_member_bytes": dense_member_bytes,
        "table_bytes": table_bytes,
        "stage_bytes": stage_bytes,
        "layer_bytes": layer_bytes,
        "head_bytes": head_bytes,
        "fill_bytes": weights["fill_bytes"],
        "fill_pread_count": weights["fill_pread_count"],
        "fill_ns": dense_documents[0]["weights"]["fill_ns"],
        "stream_step_dense_pack_bytes": streamed_weights["step_dense_pack_bytes"],
        "dense_step_dense_pack_bytes": weights["step_dense_pack_bytes"],
        "stream_step_expert_pack_bytes": streamed_weights["step_expert_pack_bytes"],
        "dense_step_expert_pack_bytes": weights["step_expert_pack_bytes"],
        "stream_wrap_count": streamed_weights["wrap_count"],
        "dense_wrap_count": weights["wrap_count"],
        "oracle_d": "MATCH" if left == right else "DIVERGED",
        "dense_elapsed_ns": dense["timings"]["elapsed_ns"],
        "dense_claim_pread_ns": dense["timings"]["claim_pread_ns"],
        "stream_claim_pread_ns": d["timings"]["claim_pread_ns"],
        "dense_decode_expert_pread_bytes": dense["residency"]["decode_expert_pread_bytes"],
        "stream_decode_expert_pread_bytes": d["residency"]["decode_expert_pread_bytes"],
    }

# --- Oracle C', on the branch the measurement selects ------------------------------------------
self_rows = []
for k in [int(x) for x in checkpoints.split()]:
    reference = load("%s-self-%d.json" % (tag, k))
    step = d["steps"][k - 1]
    if reference["status"] != "ok":
        failures.append("oracle C' at k=%d: the self-reference prefill failed with %r"
                        % (k, reference["error_code"]))
        continue
    identical = reference["output"]["sha256"] == step["sha256"]
    same_argmax = reference["output"]["argmax"] == step["argmax"]
    # Section 4.4's fallback, as it was pre-committed and not as an argmax check alone: R5E's own
    # runtime-width rule — `LOGIT_TOLERANCE_TEN_THOUSANDTHS` of 5000, argmax equality, and top-ten
    # **set** equality — applied unchanged. Neither document publishes a whole logit vector, so the
    # bound is taken over the union of the two top-ten sets: those are the elements that decide the
    # token, and every one of them is published with the raw `u32` of its f32, so the comparison is
    # exact rather than a re-read of a printed decimal. Section 13 deviation 13 records that this is
    # a narrower denominator than R5E's whole-vocabulary sweep and why C′ is characterization here.
    reference_top = {entry["index"]: entry["bits"] for entry in reference["output"]["top_k"]}
    step_top = {entry["index"]: entry["bits"] for entry in step["top_k"]}
    same_top_set = set(reference_top) == set(step_top)
    compared_indices = sorted(set(reference_top) | set(step_top))
    max_abs = 0
    for vocab_id in compared_indices:
        pair = []
        for table in (reference_top, step_top):
            if vocab_id in table:
                pair.append(struct.unpack("<f", struct.pack("<I", table[vocab_id] & 0xFFFFFFFF))[0])
        if len(pair) == 2:
            max_abs = max(max_abs, abs(round(pair[0] * 10000) - round(pair[1] * 10000)))
    within = max_abs <= 5000 and same_argmax and same_top_set
    verdict = "IDENTICAL" if identical else ("WITHIN" if within else "FAIL")
    self_rows.append({"k": k, "identical": identical, "argmax": same_argmax,
                      "verdict": verdict, "top_k_set_equal": same_top_set,
                      "max_abs_diff_ten_thousandths": max_abs,
                      "compared_indices": len(compared_indices),
                      "prefill_sha": reference["output"]["sha256"],
                      "step_sha": step["sha256"],
                      "prefill_argmax": reference["output"]["argmax"],
                      "step_argmax": step["argmax"]})
    # Section 4.6 clause 4. On the branch cell C-P1 selected, section 4.4 puts the acceptance weight
    # "entirely on gate G, oracle R, and oracle B", so the verdict and all three of its quantities
    # are **reported** at every checkpoint and exactly one clause is acceptance: **argmax equality**.
    # A self-reference that disagreed about the token would mean the decode loop and the prefill
    # compute different models, which no tolerance excuses. The other two clauses are the bound this
    # document fixed in advance and they are what the verdict is computed from; section 12.4 records
    # what they measured, including where `WITHIN` does not hold.
    if not same_argmax:
        failures.append("oracle C' at k=%d: the prefill's argmax %r is not the step's %r "
                        "(verdict %s, top-ten set equal %r, max_abs %d ten-thousandths over %d "
                        "compared indices)"
                        % (k, reference["output"]["argmax"], step["argmax"], verdict,
                           same_top_set, max_abs, len(compared_indices)))

# --- The demand stream, which is the deliverable -----------------------------------------------
residency = d["residency"]
row = {
    "prompt": prompt_index,
    "tokens": tokens,
    "token_ids": decode["token_ids"],
    "steps": steps,
    "routing_matched": routing["ids_printed_matched"],
    "routing_total": routing["ids_total"],
    "step_expert_bytes": d["steps"][0]["residency"]["expert_bytes"],
    "step_expert_pread_bytes": [r["residency"]["expert_pread_bytes"] for r in d["steps"]],
    "amplification_ppm": [r["residency"]["expert_read_amplification_ppm"] for r in d["steps"]],
    "union_keys": [r["routed"]["union_keys_after"] for r in d["steps"]],
    "union_bytes": [r["routed"]["union_bytes_after"] for r in d["steps"]],
    "new_keys": [r["routed"]["new_keys"] for r in d["steps"]],
    "new_bytes": [r["routed"]["new_bytes"] for r in d["steps"]],
    "prefill_expert_bytes": residency["prefill_expert_bytes"],
    "decode_expert_bytes": residency["decode_expert_bytes"],
    "decode_expert_pread_bytes": residency["decode_expert_pread_bytes"],
    "union_keys_final": residency["union_keys_final"],
    "union_bytes_final": residency["union_bytes_final"],
    "decode_keys_demanded": residency["decode_keys_demanded"],
    "decode_keys_distinct": residency["decode_keys_distinct"],
    "decode_keys_in_prefill_union": residency["decode_keys_in_prefill_union"],
    "decode_distinct_keys_in_prefill_union":
        residency["decode_distinct_keys_in_prefill_union"],
    "step_reuse_per_mille": residency["step_reuse_per_mille"],
    "claim_decode_peak_use_bytes": d["window"]["claim_decode_peak_use_bytes"],
    "claim_bytes": d["window"]["claim_bytes"],
    "elapsed_ns": d["timings"]["elapsed_ns"],
    "compute_ns": d["timings"]["compute_ns"],
    "decode_compute_ns": d["timings"]["decode_compute_ns"],
    "pread_ns": d["timings"]["pread_ns"],
    "claim_pread_ns": d["timings"]["claim_pread_ns"],
    "first_token_ns": d["timings"]["first_token_ns"],
    "oracle_max_abs": oracle["max_abs_diff_ten_thousandths"],
    "step_oracle_max_abs": [r["oracle"]["max_abs_diff_ten_thousandths"] for r in d["steps"]],
    "self_reference": self_rows,
    "table_rows_a_decode": d["graph"]["table_rows_a_decode"],
    "slot_high_water": d["graph"]["slot_high_water"],
    "graph_count": d["decode"]["graph_count"],
    "fingerprint_collisions": len(non_degenerate),
    "resident": resident_rows,
}
with open(rows_json, "a", encoding="utf-8") as handle:
    handle.write(json.dumps(row, separators=(",", ":")) + "\n")

if failures:
    for line in failures:
        sys.stderr.write("moe decode step qualification: FAIL prompt %s %s\n" % (index, line))
    raise SystemExit(1)
mean_new = sum(row["new_bytes"]) / float(len(row["new_bytes"]))
print("moe decode step qualification: prompt %s PASS -- %d ids gated, routing %d/%d, oracle B %d "
      "bytes, union %d keys / %d bytes, marginal mean %.1f MB against a %.1f MB streamed step"
      % (index, len(decode["token_ids"]), routing["ids_printed_matched"], routing["ids_total"],
         plane["roundtrip_bytes_compared"], residency["union_keys_final"],
         residency["union_bytes_final"], mean_new / 1e6,
         d["steps"][0]["residency"]["expert_bytes"] / 1e6))
PY
done

# ---------------------------------------------------------------------------------------------
# R6-MOE-RESIDENT-DENSE section 3.7 -- the measurement
#
# **The baseline is re-taken here, in this session, on this host**, and the two legs are
# **interleaved**: `repeat` outside and `mode` inside. Taking one leg's repeats and then the other
# confounds the leg with the clock and puts the whole of any monotone drift on one side of the
# subtraction; that is `r6-resident-weights.md` section 3.4 measurement risk 4 and the blocked order
# is not offered as an option here. The conservative reading is the **worst** of the repeats, not the
# median, and section 6's verdict rule is applied to it.
#
# Every run is the same invocation the qualification of record used, plus the `dense` leg's one extra
# operand, so the reproduced baseline is comparable with the 3.63 s section 3.7 records.
# ---------------------------------------------------------------------------------------------
bench_rows="${work_dir}/bench.jsonl"
: > "${bench_rows}"
if [ "${RESIDENT_LEG}" = 1 ]; then
  echo ""
  echo "moe decode step qualification: MRD measurement -- interleaved (repeat outside, mode" \
    "inside), 3 repeats, N in {1,4,16}, one session"
  echo "moe decode step qualification: MRD compressor before: $(compressor_state)"
  for repeat in 1 2 3; do
    echo "moe decode step qualification: MRD compressor before repeat ${repeat}:" \
      "$(compressor_state)"
    for mode in stream dense; do
      bench_index=0
      for entry in "${PROMPTS[@]}"; do
        bench_index=$(( bench_index + 1 ))
        bench_tag="p${bench_index}"
        bench_tokens="${entry##*|}"
        bench_logits=$(ls "${work_dir}/${bench_tag}-lg"/*.bin 2>/dev/null \
          | grep -v -- '-tokens\.bin$' | head -1 || true)
        for bench_n in 1 4 16; do
          bench_json="${work_dir}/bench-${bench_tag}-${mode}-${bench_n}-${repeat}.json"
          bench_wall="${work_dir}/bench-wall.txt"
          : > "${bench_wall}"
          if [ "${mode}" = "dense" ]; then
            time_invocation "${bench_wall}" "${root_dir}/ggml-spike" --moe-decode-step \
              "${work_dir}/model.alignpack" "${work_dir}/geometry.json" "${bench_tokens}" \
              "${bench_json}" "${ALIGN_LLM_GGUF_MODEL}" \
              "${work_dir}/${bench_tag}-transcript.txt" "${KV_WIDTH}" "${bench_logits}" \
              "${bench_n}" "-" "-" "dense" || {
                echo "moe decode step qualification: FAIL the dense benchmark leg failed at" \
                  "prompt ${bench_index} N=${bench_n} repeat ${repeat}" >&2
                exit 1
              }
          else
            time_invocation "${bench_wall}" "${root_dir}/ggml-spike" --moe-decode-step \
              "${work_dir}/model.alignpack" "${work_dir}/geometry.json" "${bench_tokens}" \
              "${bench_json}" "${ALIGN_LLM_GGUF_MODEL}" \
              "${work_dir}/${bench_tag}-transcript.txt" "${KV_WIDTH}" "${bench_logits}" \
              "${bench_n}" || {
                echo "moe decode step qualification: FAIL the streamed benchmark leg failed at" \
                  "prompt ${bench_index} N=${bench_n} repeat ${repeat}" >&2
                exit 1
              }
          fi
          python3 - "${bench_json}" "${bench_wall}" "${repeat}" "${mode}" "${bench_index}" \
            "${bench_n}" "${bench_rows}" <<'BENCH'
import json
import sys

document_path, wall_path, repeat, mode, prompt, steps, rows_path = sys.argv[1:8]
with open(document_path, "r", encoding="utf-8") as handle:
    document = json.load(handle)
with open(wall_path, "r", encoding="utf-8") as handle:
    wall = int(handle.read().strip().split("\n")[0])
weights = document["weights"]
row = {
    "repeat": int(repeat), "mode": mode, "prompt": int(prompt), "steps": int(steps),
    "status": document["status"], "error_code": document["error_code"],
    "elapsed_ns": document["timings"]["elapsed_ns"],
    "first_token_ns": document["timings"]["first_token_ns"],
    "pread_ns": document["timings"]["pread_ns"],
    "claim_pread_ns": document["timings"]["claim_pread_ns"],
    "wall_ns": wall,
    "weights_mode": weights["mode"],
    "step_dense_pack_bytes": weights["step_dense_pack_bytes"],
    "step_expert_pack_bytes": weights["step_expert_pack_bytes"],
    "fill_bytes": weights["fill_bytes"],
    "fill_ns": weights["fill_ns"],
    "resident_bytes": weights["resident_bytes"],
    "steps_completed": document["decode"]["steps_completed"],
}
with open(rows_path, "a", encoding="utf-8") as handle:
    handle.write(json.dumps(row, separators=(",", ":")) + "\n")
BENCH
        done
      done
    done
    echo "moe decode step qualification: MRD compressor after  repeat ${repeat}:" \
      "$(compressor_state)"
  done
  echo "moe decode step qualification: MRD compressor after:  $(compressor_state)"
else
  echo "moe decode step qualification: N/A the dense leg was skipped (${resident_na}); the byte"\
    "claim, oracle D, and the floor verdict are not established by this run"
fi

python3 - "${rows_json}" "${work_dir}/fingerprints.json" "${steps}" "${bench_rows}" \
    "${RESIDENT_LEG}" <<'PY'
import json
import sys

rows = [json.loads(line) for line in open(sys.argv[1]) if line.strip()]
fingerprints = json.load(open(sys.argv[2]))
steps = int(sys.argv[3])
bench_path = sys.argv[4]
resident_leg = sys.argv[5] == "1"
print("")
print("moe decode step qualification: cell G-P1 -- %d rows of %s, %d distinct fingerprints, "
      "%d collision class(es) covering %d ids, %d of them not all-zero (%r)"
      % (fingerprints["n_vocab"], fingerprints["ggml_type"], fingerprints["distinct_fingerprints"],
         fingerprints["collision_classes"], fingerprints["colliding_id_count"],
         len(fingerprints["colliding_ids_that_are_not_all_zero"]),
         fingerprints["colliding_ids_that_are_not_all_zero"]))
print("")
# Both prefill-union fractions are printed, and neither is printed alone. `decode_keys_in_prefill_union`
# counts **demands** with repetition and `decode_distinct_keys_in_prefill_union` counts **distinct
# keys**; section 2.4 reading 2 predicted the second and the arm has always measured the first, so a
# table that showed one of them under the other's name is what section 12.3 finding 2 compared across.
print("| prompt | ids | routing | step bytes | pread | ampl ppm | union keys | union bytes | "
      "marginal MB | demands in prefill | distinct in prefill | reuse ppm | elapsed s |")
print("| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |")
for row in rows:
    marginal = sum(row["new_bytes"]) / float(len(row["new_bytes"]))
    print("| %d | %s | %d/%d | %d | %d | %d | %d | %d | %.1f | %d/%d | %d/%d | %d | %.2f |"
          % (row["prompt"], ",".join(str(i) for i in row["token_ids"][:4]) + "...",
             row["routing_matched"], row["routing_total"], row["step_expert_bytes"],
             row["step_expert_pread_bytes"][0], row["amplification_ppm"][0],
             row["union_keys_final"], row["union_bytes_final"], marginal / 1e6,
             row["decode_keys_in_prefill_union"], row["decode_keys_demanded"],
             row["decode_distinct_keys_in_prefill_union"], row["decode_keys_distinct"],
             row["step_reuse_per_mille"], row["elapsed_ns"] / 1e9))
print("")
for row in rows:
    print("moe decode step qualification: prompt %d union curve %s"
          % (row["prompt"], " -> ".join(str(v) for v in row["union_keys"])))
    print("moe decode step qualification: prompt %d marginal bytes %s"
          % (row["prompt"], " ".join(str(v) for v in row["new_bytes"])))
    for entry in row["self_reference"]:
        print("moe decode step qualification: prompt %d oracle C' at k=%d %s -- argmax %d vs %d, "
              "top-ten set equal %r, max_abs %d ten-thousandths over %d indices"
              % (row["prompt"], entry["k"], entry["verdict"],
                 entry["prefill_argmax"], entry["step_argmax"], entry["top_k_set_equal"],
                 entry["max_abs_diff_ten_thousandths"], entry["compared_indices"]))
print("")
print("moe decode step qualification: %d prompt(s) x %d steps PASS -- gate G, oracle R at %d of %d "
      "ids, oracle B, oracle T, and the claim accounting"
      % (len(rows), steps, sum(r["routing_matched"] for r in rows),
         sum(r["routing_total"] for r in rows)))

# ---------------------------------------------------------------------------------------------
# R6-MOE-RESIDENT-DENSE sections 3.7 and 6 -- the result, printed on every run
# ---------------------------------------------------------------------------------------------
if not resident_leg:
    print("")
    print("moe decode step qualification: MRD N/A the dense leg did not run, so no byte claim, no "
          "oracle D and no floor verdict are established by this run")
    raise SystemExit(0)

# Section 3.7, committed before implementation and restated here rather than recomputed.
CEILING_PPM = 276000
FLOOR_PPM = 150000
COMMITTED_BASELINE_NS = 3630000000
MISS_PPM = CEILING_PPM // 2
FIXED_PROMPT = 1
FIXED_STEPS = 16

bench = [json.loads(line) for line in open(bench_path) if line.strip()]
failures = []
for row in bench:
    if row["status"] != "ok":
        failures.append("benchmark run %r failed with %r" % (row, row["error_code"]))
    if row["steps_completed"] != row["steps"]:
        failures.append("benchmark run prompt %d %s N=%d completed %d steps"
                        % (row["prompt"], row["mode"], row["steps"], row["steps_completed"]))

print("")
print("moe decode step qualification: MRD region %d B, reproduced from the pack document by an "
      "independent walk of its %d dense member records (%d B of members, %d B table, %d B stage, "
      "%d B head); fill %d B in %d preads"
      % (rows[0]["resident"]["resident_bytes"], rows[0]["resident"]["dense_member_count"],
         rows[0]["resident"]["dense_member_bytes"], rows[0]["resident"]["table_bytes"],
         rows[0]["resident"]["stage_bytes"], rows[0]["resident"]["head_bytes"],
         rows[0]["resident"]["fill_bytes"], rows[0]["resident"]["fill_pread_count"]))
for row in rows:
    print("moe decode step qualification: MRD oracle D prompt %d %s"
          % (row["prompt"], row["resident"]["oracle_d"]))
    if row["resident"]["oracle_d"] != "MATCH":
        failures.append("oracle D diverged on prompt %d" % row["prompt"])

# --- The primary metric, at twelve points -----------------------------------------------------
print("")
print("| prompt | N | streamed step_dense_pack_bytes | dense | streamed step_expert_pack_bytes | "
      "dense |")
print("| --- | --- | --- | --- | --- | --- |")
metric_failures = 0
for prompt in sorted({row["prompt"] for row in bench}):
    for n in (1, 4, 16):
        point = [row for row in bench if row["prompt"] == prompt and row["steps"] == n]
        stream_dense = {row["step_dense_pack_bytes"] for row in point if row["mode"] == "stream"}
        dense_dense = {row["step_dense_pack_bytes"] for row in point if row["mode"] == "dense"}
        stream_expert = {row["step_expert_pack_bytes"] for row in point if row["mode"] == "stream"}
        dense_expert = {row["step_expert_pack_bytes"] for row in point if row["mode"] == "dense"}
        # A counter, not a clock: identical across the three repeats or the claim is not a counter.
        for label, values in (("streamed dense", stream_dense), ("dense dense", dense_dense),
                              ("streamed expert", stream_expert), ("dense expert", dense_expert)):
            if len(values) != 1:
                failures.append("prompt %d N=%d: the %s byte counter is not identical across the "
                                "three repeats: %r" % (prompt, n, label, sorted(values)))
        if dense_dense != {0}:
            metric_failures += 1
            failures.append("prompt %d N=%d: the dense leg read %r dense pack bytes"
                            % (prompt, n, sorted(dense_dense)))
        if stream_expert != dense_expert:
            failures.append("prompt %d N=%d: the expert measurement moved: %r streamed against %r "
                            "dense" % (prompt, n, sorted(stream_expert), sorted(dense_expert)))
        print("| %d | %d | %d | %d | %d | %d |"
              % (prompt, n, max(stream_dense), max(dense_dense), max(stream_expert),
                 max(dense_expert)))

fixed = [row for row in bench
         if row["prompt"] == FIXED_PROMPT and row["steps"] == FIXED_STEPS]
stream_ns = sorted(row["elapsed_ns"] for row in fixed if row["mode"] == "stream")
dense_ns = sorted(row["elapsed_ns"] for row in fixed if row["mode"] == "dense")
if not stream_ns or not dense_ns:
    # A fixed task with no timed runs is a runner defect, not a result. Say so and stop rather than
    # raising a `max() arg is an empty sequence` from inside a verdict line.
    sys.stderr.write("moe decode step qualification: FAIL the fixed task (prompt %d, N=%d) produced "
                     "%d streamed and %d dense timed runs\n"
                     % (FIXED_PROMPT, FIXED_STEPS, len(stream_ns), len(dense_ns)))
    raise SystemExit(1)
print("")
print("moe decode step qualification: MRD primary  streamed step_dense_pack_bytes %d, dense %d "
      "-- %s"
      % (max(row["step_dense_pack_bytes"] for row in fixed if row["mode"] == "stream"),
         max(row["step_dense_pack_bytes"] for row in fixed if row["mode"] == "dense"),
         "FAIL" if metric_failures else "PASS"))
expert_total = {row["step_expert_pack_bytes"] for row in fixed}
print("moe decode step qualification: MRD invariant  step_expert_pack_bytes %r on both legs at "
      "N=%d, and every step reports expert_bytes 487587840 with 0 ppm amplification -- %s"
      % (sorted(expert_total), FIXED_STEPS, "PASS" if len(expert_total) == 1 else "FAIL"))

stream_worst = max(stream_ns)
dense_worst = max(dense_ns)
stream_mean = sum(stream_ns) / float(len(stream_ns))
# Measurement risk 2, pre-committed: the streamed leg's own spread, taken against its mean
# exactly as item 32 section 12.5's figures are quoted, decides whether the elapsed leg is
# reportable at all. It is **printed either way** and never discarded.
spread_ppm = int(round((max(stream_ns) - min(stream_ns)) * 1000000.0 / stream_mean))
removed_ns = stream_worst - dense_worst
result_ppm = int(round(removed_ns * 1000000.0 / stream_worst))
baseline_drift_ppm = int(round(abs(stream_worst - COMMITTED_BASELINE_NS) * 1000000.0
                               / COMMITTED_BASELINE_NS))
if spread_ppm > CEILING_PPM:
    verdict = "INDETERMINATE"
elif result_ppm >= FLOOR_PPM:
    verdict = "MET"
else:
    verdict = "BELOW FLOOR"
print("moe decode step qualification: MRD baseline  the committed baseline is %d ns (3.63 s, "
      "item 32 section 12.3) and this session reproduced %d ns worst-of-3 (runs %r); drift "
      "%d ppm"
      % (COMMITTED_BASELINE_NS, stream_worst, stream_ns, baseline_drift_ppm))
print("moe decode step qualification: MRD floor  baseline (streamed, this session, worst of 3) "
      "%d ns, dense (worst of 3) %d ns, runs %r; removed %d ns = %d ppm of the fixed task "
      "against a %d ppm floor: %s"
      % (stream_worst, dense_worst, dense_ns, removed_ns, result_ppm, FLOOR_PPM, verdict))
print("moe decode step qualification: MRD spread  the streamed leg's own spread at the fixed "
      "task is %d ppm against the %d ppm ceiling; the pre-committed INDETERMINATE rule %s"
      % (spread_ppm, CEILING_PPM,
         "APPLIES" if spread_ppm > CEILING_PPM else "does not apply"))
print("moe decode step qualification: MRD ceiling  the recorded cost ceiling was %d ppm and the "
      "measured result is %d ppm = %d %% of it%s"
      % (CEILING_PPM, result_ppm, int(round(result_ppm * 100.0 / CEILING_PPM)),
         "; below one half of the ceiling, which section 3.7 labels a ceiling-estimation MISS"
         if result_ppm < MISS_PPM else ""))
for prompt in sorted({row["prompt"] for row in bench}):
    for n in (1, 4, 16):
        point = [row for row in bench if row["prompt"] == prompt and row["steps"] == n]
        s_ns = [row["elapsed_ns"] for row in point if row["mode"] == "stream"]
        d_ns = [row["elapsed_ns"] for row in point if row["mode"] == "dense"]
        if not s_ns or not d_ns:
            continue
        point_ppm = int(round((max(s_ns) - max(d_ns)) * 1000000.0 / max(s_ns)))
        print("moe decode step qualification: MRD elapsed  prompt %d N=%2d  streamed worst "
              "%d ns, dense worst %d ns, %d ppm%s"
              % (prompt, n, max(s_ns), max(d_ns), point_ppm,
                 "  <-- the fixed task, the only point an elapsed claim is made at"
                 if prompt == FIXED_PROMPT and n == FIXED_STEPS
                 else "  (diagnostic, no elapsed claim)"))
print("moe decode step qualification: MRD expert path  claim_pread_ns %d streamed against %d "
      "dense on prompt 1's owner run, and decode_expert_pread_bytes %d against %d -- the bytes "
      "must be identical and the time is reported, not absorbed"
      % (rows[0]["claim_pread_ns"], rows[0]["resident"]["dense_claim_pread_ns"],
         rows[0]["resident"]["stream_decode_expert_pread_bytes"],
         rows[0]["resident"]["dense_decode_expert_pread_bytes"]))

if failures:
    for line in failures:
        sys.stderr.write("moe decode step qualification: FAIL %s\n" % line)
    raise SystemExit(1)
PY
