#!/usr/bin/env bash
set -euo pipefail

# R2A-EXPERT-TRACE-CAPTURE narrow durable owner (`docs/specs/r2a-expert-trace.md` section 4.2). It
# needs no model, no network, and no reference tool: `scripts/eval_callback_fixture.py` writes an
# independent synthetic corpus into a temporary tree, and every fixture is removed by the EXIT trap.
# That is why it joins HOSTED_CHECK_TARGETS.
#
# Provenance of the checked-in format-fidelity fixture
# `eval/fixtures/expert-trace/qwen2-prefill-build10566.txt` (section 4.3), recorded here rather than
# in the fixture so the fixture stays byte-exact instrument output:
#
#   instrument : llama-eval-callback, version: 0.2.0 (build 10566, commit bb4caa754)
#   built with : AppleClang 21.0.0.21000101 for Darwin arm64
#   command    : llama-eval-callback -m MODEL.gguf -p "Write a function" -n 1 -t 4 > transcript.txt
#   model      : a dense qwen2 7B Q4_K_M GGUF (n_layer 28, n_embd 3584)
#   full run   : 21110 lines / 1487718 bytes / 958 callback blocks
#   excerpt    : 171 lines / 11764 bytes / 6 callback blocks, md5 81df3252be98a5e790e57fa77ba1e4b2
#
# The excerpt covers, in order: two operands and a full axis-1 print; the `, }` unary form with a
# backend-prefixed operand; axis-1 truncation; a name containing spaces and parentheses; the `f16`
# type with axis-2 truncation; and a single-row result. The model path appears only in the stderr
# stream, which this fixture does not include, and both sanitization sweeps are re-run below on
# every invocation so a future re-capture cannot smuggle a path in.

unset GIT_DIR GIT_COMMON_DIR GIT_WORK_TREE
export PYTHONDONTWRITEBYTECODE=1

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
temp_dir=$(mktemp -d)
fixture_dir="$temp_dir/fixtures"
work_dir="$temp_dir/work"

cleanup() {
  rm -rf "$temp_dir"
}
trap cleanup EXIT

if [ ! -x "$root_dir/main" ]; then
  printf '%s\n' "expert trace smoke: the product executable is missing; run 'make build'" >&2
  exit 1
fi

mkdir -p "$work_dir"
python3 "$root_dir/scripts/eval_callback_fixture.py" "$fixture_dir"

python3 - "$root_dir/main" "$fixture_dir" "$work_dir" "$root_dir" <<'PY'
import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path

binary, fixture_dir, work_dir, root_dir = (
    sys.argv[1], Path(sys.argv[2]), Path(sys.argv[3]), Path(sys.argv[4]))
manifest = json.loads((fixture_dir / "manifest.json").read_text(encoding="utf-8"))
WINDOW_BYTES = manifest["window_bytes"]
WINDOWS = manifest["windows"]
SCHEMA_VERSION = 2

TOP_ORDER = ["schema_version", "kind", "path", "status", "error_code", "error_detail",
             "source", "run", "graph", "moe", "graphs", "selections", "locality"]
SOURCE_ORDER = ["file_size", "line_count", "bytes_read", "callback_line_count",
                "skipped_line_count"]
RUN_ORDER = ["instrument", "build", "build_source", "contract_build", "build_matches_contract",
             "version_line"]
GRAPH_ORDER = ["graph_count", "n_layer", "node_families", "unsuffixed_nodes", "ops",
               "shape_class", "shape_class_basis"]
MOE_ORDER = ["present", "n_expert", "n_expert_used", "n_expert_source", "topk_layers",
             "token_reduced_layers", "slots_truncated"]
GRAPH_ROW_ORDER = ["ordinal", "n_tokens", "phase", "tokens_observed", "tokens_truncated",
                   "observed_token_indices", "node_count"]
SELECTION_ORDER = ["graph", "layer", "token", "slot", "expert",
                   "router_weight_ten_thousandths"]
LOCALITY_ORDER = ["adjacent_pair_count", "reuse_numerator", "reuse_denominator",
                  "reuse_per_mille", "per_layer", "working_set", "phase_split"]
PER_LAYER_ORDER = ["layer", "adjacent_pair_count", "reuse_numerator", "reuse_denominator",
                   "reuse_per_mille", "histogram"]
WORKING_SET_ORDER = ["window", "sample_count", "unique_sum", "unique_mean_per_mille"]
TRIPLE_ORDER = ["adjacent_pair_count", "reuse_numerator", "reuse_denominator", "reuse_per_mille"]

SUMMARY_LABELS = ["expert trace:", "status:", None, "graphs:", None, "layers:", None,
                  "tokens observed:", None, "tokens total:", None, "moe:", None, "experts:", None,
                  "experts used:", None, "selections:", None, "reuse:", None]

# Every `R2_*` code the section 2.6 table defines. `R2_TRANSCRIPT_UNREADABLE` is an operating-system
# fault, surfaced as `Err` with no document (section 6, item 1), so it is closed by the CLI cases
# below rather than by a corpus fixture; `R2_LINE_LIMIT` has no economically constructible fixture
# and is recorded as unclosed in section 7.
CODES = {
    "R2_TRANSCRIPT_EMPTY", "R2_TRANSCRIPT_TOO_LARGE", "R2_LINE_TOO_LONG", "R2_HEADER_GRAMMAR",
    "R2_NODE_NAME_TOO_LONG", "R2_DIMS_INVALID", "R2_VALUE_GRAMMAR", "R2_SUM_MISSING",
    "R2_GRAPH_LIMIT", "R2_NODE_LIMIT", "R2_LAYER_INDEX", "R2_ROW_COUNT", "R2_TOKEN_COUNT",
    "R2_EXPERT_ID_NOT_INTEGRAL", "R2_EXPERT_BOUNDS", "R2_MOE_INCONSISTENT", "R2_SELECTION_LIMIT",
    "R2_ROUTER_WEIGHT_VALUE", "R2_ROUTER_WEIGHT_MISMATCH",
}


def fail(message):
    raise SystemExit("expert trace smoke: FAIL %s" % message)


def run(args, env=None):
    return subprocess.run([binary] + args, capture_output=True, env=env, cwd=str(work_dir))


def compare(expected, actual, where, context):
    if isinstance(expected, dict) and len(expected) == 1 and "$bytes_read" in expected:
        size = expected["$bytes_read"]
        windows = max(1, (size + WINDOW_BYTES - 1) // WINDOW_BYTES)
        upper = size + windows * WINDOW_BYTES
        if not isinstance(actual, int) or not size <= actual <= upper:
            fail("%s %s: bytes_read %r outside [%d, %d]" % (context, where, actual, size, upper))
        return
    if isinstance(expected, dict):
        if not isinstance(actual, dict):
            fail("%s %s: expected an object, got %r" % (context, where, actual))
        if list(expected.keys()) != list(actual.keys()):
            fail("%s %s: field order/set %r, expected %r"
                 % (context, where, list(actual.keys()), list(expected.keys())))
        for key, value in expected.items():
            compare(value, actual[key], "%s.%s" % (where, key), context)
        return
    if isinstance(expected, list):
        if not isinstance(actual, list):
            fail("%s %s: expected an array, got %r" % (context, where, actual))
        if len(expected) != len(actual):
            fail("%s %s: length %d, expected %d" % (context, where, len(actual), len(expected)))
        for index, (want, got) in enumerate(zip(expected, actual)):
            compare(want, got, "%s[%d]" % (where, index), context)
        return
    if isinstance(expected, bool) != isinstance(actual, bool) or expected != actual:
        fail("%s %s: %r, expected %r" % (context, where, actual, expected))


def field_order(name, document):
    if list(document.keys()) != TOP_ORDER:
        fail("%s: top-level field order %r" % (name, list(document.keys())))
    for key, order in (("source", SOURCE_ORDER), ("run", RUN_ORDER), ("graph", GRAPH_ORDER),
                       ("moe", MOE_ORDER), ("locality", LOCALITY_ORDER)):
        if list(document[key].keys()) != order:
            fail("%s: %s field order %r" % (name, key, list(document[key].keys())))
    for row in document["graphs"]:
        if list(row.keys()) != GRAPH_ROW_ORDER:
            fail("%s: graphs entry field order %r" % (name, list(row.keys())))
    for row in document["selections"]:
        if list(row.keys()) != SELECTION_ORDER:
            fail("%s: selections entry field order %r" % (name, list(row.keys())))
    for row in document["locality"]["per_layer"]:
        if list(row.keys()) != PER_LAYER_ORDER:
            fail("%s: per_layer field order %r" % (name, list(row.keys())))
    for row in document["locality"]["working_set"]:
        if list(row.keys()) != WORKING_SET_ORDER:
            fail("%s: working_set field order %r" % (name, list(row.keys())))
    if list(document["locality"]["phase_split"].keys()) != ["prefill", "decode"]:
        fail("%s: phase_split field order %r"
             % (name, list(document["locality"]["phase_split"].keys())))
    for side in document["locality"]["phase_split"].values():
        if side is not None and list(side.keys()) != TRIPLE_ORDER:
            fail("%s: phase_split triple field order %r" % (name, list(side.keys())))
    if document["schema_version"] != SCHEMA_VERSION:
        fail("%s: schema_version %r" % (name, document["schema_version"]))
    if document["kind"] != "R2_ACTIVATION_TRACE":
        fail("%s: kind %r" % (name, document["kind"]))


def oracle_locality(selections, graph_phase, topk_layers):
    """The section 4.3 aggregate oracle, recomputed here from the generator's own selection list
    with deliberately naive nested loops, so the parser's single sorted sweep is checked against a
    second implementation of the same definition rather than against itself."""
    groups = {}
    for row in selections:
        groups.setdefault((row["graph"], row["layer"], row["token"]), set()).add(row["expert"])

    def triple(keys):
        pairs = numerator = denominator = 0
        for key in sorted(keys):
            following = (key[0], key[1], key[2] + 1)
            if following not in keys:
                continue
            pairs += 1
            numerator += len(groups[key] & groups[following])
            denominator += len(groups[following])
        return {
            "adjacent_pair_count": pairs,
            "reuse_numerator": numerator if pairs else None,
            "reuse_denominator": denominator if pairs else None,
            "reuse_per_mille": (numerator * 1000) // denominator if pairs and denominator else None,
        }

    keys = set(groups)
    overall = triple(keys)
    per_layer = []
    for layer in sorted(set(topk_layers)):
        entry = {"layer": layer}
        entry.update(triple({key for key in keys if key[1] == layer}))
        histogram = {}
        for row in selections:
            if row["layer"] == layer:
                histogram[row["expert"]] = histogram.get(row["expert"], 0) + 1
        entry["histogram"] = [[expert, histogram[expert]] for expert in sorted(histogram)]
        per_layer.append(entry)
    working_set = []
    for width in WINDOWS:
        samples = unique_sum = 0
        for key in sorted(keys):
            run_keys = [(key[0], key[1], key[2] - offset) for offset in range(width)]
            if not all(entry in keys for entry in run_keys):
                continue
            samples += 1
            union = set()
            for entry in run_keys:
                union |= groups[entry]
            unique_sum += len(union)
        working_set.append({"window": width, "sample_count": samples, "unique_sum": unique_sum,
                            "unique_mean_per_mille":
                            (unique_sum * 1000) // samples if samples else None})
    phase_split = {}
    for phase in ("prefill", "decode"):
        if phase not in graph_phase.values():
            phase_split[phase] = None
        else:
            phase_split[phase] = triple({k for k in keys if graph_phase.get(k[0]) == phase})
    result = dict(overall)
    result["per_layer"] = per_layer
    result["working_set"] = working_set
    result["phase_split"] = phase_split
    return result


documents = {}
stripped = {}
checked = 0
codes_seen = set()

for case in manifest["cases"]:
    name = case["name"]
    transcript = (fixture_dir / case["file"]).resolve()
    destination = work_dir / (name + ".trace.json")
    two_form = run(["--expert-trace", str(transcript), str(destination)])
    one_form = run(["--expert-trace", str(transcript)])
    if two_form.returncode < 0 or two_form.returncode > 125:
        fail("%s: exit %d looks like an abort, not a recorded failure" % (name, two_form.returncode))
    if not destination.exists():
        fail("%s: the two-operand form wrote no document" % name)
    written = destination.read_bytes()
    # `form-parity`: both forms emit byte-identical document bytes.
    if one_form.stdout != written + b"\n":
        fail("%s: the one-operand form differs from the written document" % name)
    if one_form.returncode != two_form.returncode:
        fail("%s: the two forms disagree on the exit status" % name)
    document = json.loads(written.decode("utf-8"))
    documents[name] = document
    field_order(name, document)

    expect_ok = case["expect"] == "ok"
    if expect_ok:
        if document["status"] != "ok" or two_form.returncode != 0:
            fail("%s: status %r exit %d, expected ok"
                 % (name, document["status"], two_form.returncode))
        if document["error_code"] or document["error_detail"]:
            fail("%s: an ok document carries %r/%r"
                 % (name, document["error_code"], document["error_detail"]))
    else:
        if document["status"] != "error" or two_form.returncode == 0:
            fail("%s: status %r exit %d, expected error"
                 % (name, document["status"], two_form.returncode))
        if document["error_code"] != case["error_code"]:
            fail("%s: error_code %r, expected %r" % (name, document["error_code"],
                                                     case["error_code"]))
        codes_seen.add(document["error_code"])
        if "error_detail" in case and document["error_detail"] != case["error_detail"]:
            fail("%s: error_detail %r, expected %r" % (name, document["error_detail"],
                                                       case["error_detail"]))
        # The failure document still reports every value derived before the failure.
        if document["source"]["file_size"] <= 0 and case["error_code"] != "R2_TRANSCRIPT_EMPTY":
            fail("%s: the failure document lost its file size" % name)

    if "document" in case:
        compare(case["document"], document, "", name)
        # `aggregate-oracle`: the locality object is recomputed here, independently, from the
        # generator's own selection list.
        phases = {row["ordinal"]: row["phase"] for row in document["graphs"]}
        topk = document["moe"]["topk_layers"]
        if document["moe"]["present"]:
            oracle = oracle_locality(case["document"]["selections"], phases, topk)
            compare(oracle, document["locality"], ".locality", name + " (oracle)")
        elif document["locality"]["adjacent_pair_count"] != 0:
            fail("%s: a dense document reported adjacent pairs" % name)

    asserts = case.get("asserts", {})
    for key, want in asserts.items():
        if key in ("same_document_as", "ignore_source"):
            continue
        if key == "straddles_window":
            # `bytes-read-bound`: a line that runs off the window forces a re-read at its own first
            # byte, so `bytes_read` must exceed `file_size` here and the upper bound is not vacuous.
            if document["source"]["bytes_read"] <= document["source"]["file_size"]:
                fail("%s: a straddling line did not force a re-read (bytes_read %d, file_size %d)"
                     % (name, document["source"]["bytes_read"], document["source"]["file_size"]))
            continue
        if key == "build":
            got = document["run"]["build"]
            if document["run"]["build_source"] != "transcript" or \
                    document["run"]["build_matches_contract"] is not True or \
                    not document["run"]["version_line"]:
                fail("%s: the version line did not reach `run`" % name)
        elif key in ("graph_count", "n_layer"):
            got = document["graph"][key]
        elif key == "moe_present":
            got = document["moe"]["present"]
        elif key == "selection_count":
            # `zero-selection`: the selection loop, the aggregate sweep, and the renderer all
            # terminate on a zero count.
            got = len(document["selections"])
        else:
            got = document["source"][key]
        if got != want:
            fail("%s: %s %r, expected %r" % (name, key, got, want))
    reference = asserts.get("same_document_as")
    if reference is not None:
        if reference not in documents:
            fail("%s: reference document %r has not been derived yet" % (name, reference))
        # `path`, `source`, and `run` are properties of the capture, not of the graph; every
        # derived fact must be identical.
        skip = ("path", "source", "run")
        left = {k: v for k, v in document.items() if k not in skip}
        right = {k: v for k, v in documents[reference].items() if k not in skip}
        if left != right:
            fail("%s: the derived document differs from %r" % (name, reference))

    # The section 4.6 secondary metric, asserted on every fixture.
    size = document["source"]["file_size"]
    windows = max(1, (size + WINDOW_BYTES - 1) // WINDOW_BYTES)
    if not 0 <= document["source"]["bytes_read"] <= size + windows * WINDOW_BYTES:
        fail("%s: bytes_read %d is outside its bound" % (name, document["source"]["bytes_read"]))
    if size <= WINDOW_BYTES and document["source"]["bytes_read"] not in (0, size):
        fail("%s: a single-window transcript read %d of %d bytes"
             % (name, document["source"]["bytes_read"], size))

    # `summary-order`: the section 2.3 lines appear in this exact order, and every
    # transcript-controlled value occupies exactly one line.
    summary = two_form.stdout.decode("utf-8").split("\n")
    for position, label in enumerate(SUMMARY_LABELS):
        if label is not None and summary[position] != label:
            fail("%s: summary line %d %r, expected %r" % (name, position, summary[position], label))
    if summary[2] != ("OK" if expect_ok else "ERROR"):
        fail("%s: summary status %r" % (name, summary[2]))
    # `dense-zero-layer`: an underived layer count prints the reserved `-`, never the `-1`
    # sentinel the derivation carries and never a value a reader could mistake for a count.
    n_layer = document["graph"]["n_layer"]
    if summary[6] != ("-" if n_layer is None else str(n_layer)):
        fail("%s: summary layers %r, document graph.n_layer %r" % (name, summary[6], n_layer))
    if summary[12] != ("YES" if document["moe"]["present"] else "NO"):
        fail("%s: summary moe %r" % (name, summary[12]))
    if summary[18] != str(len(document["selections"])):
        fail("%s: summary selections %r" % (name, summary[18]))
    if expect_ok:
        if summary[21] != "":
            fail("%s: an ok summary printed %r after the reuse row" % (name, summary[21]))
    else:
        if summary[21] != "error:" or summary[22] != document["error_code"]:
            fail("%s: summary error rows %r" % (name, summary[21:23]))
        if summary[23] != "detail:":
            fail("%s: summary detail label %r" % (name, summary[23]))
        if summary[25] != "":
            fail("%s: the detail value did not occupy exactly one line (%r)" % (name, summary[25]))
    checked += 1

if checked != len(manifest["cases"]):
    fail("only %d of %d manifest cases ran" % (checked, len(manifest["cases"])))

expected_codes = set(CODES)
if not manifest["sparse_oversize"]:
    # A dropped expectation is never silent: the code this run did *not* cover is named on its own
    # line, so a reader of the log can tell an unexercised row from a passing one.
    expected_codes.discard("R2_TRANSCRIPT_TOO_LARGE")
    print("expert trace smoke: SKIPPED oversize-transcript / R2_TRANSCRIPT_TOO_LARGE - this "
          "filesystem did not produce a sparse file above MAX_TRANSCRIPT_BYTES, so the code is "
          "not covered by this run")
missing = sorted(expected_codes - codes_seen)
if missing:
    fail("error-corpus: no fixture fired %s" % ", ".join(missing))

# `fixture-determinism`: two runs of the generator produce byte-identical fixtures. The generator
# takes no seed from the environment and no wall-clock value, so a difference here is a real
# nondeterminism and not a tolerance question.
second = work_dir / "regenerated"
subprocess.run([sys.executable, str(root_dir / "scripts/eval_callback_fixture.py"), str(second)],
               check=True, capture_output=True)
for case in manifest["cases"]:
    left = fixture_dir / case["file"]
    right = second / case["file"]
    if left.stat().st_size != right.stat().st_size:
        fail("fixture-determinism: %s changed size between two runs" % case["file"])
    if left.stat().st_size > WINDOW_BYTES * 2:
        continue
    if left.read_bytes() != right.read_bytes():
        fail("fixture-determinism: %s differs between two runs" % case["file"])
placeholder = json.dumps(manifest).replace(str(fixture_dir), "@")
regenerated = json.loads((second / "manifest.json").read_text(encoding="utf-8"))
if json.dumps(regenerated).replace(str(second), "@") != placeholder:
    fail("fixture-determinism: the manifest differs between two runs")

# ---------------------------------------------------------------------------------------------
# The section 4.3 format-fidelity fixture: real output from build 10566 on this host.
real = (root_dir / "eval/fixtures/expert-trace/qwen2-prefill-build10566.txt").resolve()
raw = real.read_bytes()
if hashlib.md5(raw).hexdigest() != "81df3252be98a5e790e57fa77ba1e4b2":
    fail("real-transcript: the checked-in fixture changed; re-record its provenance")
PATH_NEEDLES = (b"/Users/", b"/home/", b"/private/", b"/opt/", b"/var/", b"/tmp/", b"\\\\")
for needle in PATH_NEEDLES:
    if needle in raw:
        fail("real-transcript: the fixture carries a path fragment %r" % needle)
if re.search(rb"[A-Za-z]:\\", raw):
    fail("real-transcript: the fixture carries a Windows drive prefix")
# The operator's own account name, swept for the same reason the path fragments are: a future
# re-capture must not smuggle one in. Names shorter than four bytes are skipped because they would
# collide with the grammar's own vocabulary rather than detect anything.
account_names = {os.environ.get("USER") or "", os.environ.get("LOGNAME") or "",
                 Path.home().name if str(Path.home()) else ""}
swept = sorted(name for name in account_names if len(name) >= 4)
for name in swept:
    if name.encode("utf-8") in raw:
        fail("real-transcript: the fixture carries the operator's account name %r" % name)
print("expert trace smoke: real-transcript sanitization swept %d path fragment(s), the Windows "
      "drive prefix, every non-printable byte, and %d account name(s) %s"
      % (len(PATH_NEEDLES), len(swept), swept))
for byte in set(raw):
    if byte != 10 and (byte < 32 or byte > 126):
        fail("real-transcript: the fixture carries a non-printable byte %d" % byte)

# The arm is pointed at a **writable copy**, never at the checked-in path. `expert_trace.scan`
# opens its transcript with `fs.open_rw` (Request 21), so a read-only checkout — which is exactly
# what the fresh trusted worker mounts, and what a CI artifact directory normally is — refuses the
# scan with exit 3 before a byte is read. The sanitization sweep above still reads the checked-in
# bytes, so nothing about the fixture's own contract is weakened.
real_input = work_dir / "real-transcript.txt"
real_input.write_bytes(raw)
real_destination = work_dir / "real.trace.json"
real_result = run(["--expert-trace", str(real_input), str(real_destination)])
if real_result.returncode != 0:
    fail("real-transcript: exit %d" % real_result.returncode)
real_document = json.loads(real_destination.read_text(encoding="utf-8"))
field_order("real-transcript", real_document)
expected_real = {
    "status": "ok",
    "source": {"file_size": 11764, "line_count": 171, "bytes_read": 11764,
               "callback_line_count": 6, "skipped_line_count": 5},
    "run": {"instrument": "llama-eval-callback", "build": None, "build_source": "absent",
            "contract_build": manifest["contract_build"], "build_matches_contract": None,
            "version_line": None},
    "graph": {"graph_count": 1, "n_layer": 1,
              "node_families": ["Qcur", "norm"],
              "unsuffixed_nodes": ["Qcur-0 (view) (permuted)", "cache_v_l0 (view)", "embd",
                                   "result_output"],
              "ops": ["GET_ROWS", "MUL_MAT", "PERMUTE", "RESHAPE", "RMS_NORM", "VIEW"],
              "shape_class": "unknown",
              "shape_class_basis": "ffn_moe_topk absent, no dense feed-forward family present"},
    "moe": {"present": False, "n_expert": None, "n_expert_used": None, "n_expert_source": None,
            "topk_layers": [], "token_reduced_layers": [], "slots_truncated": False},
    "graphs": [{"ordinal": 0, "n_tokens": 5, "phase": "prefill", "tokens_observed": 5,
                "tokens_truncated": False, "observed_token_indices": [0, 1, 2, 3, 4],
                "node_count": 6}],
    "selections": [],
    "locality": {"adjacent_pair_count": 0, "reuse_numerator": None, "reuse_denominator": None,
                 "reuse_per_mille": None, "per_layer": [], "working_set": [],
                 "phase_split": {"prefill": None, "decode": None}},
}
for key, want in expected_real.items():
    compare(want, real_document[key], "." + key, "real-transcript")
# `value-shapes`: only the five blank separators were skipped, so every other line of the real
# excerpt matched one of the recognized shapes.
if real_document["source"]["skipped_line_count"] != 5:
    fail("real-transcript: %d lines matched no recognized shape"
         % real_document["source"]["skipped_line_count"])

# ---------------------------------------------------------------------------------------------
# CLI arity, path validation, and operating-system failures.
sample = (fixture_dir / "dense-L2-T5.txt").resolve()
sample_document = (work_dir / "dense-L2-T5.trace.json").read_bytes()

no_args = run([])
if no_args.returncode != 0 or b"--expert-trace" not in no_args.stdout:
    fail("usage-diff: the no-argument help does not name --expert-trace")
if b"--model-ir" not in no_args.stdout or b"--inspect-gguf" not in no_args.stdout:
    fail("usage-diff: an existing usage line disappeared")
missing_operand = run(["--expert-trace"])
if missing_operand.returncode == 0 or missing_operand.stdout != b"":
    fail("cli-arity: a zero-operand invocation must fail with no output")
too_many = run(["--expert-trace", str(sample), "a.json", "b.json"])
if too_many.returncode == 0 or too_many.stdout != b"":
    fail("cli-arity: a three-operand invocation must fail with no output")
if (work_dir / "a.json").exists():
    fail("cli-arity: an over-arity invocation created a file")
# `selector-as-operand`: the selector is recognized only at args[1].
operand = run(["--expert-trace", "--expert-trace"])
if operand.returncode == 0 or operand.stdout != b"":
    fail("selector-as-operand: the second --expert-trace must be read as a path")

for label, bad_path in (("empty", ""), ("over-length", "x" * 4097)):
    bad = run(["--expert-trace", bad_path, str(work_dir / "bad-path.json")])
    if bad.returncode == 0 or bad.stdout != b"":
        fail("path-too-long: an %s path must fail with no output" % label)
    if (work_dir / "bad-path.json").exists():
        fail("path-too-long: an %s path created a destination file" % label)

# `destination-path-guard`: section 2.6 step 2 owns *both* operands, and the guard runs before the
# derivation, so an unusable destination produces no document, no summary block, and no scan.
for label, bad_destination in (("empty", ""), ("over-length", "x" * 4097)):
    bad = run(["--expert-trace", str(sample), bad_destination])
    # Exit 2 is `Err(Error.Invalid)` from the lexical guard. A bare "nonzero" assertion would also
    # accept a failure raised *after* the transcript was scanned, which is the thing this case
    # exists to rule out.
    if bad.returncode != 2 or bad.stdout != b"":
        fail("destination-path-guard: an %s destination must exit 2 with no output (saw %d, %r)"
             % (label, bad.returncode, bad.stdout[:80]))
# Not `(work_dir / ("x" * 4097)).exists()`: a 4097-byte final component is longer than any
# supported name, so `stat` answers `ENAMETOOLONG` rather than "absent" and `Path.exists` re-raises
# it on Python 3.12 (3.13 swallows it). The guard is about a *created* entry, so read the directory
# instead of probing the impossible name.
if any(entry.name.startswith("x") for entry in work_dir.iterdir()):
    fail("destination-path-guard: an over-length destination created a file")

sentinel = work_dir / "sentinel.json"
sentinel.write_bytes(b"SENTINEL")
absent = run(["--expert-trace", str(fixture_dir / "absent.txt"), str(sentinel)])
if absent.returncode == 0 or absent.stdout != b"":
    fail("unreadable-transcript: an absent transcript must fail with no output")
if sentinel.read_bytes() != b"SENTINEL":
    fail("untouched-destination: an OS failure rewrote the destination")
directory = run(["--expert-trace", str(fixture_dir), str(sentinel)])
if directory.returncode == 0 or directory.stdout != b"":
    fail("directory-operand: a directory operand must fail with no output")
if sentinel.read_bytes() != b"SENTINEL":
    fail("untouched-destination: a directory operand rewrote the destination")

denied = work_dir / "denied.txt"
denied.write_bytes(sample.read_bytes())
denied.chmod(0o000)
if hasattr(os, "geteuid") and os.geteuid() == 0:
    print("expert trace smoke: denied-path SKIPPED (running as root)")
else:
    denied_result = run(["--expert-trace", str(denied), str(sentinel)])
    if denied_result.returncode == 0 or denied_result.stdout != b"":
        fail("unreadable-transcript: an unreadable transcript must fail with no output")
    if sentinel.read_bytes() != b"SENTINEL":
        fail("untouched-destination: an unreadable transcript rewrote the destination")
denied.chmod(0o600)

# `read-only-transcript`: the Request 21 client evidence, asserted rather than described. The
# transcript below is readable by its owner and not writable by anyone, which is exactly a
# CI-produced trace in a root-owned or read-only artifact directory. Align ships only `fs.open_rw`,
# so the kernel refuses `O_RDWR` and the derivation cannot start at all — no document, untouched
# destination, nonzero exit. This case is expected to FLIP to a successful derivation the day
# `docs/align-requests.md` Request 21 ships `fs.open_ro` and `src/expert_trace.align` adopts it.
read_only = work_dir / "read-only.txt"
read_only.write_bytes(sample.read_bytes())
read_only.chmod(0o444)
if hasattr(os, "geteuid") and os.geteuid() == 0:
    print("expert trace smoke: SKIPPED read-only-transcript - running as root, which may write a "
          "mode 0444 file, so the writable-path precondition is not observable here")
else:
    read_only_result = run(["--expert-trace", str(read_only), str(sentinel)])
    if read_only_result.returncode == 0 or read_only_result.stdout != b"":
        fail("read-only-transcript: `fs.open_rw` unexpectedly opened a mode 0444 transcript; if "
             "Align now ships a read-only open, adopt it and close Request 21")
    if sentinel.read_bytes() != b"SENTINEL":
        fail("untouched-destination: a read-only transcript rewrote the destination")
    print("expert trace smoke: read-only-transcript exits %d with no document (Request 21 client "
          "evidence: `fs.open_rw` requires O_RDWR on a transcript R2A never writes)"
          % read_only_result.returncode)
read_only.chmod(0o600)

# A transcript defect replaces the destination with the complete document — never a partial write.
structural = run(["--expert-trace", str((fixture_dir / "dims-invalid.txt").resolve()),
                  str(sentinel)])
if structural.returncode == 0:
    fail("error-corpus: a transcript defect must exit nonzero")
replaced = json.loads(sentinel.read_text(encoding="utf-8"))
if replaced["error_code"] != "R2_DIMS_INVALID":
    fail("error-corpus: the destination does not hold the complete failure document")
if b"expert trace:" not in structural.stdout or b"R2_DIMS_INVALID" not in structural.stdout:
    fail("error-corpus: the summary block does not report the error code")

# `summary-control-bytes`: a control byte in a transcript-supplied identifier is escaped, so the
# detail still occupies exactly one line, and the document stays valid JSON.
control = work_dir / "control.txt"
control.write_bytes((fixture_dir / "dense-L2-T5.txt").read_bytes()
                    .replace(b"= {3584, 5, 1, 1}", b"= {3584, 5, 1}", 1)
                    .replace(b"embd = ", b"em\x01d = ", 1))
control_result = run(["--expert-trace", str(control.resolve()), str(work_dir / "control.json")])
if control_result.returncode == 0:
    fail("summary-control-bytes: a defective transcript must exit nonzero")
control_document = json.loads((work_dir / "control.json").read_text(encoding="utf-8"))
if "\x01" in json.dumps(control_document["error_detail"]):
    fail("wire-escapes: a raw control byte reached the document")
control_summary = control_result.stdout.decode("utf-8").split("\n")
if control_summary[23] != "detail:" or "\x01" in control_summary[24]:
    fail("summary-control-bytes: the summary detail was not sanitized")

# `env-perturbation`: no environment variable changes one document byte.
perturbed = dict(os.environ)
perturbed.update({"LC_ALL": "tr_TR.UTF-8", "LANG": "tr_TR.UTF-8", "TZ": "Pacific/Kiritimati",
                  "SOURCE_DATE_EPOCH": "1", "HOME": str(work_dir),
                  "ALIGN_LLM_GGUF_MODEL": "/nonexistent",
                  "ALIGN_LLM_LLAMA_EVAL_CALLBACK": "/nonexistent",
                  "ALIGN_LLM_EXPERT_TRACE_BUILD": "10567"})
env_result = run(["--expert-trace", str(sample)], env=perturbed)
if env_result.returncode != 0 or env_result.stdout != sample_document + b"\n":
    fail("env-perturbation: a perturbed environment changed the document")

# `repeat-expert-trace`: repeated derivations do not drift and do not grow.
for _ in range(64):
    repeat = run(["--expert-trace", str(sample)])
    if repeat.returncode != 0 or repeat.stdout != sample_document + b"\n":
        fail("repeat-expert-trace: a repeated derivation diverged")

# The neighbouring arms are untouched.
inspect_still_works = run(["--inspect-gguf", str(work_dir / "absent.gguf")])
if inspect_still_works.returncode == 0:
    fail("selector-isolation: the --inspect-gguf arm changed")

# `locality-gate-aggregator`: the R2 locality gate's pooled verdict function, run here on the
# synthetic corpus so that the statistics have an owner test with no model, no network, and no
# instrument. `scripts/expert_locality_gate.py` is the same module `scripts/run-expert-locality-gate`
# imports; only its input differs.
sys.path.insert(0, str(root_dir / "scripts"))
from expert_locality_gate import GateError, aggregate, require_compact_router_axes

gate_inputs = {}
for name, document in documents.items():
    if document["status"] != "ok" or not document["moe"]["present"]:
        continue
    if document["locality"]["adjacent_pair_count"] <= 0:
        continue
    if document["moe"]["n_expert_used"] > 6 and document["moe"]["slots_truncated"] is not True:
        continue
    shape = (document["moe"]["n_expert"], document["moe"]["n_expert_used"])
    gate_inputs.setdefault(shape, []).append((name, document))
if not gate_inputs:
    fail("locality-gate-aggregator: the corpus produced no poolable MoE document")

# The generator's router is a deterministic hash of `(seed, graph, layer, token)`, so its expert
# choice at `t + 1` is independent of its choice at `t`. Pooling those documents must therefore
# report NO_LOCALITY: an aggregator that finds locality in a memoryless router would find it
# anywhere.
shape, entries = max(gate_inputs.items(), key=lambda item: len(item[1]))
random_result = aggregate([document for _, document in entries],
                          [name for name, _ in entries])
if random_result["verdict"] != "NO_LOCALITY":
    fail("locality-gate-aggregator: a memoryless router scored %s (p^ %d per mille, null %d, "
         "wilson lo %d over %d trials)"
         % (random_result["verdict"], random_result["reuse_per_mille"],
            random_result["null_per_mille"], random_result["wilson_low_per_mille"],
            random_result["reuse_denominator"]))
if random_result["n_expert"] != shape[0] or random_result["n_expert_used"] != shape[1]:
    fail("locality-gate-aggregator: the pooled router shape was not carried through")

# --- locality-gate hand-built cases (begin) ---
# The generator's corpus supplies one end of the verdict rule and nothing else: a memoryless router
# fails both halves at once, so it cannot tell a conjunction from a disjunction, a threshold of 1.5
# from one of 3.0, or a 95% interval from a zero-width one. The cases below are built here, with a
# router this file specifies exactly, so that each half of the rule is decided on its own.
GATE_N_EXPERT = 64
GATE_N_EXPERT_USED = 8
GATE_SLOTS = 6


def built_document(shares, n_expert=GATE_N_EXPERT, used=GATE_N_EXPERT_USED, slots=GATE_SLOTS):
    """One `R2_ACTIVATION_TRACE` document whose adjacent-token reuse is exactly `shares`.

    `shares[layer][t]` is how many of the `slots` experts selected at token `t + 1` were also
    selected at token `t`; the remaining slots are drawn disjoint from token `t`. Every layer
    carries `len(shares[layer]) + 1` token positions. `locality` is computed from the emitted
    `selections[]`, so the gate's parser/recomputation cross-check passes and every number it
    reports is a consequence of `shares` alone.
    """
    selections = []
    groups = {}
    for layer, layer_shares in enumerate(shares):
        cursor = 0
        previous = None
        for token in range(len(layer_shares) + 1):
            if previous is None:
                chosen = list(range(slots))
            else:
                chosen = list(previous[:layer_shares[token - 1]])
                while len(chosen) < slots:
                    candidate = cursor % n_expert
                    cursor += 1
                    if candidate not in previous and candidate not in chosen:
                        chosen.append(candidate)
            slot_indices = (list(range(used)) if slots == used or used <= 6 else
                            [0, 1, 2, used - 3, used - 2, used - 1])
            for slot, expert in zip(slot_indices, chosen):
                selections.append({"graph": 0, "layer": layer, "token": token,
                                   "slot": slot, "expert": expert})
            groups[(layer, token)] = chosen
            previous = chosen

    pairs = numerator = denominator = 0
    for (layer, token), experts in sorted(groups.items()):
        following = groups.get((layer, token + 1))
        if following is None:
            continue
        pairs += 1
        numerator += len(set(experts) & set(following))
        denominator += len(following)

    working_set = []
    for width in (1, 2, 4):
        samples = unique_sum = 0
        for (layer, token) in sorted(groups):
            run = [groups.get((layer, token + step)) for step in range(width)]
            if any(entry is None for entry in run):
                continue
            samples += 1
            unique_sum += len(set().union(*[set(entry) for entry in run]))
        working_set.append({"window": width, "sample_count": samples, "unique_sum": unique_sum})

    n_tokens = max(len(layer_shares) for layer_shares in shares) + 1
    return {
        "status": "ok", "error_code": "",
        "moe": {"present": True, "n_expert": n_expert, "n_expert_used": used,
                "n_expert_source": "ffn_moe_probs", "topk_layers": list(range(len(shares))),
                "token_reduced_layers": [], "slots_truncated": used > slots},
        "graphs": [{"ordinal": 0, "n_tokens": n_tokens, "phase": "prefill",
                    "tokens_observed": n_tokens, "tokens_truncated": False, "node_count": 0}],
        "selections": selections,
        "locality": {"adjacent_pair_count": pairs, "reuse_numerator": numerator,
                     "reuse_denominator": denominator, "working_set": working_set},
    }


def gate_case(label, documents, **expected):
    result = aggregate(documents, ["%s-%d" % (label, index) for index in range(len(documents))])
    for field, want in sorted(expected.items()):
        if result[field] != want:
            fail("locality-gate-aggregator: %s reported %s = %r, expected %r (verdict %s, p^ %d, "
                 "wilson lo %d, cluster lo %d over %d cluster(s), deff %d)"
                 % (label, field, result[field], want, result["verdict"],
                    result["reuse_per_mille"], result["wilson_low_per_mille"],
                    result["cluster_low_per_mille"], result["cluster_count"],
                    result["design_effect_per_mille"]))
    return result


# The historical gate's denominator is six printed slots. A schema-1 full-axis R2c document is
# valid parser output but is not valid input to that already-recorded measurement.
full_axis_document = built_document([[8] * 5] * 4, slots=8)
try:
    require_compact_router_axes([full_axis_document], ["full-axis"])
except GateError as error:
    if "compact router axes" not in str(error):
        fail("locality-gate-aggregator: full-axis refusal has the wrong diagnostic %r" % error)
else:
    fail("locality-gate-aggregator: a full-axis R2c document entered the historical gate")


# The two nulls are constants of the router shape, not of the corpus, and the verdict is judged
# against the larger of them. Asserting them here is what makes every ratio below meaningful.
sticky_result = gate_case("sticky", [built_document([[6] * 5] * 4)],
                          verdict="LOCALITY", null_per_mille=125, observed_null_per_mille=93,
                          reuse_per_mille=1000, layers_clearing_null=4,
                          pooled_top8_mass_per_mille=1000, excludes_null=True,
                          materially_above_null=True, cluster_count=1,
                          design_effect_estimated=False, design_effect_per_mille=1000,
                          wilson_low_per_mille=968, cluster_low_per_mille=968)
if sticky_result["working_set"][1]["deficit_per_mille"] != 11437 - 6000:
    fail("locality-gate-aggregator: the w=2 working-set deficit is %d per mille"
         % sticky_result["working_set"][1]["deficit_per_mille"])

# Detectable but immaterial: one shared expert of six at every adjacent pair is 166 per mille, so
# the interval clears the 125 per mille null on 1,200 trials while the point estimate is far below
# 1.5 x null. Only a conjunction can call this NO_LOCALITY, and only the k/n null can: judged
# against the printed-subset null of 93 per mille, 166 would be material.
gate_case("half-detectable", [built_document([[1] * 5] * 5) for _ in range(8)],
          verdict="NO_LOCALITY", excludes_null=True, materially_above_null=False,
          reuse_per_mille=166, reuse_numerator=200, reuse_denominator=1200,
          wilson_low_per_mille=146, cluster_low_per_mille=146, cluster_count=8,
          design_effect_per_mille=1000, design_effect_estimated=True, layers_clearing_null=0)

# Material but uncertain: three hits in twelve trials is 250 per mille, twice the null, but a
# twelve-trial interval reaches down to 88 per mille and includes it. Only a conjunction can call
# this NO_LOCALITY, and only a nonzero z: at z = 0 the interval collapses onto p^ and clears.
gate_case("half-material", [built_document([[1, 2]])],
          verdict="NO_LOCALITY", excludes_null=False, materially_above_null=True,
          reuse_per_mille=250, reuse_numerator=3, reuse_denominator=12,
          wilson_low_per_mille=88, cluster_low_per_mille=88, cluster_count=1,
          design_effect_estimated=False, layers_clearing_null=0)

# Between the two thresholds: 250 per mille on 1,200 trials is 2.0 x the null, above the shipped
# 1.5 x materiality bar and below 3.0 x. It is also the shape of the real measurement, whose ratio
# is 2.29 x, so a materiality threshold raised past 2 would silently reverse the shipped verdict.
gate_case("material", [built_document([[1] * 5] * 4 + [[2] * 5] * 4) for _ in range(5)],
          verdict="LOCALITY", excludes_null=True, materially_above_null=True,
          reuse_per_mille=250, reuse_numerator=300, reuse_denominator=1200,
          ratio_to_null_per_mille=2000, threshold_per_mille=188,
          wilson_low_per_mille=226, cluster_low_per_mille=226, layers_clearing_null=4)

# Clustering, which the naive interval cannot see. Six prompts: two perfectly sticky, four
# memoryless. Pooled reuse is 333 per mille and the Wilson interval says [299, 368] — a decisive
# LOCALITY on the independence assumption — but the effect lives entirely *between* prompts, the
# measured design effect is 144, and the cluster-robust bound reaches 86 per mille, below the null.
# The verdict must follow the clustered bound.
gate_case("between-prompt", [built_document([[6] * 5] * 4) for _ in range(2)]
          + [built_document([[0] * 5] * 4) for _ in range(4)],
          verdict="NO_LOCALITY", excludes_null=False, materially_above_null=True,
          reuse_per_mille=333, wilson_low_per_mille=299, cluster_low_per_mille=86,
          cluster_count=6, design_effect_per_mille=143999, design_effect_estimated=True)

# A disagreement between this module's recomputation and the parser's own aggregate is an
# instrument problem, and the gate must refuse rather than average over it.
corrupted = json.loads(json.dumps(built_document([[6] * 5] * 4)))
corrupted["locality"]["reuse_numerator"] -= 1
try:
    aggregate([corrupted], ["corrupted"])
except GateError:
    pass
else:
    fail("locality-gate-aggregator: a parser/recomputation disagreement was not refused")

# The pooled omission fields: a document that dropped a token-reduced layer must be counted and its
# layer named, because that layer contributed nothing to any number above.
reduced_document = json.loads(json.dumps(built_document([[6] * 5] * 4)))
reduced_document["moe"]["token_reduced_layers"] = [4]
reduced_document["graphs"][0]["tokens_truncated"] = True
gate_case("token-reduced", [reduced_document],
          token_reduced_layers=[4], documents_token_reduced=1, truncated_documents=1)
# --- locality-gate hand-built cases (end) ---

# --- decode-locality-gate hand-built cases (begin) ---
# `decode-locality-gate-aggregator`: the R2D decode gate's three verdicts, run on full-axis
# multi-graph documents this file specifies exactly. The R2c instrument prints every router slot
# and evaluates decode graphs, so the decode gate's adjacency is over the *sequence* rather than
# inside one graph: the last prompt token and the first generated token are adjacent, and so are
# two consecutive decode graphs. None of that can be exercised by the generator's single-graph
# compact corpus, and none of it may be judged by a different rule than the prefill half.
from expert_locality_gate import (DECODE_CAVEATS, aggregate_decode, decode_caveats,
                                  entry_token_fingerprints, require_full_router_axes)

DECODE_SLOTS = 8


def built_decode_document(shares, prefill_tokens, decode_graphs, marks=None, layers=4,
                          n_expert=GATE_N_EXPERT, used=DECODE_SLOTS, token_reduced_layer=None,
                          omit=()):
    """One full-axis document whose sequence-adjacent reuse is exactly `shares`.

    The chain of one `(document, layer)` is `prefill_tokens` positions of graph 0 followed by one
    position of each of `decode_graphs` one-token graphs. `shares[i]` is how many of the `used`
    experts at chain position `i + 1` were also selected at position `i`; the rest are drawn
    disjoint. `shares` therefore names the prefill pairs, then the single boundary pair, then the
    decode pairs, in that order, and every number the gate reports is a consequence of it alone.

    `marks[i]` is the token fingerprint of chain position `i`, used only by the repetition and
    sensitivity arms.

    `token_reduced_layer` reproduces correction 20 on the *prefill* graph: the instrument runs the
    output-token `GET_ROWS` before the graph's highest layer's feed-forward, so that layer emits no
    `selections[]` row for graph 0 at all and is listed in `moe.token_reduced_layers`. Its chain
    therefore starts at the first decode graph, and its first pair is a decode pair rather than the
    boundary pair -- which is why the real capture reports 16 decode layers against 15 prefill ones.

    `omit` drops the named `(graph, layer)` groups outright, leaving a hole in that layer's chain.
    """
    positions = ([(0, token) for token in range(prefill_tokens)]
                 + [(graph, 0) for graph in range(1, decode_graphs + 1)])
    if len(shares) != len(positions) - 1:
        fail("decode-locality-gate-aggregator: %d share(s) for %d position(s)"
             % (len(shares), len(positions)))

    if token_reduced_layer is not None and token_reduced_layer != layers - 1:
        fail("decode-locality-gate-aggregator: only the highest layer may be token-reduced")
    dropped = set(omit)
    if token_reduced_layer is not None:
        dropped.add((0, token_reduced_layer))

    selections = []
    chosen_by = {}
    for layer in range(layers):
        cursor = layer * 991
        previous = None
        for index, position in enumerate(positions):
            if previous is None:
                chosen = list(range(used))
            else:
                chosen = list(previous[:shares[index - 1]])
                while len(chosen) < used:
                    candidate = cursor % n_expert
                    cursor += 1
                    if candidate not in previous and candidate not in chosen:
                        chosen.append(candidate)
            if (position[0], layer) not in dropped:
                for slot, expert in enumerate(chosen):
                    selections.append({"graph": position[0], "layer": layer, "token": position[1],
                                       "slot": slot, "expert": expert})
            chosen_by[(layer, position)] = chosen
            previous = chosen

    # The parser's own `locality` only ever sees within-graph adjacency, and `aggregate_decode`
    # cross-checks its prefill arm against it. Computing it here from the emitted `selections[]`
    # keeps the fixture honest instead of asserting agreement with a number it was handed.
    pairs = numerator = denominator = 0
    for layer in range(layers):
        if (0, layer) in dropped:
            continue
        for token in range(prefill_tokens - 1):
            before = set(chosen_by[(layer, (0, token))])
            after = set(chosen_by[(layer, (0, token + 1))])
            pairs += 1
            numerator += len(before & after)
            denominator += len(after)
    prefill_side = ({"adjacent_pair_count": pairs, "reuse_numerator": numerator,
                     "reuse_denominator": denominator,
                     "reuse_per_mille": numerator * 1000 // denominator} if denominator else None)

    working_set = []
    for width in (1, 2, 4):
        samples = unique_sum = 0
        for layer in range(layers):
            if (0, layer) in dropped:
                continue
            for token in range(prefill_tokens):
                if token + width > prefill_tokens:
                    continue
                samples += 1
                union = set()
                for step in range(width):
                    union |= set(chosen_by[(layer, (0, token + step))])
                unique_sum += len(union)
        working_set.append({"window": width, "sample_count": samples, "unique_sum": unique_sum})

    graphs = [{"ordinal": 0, "n_tokens": prefill_tokens,
               "phase": "prefill" if prefill_tokens > 1 else "single_token_first_graph",
               "tokens_observed": prefill_tokens, "tokens_truncated": False,
               "observed_token_indices": list(range(prefill_tokens)), "node_count": 0}]
    for graph in range(1, decode_graphs + 1):
        graphs.append({"ordinal": graph, "n_tokens": 1, "phase": "decode", "tokens_observed": 1,
                       "tokens_truncated": False, "observed_token_indices": [0], "node_count": 0})

    document = {
        "status": "ok", "error_code": "",
        "moe": {"present": True, "n_expert": n_expert, "n_expert_used": used,
                "n_expert_source": "ffn_moe_probs", "topk_layers": list(range(layers)),
                "token_reduced_layers": ([] if token_reduced_layer is None
                                         else [token_reduced_layer]),
                "slots_truncated": False},
        "graphs": graphs,
        "selections": selections,
        "locality": {"adjacent_pair_count": pairs, "reuse_numerator": numerator or None,
                     "reuse_denominator": denominator or None, "working_set": working_set,
                     "phase_split": {"prefill": prefill_side, "decode": None}},
    }
    fingerprints = None
    if marks is not None:
        fingerprints = {position: marks[index] for index, position in enumerate(positions)}
    return document, fingerprints


def decode_case(label, built, **expected):
    documents = [entry[0] for entry in built]
    marks = [entry[1] for entry in built]
    fingerprints = None if any(entry is None for entry in marks) else marks
    result = aggregate_decode(documents, ["%s-%d" % (label, index)
                                          for index in range(len(documents))], fingerprints)
    for field, want in sorted(expected.items()):
        parts = field.split(".")
        actual = result
        for part in parts:
            actual = actual[part] if actual is not None else None
        if actual != want:
            fail("decode-locality-gate-aggregator: %s reported %s = %r, expected %r (%s)"
                 % (label, field, actual, want,
                    "; ".join("%s p^ %s cluster lo %s verdict %s"
                              % (name,
                                 result["phases"][name] and result["phases"][name][
                                     "reuse_per_mille"],
                                 result["phases"][name] and result["phases"][name][
                                     "cluster_low_per_mille"],
                                 result["phases"][name] and result["phases"][name]["verdict"])
                              for name in ("prefill", "decode", "boundary"))))
    return result


# The compact historical corpus and the full-axis decode corpus must never be pooled, in either
# direction: the historical gate refuses full axes (asserted above) and the decode gate refuses
# compact ones, because its denominator is the whole top-k set.
compact_document = built_document([[6] * 5] * 4)
try:
    require_full_router_axes([compact_document], ["compact"])
except GateError as error:
    if "full router axes" not in str(error):
        fail("decode-locality-gate-aggregator: compact refusal has the wrong diagnostic %r" % error)
else:
    fail("decode-locality-gate-aggregator: a compact R2A document entered the decode gate")

# A refused document is refused on its own diagnostic. `main --expert-trace` writes a document
# with `status: "error"`, an `error_code`, and null `moe` fields, so a gate that derived the router
# shape before checking the status would report "n_expert is null" and hide the real reason.
refused, _ = built_decode_document([0] * 6, prefill_tokens=4, decode_graphs=3)
refused["status"] = "error"
refused["error_code"] = "R2_TOKEN_COUNT"
refused["moe"] = {"present": False, "n_expert": None, "n_expert_used": None,
                  "n_expert_source": None, "topk_layers": [], "token_reduced_layers": [],
                  "slots_truncated": None}
try:
    aggregate_decode([refused], ["refused"])
except GateError as error:
    if "R2_TOKEN_COUNT" not in str(error):
        fail("decode-locality-gate-aggregator: a refused document reported %r rather than its "
             "own error code" % error)
else:
    fail("decode-locality-gate-aggregator: a refused document entered the decode gate")

# A truncated token axis would make an "adjacency" a jump across hidden positions.
truncated_document, _ = built_decode_document([0] * 6, prefill_tokens=4, decode_graphs=3)
truncated_document["graphs"][0]["tokens_truncated"] = True
try:
    require_full_router_axes([truncated_document], ["truncated"])
except GateError as error:
    if "truncated token axis" not in str(error):
        fail("decode-locality-gate-aggregator: truncation refusal has the wrong diagnostic %r"
             % error)
else:
    fail("decode-locality-gate-aggregator: a truncated token axis entered the decode gate")

# The null is a constant of the router shape. With every slot printed there is only one null left:
# the compact gate's smaller printed-subset null has no counterpart here, and the 1.5 x threshold
# is 188 per mille -- ceil(3 * 125 / 2), the smallest integer per mille that satisfies
# `p^ * 2 >= null * 3`, which the floor of that quotient misses by one. Asserting both is what
# makes every ratio below meaningful.
memoryless = decode_case("memoryless",
                         [built_decode_document([0] * 20, prefill_tokens=5, decode_graphs=16)
                          for _ in range(6)],
                         null_per_mille=125, threshold_per_mille=188,
                         observed_slots_per_token=8, n_expert=64, n_expert_used=8,
                         ambiguous_pairs=0)
# All three arms must exist before any of them can be judged: an adjacency rule that lost the
# cross-graph pair, or a phase rule that folded the boundary into a neighbour, would leave an arm
# empty rather than wrong, and an empty arm is not a NO_LOCALITY verdict.
missing = [name for name in ("prefill", "decode", "boundary")
           if memoryless["phases"][name] is None]
if missing:
    fail("decode-locality-gate-aggregator: the %s arm(s) observed no pair at all"
         % ", ".join(missing))
for name in ("prefill", "decode", "boundary"):
    if memoryless["phases"][name]["verdict"] != "NO_LOCALITY":
        fail("decode-locality-gate-aggregator: a memoryless router scored %s on the %s arm"
             % (memoryless["phases"][name]["verdict"], name))
if memoryless["graph_counts"] != {"prefill": 6, "decode": 96, "single_token_first_graph": 0}:
    fail("decode-locality-gate-aggregator: the graph phases were not carried through: %r"
         % memoryless["graph_counts"])
# Four layers, 4 prefill pairs, 1 boundary pair, and 15 decode pairs per document.
if (memoryless["phases"]["prefill"]["adjacent_pair_count"],
        memoryless["phases"]["boundary"]["adjacent_pair_count"],
        memoryless["phases"]["decode"]["adjacent_pair_count"]) != (96, 24, 360):
    fail("decode-locality-gate-aggregator: the pairs were partitioned as %r"
         % [memoryless["phases"][name]["adjacent_pair_count"]
            for name in ("prefill", "decode", "boundary")])

# Phase isolation, in all three directions. An effect confined to one arm must appear in that arm
# and in neither of the others, or the gate is measuring one thing and reporting three.
decode_case("sticky-decode",
            [built_decode_document([0] * 5 + [8] * 15, prefill_tokens=5, decode_graphs=16)
             for _ in range(6)],
            **{"phases.decode.verdict": "LOCALITY", "phases.decode.reuse_per_mille": 1000,
               "phases.decode.layers_clearing_null": 4,
               "phases.prefill.verdict": "NO_LOCALITY", "phases.prefill.reuse_per_mille": 0,
               "phases.boundary.verdict": "NO_LOCALITY", "phases.boundary.reuse_per_mille": 0})
decode_case("sticky-prefill",
            [built_decode_document([8] * 4 + [0] * 16, prefill_tokens=5, decode_graphs=16)
             for _ in range(6)],
            **{"phases.prefill.verdict": "LOCALITY", "phases.prefill.reuse_per_mille": 1000,
               "phases.decode.verdict": "NO_LOCALITY", "phases.decode.reuse_per_mille": 0,
               "phases.boundary.verdict": "NO_LOCALITY", "phases.boundary.reuse_per_mille": 0})
# The boundary pair is exactly one pair per document and layer: the last prompt token against the
# first generated token. If it were folded into either neighbour, this case would move two arms.
decode_case("sticky-boundary",
            [built_decode_document([0] * 4 + [8] + [0] * 15, prefill_tokens=5, decode_graphs=16)
             for _ in range(6)],
            **{"phases.boundary.verdict": "LOCALITY", "phases.boundary.reuse_per_mille": 1000,
               "phases.boundary.adjacent_pair_count": 24,
               "phases.boundary.reuse_denominator": 192,
               "phases.prefill.verdict": "NO_LOCALITY", "phases.prefill.reuse_per_mille": 0,
               "phases.decode.verdict": "NO_LOCALITY", "phases.decode.reuse_per_mille": 0})

# Detectable but immaterial: alternating 1 and 2 shared experts of 8 is 187 per mille over 4,096
# trials, one per mille *below* the 188 the materiality half needs (`p^ * 2 >= null * 3` is
# `p^ >= 187.5`), while the interval is well clear of 125. Only a conjunction can call this
# NO_LOCALITY, and only the correct boundary: at the floored threshold of 187 this case would pass.
decode_case("decode-half-detectable",
            [built_decode_document([0] * 5 + [1, 2] * 8, prefill_tokens=5, decode_graphs=17)
             for _ in range(8)],
            **{"phases.decode.verdict": "NO_LOCALITY", "phases.decode.excludes_null": True,
               "phases.decode.materially_above_null": False,
               "phases.decode.reuse_per_mille": 187, "threshold_per_mille": 188})
# The other side of the same boundary, one per mille up: seven prompts at 24 shared experts per
# decode chain and one at 25 is 772 / 4,096 = 188 per mille, the smallest value the materiality
# half accepts. A threshold or a comparison off by one in either direction moves exactly one of
# these two cases, so the pair pins the boundary rather than one side of it.
decode_case("decode-half-material-boundary",
            [built_decode_document([0] * 5 + [1, 2] * 8, prefill_tokens=5, decode_graphs=17)
             for _ in range(7)]
            + [built_decode_document([0] * 5 + [1, 2] * 7 + [1, 3], prefill_tokens=5,
                                     decode_graphs=17)],
            **{"phases.decode.verdict": "LOCALITY", "phases.decode.excludes_null": True,
               "phases.decode.materially_above_null": True,
               "phases.decode.reuse_per_mille": 188,
               "phases.decode.reuse_numerator": 772,
               "phases.decode.reuse_denominator": 4096,
               "threshold_per_mille": 188})

# Material but uncertain: two decode pairs in one document at 2 of 8 shared is 250 per mille, twice
# the null, but sixteen trials cannot exclude it. Only a nonzero z can call this NO_LOCALITY: at
# z = 0 the interval collapses onto p^ and clears.
half_material = decode_case("decode-half-material",
                            [built_decode_document([0, 0, 2, 2], prefill_tokens=2,
                                                   decode_graphs=3, layers=1)],
                            **{"phases.decode.verdict": "NO_LOCALITY",
                               "phases.decode.materially_above_null": True,
                               "phases.decode.excludes_null": False,
                               "phases.decode.reuse_per_mille": 250,
                               "phases.decode.reuse_numerator": 4,
                               "phases.decode.reuse_denominator": 16})
if half_material["phases"]["decode"]["cluster_low_per_mille"] > 125:
    fail("decode-locality-gate-aggregator: a sixteen-trial interval excluded the null")

# Clustering, which the naive interval cannot see: two prompts whose decode is perfectly sticky and
# four whose decode is memoryless. The pooled point estimate is decisive and the Wilson interval
# agrees, but the effect lives entirely between prompts and the cluster-robust bound must not.
between = decode_case("decode-between-prompt",
                      [built_decode_document([0] * 5 + [8] * 15, prefill_tokens=5,
                                             decode_graphs=16) for _ in range(2)]
                      + [built_decode_document([0] * 20, prefill_tokens=5, decode_graphs=16)
                         for _ in range(4)],
                      **{"phases.decode.verdict": "NO_LOCALITY",
                         "phases.decode.materially_above_null": True,
                         "phases.decode.excludes_null": False,
                         "phases.decode.reuse_per_mille": 333, "phases.decode.cluster_count": 6})
if not (between["phases"]["decode"]["wilson_low_per_mille"] > 125
        >= between["phases"]["decode"]["cluster_low_per_mille"]):
    fail("decode-locality-gate-aggregator: the clustered bound did not overturn Wilson: %r"
         % between["phases"]["decode"])

# The repetition arm. Greedy decode can fall into a loop whose adjacent tokens are the same token,
# and the experts of one token are trivially the experts of the same token. Each of these six
# prompts loops for its first eight generated tokens and then emits distinct ones, so the pooled
# decode arm finds LOCALITY, the loop is measured rather than assumed, and excluding exactly the
# repeating pairs must take the whole effect away.
loop_shares = [0] * 5 + [8] * 7 + [0] * 8
loop_marks = ["p%d" % index for index in range(5)] + ["loop"] * 8 + ["g%d" % index
                                                                    for index in range(8)]
degenerate = decode_case("decode-repetition",
                         [built_decode_document(loop_shares, prefill_tokens=5, decode_graphs=16,
                                                marks=loop_marks) for _ in range(6)],
                         **{"phases.decode.verdict": "LOCALITY",
                            "phases.decode.reuse_per_mille": 466,
                            "repetition.pooled.decode.repeated": 42,
                            "repetition.pooled.decode.pairs": 90,
                            "repetition.pooled.decode.repetition_per_mille": 466,
                            "repetition.pooled.prefill.repeated": 0,
                            "repetition.pooled.boundary.repeated": 0,
                            "excluding_repeats.dropped_pairs.decode": 168,
                            "excluding_repeats.dropped_pairs.prefill": 0,
                            "excluding_repeats.dropped_pairs.boundary": 0,
                            "excluding_repeats.unknown_pairs": 0,
                            "excluding_repeats.phases.decode.verdict": "NO_LOCALITY",
                            "excluding_repeats.phases.decode.reuse_per_mille": 0})
if degenerate["repetition"]["per_document"][0]["distinct_generated_tokens"] != 9:
    fail("decode-locality-gate-aggregator: the distinct generated token count is %r"
         % degenerate["repetition"]["per_document"][0])

# A fingerprint that is absent on one side keeps its pair rather than dropping it silently.
partial_documents = [built_decode_document(loop_shares, prefill_tokens=5, decode_graphs=16,
                                           marks=loop_marks) for _ in range(6)]
del partial_documents[0][1][(7, 0)]
decode_case("decode-repetition-unknown", partial_documents,
            **{"excluding_repeats.unknown_pairs": 8,
               "excluding_repeats.dropped_pairs.decode": 160})

# Working sets are recomputed over the sequence, so a decode window of eight positions exists even
# though every decode graph holds one token and the document's own windows never cross a graph.
sticky_windows = decode_case("decode-working-set",
                             [built_decode_document([0] * 5 + [8] * 15, prefill_tokens=5,
                                                    decode_graphs=16)])
windows = {row["window"]: row for row in sticky_windows["working_set"]["decode"]}
if windows[8]["sample_count"] != 36 or windows[8]["unique_mean_per_mille"] != 8000:
    fail("decode-locality-gate-aggregator: the sticky w=8 decode window is %r" % windows[8])
if windows[8]["null_unique_mean_per_mille"] <= windows[8]["unique_mean_per_mille"]:
    fail("decode-locality-gate-aggregator: the w=8 null is not above a perfectly sticky router")
prefill_windows = {row["window"]: row for row in sticky_windows["working_set"]["prefill"]}
if prefill_windows[8]["sample_count"] or prefill_windows[4]["sample_count"] != 8:
    fail("decode-locality-gate-aggregator: the prefill windows are %r" % prefill_windows)

# Correction 20's token-reduced layer, at the real model's shape: 16 layers, layer 15 reduced out
# of the prefill graph and present in every one-token decode graph. Its chain therefore begins at
# the first decode graph, so its first pair is a decode pair and it contributes no prefill or
# boundary pair at all. That is the whole reason the real capture reports 16 decode layers against
# 15 prefill ones, and without it the fixture corpus could not tell the two counts apart.
reduced_tail = decode_case("decode-token-reduced-tail",
                           [built_decode_document([0] * 5 + [8] * 15, prefill_tokens=5,
                                                  decode_graphs=16, layers=16,
                                                  token_reduced_layer=15) for _ in range(6)],
                           token_reduced_layers=[15], documents_token_reduced=6,
                           **{"phases.prefill.layer_count": 15,
                              "phases.boundary.layer_count": 15,
                              "phases.decode.layer_count": 16,
                              "phases.decode.layers_clearing_null": 16})
tail_rows = {row["layer"]: row for row in reduced_tail["phases"]["decode"]["per_layer"]}
if 15 not in tail_rows or tail_rows[15]["adjacent_pair_count"] != 90:
    fail("decode-locality-gate-aggregator: the token-reduced layer's decode pairs are %r"
         % tail_rows.get(15))
for arm in ("prefill", "boundary"):
    if any(row["layer"] == 15 for row in reduced_tail["phases"][arm]["per_layer"]):
        fail("decode-locality-gate-aggregator: the token-reduced layer reached the %s arm" % arm)

# A hole in one layer's chain is not an adjacency. The working-set windows are recomputed over the
# sequence, so a layer missing from one middle graph must break its run there rather than union
# across the gap: layer 1 here has no group in decode graph 3, which leaves it a run of two and a
# run of thirteen instead of one run of sixteen.
gapped = decode_case("decode-chain-gap",
                     [built_decode_document([0] * 5 + [8] * 15, prefill_tokens=5, decode_graphs=16,
                                            omit=((3, 1),))],
                     **{"phases.decode.adjacent_pair_count": 58,
                        "phases.prefill.adjacent_pair_count": 16,
                        "phases.boundary.adjacent_pair_count": 4})
gap_windows = {row["window"]: row["sample_count"]
               for row in gapped["working_set"]["decode"]}
if gap_windows != {1: 63, 2: 58, 4: 49, 8: 33}:
    fail("decode-locality-gate-aggregator: the gapped decode windows are %r; breaking the run at "
         "the hole gives {1: 63, 2: 58, 4: 49, 8: 33} and unioning across it gives "
         "{1: 63, 2: 59, 4: 51, 8: 35}" % gap_windows)

# The materiality half is "at least half again the null", and at this null the boundary is an
# integer: 16 of 64 makes p0 250 per mille and 1.5 x p0 exactly 375, which the rule must accept.
# The 125 per mille null can never land on that point, so without a second router shape the
# difference between `>=` and `>` is unobservable and the shipped contract is not pinned.
decode_case("decode-materiality-exact",
            [built_decode_document([0] * 5 + [6] * 15, prefill_tokens=5, decode_graphs=16,
                                   used=16) for _ in range(6)],
            null_per_mille=250, threshold_per_mille=375,
            **{"phases.decode.verdict": "LOCALITY",
               "phases.decode.reuse_per_mille": 375,
               "phases.decode.materially_above_null": True,
               "phases.decode.excludes_null": True})

# A one-token first graph is neither prefill nor decode (`docs/specs/r2a-expert-trace.md` section
# 2.5.6), so its pairs are counted as ambiguous and reach no arm.
ambiguous = decode_case("decode-single-token-first",
                        [built_decode_document([8] * 3, prefill_tokens=1, decode_graphs=3)],
                        ambiguous_pairs=4)
if ambiguous["phases"]["prefill"] is not None or ambiguous["phases"]["boundary"] is not None:
    fail("decode-locality-gate-aggregator: a single-token first graph produced a prefill arm")
if ambiguous["graph_counts"]["single_token_first_graph"] != 1:
    fail("decode-locality-gate-aggregator: the single-token first graph was not counted")

# A parser `locality` that disagrees with a recomputation from the same `selections[]` is an
# instrument problem on the one arm where the two definitions coincide, and the gate must refuse.
disagreeing, _ = built_decode_document([0] * 6, prefill_tokens=4, decode_graphs=3)
disagreeing["locality"]["phase_split"]["prefill"]["reuse_numerator"] += 1
try:
    aggregate_decode([disagreeing], ["disagreeing"])
except GateError as error:
    if "disagrees with the parser" not in str(error):
        fail("decode-locality-gate-aggregator: the cross-check diagnostic is %r" % error)
else:
    fail("decode-locality-gate-aggregator: a parser/recomputation disagreement was not refused")

# The token fingerprints, read from an entry `embd` block the way the runner reads them. Two
# positions carry the same token exactly when their printed rows are identical.
transcript = [
    "common_debug_cb_eval:  embd = (f32) GET_ROWS(token_embd.weight{2048, 50304, 1, 1}, "
    "inp_tokens{2, 1, 1, 1}}) = {2048, 2, 1, 1}\n",
    "    [\n",
    "        [\n",
    "            [     -0.0141,       0.0051,      -0.0013,    ...,       0.0097  ],\n",
    "            [      0.0052,       0.0034,      -0.0094,    ...,       0.0016  ],\n",
    "        ],\n",
    "    ]\n",
    "    sum = 0.794289\n",
    "common_debug_cb_eval:  norm-0 = (f32) RMS_NORM(embd{2048, 2, 1, 1}, }) = {2048, 2, 1, 1}\n",
    "    [\n",
    "        [\n",
    "            [      9.9999,       9.9999,       9.9999,    ...,       9.9999  ],\n",
    "        ],\n",
    "    ]\n",
    "    sum = 1.0\n",
    "common_debug_cb_eval:  embd = (f32) GET_ROWS(token_embd.weight{2048, 50304, 1, 1}, "
    "inp_tokens{1, 1, 1, 1}}) = {2048, 1, 1, 1}\n",
    "    [\n",
    "        [\n",
    "            [      0.0052,       0.0034,      -0.0094,    ...,       0.0016  ],\n",
    "        ],\n",
    "    ]\n",
    "    sum = 0.1\n",
    # The `sum =` line is the block terminator, and the last block in a transcript is the case that
    # needs it: after the final callback the instrument prints the generated continuation, and this
    # corpus is code, so a generated line can look exactly like a printed tensor row. Without the
    # terminator the line below would be read as a second embedding row of a one-token graph.
    "\n",
    "def build():\n",
    "    return [\n",
    "        [      0.0052,       0.0034,      -0.0094,    ...,       0.0016  ],\n",
    "    ]\n",
]
blocks = entry_token_fingerprints(transcript)
if [len(block) for block in blocks] != [2, 1]:
    fail("decode-locality-gate-aggregator: the entry blocks are %r (a block that did not end at "
         "its `sum =` line reads the generated text as a token row)" % blocks)
if blocks[0][1] != blocks[1][0] or blocks[0][0] == blocks[0][1]:
    fail("decode-locality-gate-aggregator: the fingerprints do not identify the repeated token")
if any("RMS_NORM" in "".join(block) or "9.9999" in "".join(block) for block in blocks):
    fail("decode-locality-gate-aggregator: a non-entry tensor was read as a token")

# The caveats are printed with every result, and the corpus-dependent one is bound to the run that
# was actually measured: a hard-coded "6 tokens or fewer" is false the moment
# `ALIGN_LLM_LOCALITY_PROMPTS` names another corpus.
if len(DECODE_CAVEATS) < 5:
    fail("decode-locality-gate-aggregator: the decode caveats went missing")
if reduced_tail["max_prompt_tokens"] != 5:
    fail("decode-locality-gate-aggregator: the longest prompt is %r"
         % reduced_tail["max_prompt_tokens"])
bound_caveats = decode_caveats(reduced_tail)
if not any("longest prompt is 5 token(s)" in caveat for caveat in bound_caveats):
    fail("decode-locality-gate-aggregator: the short-context caveat was not bound to the corpus: "
         "%r" % (bound_caveats,))
if any("{max_prompt_tokens}" in caveat for caveat in bound_caveats):
    fail("decode-locality-gate-aggregator: a caveat placeholder survived binding")
# --- decode-locality-gate hand-built cases (end) ---

print("expert trace smoke: %d fixtures, %d error codes, the real build-10566 excerpt, both CLI "
      "forms, the aggregate oracle, the locality-gate aggregator, the decode-locality-gate "
      "aggregator, and CLI arity/isolation PASS"
      % (checked, len(codes_seen)))
PY

# A bounded descriptor budget: one derivation opens one transcript descriptor and nothing else.
(
  ulimit -n 64
  "$root_dir/main" --expert-trace "$fixture_dir/dense-L28-T64.txt" >/dev/null
  "$root_dir/main" --expert-trace "$fixture_dir/multi-graph.txt" >/dev/null
)

# The generator runs with the repository root as cwd and receives `fixture_dir`. A dropped fixture
# argument can therefore leak its root `manifest.json`; an unrelated tracked manifest in a consumer
# corpus is not this generator's output.
leaked=""
if [ -e "$root_dir/manifest.json" ] || [ -L "$root_dir/manifest.json" ]; then
  leaked="$root_dir/manifest.json"
fi
if [ -n "$leaked" ]; then
  printf '%s\n' "expert trace smoke: a fixture leaked into the repository:" >&2
  printf '%s\n' "$leaked" >&2
  exit 1
fi
if [ ! -d "$temp_dir" ]; then
  printf '%s\n' "expert trace smoke: the temporary fixture root vanished mid-run" >&2
  exit 1
fi

printf '%s\n' "expert trace smoke: the build-10566 grammar, graph segmentation, the truncation rule, the selection table, the locality aggregates, the malformed corpora, the window-boundary and huge-line corpora, and CLI arity/isolation PASS"
