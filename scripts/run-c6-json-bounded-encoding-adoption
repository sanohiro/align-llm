#!/usr/bin/env bash

set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
compiler="${ALIGNC:-${project_root}/scripts/alignc}"
fixture="${project_root}/eval/fixtures/c6-prompt-artifacts/prompt-variant.json"
output_file="$(mktemp)"
trap 'rm -f "${output_file}"' EXIT

"${compiler}" run "${project_root}/src/c6_json_bounded_encoding_adoption.align" "${fixture}" >"${output_file}"

python3 - "${output_file}" <<'PY'
import sys
from pathlib import Path

actual = Path(sys.argv[1]).read_text(encoding="utf-8").splitlines()
expected = ["OK", "ERROR", "OK", "ERROR", "831"]
if actual != expected:
    raise SystemExit(f"bounded encoding adoption mismatch: {actual!r}")
print("c6 json bounded canonical encoding and malformed-input adoption: PASS")
PY
