#!/usr/bin/env bash

set -euo pipefail

# R4.5-EXTERNAL-BUFFER-SPIKE shim builder (`docs/specs/r4-5-external-buffer.md` section 3.2).
#
# One library, `libalign_ggml_shim`, built from one of two checked-in C files and nothing else:
#
#   ALIGN_LLM_GGML_INCLUDE set -> scripts/ggml_shim.c      (compiled against that include tree)
#   ALIGN_LLM_GGML_INCLUDE unset -> scripts/ggml_shim_stub.c  (ggml-free, links nothing)
#
# There is no third state and no probing of `/opt/homebrew`, because a build input that changes with
# the contents of a directory is not reproducible.
#
#   ALIGN_LLM_GGML_INCLUDE  directory holding `ggml.h` and `ggml-backend.h`  (selects the real shim)
#   ALIGN_LLM_GGML_LIB      directory holding `libggml` and `libggml-base`   (real shim only)
#   ALIGN_LLM_GGML_FORCE    the section 4.6 forced-failure builds. `init`, `compute`, and
#                           `reference` need the real shim; `engine`, `engine+init`,
#                           `engine+alloc`, `engine+compute`, `engine+reference`,
#                           `engine+slot-range`, `engine+slot-empty`,
#                           `engine+no-mark-output`, `engine+pad-negative`, and
#                           `engine+pad-oversize` select the ggml-free deterministic engine of
#                           `docs/specs/r5a-dense-layer-forward.md` section 5.1 and need the stub
#   ALIGN_LLM_GGML_SHIM_DIR output directory; defaults to `build/lib` inside the work tree
#   CC                      C compiler; defaults to `cc`
#
# **Toolchain assumption, stated rather than assumed.** A working `cc` on `PATH` is already a
# prerequisite of this repository: `alignc` links every executable through it, so `make build` does
# not work without one and neither does any hosted target. This script needs nothing beyond that —
# a freestanding C compiler, `-shared`, and libc headers. `scripts/ggml_shim_stub.c` includes only
# `<math.h>`, `<stddef.h>`, `<stdint.h>`, and `<string.h>` and links only libm;
# `scripts/ggml_shim.c` additionally needs the ggml headers the
# caller names, and is never built on a host that does not name them. Both files compile clean under
# `-Wall -Wextra -Werror` with Apple clang 21 and Homebrew LLVM 19, 21, and 22.
#
# The output goes to `build/lib/` by default, which `.gitignore` excludes: no binary is ever
# committed. The
# shim's install name / soname is its own absolute path, so an executable linked against it resolves
# it at run time without `DYLD_LIBRARY_PATH` or `LD_LIBRARY_PATH` — the two runners set them anyway,
# because a relocated build directory is a worse failure than a redundant variable.
#
# It prints one line, the directory the library was written to, so a caller can put it on
# `LIBRARY_PATH` without knowing this script's layout.

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
# `build/` is the ordinary destination and is `.gitignore`d. `ALIGN_LLM_GGML_SHIM_DIR` moves the
# library out of the work tree entirely, which is what `scripts/run-ggml-spike-smoke` does: the
# fresh worker permits the aggregate to leave exactly one file, `main`, in `/workspace`
# (`scripts/fresh-align-compiler`), so an aggregate member may not write a build artifact there.
out_dir="${ALIGN_LLM_GGML_SHIM_DIR:-${root_dir}/build/lib}"
compiler="${CC:-cc}"

# The platform test is bash's own `OSTYPE`, not `uname`. The fresh worker image ships a curated
# tool set (`image/fresh/Dockerfile`) that has no `uname`, and this script runs inside that image
# as part of `ggml-spike-smoke`; a shell variable needs no tool at all.
case "${OSTYPE:-}" in
  darwin*) suffix=dylib ;;
  *)       suffix=so ;;
esac
library="${out_dir}/libalign_ggml_shim.${suffix}"

source_file="${root_dir}/scripts/ggml_shim_stub.c"
flavour=stub
include_flags=()
link_flags=()
if [ -n "${ALIGN_LLM_GGML_INCLUDE:-}" ]; then
  if [ ! -d "${ALIGN_LLM_GGML_INCLUDE}" ]; then
    printf '%s\n' "build-ggml-shim: ALIGN_LLM_GGML_INCLUDE is not a directory: ${ALIGN_LLM_GGML_INCLUDE}" >&2
    exit 1
  fi
  if [ ! -f "${ALIGN_LLM_GGML_INCLUDE}/ggml.h" ] || [ ! -f "${ALIGN_LLM_GGML_INCLUDE}/ggml-backend.h" ]; then
    printf '%s\n' "build-ggml-shim: ggml.h and ggml-backend.h are not in ${ALIGN_LLM_GGML_INCLUDE}" >&2
    exit 1
  fi
  source_file="${root_dir}/scripts/ggml_shim.c"
  flavour=real
  include_flags=("-I${ALIGN_LLM_GGML_INCLUDE}")
  if [ -n "${ALIGN_LLM_GGML_LIB:-}" ]; then
    link_flags=("-L${ALIGN_LLM_GGML_LIB}")
  fi
  link_flags+=("-lggml" "-lggml-base")
  # Section 4.6's named mechanism for the three failures no input can produce. Only the real shim
  # honours it, and only when the qualification asks: an ordinary build never defines a macro.
  case "${ALIGN_LLM_GGML_FORCE:-}" in
    "") ;;
    init)      include_flags+=("-DALIGN_GGML_FORCE_INIT_FAILURE=1"); flavour="real+force-init" ;;
    compute)   include_flags+=("-DALIGN_GGML_FORCE_COMPUTE_FAILURE=1"); flavour="real+force-compute" ;;
    reference) include_flags+=("-DALIGN_GGML_FORCE_REFERENCE_PERTURBATION=1")
               flavour="real+force-reference" ;;
    # R5C-METAL-PREFILL-ARM section 4.5, against a **real** device. Both new device conditions are
    # stub-reachable, and these two builds let `metal-forward-qualification` reach them against the
    # linked ggml as well, so the guard that stands between an oversize wrap and a `SIGSEGV`
    # (section 2.6) is exercised on the device it protects.
    max-buffer) include_flags+=("-DALIGN_GGML_FORCE_MAX_BUFFER_SIZE=1024")
               flavour="real+force-max-buffer" ;;
    no-host-ptr) include_flags+=("-DALIGN_GGML_FORCE_NO_HOST_PTR=1")
               flavour="real+force-no-host-ptr" ;;
    *)
      printf '%s\n' "build-ggml-shim: unknown ALIGN_LLM_GGML_FORCE=${ALIGN_LLM_GGML_FORCE}" >&2
      exit 1
      ;;
  esac
else
  # The stub's own forced builds. `engine` turns on the deterministic single-precision engine of
  # `docs/specs/r5a-dense-layer-forward.md` section 5.1, which is what makes steps 18 to 29 — and
  # therefore both oracle verdicts and fourteen more error codes — reachable on a host with no
  # ggml, no model, and no llama.cpp. The default stub is unchanged and remains unavailable.
  engine="-DALIGN_GGML_STUB_ENGINE=1"
  case "${ALIGN_LLM_GGML_FORCE:-}" in
    "") ;;
    engine)            include_flags+=("${engine}"); flavour="stub+engine" ;;
    engine+init)       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_INIT_FAILURE=1")
                       flavour="stub+engine+force-init" ;;
    engine+alloc)      include_flags+=("${engine}" "-DALIGN_GGML_FORCE_ALLOC_FAILURE=1")
                       flavour="stub+engine+force-alloc" ;;
    engine+compute)    include_flags+=("${engine}" "-DALIGN_GGML_FORCE_COMPUTE_FAILURE=1")
                       flavour="stub+engine+force-compute" ;;
    engine+reference)  include_flags+=("${engine}" "-DALIGN_GGML_FORCE_REFERENCE_PERTURBATION=1")
                       flavour="stub+engine+force-reference" ;;
    engine+slot-range) include_flags+=("${engine}" "-DALIGN_GGML_FORCE_SLOT_RANGE=1")
                       flavour="stub+engine+force-slot-range" ;;
    engine+slot-empty) include_flags+=("${engine}" "-DALIGN_GGML_FORCE_SLOT_EMPTY=1")
                       flavour="stub+engine+force-slot-empty" ;;
    engine+slot-empty-pos)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_SLOT_EMPTY_POS=1")
                       flavour="stub+engine+force-slot-empty-pos" ;;
    engine+no-mark-output)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_NO_MARK_OUTPUT=1")
                       flavour="stub+engine+force-no-mark-output" ;;
    engine+pad-negative)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_PAD_NEGATIVE=1")
                       flavour="stub+engine+force-pad-negative" ;;
    engine+short-readback)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_SHORT_READBACK=1")
                       flavour="stub+engine+force-short-readback" ;;
    engine+pad-oversize)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_PAD_OVERSIZE=1")
                       flavour="stub+engine+force-pad-oversize" ;;
    # R5C-METAL-PREFILL-ARM (`docs/specs/r5c-metal-prefill.md` sections 4.5 and 5.1). The stub has
    # no GPU device by default, which is what makes `R5C_GPU_UNAVAILABLE` the GPU arm's hosted
    # baseline; `engine+gpu` gives it one so the arm's whole successful path is reachable hosted,
    # and the two `gpu+...` builds reach the other two new codes. All three are stub-reachable, so
    # the GPU arm's own failure surface is fully covered on a host with no GPU.
    engine+gpu)        include_flags+=("${engine}" "-DALIGN_GGML_STUB_GPU=1")
                       flavour="stub+engine+gpu" ;;
    engine+gpu+no-host-ptr)
                       include_flags+=("${engine}" "-DALIGN_GGML_STUB_GPU=1"
                                       "-DALIGN_GGML_FORCE_NO_HOST_PTR=1")
                       flavour="stub+engine+gpu+force-no-host-ptr" ;;
    engine+gpu+max-buffer)
                       include_flags+=("${engine}" "-DALIGN_GGML_STUB_GPU=1"
                                       "-DALIGN_GGML_FORCE_MAX_BUFFER_SIZE=1024")
                       flavour="stub+engine+gpu+force-max-buffer" ;;
    engine+gpu+compute)
                       include_flags+=("${engine}" "-DALIGN_GGML_STUB_GPU=1"
                                       "-DALIGN_GGML_FORCE_COMPUTE_FAILURE=1")
                       flavour="stub+engine+gpu+force-compute" ;;
    # R5C section 6, correction C19. A non-finite **computed** activation, which no operand can
    # produce: the first element of every readback is `+inf` and the tensor data is untouched. It is
    # what makes the transcript oracle's saturating conversion and the logits comparison's
    # non-finite *primary* branch reachable hosted, on both arms.
    engine+moe-slot-empty)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_SLOT_EMPTY_MOE=1")
                       flavour="stub+engine+force-moe-slot-empty" ;;
    engine+moe-reference)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_REFERENCE_PERTURBATION_MOE=1")
                       flavour="stub+engine+force-moe-reference" ;;
    engine+moe-argsort-range)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_ARGSORT_RANGE=1")
                       flavour="stub+engine+force-moe-argsort-range" ;;
    engine+moe-argsort-repeat)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_ARGSORT_REPEAT=1")
                       flavour="stub+engine+force-moe-argsort-repeat" ;;
    engine+moe-argsort-order)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_ARGSORT_ORDER=1")
                       flavour="stub+engine+force-moe-argsort-order" ;;
    engine+moe-view-extent)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_VIEW_EXTENT=1")
                       flavour="stub+engine+force-moe-view-extent" ;;
    # R5E-MOE-MODEL-PREFILL (`docs/specs/r5e-moe-model-prefill.md` section 4.5). Two carried
    # lengths no input can produce, because both come from the same node table: the routed layer's
    # `l_out` under-reported by one element, which makes the residual invariant refuse for real, and
    # the phase-A `ffn_norm` under-reported by one, which makes `R5E_CARRY`'s length arm reachable.
    engine+moe-residual-short)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_MOE_RESIDUAL_SHORT=1")
                       flavour="stub+engine+force-moe-residual-short" ;;
    engine+moe-carry-short)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_MOE_CARRY_SHORT=1")
                       flavour="stub+engine+force-moe-carry-short" ;;
    engine+inf-readback)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_INF_READBACK=1")
                       flavour="stub+engine+force-inf-readback" ;;
    engine+gpu+inf-readback)
                       include_flags+=("${engine}" "-DALIGN_GGML_STUB_GPU=1"
                                       "-DALIGN_GGML_FORCE_INF_READBACK=1")
                       flavour="stub+engine+gpu+force-inf-readback" ;;
    # R6-DECODE-KV-STEP1 (`docs/specs/r6-decode-kv-step1.md` section 4.5). The decode table names
    # K's column axis 1 and V's axis 0, so `align_ggml_op_concat`'s axis-mismatch refusal is not
    # producible from any operand this arm accepts. The build flips the axis inside the shim, which
    # is what makes `ALIGN_GGML_SHAPE` a run rather than an argument.
    engine+concat-axis)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_CONCAT_AXIS=1")
                       flavour="stub+engine+force-concat-axis" ;;
    # The other three R6 conditions no operand can produce, each keyed on one slot the decode graph
    # alone writes (`docs/specs/r6-decode-kv-step1.md` sections 4.2 and 11.1). `plane-stage-offset`
    # shifts the staged past K by one lane and is the shipped regression for `R6_PLANE_MISMATCH`;
    # `decode-position` ropes the decoded token at position 0; `mask-offset` masks the decoded
    # token's own column. The last two are oracle A's own regressions, which until now existed only
    # as source mutations recorded in a table.
    engine+plane-stage-offset)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_PLANE_STAGE_OFFSET=1")
                       flavour="stub+engine+force-plane-stage-offset" ;;
    engine+decode-position)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_DECODE_POSITION=1")
                       flavour="stub+engine+force-decode-position" ;;
    engine+mask-offset)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_MASK_OFFSET=1")
                       flavour="stub+engine+force-mask-offset" ;;
    # R6-STEP-N (`docs/specs/r6-step-n.md` sections 4.1 and 4.2). The two conditions the step axis
    # adds and no operand can produce: a compute failure at a chosen **step** index rather than a
    # chosen graph, and a write-back that lands one lane off. `compute-step2` keys on the past-K
    # upload growing, so it fires at step 2 and not step 1; `writeback-offset` keys on the one-column
    # shape of the decode graph's post-RoPE K, so it perturbs the column the step just wrote and
    # nothing else, and oracle B names that column.
    engine+compute-step2)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_COMPUTE_STEP2=1")
                       flavour="stub+engine+force-compute-step2" ;;
    engine+writeback-offset)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_WRITEBACK_OFFSET=1")
                       flavour="stub+engine+force-writeback-offset" ;;
    # R6-OLMOE-DECODE (`docs/specs/r6-olmoe-decode.md` section 5.6). The routed counterparts of the
    # three builds above whose dense form is keyed on a **slot number**: the routed arm's position,
    # mask and post-RoPE K live at `layer_olmoe`'s slots, which are ordinary weight slots in a dense
    # graph. They are separate builds rather than second indices on the dense ones, so every dense
    # build stays behaviourally byte-unchanged and the sixth block's goldens cannot move for a
    # capability that changes no dense behaviour. `plane-stage-offset` and `compute-step2` need no
    # counterpart: both key on the past-K slot, which is `layer_qwen2`'s 64 on one arm and
    # `layer_olmoe`'s 126 on the other and is written by no other graph on either.
    engine+decode-position-moe)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_DECODE_POSITION_MOE=1")
                       flavour="stub+engine+force-decode-position-moe" ;;
    engine+mask-offset-moe)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_MASK_OFFSET_MOE=1")
                       flavour="stub+engine+force-mask-offset-moe" ;;
    engine+writeback-offset-moe)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_WRITEBACK_OFFSET_MOE=1")
                       flavour="stub+engine+force-writeback-offset-moe" ;;
    # R6-RESIDENT-WEIGHTS section 5.1's early-exit cell. `buffer_from_host` refuses, which is the
    # only input-reachable way to reach a resident run whose arena is filled and live and whose wrap
    # does not exist — the exact shape of the run-scope balance invariant's failure path.
    engine+resident-wrap)
                       include_flags+=("${engine}" "-DALIGN_GGML_FORCE_HOST_WRAP_FAILURE=1")
                       flavour="stub+engine+force-resident-wrap" ;;
    *)
      printf '%s\n' "build-ggml-shim: unknown stub ALIGN_LLM_GGML_FORCE=${ALIGN_LLM_GGML_FORCE}" >&2
      exit 1
      ;;
  esac
  link_flags+=("-lm")
fi

if ! command -v "${compiler}" >/dev/null 2>&1; then
  printf '%s\n' "build-ggml-shim: no C compiler (CC=${compiler}); alignc needs one to link too" >&2
  exit 1
fi

mkdir -p "${out_dir}"

case "${OSTYPE:-}" in
  darwin*) name_flags=("-install_name" "${library}") ;;
  *)       name_flags=("-Wl,-soname,${library}") ;;
esac

# `-ffp-contract=off` is a **correctness** flag here, not an optimisation preference
# (`docs/specs/r5a-dense-layer-forward.md` section 6, correction C15). `a * b + c` may be
# contracted into one fused multiply-add, and whether it is depends on the compiler and the
# target: Apple clang on arm64 contracts by default, GCC 13 on x86-64 does not. The stub engine's
# kernels are what `scripts/layer-forward-golden.jsonl` is generated from, so a contraction
# difference is twelve of forty-eight goldens disagreeing on a host that is otherwise correct.
# Both C files also carry a Clang-guarded `#pragma STDC FP_CONTRACT OFF`; the flag is what covers a
# compiler that does not honour or implement the pragma (including GCC 14.2), and
# `-DALIGN_GGML_FP_CONTRACT_OFF=1` is what lets the two runners assert that the library they loaded
# was built this way.
"${compiler}" -O2 -ffp-contract=off -DALIGN_GGML_FP_CONTRACT_OFF=1 \
  -fPIC -shared -Wall -Wextra -Werror \
  "${include_flags[@]+"${include_flags[@]}"}" \
  -o "${library}" "${source_file}" \
  "${name_flags[@]}" \
  "${link_flags[@]+"${link_flags[@]}"}"

if [ ! -f "${library}" ]; then
  printf '%s\n' "build-ggml-shim: the library was not produced: ${library}" >&2
  exit 1
fi

printf '%s\n' "build-ggml-shim: ${flavour} shim from $(basename -- "${source_file}") -> ${library}" >&2
printf '%s\n' "${out_dir}"
