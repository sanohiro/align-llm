#!/usr/bin/env bash
set -euo pipefail
root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT
for failure in 0 1; do
  "${CC:-cc}" -O2 -ffp-contract=off -DALIGN_GGML_FP_CONTRACT_OFF=1 \
    -DALIGN_GGML_STUB_ENGINE=1 -DALIGN_GGML_STUB_GPU=1 \
    -DALIGN_GPU_FORCE_TRANSFER_FAILURE="$failure" \
    "$root_dir/scripts/gpu_weight_upload_smoke.c" -lm -o "$work_dir/upload"
  "$work_dir/upload"
done
printf '%s\n' 'weight upload policy: PASS (legacy/direct, bounds, lifecycle, isolation, failure)'
