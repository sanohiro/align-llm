from importlib.machinery import SourceFileLoader
import json
import os
import platform
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any
from unittest import mock


ROOT = Path(__file__).resolve().parents[1]
DIAGNOSIS_PATH = ROOT / "scripts/run-olmoe-remaining-decode-overhead-diagnosis"
DIAGNOSIS_LOADER = SourceFileLoader("olmoe_remaining_decode_for_kv_stage", str(DIAGNOSIS_PATH))
DIAGNOSIS_SPEC = importlib.util.spec_from_loader(DIAGNOSIS_LOADER.name, DIAGNOSIS_LOADER)
if DIAGNOSIS_SPEC is None or DIAGNOSIS_SPEC.loader is None:
    raise RuntimeError("cannot load the remaining-decode owner")
diagnosis = importlib.util.module_from_spec(DIAGNOSIS_SPEC)
sys.modules[DIAGNOSIS_LOADER.name] = diagnosis
DIAGNOSIS_SPEC.loader.exec_module(diagnosis)
phase = diagnosis.phase
owner = diagnosis.parent
base = diagnosis.base

MODEL_BYTES = 4_213_512_192
MODEL_SHA256 = "4ddc0e53159ed512b8dd67914a66e27bc618f694672ba43a9a0454eabd9c684f"
SERVER_BUILD = "build 10566, commit bb4caa754"
BUDGET = 975_175_680
SEED = 5
FULL_TOKENS = 128
TEMPERATURE_MICROS = 300_000
FULL_OUTPUT_SHA256 = "aac1d1158144da0b3afd4f4cdff7c10df240adaa85529b8a21839a0c89777e52"
REPETITIONS = 4
CEILING_SECONDS = 8 * 60

BASELINE_VALUES_NS = [28_322_991_875, 30_172_193_417, 30_729_519_750, 30_967_544_875]
BASELINE_MEDIAN_NS = 30_450_856_583
FLOOR_PPM = 50_000
CANDIDATE_CEILING_NS = 28_928_313_753

EXPECTED_DIAGNOSIS_SHA256 = "de717064f4d2ea89d63a6529d38d37157f7d34f9946db7e6dc350076185157ce"
