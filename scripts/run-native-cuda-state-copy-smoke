#!/usr/bin/env bash
set -euo pipefail
root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
scratch=$(mktemp -d)
trap 'rm -rf -- "$scratch"' EXIT
nvcc -O2 -std=c++17 -gencode arch=compute_89,code=sm_89 \
  "$root_dir/scripts/native_cuda_state_copy.cu" \
  "$root_dir/scripts/test-native-cuda-state-copy.cu" \
  -o "$scratch/test-native-cuda-state-copy"
"$scratch/test-native-cuda-state-copy"
