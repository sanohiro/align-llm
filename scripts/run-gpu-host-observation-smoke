#!/usr/bin/env python3
"""Own real host discovery and native-device-bound Metal/CUDA driver observations."""
import pathlib
import tempfile
import time

from gpu_backend_recipe import RecipeError
from gpu_qualification_host import _platform
from gpu_qualification_host_observation import observe_host, observe_device, probe_owner, same_device


def refused(operation):
    try:
        operation()
    except RecipeError:
        return
    raise AssertionError("invalid host/device observation was accepted")


with tempfile.TemporaryDirectory(prefix="gpu-host-observation-") as raw:
    root = pathlib.Path(raw).resolve()
    home, temporary = root / "home", root / "tmp"
    home.mkdir(mode=0o700)
    temporary.mkdir(mode=0o700)
    deadline = time.monotonic_ns() + 30_000_000_000
    probe = probe_owner(work=root, home=home, temporary=temporary, deadline_ns=deadline)
    host = observe_host(expected_platform=_platform(), backend="metal" if _platform() == "macos" else "cuda",
                        probe=probe, deadline_ns=deadline)
    assert host["host_total_bytes"] > 0 and 0 <= host["host_free_bytes"] <= host["host_total_bytes"]
    assert host["cpu"] and host["os_version"] and host["kernel"] and host["logical_cpus"] > 0
    assert host["device_state"] == "unavailable" and host["device_total_bytes"] == 0
    refused(lambda: observe_host(expected_platform="unsupported", backend="metal", probe=probe, deadline_ns=deadline))
    observation = dict(available=True, bundle_id="a" * 64, device_name="Metal", device_description="Apple M1",
                       device_id="", device_total_bytes=1024, device_free_bytes=0)
    bundle = dict(bundle_id="a" * 64, backend="metal", target={"gpu_architectures": ["apple_m1"]})
    metal_host = {**host, "platform": "macos", "backend": "metal"}
    enriched = observe_device(metal_host, observation, bundle=bundle, probe=probe, deadline_ns=deadline)
    assert enriched["device_free_bytes"] == 0 and enriched["device_state"] == "available"
    assert str(host["os_version"]) in enriched["driver"] and enriched["gpu_architecture"] == "apple_m1"
    same_device(observation, {**observation, "device_free_bytes": 1})
    for key, value in (("bundle_id", "b" * 64), ("device_name", "other"), ("device_description", "Apple M2"),
                       ("device_id", "other"), ("device_total_bytes", 2048)):
        refused(lambda: same_device(observation, {**observation, key: value}))
    for change in ({"device_total_bytes": 0}, {"device_free_bytes": 1025}, {"device_description": "invented"}):
        refused(lambda: observe_device(metal_host, {**observation, **change}, bundle=bundle, probe=probe, deadline_ns=deadline))
    refused(lambda: observe_device(metal_host, observation, bundle=bundle, probe=probe, deadline_ns=0))

    cuda = {**observation, "device_name": "CUDA0", "device_description": "NVIDIA RTX 4090", "device_id": "0000:0a:00.0"}
    cuda_host = {**host, "platform": "linux", "backend": "cuda"}
    cuda_bundle = {**bundle, "backend": "cuda", "target": {"gpu_architectures": ["sm_89"]}}
    rows = "00000000:03:00.0, NVIDIA A100, 570.124.06, 8.0\n00000000:0A:00.0, NVIDIA RTX 4090, 570.124.06, 8.9\n"
    calls = []
    def cuda_probe(*arguments):
        calls.append(arguments)
        return rows
    result = observe_device(cuda_host, cuda, bundle=cuda_bundle, probe=cuda_probe, deadline_ns=deadline)
    assert result["registry_device"] == "CUDA0" and result["gpu_architecture"] == "sm_89"
    assert result["driver"] == "570.124.06"
    assert calls == [("nvidia-smi", "--query-gpu=pci.bus_id,name,driver_version,compute_cap", "--format=csv,noheader,nounits")]
    for broken in (rows + rows.splitlines()[1] + "\n", rows.replace("0A:00.0", "0B:00.0"),
                   rows.replace("RTX 4090", "RTX 4080"), rows.replace("8.9", "N/A"),
                   rows.replace("8.9", "8.0"), rows.replace("00000000:0A", "00010000:0A"),
                   rows.replace("0A:00.0", "0A:ff.0"), "malformed", '"unterminated'):
        refused(lambda: observe_device(cuda_host, cuda, bundle=cuda_bundle,
                                       probe=lambda *args: broken, deadline_ns=deadline))
    refused(lambda: observe_device(cuda_host, {**cuda, "device_id": ""}, bundle=cuda_bundle,
                                   probe=cuda_probe, deadline_ns=deadline))
    if _platform() == "macos":
        refused(lambda: observe_host(expected_platform="macos", backend="metal",
            probe=lambda name, *args: "garbage" if name.endswith("vm_stat") else probe(name, *args),
            deadline_ns=deadline))
print("gpu-host-observation: PASS (real host facts, PCI binding, identity drift, malformed probes)")
