#!/usr/bin/env bash
set -euo pipefail

unset GIT_DIR GIT_COMMON_DIR GIT_WORK_TREE

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
temp_dir=$(mktemp -d)
repo_dir="$temp_dir/repository"
patch_path="$temp_dir/candidate.patch"
evaluation_path="$temp_dir/evaluation.json"
failed_path="$temp_dir/failed.json"
unborn_repo_dir="$temp_dir/unborn-repository"
unborn_evaluation_path="$temp_dir/unborn-evaluation.json"
empty_repo_dir="$temp_dir/empty-unborn-repository"
empty_evaluation_path="$temp_dir/empty-unborn-evaluation.json"
no_repo_dir="$temp_dir/not-a-repository"
no_repo_evaluation_path="$temp_dir/not-a-repository-evaluation.json"

cleanup() {
  rm -rf "$temp_dir"
}
trap cleanup EXIT

python3 - "$repo_dir" "$patch_path" <<'PY'
from pathlib import Path
import sys

repo = Path(sys.argv[1])
patch = Path(sys.argv[2])
(repo / "src").mkdir(parents=True)
(repo / "tests").mkdir()
(repo / "src" / "inclusive_range.py").write_text(
    "def inclusive_total(start: int, stop: int) -> int:\n    return sum(range(start, stop))\n",
    encoding="utf-8",
)
(repo / "tests" / "test_inclusive_range.py").write_text(
    "def test_inclusive_range():\n    assert True\n", encoding="utf-8"
)
(repo / "tests" / "test_other.py").write_text(
    "def test_other():\n    assert True\n", encoding="utf-8"
)
(repo / "src" / "api.align").write_text("module api\npub fn old() -> i64 = 1\n", encoding="utf-8")
patch.write_text(
    """diff --git a/src/inclusive_range.py b/src/inclusive_range.py
index 0000000..1111111 100644
--- a/src/inclusive_range.py
+++ b/src/inclusive_range.py
@@ -2 +2 @@ def inclusive_total(start: int, stop: int) -> int:
-    return sum(range(start, stop))
+    return sum(range(start, stop + 1))
diff --git a/tests/test_inclusive_range.py b/tests/test_inclusive_range.py
--- a/tests/test_inclusive_range.py
+++ b/tests/test_inclusive_range.py
@@ -1 +1 @@ def test_inclusive_range():
-    assert True
+    assert True  # candidate test edit
diff --git a/src/api.align b/src/api.align
--- a/src/api.align
+++ b/src/api.align
@@ -2 +2 @@
-pub fn old() -> i64 = 1
+pub fn new() -> i64 = 1
""",
    encoding="utf-8",
)
PY

git init -q "$repo_dir"
git -C "$repo_dir" config user.email smoke@example.invalid
git -C "$repo_dir" config user.name "Patch Eval Smoke"
git -C "$repo_dir" add --all
git -C "$repo_dir" commit -qm initial

"$root_dir/main" --evaluate-patch "$repo_dir" "$patch_path" "$evaluation_path"

python3 - "$repo_dir" "$patch_path" "$evaluation_path" <<'PY'
import json
import sys
from pathlib import Path

repo = Path(sys.argv[1])
patch = Path(sys.argv[2])
evaluation = json.loads(Path(sys.argv[3]).read_text(encoding="utf-8"))

assert evaluation["schema_version"] == 1, evaluation
assert evaluation["root"] == str(repo), evaluation
assert evaluation["patch_path"] == str(patch), evaluation
assert evaluation["status"] == "ok", evaluation
assert evaluation["error_code"] == -1, evaluation
assert evaluation["touched_file_count"] == 3, evaluation
assert evaluation["touched_symbol_count"] == 3, evaluation
assert evaluation["risk_score"] == 51, evaluation
assert evaluation["unrelated_diff"] is True, evaluation
assert evaluation["public_api_change"] is True, evaluation
assert evaluation["complexity_delta"] == 0, evaluation
assert evaluation["recommended_test_count"] == 1, evaluation

files = {item["path"]: item for item in evaluation["files"]}
assert files["src/inclusive_range.py"] == {
    "path": "src/inclusive_range.py",
    "additions": 1,
    "deletions": 1,
    "complexity_delta": 0,
    "risk_score": 2,
    "unrelated": False,
    "public_api_change": False,
}, files
assert files["tests/test_inclusive_range.py"]["unrelated"] is True, files
assert files["src/api.align"]["public_api_change"] is True, files

symbols = {(item["path"], item["name"], item["kind"]) for item in evaluation["symbols"]}
assert ("src/inclusive_range.py", "inclusive_total", "function") in symbols, symbols
assert ("tests/test_inclusive_range.py", "test_inclusive_range", "function") in symbols, symbols
assert ("src/api.align", "old", "public-function") in symbols, symbols
assert evaluation["recommended_tests"] == [
    {"path": "tests/test_inclusive_range.py", "score": 100, "reason": "basename-match"},
], evaluation
PY

if "$root_dir/main" --evaluate-patch "$repo_dir" "$temp_dir/missing.patch" "$failed_path"; then
  exit 1
fi
python3 - "$failed_path" <<'PY'
import json
import sys
from pathlib import Path

failed = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
assert failed["schema_version"] == 1, failed
assert failed["status"] == "error", failed
assert failed["error_code"] == 2, failed
assert failed["touched_file_count"] == 0, failed
assert failed["files"] == [], failed
assert failed["symbols"] == [], failed
assert failed["recommended_tests"] == [], failed
PY

# The evaluation path consumes only the candidates, their count, and the selection status, so it
# runs `git ls-files -z` alone. These three cases own that contract:
#   1. an unborn HEAD with a populated index reports `ok` and the real index-derived candidates;
#   2. an unborn HEAD with an empty index reports `ok` with zero candidates;
#   3. a directory outside a work tree still fails, because `git ls-files` itself fails there.
mkdir -p "$unborn_repo_dir/src" "$unborn_repo_dir/tests"
printf 'def inclusive_total(start: int, stop: int) -> int:\n    return sum(range(start, stop))\n' \
  >"$unborn_repo_dir/src/inclusive_range.py"
printf 'def test_inclusive_range():\n    assert True\n' \
  >"$unborn_repo_dir/tests/test_inclusive_range.py"
git init -q "$unborn_repo_dir"
git -C "$unborn_repo_dir" config user.email smoke@example.invalid
git -C "$unborn_repo_dir" config user.name "Unborn Patch Eval Smoke"
git -C "$unborn_repo_dir" add --all
if git -C "$unborn_repo_dir" rev-parse --verify HEAD >/dev/null 2>&1; then
  printf '%s\n' "patch evaluator smoke: unborn fixture unexpectedly has a HEAD commit" >&2
  exit 1
fi
"$root_dir/main" --evaluate-patch "$unborn_repo_dir" "$patch_path" "$unborn_evaluation_path"

git init -q "$empty_repo_dir"
git -C "$empty_repo_dir" config user.email smoke@example.invalid
git -C "$empty_repo_dir" config user.name "Empty Unborn Patch Eval Smoke"
"$root_dir/main" --evaluate-patch "$empty_repo_dir" "$patch_path" "$empty_evaluation_path"

python3 - "$unborn_evaluation_path" "$empty_evaluation_path" <<'PY'
import json
import sys
from pathlib import Path

unborn = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
assert unborn["status"] == "ok", unborn
assert unborn["error_code"] == -1, unborn
assert unborn["touched_file_count"] == 3, unborn
assert unborn["recommended_test_count"] == 1, unborn
assert unborn["recommended_tests"] == [
    {"path": "tests/test_inclusive_range.py", "score": 100, "reason": "basename-match"},
], unborn

empty = json.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))
assert empty["status"] == "ok", empty
assert empty["error_code"] == -1, empty
assert empty["touched_file_count"] == 3, empty
assert empty["recommended_test_count"] == 0, empty
assert empty["recommended_tests"] == [], empty
PY

mkdir "$no_repo_dir"
if "$root_dir/main" --evaluate-patch "$no_repo_dir" "$patch_path" "$no_repo_evaluation_path"; then
  exit 1
fi
python3 - "$no_repo_evaluation_path" <<'PY'
import json
import sys
from pathlib import Path

outside = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
assert outside["status"] == "error", outside
assert outside["error_code"] == 2, outside
assert outside["touched_file_count"] == 3, outside
assert outside["recommended_test_count"] == 0, outside
assert outside["recommended_tests"] == [], outside
PY

printf '%s\n' "patch evaluator smoke: diff shape, symbol/risk signals, recommended tests, revision-free selection, and failure persistence PASS"
