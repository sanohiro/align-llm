class KPreparationError(RuntimeError):
    pass


def require(condition: bool, message: str) -> None:
    if not condition:
        raise KPreparationError(message)


def keys(value: Any, expected: set[str], label: str) -> None:
    require(isinstance(value, dict) and set(value) == expected, f"{label} keys drifted")


def integer(value: Any, *, signed: bool = False, positive: bool = False) -> bool:
    lower = MIN_I64 if signed else (1 if positive else 0)
    return type(value) is int and lower <= value <= MAX_I64


def same(actual: Any, expected: Any, label: str) -> None:
    require(previous.same_typed_json(actual, expected), f"{label} drifted")


def scalar_domains(value: Any, field: str = "") -> None:
    if isinstance(value, dict):
        for name, item in value.items():
            scalar_domains(item, name)
    elif isinstance(value, list):
        for item in value:
            scalar_domains(item, field)
    elif isinstance(value, bool):
        require(field in {"stopped_eog", "released_before_owner_scope_end"},
                f"boolean integer at {field}")
    elif isinstance(value, int):
        require(integer(value, signed=field in {"gain_ns", "paired_gains_ns", "median_gain_ns", "gain_ppm"}),
                f"integer outside signed-i64 domain at {field}")
    elif isinstance(value, float):
        raise KPreparationError(f"non-integer scalar at {field}")


def source_identities() -> tuple[str, ...]:
    return tuple(base.file_sha256(path) for path in SOURCE_PATHS)


def validate_imported_contract() -> None:
    require(source_identities() == EXPECTED_SOURCE_IDENTITIES, "pinned source chain drifted")
    same((previous.CEILING_SECONDS, previous.FLOOR_NS, previous.FLOOR_PPM),
         (CEILING_SECONDS, FLOOR_NS, FLOOR_PPM), "inherited measurement constants")
    require(previous.BASELINE_MEDIAN_NS - FLOOR_NS == HISTORICAL_CEILING_NS,
            "historical ceiling arithmetic drifted")


def run(argv: list[str], *, deadline: float, env: dict[str, str], cwd: Path = ROOT,
        maximum: int = 240, check: bool = True) -> subprocess.CompletedProcess[bytes]:
    """Keep inherited signal/child ownership while explicitly isolating the build cwd."""
    remaining = min(float(maximum), deadline - time.monotonic())
    require(remaining > 0, "complete comparison exceeded its 8-minute ceiling")
    process = subprocess.Popen(argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    owner.active_process = process
    try:
        stdout, stderr = process.communicate(timeout=remaining)
    except BaseException:
        owner.stop_process(process)
        raise
    finally:
        if owner.active_process is process:
            owner.active_process = None
    completed = subprocess.CompletedProcess(argv, process.returncode, stdout, stderr)
    require(not check or completed.returncode == 0,
            f"command failed ({completed.returncode}): {' '.join(argv)}\n"
            + stderr.decode("utf-8", "replace")[-4096:])
    return completed


def git(arguments: list[str], deadline: float, env: dict[str, str], *, check: bool = True
        ) -> subprocess.CompletedProcess[bytes]:
    return run(["git", "--no-replace-objects", *arguments], deadline=deadline, env=env,
               maximum=30, check=check)


def clean_head(deadline: float, env: dict[str, str]) -> str:
    require(not git(["status", "--porcelain", "--untracked-files=all"], deadline, env).stdout,
            "real comparison requires a clean worktree")
    return git(["rev-parse", "HEAD"], deadline, env).stdout.decode("ascii").strip()


def git_common_dir(deadline: float, env: dict[str, str]) -> Path:
    value = git(["rev-parse", "--git-common-dir"], deadline, env).stdout.decode("utf-8").strip()
    require(bool(value), "Git common directory was empty")
    return (ROOT / value).resolve()


def validate_ancestry_state(replace_refs: bytes, graft_exists: bool, statuses: list[int]) -> None:
    require(not replace_refs.strip(), "ancestry refuses Git replacement refs")
    require(not graft_exists, "ancestry refuses Git grafts")
    require(all(status == 0 for status in statuses), "required revision is not an ancestor")


def require_ancestry(head: str, deadline: float, env: dict[str, str], common: Path,
                     evaluated: str | None = None) -> None:
    require(git_common_dir(deadline, env) == common, "Git common directory changed")
    refs = git(["for-each-ref", "--format=%(refname)", "refs/replace"], deadline, env).stdout
    graft_exists = (common / "info/grafts").exists()
    validate_ancestry_state(refs, graft_exists, [])
    ancestors = [CONTROL_HEAD] + ([evaluated] if evaluated is not None else [])
    statuses = [git(["merge-base", "--is-ancestor", ancestor, head], deadline, env,
                    check=False).returncode for ancestor in ancestors]
    validate_ancestry_state(refs, graft_exists, statuses)


def tracked_sources(revision: str, deadline: float, env: dict[str, str]) -> dict[str, tuple[str, str]]:
    rows = git(["ls-tree", "-r", "-z", revision, "--", "src", *sorted(BUILD_FILES)],
               deadline, env).stdout
    result = {}
    for raw in rows.split(b"\0"):
        if not raw:
            continue
        metadata, raw_path = raw.split(b"\t", 1)
        mode, kind, blob = metadata.decode("ascii").split()
        path = raw_path.decode("utf-8", "strict")
        if path not in BUILD_FILES and not (path.startswith("src/") and path.endswith(".align")):
            continue
        require(kind == "blob" and mode in {"100644", "100755"}, "source is not a regular tracked file")
        require(not Path(path).is_absolute() and ".." not in Path(path).parts, "unsafe source path")
        result[path] = (mode, blob)
    require(BUILD_FILES | ALLOWED_DELTA | {HELPER_SOURCE} <= set(result), "tracked source inventory incomplete")
    return result


def manifest(tree: Path, inventory: dict[str, tuple[str, str]]) -> list[dict[str, Any]]:
    actual_align = {path.relative_to(tree).as_posix() for path in (tree / "src").rglob("*.align")}
    require(actual_align == {path for path in inventory if path.endswith(".align")},
            "snapshot Align source inventory changed")
    rows = []
    for path in sorted(inventory):
        source = tree / path
        require(source.is_file() and not source.is_symlink(), "snapshot source missing or symlinked")
        data = source.read_bytes()
        blob = hashlib.sha1(b"blob " + str(len(data)).encode("ascii") + b"\0" + data).hexdigest()
        require(blob == inventory[path][1], f"snapshot bytes differ from tracked blob: {path}")
        rows.append({"path": path, "bytes": len(data), "sha256": base.bytes_sha256(data)})
    return rows


def materialize(revision: str, tree: Path, deadline: float, env: dict[str, str]) -> dict[str, Any]:
    inventory = tracked_sources(revision, deadline, env)
    archive = git(["archive", "--format=tar", revision, "--", *sorted(inventory)], deadline, env).stdout
    tree.mkdir()
    with tarfile.open(fileobj=io.BytesIO(archive), mode="r:") as bundle:
        for member in bundle:
            if member.isdir():
                continue
            require(member.name in inventory and member.isfile(), "unexpected snapshot archive member")
            destination = tree / member.name
            destination.parent.mkdir(parents=True, exist_ok=True)
            source = bundle.extractfile(member)
            require(source is not None, "snapshot archive member was unreadable")
            destination.write_bytes(source.read())
            destination.chmod(int(inventory[member.name][0], 8) & 0o777)
    return {"root": tree, "inventory": inventory, "identity": {
        "align_llm_head": revision,
        "source_tree": git(["rev-parse", f"{revision}^{{tree}}"], deadline, env).stdout.decode("ascii").strip(),
        "source_files": manifest(tree, inventory),
    }}


def validate_manifests(control: Any, candidate: Any, *, restored: bool = False) -> None:
    for rows in (control, candidate):
        require(isinstance(rows, list) and rows, "source manifest was not a nonempty array")
        paths = []
        for row in rows:
            keys(row, {"path", "bytes", "sha256"}, "source manifest row")
            require(isinstance(row["path"], str) and not Path(row["path"]).is_absolute()
                    and ".." not in Path(row["path"]).parts, "manifest source path was invalid")
            require(integer(row["bytes"], positive=True) and transfer.is_lower_hex(row["sha256"], 64),
                    "manifest file identity was invalid")
            paths.append(row["path"])
        require(paths == list(MANIFEST_PATHS), "source manifest is not complete, unique and path-sorted")
        require(BUILD_FILES | ALLOWED_DELTA | {HELPER_SOURCE} <= set(paths), "manifest source inventory incomplete")
        require(all(path in BUILD_FILES or (path.startswith("src/") and path.endswith(".align"))
                    for path in paths), "manifest source path outside declared inventory")
    require([row["path"] for row in control] == [row["path"] for row in candidate],
            "compiled source inventory differs between arms")
    differences = {left["path"] for left, right in zip(control, candidate, strict=True) if left != right}
    if restored:
        require(not differences, "removed production does not match control bytes")
    else:
        require(bool(differences) and differences <= ALLOWED_DELTA,
                "compiled source delta is empty or outside the five allowed paths")


def build_snapshot(snapshot: dict[str, Any], compiler: Path, include: Path, library: Path,
                   clean_env: dict[str, str], deadline: float) -> dict[str, Any]:
    tree = snapshot["root"]
    shim_dir = tree / "lib"
    build_env = dict(clean_env)
    build_env.update({"ALIGN_LLM_GGML_INCLUDE": str(include), "ALIGN_LLM_GGML_LIB": str(library),
                      "ALIGN_LLM_GGML_SHIM_DIR": str(shim_dir)})
    run([str(tree / "scripts/build-ggml-shim")], cwd=tree, env=build_env, deadline=deadline, maximum=180)
    build_env["LIBRARY_PATH"] = ":".join(value for value in
        (str(shim_dir), str(library), clean_env.get("LIBRARY_PATH", "")) if value)
    run([str(compiler), "build", HELPER_SOURCE], cwd=tree, env=build_env, deadline=deadline, maximum=300)
    helper = tree / HELPER_NAME
    shim = shim_dir / ("libalign_ggml_shim.dylib" if platform.system() == "Darwin" else "libalign_ggml_shim.so")
    require(helper.is_file() and os.access(helper, os.X_OK) and shim.is_file(), "isolated build incomplete")
    runtime_env = dict(clean_env)
    runtime_env["DYLD_LIBRARY_PATH"] = runtime_env["LD_LIBRARY_PATH"] = ":".join((str(shim_dir), str(library)))
    identity = {**snapshot["identity"], "helper_sha256": base.file_sha256(helper),
                "shim_sha256": base.file_sha256(shim)}
    return {**snapshot, "identity": identity, "helper": helper, "shim": shim, "runtime_env": runtime_env}


@contextmanager
def protect_root_artifacts(work: Path) -> Iterator[None]:
    paths = [ROOT / HELPER_NAME, ROOT / "main", *[ROOT / "build/lib" / f"libalign_ggml_shim.{suffix}"
             for suffix in ("so", "dylib")]]
    before = {}
    for index, path in enumerate(paths):
        require(not path.is_symlink(), "root generated artifact is a symlink")
        saved = work / f"root-artifact-{index}"
        if path.exists():
            require(path.is_file(), "root generated artifact is not a file")
            shutil.copy2(path, saved)
        before[path] = saved
    try:
        yield
    finally:
        changed = []
        for path, saved in before.items():
            expected = (base.file_sha256(saved), saved.stat().st_mode) if saved.exists() else None
            actual = (base.file_sha256(path), path.stat().st_mode) if path.is_file() else None
            if expected != actual or path.is_symlink() or (path.exists() and not path.is_file()):
                changed.append(path.name)
                if path.exists() or path.is_symlink():
                    if path.is_dir() and not path.is_symlink():
                        shutil.rmtree(path)
                    else:
                        path.unlink()
                if saved.exists():
                    path.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(saved, path)
        require(not changed, "isolated builds touched root artifacts: " + ", ".join(changed))


def inherited_sample(leg: dict[str, Any], index: int) -> dict[str, Any]:
    return {"index": index, "conditioning": leg["short"], "full": leg["full"],
            "full_helper_wall_ns": leg["full_helper_wall_ns"], "isolation": leg["isolation"]}


def validate_leg(leg: Any, index: int) -> None:
    keys(leg, LEG_KEYS, "arm leg")
    scalar_domains(leg)
    for record in (leg["short"], leg["full"]):
        require(integer(record["schema_version"]) and record["schema_version"] == 1,
                "helper schema version drifted")
    exact.validate_sample(inherited_sample(leg, index), index)
    require(integer(leg["full_helper_wall_ns"], positive=True)
            and leg["full_helper_wall_ns"] >= leg["full"]["phases"]["elapsed_ns"],
            "full helper wall did not contain helper elapsed")


def measure_request(built: dict[str, Any], model: Path, pack: Path, geometry: Path,
                    maximum: int, deadline: float) -> tuple[dict[str, Any], int]:
    owner.verify_identities((("arm helper", built["helper"], built["identity"]["helper_sha256"]),
                             ("arm shim", built["shim"], built["identity"]["shim_sha256"])))
    started = time.monotonic_ns()
    completed = run([str(built["helper"]), str(model), str(pack), str(geometry), diagnosis.PROMPT_TEXT,
                     str(maximum), str(exact.SEED)], cwd=built["root"], env=built["runtime_env"], deadline=deadline)
    wall = time.monotonic_ns() - started
    try:
        record = json.loads(completed.stdout.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as error:
        raise KPreparationError("helper did not emit one JSON record") from error
    scalar_domains(record)
    exact.validate_helper_record(record, maximum)
    require(integer(wall, positive=True) and wall >= record["phases"]["elapsed_ns"],
            "helper wall did not contain helper elapsed")
    return record, wall


def measure_leg(built: dict[str, Any], paths: tuple[Path, ...], env: dict[str, str],
                deadline: float, index: int) -> dict[str, Any]:
    model, pack, geometry, _, _, server = paths
    owner.require_no_matching_process(server, model, deadline, env)
    short, _ = measure_request(built, model, pack, geometry, 2, deadline)
    owner.require_no_matching_process(server, model, deadline, env)
    try:
        full, wall = measure_request(built, model, pack, geometry, exact.FULL_TOKENS, deadline)
    finally:
        owner.require_no_matching_process(server, model, deadline, env)
    leg = {"short": short, "full": full, "full_helper_wall_ns": wall,
           "isolation": {"matching_before": 0, "matching_between": 0, "matching_after": 0}}
    validate_leg(leg, index)
    return leg


def measure_pairs(builds: dict[str, Any], paths: tuple[Path, ...], env: dict[str, str],
                  deadline: float) -> list[dict[str, Any]]:
    pairs = []
    for index, order in enumerate(PAIR_ORDER, 1):
        pair: dict[str, Any] = {"index": index, "order": order}
        for symbol in order:
            arm = ARM_NAMES[symbol]
            pair[arm] = measure_leg(builds[arm], paths, env, deadline, index)
        pair["gain_ns"] = pair["control"]["full_helper_wall_ns"] - pair["candidate"]["full_helper_wall_ns"]
        pairs.append(pair)
    validate_pairs(pairs)
    return pairs


def validate_pairs(pairs: Any) -> None:
    require(isinstance(pairs, list) and len(pairs) == 4, "comparison requires four complete pairs")
    for index, (pair, order) in enumerate(zip(pairs, PAIR_ORDER, strict=True), 1):
        keys(pair, PAIR_KEYS, "pair")
        require(integer(pair["index"], positive=True) and pair["index"] == index and pair["order"] == order,
                "chronological pair order or index drifted")
        for arm in ("control", "candidate"):
            validate_leg(pair[arm], index)
        expected = pair["control"]["full_helper_wall_ns"] - pair["candidate"]["full_helper_wall_ns"]
        require(integer(pair["gain_ns"], signed=True) and pair["gain_ns"] == expected, "paired gain drifted")
    # Timings may differ; both arms and all legs must preserve every non-timing result.
    exact.validate_repeatability([inherited_sample(pair[arm], index)
        for index, pair in enumerate(pairs, 1) for arm in ("control", "candidate")])


def signed_median(values: list[int]) -> int:
    require(len(values) == 4 and all(integer(value, signed=True) for value in values),
            "signed median requires four i64 values")
    ordered = sorted(values)
    return (ordered[1] + ordered[2]) // 2


def gate(control: list[int], candidate: list[int]) -> tuple[dict[str, Any], str]:
    require(len(control) == len(candidate) == 4
            and all(integer(value, positive=True) for value in control + candidate), "gate walls invalid")
    gains = [a - b for a, b in zip(control, candidate, strict=True)]
    control_median = signed_median(control)
    candidate_median = signed_median(candidate)
    gain_median = signed_median(gains)
    required = max(FLOOR_NS, (control_median * FLOOR_PPM + 999_999) // 1_000_000)
    positive = sum(gain > 0 for gain in gains)
    aggregate = {"control_values_ns": control, "candidate_values_ns": candidate,
        "paired_gains_ns": gains, "control_median_ns": control_median,
        "candidate_median_ns": candidate_median, "median_gain_ns": gain_median,
        "positive_pairs": positive, "required_gain_ns": required,
        "historical_ceiling_ns": HISTORICAL_CEILING_NS,
        "gain_ppm": gain_median * 1_000_000 // control_median}
    scalar_domains(aggregate)
    decision = "MET" if positive == 4 and gain_median >= required and candidate_median <= HISTORICAL_CEILING_NS else "NOT_MET"
    return aggregate, decision


def aggregate_pairs(pairs: list[dict[str, Any]]) -> tuple[dict[str, Any], str]:
    validate_pairs(pairs)
    return gate([pair["control"]["full_helper_wall_ns"] for pair in pairs],
                [pair["candidate"]["full_helper_wall_ns"] for pair in pairs])


def boundary_record() -> dict[str, Any]:
    return {"concat_row": 17, "pad_row": 18, "concat_op": "K_CONCAT_F32", "pad_op": "K_PAD_F32",
            "callback_tasks": 1, "execution": "NORMAL_UNSPLIT_PHASE_A"}


def fixed_request_record() -> dict[str, Any]:
    return {"model_bytes": exact.MODEL_BYTES, "model_sha256": exact.MODEL_SHA256,
        "pack_sha256": exact.EXPECTED_PACK_SHA256, "geometry_sha256": exact.EXPECTED_GEOMETRY_SHA256,
        "server_sha256": exact.EXPECTED_SERVER_SHA256, "align_revision": exact.EXPECTED_ALIGN_REVISION,
        "compiler_sha256": exact.EXPECTED_COMPILER_SHA256, "ggml_libraries": exact.EXPECTED_GGML_LIBRARIES,
        "ggml_headers": exact.EXPECTED_GGML_HEADERS, "task_id": "python-inclusive-range",
        "task_sha256": exact.EXPECTED_TASK_SHA256, "prompt_sha256": exact.EXPECTED_PROMPT_SHA256,
        "maximum_tokens": exact.FULL_TOKENS, "temperature_micros": exact.TEMPERATURE_MICROS,
        "seed": exact.SEED, "cache_budget_bytes": exact.BUDGET, "full_output_sha256": exact.FULL_OUTPUT_SHA256}


def environment_record() -> dict[str, Any]:
    return {**exact.EXPECTED_BASELINE_HOST, "host_fingerprint_sha256": exact.EXPECTED_BASELINE_HOST_SHA256,
        "c_compiler_sha256": exact.EXPECTED_C_COMPILER_SHA256,
        "c_compiler_version_sha256": exact.EXPECTED_C_COMPILER_VERSION_SHA256,
        "linker_search_sha256": exact.EXPECTED_LINKER_SEARCH_SHA256}


def validate_arms(control: Any, candidate: Any) -> None:
    for arm in (control, candidate):
        keys(arm, ARM_KEYS, "arm identity")
        for field, length in (("align_llm_head", 40), ("source_tree", 40), ("helper_sha256", 64), ("shim_sha256", 64)):
            require(transfer.is_lower_hex(arm[field], length), f"arm {field} invalid")
    require(control["align_llm_head"] == CONTROL_HEAD, "control revision drifted")
    require(candidate["align_llm_head"] != CONTROL_HEAD, "candidate revision equals control")
    require(all(control[field] != candidate[field] for field in ("source_tree", "helper_sha256", "shim_sha256")),
            "compiled arms were not distinct")
    if PUBLICATION_ONLY and EVALUATED_HEAD is not None:
        require(candidate["align_llm_head"] == EVALUATED_HEAD, "evaluated candidate revision drifted")
    validate_manifests(control["source_files"], candidate["source_files"])


def validate_elapsed(result: dict[str, Any]) -> None:
    elapsed = result["elapsed_ns"]
    total = sum(pair[arm]["full_helper_wall_ns"] for pair in result["pairs"] for arm in ("control", "candidate"))
    require(integer(elapsed, positive=True) and total <= elapsed <= CEILING_SECONDS * 1_000_000_000,
            "complete elapsed did not contain full walls within the 8-minute ceiling")


def validate_result(result: Any) -> None:
    keys(result, TOP_KEYS, "result")
    scalar_domains(result)
    require(result["schema_version"] == 1 and result["kind"] == KIND, "result schema identity drifted")
    validate_arms(result["control"], result["candidate"])
    same(result["boundary"], boundary_record(), "operation boundary")
    same(result["fixed_request"], fixed_request_record(), "fixed request")
    same(result["environment"], environment_record(), "host/toolchain environment")
    same(result["pair_order"], PAIR_ORDER, "pair schedule")
    aggregate, decision = aggregate_pairs(result["pairs"])
    keys(result["aggregate"], AGGREGATE_KEYS, "aggregate")
    same(result["aggregate"], aggregate, "paired aggregate")
    same(result["decision"], decision, "shipping decision")
    validate_elapsed(result)


def complete_result_after_cleanup(result: dict[str, Any], started: int) -> dict[str, Any]:
    result = {**result, "elapsed_ns": time.monotonic_ns() - started}
    validate_result(result)
    result["elapsed_ns"] = time.monotonic_ns() - started
    validate_elapsed(result)
    return result


def prerequisites() -> tuple[Path, ...] | None:
    rows = [("ALIGN_LLM_OLMOE_MODEL", base.configured_file("ALIGN_LLM_OLMOE_MODEL")),
        ("ALIGN_LLM_MOE_ALIGNPACK", base.configured_file("ALIGN_LLM_MOE_ALIGNPACK")),
        ("ALIGN_LLM_MOE_GEOMETRY", base.configured_file("ALIGN_LLM_MOE_GEOMETRY")),
        ("ALIGN_LLM_GGML_INCLUDE", base.configured_directory("ALIGN_LLM_GGML_INCLUDE")),
        ("ALIGN_LLM_GGML_LIB", base.configured_directory("ALIGN_LLM_GGML_LIB")),
        ("ALIGN_LLM_LLAMA_SERVER", base.configured_file("ALIGN_LLM_LLAMA_SERVER", executable=True))]
    missing = next((name for name, path in rows if path is None), None)
    if missing is not None:
        print(f"{LABEL}: N/A ({missing} unset)")
        return None
    return tuple(path.resolve() for _, path in rows)


def external_request(paths: tuple[Path, ...], compiler: Path, env: dict[str, str],
                     deadline: float) -> dict[str, Any]:
    model, pack, geometry, include, library, server = paths
    version = run([str(server), "--version"], deadline=deadline, env=env, maximum=30)
    require(exact.SERVER_BUILD in (version.stdout + version.stderr).decode("utf-8", "replace"),
            "server build identity drifted")
    task = json.loads(diagnosis.TASK.read_text(encoding="utf-8"))
    result = {**fixed_request_record(), "model_bytes": model.stat().st_size,
        "model_sha256": base.file_sha256(model), "pack_sha256": base.file_sha256(pack),
        "geometry_sha256": base.file_sha256(geometry), "server_sha256": base.file_sha256(server),
        "align_revision": (ROOT / ".align-revision").read_text(encoding="utf-8").strip(),
        "compiler_sha256": base.file_sha256(compiler), "ggml_libraries": base.library_identities(library),
        "ggml_headers": previous.compute.predecessor.ggml_header_identities(include),
        "task_id": task["id"], "task_sha256": base.file_sha256(diagnosis.TASK),
        "prompt_sha256": base.bytes_sha256(diagnosis.PROMPT_TEXT.encode("utf-8"))}
    same(result, fixed_request_record(), "external fixed request")
    return result


def toolchain_environment(compiler: Path, c_compiler: Path, env: dict[str, str],
                          linker_search: str, deadline: float) -> dict[str, Any]:
    version = run([str(c_compiler), "--version"], deadline=deadline, env=env, maximum=30)
    identities = {"compiler_sha256": base.file_sha256(compiler),
        "c_compiler_sha256": base.file_sha256(c_compiler),
        "c_compiler_version_sha256": base.command_output_sha256(version)}
    diagnosis.validate_toolchain_identity(identities)
    result = {**transfer.qualification_host(env, deadline),
        "c_compiler_sha256": identities["c_compiler_sha256"],
        "c_compiler_version_sha256": identities["c_compiler_version_sha256"],
        "linker_search_sha256": None if not linker_search else base.bytes_sha256(linker_search.encode("utf-8"))}
    same(result, environment_record(), "host/toolchain environment")
    return result


def require_snapshot_identity(built: dict[str, Any]) -> None:
    same(manifest(built["root"], built["inventory"]), built["identity"]["source_files"], "built source manifest")
    owner.verify_identities((("arm helper", built["helper"], built["identity"]["helper_sha256"]),
                             ("arm shim", built["shim"], built["identity"]["shim_sha256"])))


def main() -> int:
    if sys.argv[1:] == ["--self-test"]:
        return self_test()
    require(len(sys.argv) == 1, "qualification accepts no arguments or --self-test")
    require(not PUBLICATION_ONLY,
            f"candidate was removed after NOT_MET; replay real qualification at evaluated commit {EVALUATED_HEAD}")
    paths = prerequisites()
    if paths is None:
        return 0
    started = time.monotonic_ns()
    deadline = time.monotonic() + CEILING_SECONDS
    validate_imported_contract()
    env = transfer.phase.decision.decision_environment()
    env["GIT_NO_REPLACE_OBJECTS"] = "1"
    linker_search = transfer.phase.decision.validate_linker_search(env)
    if linker_search:
        env["LIBRARY_PATH"] = linker_search
    transfer.qualification_host(env, deadline)
    head = clean_head(deadline, env)
    common = git_common_dir(deadline, env)
    require_ancestry(head, deadline, env, common, EVALUATED_HEAD)
    # The runner cannot contain its own literal digest. Bind its bytes to this clean
    # tracked head, then independently recheck its hash after all measurements.
    runner_digest = base.file_sha256(RUNNER_PATH)
    tracked_runner = git(["show", f"{head}:scripts/run-olmoe-k-preparation-boundary"], deadline, env).stdout
    require(base.bytes_sha256(tracked_runner) == runner_digest, "driver differs from evaluated tracked head")
    model, _, _, include, library, server = paths
    owner.require_no_matching_process(server, model, deadline, env)
    compiler_output = run([str(ROOT / "scripts/align-toolchain"), "ensure", "compiler"],
                          deadline=deadline, env=env, maximum=300)
    compiler = Path(compiler_output.stdout.decode("utf-8").strip()).resolve()
    require(compiler.is_file() and os.access(compiler, os.X_OK), "managed pinned compiler is unusable")
    c_name = shutil.which("cc", path=env.get("PATH"))
    require(c_name is not None, "default C compiler is unavailable")
    c_compiler = Path(c_name).resolve()
    environment = toolchain_environment(compiler, c_compiler, env, linker_search, deadline)
    request = external_request(paths, compiler, env, deadline)
    with tempfile.TemporaryDirectory(prefix="align-r8-k-preparation-") as raw:
        work = Path(raw)
        with protect_root_artifacts(work):
            snapshots = {"control": materialize(CONTROL_HEAD, work / "control", deadline, env),
                         "candidate": materialize(head, work / "candidate", deadline, env)}
            validate_manifests(snapshots["control"]["identity"]["source_files"],
                               snapshots["candidate"]["identity"]["source_files"])
            builds = {arm: build_snapshot(snapshots[arm], compiler, include, library, env, deadline)
                      for arm in ("control", "candidate")}
            validate_arms(builds["control"]["identity"], builds["candidate"]["identity"])
            pairs = measure_pairs(builds, paths, env, deadline)
            aggregate, decision = aggregate_pairs(pairs)
            require(clean_head(deadline, env) == head, "evaluated head changed during comparison")
            require_ancestry(head, deadline, env, common, EVALUATED_HEAD)
            validate_imported_contract()
            require(base.file_sha256(RUNNER_PATH) == runner_digest, "qualification driver changed")
            for arm in ("control", "candidate"):
                require_snapshot_identity(builds[arm])
                same(tracked_sources(builds[arm]["identity"]["align_llm_head"], deadline, env),
                     builds[arm]["inventory"], "tracked arm sources")
            same(external_request(paths, compiler, env, deadline), request, "external recheck")
            same(toolchain_environment(compiler, c_compiler, env, linker_search, deadline),
                 environment, "toolchain recheck")
            owner.require_no_matching_process(server, model, deadline, env)
            result = {"schema_version": 1, "kind": KIND, "control": builds["control"]["identity"],
                "candidate": builds["candidate"]["identity"], "boundary": boundary_record(),
                "fixed_request": request, "environment": environment, "pair_order": list(PAIR_ORDER),
                "pairs": pairs, "aggregate": aggregate, "decision": decision,
                "elapsed_ns": time.monotonic_ns() - started}
            validate_result(result)
    result = complete_result_after_cleanup(result, started)
    print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))
    print(f"{LABEL}: COMPLETE decision={result['decision']} "
          f"control={aggregate['control_median_ns'] / 1e9:.3f}s "
          f"candidate={aggregate['candidate_median_ns'] / 1e9:.3f}s "
          f"median_gain={aggregate['median_gain_ns'] / 1e9:.3f}s "
          f"elapsed={result['elapsed_ns'] / 1e9:.2f}s", file=sys.stderr)
    return 0


def synthetic_result() -> dict[str, Any]:
    samples = exact.synthetic_samples([20_000_000_000] * 4)
    pairs = []
    for index, sample in enumerate(samples, 1):
        control = {"short": sample["conditioning"], "full": sample["full"],
                   "full_helper_wall_ns": 20_000_000_000, "isolation": sample["isolation"]}
        candidate = deepcopy(control)
        candidate["full_helper_wall_ns"] = 16_000_000_000
        pairs.append({"index": index, "order": PAIR_ORDER[index - 1], "control": control,
                      "candidate": candidate, "gain_ns": 4_000_000_000})
    source_files = [{"path": path, "bytes": 1, "sha256": "a" * 64} for path in MANIFEST_PATHS]
    changed = deepcopy(source_files)
    for row in changed:
        if row["path"] in ALLOWED_DELTA:
            row["sha256"] = "b" * 64
    control = {"align_llm_head": CONTROL_HEAD, "source_tree": "a" * 40, "source_files": source_files,
               "helper_sha256": "a" * 64, "shim_sha256": "c" * 64}
    candidate = {"align_llm_head": EVALUATED_HEAD or "b" * 40, "source_tree": "b" * 40,
                 "source_files": changed, "helper_sha256": "b" * 64, "shim_sha256": "d" * 64}
    aggregate, decision = aggregate_pairs(pairs)
    return {"schema_version": 1, "kind": KIND, "control": control, "candidate": candidate,
        "boundary": boundary_record(), "fixed_request": fixed_request_record(),
        "environment": environment_record(), "pair_order": list(PAIR_ORDER), "pairs": pairs,
        "aggregate": aggregate, "decision": decision, "elapsed_ns": 144_000_000_001}


def expect_error(action: Any, message: str) -> None:
    try:
        action()
    except Exception:
        return
    raise KPreparationError(message)


def verify_publication_state(deadline: float, env: dict[str, str]) -> None:
    head = git(["rev-parse", "HEAD"], deadline, env).stdout.decode("ascii").strip()
    common = git_common_dir(deadline, env)
    require(not PUBLICATION_ONLY or EVALUATED_HEAD is not None, "publication lacks evaluated revision")
    require_ancestry(head, deadline, env, common, EVALUATED_HEAD)
    if PUBLICATION_ONLY:
        with tempfile.TemporaryDirectory(prefix="align-kprep-removal-") as raw:
            control = materialize(CONTROL_HEAD, Path(raw) / "control", deadline, env)
            current = materialize(head, Path(raw) / "current", deadline, env)
            validate_manifests(control["identity"]["source_files"], current["identity"]["source_files"], restored=True)


def self_test() -> int:
    validate_imported_contract()
    result = synthetic_result()
    validate_result(result)
    require(signed_median([-5, -4, -3, 100]) == -4, "signed median rounded toward zero")
    require(signed_median([MIN_I64, MIN_I64, MAX_I64, MAX_I64]) == -1,
            "signed median endpoint arithmetic drifted")
    ceiling = HISTORICAL_CEILING_NS
    # Absolute floor and historical equality both pass; a one-ns loss on either fails.
    require(gate([ceiling + FLOOR_NS] * 4, [ceiling] * 4)[1] == "MET", "gate equality failed")
    require(gate([ceiling + FLOOR_NS - 1] * 4, [ceiling] * 4)[1] == "NOT_MET", "below absolute floor passed")
    require(gate([ceiling + FLOOR_NS + 2] * 4, [ceiling + 1] * 4)[1] == "NOT_MET", "above historical ceiling passed")
    # Large alternating walls retain the historical candidate median but expose the
    # contemporary relative floor independently of the absolute floor.
    control = [10_000_000_000, 10_000_000_000, 40_000_000_000, 40_000_000_000]
    candidate = [9_000_000_000, 9_000_000_000, 9_000_000_000, 40_000_000_000 - 1]
    require(gate(control, candidate)[1] == "NOT_MET", "relative floor was not independently required")
    require(gate([20_000_000_000] * 4, [16_000_000_000] * 3 + [20_000_000_000])[1] == "NOT_MET",
            "zero paired saving passed")
    require(gate([20_000_000_000] * 4, [16_000_000_000] * 3 + [20_000_000_001])[1] == "NOT_MET",
            "negative paired saving passed")
    for invalid in (True, -1, 0, MAX_I64 + 1, 1.0):
        expect_error(lambda: gate([invalid] * 4, [1] * 4), "invalid gate wall accepted")
    require(integer(MAX_I64) and integer(MIN_I64, signed=True), "i64 endpoints rejected")
    require(not integer(MIN_I64 - 1, signed=True) and not integer(MAX_I64 + 1, signed=True),
            "i64 overflow accepted")
    for path, value in (
        (("schema_version",), True), (("kind",), "other"), (("pair_order",), ["BA"] * 4),
        (("pairs", 0, "index"), True), (("pairs", 0, "order"), "BA"),
        (("pairs", 0, "gain_ns"), 0), (("pairs", 0, "gain_ns"), MAX_I64 + 1),
        (("pairs", 0, "control", "full_helper_wall_ns"), 1),
        (("pairs", 0, "control", "isolation", "matching_between"), 1),
        (("pairs", 0, "candidate", "full", "lifetime", "contexts_freed"), 0),
        (("pairs", 0, "candidate", "full", "engine", "expert_cache_requests"), 1),
        (("pairs", 0, "candidate", "full", "output_sha256"), "0" * 64),
        (("pairs", 0, "candidate", "short", "token_ids"), [0]),
        (("pairs", 0, "candidate", "full", "phases", "elapsed_ns"), True),
        (("pairs", 0, "candidate", "full", "phases", "elapsed_ns"), -1),
        (("pairs", 0, "candidate", "full", "phases", "elapsed_ns"), MAX_I64 + 1),
        (("pairs", 0, "candidate", "full", "schema_version"), True),
        (("control", "align_llm_head"), "b" * 40),
        (("candidate", "shim_sha256"), "c" * 64),
        (("candidate", "helper_sha256"), "a" * 64),
        (("candidate", "source_tree"), "a" * 40),
        (("fixed_request", "compiler_sha256"), "0" * 64),
        (("environment", "host_fingerprint_sha256"), "0" * 64),
        (("aggregate", "positive_pairs"), True), (("decision",), "NOT_MET"),
        (("elapsed_ns",), 144_000_000_000 - 1), (("elapsed_ns",), CEILING_SECONDS * 1_000_000_000 + 1),
    ):
        malformed = deepcopy(result)
        target = malformed
        for component in path[:-1]:
            target = target[component]
        target[path[-1]] = value
        expect_error(lambda: validate_result(malformed), f"malformed field accepted: {path}")
    for path in ((), ("control",), ("pairs", 0), ("pairs", 0, "candidate"), ("aggregate",)):
        for extra in (False, True):
            malformed = deepcopy(result)
            target = malformed
            for component in path:
                target = target[component]
            if extra:
                target["unexpected"] = 0
            else:
                del target[next(iter(target))]
            expect_error(lambda: validate_result(malformed), "incorrect exact keys accepted")
    malformed = deepcopy(result)
    malformed["pairs"].pop()
    expect_error(lambda: validate_result(malformed), "incomplete pair count accepted")
    for mutation in ("missing", "reverse", "outside", "empty"):
        malformed = deepcopy(result)
        rows = malformed["candidate"]["source_files"]
        if mutation == "missing":
            rows.pop()
        elif mutation == "reverse":
            rows.reverse()
        elif mutation == "outside":
            next(row for row in rows if row["path"] == HELPER_SOURCE)["sha256"] = "0" * 64
        else:
            malformed["candidate"]["source_files"] = deepcopy(malformed["control"]["source_files"])
        expect_error(lambda: validate_result(malformed), "incorrect source delta accepted")
    validate_manifests(result["control"]["source_files"], result["control"]["source_files"], restored=True)
    expect_error(lambda: validate_manifests(result["control"]["source_files"], result["candidate"]["source_files"], restored=True),
                 "unremoved production accepted")
    validate_ancestry_state(b"", False, [0, 0])
    for refs, grafts, statuses in ((b"refs/replace/test", False, [0]), (b"", True, [0]), (b"", False, [0, 1])):
        expect_error(lambda: validate_ancestry_state(refs, grafts, statuses), "invalid ancestry accepted")

    # Exercise the real orchestration dispatcher: the chronological helper, shim and
    # loader-path identities must follow AB BA AB BA while arm arrays retain labels.
    calls = []
    builds = {arm: {"arm": arm} for arm in ("control", "candidate")}
    module = sys.modules[__name__]
    def measured_leg(built: dict[str, Any], _paths: Any, _env: Any, _deadline: Any, index: int) -> dict[str, Any]:
        calls.append(built["arm"])
        return deepcopy(result["pairs"][index - 1][built["arm"]])
    with mock.patch.object(module, "measure_leg", side_effect=measured_leg):
        measured = measure_pairs(builds, (), {}, 1)
    same(calls, [ARM_NAMES[symbol] for order in PAIR_ORDER for symbol in order], "build arm binding")
    same(measured, result["pairs"], "measured arm labels")

    actual_hash = base.file_sha256
    for changed in SOURCE_PATHS:
        with mock.patch.object(base, "file_sha256", side_effect=lambda path: "0" * 64 if path == changed else actual_hash(path)):
            expect_error(validate_imported_contract, "transitive source mutation accepted")
    with tempfile.TemporaryDirectory(prefix="align-kprep-owner-") as raw:
        tree = Path(raw) / "tree"
        (tree / "src").mkdir(parents=True)
        data = b"tracked\n"
        (tree / "src/test.align").write_bytes(data)
        blob = hashlib.sha1(b"blob 8\0" + data).hexdigest()
        inventory = {"src/test.align": ("100644", blob)}
        manifest(tree, inventory)
        (tree / "src/test.align").write_bytes(b"changed\n")
        expect_error(lambda: manifest(tree, inventory), "snapshot source mutation accepted")
        fake_root = Path(raw) / "root"
        fake_root.mkdir()
        root_binary = fake_root / HELPER_NAME
        root_binary.write_bytes(b"original")
        def changed_root() -> None:
            with mock.patch.object(module, "ROOT", fake_root), protect_root_artifacts(Path(raw)):
                root_binary.write_bytes(b"changed")
        expect_error(changed_root, "root artifact mutation accepted")
        require(root_binary.read_bytes() == b"original", "root artifact was not restored")
    with mock.patch.object(time, "monotonic_ns", return_value=CEILING_SECONDS * 1_000_000_000):
        require(complete_result_after_cleanup(result, 0)["elapsed_ns"] == CEILING_SECONDS * 1_000_000_000,
                "exact ceiling rejected")
    with mock.patch.object(time, "monotonic_ns", side_effect=[CEILING_SECONDS * 1_000_000_000, CEILING_SECONDS * 1_000_000_000 + 1]):
        expect_error(lambda: complete_result_after_cleanup(result, 0), "final validation overrun accepted")
    with mock.patch.object(time, "monotonic_ns", return_value=CEILING_SECONDS * 1_000_000_000 + 1):
        expect_error(lambda: complete_result_after_cleanup(result, 0), "cleanup overrun accepted")
    with mock.patch.object(module, "PUBLICATION_ONLY", True), mock.patch.object(sys, "argv", [str(RUNNER_PATH)]):
        expect_error(main, "removed candidate accepted real replay")
    with mock.patch.dict(os.environ, {}, clear=True), mock.patch("builtins.print") as printed:
        require(prerequisites() is None, "missing prerequisite did not return N/A")
    printed.assert_called_once_with(f"{LABEL}: N/A (ALIGN_LLM_OLMOE_MODEL unset)")
    env = transfer.phase.decision.decision_environment()
    env["GIT_NO_REPLACE_OBJECTS"] = "1"
    verify_publication_state(time.monotonic() + 30, env)
    print(f"{LABEL} self-test: PASS")
    return 0


def interrupted(number: int, _frame: object) -> None:
    owner.stop_owned_processes()
    raise SystemExit(128 + number)


if __name__ == "__main__":
    signal.signal(signal.SIGINT, interrupted)
    signal.signal(signal.SIGTERM, interrupted)
    try:
        raise SystemExit(main())
    except Exception as error:
        owner.stop_owned_processes()
        print(f"{LABEL}: FAIL {error}", file=sys.stderr)
        raise SystemExit(1)
