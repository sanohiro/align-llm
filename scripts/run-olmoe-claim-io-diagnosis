class ClaimIoError(RuntimeError):
    pass


def source_identities() -> tuple[str, ...]:
    return tuple(base.file_sha256(path) for path in SOURCE_PATHS)


def validate_imported_contract() -> None:
    actual = (
        compute.MODEL_BYTES, compute.MODEL_SHA256, compute.SERVER_BUILD, compute.BUDGET,
        compute.SEED, compute.FULL_TOKENS, compute.TEMPERATURE_MICROS,
        compute.FULL_OUTPUT_SHA256, compute.REPETITIONS, compute.CEILING_SECONDS,
        compute.EXPECTED_ALIGN_REVISION, compute.EXPECTED_COMPILER_SHA256,
        compute.EXPECTED_PACK_SHA256, compute.EXPECTED_GEOMETRY_SHA256,
        compute.EXPECTED_SERVER_SHA256, compute.EXPECTED_TASK_SHA256,
        compute.EXPECTED_PROMPT_SHA256, compute.EXPECTED_C_COMPILER_SHA256,
        compute.EXPECTED_C_COMPILER_VERSION_SHA256, compute.EXPECTED_LINKER_SEARCH_SHA256,
        compute.EXPECTED_GGML_LIBRARIES, compute.EXPECTED_GGML_HEADERS,
        compute.EXPECTED_BASELINE_HOST, compute.EXPECTED_BASELINE_HOST_SHA256,
    )
    expected = (
        MODEL_BYTES, MODEL_SHA256, SERVER_BUILD, BUDGET, SEED, FULL_TOKENS,
        TEMPERATURE_MICROS, FULL_OUTPUT_SHA256, REPETITIONS, CEILING_SECONDS,
        EXPECTED_ALIGN_REVISION, EXPECTED_COMPILER_SHA256, EXPECTED_PACK_SHA256,
        EXPECTED_GEOMETRY_SHA256, EXPECTED_SERVER_SHA256, EXPECTED_TASK_SHA256,
        EXPECTED_PROMPT_SHA256, EXPECTED_C_COMPILER_SHA256,
        EXPECTED_C_COMPILER_VERSION_SHA256, EXPECTED_LINKER_SEARCH_SHA256,
        EXPECTED_GGML_LIBRARIES, EXPECTED_GGML_HEADERS, EXPECTED_BASELINE_HOST,
        EXPECTED_BASELINE_HOST_SHA256,
    )
    if actual != expected:
        raise ClaimIoError("imported item 62 workload or environment drifted")
    if source_identities() != EXPECTED_SOURCE_IDENTITIES:
        raise ClaimIoError("item 64 imported source chain drifted")
    if diagnosis.integer_median(BASELINE_FULL_VALUES_NS) != BASELINE_FULL_MEDIAN_NS:
        raise ClaimIoError("item 62 full-helper baseline median drifted")
    expected_floor = (BASELINE_FULL_MEDIAN_NS * FLOOR_PPM + 999_999) // 1_000_000
    if expected_floor != FLOOR_NS:
        raise ClaimIoError("item 64 materiality floor drifted")


def inherited_record(record: dict[str, Any]) -> dict[str, Any]:
    inherited = dict(record)
    inherited.pop("claim_io")
    return inherited


def inherited_sample(sample: dict[str, Any]) -> dict[str, Any]:
    inherited = dict(sample)
    inherited["conditioning"] = inherited_record(sample["conditioning"])
    inherited["full"] = inherited_record(sample["full"])
    return inherited


def validate_helper_record(record: dict[str, Any], maximum_tokens: int) -> None:
    diagnosis.require_exact_keys(record, HELPER_KEYS, "helper record")
    compute.validate_helper_record(inherited_record(record), maximum_tokens)
    detail = record["claim_io"]
    if not isinstance(detail, dict):
        raise ClaimIoError("claim-I/O detail was not an object")
    diagnosis.require_exact_keys(detail, DETAIL_KEYS, "claim I/O")
    if any(not diagnosis.is_int(detail[name]) or detail[name] < 0 for name in DETAIL_KEYS):
        raise ClaimIoError("claim-I/O timing was invalid")
    if maximum_tokens == 2:
        if any(detail.values()):
            raise ClaimIoError("conditioning entered claim-I/O detail")
        return
    if any(detail[name] <= 0 for name in DETAIL_KEYS):
        raise ClaimIoError("full claim-I/O clock was not positive")
    if detail["total_ns"] != record["remaining_decode"]["claim_pread_ns"]:
        raise ClaimIoError("claim-I/O total did not match remaining decode")
    if sum(detail[name] for name in DETAIL_KEYS - {"total_ns"}) != detail["total_ns"]:
        raise ClaimIoError("claim-I/O detail did not partition its total")


def measure_request(
    helper: Path,
    model: Path,
    pack: Path,
    geometry: Path,
    maximum_tokens: int,
    runtime_env: dict[str, str],
    deadline: float,
) -> tuple[dict[str, Any], int]:
    started_ns = time.monotonic_ns()
    completed = owner.run_process(
        [str(helper), str(model), str(pack), str(geometry), diagnosis.PROMPT_TEXT,
         str(maximum_tokens), str(SEED)],
        deadline=deadline, maximum=240, env=runtime_env,
    )
    helper_wall_ns = time.monotonic_ns() - started_ns
    try:
        record = json.loads(completed.stdout.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as error:
        raise ClaimIoError("helper did not emit one JSON record") from error
    if not isinstance(record, dict):
        raise ClaimIoError("helper record was not an object")
    validate_helper_record(record, maximum_tokens)
    if helper_wall_ns < record["phases"]["elapsed_ns"]:
        raise ClaimIoError("helper wall interval did not contain helper elapsed")
    return record, helper_wall_ns


def validate_sample(sample: dict[str, Any], expected_index: int) -> None:
    compute.validate_sample(inherited_sample(sample), expected_index)
    validate_helper_record(sample["conditioning"], 2)
    validate_helper_record(sample["full"], FULL_TOKENS)


def validate_repeatability(samples: list[dict[str, Any]]) -> None:
    compute.validate_repeatability([inherited_sample(sample) for sample in samples])


def measure_sample(
    index: int,
    built: dict[str, Any],
    server: Path,
    model: Path,
    pack: Path,
    geometry: Path,
    clean_env: dict[str, str],
    deadline: float,
) -> dict[str, Any]:
    owner.require_no_matching_process(server, model, deadline, clean_env)
    conditioning, _ = measure_request(
        built["helper"], model, pack, geometry, 2, built["runtime_env"], deadline,
    )
    owner.require_no_matching_process(server, model, deadline, clean_env)
    try:
        full, full_wall = measure_request(
            built["helper"], model, pack, geometry, FULL_TOKENS,
            built["runtime_env"], deadline,
        )
    finally:
        owner.require_no_matching_process(server, model, deadline, clean_env)
    sample = {
        "index": index,
        "conditioning": conditioning,
        "full": full,
        "full_helper_wall_ns": full_wall,
        "isolation": {"matching_before": 0, "matching_between": 0, "matching_after": 0},
    }
    validate_sample(sample, index)
    return sample


def aggregate(samples: list[dict[str, Any]]) -> dict[str, Any]:
    if len(samples) != REPETITIONS:
        raise ClaimIoError("aggregate requires four samples")
    for index, sample in enumerate(samples, 1):
        validate_sample(sample, index)
    validate_repeatability(samples)
    bucket_values = {
        bucket: [sample["full"]["claim_io"][field] for sample in samples]
        for bucket, field in BUCKET_FIELDS.items()
    }
    bucket_medians = {
        bucket: diagnosis.integer_median(bucket_values[bucket]) for bucket in BUCKET_ORDER
    }
    selected = BUCKET_ORDER[0]
    for bucket in BUCKET_ORDER[1:]:
        if bucket_medians[bucket] > bucket_medians[selected]:
            selected = bucket
    selected_median = bucket_medians[selected]
    claim_io_median = diagnosis.integer_median(
        [sample["full"]["claim_io"]["total_ns"] for sample in samples]
    )
    if claim_io_median <= 0 or selected_median > claim_io_median:
        raise ClaimIoError("aggregate claim-I/O bounds drifted")
    decision = "MEASURED_BUCKET_ELIGIBLE" if selected_median >= FLOOR_NS \
        else "NO_MATERIAL_BUCKET"
    return {
        "full_helper_wall_median_ns": diagnosis.integer_median(
            [sample["full_helper_wall_ns"] for sample in samples]
        ),
        "claim_io_median_ns": claim_io_median,
        "bucket_values_ns": bucket_values,
        "bucket_medians_ns": bucket_medians,
        "selected_bucket": selected,
        "selected_bucket_median_ns": selected_median,
        "selected_bucket_share_ppm": selected_median * 1_000_000 // claim_io_median,
        "baseline_claim_io_median_ns": BASELINE_CLAIM_IO_MEDIAN_NS,
        "floor_ppm": FLOOR_PPM,
        "floor_ns": FLOOR_NS,
        "decision": decision,
    }


def validate_result(result: dict[str, Any]) -> None:
    diagnosis.require_exact_keys(result, TOP_KEYS, "result")
    if result["schema_version"] != 1 or result["status"] != "COMPLETE" \
            or result["artifact_kind"] != "R8_OLMOE_CLAIM_IO_DIAGNOSIS":
        raise ClaimIoError("result identity drifted")
    expected_baseline = {
        "full_helper_wall_values_ns": BASELINE_FULL_VALUES_NS,
        "full_helper_wall_median_ns": BASELINE_FULL_MEDIAN_NS,
        "claim_io_median_ns": BASELINE_CLAIM_IO_MEDIAN_NS,
        "floor_ppm": FLOOR_PPM,
        "floor_ns": FLOOR_NS,
    }
    diagnosis.require_exact_keys(result["baseline"], BASELINE_KEYS, "result baseline")
    if result["baseline"] != expected_baseline:
        raise ClaimIoError("result baseline drifted")
    diagnosis.require_exact_keys(result["aggregate"], AGGREGATE_KEYS, "result aggregate")
    if result["aggregate"] != aggregate(result["samples"]):
        raise ClaimIoError("result aggregate drifted")
    if not diagnosis.is_int(result["elapsed_ns"]) or result["elapsed_ns"] <= 0:
        raise ClaimIoError("result elapsed interval was invalid")


def prerequisites() -> tuple[Path, Path, Path, Path, Path, Path] | None:
    rows = (
        ("ALIGN_LLM_OLMOE_MODEL", base.configured_file("ALIGN_LLM_OLMOE_MODEL")),
        ("ALIGN_LLM_MOE_ALIGNPACK", base.configured_file("ALIGN_LLM_MOE_ALIGNPACK")),
        ("ALIGN_LLM_MOE_GEOMETRY", base.configured_file("ALIGN_LLM_MOE_GEOMETRY")),
        ("ALIGN_LLM_GGML_INCLUDE", base.configured_directory("ALIGN_LLM_GGML_INCLUDE")),
        ("ALIGN_LLM_GGML_LIB", base.configured_directory("ALIGN_LLM_GGML_LIB")),
        ("ALIGN_LLM_LLAMA_SERVER", base.configured_file("ALIGN_LLM_LLAMA_SERVER", executable=True)),
    )
    missing = next((name for name, path in rows if path is None), None)
    if missing is not None:
        print(f"R8-OLMOE-CLAIM-IO-DIAGNOSIS: N/A ({missing} unset)")
        return None
    return tuple(path.resolve() for _, path in rows)  # type: ignore[return-value]


def synthetic_samples(values: dict[str, int]) -> list[dict[str, Any]]:
    samples = compute.synthetic_samples({
        "EMBEDDING": 100, "ROUTING_PHASE_A": 100,
        "EXPERT_PHASE_B": 100, "OUTPUT_HEAD": 100,
    })
    total = sum(values.values())
    for sample in samples:
        sample["conditioning"]["claim_io"] = {name: 0 for name in DETAIL_KEYS}
        remaining = sample["full"]["remaining_decode"]
        old_total = remaining["claim_pread_ns"]
        delta = total - old_total
        remaining["claim_pread_ns"] = total
        remaining["pass_ns"] += delta
        phases = sample["full"]["engine_phases"]
        phases["remaining_decode_claim_pread_ns"] = total
        phases["remaining_decode_ns"] += delta
        sample["full"]["engine"]["claim_pread_ns"] += delta
        sample["full"]["engine"]["elapsed_ns"] += delta
        sample["full"]["phases"]["engine_wall_ns"] += delta
        sample["full"]["phases"]["elapsed_ns"] += delta
        sample["full_helper_wall_ns"] += delta
        sample["full"]["claim_io"] = {
            "total_ns": total,
            "file_pread_ns": values["FILE_PREAD"],
            "block_to_claim_copy_ns": values["BLOCK_TO_CLAIM_COPY"],
            "claim_to_cache_copy_ns": values["CLAIM_TO_CACHE_COPY"],
            "cache_to_claim_copy_ns": values["CACHE_TO_CLAIM_COPY"],
            "other_ns": values["OTHER_CLAIM_IO"],
        }
    return samples


def synthetic_result(samples: list[dict[str, Any]]) -> dict[str, Any]:
    inherited = compute.synthetic_result([inherited_sample(sample) for sample in samples])
    return {
        "schema_version": 1,
        "artifact_kind": "R8_OLMOE_CLAIM_IO_DIAGNOSIS",
        "status": "COMPLETE",
        "model": inherited["model"],
        "baseline": {
            "full_helper_wall_values_ns": BASELINE_FULL_VALUES_NS,
            "full_helper_wall_median_ns": BASELINE_FULL_MEDIAN_NS,
            "claim_io_median_ns": BASELINE_CLAIM_IO_MEDIAN_NS,
            "floor_ppm": FLOOR_PPM,
            "floor_ns": FLOOR_NS,
        },
        "candidate": inherited["candidate"],
        "task": inherited["task"],
        "environment": inherited["environment"],
        "samples": samples,
        "aggregate": aggregate(samples),
        "elapsed_ns": 1,
    }


def expect_error(action: Any, message: str) -> None:
    try:
        action()
    except Exception:
        return
    raise ClaimIoError(message)


def complete_result_after_cleanup(result: dict[str, Any], started_ns: int) -> dict[str, Any]:
    completed = dict(result)
    elapsed_ns = time.monotonic_ns() - started_ns
    if elapsed_ns > CEILING_SECONDS * 1_000_000_000:
        raise ClaimIoError(
            f"complete diagnosis exceeded its 8-minute ceiling ({elapsed_ns / 1e9:.1f}s)"
        )
    completed["elapsed_ns"] = elapsed_ns
    validate_result(completed)
    return completed


def self_test() -> int:
    validate_imported_contract()
    one = {bucket: 1 for bucket in BUCKET_ORDER}
    at_floor = dict(one)
    at_floor["BLOCK_TO_CLAIM_COPY"] = FLOOR_NS
    selected = aggregate(synthetic_samples(at_floor))
    if selected["selected_bucket"] != "BLOCK_TO_CLAIM_COPY" \
            or selected["decision"] != "MEASURED_BUCKET_ELIGIBLE":
        raise ClaimIoError("direct bucket at the floor did not select implementation work")
    below = {bucket: FLOOR_NS - 1 for bucket in BUCKET_ORDER}
    below_result = aggregate(synthetic_samples(below))
    if below_result["selected_bucket"] != BUCKET_ORDER[0] \
            or below_result["decision"] != "NO_MATERIAL_BUCKET":
        raise ClaimIoError("below-floor tie did not select no material bucket")
    result = synthetic_result(synthetic_samples(at_floor))
    validate_result(result)
    malformed = synthetic_samples(at_floor)
    malformed[0]["full"]["claim_io"]["file_pread_ns"] = True
    expect_error(lambda: aggregate(malformed), "boolean claim-I/O clock was accepted")
    malformed = synthetic_samples(at_floor)
    malformed[0]["full"]["claim_io"]["other_ns"] += 1
    expect_error(lambda: aggregate(malformed), "inexact claim-I/O partition was accepted")
    with mock.patch.object(base, "file_sha256", return_value="0" * 64):
        expect_error(validate_imported_contract, "transitive source drift was accepted")
    incomplete = dict(result)
    incomplete["elapsed_ns"] = 0
    with mock.patch.object(time, "monotonic_ns", return_value=2_000):
        finalized = complete_result_after_cleanup(incomplete, 1_000)
    if finalized["elapsed_ns"] != 1_000:
        raise ClaimIoError("cleanup-inclusive elapsed time was not finalized")
    with mock.patch.object(
        time, "monotonic_ns", return_value=CEILING_SECONDS * 1_000_000_000 + 1_001,
    ):
        expect_error(
            lambda: complete_result_after_cleanup(incomplete, 1_000),
            "post-cleanup ceiling excess was accepted",
        )
    with mock.patch.dict(os.environ, {}, clear=True), mock.patch("builtins.print") as printed:
        if prerequisites() is not None:
            raise ClaimIoError("missing prerequisites did not produce N/A")
    printed.assert_called_once_with(
        "R8-OLMOE-CLAIM-IO-DIAGNOSIS: N/A (ALIGN_LLM_OLMOE_MODEL unset)"
    )
    print("R8-OLMOE-CLAIM-IO-DIAGNOSIS self-test: PASS")
    return 0


def main() -> int:
    if sys.argv[1:] == ["--self-test"]:
        return self_test()
    if len(sys.argv) != 1:
        raise ClaimIoError("OLMoE claim-I/O diagnosis accepts no arguments")
    required = prerequisites()
    if required is None:
        return 0
    model, pack, geometry, include, library, server = required
    started_ns = time.monotonic_ns()
    deadline = time.monotonic() + CEILING_SECONDS

    with tempfile.TemporaryDirectory(prefix="align-r8-olmoe-claim-io-") as raw:
        work = Path(raw)
        clean_env = transfer.phase.decision.decision_environment()
        linker_search = transfer.phase.decision.validate_linker_search(clean_env)
        if linker_search:
            clean_env["LIBRARY_PATH"] = linker_search
        host_environment = transfer.qualification_host(clean_env, deadline)
        source_status = owner.run_process(
            ["git", "status", "--porcelain", "--untracked-files=all"],
            deadline=deadline, maximum=30, env=clean_env,
        )
        if source_status.stdout:
            raise ClaimIoError("real diagnosis requires a clean worktree")
        align_llm_head = owner.run_process(
            ["git", "rev-parse", "HEAD"], deadline=deadline, maximum=30, env=clean_env,
        ).stdout.decode("ascii").strip()
        validate_imported_contract()
        align_revision = (ROOT / ".align-revision").read_text(encoding="utf-8").strip()
        owner.require_no_matching_process(server, model, deadline, clean_env)
        if model.stat().st_size != MODEL_BYTES or base.file_sha256(model) != MODEL_SHA256:
            raise ClaimIoError("configured OLMoE GGUF does not have the pinned identity")
        pack_sha256 = base.file_sha256(pack)
        geometry_sha256 = base.file_sha256(geometry)
        server_sha256 = base.file_sha256(server)
        task_sha256 = base.file_sha256(diagnosis.TASK)
        prompt_sha256 = base.bytes_sha256(diagnosis.PROMPT_TEXT.encode("utf-8"))
        ggml_libraries = base.library_identities(library)
        ggml_headers = compute.predecessor.ggml_header_identities(include)
        if ggml_headers != EXPECTED_GGML_HEADERS:
            raise ClaimIoError("configured ggml header identity drifted")
        linker_search_sha256 = (
            None if not linker_search else base.bytes_sha256(linker_search.encode("utf-8"))
        )
        diagnosis.validate_external_identity(
            align_revision=align_revision, pack_sha256=pack_sha256,
            geometry_sha256=geometry_sha256, server_sha256=server_sha256,
            task_sha256=task_sha256, prompt_sha256=prompt_sha256,
            ggml_libraries=ggml_libraries, linker_search_sha256=linker_search_sha256,
        )
        version = owner.run_process(
            [str(server), "--version"], deadline=deadline, maximum=30, env=clean_env,
        )
        if SERVER_BUILD not in (version.stdout + version.stderr).decode("utf-8", "replace"):
            raise ClaimIoError("llama-server build identity drifted")

        with compute.other.predecessor.built_helper_for(
            work, include, library, clean_env, deadline,
            "src/olmoe_claim_io_gate.align", "olmoe_claim_io_gate", "olmoe-claim-io-gate",
        ) as built:
            diagnosis.validate_toolchain_identity(built)
            samples = []
            for index in range(1, REPETITIONS + 1):
                samples.append(
                    measure_sample(index, built, server, model, pack, geometry, clean_env, deadline)
                )
                validate_repeatability(samples)

            final_status = owner.run_process(
                ["git", "status", "--porcelain", "--untracked-files=all"],
                deadline=deadline, maximum=30, env=clean_env,
            )
            final_head = owner.run_process(
                ["git", "rev-parse", "HEAD"], deadline=deadline, maximum=30, env=clean_env,
            ).stdout.decode("ascii").strip()
            if final_status.stdout or final_head != align_llm_head:
                raise ClaimIoError("align-llm source changed during diagnosis")
            if source_identities() != EXPECTED_SOURCE_IDENTITIES:
                raise ClaimIoError("diagnosis sources changed during the run")
            owner.verify_identities((
                ("model", model, MODEL_SHA256), ("pack", pack, pack_sha256),
                ("geometry", geometry, geometry_sha256), ("server", server, server_sha256),
                ("task", diagnosis.TASK, task_sha256),
                ("compiler", built["compiler"], built["compiler_sha256"]),
                ("C compiler", built["c_compiler"], built["c_compiler_sha256"]),
                ("shim", built["shim"], built["shim_sha256"]),
                ("helper", built["helper"], built["helper_sha256"]),
            ))
            if base.library_identities(library) != ggml_libraries:
                raise ClaimIoError("ggml library identities changed during diagnosis")
            if compute.predecessor.ggml_header_identities(include) != ggml_headers:
                raise ClaimIoError("ggml headers changed during diagnosis")
            owner.require_no_matching_process(server, model, deadline, clean_env)

            task_document = json.loads(diagnosis.TASK.read_text(encoding="utf-8"))
            result = {
                "schema_version": 1,
                "artifact_kind": "R8_OLMOE_CLAIM_IO_DIAGNOSIS",
                "status": "COMPLETE",
                "model": {"bytes": MODEL_BYTES, "sha256": MODEL_SHA256, "architecture": "olmoe"},
                "baseline": {
                    "full_helper_wall_values_ns": BASELINE_FULL_VALUES_NS,
                    "full_helper_wall_median_ns": BASELINE_FULL_MEDIAN_NS,
                    "claim_io_median_ns": BASELINE_CLAIM_IO_MEDIAN_NS,
                    "floor_ppm": FLOOR_PPM,
                    "floor_ns": FLOOR_NS,
                },
                "candidate": {
                    "provider": "align-runtime", "align_llm_head": align_llm_head,
                    "align_revision": align_revision,
                    "compiler_sha256": built["compiler_sha256"],
                    "helper_sha256": built["helper_sha256"],
                    "shim_sha256": built["shim_sha256"], "ggml_libraries": ggml_libraries,
                    "ggml_headers": ggml_headers, "pack_sha256": pack_sha256,
                    "geometry_sha256": geometry_sha256, "cache_budget_bytes": BUDGET,
                },
                "task": {
                    "task_id": task_document["id"], "task_sha256": task_sha256,
                    "prompt_sha256": prompt_sha256, "maximum_tokens": FULL_TOKENS,
                    "temperature_micros": TEMPERATURE_MICROS, "seed": SEED,
                    "full_output_sha256": FULL_OUTPUT_SHA256,
                },
                "environment": {
                    **host_environment,
                    "c_compiler_sha256": built["c_compiler_sha256"],
                    "c_compiler_version_sha256": built["c_compiler_version_sha256"],
                    "linker_search_sha256": linker_search_sha256,
                },
                "samples": samples,
                "aggregate": aggregate(samples),
            }
    result = complete_result_after_cleanup(result, started_ns)
    elapsed_ns = result["elapsed_ns"]
    aggregate_result = result["aggregate"]
    print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))
    print(
        "R8-OLMOE-CLAIM-IO-DIAGNOSIS: COMPLETE "
        f"decision={aggregate_result['decision']} "
        f"selected={aggregate_result['selected_bucket']} "
        f"median={aggregate_result['selected_bucket_median_ns'] / 1e9:.3f}s "
        f"claim_io={aggregate_result['claim_io_median_ns'] / 1e9:.3f}s "
        f"elapsed={elapsed_ns / 1e9:.2f}s",
        file=sys.stderr,
    )
    return 0


def interrupted(signal_number: int, _frame: object) -> None:
    owner.stop_owned_processes()
    raise SystemExit(128 + signal_number)


if __name__ == "__main__":
    signal.signal(signal.SIGINT, interrupted)
    signal.signal(signal.SIGTERM, interrupted)
    try:
        raise SystemExit(main())
    except (
        ClaimIoError, OSError, ValueError, KeyError, TypeError, json.JSONDecodeError,
        subprocess.TimeoutExpired, owner.DiagnosisError,
    ) as error:
        owner.stop_owned_processes()
        print(f"R8-OLMOE-CLAIM-IO-DIAGNOSIS: FAIL {error}", file=sys.stderr)
        raise SystemExit(1)
