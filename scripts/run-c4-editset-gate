#!/usr/bin/env python3
"""Run the C4-REPAIR-EDITSET gate: 3 tasks x 2 variants x 2 paired samples, one repair each.

`docs/specs/c4-repair-editset.md` section 6.2 owns this contract. This is a named focused
qualification. It requires a running host `llama-server`, a 4.7 GB model, and a Linux container, so
it joins no aggregate: `make ci`, `hosted-checks`, and `capable-checks` do not reach it.

Topology, section 3.5. Validation runs in `bwrap` inside a Linux aarch64 container with the
repository bind-mounted. The derived `./main prompt generate` child runs in that same container and
dials `provider_control.endpoint`, which is `http://127.0.0.1:18080/...` and is **byte-identical to
the frozen C6 provider control**. A container-local `socat` forwarder binds that loopback address
and proxies to the host. The forwarder exists so that no machine-specific hostname ever reaches a
persisted artifact; it is run topology, recorded in this run's record, not corpus content.

Provider identity is checked twice and fails closed both times: on the host, before the container
starts, by comparing `scripts/probe-provider-service`'s document against the frozen generation
policy; and in band, by requiring each generation response's advertised model id to equal the
policy's model. Neither observes that the process answering the endpoint is the process whose
binary was hashed — section 3.5 states that residual risk rather than resolving it.

The gate verdict consumes `corpus_aggregate.repair_recovery_paired_count` and nothing else — the
identical predicate `docs/specs/c4-repair-measured.md` section 1.4 fixed, so the two runs are
directly comparable. The C6 acceptance verdict (`status`, `gate_eligible`) is recorded alongside as
secondary evidence and is explicitly not the C4 claim. A `NOT_MET` result is a delivered result: the
evidence is checked in exactly as a `MET` run's would be, and here it is directional — it would
answer that document's section 5.7 tie-breaker in the negative and move the next capability from
the adapter to the prompt.

**The addressable arm, stated before the run.** Six of the C4 run's ten repair attempts can carry a
non-empty `EDITSET` section: `record-codec-round-trip` x4 and `duration-half-away-from-zero`
PARENT x2. The other four are `layer-precedence-frozen-module`, where attempt one persists no edit
set. The reason is **not** that the response failed to parse — none did. On six of that task's
eight attempts the whole-file blocks reproduced the pinned files unchanged, so every hunk is empty,
`synthesized_patch` raises, and the adapter resets `edit_set`, `edit_set_total_bytes`, and
`patch_sha256` to `None` (`docs/specs/c4-repair-editset.md` section 11.3 deviation 14); on the
other two the response named `src/legacy.py`, outside the task's `allowed_edits`, and was rejected
as a `POLICY` violation. Either way the section's source is empty and the section is omitted, so a
validated edit set that briefly existed is discarded rather than shown — which is a recorded gap in
this capability, not a structural impossibility. `repair_editset_attempt_count` is the persisted
denominator; its expected value is 6, and a value below 6 means the drop ladder fired or a row
changed mode.

**Patch identity, reported and new.** `patch_sha256` makes "attempt two re-sent attempt one's
patch" a checkable fact rather than an inference from a byte count, which is all the C4 run could
say. The gate does not consume it; it is reported for every row that produced a patch on both
attempts.

**No speed claim of any kind.** The C4 run measured a 8.1x spread over 22 calls at temperature 0,
and the repair prompt is a strict textual extension of the attempt-one prompt, so prompt-cache reuse
is an uncontrolled confound. No timing is a gate input, a threshold, or a claim.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

HOST_ROOT = Path(__file__).resolve().parent.parent
CONTAINER_ROOT = "/work/align-llm"
DEFAULT_IMAGE = "c4-repair-measure:latest"
# Recorded before implementation, in the plan, and not raised after the fact. A run that exceeds
# it stops and the capability boundary is reconsidered.
COST_CEILING_SECONDS = 60 * 60
EVALUATION_ID = "c4e-measure"
# What the evaluation container needs so `bwrap` can build its namespaces. Named here rather than
# inlined so the run record can publish the exact grant it was given.
DOCKER_CONTAINMENT_PRIVILEGES = (
    "--cap-add=SYS_ADMIN",
    "--security-opt", "seccomp=unconfined",
    "--security-opt", "apparmor=unconfined",
    # Docker masks a set of `/proc` paths by default. `bwrap` re-mounts proc inside the user
    # namespace it was handed, which those masks refuse: the observed failure is
    # `Can't mount proc on /newroot/proc: Operation not permitted`, and it lands *after* the
    # generation call for the row is already paid for. `systempaths=unconfined` lifts exactly that
    # mask and is narrower than `--privileged`, which also works and grants far more.
    "--security-opt", "systempaths=unconfined",
)


class GateError(RuntimeError):
    """The run cannot proceed on the evidence available."""


def canonical_chunks(value: Any):
    if isinstance(value, dict):
        yield b"{"
        first = True
        for key, child in value.items():
            if child is None:
                continue
            if not first:
                yield b","
            first = False
            yield from canonical_chunks(key)
            yield b":"
            yield from canonical_chunks(child)
        yield b"}"
        return
    if isinstance(value, list):
        yield b"["
        for ordinal, child in enumerate(value):
            if ordinal:
                yield b","
            yield from canonical_chunks(child)
        yield b"]"
        return
    yield json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode("utf-8")


def canonical(value: Any) -> bytes:
    """The wire form the evaluator reads: an `Option::None` is written, not omitted."""
    def chunks(item: Any):
        if isinstance(item, dict):
            yield b"{"
            for ordinal, (key, child) in enumerate(item.items()):
                if ordinal:
                    yield b","
                yield json.dumps(key, ensure_ascii=False).encode("utf-8")
                yield b":"
                yield from chunks(child)
            yield b"}"
            return
        if isinstance(item, list):
            yield b"["
            for ordinal, child in enumerate(item):
                if ordinal:
                    yield b","
                yield from chunks(child)
            yield b"]"
            return
        yield json.dumps(item, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    return b"".join(chunks(value))


def bind(value: dict[str, Any]) -> dict[str, Any]:
    value["content_sha256"] = ""
    value["content_sha256"] = hashlib.sha256(b"".join(canonical_chunks(value))).hexdigest()
    return value


def raw_digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def load(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def run(command: list[str], **keywords: Any) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(command, capture_output=True, check=False, **keywords)


def git_head(repository: Path) -> str:
    completed = run(["git", "-C", str(repository), "rev-parse", "--verify", "HEAD"])
    if completed.returncode != 0:
        raise GateError(f"{repository} has no resolvable HEAD")
    return completed.stdout.decode("ascii").strip()


def git_clean(repository: Path) -> bool:
    completed = run([
        "git", "-C", str(repository), "status", "--porcelain=v1", "-z", "--untracked-files=all",
    ])
    return completed.returncode == 0 and completed.stdout == b""


# --------------------------------------------------------------------------------------------
# Host phase: provider identity, fail closed, before the container starts.
# --------------------------------------------------------------------------------------------


def verify_provider_probe(probe_path: Path, policy: dict[str, Any]) -> dict[str, Any]:
    probe = load(probe_path)
    if probe.get("artifact_kind") != "PROVIDER_SERVICE_PROBE" or probe.get("schema_version") != 1:
        raise GateError("the provider service probe header is invalid")
    claimed = probe.get("content_sha256")
    if not isinstance(claimed, str) or bind(dict(probe))["content_sha256"] != claimed:
        raise GateError("the provider service probe digest does not recompute")
    if probe.get("provider_service_revision") != policy.get("provider_service_revision"):
        raise GateError(
            "the probed provider service is not the one the generation policy records\n"
            f"  policy: {policy.get('provider_service_revision')}\n"
            f"  probe:  {probe.get('provider_service_revision')}"
        )
    return probe


def probe_endpoint_model(endpoint_host: str, port: int, expected_model: str) -> str:
    """The in-band half of the fail-closed pair: which model does the server say it serves?"""
    import urllib.error
    import urllib.request

    url = f"http://{endpoint_host}:{port}/v1/models"
    try:
        with urllib.request.urlopen(url, timeout=120) as response:
            document = json.loads(response.read().decode("utf-8"))
    except (urllib.error.URLError, OSError, ValueError) as failure:
        raise GateError(f"the provider endpoint did not answer a model query: {failure}") from None
    advertised = [item.get("id") for item in document.get("data", []) if isinstance(item, dict)]
    if expected_model not in advertised:
        raise GateError(
            "the answering server does not advertise the recorded model\n"
            f"  policy:     {expected_model}\n"
            f"  advertised: {advertised}"
        )
    return expected_model


# --------------------------------------------------------------------------------------------
# Request assembly. Every path in the request is a container path.
# --------------------------------------------------------------------------------------------


def build_request_inputs(root: Path, scope_relative: str, run_relative: str) -> dict[str, Any]:
    """Write the per-run inputs the evaluate request names, and return the request itself.

    The PARENT arm is the frozen `baseline-v1r` activation, whose effective variant is
    byte-identical to C6's. The CANDIDATE arm is lifted verbatim from the merged C6 evidence. So
    this run measures exactly the prompt pair C6 measured and differs from it only in the bounded
    repair attempt — which is what makes the two runs' attempt-1 arms comparable at all.
    """
    scope_path = root / scope_relative
    scope = load(scope_path)
    corpus = load(scope_path.parent / "corpus.json")
    baseline = load(scope_path.parent / "prompt-activation-baseline-v1e.json")
    frozen = load(root / "eval/prompt/gate/prompt-evaluation-improved.json")

    run_directory = root / run_relative
    # Clear only what this function owns. The derived generation child was already built into the
    # run directory by the caller, and the workspace must be empty because the evaluator's
    # preflight refuses to start against a workspace that is not.
    for owned in ("artifacts", "workspace"):
        if (run_directory / owned).exists():
            shutil.rmtree(run_directory / owned)
    (run_directory / "artifacts").mkdir(parents=True)
    workspace = run_directory / "workspace"
    workspace.mkdir()
    for stale in ("result.json", "evidence.json"):
        (run_directory / stale).unlink(missing_ok=True)

    baseline_relative = f"{scope_relative.rsplit('/', 1)[0]}/prompt-activation-baseline-v1e.json"
    experiment = dict(frozen["experiment_artifact"])
    experiment["experiment_id"] = "c4e-experiment"
    experiment["scope"] = scope
    experiment["parent_activation"] = {
        "artifact_kind": "PROMPT_ACTIVATION_RESULT",
        "path": baseline_relative,
        "artifact_id": baseline["decision_id"],
        "content_sha256": baseline["content_sha256"],
    }
    bind(experiment)
    (run_directory / "artifacts/experiment.json").write_bytes(canonical(experiment))

    preflight = bind({
        "schema_version": 1,
        "artifact_kind": "WORKSPACE_PREFLIGHT_REQUEST",
        "evaluation_id": EVALUATION_ID,
        "project_root": str(root),
        "workspace_path": str(workspace),
        "content_sha256": "",
    })
    (run_directory / "artifacts/preflight.json").write_bytes(canonical(preflight))

    # Both must be the *physical* files. The evaluator retains each declared executable through
    # `O_NOFOLLOW`, so a symlink is refused outright — and `/usr/bin/python3` is a symlink to
    # `python3.12` on this image. That is why the frozen environment policy declares both names.
    python_path = Path("/usr/bin/python3").resolve()
    git_path = Path("/usr/bin/git").resolve()
    helper_relative = "scripts/prompt-source-verifier.py"
    helper_digest = raw_digest(root / helper_relative)
    interpreter_digest = raw_digest(python_path)
    source_policy = bind({
        "schema_version": 1,
        "artifact_kind": "PROMPT_SOURCE_VERIFIER_POLICY",
        "policy_id": "c4e-source",
        "helper_path": helper_relative,
        "helper_sha256": helper_digest,
        "helper_runtime": f"CPYTHON:{interpreter_digest}:{helper_digest}",
        "interpreter_sha256": interpreter_digest,
        "git_executable_sha256": raw_digest(git_path),
        "content_sha256": "",
    })
    (run_directory / "artifacts/source-policy.json").write_bytes(canonical(source_policy))

    manifest_relative = f"{scope_relative.rsplit('/', 1)[0]}/corpus-file-set.manifest"
    align_repository = os.environ.get("C4_EDITSET_ALIGN_REPO", "/work/align")
    request = {
        "schema_version": 1,
        "artifact_kind": "PROMPT_EVALUATE_REQUEST",
        "evaluation_id": EVALUATION_ID,
        "project_root": str(root),
        "experiment_path": f"{run_relative}/artifacts/experiment.json",
        "parent_activation_path": baseline_relative,
        "corpus_path": f"{scope_relative.rsplit('/', 1)[0]}/corpus.json",
        "sample_count": 2,
        "acceptance_policy_path": "eval/prompt/canonical-v1/prompt-acceptance-policy.json",
        "workspace_path": str(workspace),
        "workspace_preflight_path": f"{run_relative}/artifacts/preflight.json",
        "verifier_align_llm_repository_path": str(root),
        "verifier_align_llm_commit": git_head(root),
        "verifier_align_repository_path": align_repository,
        "verifier_align_revision": (root / ".align-revision").read_text().strip(),
        "verifier_corpus_source_path": str(root),
        "verifier_corpus_source_kind": corpus["corpus_revision"]["source_kind"],
        "verifier_corpus_file_set_manifest_path": str(root / manifest_relative),
        "verifier_corpus_source_repository_id": corpus["corpus_revision"]["source_repository_id"],
        "verifier_corpus_source_sha256": corpus["corpus_revision"]["source_sha256"],
        "verifier_source_policy_path": f"{run_relative}/artifacts/source-policy.json",
        "verifier_source_policy_sha256": source_policy["content_sha256"],
        "verifier_python_executable_path": str(python_path),
        "verifier_git_executable_path": str(git_path),
        "evaluation_evidence_path": f"{run_relative}/evidence.json",
        "generation_child_path": str(run_directory / "main"),
        "generation_child_sha256": raw_digest(run_directory / "main"),
    }
    (run_directory / "evaluate-request.json").write_bytes(canonical(request))
    return request


# --------------------------------------------------------------------------------------------
# Verdict.
# --------------------------------------------------------------------------------------------


def gate_verdict(result: dict[str, Any]) -> tuple[str, dict[str, Any]]:
    corpus = result.get("corpus_aggregate") or {}
    paired = corpus.get("repair_recovery_paired_count", 0)
    return ("MET" if paired >= 1 else "NOT_MET"), corpus


def attempt_patch_digest(attempt: dict[str, Any] | None) -> str | None:
    if attempt is None:
        return None
    measurement = attempt.get("measurement") or {}
    return measurement.get("patch_sha256")


def attempt_edit_set_paths(attempt: dict[str, Any] | None) -> list[str] | None:
    if attempt is None:
        return None
    measurement = attempt.get("measurement") or {}
    blocks = measurement.get("edit_set")
    if blocks is None:
        return None
    return [block["path"] for block in blocks]


def row_report(result: dict[str, Any]) -> list[dict[str, Any]]:
    report = []
    for row in result.get("rows", []):
        attempts = row.get("attempts", [])
        first = attempts[0] if attempts else None
        second = attempts[1] if len(attempts) > 1 else None
        first_patch = attempt_patch_digest(first)
        second_patch = attempt_patch_digest(second)
        report.append({
            "task_id": row["task_id"],
            "sample_index": row["sample_index"],
            "variant": row["variant"],
            "attempt_1_status": attempts[0]["status"] if attempts else row["measurement"]["status"],
            "attempt_2_status": attempts[1]["status"] if len(attempts) > 1 else None,
            "attempt_2_skip_reason": (
                attempts[1].get("skip_reason") if len(attempts) > 1 else None
            ),
            "repair_loop_count": row.get("repair_loop_count"),
            "generation_to_passing_patch_ns": row.get("generation_to_passing_patch_ns"),
            "time_to_passing_patch_ns": row.get("time_to_passing_patch_ns"),
            "adapter_elapsed_ns": [item.get("adapter_elapsed_ns") for item in attempts],
            "adapter_overhead_ns": [item.get("adapter_overhead_ns") for item in attempts],
            "repair_prompt_sha256": (
                attempts[1].get("rendered_prompt_sha256") if len(attempts) > 1 else None
            ),
            "included_sections": (
                (second.get("repair_prompt_source") or {}).get("included_sections")
                if second is not None else None
            ),
            "dropped_sections": (
                (second.get("repair_prompt_source") or {}).get("dropped_sections")
                if second is not None else None
            ),
            "editset_included": (
                "EDITSET" in ((second.get("repair_prompt_source") or {}).get(
                    "included_sections") or [])
                if second is not None else None
            ),
            # The two facts the C4 run could not state. `patch_size_bytes` said only "the same
            # size"; these say whether the bytes were the same.
            "attempt_1_patch_size_bytes": (
                (first.get("measurement") or {}).get("patch_size_bytes") if first else None
            ),
            "attempt_2_patch_size_bytes": (
                (second.get("measurement") or {}).get("patch_size_bytes") if second else None
            ),
            "attempt_1_patch_sha256": first_patch,
            "attempt_2_patch_sha256": second_patch,
            "same_patch_resent": (
                first_patch == second_patch
                if first_patch is not None and second_patch is not None else None
            ),
            "attempt_1_edit_set_paths": attempt_edit_set_paths(first),
            "attempt_1_edit_set_total_bytes": (
                (first.get("measurement") or {}).get("edit_set_total_bytes") if first else None
            ),
        })
    return report


# --------------------------------------------------------------------------------------------
# Phases.
# --------------------------------------------------------------------------------------------


def in_container(values: argparse.Namespace) -> int:
    root = Path(CONTAINER_ROOT)
    scope_relative = values.scope
    run_relative = values.run_relative

    compiler = os.environ.get("C4_EDITSET_ALIGNC", "/tc/alignc")
    run_directory = root / run_relative
    run_directory.mkdir(parents=True, exist_ok=True)
    built = run(
        [str(root / "scripts/run-main-with-shim"), compiler, "build", str(root / "src/main.align")],
        cwd=str(run_directory),
    )
    if built.returncode != 0 or not (run_directory / "main").exists():
        sys.stderr.write(built.stderr.decode("utf-8", "replace")[-8192:])
        raise GateError("the derived generation child did not compile")

    if values.diagnose_sandbox:
        # The validation runner builds its own user namespace and hands the descriptor to
        # `bwrap --userns`. When that is unavailable every row dies as "contained validation runner
        # failed" *after* its generation call is already paid for, so this probe answers the
        # question for free, before any provider work.
        probe_source = (
            "import ctypes, os, subprocess, sys\n"
            "rc = ctypes.CDLL(None, use_errno=True).unshare(0x10000000)\n"
            "print('unshare(CLONE_NEWUSER) ->', rc, os.strerror(ctypes.get_errno()) if rc else 'ok')\n"
            "done = subprocess.run(['/usr/bin/bwrap', '--dev-bind', '/', '/', '--unshare-user',\n"
            "                       '--unshare-pid', '/usr/bin/true'], capture_output=True)\n"
            "print('bwrap --unshare-user ->', done.returncode,\n"
            "      done.stderr.decode('utf-8', 'replace').strip())\n"
            "print('max_user_namespaces:',\n"
            "      open('/proc/sys/user/max_user_namespaces').read().strip()\n"
            "      if os.path.exists('/proc/sys/user/max_user_namespaces') else 'absent')\n"
        )
        completed = run(["/usr/bin/python3", "-c", probe_source], cwd=str(root))
        sys.stdout.write(completed.stdout.decode("utf-8", "replace"))
        sys.stderr.write(completed.stderr.decode("utf-8", "replace"))
        return 0

    request = build_request_inputs(root, scope_relative, run_relative)
    started = time.monotonic()
    if values.diagnose:
        # `./main` requires the evaluator child to exit zero with empty stderr and reports only
        # `EVALUATION_FAILED` otherwise, which discards the one thing a failing run needs. This
        # mode runs the same reviewed evaluator directly so its diagnostics survive. It is a
        # debugging affordance, never the gate path: it does not publish and its output is not
        # evidence.
        completed = run(
            [
                "/usr/bin/python3", str(root / "scripts/prompt-evaluate.py"),
                "--request", str(run_directory / "evaluate-request.json"),
                "--final-result-relative", f"{run_relative}/result.json",
                "--final-evidence-relative", f"{run_relative}/evidence.json",
            ],
            cwd=str(root),
        )
        (run_directory / "diagnose-stdout.bin").write_bytes(completed.stdout)
        (run_directory / "diagnose-stderr.txt").write_bytes(completed.stderr)
        sys.stderr.write(completed.stderr.decode("utf-8", "replace")[-16384:])
        sys.stdout.write(f"diagnose: evaluator exit {completed.returncode}\n")
        return 0 if completed.returncode == 0 else 1
    completed = run(
        [
            str(run_directory / "main"), "prompt", "evaluate",
            str(run_directory / "evaluate-request.json"),
            f"{run_relative}/result.json",
        ],
        cwd=str(root),
    )
    elapsed = time.monotonic() - started
    sys.stdout.write(completed.stdout.decode("utf-8", "replace")[-8192:])
    sys.stderr.write(completed.stderr.decode("utf-8", "replace")[-8192:])
    (run_directory / "wall-clock-seconds").write_text(f"{elapsed:.3f}\n")
    if completed.returncode != 0:
        raise GateError(f"prompt evaluate failed with status {completed.returncode}")
    if elapsed > COST_CEILING_SECONDS:
        # Recorded before implementation. The run's result still stands; the ceiling breach is a
        # signal to reconsider the capability boundary, not to raise the ceiling after the fact.
        sys.stderr.write(
            f"run-c4-editset-gate: WARNING wall clock {elapsed:.0f}s exceeds the "
            f"{COST_CEILING_SECONDS}s recorded cost ceiling\n"
        )
    _ = request
    return 0


def on_host(values: argparse.Namespace) -> int:
    scope_path = HOST_ROOT / values.scope
    policy = load(scope_path.parent / "generation-policy.json")
    control = load(HOST_ROOT / "eval/prompt/canonical-v1/evaluation-provider-control.json")
    probe = verify_provider_probe(Path(values.provider_probe), policy)
    port = int(control["endpoint"].split(":")[2].split("/")[0])
    # The in-band half of the fail-closed pair runs here, on the host, so it dials the host's own
    # loopback. `--endpoint-host` names what the *container's* forwarder proxies to, which is a
    # container-side name and does not resolve out here.
    model = probe_endpoint_model("127.0.0.1", port, control["model"])

    out = Path(values.out)
    out.mkdir(parents=True, exist_ok=True)
    run_relative = "run/c4-editset-gate"
    align_repository = Path(
        os.environ.get(
            "C4_EDITSET_ALIGN_REPO_HOST",
            str(Path.home() / ".cache/align-llm/align/dev-v1"
                / (HOST_ROOT / ".align-revision").read_text().strip()),
        )
    )
    if not (align_repository / ".git").exists():
        raise GateError(f"no Align checkout at the pinned revision under {align_repository}")
    toolchain = Path(os.environ.get("C4_EDITSET_LINUX_TOOLCHAIN", str(HOST_ROOT.parent / "toolchain")))
    if not (toolchain / "alignc").exists():
        raise GateError(f"no Linux aarch64 compiler under {toolchain}")

    if not git_clean(HOST_ROOT):
        # Not fatal, and said out loud. Source reachability will not be VERIFIED, so the C6
        # acceptance `gate_eligible` cannot be true. The C4 gate does not consume it.
        sys.stderr.write(
            "run-c4-editset-gate: WARNING the align-llm checkout is not clean; source "
            "reachability will not verify and `gate_eligible` will be false. The C4 verdict "
            "consumes `repair_recovery_paired_count` only.\n"
        )

    # Every interpolated value is quoted for the shell, without exception. These are operator
    # inputs — a scope path, an output directory, a probe path, a host name — and one space or
    # quote in any of them would otherwise be re-split by `sh -lc` into a different command.
    def quoted(value: object) -> str:
        return shlex.quote(str(value))

    forwarder = (
        f"socat TCP-LISTEN:{quoted(port)},fork,reuseaddr,bind=127.0.0.1 "
        f"TCP:{quoted(values.endpoint_host)}:{quoted(port)} & sleep 1; "
    )
    driver = (
        f"exec /usr/bin/python3 {quoted(CONTAINER_ROOT + '/scripts/run-c4-editset-gate')} "
        f"--in-container "
        f"--scope {quoted(values.scope)} --run-relative {quoted(run_relative)} "
        f"--provider-probe {quoted(values.provider_probe)} --out {quoted(values.out)} "
        f"--endpoint-host {quoted(values.endpoint_host)}"
        + (" --diagnose" if values.diagnose else "")
        + (" --diagnose-sandbox" if values.diagnose_sandbox else "")
    )
    command = [
        "docker", "run", "--rm", "--platform", "linux/arm64",
        # `bwrap` is the containment boundary the validation runner executes every fixture command
        # inside, and it creates user, mount, and PID namespaces to do so. Docker's default seccomp
        # profile denies those outright, so without this the runner fails as "contained validation
        # runner failed" on every row, with the generation call already paid for.
        #
        # This widens the *evaluation container's* privileges, not the validation sandbox's:
        # `bwrap` still contains each fixture command exactly as it does outside Docker, and the
        # containment result is still checked and recorded per attempt. The container is a
        # disposable `--rm` sandbox holding only this repository, an Align checkout, and a
        # compiler. It is nonetheless a real privilege grant and is recorded as run topology.
        *DOCKER_CONTAINMENT_PRIVILEGES,
        "-v", f"{HOST_ROOT}:{CONTAINER_ROOT}",
        "-v", f"{align_repository}:/work/align:ro",
        "-v", f"{toolchain}:/tc:ro",
    ]
    # A linked worktree's `.git` is a file naming a common directory outside the mount, so the
    # source verifier's `git rev-parse` would fail inside the container with a bare bind of the
    # checkout. Mounting the resolved common directory read-only at its own absolute path is what
    # makes an ordinary clone and a linked worktree behave identically here.
    common = run(["git", "-C", str(HOST_ROOT), "rev-parse", "--git-common-dir"])
    if common.returncode == 0:
        resolved = Path(common.stdout.decode("utf-8").strip())
        if not resolved.is_absolute():
            resolved = (HOST_ROOT / resolved).resolve()
        if not str(resolved).startswith(str(HOST_ROOT)):
            command += ["-v", f"{resolved}:{resolved}:ro"]
    command += [
        "-w", CONTAINER_ROOT,
        "-e", "PYTHONDONTWRITEBYTECODE=1",
        values.image, "sh", "-lc", forwarder + driver,
    ]
    started = time.monotonic()
    completed = subprocess.run(command, check=False)
    elapsed = time.monotonic() - started
    if completed.returncode != 0:
        raise GateError(f"the containerized gate run failed with status {completed.returncode}")

    run_directory = HOST_ROOT / run_relative
    result = load(run_directory / "result.json")
    evidence = load(run_directory / "evidence.json")
    verdict, corpus = gate_verdict(result)
    record = {
        "schema_version": 1,
        "artifact_kind": "C4_EDITSET_GATE_RECORD",
        "gate_id": "c4-repair-editset-gate-v1",
        "verdict": verdict,
        "align_llm_commit": git_head(HOST_ROOT),
        "align_llm_clean": git_clean(HOST_ROOT),
        "align_revision": (HOST_ROOT / ".align-revision").read_text().strip(),
        "image": values.image,
        "docker_version": run(["docker", "version", "--format", "{{.Server.Version}}"])
        .stdout.decode("ascii").strip(),
        "forwarder": (
            f"socat TCP-LISTEN:{port},fork,reuseaddr,bind=127.0.0.1 "
            f"TCP:{values.endpoint_host}:{port}"
        ),
        "container_privileges": list(DOCKER_CONTAINMENT_PRIVILEGES),
        "provider_service_probe": probe,
        "in_band_model_id": model,
        "wall_clock_seconds": round(elapsed, 3),
        "cost_ceiling_seconds": COST_CEILING_SECONDS,
        "evaluation_status": result["status"],
        "gate_eligible": result["gate_eligible"],
        "corpus_aggregate": corpus,
        # Stated before the run and recorded with it: six of ten repair attempts are addressable,
        # so the expected `repair_editset_attempt_count` is 6.
        "addressable_repair_attempts": 6,
        "rows": row_report(result),
        "content_sha256": "",
    }
    bind(record)

    shutil.copyfile(run_directory / "result.json", out / "c4-editset-evaluation.json")
    shutil.copyfile(run_directory / "evidence.json", out / "c4-editset-evaluation-evidence.json")
    (out / "c4-editset-gate-record.json").write_bytes(
        (json.dumps(record, ensure_ascii=False, indent=2) + "\n").encode("utf-8")
    )
    _ = evidence
    rows = record["rows"]
    resent = [item for item in rows if item["same_patch_resent"] is True]
    changed = [item for item in rows if item["same_patch_resent"] is False]
    sys.stdout.write(
        f"run-c4-editset-gate: {verdict} "
        f"repair_recovery_paired_count={corpus.get('repair_recovery_paired_count')} "
        f"repair_attempt_count={corpus.get('repair_attempt_count')} "
        f"repair_recovery_count={corpus.get('repair_recovery_count')} "
        f"repair_editset_attempt_count={corpus.get('repair_editset_attempt_count')} "
        f"same_patch_resent={len(resent)} patch_changed={len(changed)} "
        f"wall_clock={elapsed:.0f}s\n"
    )
    for item in rows:
        sys.stdout.write(
            f"  {item['task_id']} s{item['sample_index']} {item['variant']}: "
            f"a1={item['attempt_1_status']}/{item['attempt_1_patch_size_bytes']}B "
            f"a2={item['attempt_2_status']}/{item['attempt_2_patch_size_bytes']}B "
            f"editset={item['editset_included']} same_patch={item['same_patch_resent']}\n"
        )
    return 0


def parse_arguments(arguments: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--scope", required=True)
    parser.add_argument("--provider-probe", required=True)
    parser.add_argument("--out", required=True)
    parser.add_argument("--image", default=DEFAULT_IMAGE)
    parser.add_argument("--endpoint-host", default="host.docker.internal")
    parser.add_argument("--in-container", action="store_true")
    parser.add_argument("--run-relative", default="run/c4-editset-gate")
    parser.add_argument(
        "--diagnose-sandbox", action="store_true",
        help="probe the container's user-namespace support and exit; makes no provider call",
    )
    parser.add_argument(
        "--diagnose", action="store_true",
        help="run the evaluator directly and surface its diagnostics; publishes nothing",
    )
    return parser.parse_args(arguments)


def main(arguments: list[str] | None = None) -> int:
    values = parse_arguments(sys.argv[1:] if arguments is None else arguments)
    try:
        return in_container(values) if values.in_container else on_host(values)
    except (GateError, OSError, ValueError, KeyError) as failure:
        sys.stderr.write(f"run-c4-editset-gate: ERROR {failure}\n")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
