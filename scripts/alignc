#!/usr/bin/env bash

set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ "${ALIGN_LLM_FRESH_COMPILER:-}" == "1" ]]; then
  if [[ "${ALIGNC:-}" != "/tools/fresh-alignc" ]]; then
    printf '%s\n' "fresh compiler launcher is not the authenticated path" >&2
    exit 1
  fi
  compiler="/tools/fresh-alignc"
elif [[ -n "${ALIGNC:-}" ]]; then
  compiler="${ALIGNC}"
elif [[ -n "${ALIGN_REPO:-}" ]]; then
  if [[ -x "${ALIGN_REPO}/target/release/alignc" ]]; then
    compiler="${ALIGN_REPO}/target/release/alignc"
  elif [[ -x "${ALIGN_REPO}/target/debug/alignc" ]]; then
    compiler="${ALIGN_REPO}/target/debug/alignc"
  else
    printf '%s\n' "alignc was not found in explicit ALIGN_REPO=${ALIGN_REPO}." >&2
    exit 127
  fi
else
  compiler="$("${project_root}/scripts/align-toolchain" ensure compiler)"
fi

exec "${compiler}" "$@"
