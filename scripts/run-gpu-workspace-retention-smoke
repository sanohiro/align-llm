#!/usr/bin/env bash
set -euo pipefail
if [ "$#" != 3 ]; then
  printf '%s\n' 'usage: run-gpu-workspace-retention-smoke GGML_SOURCE GGML_LIB GPU_PLUGIN' >&2
  exit 2
fi
root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
source_dir=$(realpath -- "$1")
library_dir=$(realpath -- "$2")
plugin=$(realpath -- "$3")
test -f "$source_dir/ggml/include/ggml.h"
test -f "$plugin"
work_dir=$(mktemp -d)
trap 'rm -r -- "$work_dir"' EXIT
for mode in ordinary reserve bind first; do
  flags=()
  if [ "$mode" = reserve ]; then flags+=(-DALIGN_GPU_FORCE_WORKSPACE_RETAIN_RESERVE=1); fi
  if [ "$mode" = bind ]; then flags+=(-DALIGN_GPU_FORCE_WORKSPACE_RETAIN_BIND=1); fi
  if [ "$mode" = first ]; then flags+=(-DALIGN_GPU_FORCE_ALLOCATION_PREFIX=1); fi
  native_link=()
  if [ -n "${WORKSPACE_RETAIN_NATIVE_SHIM:-}" ]; then
    native_dir=$(realpath -- "$WORKSPACE_RETAIN_NATIVE_SHIM")
    test -f "$native_dir/libalign_ggml_shim.so"
    flags+=(-DALIGN_LLM_NATIVE_CUDA=1)
    native_link+=(-L"$native_dir" -Wl,-rpath,"$native_dir" -lalign_ggml_shim)
  fi
  "${CC:-cc}" -std=c11 -O2 -Wall -Wextra -Werror -ffp-contract=off \
    -DALIGN_GGML_FP_CONTRACT_OFF=1 "${flags[@]}" \
    -I"$source_dir/ggml/include" "$root_dir/scripts/gpu_workspace_retention_smoke.c" \
    -L"$library_dir" -Wl,-rpath,"$library_dir" -lggml -lggml-base -lm -ldl "${native_link[@]}" \
    -o "$work_dir/$mode"
  "$work_dir/$mode" "$plugin"
done
