#!/usr/bin/env bash

set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
binary="${ALIGN_LLM_BIN:-${project_root}/main}"
corpus="${project_root}/eval/tasks/empty-invalid.json"
output_file="$(mktemp)"
trap 'rm -f "${output_file}"' EXIT

if [[ ! -x "${binary}" ]]; then
  make -C "${project_root}" build
fi

cd "${project_root}"
if "${binary}" --eval "${corpus}" >"${output_file}" 2>&1; then
  printf '%s\n' "empty evaluation corpus unexpectedly passed" >&2
  cat "${output_file}" >&2
  exit 1
fi

printf '%s\n' "empty evaluation corpus: rejected"
