#!/usr/bin/env python3
"""Copy a runtime tree without retaining symlinks or following directory cycles."""

from __future__ import annotations

import argparse
import errno
import os
import shutil
import stat
from pathlib import Path


def copy_entry(
    source: Path,
    target: Path,
    ancestors: frozenset[tuple[int, int]],
    regular_targets: dict[tuple[int, int], Path],
) -> None:
    try:
        value = source.stat()
    except OSError as error:
        if source.is_symlink() and error.errno in (errno.ENOENT, errno.ELOOP):
            return
        raise
    identity = (value.st_dev, value.st_ino)
    if stat.S_ISDIR(value.st_mode):
        if identity in ancestors:
            return
        target.mkdir(mode=stat.S_IMODE(value.st_mode))
        next_ancestors = ancestors | {identity}
        with os.scandir(source) as entries:
            ordered = sorted(entries, key=lambda entry: os.fsencode(entry.name))
        for entry in ordered:
            copy_entry(
                source / entry.name,
                target / entry.name,
                next_ancestors,
                regular_targets,
            )
        target.chmod(stat.S_IMODE(value.st_mode))
        return
    if stat.S_ISREG(value.st_mode):
        existing = regular_targets.get(identity)
        if existing is not None:
            os.link(existing, target, follow_symlinks=False)
            return
        shutil.copyfile(source, target, follow_symlinks=True)
        target.chmod(stat.S_IMODE(value.st_mode))
        regular_targets[identity] = target
        return
    raise RuntimeError(f"unsupported runtime entry: {source}")


def canonical(path: Path) -> Path:
    return Path(os.path.realpath(path))


def overlaps(first: Path, second: Path) -> bool:
    return first == second or first in second.parents or second in first.parents


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("paths", nargs="+", type=Path, metavar="SOURCE_OR_TARGET")
    arguments = parser.parse_args()
    if len(arguments.paths) % 2 != 0:
        parser.error("expected one or more SOURCE TARGET pairs")
    pairs = tuple(zip(arguments.paths[::2], arguments.paths[1::2], strict=True))
    canonical_sources = tuple(canonical(source) for source, _target in pairs)
    canonical_targets: list[Path] = []
    for _source, target in pairs:
        normalized = canonical(target)
        if any(
            overlaps(normalized, other)
            for other in canonical_targets
        ):
            parser.error("target roots must be distinct and non-overlapping")
        if any(overlaps(normalized, source) for source in canonical_sources):
            parser.error("source and target roots must be non-overlapping")
        canonical_targets.append(normalized)
    for _source, target in pairs:
        if target.exists(follow_symlinks=False):
            raise SystemExit(f"target already exists: {target}")

    regular_targets: dict[tuple[int, int], Path] = {}
    for source, target in pairs:
        copy_entry(source, target, frozenset(), regular_targets)
        if not target.exists(follow_symlinks=False):
            raise SystemExit(f"source did not materialize: {source}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
