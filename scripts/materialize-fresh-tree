#!/usr/bin/env python3
"""Copy a runtime tree without retaining symlinks or following directory cycles."""

from __future__ import annotations

import argparse
import errno
import os
import shutil
import stat
from pathlib import Path


def copy_entry(source: Path, target: Path, ancestors: frozenset[tuple[int, int]]) -> None:
    try:
        value = source.stat()
    except OSError as error:
        if source.is_symlink() and error.errno in (errno.ENOENT, errno.ELOOP):
            return
        raise
    identity = (value.st_dev, value.st_ino)
    if stat.S_ISDIR(value.st_mode):
        if identity in ancestors:
            return
        target.mkdir(mode=stat.S_IMODE(value.st_mode))
        next_ancestors = ancestors | {identity}
        with os.scandir(source) as entries:
            ordered = sorted(entries, key=lambda entry: os.fsencode(entry.name))
        for entry in ordered:
            copy_entry(source / entry.name, target / entry.name, next_ancestors)
        target.chmod(stat.S_IMODE(value.st_mode))
        return
    if stat.S_ISREG(value.st_mode):
        shutil.copyfile(source, target, follow_symlinks=True)
        target.chmod(stat.S_IMODE(value.st_mode))
        return
    raise RuntimeError(f"unsupported runtime entry: {source}")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("source", type=Path)
    parser.add_argument("target", type=Path)
    arguments = parser.parse_args()
    if arguments.target.exists(follow_symlinks=False):
        raise SystemExit("target already exists")
    copy_entry(arguments.source, arguments.target, frozenset())
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
