#!/usr/bin/python3
"""Transfer the authenticated ordinary worker to the image-owned controller.

The dispatcher snapshots this file into sealed FD 13.  This small carrier
checks the capsule's worker, nonce, source-tree, and queued-proof bindings,
then replaces itself with the authenticated generic controller from the same
source snapshot.  It never owns the bwrap edge or produces semantic output.
"""

from __future__ import annotations

import base64
import hashlib
import json
import os
import stat
import sys
from collections import OrderedDict
from typing import Any


CAPSULE_LIMIT = 1_048_576
WORKER_LIMIT = 4_194_304
NONCE_LIMIT = 32
MAX_FILE_BYTES = 4_194_304
MAX_PATH_BYTES = 4096
MAX_ENTRIES = 1_500_000
MAX_TREE_BYTES = 48 * 1024 * 1024 * 1024
REQUIRED_FDS = {0, 1, 2, 4, 12, 13, 15, 16, 18}
EXPECTED_ENVIRONMENT = {
    "PATH": "/usr/bin:/bin",
    "LC_ALL": "C",
    "HOME": "/nonexistent",
    "TMPDIR": "/tmp",
    "PYTHONHOME": "/usr",
    "PYTHONNOUSERSITE": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
}
REQUIRED_ARGS = (
    "--mode", "ordinary-adoption", "--project-root-fd", "4", "--align-root-fd", "18",
    "--capsule-fd", "12", "--invocation-nonce-fd", "15", "--supervisor-channel-fd", "16",
)


def fail() -> None:
    os.write(2, b"json-scan adoption: ERROR toolchain\n")
    raise SystemExit(2)


def _render(value: Any, level: int = 0) -> str:
    if value is None:
        return "null"
    if value is True:
        return "true"
    if value is False:
        return "false"
    if isinstance(value, int) and not isinstance(value, bool):
        if value < 0:
            fail()
        return str(value)
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False, separators=(",", ":"))
    if isinstance(value, list):
        if not value:
            return "[]"
        indent = " " * (2 * (level + 1))
        closing = " " * (2 * level)
        return "[\n" + ",\n".join(indent + _render(item, level + 1) for item in value) + "\n" + closing + "]"
    if isinstance(value, OrderedDict):
        if not value:
            return "{}"
        indent = " " * (2 * (level + 1))
        closing = " " * (2 * level)
        return "{\n" + ",\n".join(
            indent + _render(key) + ": " + _render(child, level + 1)
            for key, child in value.items()
        ) + "\n" + closing + "}"
    fail()
    raise AssertionError


def canonical(value: Any) -> bytes:
    return (_render(value) + "\n").encode("utf-8", "strict")


def _b64(raw: bytes) -> str:
    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode("ascii")


def _read(fd: int, limit: int) -> bytes:
    try:
        before = os.fstat(fd)
        if not stat.S_ISREG(before.st_mode) or before.st_size < 0 or before.st_size > limit:
            fail()
        chunks: list[bytes] = []
        offset = 0
        while offset < before.st_size:
            block = os.pread(fd, min(65_536, before.st_size - offset), offset)
            if not block:
                fail()
            chunks.append(block)
            offset += len(block)
        after = os.fstat(fd)
    except OSError:
        fail()
    if (
        before.st_dev, before.st_ino, before.st_mode, before.st_nlink, before.st_size,
    ) != (
        after.st_dev, after.st_ino, after.st_mode, after.st_nlink, after.st_size,
    ):
        fail()
    return b"".join(chunks)


def _open_relative(root_fd: int, path: str, flags: int) -> int:
    parts = os.fsencode(path).split(b"/")
    if not parts or len(path.encode("utf-8")) > MAX_PATH_BYTES or any(
        part in (b"", b".", b"..") or b"\x00" in part for part in parts
    ):
        fail()
    current = os.dup(root_fd)
    retained = [current]
    try:
        for part in parts[:-1]:
            current = os.open(
                part, os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=current
            )
            retained.append(current)
        descriptor = os.open(parts[-1], flags | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=current)
        return descriptor
    except OSError:
        fail()
    finally:
        for descriptor in retained:
            try:
                os.close(descriptor)
            except OSError:
                pass
    raise AssertionError


def _descriptor_set() -> set[int]:
    directory_fd = os.open("/proc/self/fd", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        result: set[int] = set()
        for name in os.listdir(directory_fd):
            if not name.isdigit():
                continue
            fd = int(name)
            if fd != directory_fd:
                result.add(fd)
        return result
    finally:
        os.close(directory_fd)


def _raw_tree(root_fd: int) -> bytes:
    root = os.open(b".", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=root_fd)
    entries: list[OrderedDict[str, object]] = []
    total = 0

    def append(path: bytes, kind: str, mode: int, size: int, raw: bytes, target: bytes = b"") -> None:
        nonlocal total
        total += len(raw)
        if len(entries) >= MAX_ENTRIES or total > MAX_TREE_BYTES:
            fail()
        entries.append(
            OrderedDict(
                (
                    ("path_b64", _b64(path)),
                    ("kind", kind),
                    ("mode", f"{stat.S_IMODE(mode):04o}"),
                    ("size", size),
                    ("sha256", hashlib.sha256(raw).hexdigest()),
                    ("target_b64", _b64(target)),
                )
            )
        )

    root_value = os.fstat(root)
    append(b"", "dir", root_value.st_mode, 0, b"")

    def visit(parent: int, prefix: tuple[bytes, ...]) -> None:
        try:
            names = sorted((os.fsencode(name) for name in os.listdir(parent)))
        except OSError:
            fail()
        for name in names:
            if not prefix and name in (b".git", b"HANDOFF.md", b"target", b"main"):
                continue
            path = (*prefix, name)
            path_raw = b"/".join(path)
            if not name or name in (b".", b"..") or b"\x00" in name or len(path_raw) > MAX_PATH_BYTES:
                fail()
            try:
                value = os.stat(name, dir_fd=parent, follow_symlinks=False)
            except OSError:
                fail()
            if stat.S_ISDIR(value.st_mode):
                child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=parent)
                try:
                    before = os.fstat(child)
                    if (before.st_dev, before.st_ino, before.st_mode, before.st_uid) != (
                        value.st_dev, value.st_ino, value.st_mode, value.st_uid
                    ):
                        fail()
                    append(path_raw, "dir", value.st_mode, 0, b"")
                    visit(child, path)
                    after = os.fstat(child)
                    if (before.st_dev, before.st_ino, before.st_mode, before.st_uid) != (
                        after.st_dev, after.st_ino, after.st_mode, after.st_uid
                    ):
                        fail()
                finally:
                    os.close(child)
            elif stat.S_ISREG(value.st_mode):
                if value.st_nlink != 1 or value.st_uid != os.geteuid():
                    fail()
                descriptor = os.open(name, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=parent)
                try:
                    before = os.fstat(descriptor)
                    raw = _read(descriptor, MAX_FILE_BYTES)
                    if before != os.fstat(descriptor) or len(raw) != value.st_size:
                        fail()
                    append(path_raw, "file", value.st_mode, len(raw), raw)
                finally:
                    os.close(descriptor)
            elif stat.S_ISLNK(value.st_mode):
                try:
                    target = os.fsencode(os.readlink(name, dir_fd=parent))
                except OSError:
                    fail()
                if not target or len(target) > MAX_PATH_BYTES or b"\x00" in target:
                    fail()
                append(path_raw, "symlink", value.st_mode, len(target), target, target)
            else:
                fail()

    try:
        visit(root, ())
    finally:
        os.close(root)
    return canonical(OrderedDict((("schema", "raw-tree/v1"), ("source", "project-source"), ("entries", entries))))


def _parse_capsule(raw: bytes) -> OrderedDict[str, Any]:
    try:
        envelope = json.loads(raw.decode("utf-8", "strict"), object_pairs_hook=OrderedDict)
        if tuple(envelope) != ("payloadType", "payload", "signatures"):
            fail()
        payload = envelope["payload"]
        if not isinstance(payload, str) or not payload or "=" in payload:
            fail()
        predicate_raw = base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4))
        predicate = json.loads(predicate_raw.decode("utf-8", "strict"), object_pairs_hook=OrderedDict)
    except (ValueError, TypeError, UnicodeError, json.JSONDecodeError):
        fail()
    if envelope["payloadType"] != "https://align-llm.dev/attestations/ordinary-adoption/v2":
        fail()
    if not isinstance(envelope["signatures"], list) or len(envelope["signatures"]) != 1:
        fail()
    if not isinstance(predicate, OrderedDict):
        fail()
    return predicate


def _run_controller(raw: bytes) -> None:
    try:
        code = compile(raw, "scripts/fresh-align-compiler", "exec")
    except (SyntaxError, ValueError):
        fail()
    globals()["__file__"] = "scripts/fresh-align-compiler"
    exec(code, globals(), globals())


def main() -> int:
    if tuple(sys.argv[1:]) != REQUIRED_ARGS or dict(os.environ) != EXPECTED_ENVIRONMENT:
        fail()
    descriptors = _descriptor_set()
    if descriptors != REQUIRED_FDS:
        fail()
    capsule = _read(12, CAPSULE_LIMIT)
    worker = _read(13, WORKER_LIMIT)
    nonce = _read(15, NONCE_LIMIT)
    if len(nonce) != NONCE_LIMIT:
        fail()
    predicate = _parse_capsule(capsule)
    if (
        predicate.get("worker_size") != len(worker)
        or predicate.get("worker_sha256") != hashlib.sha256(worker).hexdigest()
        or predicate.get("worker_relative") != "scripts/run-json-scan-row-ownership-adoption"
        or predicate.get("invocation_nonce") != _b64(nonce)
        or predicate.get("project_raw_tree_sha256") != hashlib.sha256(_raw_tree(4)).hexdigest()
    ):
        fail()
    try:
        import socket
        channel = socket.socket(fileno=16)
        proof, _, flags, _ = channel.recvmsg(33, socket.MSG_PEEK)
        if flags & socket.MSG_TRUNC or len(proof) != 32:
            fail()
        expected = hashlib.sha256(
            b"align-llm/ordinary-adoption/worker-admission/v2\x00"
            + bytes.fromhex(predicate["dispatch_ticket_sha256"])
            + nonce
            + hashlib.sha256(capsule).digest()
        ).digest()
        if proof != expected:
            fail()
    except (OSError, ValueError, KeyError):
        fail()
    generic = _open_relative(4, "scripts/fresh-align-compiler", os.O_RDONLY)
    try:
        value = os.fstat(generic)
        if not stat.S_ISREG(value.st_mode) or value.st_nlink != 1 or stat.S_IMODE(value.st_mode) != 0o755:
            fail()
        generic_raw = _read(generic, MAX_FILE_BYTES)
    finally:
        os.close(generic)
    _run_controller(generic_raw)
    return 127


if __name__ == "__main__":
    raise SystemExit(main())
