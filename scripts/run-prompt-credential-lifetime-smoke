#!/usr/bin/env python3
"""Owner smoke for the C6e credential lifetime.

It proves the four ledger cells: `MISSING_CREDENTIAL` precedence before the first external call,
the credential travelling only as the explicit `api_key` argument of the single provider call, no
credential byte in any persisted or printed output on success or on any terminal error path, and
the ordinary `api_key_env: None` run that performs no environment read at all.

Every fixture response in the `/credential/...` family deliberately echoes the credential value
back at the client, so a missing redaction pass shows up as a real leak rather than as an absence.
"""

from __future__ import annotations

import pathlib
import sys
import tempfile

sys.dont_write_bytecode = True
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from prompt_experiment_fixture import (  # noqa: E402
    CREDENTIAL_VALUE,
    CREDENTIAL_VARIABLE,
    closed_port,
    invoke,
    prepare,
    require,
    start_server,
    stop_server,
)

# Terminal rows driven with the credential present. Each entry is a fixture path, the expected
# terminal status, and its expected error code.
TERMINAL_ROWS = (
    ("proposed", "/credential/echo-summary", "PROPOSED", "NONE"),
    ("proposal-schema", "/credential/echo-schema", "INVALID_PROPOSAL", "PROPOSAL_SCHEMA"),
    ("proposal-bounds", "/credential/echo-bounds", "INVALID_PROPOSAL", "PROPOSAL_BOUNDS"),
    ("proposal-no-change", "/credential/echo-no-change", "INVALID_PROPOSAL", "PROPOSAL_NO_CHANGE"),
    ("provider-status", "/credential/echo-status", "PROVIDER_ERROR", "PROVIDER_HTTP_STATUS"),
    ("provider-over-cap", "/credential/echo-over-cap", "PROVIDER_ERROR",
     "PROVIDER_RESPONSE_TOO_LARGE"),
)


def assert_no_credential(name: str, *values: str) -> None:
    for index, value in enumerate(values):
        require(
            CREDENTIAL_VALUE not in value,
            f"{name}: the credential leaked into observable output #{index}",
        )
        # The redaction pass replaces the complete value, so no proper prefix may survive either.
        require(
            CREDENTIAL_VALUE[:12] not in value,
            f"{name}: a credential prefix leaked into observable output #{index}",
        )


def observed(case) -> tuple[str, ...]:
    artifact = ""
    if case.result_path.is_file():
        artifact = case.result_path.read_text(encoding="utf-8", errors="replace")
    return (artifact, case.request_path.read_text(encoding="utf-8", errors="replace"))


def assert_single_explicit_argument(name: str, requests: list[dict]) -> None:
    require(len(requests) == 1, f"{name}: expected exactly one provider call, saw {len(requests)}")
    call = requests[0]
    require(
        call["authorization"] == f"Bearer {CREDENTIAL_VALUE}",
        f"{name}: the credential is not the explicit api_key argument: {call['authorization']!r}",
    )
    require(
        CREDENTIAL_VALUE.encode("utf-8") not in call["body"],
        f"{name}: the credential was copied into the request body",
    )
    require(
        CREDENTIAL_VALUE not in call["path"],
        f"{name}: the credential was copied into the request path",
    )


def missing_credential_precedence(root: pathlib.Path, server) -> None:
    """`MISSING_CREDENTIAL` is decided before the first external call, and only after the earlier
    section 5 checks have passed."""
    endpoint = f"{server.base}/credential/echo-summary"
    before = server.connections

    for name, environment in (
        ("credential-unset", None),
        ("credential-empty", {CREDENTIAL_VARIABLE: ""}),
    ):
        case = prepare(root, name, endpoint, api_key_env=CREDENTIAL_VARIABLE)
        completed = case.run(environment=environment)
        require(completed.returncode == 2, f"{name}: expected failure")
        result = case.result()
        require(
            result["status"] == "INVALID_INPUT" and result["error_code"] == "MISSING_CREDENTIAL",
            f"{name}: expected MISSING_CREDENTIAL, got {result['status']}/{result['error_code']}",
        )
        require(
            result["bounded_provider_output"] == "" and result["proposal_elapsed_ns"] == 0
            and "proposal_status_code" not in result and "candidate_variant" not in result,
            f"{name}: a pre-call failure must record no provider outcome: {result!r}",
        )

    # An earlier failing check still wins: the credential name is never even reached.
    case = prepare(root, "credential-after-opportunity", endpoint,
                   api_key_env=CREDENTIAL_VARIABLE, opportunity_path="absent.json")
    case.run()
    result = case.result()
    require(
        result["error_code"] == "INPUT_NOT_FOUND",
        f"credential-after-opportunity: expected INPUT_NOT_FOUND, got {result['error_code']}",
    )

    require(
        server.connections == before,
        "a MISSING_CREDENTIAL row contacted the provider listener",
    )


def terminal_rows(root: pathlib.Path, server) -> None:
    for name, path, status, error_code in TERMINAL_ROWS:
        before = len(server.requests)
        case = prepare(root, f"terminal-{name}", f"{server.base}{path}",
                       api_key_env=CREDENTIAL_VARIABLE)
        completed = case.run(environment={CREDENTIAL_VARIABLE: CREDENTIAL_VALUE})
        result = case.result()
        require(
            result["status"] == status and result["error_code"] == error_code,
            f"{name}: expected {status}/{error_code}, got"
            f" {result['status']}/{result['error_code']} ({result['error']})",
        )
        assert_single_explicit_argument(name, server.requests[before:])
        assert_no_credential(name, completed.stdout, completed.stderr, *observed(case))
        if status == "PROPOSED":
            require(
                "[REDACTED]" in result["proposal_summary"],
                f"{name}: the echoed credential was not replaced in the persisted summary",
            )
            require(
                result["bounded_provider_output"] == "",
                f"{name}: a successful proposal must retain no provider response bytes",
            )
        elif error_code in {"PROPOSAL_SCHEMA", "PROPOSAL_BOUNDS", "PROVIDER_HTTP_STATUS"}:
            require(
                "[REDACTED]" in result["bounded_provider_output"],
                f"{name}: the echoed credential was not replaced in the persisted diagnostics",
            )


def transport_rows(root: pathlib.Path, server) -> None:
    """Terminal transport failures never see a response body, but still must not print or persist
    the credential they were handed."""
    case = prepare(root, "terminal-timeout", f"{server.base}/credential/stall",
                   api_key_env=CREDENTIAL_VARIABLE, timeout_ns=500_000_000)
    before = len(server.requests)
    completed = case.run(environment={CREDENTIAL_VARIABLE: CREDENTIAL_VALUE})
    result = case.result()
    require(result["error_code"] == "PROVIDER_TIMEOUT",
            f"terminal-timeout: expected PROVIDER_TIMEOUT, got {result['error_code']}")
    assert_single_explicit_argument("terminal-timeout", server.requests[before:])
    assert_no_credential("terminal-timeout", completed.stdout, completed.stderr, *observed(case))
    server.release.set()

    refused = f"http://127.0.0.1:{closed_port()}/credential/echo-summary"
    case = prepare(root, "terminal-transport", refused,
                   api_key_env=CREDENTIAL_VARIABLE, timeout_ns=5_000_000_000)
    completed = case.run(environment={CREDENTIAL_VARIABLE: CREDENTIAL_VALUE})
    result = case.result()
    require(result["error_code"] == "PROVIDER_TRANSPORT",
            f"terminal-transport: expected PROVIDER_TRANSPORT, got {result['error_code']}")
    assert_no_credential("terminal-transport", completed.stdout, completed.stderr, *observed(case))

    # The credential owner is dropped before result construction, so a publication failure after a
    # valid terminal result still prints and persists nothing of it.
    case = prepare(root, "terminal-output-write", f"{server.base}/credential/echo-summary",
                   api_key_env=CREDENTIAL_VARIABLE)
    completed = case.run(environment={CREDENTIAL_VARIABLE: CREDENTIAL_VALUE},
                         limit_file_size=True)
    require("\nOUTPUT_WRITE\n" in completed.stdout,
            f"terminal-output-write: expected OUTPUT_WRITE, got {completed.stdout!r}")
    require(case.result_path.stat().st_size == 0,
            "terminal-output-write: a partial artifact must never survive")
    assert_no_credential("terminal-output-write", completed.stdout, completed.stderr,
                         *observed(case))


def uncredentialed_row(root: pathlib.Path, server) -> None:
    """`api_key_env: None` performs no environment read and passes an empty `api_key`; the empty
    redaction pattern returns provider text unchanged."""
    before = len(server.requests)
    case = prepare(root, "uncredentialed", f"{server.base}/credential/echo-summary")
    completed = case.run(environment={CREDENTIAL_VARIABLE: CREDENTIAL_VALUE})
    result = case.result()
    require(result["status"] == "PROPOSED",
            f"uncredentialed: expected PROPOSED, got {result['status']}/{result['error_code']}")
    calls = server.requests[before:]
    require(len(calls) == 1, f"uncredentialed: expected one provider call, saw {len(calls)}")
    require(calls[0]["authorization"] is None,
            f"uncredentialed: no Authorization header may be sent: {calls[0]['authorization']!r}")
    # The environment variable is set for this process, but an `api_key_env: None` request never
    # reads it, so the empty pattern leaves the echoed provider text verbatim.
    require(CREDENTIAL_VALUE in result["proposal_summary"],
            "uncredentialed: an empty pattern must return the provider text unchanged")
    require("[REDACTED]" not in result["proposal_summary"],
            "uncredentialed: an empty pattern must not replace anything")
    require(completed.returncode == 0, "uncredentialed: expected success")


def main() -> None:
    server, thread = start_server()
    try:
        with tempfile.TemporaryDirectory() as directory:
            root = pathlib.Path(directory).resolve()
            missing_credential_precedence(root, server)
            terminal_rows(root, server)
            transport_rows(root, server)
            uncredentialed_row(root, server)
    finally:
        stop_server(server, thread)

    print(
        "prompt credential lifetime smoke: MISSING_CREDENTIAL precedence with no listener contact, "
        "one explicit api_key argument per call, no credential byte in any persisted result, "
        "diagnostic, or stream on success and on every terminal error path, and the ordinary "
        "api_key_env: None empty-pattern run PASS"
    )


if __name__ == "__main__":
    main()
