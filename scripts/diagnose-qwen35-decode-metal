#!/usr/bin/env python3
"""Independent Metal dispatch census and invalid-output projection-cost probe."""
import argparse
import collections
import hashlib
import http.client
import json
import os
from pathlib import Path
import re
import socket
import statistics
import subprocess
import tempfile
import time


ROOT = Path(__file__).resolve().parent.parent
SYSTEM = 'You are a coding assistant. Return a concise patch-oriented answer.'
USER = 'List the integers from 1 to 1000 in ascending order, separated by single spaces. Output only the integers. ' + 'hello ' * (200 - 56)
KERNEL = re.compile(r'^Q35_KERNEL label=(.* groups=.* threads=.*)$')
GRAPH = re.compile(r'^Q35_PROJ_DIAG kind=(\d+) skip=(\d+) projection_index=(-?\d+) nodes=(\d+) elapsed_ns=(\d+) status=(-?\d+)$')


def digest(path):
    with Path(path).open('rb') as source:
        return hashlib.file_digest(source, 'sha256').hexdigest()


def verified_bundle(directory):
    manifest_path = Path(directory) / 'manifest.json'
    manifest = json.loads(manifest_path.read_text())
    if manifest.get('artifact_kind') != 'GPU_BACKEND_BUNDLE' or not manifest.get('bundle_id'):
        raise ValueError('invalid backend bundle manifest')
    artifacts = manifest.get('artifacts')
    if type(artifacts) is not list or not artifacts:
        raise ValueError('backend bundle has no artifacts')
    for item in artifacts:
        path = item.get('path')
        if type(path) is not str or Path(path).is_absolute() or '..' in Path(path).parts:
            raise ValueError('invalid bundle artifact path')
        candidate = Path(directory) / path
        if candidate.stat().st_size != item['bytes'] or digest(candidate) != item['sha256']:
            raise ValueError('backend bundle artifact identity differs')
    return dict(bundle_id=manifest['bundle_id'], manifest_sha256=digest(manifest_path))


def build_probes(include, directory):
    dispatch = ROOT / 'scripts/trace-qwen35-metal-dispatch.m'
    prune = ROOT / 'scripts/diagnose-qwen35-projection-prune.c'
    built = {key: directory / (key + '.dylib') for key in ('align', 'llama', 'prune')}
    common = ['clang', '-O2', '-dynamiclib', '-undefined', 'dynamic_lookup']
    objc = ['-fobjc-arc', '-framework', 'Foundation', '-framework', 'Metal']
    subprocess.run([*common, *objc, str(dispatch), '-o', str(built['align'])], check=True)
    subprocess.run([*common, *objc, '-DQ35_TRACE_LLAMA', str(dispatch), '-o', str(built['llama'])], check=True)
    subprocess.run([*common, '-I', str(include), str(prune), '-o', str(built['prune'])], check=True)
    return built


def clean_environment():
    return {key: value for key, value in os.environ.items()
            if not key.startswith(('DYLD_', 'GGML_', 'ALIGN_LLM_PREFILL_', 'ALIGN_LLM_NATIVE_', 'ALIGN_Q35_'))}


def prepare_fixture(cfg, fixture, directory):
    ids = json.loads(fixture.read_text())
    if type(ids) is not list or len(ids) != 200 or any(type(token) is not int or token < 0 for token in ids):
        raise ValueError('expected exactly 200 nonnegative token IDs')
    system = directory / 'system.txt'
    user = directory / 'user.txt'
    system.write_text(SYSTEM)
    user.write_text(USER)
    arm = cfg['candidate']
    env = dict(clean_environment(), DYLD_LIBRARY_PATH=arm['lib'])
    actual = json.loads(subprocess.check_output(
        [arm['binary'], '--prepare-prompt', cfg['model'], str(system), str(user)], env=env))
    if actual != ids:
        raise ValueError('fixed prompt ID fixture differs from this tokenizer')
    input_ids = directory / 'prompt-ids.json'
    input_ids.write_text(json.dumps(ids, separators=(',', ':')) + '\n')
    rendered = directory / 'rendered-prompt.txt'
    rendered.write_bytes(subprocess.check_output(
        [arm['binary'], '--detokenize', cfg['model'], str(input_ids), 'render-control'], env=env))
    return input_ids, rendered


def ready(process, port):
    started = time.monotonic()
    while time.monotonic() - started < 30:
        if process.poll() is not None:
            raise RuntimeError(f'Align server exited before ready: {process.returncode}')
        try:
            connection = http.client.HTTPConnection('127.0.0.1', port, timeout=1)
            connection.request('GET', '/v1/models')
            response = connection.getresponse()
            response.read()
            connection.close()
            if response.status == 200:
                return
        except (OSError, http.client.HTTPException):
            time.sleep(0.05)
    raise TimeoutError('Align server readiness')


def server(cfg, trace, name, directory, skip=None):
    with socket.socket() as sock:
        sock.bind(('127.0.0.1', 0))
        port = sock.getsockname()[1]
    arm = cfg['candidate']
    log_path = directory / (name + '.log')
    log = log_path.open('w+b')
    env = dict(clean_environment(), DYLD_LIBRARY_PATH=arm['lib'], DYLD_INSERT_LIBRARIES=str(trace),
               ALIGN_LLM_NATIVE_SWIGLU='0', ALIGN_LLM_SYNC_WEIGHT_UPLOAD='0',
               ALIGN_LLM_PREFILL_CHUNK='128', ALIGN_LLM_PREFILL_FINAL_LOGITS='1',
               ALIGN_LLM_PREFILL_LAST_FFN_ROW='0')
    if skip is not None:
        env['ALIGN_Q35_PROJECTION_SKIP'] = str(skip)
    process = subprocess.Popen([arm['binary'], '--serve-openai', cfg['model'], cfg['pack'],
                                cfg['geometry'], arm['options'], '0', 'decode-attribution', str(port)],
                               env=env, stdout=log, stderr=log)
    try:
        ready(process, port)
    except BaseException:
        stop(process, log)
        raise
    return process, port, log, log_path


def stop(process, log):
    if process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()
    log.close()


def request(port):
    body = dict(model='decode-attribution', temperature=0, max_tokens=2, stream=False,
                messages=[dict(role='system', content=SYSTEM), dict(role='user', content=USER)])
    connection = http.client.HTTPConnection('127.0.0.1', port, timeout=180)
    started = time.monotonic_ns()
    try:
        connection.request('POST', '/v1/chat/completions', json.dumps(body),
                           {'Content-Type': 'application/json'})
        response = connection.getresponse()
        payload = response.read()
        elapsed = time.monotonic_ns() - started
        if response.status != 200:
            raise ValueError(f'HTTP {response.status}: {payload[:200]!r}')
        result = json.loads(payload)
        if result['usage'] != {'prompt_tokens': 200, 'completion_tokens': 2, 'total_tokens': 202}:
            raise ValueError('actual token work differs')
        return dict(request_ns=elapsed, usage=result['usage'],
                    output=result['choices'][0]['message']['content'])
    finally:
        connection.close()


def kernels(lines):
    return [match.group(1) for line in lines if (match := KERNEL.match(line))]


def census(cfg, probes, input_ids, rendered, directory):
    process, port, log, align_log = server(cfg, probes['align'], 'align-dispatch', directory)
    try:
        outputs = [request(port)['output'] for _ in range(2)]
        if outputs[0] != outputs[1]:
            raise ValueError('Align repeated output differs')
    finally:
        stop(process, log)
    sections = []
    current = None
    for line in align_log.read_text(errors='replace').splitlines():
        if line.startswith('Q35_GRAPH_BEGIN'):
            current = []
            sections.append(current)
        elif line.startswith('Q35_GRAPH_END'):
            current = None
        elif current is not None and KERNEL.match(line):
            current.append(KERNEL.match(line).group(1))
    if len(sections) != 6 or sections[0] != sections[3] or sections[1] != sections[4] or sections[2] != sections[5]:
        raise ValueError('Align graph dispatch sequence changed')
    reference_log = directory / 'llama-dispatch.log'
    env = dict(clean_environment(), DYLD_INSERT_LIBRARIES=str(probes['llama']))
    with reference_log.open('wb') as output:
        subprocess.run([cfg['llama'], cfg['model'], str(rendered), str(input_ids), '2'],
                       env=env, stdout=output, stderr=subprocess.STDOUT, timeout=180, check=True)
    lines = reference_log.read_text(errors='replace').splitlines()
    result_lines = [line for line in lines if line.startswith('iteration=')]
    if len(result_lines) != 3 or not all('prompt=200 ' in line for line in result_lines):
        raise ValueError('reference did not complete three equal-token iterations')
    ids_text = result_lines[-1].split('ids=', 1)[1]
    generated = [int(token) for token in ids_text.split(',') if token]
    if len(generated) != 2:
        raise ValueError('reference generated token count differs')
    tokens = directory / 'llama-generated-ids.json'
    tokens.write_text(json.dumps(generated) + '\n')
    text = subprocess.check_output([cfg['candidate']['binary'], '--detokenize', cfg['model'],
                                    str(tokens), 'render-control'],
                                   env=dict(clean_environment(), DYLD_LIBRARY_PATH=cfg['candidate']['lib'])).decode()
    if text != outputs[-1]:
        raise ValueError('normal Align/reference rendered output differs')
    all_reference = kernels(lines)
    ends = [index for index, label in enumerate(all_reference)
            if label.startswith('kernel_mul_mv_q6_K_f32 groups=')]
    if len(ends) != 6:
        raise ValueError('reference projection count differs')
    reference = all_reference[ends[4] + 1:ends[5] + 1]
    align = sections[-1]
    left, right = collections.Counter(align), collections.Counter(reference)
    return dict(align_dispatches=len(align), llama_dispatches=len(reference),
                identical_signatures=sum((left & right).values()),
                align_signatures=dict(sorted(left.items())),
                llama_signatures=dict(sorted(right.items())),
                align_only=dict(sorted((left - right).items())),
                llama_only=dict(sorted((right - left).items())),
                normal_rendered_output=text, reference_generated_ids=generated)


def projection_pairs(cfg, probe, directory, expected_output):
    servers = []
    try:
        for name, skip in (('full', 0), ('skip', 1)):
            servers.append((name, *server(cfg, probe, 'prune-' + name, directory, skip=skip)))
        rows = []
        for repetition in range(7):
            pair = {}
            for index in ((0, 1) if repetition % 2 == 0 else (1, 0)):
                name, process, port, log, path = servers[index]
                log.seek(0, os.SEEK_END)
                before = log.tell()
                row = request(port)
                if name == 'full' and row['output'] != expected_output:
                    raise ValueError('unpruned diagnostic output differs from the normal reference')
                log.flush()
                log.seek(before)
                lines = log.read().decode('utf-8', 'replace').splitlines()
                log.seek(0, os.SEEK_END)
                graphs = [match.groups() for line in lines if (match := GRAPH.match(line))]
                decode = [record for record in graphs if record[0] in ('1', '2')]
                if len(graphs) != 3 or len(decode) != 1 or decode[0][1] != str(index) or decode[0][-1] != '0':
                    raise ValueError(f'{name} graph trace incomplete')
                row.update(decode_graph_ns=int(decode[0][4]), nodes=int(decode[0][3]),
                           projection_index=int(decode[0][2]))
                if row['nodes'] != 1110 or row['projection_index'] != 1109:
                    raise ValueError('the diagnostic would prune a different graph')
                pair[name] = row
            rows.append(pair)
        measured = rows[2:]
        delta = [(pair['full']['decode_graph_ns'] - pair['skip']['decode_graph_ns']) / 1e6
                 for pair in measured]
        return dict(warmups=rows[:2], pairs=measured,
                    full_median_ms=statistics.median(pair['full']['decode_graph_ns'] for pair in measured) / 1e6,
                    pruned_median_ms=statistics.median(pair['skip']['decode_graph_ns'] for pair in measured) / 1e6,
                    paired_delta_ms=delta, paired_delta_median_ms=statistics.median(delta))
    finally:
        for name, process, port, log, path in servers:
            stop(process, log)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--config', type=Path, required=True,
                        help='same model/pack/geometry and candidate/llama binaries as measure-host-reuse')
    parser.add_argument('--ggml-include', type=Path, required=True)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--diagnostic-dir', type=Path, required=True)
    parser.add_argument('--input-ids', type=Path,
                        default=ROOT / 'eval/fixtures/qwen35-decode-attribution-200-ids.json')
    args = parser.parse_args()
    if args.output.exists() or args.diagnostic_dir.exists():
        parser.error('output and diagnostic directory must be new')
    cfg = json.loads(args.config.read_text())
    args.diagnostic_dir.mkdir(parents=True)
    built = build_probes(args.ggml_include, args.diagnostic_dir)
    input_ids, rendered = prepare_fixture(cfg, args.input_ids, args.diagnostic_dir)
    dispatch = census(cfg, built, input_ids, rendered, args.diagnostic_dir)
    projection = projection_pairs(cfg, built['prune'], args.diagnostic_dir,
                                  dispatch['normal_rendered_output'])
    report = dict(schema_version=1, status='DIAGNOSTIC_ONLY',
                  model_sha256=digest(cfg['model']),
                  pack_sha256=digest(cfg['pack']),
                  geometry_sha256=digest(cfg['geometry']),
                  options_sha256=digest(cfg['candidate']['options']),
                  backend_bundle=verified_bundle(cfg['candidate']['lib']),
                  align_sha256=digest(cfg['candidate']['binary']),
                  llama_sha256=digest(cfg['llama']),
                  fixture_sha256=digest(args.input_ids),
                  inputs=dict(prompt_tokens=200, completion_tokens=2,
                              native_swiglu='0', sync_weight_upload='0',
                              prefill_chunk='128', final_prefill_logits='1', final_ffn_row='0'),
                  dispatch=dispatch, projection=projection,
                  raw_sha256={name: digest(args.diagnostic_dir / name)
                              for name in ('align-dispatch.log', 'llama-dispatch.log',
                                           'prune-full.log', 'prune-skip.log')},
                  limitation='Instrumented clocks and intentionally invalid output cannot support a speed adoption claim.')
    args.output.write_text(json.dumps(report, indent=2) + '\n')
    print('decode attribution diagnostic PASS:', len(dispatch['align_signatures']),
          'Align signatures,', len(dispatch['llama_signatures']), 'llama signatures,',
          len(projection['pairs']), 'timed pairs')


if __name__ == '__main__':
    main()
