#!/usr/bin/env python3
"""Run the batched, non-aggregate FRESH-WORKER closure qualification."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path

from signal_subprocess import signal_subprocess_owner


REPOSITORY = Path(__file__).resolve().parent.parent
SPECIFICATION = REPOSITORY / "docs/specs/check-gate-topology.md"
WORKER = REPOSITORY / "scripts/fresh-align-compiler"
IMAGE_DOCKERFILE = REPOSITORY / "image/fresh/Dockerfile"

FOCUSED_CHECKS = (
    ("run-fresh-attestation-wire-smoke", ("fresh-v2-attestation-wire-golden",)),
    (
        "run-fresh-manifest-wire-smoke",
        (
            "fresh-v2-manifest-format-smoke",
            "fresh-v2-digest-tree-golden",
            "fresh-v2-cache-manifest-golden",
        ),
    ),
    (
        "run-fresh-source-manifest-wire-smoke",
        (
            "fresh-v2-source-manifest-golden",
            "fresh-v2-source-manifest-symlink-golden",
            "fresh-v2-source-manifest-object-format-golden",
        ),
    ),
    ("run-fresh-source-identity-smoke", ("fresh-v2-source-identity-smoke",)),
    (
        "run-fresh-image-control-smoke",
        (
            "fresh-v2-image-trust-smoke",
            "fresh-v2-run-attestation-smoke",
            "fresh-v2-pre-dispatch-source-smoke",
        ),
    ),
    ("run-fresh-focused-adoption-smoke", ("fresh-v2-focused-adoption-request-smoke",)),
    (
        "run-fresh-worker-unit-smoke",
        (
            "fresh-v2-bwrap-trust-smoke",
            "fresh-v2-tool-identity-smoke",
            "fresh-v2-runtime-closure-smoke",
            "fresh-v2-cache-smoke",
            "fresh-v2-root-staging-smoke",
            "fresh-v2-descriptor-file-smoke",
            "fresh-v2-cleanup-smoke",
            "fresh-v2-cleanup-failure-smoke",
            "fresh-v2-status-grammar-smoke",
        ),
    ),
    (
        "run-coding-task-resource-scan-smoke",
        ("fresh-v2-process-lifecycle-smoke",),
    ),
    ("run-baseline-failure-smoke", ("fresh-v2-baseline-scratch-smoke",)),
    ("check-gate-topology --self-test", ("fresh-v2-aggregate-topology-smoke",)),
)

EXPECTED_CASES = {
    "fresh-v2-image-trust-smoke",
    "fresh-v2-run-attestation-smoke",
    "fresh-v2-pre-dispatch-source-smoke",
    "fresh-v2-bootstrap-snapshot-smoke",
    "fresh-v2-attestation-wire-golden",
    "fresh-v2-manifest-format-smoke",
    "fresh-v2-digest-tree-golden",
    "fresh-v2-cache-manifest-golden",
    "fresh-v2-source-manifest-golden",
    "fresh-v2-source-manifest-symlink-golden",
    "fresh-v2-source-manifest-object-format-golden",
    "fresh-v2-focused-adoption-request-smoke",
    "fresh-v2-source-identity-smoke",
    "fresh-v2-bwrap-trust-smoke",
    "fresh-v2-tool-identity-smoke",
    "fresh-v2-runtime-closure-smoke",
    "fresh-v2-cache-smoke",
    "fresh-v2-root-staging-smoke",
    "fresh-v2-temp-root-callsite-smoke",
    "fresh-v2-aggregate-publication-smoke",
    "fresh-v2-build-namespace-smoke",
    "fresh-v2-descriptor-file-smoke",
    "fresh-v2-direct-interposition-smoke",
    "fresh-v2-callsite-smoke",
    "fresh-v2-interpreter-boundary-smoke",
    "fresh-v2-aggregate-topology-smoke",
    "fresh-v2-process-lifecycle-smoke",
    "fresh-v2-cleanup-smoke",
    "fresh-v2-cleanup-failure-smoke",
    "fresh-v2-baseline-scratch-smoke",
    "fresh-v2-status-grammar-smoke",
    "fresh-v2-baseline-integration-smoke",
    "fresh-v2-concurrency-smoke",
    "fresh-v2-platform-profile-smoke",
}

# These cases require the complete product graph inside the authenticated worker rather than a
# narrow native owner or the installed image/profile boundary itself. They remain available through
# the explicit complete audit, but routine PR evidence does not rerun the common functional graph on
# both architectures. Generated-output ELF closure is deliberately absent: the native worker unit
# owner exercises the production parser and dependency validator, and the installed ordinary
# adoption compiles and executes real Align fixtures on each required architecture.
COMPLETE_AGGREGATE_CASES = {
    "fresh-v2-temp-root-callsite-smoke",
    "fresh-v2-aggregate-publication-smoke",
    "fresh-v2-callsite-smoke",
    "fresh-v2-interpreter-boundary-smoke",
    "fresh-v2-baseline-integration-smoke",
}

FIXED_CHILD_PATH = "/usr/bin:/bin"
INSTALLED_OWNER = "run-fresh-image-profile-smoke"
AGGREGATE_DIAGNOSTIC_VARIABLE = "ALIGN_LLM_AGGREGATE_DIAGNOSTIC"
SIGNAL_CLEANUP_SECONDS = 4.5
QUALIFICATION_SIGNALS = tuple(
    selected
    for selected in (
        getattr(signal, "SIGHUP", None),
        signal.SIGINT,
        getattr(signal, "SIGQUIT", None),
        signal.SIGTERM,
    )
    if selected is not None
)


def qualification_environment(owner: str) -> dict[str, str]:
    environment = {
        "PATH": qualification_path(owner),
        "LC_ALL": "C",
        "HOME": "/nonexistent",
        "PYTHONDONTWRITEBYTECODE": "1",
    }
    # Only the installed-profile owner can reach the explicit complete aggregate audit, so only it
    # needs the aggregate diagnostic opt-in. Forwarding the variable to every focused owner would
    # widen the qualified environment of targets that cannot consume it.
    if owner == INSTALLED_OWNER and os.environ.get(AGGREGATE_DIAGNOSTIC_VARIABLE) == "1":
        environment[AGGREGATE_DIAGNOSTIC_VARIABLE] = "1"
    return environment


def emit_phase(owner: str, status: str, duration_ms: int | None = None) -> None:
    record: dict[str, object] = {
        "event": "fresh-qualification-phase",
        "owner": owner,
        "status": status,
    }
    if duration_ms is not None:
        record["duration_ms"] = duration_ms
    print(json.dumps(record, sort_keys=True, separators=(",", ":")), file=sys.stderr)


def qualification_path(owner: str) -> str:
    if owner != INSTALLED_OWNER:
        return FIXED_CHILD_PATH
    selected = shutil.which("docker", path=os.environ.get("PATH"))
    if selected is None:
        return FIXED_CHILD_PATH
    try:
        executable = Path(selected).resolve(strict=True)
        metadata = executable.stat()
    except OSError:
        return FIXED_CHILD_PATH
    parent = str(executable.parent)
    if (
        not stat.S_ISREG(metadata.st_mode)
        or not os.access(executable, os.X_OK)
        or ":" in parent
    ):
        return FIXED_CHILD_PATH
    fixed_directories = FIXED_CHILD_PATH.split(":")
    if parent in fixed_directories:
        return FIXED_CHILD_PATH
    return f"{FIXED_CHILD_PATH}:{parent}"


def run(owner: str, *arguments: str) -> None:
    started = time.monotonic_ns()
    emit_phase(owner, "start")
    environment = qualification_environment(owner)
    if owner == INSTALLED_OWNER:
        with signal_subprocess_owner(
            QUALIFICATION_SIGNALS, SIGNAL_CLEANUP_SECONDS
        ) as signal_owner:
            directory = tempfile.mkdtemp(prefix="align-llm-docker-config-", dir="/tmp")
            try:
                os.chmod(directory, 0o700)
                environment["DOCKER_CONFIG"] = directory
                result = signal_owner.run(
                    arguments,
                    cwd=REPOSITORY,
                    env=environment,
                    check=False,
                )
            finally:
                signal_owner.begin_cleanup()
                shutil.rmtree(directory)
    else:
        result = subprocess.run(
            arguments,
            cwd=REPOSITORY,
            env=environment,
            check=False,
        )
    duration_ms = max(0, (time.monotonic_ns() - started) // 1_000_000)
    emit_phase(owner, "pass" if result.returncode == 0 else "fail", duration_ms)
    if result.returncode != 0:
        raise subprocess.CalledProcessError(result.returncode, arguments)


def verify_contract_inventory() -> None:
    specification = SPECIFICATION.read_text(encoding="utf-8")
    closure = specification[specification.index("### 9.10 Closure matrix") :]
    observed = set(re.findall(r"`(fresh-v2-[a-z0-9-]+)`", closure))
    if observed != EXPECTED_CASES:
        missing = sorted(EXPECTED_CASES - observed)
        unexpected = sorted(observed - EXPECTED_CASES)
        raise RuntimeError(
            f"FRESH-WORKER qualification inventory changed: missing={missing}, unexpected={unexpected}"
        )

    owners: dict[str, str] = {}
    for command, cases in FOCUSED_CHECKS:
        for case in cases:
            if case in owners:
                raise RuntimeError(f"FRESH-WORKER case has duplicate focused owners: {case}")
            owners[case] = command
        if command != "check-gate-topology --self-test":
            path = REPOSITORY / "scripts" / command
            if not path.is_file():
                raise RuntimeError(f"FRESH-WORKER focused owner is missing: {path}")
    if not set(owners) <= EXPECTED_CASES:
        raise RuntimeError("FRESH-WORKER focused owner names are outside the contract inventory")
    if not COMPLETE_AGGREGATE_CASES <= EXPECTED_CASES:
        raise RuntimeError("complete-audit owner names are outside the contract inventory")
    if COMPLETE_AGGREGATE_CASES & set(owners):
        raise RuntimeError("complete-audit cases also have a routine focused owner")

    worker = WORKER.read_text(encoding="utf-8")
    forbidden = {
        ".communicate(": "unbounded child collection returned",
        'Path(f"/proc/self/fd/{roots_fd}") / root_name': "mutable private-root pathname returned",
        '("rev-parse", "--verify", "HEAD")': "mutable HEAD query returned",
    }
    for token, message in forbidden.items():
        if token in worker:
            raise RuntimeError(message)
    required = (
        "verify_ed25519(",
        "assert_git_view(",
        "require_parent_entry(",
        "kill_cgroup(",
        "set_subreaper(",
        "MAX_SOURCE_DEPTH",
    )
    for token in required:
        if token not in worker:
            raise RuntimeError(f"worker closure owner is missing: {token}")
    aggregate_start = worker.index("def run_aggregate")
    aggregate_end = worker.index("\ndef scan_private_fd", aggregate_start)
    aggregate = worker[aggregate_start:aggregate_end]
    for token in (
        '"--uid"',
        '"--gid"',
        '"--cap-add"',
        '"CAP_SYS_ADMIN"',
        '"CAP_SETFCAP"',
        '"CAP_SETUID"',
        '"CAP_SETGID"',
        '"--prepare-validation-userns"',
        '"--tmpfs-inodes"',
        '"--size"',
        "validate_published_elf",
    ):
        if token not in aggregate:
            raise RuntimeError(f"aggregate capability boundary is missing: {token}")
    for token in (
        "MAX_AGGREGATE_OVERLAY_BYTES",
        "assert_reachable_git_bound",
        "GitCopyBudget",
    ):
        if token not in worker:
            raise RuntimeError(f"worker resource boundary is missing: {token}")

    runner = (REPOSITORY / "eval/runners/run-coding-task.py").read_text(encoding="utf-8")
    prefix = runner[runner.index("def fresh_namespace_prefix"): runner.index("\ndef sandbox_probe_command", runner.index("def fresh_namespace_prefix"))]
    if (
        '"--cap-drop",\n        "ALL",\n        "--cap-add",\n        "CAP_SYS_ADMIN",\n        "--cap-add",\n        "CAP_SETFCAP"'
        not in prefix
    ):
        raise RuntimeError("nested validation capability admission order changed")
    for token in (
        '"--userns"',
        '"--unshare-ipc"',
        '"--unshare-pid"',
        '"--unshare-net"',
        '"--unshare-uts"',
    ):
        if token not in prefix:
            raise RuntimeError(f"nested validation namespace boundary is missing: {token}")
    for token in ('"--unshare-all"', '"--unshare-user"'):
        if token in prefix:
            raise RuntimeError(f"nested validation namespace boundary is too broad: {token}")
    guard = (REPOSITORY / "image/fresh/mount-guard.c").read_text(encoding="utf-8")
    if '"--prepare-validation-userns"' not in guard:
        raise RuntimeError("aggregate mount-guard user namespace preparation is missing")
    alignc = (REPOSITORY / "scripts/alignc").read_text(encoding="utf-8")
    if 'if [[ "${ALIGNC:-}" != "/tools/fresh-alignc" ]]; then' not in alignc:
        raise RuntimeError("fresh compiler override authentication is missing")

    directories_start = worker.index("def namespace_directories")
    directories_end = worker.index("\ndef open_private_mount", directories_start)
    directories = worker[directories_start:directories_end]
    for token in ('"/tmp"', '"/dev/shm"', '"/workspace"'):
        if token not in directories:
            raise RuntimeError(f"nested sandbox parent is missing: {token}")

    image = IMAGE_DOCKERFILE.read_text(encoding="utf-8")
    for token in (
        "libzstd-dev",
        'DEB_MULTIARCH="$(dpkg-architecture -qDEB_HOST_MULTIARCH)"',
        '"/usr/lib/$DEB_MULTIARCH" "/runtime/system/usr-lib-$PROFILE_ARCH"',
        '"/usr/lib/gcc/$DEB_MULTIARCH" "/runtime/system/gcc-$PROFILE_ARCH"',
        '--runtime "/runtime/system/gcc-$PROFILE_ARCH=/usr/lib/gcc/$DEB_MULTIARCH"',
        "aarch64:aarch64-linux-gnu",
        "LOADER_TARGET=/lib/ld-linux-aarch64.so.1",
        "--runtime /usr/bin/dash=/bin/sh",
        "--runtime /usr/bin/bash=/bin/bash",
        "--runtime /usr/bin/env=/usr/bin/env",
        "--runtime /usr/bin/python3.12=/usr/bin/python3",
    ):
        if token not in image:
            raise RuntimeError(f"image runtime closure is missing: {token}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--installed-profile", action="store_true")
    parser.add_argument("--installed-profile-only", action="store_true")
    parser.add_argument("--complete-aggregate", action="store_true")
    parser.add_argument("--require-docker", action="store_true")
    parser.add_argument("--align-repo", type=Path)
    parser.add_argument("--prepared-image")
    parser.add_argument("--image-signing-seed", type=Path)
    parser.add_argument("--run-signing-seed", type=Path)
    values = parser.parse_args()
    installed_profile = values.installed_profile
    installed_profile_only = values.installed_profile_only
    complete_aggregate = values.complete_aggregate
    require_docker = values.require_docker
    if installed_profile and installed_profile_only:
        raise SystemExit("--installed-profile and --installed-profile-only are mutually exclusive")
    if require_docker and not (installed_profile or installed_profile_only):
        raise SystemExit("--require-docker requires an installed-profile mode")
    if complete_aggregate and not (installed_profile or installed_profile_only):
        raise SystemExit("--complete-aggregate requires an installed-profile mode")
    prepared_values = (
        values.prepared_image,
        values.image_signing_seed,
        values.run_signing_seed,
    )
    if any(value is not None for value in prepared_values) and not all(
        value is not None for value in prepared_values
    ):
        raise SystemExit(
            "--prepared-image, --image-signing-seed, and --run-signing-seed are required together"
        )
    if any(value is not None for value in prepared_values) and not (
        installed_profile or installed_profile_only
    ):
        raise SystemExit("prepared image arguments require an installed-profile mode")
    verify_contract_inventory()
    if not installed_profile_only:
        for command, _ in FOCUSED_CHECKS:
            if command == "check-gate-topology --self-test":
                run(command, sys.executable, "scripts/check-gate-topology", "--self-test")
            else:
                run(command, sys.executable, f"scripts/{command}")
    if installed_profile or installed_profile_only:
        arguments = [sys.executable, "scripts/run-fresh-image-profile-smoke"]
        if require_docker:
            arguments.append("--require-docker")
        if complete_aggregate:
            arguments.append("--complete-aggregate")
        if values.align_repo is not None:
            arguments.extend(("--align-repo", str(values.align_repo)))
        if values.prepared_image is not None:
            arguments.extend(
                (
                    "--prepared-image",
                    values.prepared_image,
                    "--image-signing-seed",
                    str(values.image_signing_seed),
                    "--run-signing-seed",
                    str(values.run_signing_seed),
                )
            )
        run("run-fresh-image-profile-smoke", *arguments)
    audit_suffix = " with complete audit" if complete_aggregate else ""
    if installed_profile_only:
        mode = "installed profile only" + audit_suffix
    elif installed_profile:
        mode = "focused and installed profile" + audit_suffix
    else:
        mode = "focused; installed profile deferred"
    print(
        "fresh worker qualification: PASS "
        + f"({mode})"
    )
    owners = {case: command for command, cases in FOCUSED_CHECKS for case in cases}
    for name in sorted(EXPECTED_CASES):
        if installed_profile_only and name in owners:
            print(f"  {name}: owner={owners[name]} execution=skipped-by-installed-only")
        elif name in owners:
            print(f"  {name}: owner={owners[name]} execution=focused")
        elif name in COMPLETE_AGGREGATE_CASES:
            execution = (
                "explicit-complete-audit"
                if complete_aggregate
                else "deferred-to-explicit-complete-audit"
            )
            print(f"  {name}: owner=run-fresh-image-profile-smoke execution={execution}")
        elif installed_profile or installed_profile_only:
            print(f"  {name}: owner=run-fresh-image-profile-smoke execution=installed-profile")
        else:
            print(
                f"  {name}: owner=run-fresh-image-profile-smoke "
                "execution=deferred-to-installed-profile"
            )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
