ROOT = Path(__file__).resolve().parents[1]
PREDECESSOR_PATH = ROOT / "scripts/run-olmoe-isolated-sampled-runtime-decision"
PREDECESSOR_LOADER = SourceFileLoader("olmoe_isolated_for_post_optimization", str(PREDECESSOR_PATH))
PREDECESSOR_SPEC = importlib.util.spec_from_loader(PREDECESSOR_LOADER.name, PREDECESSOR_LOADER)
if PREDECESSOR_SPEC is None or PREDECESSOR_SPEC.loader is None:
    raise RuntimeError("cannot load the isolated sampled runtime owner")
previous = importlib.util.module_from_spec(PREDECESSOR_SPEC)
sys.modules[PREDECESSOR_LOADER.name] = previous
PREDECESSOR_SPEC.loader.exec_module(previous)

EXACT_SAFE_PATH = ROOT / "scripts/run-olmoe-exact-safe-decode-boundaries"
EXACT_SAFE_LOADER = SourceFileLoader("olmoe_exact_safe_for_post_optimization", str(EXACT_SAFE_PATH))
EXACT_SAFE_SPEC = importlib.util.spec_from_loader(EXACT_SAFE_LOADER.name, EXACT_SAFE_LOADER)
if EXACT_SAFE_SPEC is None or EXACT_SAFE_SPEC.loader is None:
    raise RuntimeError("cannot load the exact-safe decode owner")
exact_safe = importlib.util.module_from_spec(EXACT_SAFE_SPEC)
sys.modules[EXACT_SAFE_LOADER.name] = exact_safe
EXACT_SAFE_SPEC.loader.exec_module(exact_safe)

