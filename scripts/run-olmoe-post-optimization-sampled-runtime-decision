active_process: subprocess.Popen[bytes] | None = None


class PostOptimizationDecisionError(RuntimeError):
    pass


def source_identities() -> tuple[str, ...]:
    return tuple(base.file_sha256(path) for path in SOURCE_PATHS)


def validate_imported_contract() -> None:
    previous.validate_imported_workload()
    exact_safe.validate_imported_contract()
    workload = (
        previous.MODEL_BYTES,
        previous.MODEL_SHA256,
        previous.SERVER_BUILD,
        previous.SERVER_COMMIT,
        previous.BUDGET,
        previous.ALIAS,
        previous.TASK,
        base.bytes_sha256(previous.PROMPT_TEXT.encode("utf-8")),
        base.bytes_sha256(previous.KNOWN_GOOD_PATCH.encode("utf-8")),
        previous.ORDERS,
        previous.TEMPERATURE_MICROS,
        previous.SEEDS,
        previous.MAX_TOKENS,
        previous.FLOOR_PPM,
        previous.CEILING_SECONDS,
    )
    if workload != EXPECTED_WORKLOAD:
        raise PostOptimizationDecisionError("item 56 workload contract drifted")
    external = (
        previous.EXPECTED_ALIGN_REVISION,
        previous.EXPECTED_COMPILER_SHA256,
        previous.EXPECTED_PACK_SHA256,
        previous.EXPECTED_GEOMETRY_SHA256,
        previous.EXPECTED_SERVER_SHA256,
        previous.EXPECTED_TASK_SHA256,
        previous.EXPECTED_PROMPT_SHA256,
        previous.EXPECTED_C_COMPILER_SHA256,
        previous.EXPECTED_C_COMPILER_VERSION_SHA256,
        previous.EXPECTED_LINKER_SEARCH_SHA256,
        previous.EXPECTED_VALIDATOR_IMAGE,
    )
    if external != EXPECTED_EXTERNAL_IDENTITY:
        raise PostOptimizationDecisionError("item 56 external identity drifted")
    if source_identities() != EXPECTED_SOURCE_IDENTITIES:
        raise PostOptimizationDecisionError("post-optimization source chain drifted")
    if (
        exact_safe.BASELINE_MEDIAN_NS != 19_266_559_229
        or exact_safe.CANDIDATE_CEILING_NS != 18_303_231_267
    ):
        raise PostOptimizationDecisionError("item 68 performance contract drifted")


def predecessor_projection(result: dict[str, Any]) -> dict[str, Any]:
    projected = dict(result)
    projected["artifact_kind"] = PREDECESSOR_ARTIFACT_KIND
    return projected


def adapt_result(result: dict[str, Any]) -> dict[str, Any]:
    previous.validate_result(result)
    adapted = dict(result)
    adapted["artifact_kind"] = ARTIFACT_KIND
    validate_result(adapted)
    return adapted


def validate_result(result: dict[str, Any]) -> None:
    if result.get("artifact_kind") != ARTIFACT_KIND:
        raise PostOptimizationDecisionError("result artifact identity drifted")
    previous.validate_result(predecessor_projection(result))


def prerequisites() -> bool:
    captured = io.StringIO()
    with contextlib.redirect_stdout(captured):
        required = previous.prerequisites()
    if required is not None:
        return True
    line = captured.getvalue().strip()
    marker = ": N/A ("
    if marker not in line or not line.endswith(")"):
        raise PostOptimizationDecisionError("predecessor prerequisite result was malformed")
    print(f"R8-OLMOE-POST-OPTIMIZATION-SAMPLED-RUNTIME-DECISION{line[line.index(marker):]}")
    return False


def stop_active_process() -> None:
    global active_process
    process = active_process
    active_process = None
    if process is None or process.poll() is not None:
        return
    process.terminate()
    try:
        process.wait(timeout=INHERITED_CLEANUP_SECONDS)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait(timeout=5)


def delegate_decision() -> dict[str, Any]:
    global active_process
    active_process = subprocess.Popen(
        [sys.executable, str(PREDECESSOR_PATH)],
        cwd=ROOT,
        env=os.environ.copy(),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    process = active_process
    try:
        stdout, stderr = process.communicate(timeout=DELEGATE_TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired as error:
        stop_active_process()
        raise PostOptimizationDecisionError(
            "delegated decision exceeded its deadline and inherited cleanup budget"
        ) from error
    finally:
        if active_process is process and process.poll() is not None:
            active_process = None
    if process.returncode != 0:
        detail = stderr.decode("utf-8", "replace").strip().splitlines()
        suffix = "" if not detail else f": {detail[-1]}"
        raise PostOptimizationDecisionError(f"delegated decision failed{suffix}")
    try:
        lines = stdout.decode("utf-8").splitlines()
    except UnicodeError as error:
        raise PostOptimizationDecisionError("delegated result was not UTF-8") from error
    if len(lines) != 1:
        raise PostOptimizationDecisionError("delegated decision did not emit exactly one result")
    try:
        result = json.loads(lines[0])
    except json.JSONDecodeError as error:
        raise PostOptimizationDecisionError("delegated result was not JSON") from error
    if not isinstance(result, dict):
        raise PostOptimizationDecisionError("delegated result was not an object")
    return result


def synthetic_predecessor_result() -> dict[str, Any]:
    samples = previous.synthetic_samples()
    aggregate = previous.previous.aggregate(samples)
    return {
        "schema_version": 1,
        "artifact_kind": PREDECESSOR_ARTIFACT_KIND,
        "status": "COMPLETE",
        "model": {
            "bytes": previous.MODEL_BYTES,
            "sha256": previous.MODEL_SHA256,
            "architecture": "olmoe",
        },
        "baseline": previous.baseline_metadata(),
        "candidate": {
            "provider": "align-runtime",
            "align_llm_head": "a" * 40,
            "align_revision": previous.EXPECTED_ALIGN_REVISION,
            "compiler_sha256": previous.EXPECTED_COMPILER_SHA256,
            "helper_sha256": "b" * 64,
            "shim_sha256": "c" * 64,
            "ggml_libraries": previous.EXPECTED_GGML_LIBRARIES,
            "pack_sha256": previous.EXPECTED_PACK_SHA256,
            "geometry_sha256": previous.EXPECTED_GEOMETRY_SHA256,
            "cache_budget_bytes": previous.BUDGET,
        },
        "task": {
            "task_id": "python-inclusive-range",
            "task_sha256": previous.EXPECTED_TASK_SHA256,
            "prompt_sha256": previous.EXPECTED_PROMPT_SHA256,
            "maximum_completion_tokens": previous.MAX_TOKENS,
        },
        "sampling": {
            "temperature_micros": previous.TEMPERATURE_MICROS,
            "ordered_seeds": list(previous.SEEDS),
            "maximum_candidates": len(previous.SEEDS),
            "stop_on_first_pass": True,
        },
        "validator": {"kind": "docker", "image_id": previous.EXPECTED_VALIDATOR_IMAGE},
        "environment": {
            "os": "Darwin",
            "release": "test",
            "architecture": "arm64",
            "cpu_count": 8,
            "c_compiler_sha256": previous.EXPECTED_C_COMPILER_SHA256,
            "c_compiler_version_sha256": previous.EXPECTED_C_COMPILER_VERSION_SHA256,
            "linker_search_sha256": previous.EXPECTED_LINKER_SEARCH_SHA256,
        },
        "samples": samples,
        "aggregate": aggregate,
        "elapsed_ns": 1,
    }


def expect_error(action: Any, message: str) -> None:
    try:
        action()
    except Exception:
        return
    raise PostOptimizationDecisionError(message)


def self_test() -> int:
    validate_imported_contract()
    with contextlib.redirect_stdout(io.StringIO()):
        if previous.self_test() != 0 or exact_safe.self_test() != 0:
            raise PostOptimizationDecisionError("predecessor owner failed")
    original = synthetic_predecessor_result()
    adapted = adapt_result(original)
    if predecessor_projection(adapted) != original:
        raise PostOptimizationDecisionError("result projection changed inherited evidence")
    malformed = dict(adapted)
    malformed["aggregate"] = {"bad": True}
    expect_error(lambda: validate_result(malformed), "malformed inherited aggregate was accepted")
    malformed = dict(adapted)
    malformed["artifact_kind"] = PREDECESSOR_ARTIFACT_KIND
    expect_error(lambda: validate_result(malformed), "predecessor artifact identity was accepted")
    with mock.patch.object(base, "file_sha256", return_value="0" * 64):
        expect_error(validate_imported_contract, "source mutation was accepted")

    encoded = json.dumps(original, separators=(",", ":")).encode("utf-8")
    complete = mock.Mock()
    complete.communicate.return_value = (encoded + b"\n", b"complete\n")
    complete.returncode = 0
    complete.poll.return_value = 0
    with mock.patch("subprocess.Popen", return_value=complete):
        if delegate_decision() != original:
            raise PostOptimizationDecisionError("delegated success changed its result")
    failed = mock.Mock()
    failed.communicate.return_value = (b"", b"injected failure\n")
    failed.returncode = 1
    failed.poll.return_value = 1
    with mock.patch("subprocess.Popen", return_value=failed):
        expect_error(delegate_decision, "delegated failure was accepted")

    global active_process
    owned = mock.Mock()
    owned.poll.return_value = None
    active_process = owned
    stop_active_process()
    if (
        active_process is not None
        or owned.terminate.call_count != 1
        or owned.wait.call_args.args != ()
        or owned.wait.call_args.kwargs != {"timeout": INHERITED_CLEANUP_SECONDS}
    ):
        raise PostOptimizationDecisionError("active delegated process was not cleared")
    forced = mock.Mock()
    forced.poll.return_value = None
    forced.wait.side_effect = [
        subprocess.TimeoutExpired(
            [sys.executable, str(PREDECESSOR_PATH)], INHERITED_CLEANUP_SECONDS
        ),
        0,
    ]
    active_process = forced
    stop_active_process()
    if forced.terminate.call_count != 1 or forced.kill.call_count != 1:
        raise PostOptimizationDecisionError("delegated cleanup did not escalate after its budget")
    timed_out = mock.Mock()
    timed_out.communicate.side_effect = subprocess.TimeoutExpired(
        [sys.executable, str(PREDECESSOR_PATH)], DELEGATE_TIMEOUT_SECONDS
    )
    timed_out.poll.return_value = None
    timed_out.wait.return_value = 0
    with mock.patch("subprocess.Popen", return_value=timed_out):
        expect_error(delegate_decision, "delegated timeout was accepted")
    if timed_out.terminate.call_count != 1 or timed_out.wait.call_args.kwargs != {
        "timeout": INHERITED_CLEANUP_SECONDS
    }:
        raise PostOptimizationDecisionError("delegated timeout skipped inherited cleanup")

    with mock.patch.dict(os.environ, {}, clear=True):
        captured = io.StringIO()
        with contextlib.redirect_stdout(captured):
            if prerequisites():
                raise PostOptimizationDecisionError("missing prerequisites were accepted")
    if captured.getvalue() != (
        "R8-OLMOE-POST-OPTIMIZATION-SAMPLED-RUNTIME-DECISION: N/A "
        "(ALIGN_LLM_OLMOE_MODEL unset)\n"
    ):
        raise PostOptimizationDecisionError("missing prerequisite result drifted")
    with mock.patch.object(sys, "argv", [sys.argv[0], "unexpected"]):
        expect_error(main, "unexpected command argument was accepted")
    print("R8-OLMOE-POST-OPTIMIZATION-SAMPLED-RUNTIME-DECISION self-test: PASS")
    return 0


def git_head() -> str:
    completed = subprocess.run(
        ["git", "rev-parse", "HEAD"],
        cwd=ROOT,
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=30,
    )
    return completed.stdout.decode("ascii").strip()


def main() -> int:
    if sys.argv[1:] == ["--self-test"]:
        return self_test()
    if len(sys.argv) != 1:
        raise PostOptimizationDecisionError("decision accepts no arguments or --self-test")
    if not prerequisites():
        return 0
    validate_imported_contract()
    started_ns = time.monotonic_ns()
    head = git_head()
    predecessor_result = delegate_decision()
    result = adapt_result(predecessor_result)
    if result["candidate"]["align_llm_head"] != head or git_head() != head:
        raise PostOptimizationDecisionError("evaluated head changed during the decision")
    validate_imported_contract()
    elapsed_ns = time.monotonic_ns() - started_ns
    if elapsed_ns > CEILING_SECONDS * 1_000_000_000:
        raise PostOptimizationDecisionError(
            f"complete decision exceeded its 25-minute ceiling ({elapsed_ns / 1e9:.1f}s)"
        )
    print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))
    aggregate = result["aggregate"]
    print(
        "R8-OLMOE-POST-OPTIMIZATION-SAMPLED-RUNTIME-DECISION: COMPLETE "
        f"verdict={aggregate['verdict']} gain_ppm={aggregate['gain_ppm']} "
        f"elapsed={elapsed_ns / 1e9:.2f}s",
        file=sys.stderr,
    )
    return 0


def interrupted(signal_number: int, _frame: object) -> None:
    stop_active_process()
    raise SystemExit(128 + signal_number)


if __name__ == "__main__":
    signal.signal(signal.SIGINT, interrupted)
    signal.signal(signal.SIGTERM, interrupted)
    try:
        raise SystemExit(main())
    except (
        PostOptimizationDecisionError,
        previous.DecisionError,
        exact_safe.ExactSafeBoundaryError,
        OSError,
        ValueError,
        KeyError,
        TypeError,
        json.JSONDecodeError,
        subprocess.SubprocessError,
    ) as error:
        stop_active_process()
        print(
            f"R8-OLMOE-POST-OPTIMIZATION-SAMPLED-RUNTIME-DECISION: FAIL {error}",
            file=sys.stderr,
        )
        raise SystemExit(1)
