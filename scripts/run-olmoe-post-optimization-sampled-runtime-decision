def unique_paths(paths: tuple[Path, ...]) -> tuple[Path, ...]:
    result: list[Path] = []
    for path in paths:
        if path not in result:
            result.append(path)
    return tuple(result)


SOURCE_PATHS = unique_paths((PREDECESSOR_PATH, EXACT_SAFE_PATH, *exact_safe.SOURCE_PATHS))
