#!/usr/bin/env bash

# c7-persisted-result-lifetime-smoke.
#
# `docs/specs/c7-persisted-result.md` section 6.1 requires the acceptance fixture to delete the
# original input after `persist_file` returns and before the standalone verifier runs. Section 13
# names this runner for the "Input decode construction", "Input source expiry", "Result source
# expiry", and "Repeated standalone verify" rows, and for the section 9.2 `persist_file` +
# `verify_file` pair.
#
# The fixture bytes and the expected artifact come from the independent
# `scripts/c7_persisted_result_fixtures.py` table.

set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
compiler="${ALIGNC:-${project_root}/scripts/alignc}"
work_dir="$(mktemp -d)"
trap 'rm -rf "${work_dir}"' EXIT

python3 - "${project_root}" "${work_dir}" <<'PY'
import sys
from pathlib import Path

sys.path.insert(0, str(Path(sys.argv[1]) / "scripts"))
import c7_persisted_result_fixtures as fixtures

fixtures.require_golden()
work = Path(sys.argv[2])
source, artifact, status = fixtures.expected_pair(
    "upper-equal", 4, 5, 0, 9, 2, fixtures.ESCAPED_NOTE
)
if status != "PASS":
    raise SystemExit("c7 persisted result lifetime smoke: fixture is not a PASS case")
(work / "input.json").write_bytes(source.encode("utf-8"))
(work / "expected.json").write_bytes(artifact.encode("utf-8"))
PY

"${compiler}" run "${project_root}/src/c7_persisted_result_lifetime_smoke.align" \
  "${work_dir}/input.json" "${work_dir}/result.json" >"${work_dir}/observed.txt"

if [ -e "${work_dir}/input.json" ]; then
  printf '%s\n' "c7 persisted result lifetime smoke: the input document survived the fixture" >&2
  exit 1
fi

python3 - "${work_dir}" <<'PY'
import sys
from pathlib import Path

work = Path(sys.argv[1])
expected_rows = [
    # The publication returned the summary before the input was removed.
    "persist/status",
    "PASS",
    "2",
    "2",
    # Section 6.1: the source document is gone before any verification runs.
    "input/present",
    "false",
    # The artifact verifies from its own bytes alone.
    "verify-1/status",
    "PASS",
    "2",
    "2",
    # Section 9.2: repeated read-only verification is deterministic.
    "verify-2/status",
    "PASS",
    "2",
    "2",
    # A removed path is not an artifact.
    "verify-removed-input",
    "REJECTED",
    "result/present",
    "true",
]

raw = (work / "observed.txt").read_bytes()
if not raw.endswith(b"\n"):
    raise SystemExit("c7 persisted result lifetime smoke: output is not newline terminated")
observed_rows = raw.decode("utf-8").split("\n")[:-1]
if observed_rows != expected_rows:
    raise SystemExit(
        "c7 persisted result lifetime smoke: printed rows mismatch\n"
        f"  expected: {expected_rows!r}\n"
        f"  observed: {observed_rows!r}"
    )

produced = (work / "result.json").read_bytes()
expected = (work / "expected.json").read_bytes()
if produced != expected:
    raise SystemExit(
        "c7 persisted result lifetime smoke: artifact bytes mismatch\n"
        f"  expected: {expected!r}\n"
        f"  observed: {produced!r}"
    )

print(
    "c7 persisted result lifetime smoke: owned record survives input deletion, artifact verifies "
    "twice read-only, and the published bytes match the independent vector PASS"
)
PY
