#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
compiler="${ALIGNC:-${project_root}/scripts/alignc}"
if [[ "$(uname -s)" != Linux ]]; then
  "${compiler}" check-per-unit "${project_root}/src/prompt_fixture_command_smoke.align"
  printf '%s\n' 'fixture command: checked; sealed Git execution requires Linux'
  exit 0
fi
scratch="$(mktemp -d)"
trap 'rm -rf "${scratch}"' EXIT
mkdir "${scratch}/image" "${scratch}/oracle" "${scratch}/normal" "${scratch}/fresh"
cp "$(command -v git)" "${scratch}/image/git"
for fixture in oracle normal fresh; do
  printf 'old\n' > "${scratch}/${fixture}/file"
  printf 'ignored\n' > "${scratch}/${fixture}/.gitignore"
  printf 'odd\n' > "${scratch}/${fixture}/"$'odd\tname\n'
  chmod 644 "${scratch}/${fixture}/file" "${scratch}/${fixture}/.gitignore" "${scratch}/${fixture}/"$'odd\tname\n'
done
oracle_env=(env -i HOME=/tmp/home PATH=/usr/bin:/bin TMPDIR=/tmp LC_ALL=C
  GIT_CONFIG_NOSYSTEM=1 GIT_ATTR_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_NO_REPLACE_OBJECTS=1
  'GIT_AUTHOR_NAME=align-llm fixture' GIT_AUTHOR_EMAIL=fixture@align-llm.invalid GIT_AUTHOR_DATE=2026-01-01T00:00:00Z
  'GIT_COMMITTER_NAME=align-llm fixture' GIT_COMMITTER_EMAIL=fixture@align-llm.invalid GIT_COMMITTER_DATE=2026-01-01T00:00:00Z)
"${oracle_env[@]}" git -C "${scratch}/oracle" init -q --initial-branch=main --object-format=sha1
"${oracle_env[@]}" git -C "${scratch}/oracle" config core.autocrlf false
"${oracle_env[@]}" git -C "${scratch}/oracle" config core.filemode true
"${oracle_env[@]}" git -C "${scratch}/oracle" add --all
"${oracle_env[@]}" git -C "${scratch}/oracle" -c commit.gpgSign=false -c core.hooksPath=/dev/null commit -q -m 'Create deterministic evaluation fixture'
revision="$("${oracle_env[@]}" git -C "${scratch}/oracle" rev-parse HEAD)"
cat > "${scratch}/patch" <<'PATCH'
diff --git a/file b/file
--- a/file
+++ b/file
@@ -1 +1 @@
-old
+new
PATCH
"${compiler}" check-per-unit "${project_root}/src/prompt_fixture_command_smoke.align"
for profile in normal fresh; do
  # These hostile ambient inputs must not influence the constructed Git command.
  GIT_DIR=/nonexistent-fixture-git-dir GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=user.name GIT_CONFIG_VALUE_0=ambient \
    "${compiler}" run "${project_root}/src/prompt_fixture_command_smoke.align" -- \
      "${scratch}/image" "${scratch}/${profile}" "${revision}" "${scratch}/patch" "${profile}"
done
