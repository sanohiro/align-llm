#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
compiler="${ALIGNC:-${project_root}/scripts/alignc}"
scratch="$(mktemp -d)"
scratch="$(cd "${scratch}" && pwd -P)"
completed=0
cleanup() {
  if [[ "${completed}" == 1 ]]; then
    rm -rf "${scratch}"
  else
    printf 'fixture setup owner failed; preserving storage: %s\n' "${scratch}" >&2
  fi
}
trap cleanup EXIT
mkdir "${scratch}/image" "${scratch}/source" "${scratch}/empty-source" "${scratch}/oracle"
printf 'fixture\n' >"${scratch}/source/a.txt"
chmod 644 "${scratch}/source/a.txt"
platform="$(uname -s)"
revision=0000000000000000000000000000000000000000
if [[ "${platform}" == Linux ]]; then
  cp "$(command -v git)" "${scratch}/image/git"
  oracle_env=(env -i HOME=/tmp/home PATH=/usr/bin:/bin TMPDIR=/tmp LC_ALL=C
    GIT_CONFIG_NOSYSTEM=1 GIT_ATTR_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_NO_REPLACE_OBJECTS=1
    'GIT_AUTHOR_NAME=align-llm fixture' GIT_AUTHOR_EMAIL=fixture@align-llm.invalid GIT_AUTHOR_DATE=2026-01-01T00:00:00Z
    'GIT_COMMITTER_NAME=align-llm fixture' GIT_COMMITTER_EMAIL=fixture@align-llm.invalid GIT_COMMITTER_DATE=2026-01-01T00:00:00Z)
  "${oracle_env[@]}" git -C "${scratch}/oracle" init -q --initial-branch=main --object-format=sha1
  # Independent plumbing oracle: no checkout, index, add, or porcelain commit.
  blob="$(printf 'fixture\n' | "${oracle_env[@]}" git -C "${scratch}/oracle" hash-object -w --stdin)"
  tree="$(printf '100644 blob %s\ta.txt\n' "${blob}" | "${oracle_env[@]}" git -C "${scratch}/oracle" mktree)"
  revision="$(printf 'Create deterministic evaluation fixture\n' | "${oracle_env[@]}" git -C "${scratch}/oracle" commit-tree "${tree}")"
fi
"${compiler}" check-per-unit "${project_root}/src/prompt_fixture_setup_smoke.align"
(
  cd "${scratch}"
  "${compiler}" build "${project_root}/src/prompt_fixture_setup_smoke.align"
)
modes=(ready wrong empty malformed cancel)
if [[ "${platform}" != Linux ]]; then modes=(unsupported); fi
for mode in "${modes[@]}"; do
  mkdir "${scratch}/${mode}"
  source_path="${scratch}/source"
  if [[ "${mode}" == empty ]]; then source_path="${scratch}/empty-source"; fi
  # The shell becomes the owner binary; cancellation only signals this verified PID.
  /bin/sh -c 'exec "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$$"' fixture-setup-owner \
    "${scratch}/prompt_fixture_setup_smoke" "${platform}" "${scratch}/image" \
    "${source_path}" "${scratch}/${mode}" "${revision}" "${mode}"
  if [[ "${platform}" != Linux ]]; then continue; fi
  if [[ "${mode}" == ready || "${mode}" == wrong ]]; then
    actual="$("${oracle_env[@]}" git -C "${scratch}/${mode}" rev-parse HEAD)"
    [[ "${actual}" == "${revision}" ]]
    [[ -z "$("${oracle_env[@]}" git -C "${scratch}/${mode}" status --porcelain --ignored --untracked-files=all)" ]]
    cmp "${scratch}/source/a.txt" "${scratch}/${mode}/a.txt"
  elif [[ "${mode}" == malformed ]]; then
    [[ ! -e "${scratch}/${mode}/.git" ]]
  elif [[ "${mode}" == empty ]]; then
    [[ -d "${scratch}/${mode}/.git" ]]
    if "${oracle_env[@]}" git -C "${scratch}/${mode}" rev-parse --verify HEAD >/dev/null 2>&1; then exit 1; fi
  elif [[ "${mode}" == cancel ]]; then
    [[ ! -e "${scratch}/${mode}/.git/index" ]]
    if "${oracle_env[@]}" git -C "${scratch}/${mode}" config --local --get core.autocrlf >/dev/null 2>&1; then exit 1; fi
    if "${oracle_env[@]}" git -C "${scratch}/${mode}" rev-parse --verify HEAD >/dev/null 2>&1; then exit 1; fi
  fi
done
completed=1
if [[ "${platform}" == Linux ]]; then
  printf 'fixture setup: independent commit and refusal side-effect checks PASS (Linux)\n'
else
  printf 'fixture setup: native unsupported-host owner PASS; Linux checks not exercised\n'
fi
