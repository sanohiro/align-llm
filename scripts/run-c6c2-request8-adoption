#!/usr/bin/env bash

set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
compiler="${ALIGNC:-${project_root}/scripts/alignc}"
output_file="$(mktemp)"
trap 'rm -f "${output_file}"' EXIT

"${compiler}" run "${project_root}/src/c6c2_request8_adoption.align" >"${output_file}"

python3 - "${output_file}" <<'PY'
import sys
from pathlib import Path

actual = Path(sys.argv[1]).read_text(encoding="utf-8").splitlines()
expected = ["3", "1", "third"]
if actual != expected:
    raise SystemExit(f"request 8 adoption mismatch: {actual!r}")
print("c6c2 Request 8 runtime-sized record array adoption: PASS")
PY
