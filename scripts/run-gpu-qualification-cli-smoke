#!/usr/bin/env python3
"""Exercise G1 qualifier CLI admission before output, scratch, or device side effects."""

from __future__ import annotations

import importlib.machinery
import pathlib
import sys
import tempfile


ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "scripts"))

import gpu_qualification_cli as cli  # noqa: E402
from gpu_backend_recipe import RecipeError  # noqa: E402


def fixture_module():
    path = ROOT / "scripts" / "run-gpu-input-admission-smoke"
    loader = importlib.machinery.SourceFileLoader("gpu_input_fixture_cli", str(path))
    return loader.load_module()


def rejected(call, message: str) -> None:
    try:
        call()
    except RecipeError as error:
        assert message in str(error), (message, str(error))
    else:
        raise AssertionError(f"gpu qualifier CLI unexpectedly passed: {message}")


for arguments, message in (
    (["--profile", "a", "--suite", "generation"], "incomplete"),
    (["--profile", "a", "--profile", "b", "--suite", "generation", "--output", "c"],
     "duplicated"),
    (["--profile", "a", "--suite", "other", "--output", "c"], "unsupported"),
    (["--profile", "--suite", "generation", "--output", "c"], "no value"),
    (["--profile", "a", "--suite", "generation", "--other", "c"], "unknown"),
):
    rejected(lambda arguments=arguments: cli.parse_arguments(arguments), message)

parsed = cli.parse_arguments([
    "--output", "result", "--profile", "profile.json", "--suite", "generation",
])
assert parsed.profile == pathlib.Path("profile.json")
assert parsed.output == pathlib.Path("result")

fixture = fixture_module()
with tempfile.TemporaryDirectory(prefix="gpu-qualification-cli-") as raw_temporary:
    temporary = pathlib.Path(raw_temporary)
    input_root = temporary / "input"
    input_root.mkdir()
    fixture.materialize(input_root)
    output_parent = temporary / "output"
    output_parent.mkdir()
    output = output_parent / "evidence"
    arguments = cli.Arguments(input_root / "profile.json", "generation", output)
    invocation = cli.open_invocation(arguments)
    assert invocation.root.parent == output_parent
    assert invocation.root.stat().st_mode & 0o077 == 0
    assert invocation.home.stat().st_mode & 0o077 == 0
    assert invocation.temporary.stat().st_mode & 0o077 == 0
    assert invocation.work.stat().st_mode & 0o077 == 0
    assert invocation.sources.align_llm.is_dir()
    assert invocation.sources.ggml.is_dir()
    assert not output.exists()
    root = invocation.root
    invocation.cleanup()
    assert not root.exists()

    occupied = output_parent / "occupied"
    occupied.write_text("occupied")
    before = set(output_parent.iterdir())
    rejected(
        lambda: cli.open_invocation(cli.Arguments(
            input_root / "profile.json", "generation", occupied,
        )),
        "must be a new path",
    )
    assert set(output_parent.iterdir()) == before

    before = set(input_root.iterdir())
    rejected(
        lambda: cli.open_invocation(cli.Arguments(
            input_root / "profile.json", "generation", input_root / "evidence",
        )),
        "outside the qualification input root",
    )
    assert set(input_root.iterdir()) == before

    malformed = input_root / "profile.json"
    original = malformed.read_bytes()
    malformed.write_bytes(original + b" ")
    before = set(output_parent.iterdir())
    rejected(lambda: cli.open_invocation(arguments), "record framing is invalid")
    assert set(output_parent.iterdir()) == before

print("gpu qualification CLI smoke: PASS")
