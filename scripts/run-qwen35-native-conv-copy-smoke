#!/usr/bin/env python3
"""Compare real-model complete logits and resident state across native copy modes."""

from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path

from gpu_session_client import Session, SessionError


def main() -> None:
    model = Path(os.environ["QWEN35_GGUF"]).resolve()
    pack = Path(os.environ["QWEN35_ALIGNPACK"]).resolve()
    geometry = Path(os.environ["QWEN35_MODEL_IR"]).resolve()
    options = Path(os.environ["QWEN35_RUNTIME_OPTIONS"]).resolve()
    binary = Path(os.environ["QWEN35_NATIVE_COPY_BINARY"]).resolve()
    expected = os.environ["QWEN35_EXPECTED_SHA256"]
    with model.open("rb") as stream:
        digest = hashlib.file_digest(stream, "sha256").hexdigest()
    if digest != expected:
        raise RuntimeError("GGUF differs from the recorded real-model source")
    command = [str(binary), "--runtime-session", str(model), str(pack),
               str(geometry), str(options), "0"]
    base = os.environ.copy()
    base["DYLD_LIBRARY_PATH"] = os.environ["QWEN35_LIB_PATH"]
    greedy = os.environ.get("QWEN35_NATIVE_COPY_GREEDY", "0")
    base["DYLD_INSERT_LIBRARIES"] = (os.environ["QWEN35_STATE_TRACE"] if greedy == "1"
                                     else ":".join((os.environ["QWEN35_STATE_TRACE"],
                                                    os.environ["QWEN35_LOGIT_TRACE"])))
    base["ALIGN_STATE_COUNT"] = "84"
    base["ALIGN_LOGIT_BYTES"] = "993280"
    base["ALIGN_LLM_PREFILL_CHUNK"] = "128"
    base["ALIGN_LLM_PREFILL_FINAL_LOGITS"] = "1"
    prefill = os.environ.get("QWEN35_NATIVE_PREFILL_COPY", "0")
    if prefill not in ("0", "1"):
        raise RuntimeError("expected 0 or 1 for native prefill copy")
    if greedy not in ("0", "1") or (prefill == "1" and greedy == "1"):
        raise RuntimeError("expected one native copy trial mode")
    if greedy == "1":
        base["ALIGN_GRAPH_LOGIT_BYTES"] = "993280"
    request = dict(schema_version=1,
                   system="You are a coding assistant. Return a concise patch-oriented answer.",
                   user="List the integers from 1 to 1000 in ascending order, separated by single spaces. Output only the integers.",
                   max_tokens=16, temperature=0.0, seed=None)

    invalid_modes = (("0", "1", "0", "0"), ("bad", "0", "0", "0"))
    if prefill == "1":
        invalid_modes += (("0", "0", "1", "0"), ("1", "0", "1", "0"),
                          ("1", "1", "bad", "0"))
    if greedy == "1":
        invalid_modes += (("0", "0", "0", "1"), ("1", "0", "0", "1"),
                          ("1", "1", "0", "bad"))
    for state, conv, selected_prefill, selected_greedy in invalid_modes:
        environment = dict(base, ALIGN_LLM_NATIVE_STATE_COPY=state,
                           ALIGN_LLM_NATIVE_CONV_COPY=conv,
                           ALIGN_LLM_NATIVE_PREFILL_STATE_COPY=selected_prefill,
                           ALIGN_LLM_NATIVE_COPY_GREEDY=selected_greedy)
        try:
            with Session(command, timeout=180, env=environment):
                raise RuntimeError("invalid copy mode acknowledged session construction")
        except SessionError:
            pass
    if greedy == "1":
        for conflict in ("ALIGN_LLM_SHARED_LOGITS", "ALIGN_LLM_NEON_GREEDY",
                         "ALIGN_LLM_GRAPH_GREEDY"):
            environment = dict(base, ALIGN_LLM_NATIVE_STATE_COPY="1",
                               ALIGN_LLM_NATIVE_CONV_COPY="1",
                               ALIGN_LLM_NATIVE_PREFILL_STATE_COPY="0",
                               ALIGN_LLM_NATIVE_COPY_GREEDY="1")
            environment[conflict] = "1"
            try:
                with Session(command, timeout=180, env=environment):
                    raise RuntimeError(f"conflicting {conflict} acknowledged session construction")
            except SessionError:
                pass

    observations = {}
    arms = (("delta", "1", "0", "0", "0"), ("mixed", "1", "1", "0", "0"))
    requests = [request, request]
    if prefill == "1":
        arms = (("mixed", "1", "1", "0", "0"), ("prefill", "1", "1", "1", "0"))
        requests = [request,
                    dict(request, user="hello " * 169),
                    request]
    if greedy == "1":
        arms = (("mixed", "1", "1", "0", "0"), ("greedy", "1", "1", "0", "1"))
        requests = [request,
                    dict(request, user="hello " * 169),
                    request]
    for name, state, conv, selected_prefill, selected_greedy in arms:
        environment = dict(base, ALIGN_LLM_NATIVE_STATE_COPY=state,
                           ALIGN_LLM_NATIVE_CONV_COPY=conv,
                           ALIGN_LLM_NATIVE_PREFILL_STATE_COPY=selected_prefill,
                           ALIGN_LLM_NATIVE_COPY_GREEDY=selected_greedy)
        with Session(command, timeout=180, env=environment) as session:
            results = [session.generate(item) for item in requests]
            session.log.seek(0)
            diagnostic = session.log.read().decode("utf-8", "replace")
        if any(row["prompt_tokens"] < 1 or row["completion_tokens"] != 16 for row in results):
            raise RuntimeError(f"{name}: unexpected actual work: "
                               f"{[(r['prompt_tokens'], r['completion_tokens']) for r in results]}")
        states = []
        logits = []
        complete = []
        graph = []
        for line in diagnostic.splitlines():
            if line.startswith("Q35_STATE "):
                row = json.loads(line[len("Q35_STATE "):])
                if row["event"] == "error" or row["event"] == "graph_failed":
                    raise RuntimeError(f"{name}: diagnostic graph failed: {row}")
                if row["event"] == "plane":
                    states.append((row["ordinal"], row["kind"], row["index"], row["sha256"]))
                elif row["event"] == "graph_complete":
                    complete.append(row["ordinal"])
                elif row["event"] == "graph":
                    graph.append(row)
            elif line.startswith("Q35_LOGIT "):
                row = json.loads(line[len("Q35_LOGIT "):])
                logits.append(row["sha256"])
        expected_graphs = sum((row["prompt_tokens"] + 127) // 128 + 15 for row in results)
        expected_logits = 16 * len(results)
        if len(logits) != expected_logits or len(graph) != expected_graphs or len(complete) != expected_graphs:
            raise RuntimeError(f"{name}: incomplete diagnostic trace: "
                               f"{len(logits)} logits, {len(graph)} graphs, {len(complete)} complete")
        if complete != list(range(expected_graphs)) or len(states) != expected_graphs * 84:
            raise RuntimeError(f"{name}: resident-state trace is incomplete")
        if name == "mixed":
            decode = [row for row in graph if row["kind"] != 0]
            if len(decode) != 15 * len(results) or any(row["ops"]["CPY"] != decode[0]["ops"]["CPY"]
                                       for row in decode):
                raise RuntimeError("mixed: decode graph topology changed within session")
        outputs = [(row["output"], row["prompt_tokens"], row["completion_tokens"])
                   for row in results]
        observations[name] = (outputs, states, logits, graph)
    control = observations["mixed" if prefill == "1" or greedy == "1" else "delta"]
    candidate = observations["prefill" if prefill == "1" else
                             "greedy" if greedy == "1" else "mixed"]
    if prefill == "1" and ([row[1] for row in control[0]][1] != 199
                           or [row[1] for row in control[0]][0]
                           != [row[1] for row in control[0]][2]):
        raise RuntimeError(f"native prefill owner did not exercise 128/71 chunks: {control[0]}")
    if control[:3] != candidate[:3]:
        raise RuntimeError("native copy changed output, state, or full logits")
    for ordinary, selected in zip(control[3], candidate[3]):
        if ordinary["kind"] != selected["kind"]:
            raise RuntimeError("graph kinds differ")
        removed = ordinary["ops"]["CPY"] - selected["ops"]["CPY"]
        expected_removed = 36 if prefill == "1" and ordinary["kind"] == 0 else (
            18 if prefill == "0" and greedy == "0" and ordinary["kind"] != 0 else 0)
        if removed != expected_removed:
            raise RuntimeError(f"native copy removed {removed} CPY nodes, expected {expected_removed}")
    print(f"invalid modes refused; {len(control[2])} full logits and {len(control[1])} resident planes match exactly")
    print(f"{len(control[3])} graphs match; native copy removed the expected CPY nodes")


if __name__ == "__main__":
    main()
