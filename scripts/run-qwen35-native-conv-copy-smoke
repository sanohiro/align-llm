#!/usr/bin/env python3
"""Compare real-model complete logits and resident state across native copy modes."""

from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path

from gpu_session_client import Session, SessionError


def main() -> None:
    model = Path(os.environ["QWEN35_GGUF"]).resolve()
    pack = Path(os.environ["QWEN35_ALIGNPACK"]).resolve()
    geometry = Path(os.environ["QWEN35_MODEL_IR"]).resolve()
    options = Path(os.environ["QWEN35_RUNTIME_OPTIONS"]).resolve()
    binary = Path(os.environ["QWEN35_NATIVE_COPY_BINARY"]).resolve()
    expected = os.environ["QWEN35_EXPECTED_SHA256"]
    with model.open("rb") as stream:
        digest = hashlib.file_digest(stream, "sha256").hexdigest()
    if digest != expected:
        raise RuntimeError("GGUF differs from the recorded real-model source")
    command = [str(binary), "--runtime-session", str(model), str(pack),
               str(geometry), str(options), "0"]
    base = os.environ.copy()
    base["DYLD_LIBRARY_PATH"] = os.environ["QWEN35_LIB_PATH"]
    base["DYLD_INSERT_LIBRARIES"] = ":".join((os.environ["QWEN35_STATE_TRACE"],
                                                   os.environ["QWEN35_LOGIT_TRACE"]))
    base["ALIGN_STATE_COUNT"] = "84"
    base["ALIGN_LOGIT_BYTES"] = "993280"
    request = dict(schema_version=1,
                   system="You are a coding assistant. Return a concise patch-oriented answer.",
                   user="List the integers from 1 to 1000 in ascending order, separated by single spaces. Output only the integers.",
                   max_tokens=16, temperature=0.0, seed=None)

    for state, conv in (("0", "1"), ("bad", "0")):
        environment = dict(base, ALIGN_LLM_NATIVE_STATE_COPY=state,
                           ALIGN_LLM_NATIVE_CONV_COPY=conv)
        try:
            with Session(command, timeout=180, env=environment):
                raise RuntimeError("invalid copy mode acknowledged session construction")
        except SessionError:
            pass

    observations = {}
    for name, state, conv in (("delta", "1", "0"), ("mixed", "1", "1")):
        environment = dict(base, ALIGN_LLM_NATIVE_STATE_COPY=state,
                           ALIGN_LLM_NATIVE_CONV_COPY=conv)
        with Session(command, timeout=180, env=environment) as session:
            results = [session.generate(request), session.generate(request)]
            session.log.seek(0)
            diagnostic = session.log.read().decode("utf-8", "replace")
        if any(row["prompt_tokens"] < 1 or row["completion_tokens"] != 16 for row in results):
            raise RuntimeError(f"{name}: unexpected actual work: "
                               f"{[(r['prompt_tokens'], r['completion_tokens']) for r in results]}")
        states = []
        logits = []
        complete = []
        graph = []
        for line in diagnostic.splitlines():
            if line.startswith("Q35_STATE "):
                row = json.loads(line[len("Q35_STATE "):])
                if row["event"] == "error" or row["event"] == "graph_failed":
                    raise RuntimeError(f"{name}: diagnostic graph failed: {row}")
                if row["event"] == "plane":
                    states.append((row["ordinal"], row["kind"], row["index"], row["sha256"]))
                elif row["event"] == "graph_complete":
                    complete.append(row["ordinal"])
                elif row["event"] == "graph":
                    graph.append(row)
            elif line.startswith("Q35_LOGIT "):
                row = json.loads(line[len("Q35_LOGIT "):])
                logits.append(row["sha256"])
        if len(logits) != 32 or len(graph) != 32 or len(complete) != 32:
            raise RuntimeError(f"{name}: incomplete diagnostic trace: "
                               f"{len(logits)} logits, {len(graph)} graphs, {len(complete)} complete")
        if complete != list(range(32)) or len(states) != 32 * 84:
            raise RuntimeError(f"{name}: resident-state trace is incomplete")
        if name == "mixed":
            decode = [row for row in graph if row["kind"] != 0]
            if len(decode) != 30 or any(row["ops"]["CPY"] != graph[1]["ops"]["CPY"]
                                       for row in decode):
                raise RuntimeError("mixed: decode graph topology changed within session")
        outputs = [(row["output"], row["prompt_tokens"], row["completion_tokens"])
                   for row in results]
        observations[name] = (outputs, states, logits, graph)
    control = observations["delta"]
    mixed = observations["mixed"]
    if control[:3] != mixed[:3]:
        raise RuntimeError("mixed native convolution copy changed output, state, or full logits")
    for ordinary, candidate in zip(control[3], mixed[3]):
        if ordinary["kind"] != candidate["kind"]:
            raise RuntimeError("graph kinds differ")
        if ordinary["kind"] != 0 and ordinary["ops"]["CPY"] - candidate["ops"]["CPY"] != 18:
            raise RuntimeError("native convolution mode did not remove 18 decode CPY nodes")
    print("invalid modes refused; 32 full logits and 2688 resident planes match exactly")
    print("30 decode graphs each remove 18 convolution CPY nodes")


if __name__ == "__main__":
    main()
