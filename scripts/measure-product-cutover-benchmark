#!/usr/bin/env python3
"""Measure the fixed paired experiment, retaining all observations and failures."""
import sys
if sys.flags.optimize:
 raise RuntimeError('optimized Python is unsupported for measurement verification')
import hashlib,json,os,platform,resource,statistics,subprocess,time
from pathlib import Path
ROOT=Path(os.environ['BENCHMARK_DATA_ROOT']).resolve(strict=True)
DATA=ROOT
if (ROOT/'results.json').exists():
 raise ValueError('results.json already exists; prepare a fresh experiment directory')
ARMS={'before':(DATA/'legacy/build/main',DATA/'legacy/project'),'after':(DATA/'native/main',DATA/'native')}
if 'BENCHMARK_REFERENCE_DATA_ROOT' in os.environ:
 raise ValueError('reference substitution is unsupported; this tool replays the frozen pair only')
ENV={key:os.environ[key] for key in ['PATH','LD_LIBRARY_PATH'] if key in os.environ};ENV.update(LANG='C',LC_ALL='C',PYTHONDONTWRITEBYTECODE='1')
def source_identity(project):
 source=project/'eval/fixtures/python-inclusive-range-v1/repository'
 return {str(p.relative_to(source)):hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(source.rglob('*')) if p.is_file()}
initial_sources={arm:source_identity(project) for arm,(_,project) in ARMS.items()}
if initial_sources['before']!=initial_sources['after']:
 raise ValueError('paired source bytes differ')
limit=time.monotonic()+1200
records=[]
raw=ROOT/'raw';raw.mkdir(exist_ok=True)
identity={'schema_version':1,'source_commits':json.loads((ROOT/'source-identities.json').read_text()),'plan':json.loads((ROOT/'plan.json').read_text()),'host':platform.uname()._asdict(),'binaries':{arm:hashlib.sha256(binary.read_bytes()).hexdigest() for arm,(binary,_) in ARMS.items()},'sources':initial_sources,'samples':records}
expected=json.loads((Path(__file__).resolve().parent.parent/'eval/benchmarks/product-cutover-2026-09-13.json').read_text())
if identity['binaries']!=expected['binaries'] or identity['plan']!=expected['plan'] or initial_sources!=expected['sources']:
 raise ValueError('prepared experiment does not match the frozen baseline')
for arm,commit in [('before','9855afe1e3b7e73c758463ed2f32e13bc9b6a550'),('after','2f25c3faba4fc12c0035a5c168b38dc3f0ba935d')]:
 if identity['source_commits'][arm]['commit']!=commit:
  raise ValueError(arm+' baseline source identity mismatch')
dependencies={}
for arm,(binary,_) in ARMS.items():
 listing=subprocess.check_output(['ldd',str(binary)],text=True,env=ENV)
 paths=[]
 for line in listing.splitlines():
  words=line.strip().split()
  if 'not found' in line: raise RuntimeError('unresolved dependency: '+line)
  value=None
  if '=>' in words: value=words[words.index('=>')+1]
  elif words and words[0].startswith('/'): value=words[0]
  if value and value.startswith('/'): paths.append(Path(value).resolve(strict=True))
 dependencies[arm]={p.name:hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
if dependencies['before']!=dependencies['after']:
 raise ValueError('native dependency mismatch invalidates the paired comparison')
identity['native_dependencies_sha256']=dependencies
identity['python_sha256']=hashlib.sha256(Path(os.path.realpath(__import__('sys').executable)).read_bytes()).hexdigest()
def save(): (ROOT/'results.json').write_text(json.dumps(identity,indent=2)+'\n')
for pair in range(11):
 for arm in (['before','after'] if pair%2==0 else ['after','before']):
  if time.monotonic()>=limit:raise RuntimeError('complete measurement ceiling exceeded')
  binary,project=ARMS[arm]
  for name in ['result.json','evidence.json']:(project/name).unlink(missing_ok=True)
  start=time.perf_counter_ns();cpu=resource.getrusage(resource.RUSAGE_CHILDREN)
  completed=subprocess.run([str(binary),'prompt','evaluate',str(project/'evaluate-request.json'),'result.json'],cwd=project,env=ENV,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=min(120,limit-time.monotonic()))
  elapsed=time.perf_counter_ns()-start;aftercpu=resource.getrusage(resource.RUSAGE_CHILDREN)
  label=f'{pair:02}-{arm}'
  (raw/(label+'.stdout')).write_bytes(completed.stdout);(raw/(label+'.stderr')).write_bytes(completed.stderr)
  if not (project/'result.json').exists():raise RuntimeError(f'{label} no result: {completed.returncode}, {completed.stderr[-2000:]}')
  result=json.loads((project/'result.json').read_bytes());(raw/(label+'.json')).write_bytes((project/'result.json').read_bytes())
  rows=result.get('rows',[])
  record={'pair':pair,'warmup':pair<2,'arm':arm,'wall_ns':elapsed,'child_cpu_seconds':aftercpu.ru_utime+aftercpu.ru_stime-cpu.ru_utime-cpu.ru_stime,'exit_code':completed.returncode,'status':result.get('status'),'row_count':len(rows),'row_statuses':[r['measurement']['status'] for r in rows],'row_passing_patch_ns':[r['time_to_passing_patch_ns'] for r in rows]}
  records.append(record);save();print(json.dumps(record),flush=True)
  if completed.returncode!=0 or len(rows)!=8 or any(r['measurement']['status']!='PASS' for r in rows):
   raise RuntimeError(str((label,result.get('error'),result.get('error_code'))))
  if list((project/'workspace').iterdir()): raise RuntimeError('workspace not cleaned')
  if source_identity(project)!=initial_sources[arm]: raise RuntimeError('source bytes changed')
  if not all(r['measurement']['cleanup_passed'] and r['measurement']['containment_passed'] for r in rows):
   raise RuntimeError('containment or cleanup failed')
summary={}
for arm in ARMS:
 samples=[r for r in records if r['arm']==arm and not r['warmup']]
 summary[arm]={'median_wall_ns':statistics.median(r['wall_ns'] for r in samples),'min_wall_ns':min(r['wall_ns'] for r in samples),'max_wall_ns':max(r['wall_ns'] for r in samples),'median_cpu_seconds':statistics.median(r['child_cpu_seconds'] for r in samples)}
summary['wall_reduction_fraction']=1-summary['after']['median_wall_ns']/summary['before']['median_wall_ns']
summary['faster_pairs']=sum(next(r for r in records if r['pair']==p and r['arm']=='after')['wall_ns']<next(r for r in records if r['pair']==p and r['arm']=='before')['wall_ns'] for p in range(2,11))
identity['summary']=summary;save();print(json.dumps(summary,indent=2),flush=True)
