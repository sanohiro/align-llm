class CombinedBoundaryError(RuntimeError):
    pass


def source_identities() -> tuple[str, ...]:
    return tuple(base.file_sha256(path) for path in SOURCE_PATHS)


def validate_imported_contract() -> None:
    actual = (
        claim.MODEL_BYTES, claim.MODEL_SHA256, claim.SERVER_BUILD, claim.BUDGET,
        claim.SEED, claim.FULL_TOKENS, claim.TEMPERATURE_MICROS,
        claim.FULL_OUTPUT_SHA256, claim.REPETITIONS, claim.CEILING_SECONDS,
        claim.EXPECTED_ALIGN_REVISION, claim.EXPECTED_COMPILER_SHA256,
        claim.EXPECTED_PACK_SHA256, claim.EXPECTED_GEOMETRY_SHA256,
        claim.EXPECTED_SERVER_SHA256, claim.EXPECTED_TASK_SHA256,
        claim.EXPECTED_PROMPT_SHA256, claim.EXPECTED_C_COMPILER_SHA256,
        claim.EXPECTED_C_COMPILER_VERSION_SHA256, claim.EXPECTED_LINKER_SEARCH_SHA256,
        claim.EXPECTED_GGML_LIBRARIES, claim.EXPECTED_GGML_HEADERS,
        claim.EXPECTED_BASELINE_HOST, claim.EXPECTED_BASELINE_HOST_SHA256,
    )
    expected = (
        MODEL_BYTES, MODEL_SHA256, SERVER_BUILD, BUDGET, SEED, FULL_TOKENS,
        TEMPERATURE_MICROS, FULL_OUTPUT_SHA256, REPETITIONS, CEILING_SECONDS,
        EXPECTED_ALIGN_REVISION, EXPECTED_COMPILER_SHA256, EXPECTED_PACK_SHA256,
        EXPECTED_GEOMETRY_SHA256, EXPECTED_SERVER_SHA256, EXPECTED_TASK_SHA256,
        EXPECTED_PROMPT_SHA256, EXPECTED_C_COMPILER_SHA256,
        EXPECTED_C_COMPILER_VERSION_SHA256, EXPECTED_LINKER_SEARCH_SHA256,
        EXPECTED_GGML_LIBRARIES, EXPECTED_GGML_HEADERS, EXPECTED_BASELINE_HOST,
        EXPECTED_BASELINE_HOST_SHA256,
    )
    if actual != expected:
        raise CombinedBoundaryError("imported item 66 workload or environment drifted")
    if source_identities() != EXPECTED_SOURCE_IDENTITIES:
        raise CombinedBoundaryError("item 67 source chain drifted")
    if diagnosis.integer_median(BASELINE_VALUES_NS) != BASELINE_MEDIAN_NS:
        raise CombinedBoundaryError("item 62 full-helper baseline median drifted")
    expected_floor = (BASELINE_MEDIAN_NS * FLOOR_PPM + 999_999) // 1_000_000
    if expected_floor != MINIMUM_GAIN_NS \
            or BASELINE_MEDIAN_NS - MINIMUM_GAIN_NS != CANDIDATE_CEILING_NS:
        raise CombinedBoundaryError("item 67 shipping gate arithmetic drifted")
    if CACHE_SLOT_COUNT * CACHE_KEY_BYTES != CACHE_CAPACITY_BYTES \
            or CACHE_CAPACITY_BYTES > BUDGET:
        raise CombinedBoundaryError("fixed cache geometry drifted")


def validate_helper_record(record: dict[str, Any], maximum_tokens: int) -> None:
    diagnosis.require_exact_keys(record, HELPER_KEYS, "helper record")
    compute.validate_helper_record(claim.inherited_record(record), maximum_tokens)
    detail = record["claim_io"]
    if not isinstance(detail, dict):
        raise CombinedBoundaryError("claim-I/O detail was not an object")
    diagnosis.require_exact_keys(detail, DETAIL_KEYS, "claim I/O")
    if any(not diagnosis.is_int(detail[name]) or detail[name] < 0 for name in DETAIL_KEYS):
        raise CombinedBoundaryError("claim-I/O timing was invalid")
    if maximum_tokens == 2:
        if any(detail.values()):
            raise CombinedBoundaryError("conditioning entered remaining-decode claim I/O")
        return
    if detail["cache_to_claim_copy_ns"] != 0:
        raise CombinedBoundaryError("direct provider path copied cache hits into claims")
    if any(detail[name] <= 0 for name in DETAIL_KEYS - {"cache_to_claim_copy_ns"}):
        raise CombinedBoundaryError("full direct claim-I/O clock was not positive")
    if detail["total_ns"] != record["remaining_decode"]["claim_pread_ns"]:
        raise CombinedBoundaryError("claim-I/O total did not match remaining decode")
    if sum(detail[name] for name in DETAIL_KEYS - {"total_ns"}) != detail["total_ns"]:
        raise CombinedBoundaryError("claim-I/O detail did not partition its total")
    if record["engine"]["expert_cache_bytes_fetched"] != FULL_CACHE_BYTES_FETCHED:
        raise CombinedBoundaryError("direct cache source-byte accounting drifted")
    if record["decode_compute"]["routing_ns"] <= 0:
        raise CombinedBoundaryError("full live-width phase-A clock was not positive")
    if record["pass_other"]["plane_roundtrip_compare_ns"] <= 0:
        raise CombinedBoundaryError("full direct plane-roundtrip clock was not positive")


def validate_sample(sample: dict[str, Any], expected_index: int) -> None:
    compute.validate_sample(claim.inherited_sample(sample), expected_index)
    validate_helper_record(sample["conditioning"], 2)
    validate_helper_record(sample["full"], FULL_TOKENS)


def validate_repeatability(samples: list[dict[str, Any]]) -> None:
    compute.validate_repeatability([claim.inherited_sample(sample) for sample in samples])


def measure_request(
    helper: Path,
    model: Path,
    pack: Path,
    geometry: Path,
    maximum_tokens: int,
    runtime_env: dict[str, str],
    deadline: float,
) -> tuple[dict[str, Any], int]:
    started_ns = time.monotonic_ns()
    completed = owner.run_process(
        [str(helper), str(model), str(pack), str(geometry), diagnosis.PROMPT_TEXT,
         str(maximum_tokens), str(SEED)],
        deadline=deadline, maximum=240, env=runtime_env,
    )
    helper_wall_ns = time.monotonic_ns() - started_ns
    try:
        record = json.loads(completed.stdout.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as error:
        raise CombinedBoundaryError("helper did not emit one JSON record") from error
    if not isinstance(record, dict):
        raise CombinedBoundaryError("helper record was not an object")
    validate_helper_record(record, maximum_tokens)
    if helper_wall_ns < record["phases"]["elapsed_ns"]:
        raise CombinedBoundaryError("helper wall interval did not contain helper elapsed")
    return record, helper_wall_ns


def measure_sample(
    index: int,
    built: dict[str, Any],
    server: Path,
    model: Path,
    pack: Path,
    geometry: Path,
    clean_env: dict[str, str],
    deadline: float,
) -> dict[str, Any]:
    owner.require_no_matching_process(server, model, deadline, clean_env)
    conditioning, _ = measure_request(
        built["helper"], model, pack, geometry, 2, built["runtime_env"], deadline,
    )
    owner.require_no_matching_process(server, model, deadline, clean_env)
    try:
        full, full_wall = measure_request(
            built["helper"], model, pack, geometry, FULL_TOKENS,
            built["runtime_env"], deadline,
        )
    finally:
        owner.require_no_matching_process(server, model, deadline, clean_env)
    sample = {
        "index": index,
        "conditioning": conditioning,
        "full": full,
        "full_helper_wall_ns": full_wall,
        "isolation": {"matching_before": 0, "matching_between": 0, "matching_after": 0},
    }
    validate_sample(sample, index)
    return sample


def aggregate(samples: list[dict[str, Any]]) -> dict[str, Any]:
    if len(samples) != REPETITIONS:
        raise CombinedBoundaryError("aggregate requires four samples")
    for index, sample in enumerate(samples, 1):
        validate_sample(sample, index)
    validate_repeatability(samples)
    walls = [sample["full_helper_wall_ns"] for sample in samples]
    phase_a = [sample["full"]["decode_compute"]["routing_ns"] for sample in samples]
    plane = [
        sample["full"]["pass_other"]["plane_roundtrip_compare_ns"] for sample in samples
    ]
    copies = [sample["full"]["claim_io"]["cache_to_claim_copy_ns"] for sample in samples]
    candidate_median = diagnosis.integer_median(walls)
    gain = BASELINE_MEDIAN_NS - candidate_median
    decision = "MET" if candidate_median <= CANDIDATE_CEILING_NS else "NOT_MET"
    return {
        "candidate_full_helper_wall_values_ns": walls,
        "candidate_full_helper_wall_median_ns": candidate_median,
        "phase_a_values_ns": phase_a,
        "phase_a_median_ns": diagnosis.integer_median(phase_a),
        "plane_roundtrip_values_ns": plane,
        "plane_roundtrip_median_ns": diagnosis.integer_median(plane),
        "cache_to_claim_copy_values_ns": copies,
        "cache_to_claim_copy_median_ns": diagnosis.integer_median(copies),
        "baseline_median_ns": BASELINE_MEDIAN_NS,
        "gain_ns": gain,
        "gain_ppm": gain * 1_000_000 // BASELINE_MEDIAN_NS,
        "floor_ppm": FLOOR_PPM,
        "minimum_gain_ns": MINIMUM_GAIN_NS,
        "candidate_ceiling_ns": CANDIDATE_CEILING_NS,
        "decision": decision,
    }


def predecessor_result(result: dict[str, Any]) -> dict[str, Any]:
    samples = [claim.inherited_sample(sample) for sample in result["samples"]]
    return {
        "schema_version": 1,
        "artifact_kind": "R8_OLMOE_DECODE_COMPUTE_DIAGNOSIS",
        "status": "COMPLETE",
        "model": result["model"],
        "baseline": {
            "full_helper_wall_values_ns": compute.BASELINE_FULL_VALUES_NS,
            "full_helper_wall_median_ns": compute.BASELINE_FULL_MEDIAN_NS,
            "compute_median_ns": compute.BASELINE_COMPUTE_MEDIAN_NS,
            "floor_ppm": compute.FLOOR_PPM,
            "floor_ns": compute.FLOOR_NS,
        },
        "candidate": result["candidate"],
        "task": result["task"],
        "environment": result["environment"],
        "samples": samples,
        "aggregate": compute.aggregate(samples),
        "elapsed_ns": result["elapsed_ns"],
    }


def validate_result(result: dict[str, Any]) -> None:
    diagnosis.require_exact_keys(result, TOP_KEYS, "result")
    if result["schema_version"] != 1 or result["status"] != "COMPLETE" \
            or result["artifact_kind"] != "R8_OLMOE_COMBINED_DECODE_BOUNDARIES":
        raise CombinedBoundaryError("result identity drifted")
    compute.validate_result(predecessor_result(result))
    expected_baseline = {
        "full_helper_wall_values_ns": BASELINE_VALUES_NS,
        "full_helper_wall_median_ns": BASELINE_MEDIAN_NS,
        "floor_ppm": FLOOR_PPM,
        "minimum_gain_ns": MINIMUM_GAIN_NS,
        "candidate_ceiling_ns": CANDIDATE_CEILING_NS,
    }
    diagnosis.require_exact_keys(result["baseline"], BASELINE_KEYS, "result baseline")
    if result["baseline"] != expected_baseline:
        raise CombinedBoundaryError("result baseline drifted")
    expected_intervention = {
        "phase_a_width": "N_PAST_PLUS_ONE",
        "phase_a_pad_rows_skipped_per_layer": 2,
        "plane_source": "HOST_VISIBLE_CONCAT_SLOT",
        "plane_compare": "EXACT_BYTES",
        "plane_v_fast_path": "UNALIGNED_SAFE_AARCH64_4X4",
        "expert_source": "FIXED_STRIDE_CACHE",
        "direct_scope": "PROVIDER_GENERATION",
        "fallback": "COMPACT_CLAIM",
        "cache_key_bytes": CACHE_KEY_BYTES,
        "cache_slot_count": CACHE_SLOT_COUNT,
        "cache_capacity_bytes": CACHE_CAPACITY_BYTES,
        "full_cache_bytes_fetched": FULL_CACHE_BYTES_FETCHED,
        "full_cache_to_claim_copy_ns": 0,
    }
    diagnosis.require_exact_keys(result["intervention"], INTERVENTION_KEYS, "intervention")
    if result["intervention"] != expected_intervention:
        raise CombinedBoundaryError("intervention identity drifted")
    diagnosis.require_exact_keys(result["aggregate"], AGGREGATE_KEYS, "result aggregate")
    if result["aggregate"] != aggregate(result["samples"]):
        raise CombinedBoundaryError("result aggregate drifted")
    if not diagnosis.is_int(result["elapsed_ns"]) or result["elapsed_ns"] <= 0:
        raise CombinedBoundaryError("result elapsed interval was invalid")


def prerequisites() -> tuple[Path, Path, Path, Path, Path, Path] | None:
    rows = (
        ("ALIGN_LLM_OLMOE_MODEL", base.configured_file("ALIGN_LLM_OLMOE_MODEL")),
        ("ALIGN_LLM_MOE_ALIGNPACK", base.configured_file("ALIGN_LLM_MOE_ALIGNPACK")),
        ("ALIGN_LLM_MOE_GEOMETRY", base.configured_file("ALIGN_LLM_MOE_GEOMETRY")),
        ("ALIGN_LLM_GGML_INCLUDE", base.configured_directory("ALIGN_LLM_GGML_INCLUDE")),
        ("ALIGN_LLM_GGML_LIB", base.configured_directory("ALIGN_LLM_GGML_LIB")),
        ("ALIGN_LLM_LLAMA_SERVER", base.configured_file("ALIGN_LLM_LLAMA_SERVER", executable=True)),
    )
    missing = next((name for name, path in rows if path is None), None)
    if missing is not None:
        print(f"R8-OLMOE-COMBINED-DECODE-BOUNDARIES: N/A ({missing} unset)")
        return None
    return tuple(path.resolve() for _, path in rows)  # type: ignore[return-value]


def synthetic_samples(walls: list[int]) -> list[dict[str, Any]]:
    samples = claim.synthetic_samples({
        "FILE_PREAD": 100,
        "BLOCK_TO_CLAIM_COPY": 100,
        "CLAIM_TO_CACHE_COPY": 100,
        "CACHE_TO_CLAIM_COPY": 0,
        "OTHER_CLAIM_IO": 100,
    })
    for sample, wall in zip(samples, walls, strict=True):
        sample["full_helper_wall_ns"] = wall
        sample["full"]["engine"]["expert_cache_bytes_fetched"] = FULL_CACHE_BYTES_FETCHED
    return samples


def synthetic_result(samples: list[dict[str, Any]]) -> dict[str, Any]:
    inherited = compute.synthetic_result([claim.inherited_sample(sample) for sample in samples])
    return {
        "schema_version": 1,
        "artifact_kind": "R8_OLMOE_COMBINED_DECODE_BOUNDARIES",
        "status": "COMPLETE",
        "model": inherited["model"],
        "baseline": {
            "full_helper_wall_values_ns": BASELINE_VALUES_NS,
            "full_helper_wall_median_ns": BASELINE_MEDIAN_NS,
            "floor_ppm": FLOOR_PPM,
            "minimum_gain_ns": MINIMUM_GAIN_NS,
            "candidate_ceiling_ns": CANDIDATE_CEILING_NS,
        },
        "candidate": inherited["candidate"],
        "intervention": {
            "phase_a_width": "N_PAST_PLUS_ONE",
            "phase_a_pad_rows_skipped_per_layer": 2,
            "plane_source": "HOST_VISIBLE_CONCAT_SLOT",
            "plane_compare": "EXACT_BYTES",
            "plane_v_fast_path": "UNALIGNED_SAFE_AARCH64_4X4",
            "expert_source": "FIXED_STRIDE_CACHE",
            "direct_scope": "PROVIDER_GENERATION",
            "fallback": "COMPACT_CLAIM",
            "cache_key_bytes": CACHE_KEY_BYTES,
            "cache_slot_count": CACHE_SLOT_COUNT,
            "cache_capacity_bytes": CACHE_CAPACITY_BYTES,
            "full_cache_bytes_fetched": FULL_CACHE_BYTES_FETCHED,
            "full_cache_to_claim_copy_ns": 0,
        },
        "task": inherited["task"],
        "environment": inherited["environment"],
        "samples": samples,
        "aggregate": aggregate(samples),
        "elapsed_ns": 1,
    }


def expect_error(action: Any, message: str) -> None:
    try:
        action()
    except Exception:
        return
    raise CombinedBoundaryError(message)


def complete_result_after_cleanup(result: dict[str, Any], started_ns: int) -> dict[str, Any]:
    completed = dict(result)
    elapsed_ns = time.monotonic_ns() - started_ns
    if elapsed_ns > CEILING_SECONDS * 1_000_000_000:
        raise CombinedBoundaryError(
            f"complete qualification exceeded its 8-minute ceiling ({elapsed_ns / 1e9:.1f}s)"
        )
    completed["elapsed_ns"] = elapsed_ns
    validate_result(completed)
    return completed


def self_test() -> int:
    validate_imported_contract()
    at_ceiling = synthetic_samples([CANDIDATE_CEILING_NS] * REPETITIONS)
    if aggregate(at_ceiling)["decision"] != "MET":
        raise CombinedBoundaryError("candidate at ceiling did not meet gate")
    above = synthetic_samples([CANDIDATE_CEILING_NS + 1] * REPETITIONS)
    if aggregate(above)["decision"] != "NOT_MET":
        raise CombinedBoundaryError("candidate above ceiling met gate")
    result = synthetic_result(at_ceiling)
    validate_result(result)
    malformed = synthetic_samples([CANDIDATE_CEILING_NS] * REPETITIONS)
    malformed[0]["full"]["claim_io"]["cache_to_claim_copy_ns"] = True
    expect_error(lambda: aggregate(malformed), "boolean cache-to-claim clock was accepted")
    malformed = synthetic_samples([CANDIDATE_CEILING_NS] * REPETITIONS)
    malformed[0]["full"]["claim_io"]["cache_to_claim_copy_ns"] = 1
    expect_error(lambda: aggregate(malformed), "nonzero cache-to-claim clock was accepted")
    malformed = synthetic_samples([CANDIDATE_CEILING_NS] * REPETITIONS)
    malformed[0]["full"]["decode_compute"]["routing_ns"] = True
    expect_error(lambda: aggregate(malformed), "boolean phase-A clock was accepted")
    malformed = synthetic_samples([CANDIDATE_CEILING_NS] * REPETITIONS)
    malformed[0]["full"]["pass_other"]["plane_roundtrip_compare_ns"] = True
    expect_error(lambda: aggregate(malformed), "boolean plane-roundtrip clock was accepted")
    malformed_result = dict(result)
    malformed_result["candidate"] = {"bad": True}
    expect_error(lambda: validate_result(malformed_result), "malformed inherited candidate accepted")
    with mock.patch.object(base, "file_sha256", return_value="0" * 64):
        expect_error(validate_imported_contract, "transitive source drift was accepted")
    incomplete = dict(result)
    incomplete["elapsed_ns"] = 0
    with mock.patch.object(time, "monotonic_ns", return_value=2_000):
        finalized = complete_result_after_cleanup(incomplete, 1_000)
    if finalized["elapsed_ns"] != 1_000:
        raise CombinedBoundaryError("cleanup-inclusive elapsed time was not finalized")
    with mock.patch.dict(os.environ, {}, clear=True), mock.patch("builtins.print") as printed:
        if prerequisites() is not None:
            raise CombinedBoundaryError("missing prerequisites did not produce N/A")
    printed.assert_called_once_with(
        "R8-OLMOE-COMBINED-DECODE-BOUNDARIES: N/A (ALIGN_LLM_OLMOE_MODEL unset)"
    )
    print("R8-OLMOE-COMBINED-DECODE-BOUNDARIES self-test: PASS")
    return 0


def main() -> int:
    if sys.argv[1:] == ["--self-test"]:
        return self_test()
    if len(sys.argv) != 1:
        raise CombinedBoundaryError("qualification accepts no arguments")
    required = prerequisites()
    if required is None:
        return 0
    model, pack, geometry, include, library, server = required
    started_ns = time.monotonic_ns()
    deadline = time.monotonic() + CEILING_SECONDS

    with tempfile.TemporaryDirectory(prefix="align-r8-olmoe-combined-") as raw:
        work = Path(raw)
        clean_env = transfer.phase.decision.decision_environment()
        linker_search = transfer.phase.decision.validate_linker_search(clean_env)
        if linker_search:
            clean_env["LIBRARY_PATH"] = linker_search
        host_environment = transfer.qualification_host(clean_env, deadline)
        source_status = owner.run_process(
            ["git", "status", "--porcelain", "--untracked-files=all"],
            deadline=deadline, maximum=30, env=clean_env,
        )
        if source_status.stdout:
            raise CombinedBoundaryError("real qualification requires a clean worktree")
        align_llm_head = owner.run_process(
            ["git", "rev-parse", "HEAD"], deadline=deadline, maximum=30, env=clean_env,
        ).stdout.decode("ascii").strip()
        validate_imported_contract()
        align_revision = (ROOT / ".align-revision").read_text(encoding="utf-8").strip()
        owner.require_no_matching_process(server, model, deadline, clean_env)
        if model.stat().st_size != MODEL_BYTES or base.file_sha256(model) != MODEL_SHA256:
            raise CombinedBoundaryError("configured OLMoE GGUF does not have pinned identity")
        pack_sha256 = base.file_sha256(pack)
        geometry_sha256 = base.file_sha256(geometry)
        server_sha256 = base.file_sha256(server)
        task_sha256 = base.file_sha256(diagnosis.TASK)
        prompt_sha256 = base.bytes_sha256(diagnosis.PROMPT_TEXT.encode("utf-8"))
        ggml_libraries = base.library_identities(library)
        ggml_headers = compute.predecessor.ggml_header_identities(include)
        if ggml_headers != EXPECTED_GGML_HEADERS:
            raise CombinedBoundaryError("configured ggml header identity drifted")
        linker_search_sha256 = (
            None if not linker_search else base.bytes_sha256(linker_search.encode("utf-8"))
        )
        diagnosis.validate_external_identity(
            align_revision=align_revision, pack_sha256=pack_sha256,
            geometry_sha256=geometry_sha256, server_sha256=server_sha256,
            task_sha256=task_sha256, prompt_sha256=prompt_sha256,
            ggml_libraries=ggml_libraries, linker_search_sha256=linker_search_sha256,
        )
        version = owner.run_process(
            [str(server), "--version"], deadline=deadline, maximum=30, env=clean_env,
        )
        if SERVER_BUILD not in (version.stdout + version.stderr).decode("utf-8", "replace"):
            raise CombinedBoundaryError("llama-server build identity drifted")

        with compute.other.predecessor.built_helper_for(
            work, include, library, clean_env, deadline,
            "src/olmoe_combined_decode_gate.align", "olmoe_combined_decode_gate",
            "olmoe-combined-decode-gate",
        ) as built:
            diagnosis.validate_toolchain_identity(built)
            samples = []
            for index in range(1, REPETITIONS + 1):
                samples.append(
                    measure_sample(index, built, server, model, pack, geometry, clean_env, deadline)
                )
                validate_repeatability(samples)

            final_status = owner.run_process(
                ["git", "status", "--porcelain", "--untracked-files=all"],
                deadline=deadline, maximum=30, env=clean_env,
            )
            final_head = owner.run_process(
                ["git", "rev-parse", "HEAD"], deadline=deadline, maximum=30, env=clean_env,
            ).stdout.decode("ascii").strip()
            if final_status.stdout or final_head != align_llm_head:
                raise CombinedBoundaryError("align-llm source changed during qualification")
            if source_identities() != EXPECTED_SOURCE_IDENTITIES:
                raise CombinedBoundaryError("qualification sources changed during the run")
            owner.verify_identities((
                ("model", model, MODEL_SHA256), ("pack", pack, pack_sha256),
                ("geometry", geometry, geometry_sha256), ("server", server, server_sha256),
                ("task", diagnosis.TASK, task_sha256),
                ("compiler", built["compiler"], built["compiler_sha256"]),
                ("C compiler", built["c_compiler"], built["c_compiler_sha256"]),
                ("shim", built["shim"], built["shim_sha256"]),
                ("helper", built["helper"], built["helper_sha256"]),
            ))
            if base.library_identities(library) != ggml_libraries:
                raise CombinedBoundaryError("ggml library identities changed during qualification")
            if compute.predecessor.ggml_header_identities(include) != ggml_headers:
                raise CombinedBoundaryError("ggml headers changed during qualification")
            owner.require_no_matching_process(server, model, deadline, clean_env)

            task_document = json.loads(diagnosis.TASK.read_text(encoding="utf-8"))
            result = {
                "schema_version": 1,
                "artifact_kind": "R8_OLMOE_COMBINED_DECODE_BOUNDARIES",
                "status": "COMPLETE",
                "model": {"bytes": MODEL_BYTES, "sha256": MODEL_SHA256, "architecture": "olmoe"},
                "baseline": {
                    "full_helper_wall_values_ns": BASELINE_VALUES_NS,
                    "full_helper_wall_median_ns": BASELINE_MEDIAN_NS,
                    "floor_ppm": FLOOR_PPM, "minimum_gain_ns": MINIMUM_GAIN_NS,
                    "candidate_ceiling_ns": CANDIDATE_CEILING_NS,
                },
                "candidate": {
                    "provider": "align-runtime", "align_llm_head": align_llm_head,
                    "align_revision": align_revision, "compiler_sha256": built["compiler_sha256"],
                    "helper_sha256": built["helper_sha256"], "shim_sha256": built["shim_sha256"],
                    "ggml_libraries": ggml_libraries, "ggml_headers": ggml_headers,
                    "pack_sha256": pack_sha256, "geometry_sha256": geometry_sha256,
                    "cache_budget_bytes": BUDGET,
                },
                "intervention": {
                    "phase_a_width": "N_PAST_PLUS_ONE",
                    "phase_a_pad_rows_skipped_per_layer": 2,
                    "plane_source": "HOST_VISIBLE_CONCAT_SLOT",
                    "plane_compare": "EXACT_BYTES",
                    "plane_v_fast_path": "UNALIGNED_SAFE_AARCH64_4X4",
                    "expert_source": "FIXED_STRIDE_CACHE",
                    "direct_scope": "PROVIDER_GENERATION",
                    "fallback": "COMPACT_CLAIM",
                    "cache_key_bytes": CACHE_KEY_BYTES,
                    "cache_slot_count": CACHE_SLOT_COUNT,
                    "cache_capacity_bytes": CACHE_CAPACITY_BYTES,
                    "full_cache_bytes_fetched": FULL_CACHE_BYTES_FETCHED,
                    "full_cache_to_claim_copy_ns": 0,
                },
                "task": {
                    "task_id": task_document["id"], "task_sha256": task_sha256,
                    "prompt_sha256": prompt_sha256, "maximum_tokens": FULL_TOKENS,
                    "temperature_micros": TEMPERATURE_MICROS, "seed": SEED,
                    "full_output_sha256": FULL_OUTPUT_SHA256,
                },
                "environment": {
                    **host_environment, "c_compiler_sha256": built["c_compiler_sha256"],
                    "c_compiler_version_sha256": built["c_compiler_version_sha256"],
                    "linker_search_sha256": linker_search_sha256,
                },
                "samples": samples,
                "aggregate": aggregate(samples),
            }
    result = complete_result_after_cleanup(result, started_ns)
    aggregate_result = result["aggregate"]
    print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))
    print(
        "R8-OLMOE-COMBINED-DECODE-BOUNDARIES: COMPLETE "
        f"decision={aggregate_result['decision']} "
        f"median={aggregate_result['candidate_full_helper_wall_median_ns'] / 1e9:.3f}s "
        f"phase_a={aggregate_result['phase_a_median_ns'] / 1e9:.3f}s "
        f"plane={aggregate_result['plane_roundtrip_median_ns'] / 1e9:.3f}s "
        f"gain_ppm={aggregate_result['gain_ppm']} "
        f"elapsed={result['elapsed_ns'] / 1e9:.2f}s",
        file=sys.stderr,
    )
    return 0


def interrupted(signal_number: int, _frame: object) -> None:
    owner.stop_owned_processes()
    raise SystemExit(128 + signal_number)


if __name__ == "__main__":
    signal.signal(signal.SIGINT, interrupted)
    signal.signal(signal.SIGTERM, interrupted)
    try:
        raise SystemExit(main())
    except Exception as error:
        owner.stop_owned_processes()
        print(f"R8-OLMOE-COMBINED-DECODE-BOUNDARIES: FAIL {error}", file=sys.stderr)
        raise SystemExit(1)
