#!/usr/bin/env bash

set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
compiler="${ALIGNC:-${project_root}/scripts/alignc}"
output_file="$(mktemp)"
trap 'rm -f "${output_file}"' EXIT

"${compiler}" run "${project_root}/src/prompt_render_smoke.align" >"${output_file}"

python3 - "${output_file}" <<'PY'
import sys
from pathlib import Path

actual = Path(sys.argv[1]).read_text(encoding="utf-8")
expected = """prompt renderer:
status:
PASS
text:
BASE

--- repo prompt ---
REPO

--- task prompt ---
TASK

--- learned prompt append ---
LEARNED

--- patch evaluation context ---
PATCH

--- failure memory context ---
(omitted)

--- current failure diagnostics ---
stdout:
STDOUT
stderr:
STDERR
"""
if actual != expected:
    raise SystemExit(f"prompt renderer output mismatch:\nexpected={expected!r}\nactual={actual!r}")
print("prompt renderer smoke: hierarchy and explicit context policy PASS")
PY
