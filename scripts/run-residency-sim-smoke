error_case("ir-unreadable", basic_list, missing, basic_budget, "R3_IR_UNREADABLE")
not_json = work_dir / "not-json.json"
not_json.write_text("{not json", encoding="utf-8")
error_case("ir-decode", basic_list, not_json, basic_budget, "R3_IR_DECODE")
error_case("ir-schema-kind", basic_list,
           edited_ir("ir-kind", lambda d: d.update(kind="R2_ACTIVATION_TRACE")),
           basic_budget, "R3_IR_SCHEMA")
