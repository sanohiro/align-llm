    edited_trace("t-old-schema", lambda d: d.update(schema_version=1))]), uniform_ir,
    basic_budget, "R3_TRACE_SCHEMA", detail="1")
error_case("trace-status", trace_list("trace-status", [
    edited_trace("t-status", lambda d: d.update(status="error"))]), uniform_ir, basic_budget,
