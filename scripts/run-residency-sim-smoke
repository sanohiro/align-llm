#!/usr/bin/env bash
set -euo pipefail

# R3-RESIDENCY-SIM narrow durable owner (`docs/specs/r3-residency-sim.md` section 4.2). It needs no
# model, no network, no instrument, and no GPU: `scripts/gguf_fixture.py` writes synthetic olmoe
# containers, `main --model-ir` derives their `R1_MODEL_IR`, `scripts/eval_callback_fixture.py`
# writes synthetic MoE transcripts with generator-known expert ids, `main --expert-trace` converts
# them, and every count of the resulting `R3_RESIDENCY_SIM` document is compared against
# `scripts/residency_oracle.py` — an independent Python implementation of section 2.4 written from
# the plan and never from `src/residency_sim.align`. Every fixture is removed by the EXIT trap.
# That is why it joins HOSTED_CHECK_TARGETS.
#
# No tolerance is used anywhere, because every value in the document is an integer.

unset GIT_DIR GIT_COMMON_DIR GIT_WORK_TREE
export PYTHONDONTWRITEBYTECODE=1

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
temp_dir=$(mktemp -d)
fixture_dir="$temp_dir/fixtures"
work_dir="$temp_dir/work"

cleanup() {
  rm -rf "$temp_dir"
}
trap cleanup EXIT

if [ ! -x "$root_dir/main" ]; then
  printf '%s\n' "residency sim smoke: the product executable is missing; run 'make build'" >&2
  exit 1
fi

mkdir -p "$work_dir"
python3 "$root_dir/scripts/gguf_fixture.py" "$fixture_dir"

python3 - "$root_dir/main" "$fixture_dir" "$work_dir" "$root_dir" <<'PY'
import hashlib
import json
import os
import subprocess
import sys
from pathlib import Path

binary, fixture_dir, work_dir, root_dir = (
    sys.argv[1], Path(sys.argv[2]), Path(sys.argv[3]), Path(sys.argv[4]))
sys.path.insert(0, str(Path(root_dir) / "scripts"))
import eval_callback_fixture as fixture          # noqa: E402
import residency_oracle as oracle                # noqa: E402
import residency_projection as projection        # noqa: E402

failures = []


def fail(message):
    failures.append(message)
    sys.stderr.write("residency sim smoke: %s\n" % message)


def report_difference(name, actual, expected, path):
    if type(actual) is not type(expected):
        fail("%s: %s has type %s, the oracle says %s"
             % (name, path, type(actual).__name__, type(expected).__name__))
    elif isinstance(actual, dict):
        for key in sorted(set(actual) | set(expected)):
            if key not in actual or key not in expected:
                fail("%s: %s/%s is present on one side only" % (name, path, key))
            elif actual[key] != expected[key]:
                report_difference(name, actual[key], expected[key], "%s/%s" % (path, key))
    elif isinstance(actual, list):
        if len(actual) != len(expected):
            fail("%s: %s has %d entries, the oracle says %d"
                 % (name, path, len(actual), len(expected)))
        else:
            for index, (left, right) in enumerate(zip(actual, expected)):
                if left != right:
                    report_difference(name, left, right, "%s[%d]" % (path, index))
    else:
        fail("%s: %s is %r, the oracle says %r" % (name, path, actual, expected))


def run(args, expect_exit=None):
    completed = subprocess.run([binary] + args, capture_output=True, text=True)
    if expect_exit is not None and completed.returncode != expect_exit:
        fail("%r exited %d, expected %d (stderr %r)"
             % (args, completed.returncode, expect_exit, completed.stderr[:200]))
    return completed


# -------------------------------------------------------------------------------------------
# The synthetic Model IRs, derived by the already-verified `--model-ir` arm rather than
# hand-authored, so the fixture graph cannot drift from R1C's renderer (section 4.1).

def derive_ir(name):
    out = work_dir / ("%s-ir.json" % name)
    completed = run(["--model-ir", str(fixture_dir / ("%s.gguf" % name)), str(out)], expect_exit=0)
    document = json.loads(out.read_text())
    if document["status"] != "ok":
        fail("%s model ir: %s" % (name, document["error_code"]))
    return out, document


uniform_ir, uniform_doc = derive_ir("olmoe-full")
mixed_ir, mixed_doc = derive_ir("olmoe-mixed-quant")

UNIFORM = (uniform_doc["model"]["n_layer"], uniform_doc["model"]["n_expert"],
           uniform_doc["model"]["n_expert_used"])
MIXED = (mixed_doc["model"]["n_layer"], mixed_doc["model"]["n_expert"],
         mixed_doc["model"]["n_expert_used"])
if UNIFORM != (2, 8, 3):
    fail("olmoe-full hyperparameters moved: %r" % (UNIFORM,))
if MIXED != (2, 2, 2):
    fail("olmoe-mixed-quant hyperparameters moved: %r" % (MIXED,))


def expert_bytes(document):
    return [b["byte_size"] for b in document["blocks"] if b["kind"] == "ExpertBlock"]


if len(set(expert_bytes(uniform_doc))) != 1:
    fail("olmoe-full no longer has uniform expert bytes")
if len(set(expert_bytes(mixed_doc))) != 2:
    fail("olmoe-mixed-quant no longer has two distinct expert byte sizes")


# -------------------------------------------------------------------------------------------
# The synthetic traces. Every selection is a pure function of the router seed, so the corpus is
# known before the simulator has read a byte.

made = {}


def make_trace(name, graphs):
    if name in made:
        return made[name]
    transcript = work_dir / ("%s.log" % name)
    transcript.write_text(fixture.render(graphs), encoding="utf-8")
    document = work_dir / ("%s.json" % name)
    run(["--expert-trace", str(transcript), str(document)], expect_exit=0)
    parsed = json.loads(document.read_text())
    if parsed["status"] != "ok":
        fail("trace %s: %s %s" % (name, parsed["error_code"], parsed["error_detail"]))
    transcript.unlink()
    made[name] = document
    return document


def moe(seed, n_layer, n_tokens, shape, ordinal=0):
    _, n_expert, used = shape
    return fixture.moe_graph(n_layer, n_tokens, fixture.Router(seed, n_expert, used), ordinal)


class ScriptedRouter:
    """A router whose selection at `(graph, layer, token)` is a table lookup rather than a seeded
    draw, so a case can engineer the exact demand stream a contract row needs — the cyclic-reference
    stream of section 4.5 finding 1, for instance. It presents `fixture.Router`'s interface."""

    def __init__(self, n_expert, n_expert_used, choose, weight=None):
        self.n_expert = n_expert
        self.n_expert_used = n_expert_used
        self.choose = choose
        self.weight = weight

    def experts(self, graph, layer, token):
        chosen = list(self.choose(graph, layer, token))
        if len(chosen) != self.n_expert_used or len(set(chosen)) != len(chosen):
            raise AssertionError("a scripted router must name %d distinct experts, got %r"
                                 % (self.n_expert_used, chosen))
        return chosen

    def weight_ten_thousandths(self, graph, layer, token, slot):
        if self.weight is not None:
            return self.weight(graph, layer, token, slot)
        expert = self.experts(graph, layer, token)[slot]
        return 1000 + ((graph * 211 + layer * 307 + token * 401 + slot * 503
                        + expert * 601) % 8001)


def scripted(n_layer, n_tokens, shape, choose, ordinal=0, weight=None):
    _, n_expert, used = shape
    return fixture.moe_graph(
        n_layer, n_tokens, ScriptedRouter(n_expert, used, choose, weight), ordinal,
    )


def by_policy(document, order, budget):
    """The policy rows of one (order, budget) cell, keyed by policy name."""
    entries = document["orders"][0 if order == "token_major" else 1]["policies"]
    return {entry["policy"]: entry for entry in entries if entry["budget_bytes"] == budget}


def trace_list(name, documents):
    path = work_dir / ("%s.txt" % name)
    path.write_text("".join("%s\n" % document for document in documents), encoding="utf-8")
    return path


def normalized(document):
    """The golden form. Three values are host-dependent and none of them is a contract: the two path
    operands, and `inputs.bytes_read` — an `R2_ACTIVATION_TRACE` records its own transcript `path`,
    so every trace document's length grows with the scratch directory's name (section 6,
    correction 9 measured exactly this between the probe and the qualification). The 1,440-entry
    per-layer breakdown is pinned by digest rather than checked in whole. Every other integer,
    `bytes_read` included, is still compared against the oracle on every case, which is where that
    accounting is actually owned."""
    copy = json.loads(json.dumps(document))
    copy["trace_list_path"] = "TRACE_LIST"
    copy["model_ir_path"] = "MODEL_IR"
    copy["inputs"]["bytes_read"] = "PATH_DEPENDENT"
    for order in copy["orders"]:
        payload = json.dumps(order["per_layer"], separators=(",", ":")).encode("utf-8")
        order["per_layer"] = {"entry_count": len(order["per_layer"]),
                              "sha256": hashlib.sha256(payload).hexdigest()}
    return copy


def check_case(name, listing, ir_path, budget, asserts=None, expect_exit=0):
    """Both CLI forms, byte-identical documents, and every integer against the oracle."""
    printed = run(["--simulate-residency", str(listing), str(ir_path), str(budget)],
                  expect_exit=expect_exit)
    destination = work_dir / ("%s-out.json" % name)
    written = run(["--simulate-residency", str(listing), str(ir_path), str(budget),
                   str(destination)], expect_exit=expect_exit)
    on_disk = destination.read_text()
    if printed.stdout != on_disk + "\n":
        fail("%s: the two forms produced different documents" % name)
    if not written.stdout.startswith("residency sim:\n"):
        fail("%s: the four-operand form did not print the summary block" % name)
    document = json.loads(on_disk)
    # Every caller of a successful case indexes `stream`, `verdict`, and `orders` out of the result.
    # An error document carries none of them, so continuing would replace this case's diagnostic
    # with a `KeyError` traceback from whichever line happened to read a missing key first.
    if expect_exit == 0 and document.get("status") != "ok":
        fail("%s: the run exited 0 with %s %s rather than an ok document"
             % (name, document.get("error_code"), document.get("error_detail")))
        raise SystemExit(1)
    expected = oracle.simulate(str(listing), str(ir_path), str(budget))
    if document != expected:
        report_difference(name, document, expected, "")
        fail("%s: the document disagrees with the oracle" % name)
    for path, value in (asserts or {}).items():
        cursor = document
        for step in path.split("/"):
            cursor = cursor[int(step)] if step.lstrip("-").isdigit() else cursor[step]
        if cursor != value:
            fail("%s: %s is %r, expected %r" % (name, path, cursor, value))
    return document


def sweep_points(document):
    total = document["model"]["total_expert_bytes"]
    largest = document["model"]["largest_expert_bytes"]
    return [max(largest, total >> (7 - i)) for i in range(8)]



uniform_expert_total = sum(expert_bytes(uniform_doc))
uniform_largest = max(expert_bytes(uniform_doc))
mixed_expert_total = sum(expert_bytes(mixed_doc))
mixed_largest = max(expert_bytes(mixed_doc))

# ---- sim-basic: four documents, every policy at every sweep budget against the oracle ------
basic = [make_trace("basic-%d" % i, [moe(11 + i, 2, 4, UNIFORM)]) for i in range(4)]
basic_list = trace_list("sim-basic", basic)
basic_budget = uniform_expert_total >> 2
document = check_case("sim-basic", basic_list, uniform_ir, basic_budget, asserts={
    "status": "ok",
    "kind": "R3_RESIDENCY_SIM",
    "schema_version": 2,
    "inputs/listed_trace_count": 4,
    "inputs/admitted_trace_count": 4,
    "stream/pooling": "continuing",
    "stream/omitted_truncated_graphs": 0,
    "stream/token_position_count": 16,
    "stream/demand_count": 16 * 2 * 3,
    "stream/graph_phases/prefill": 4,
    "model/uniform_expert_bytes": True,
    "orders/0/order": "token_major",
    "orders/0/verdict_bearing": True,
    "orders/1/order": "layer_major",
    "orders/1/verdict_bearing": False,
    "verdict/rule_version": 2,
    "verdict/order": "token_major",
    "verdict/baseline_policy": "lru",
    "verdict/margin_per_mille": 50,
    "verdict/jackknife_folds": 4,
})
for order in document["orders"]:
    names = [entry["policy"] for entry in order["policies"]]
    # The name *set* over the whole order, not the first eleven rows: slicing one budget's rows off
    # the list can only ever see that budget's block, so it asserts nothing about
    # the policy set the document actually reports.
    if sorted(set(names)) != sorted(oracle.POLICY_NAMES):
        fail("sim-basic/%s: the policy set is not the eleven rows of R8, it is %r"
             % (order["order"], sorted(set(names))))
    if len(names) != len(oracle.POLICY_NAMES) * len(document["budgets"]):
        fail("sim-basic/%s: %d policy rows for %d budget(s) and %d policies"
             % (order["order"], len(names), len(document["budgets"]), len(oracle.POLICY_NAMES)))
    for start in range(0, len(names), len(oracle.POLICY_NAMES)):
        if names[start:start + len(oracle.POLICY_NAMES)] != oracle.POLICY_NAMES:
            fail("sim-basic/%s: the rows at %d are not in section 2.4 order"
                 % (order["order"], start))
if document["stream"]["slot_coverage_per_mille"] != 1000:
    fail("sim-basic: a synthetic transcript prints every slot, so coverage must be 1000 per mille")

# `null` is the floor and `compulsory` the lower bound no policy at any budget can beat.
for order in document["orders"]:
    by_budget = {}
    for entry in order["policies"]:
        by_budget.setdefault(entry["budget_bytes"], {})[entry["policy"]] = entry
    for budget, row in by_budget.items():
        if row["null"]["bytes_fetched"] != document["stream"]["demanded_byte_total"]:
            fail("sim-basic: null must fetch the whole demanded byte volume")
        if row["null"]["hits"] != 0:
            fail("sim-basic: null must never hit")
        for policy, entry in row.items():
            if entry["bytes_fetched"] < row["compulsory"]["bytes_fetched"]:
                fail("sim-basic: %s beat the compulsory bound at %d" % (policy, budget))
            if entry["hits"] + entry["misses"] != document["stream"]["demand_count"]:
                fail("sim-basic: %s replayed a different demand count" % policy)
        if row["belady"]["bytes_fetched"] > row["lru"]["bytes_fetched"]:
            fail("sim-basic: belady is not optimal at %d" % budget)

# ---- sim-single-trace: pooling of one is not a special case --------------------------------
check_case("sim-single-trace", trace_list("sim-single", basic[:1]), uniform_ir, basic_budget,
           asserts={"inputs/admitted_trace_count": 1, "verdict/jackknife_folds": 1})

# ---- sim-truncated: one graph with n_tokens = 9 is excluded and counted ---------------------
truncated = make_trace("truncated", [moe(21, 2, 9, UNIFORM, 0), moe(22, 2, 4, UNIFORM, 1)])
check_case("sim-truncated", trace_list("sim-truncated", [truncated]), uniform_ir, basic_budget,
           asserts={"stream/omitted_truncated_graphs": 1,
                    "stream/token_position_count": 4,
                    "stream/graph_phases/prefill": 1})

# ---- sim-multi-graph: two admitted graphs pool into one continuing stream -------------------
multi = make_trace("multi", [moe(31, 2, 3, UNIFORM, 0), moe(32, 2, 5, UNIFORM, 1)])
check_case("sim-multi-graph", trace_list("sim-multi", [multi]), uniform_ir, basic_budget,
           asserts={"stream/omitted_truncated_graphs": 0,
                    "stream/token_position_count": 8,
                    "stream/graph_phases/prefill": 2})

# ---- sim-full-axis-decode: a prefill graph followed by real one-token decode graphs ----------
# Every other case in this file replays prefill graphs only, because that is all build 10566 could
# produce (section 5.2). R2c's patched instrument evaluates one graph per decode step, so a trace
# is now `[prefill, decode, decode, ...]` and `scripts/run-decode-residency-gate` replays it in four
# arms: the mixed list as captured, a decode-only list with graph 0 projected away and every
# remaining ordinal left as captured, a prefill-only control, and a head-4 length control. Every arm
# is exercised here against the oracle, with no model and no instrument.
#
# Keeping the ordinals is the point of the projection: `docs/specs/r2a-expert-trace.md` section
# 2.5.6 classifies a one-token graph at ordinal 0 as `single_token_first_graph`, so renumbering
# would turn the first decode step into a phase it is not, and `graph_phases` would stop being able
# to state what was replayed.
# The four counts are deliberately unequal — 32, 20, 16, and 12 token positions. Where two arms
# carried the same number of positions, the assertions below that the four arms are four different
# measurements could be satisfied by a projection that selected the wrong graphs but the right
# count. Three prompt tokens and five decode steps separate all four, and `DECODE_STEPS` must stay
# above `DECODE_HEAD_STEPS` or the head-4 arm would be the decode-only arm under another name.
DECODE_STEPS = 5
PREFILL_TOKENS = 3
if DECODE_STEPS <= projection.DECODE_HEAD_STEPS:
    fail("sim-full-axis-decode: %d decode step(s) cannot exercise a head of %d, so the head-4 arm "
         "would be the decode-only arm" % (DECODE_STEPS, projection.DECODE_HEAD_STEPS))


def full_axis_choose(offset):
    """A scripted router over the real sequence position, not the token index.

    A decode graph carries one token, so `token` is always 0 there and the position that matters is
    the graph ordinal. Layer 0 drifts one expert at a time, which is the conditional locality R2D
    measured; layer 1 rotates faster, so the two layers do not agree and a frequency policy and a
    recency policy see different streams.
    """
    def choose(graph, layer, token):
        position = token if graph == 0 else PREFILL_TOKENS + graph - 1
        if layer == 0:
            base = (position // 2 + offset) % 8
            return ((base + 0) % 8, (base + 1) % 8, (base + 2) % 8)
        base = (position * 3 + offset) % 8
        return ((base + 0) % 8, (base + 3) % 8, (base + 5) % 8)
    return choose


def full_axis_graphs(offset):
    graphs = [scripted(2, PREFILL_TOKENS, UNIFORM, full_axis_choose(offset), 0)]
    for step in range(1, DECODE_STEPS + 1):
        graphs.append(scripted(2, 1, UNIFORM, full_axis_choose(offset), step))
    return graphs


def projected(arm, name, source):
    """One captured document through `scripts/residency_projection.py`'s named arm.

    The projection is **imported, not re-implemented**: `scripts/run-decode-residency-gate` writes
    its arms with this exact function, so a defect in it is a defect the oracle below sees. A second
    copy here would let the runner's arms drift from the arms the hosted owner proves correct, which
    is the one thing this case exists to prevent.

    The result must be a legal schema-2 input: the removed graphs become undeclared and no retained
    selection names them, so nothing fails closed.
    """
    payload = projection.PROJECTIONS[arm](json.loads(Path(source).read_text()))
    path = work_dir / ("%s.json" % name)
    path.write_text(json.dumps(payload), encoding="utf-8")
    return path


mixed_docs = [make_trace("full-axis-%d" % offset, full_axis_graphs(offset)) for offset in range(4)]
mixed_positions = 4 * (PREFILL_TOKENS + DECODE_STEPS)
full_axis_budget = uniform_expert_total >> 2
mixed_case = check_case("sim-full-axis-decode", trace_list("sim-full-axis", mixed_docs),
                        uniform_ir, full_axis_budget, asserts={
                            "inputs/admitted_trace_count": 4,
                            "stream/omitted_truncated_graphs": 0,
                            "stream/token_position_count": mixed_positions,
                            "stream/demand_count": mixed_positions * 2 * 3,
                            "stream/graph_phases/prefill": 4,
                            "stream/graph_phases/decode": 4 * DECODE_STEPS,
                            "stream/graph_phases/single_token_first_graph": 0,
                            "verdict/jackknife_folds": 4,
                        })
if mixed_case["stream"]["slot_coverage_per_mille"] != 1000:
    fail("sim-full-axis-decode: the capture must print every router slot")

decode_docs = [projected("decode_only", "full-axis-decode-only-%d" % index, path)
               for index, path in enumerate(mixed_docs)]
decode_positions = 4 * DECODE_STEPS
decode_list = trace_list("sim-full-axis-decode", decode_docs)
decode_case = check_case("sim-full-axis-decode-only", decode_list, uniform_ir,
                         full_axis_budget, asserts={
                             "inputs/admitted_trace_count": 4,
                             "stream/omitted_truncated_graphs": 0,
                             "stream/token_position_count": decode_positions,
                             "stream/demand_count": decode_positions * 2 * 3,
                             "stream/graph_phases/prefill": 0,
                             "stream/graph_phases/decode": 4 * DECODE_STEPS,
                             "stream/graph_phases/single_token_first_graph": 0,
                             "verdict/jackknife_folds": 4,
                         })

# ---- sim-full-axis-prefill-only: the runner's coverage control arm --------------------------
# `scripts/run-decode-residency-gate`'s third arm removes the decode graphs instead of the prefill
# graph, so that a verdict shared by all three arms cannot be attributed to decode. It is the arm
# that separates "the router axis went from six printed slots to eight" from "real decode graphs
# appeared", and it is exercised here for the same reason as the other two: it is a projection the
# runner replays, so the oracle must agree with it.
prefill_docs = [projected("prefill_only", "full-axis-prefill-only-%d" % index, path)
                for index, path in enumerate(mixed_docs)]
prefill_positions = 4 * PREFILL_TOKENS
prefill_case = check_case("sim-full-axis-prefill-only",
                          trace_list("sim-full-axis-prefill", prefill_docs), uniform_ir,
                          full_axis_budget, asserts={
                              "inputs/admitted_trace_count": 4,
                              "stream/omitted_truncated_graphs": 0,
                              "stream/token_position_count": prefill_positions,
                              "stream/demand_count": prefill_positions * 2 * 3,
                              "stream/graph_phases/prefill": 4,
                              "stream/graph_phases/decode": 0,
                              "stream/graph_phases/single_token_first_graph": 0,
                              "verdict/jackknife_folds": 4,
                          })

# ---- sim-full-axis-decode-head4: the runner's stream-length control arm ----------------------
# The prefill-only arm removes the coverage confound but not the length one: the decode-only arm is
# five times its length on this fixture and 3.6x on the real corpus, so a verdict that differs
# between them could belong to decode's phase or to the stream decode adds. The head-4 arm keeps
# decode ordinals 1..`DECODE_HEAD_STEPS` and nothing else — same phase, same axes, prefill-only's
# order of length — and it is the fourth projection the runner replays, so the oracle checks it for
# the same reason as the other three.
head4_docs = [projected("decode_head4", "full-axis-head4-%d" % index, path)
              for index, path in enumerate(mixed_docs)]
head4_positions = 4 * projection.DECODE_HEAD_STEPS
head4_case = check_case("sim-full-axis-decode-head4",
                        trace_list("sim-full-axis-head4", head4_docs), uniform_ir,
                        full_axis_budget, asserts={
                            "inputs/admitted_trace_count": 4,
                            "stream/omitted_truncated_graphs": 0,
                            "stream/token_position_count": head4_positions,
                            "stream/demand_count": head4_positions * 2 * 3,
                            "stream/graph_phases/prefill": 0,
                            "stream/graph_phases/decode": 4 * projection.DECODE_HEAD_STEPS,
                            "stream/graph_phases/single_token_first_graph": 0,
                            "verdict/jackknife_folds": 4,
                        })
# The arm is only a *length* control if it is the decode-only stream truncated rather than a
# different selection of graphs. A projection that kept ordinals 1..5, or 0..4, would still produce
# a well-formed document; these two assertions are what separate it from that.
if head4_case["stream"]["demand_count"] >= decode_case["stream"]["demand_count"]:
    fail("sim-full-axis-decode-head4: the head-4 arm did not truncate the decode stream (%d "
         "demand(s) against decode-only's %d)"
         % (head4_case["stream"]["demand_count"], decode_case["stream"]["demand_count"]))
head4_kept = {row["ordinal"] for row in json.loads(Path(head4_docs[0]).read_text())["graphs"]}
if head4_kept != set(range(1, projection.DECODE_HEAD_STEPS + 1)):
    fail("sim-full-axis-decode-head4: the arm kept graph ordinals %r, expected 1..%d"
         % (sorted(head4_kept), projection.DECODE_HEAD_STEPS))

# ---- sim-renumbered-decode-only: why the projection keeps the ordinals -----------------------
# Both runners' comments and `docs/specs/r3-residency-sim.md` section 8.1 rest on one claim: a
# decode-only list whose ordinals were renumbered would report the first decode step as
# `single_token_first_graph`, and `graph_phases` would stop being able to state what was replayed.
# Every assertion above pins `single_token_first_graph: 0`, which a phase classifier that never
# produces that label would satisfy vacuously. This case builds the renumbered list the projection
# deliberately does *not* build and requires the label to appear, so the three arms' zeros are
# assertions rather than a property of an unreachable branch.
def renumbered(name, source):
    payload = json.loads(Path(source).read_text())
    order = {row["ordinal"]: index for index, row in enumerate(payload["graphs"])}
    for row in payload["graphs"]:
        row["ordinal"] = order[row["ordinal"]]
    for row in payload["selections"]:
        row["graph"] = order[row["graph"]]
    path = work_dir / ("%s.json" % name)
    path.write_text(json.dumps(payload), encoding="utf-8")
    return path


renumbered_docs = [renumbered("full-axis-renumbered-%d" % index, path)
                   for index, path in enumerate(decode_docs)]
renumbered_case = check_case("sim-renumbered-decode-only",
                             trace_list("sim-full-axis-renumbered", renumbered_docs), uniform_ir,
                             full_axis_budget, asserts={
                                 "stream/graph_phases/prefill": 0,
                                 "stream/graph_phases/decode": 4 * (DECODE_STEPS - 1),
                                 "stream/graph_phases/single_token_first_graph": 4,
                                 "stream/demand_count": decode_positions * 2 * 3,
                             })
# The demands are identical and only the phase census moved, which is exactly what renumbering would
# have destroyed silently: the arm would still report a well-formed document with the same bytes.
if renumbered_case["stream"]["demand_count"] != decode_case["stream"]["demand_count"]:
    fail("sim-renumbered-decode-only: renumbering changed the demand count, so this case is not "
         "isolating the phase census")

# Each projection must be a *different measurement*, not a relabelling of the same one. If an arm
# produced the mixed arm's stream it would be answering nothing, and if the two projections did not
# partition the capture one of them dropped or duplicated a selection.
for name, case in (("decode-only", decode_case), ("prefill-only", prefill_case),
                   ("head-4", head4_case)):
    if case["stream"]["demand_count"] >= mixed_case["stream"]["demand_count"]:
        fail("sim-full-axis-decode: the %s projection did not drop any graph" % name)
if (decode_case["stream"]["demand_count"] + prefill_case["stream"]["demand_count"]
        != mixed_case["stream"]["demand_count"]):
    fail("sim-full-axis-decode: the two complementary projections do not partition the capture "
         "(%d + %d != %d)"
         % (decode_case["stream"]["demand_count"], prefill_case["stream"]["demand_count"],
            mixed_case["stream"]["demand_count"]))
for order in ("token_major", "layer_major"):
    totals = {name: by_policy(case, order, full_axis_budget)["lru"]["bytes_fetched"]
              for name, case in (("mixed", mixed_case), ("decode-only", decode_case),
                                 ("prefill-only", prefill_case), ("head-4", head4_case))}
    if len(set(totals.values())) != 4:
        fail("sim-full-axis-decode: %s baseline bytes %r do not separate the four arms, so the "
             "case cannot tell them apart" % (order, totals))

# The graph ordinal is part of the replay order, not decoration: within one document the demands of
# graph `g` all precede those of graph `g + 1`, and the token ordinals the document reports must be
# strictly increasing along that order. A stream sorted without the graph term interleaves the
# decode graphs into the prefill graph's token positions and cannot produce this count.
for case, positions in ((mixed_case, mixed_positions), (decode_case, decode_positions),
                        (prefill_case, prefill_positions), (head4_case, head4_positions)):
    if case["stream"]["token_position_count"] != positions:
        fail("sim-full-axis-decode: %d token position(s) for %d expected"
             % (case["stream"]["token_position_count"], positions))
    if case["stream"]["one_token_working_set_keys"] != 2 * 3:
        fail("sim-full-axis-decode: one token demands %d key(s), the router names 6"
             % case["stream"]["one_token_working_set_keys"])

# The jackknife must be doing work on this fixture, or a `decide` that never resampled would agree
# with it and the case would not be able to see the difference. The prefill-only arm is deliberately
# not asserted here: whether one of its 96 demands clears the pooled floor is a property of the
# fixture's router table rather than of the simulator, and the two arms below already pin the
# resampling path.
for name, case in (("mixed", mixed_case), ("decode-only", decode_case)):
    verdict = case["verdict"]
    rows = by_policy(case, "token_major", full_axis_budget)
    cleared = [policy for policy in oracle.CANDIDATES
               if 1000 * rows[policy]["bytes_fetched"]
               <= (1000 - 50) * verdict["baseline_bytes_fetched"]]
    if not cleared:
        fail("sim-full-axis-decode/%s: no candidate clears the pooled effect floor, so the "
             "jackknife never runs and the arm asserts nothing about it" % name)
    elif verdict["jackknife_min_gain_per_mille"] == verdict["gain_per_mille"]:
        fail("sim-full-axis-decode/%s: the jackknife minimum equals the pooled gain (%d per "
             "mille), so a verdict that skipped resampling would report the same numbers"
             % (name, verdict["gain_per_mille"]))
    if verdict["result"] == "BEATS_BASELINE" and verdict["best_policy"] not in cleared:
        fail("sim-full-axis-decode/%s: BEATS_BASELINE named a policy that does not clear the "
             "pooled floor" % name)

# The normalized form is what a golden pins, and it includes the per-layer breakdown by digest. A
# second run of the identical inputs must reproduce it exactly on both arms; the checked-in golden
# belongs to `sim-basic`.
for name, listing, expected in (
        ("mixed", trace_list("sim-full-axis", mixed_docs), mixed_case),
        ("decode-only", trace_list("sim-full-axis-decode", decode_docs), decode_case),
        ("prefill-only", trace_list("sim-full-axis-prefill", prefill_docs), prefill_case),
        ("head-4", trace_list("sim-full-axis-head4", head4_docs), head4_case)):
    again = json.loads(run(["--simulate-residency", str(listing), str(uniform_ir),
                            str(full_axis_budget)], expect_exit=0).stdout)
    if normalized(again) != normalized(expected):
        fail("sim-full-axis-decode/%s: a repeated run changed the normalized document" % name)

# ---- full-axis-admission: the compact runner's refusal and the decode runner's mirror --------
# `scripts/run-residency-sim` admits only the historical compact print form and
# `scripts/run-decode-residency-gate` admits only R2c's full one. The two rules are the reason the
# two corpora can never be pooled under one capability name, so the refusals are pinned here on
# real documents rather than assumed from the R2 owner's synthetic dicts. `n_expert_used` is 8
# because the two forms only differ above the printer's six-slot threshold.
from expert_locality_gate import (GateError,                                   # noqa: E402
                                  require_compact_router_axes, require_full_router_axes)

WIDE = (2, 16, 8)


def wide_trace(name, full):
    transcript = work_dir / ("%s.log" % name)
    transcript.write_text(fixture.render(
        [fixture.moe_graph(2, 4, fixture.Router(61, WIDE[1], WIDE[2]), 0, full_topk=full)]),
        encoding="utf-8")
    document = work_dir / ("%s.json" % name)
    run(["--expert-trace", str(transcript), str(document)], expect_exit=0)
    transcript.unlink()
    parsed = json.loads(document.read_text())
    if parsed["status"] != "ok":
        fail("full-axis-admission: %s trace: %s %s"
             % (name, parsed["error_code"], parsed["error_detail"]))
    return parsed


compact_document = wide_trace("admission-compact", False)
full_document = wide_trace("admission-full", True)


def slot_sets(document):
    groups = {}
    for row in document["selections"]:
        groups.setdefault((row["graph"], row["layer"], row["token"]), set()).add(row["slot"])
    return {frozenset(slots) for slots in groups.values()}


if compact_document["moe"]["slots_truncated"] is not True:
    fail("full-axis-admission: the compact fixture does not report a truncated slot axis")
if slot_sets(compact_document) != {frozenset({0, 1, 2, 5, 6, 7})}:
    fail("full-axis-admission: the compact fixture is not the printer's three-plus-three form")
if full_document["moe"]["slots_truncated"] is not False:
    fail("full-axis-admission: the full-axis fixture reports a truncated slot axis")
if slot_sets(full_document) != {frozenset(range(8))}:
    fail("full-axis-admission: the full-axis fixture does not carry every router slot")


def admits(rule, document, label):
    try:
        rule([document], [label])
    except GateError as error:
        return str(error)
    return None


for rule, name, accepted, refused, marker in (
        (require_compact_router_axes, "compact", compact_document, full_document,
         "full-axis R2c input refused"),
        (require_full_router_axes, "full", full_document, compact_document,
         "compact R2A input refused")):
    reason = admits(rule, accepted, name)
    if reason is not None:
        fail("full-axis-admission: the %s rule refused its own corpus: %s" % (name, reason))
    reason = admits(rule, refused, name)
    if reason is None:
        fail("full-axis-admission: the %s rule admitted the other print form" % name)
    elif marker not in reason:
        fail("full-axis-admission: the %s rule refused with %r, expected %r"
             % (name, reason, marker))

# The runners are what those rules protect, and a runner that stopped calling one would still pass
# every assertion above. Both bindings are therefore pinned by name, exactly as
# `scripts/run-r2c-instrument-smoke` pins the historical one.
for relative, expected in (("scripts/run-residency-sim", "require_compact_router_axes"),
                           ("scripts/run-decode-residency-gate", "require_full_router_axes")):
    source = (Path(root_dir) / relative).read_text(encoding="utf-8")
    if expected not in source:
        fail("full-axis-admission: %s no longer calls %s" % (relative, expected))
    if relative == "scripts/run-residency-sim" and "require_full_router_axes" in source:
        fail("full-axis-admission: the historical runner gained the full-axis admission")
    if relative == "scripts/run-decode-residency-gate" \
            and "require_compact_router_axes" in source:
        fail("full-axis-admission: the decode runner gained the compact admission")

# ---- projection-binding: the runner replays the arms this file proved correct ----------------
# `sim-full-axis-decode-only` and `sim-full-axis-prefill-only` are evidence about
# `scripts/run-decode-residency-gate` only for as long as the runner uses the same implementation.
# A runner that reverted to a local `project_decode_only` would pass every assertion above while
# replaying an arm nothing here has checked, so the binding is pinned by name.
decode_runner = (Path(root_dir) / "scripts/run-decode-residency-gate").read_text(encoding="utf-8")
for expected in ("from residency_projection import", "PROJECTIONS[arm]"):
    if expected not in decode_runner:
        fail("projection-binding: scripts/run-decode-residency-gate no longer uses "
             "scripts/residency_projection.py (%r absent)" % expected)
if any(("def project_%s" % arm) in decode_runner for arm in projection.ARM_NAMES):
    fail("projection-binding: scripts/run-decode-residency-gate defines a projection of its own, "
         "so the arms this file checks are not the arms it replays")
for arm in projection.ARM_NAMES:
    if ('"%s"' % arm) not in decode_runner:
        fail("projection-binding: scripts/run-decode-residency-gate never names the %r arm" % arm)

# ---- capture-identity: the two decode runners must capture the same transcripts ---------------
# `docs/specs/r3-residency-sim.md` section 8.1 and `docs/specs/r2a-expert-trace.md` section 9 both
# claim the residency and locality measurements were taken over *the same capture*, "flag for flag".
# The capture is deliberately duplicated rather than factored into a shared helper — the two runners
# differ in N/A prefixes, per-prompt side work, and post-capture admission, and
# `scripts/run-decode-locality-gate` is a merged, measurement-bearing runner whose output identity a
# refactor would put at risk — so the claim is enforced here instead of asserted in prose. A flag
# added to one runner and not the other silently turns one claim into two measurements.
CAPTURE_PEERS = ("scripts/run-decode-locality-gate", "scripts/run-decode-residency-gate")


def block_after(source, opener, closer):
    """The lines strictly between the first line containing `opener` and the next `closer` line."""
    lines = source.splitlines()
    for index, line in enumerate(lines):
        if opener in line:
            for end in range(index + 1, len(lines)):
                if lines[end].strip() == closer:
                    return [entry.strip() for entry in lines[index + 1:end]]
            return None
    return None


def continued_lines(source, opener):
    """One backslash-continued shell command, starting at the line containing `opener`."""
    lines = source.splitlines()
    for index, line in enumerate(lines):
        if opener in line:
            collected = [line.strip()]
            while collected[-1].endswith("\\") and index + 1 < len(lines):
                index += 1
                collected.append(lines[index].strip())
            return collected
    return None


captures = {}
for relative in CAPTURE_PEERS:
    source = (Path(root_dir) / relative).read_text(encoding="utf-8")
    invocation = continued_lines(source, 'exec $instrument_timeout "$instrument"')
    identity = block_after(source, 'corpus_identity=$(python3 - "$prompts" "$prompt_count"', "PY")
    ulimit = [line.strip() for line in source.splitlines() if line.strip().startswith("ulimit -f")]
    if invocation is None:
        fail("capture-identity: %s has no instrument invocation to compare" % relative)
    if identity is None:
        fail("capture-identity: %s has no corpus-identity block to compare" % relative)
    if len(ulimit) != 1:
        fail("capture-identity: %s declares %d transcript size cap(s), expected 1"
             % (relative, len(ulimit)))
    captures[relative] = (invocation, identity, ulimit)

# A missing extraction has already been reported above; comparing it would replace that finding
# with a `TypeError` from the flag scan below, which reads the invocation as a list of lines.
if len(captures) == len(CAPTURE_PEERS) and all(
        part is not None for capture in captures.values() for part in capture):
    left, right = (captures[relative] for relative in CAPTURE_PEERS)
    for index, what in enumerate(("instrument invocation", "corpus identity", "transcript cap")):
        if left[index] != right[index]:
            fail("capture-identity: the %s differs between %s and %s:\n      %s\n      %s"
                 % (what, CAPTURE_PEERS[0], CAPTURE_PEERS[1], left[index], right[index]))
    # The comparison is only worth anything if it is looking at the real flags. If the extracted
    # invocation stopped containing them the two runners would agree vacuously.
    for flag in ("-n \"$decode_steps\"", "--temp 0", "--seed 42", "-fa off", "-ctk f32",
                 "-ctv f32", "-nr", "-c 512"):
        if not any(flag in line for line in left[0]):
            fail("capture-identity: the extracted invocation does not contain %r, so the "
                 "comparison is vacuous" % flag)

# ---- sim-mixed-bytes: the real model's per-layer mixed quantization -------------------------
mixed_traces = [make_trace("mixed-%d" % i, [moe(41 + i, 2, 5, MIXED)]) for i in range(3)]
mixed_document = check_case("sim-mixed-bytes", trace_list("sim-mixed", mixed_traces), mixed_ir,
                            mixed_expert_total >> 1,
                            asserts={"model/uniform_expert_bytes": False,
                                     "inputs/admitted_trace_count": 3})
if (mixed_document["model"]["smallest_expert_bytes"]
        == mixed_document["model"]["largest_expert_bytes"]):
    fail("sim-mixed-bytes: the mixed fixture reported a uniform byte table")

# ---- sim-no-headroom: a budget that holds the whole expert footprint ------------------------
check_case("sim-no-headroom", basic_list, uniform_ir, uniform_expert_total, asserts={
    "verdict/headroom_per_mille": 0,
    "verdict/result": "NO_HEADROOM",
    "verdict/best_policy": "",
})

# ---- sim-uniform-bytes: a uniform size table makes hit and byte orderings the same ordering --
uniform_block = expert_bytes(uniform_doc)[0]
uniform_case = check_case("sim-uniform-bytes", basic_list, uniform_ir, uniform_expert_total >> 3,
                          asserts={"model/uniform_expert_bytes": True,
                                   "model/smallest_expert_bytes": uniform_block,
                                   "model/largest_expert_bytes": uniform_block})
for order in ("token_major", "layer_major"):
    for entry in uniform_case["budgets"]:
        row = by_policy(uniform_case, order, entry["bytes"])
        # Every expert costs the same, so a non-prefetch policy's bytes are exactly its misses times
        # the block size, and more hits is the same statement as fewer bytes. A prefetch policy is
        # excluded because it fetches bytes without a demand miss, which is section 2.8's whole
        # reason for measuring bytes rather than hits.
        plain = [name for name in oracle.POLICY_NAMES if not name.startswith("topk")]
        for name in plain:
            if row[name]["bytes_fetched"] != row[name]["misses"] * uniform_block:
                fail("sim-uniform-bytes: %s/%s bytes are not misses times the block size"
                     % (order, name))
        for left in plain:
            for right in plain:
                same = ((row[left]["hits"] > row[right]["hits"])
                        != (row[left]["bytes_fetched"] < row[right]["bytes_fetched"]))
                if same:
                    fail("sim-uniform-bytes: %s/%s and %s disagree on hit and byte order at %d"
                         % (order, left, right, entry["bytes"]))

# ---- sim-cyclic: the LRU cliff at the one-token working set ---------------------------------
# Every token demands six keys — layer 0's experts 0, 1, 2 every time, and three of layer 1's five
# on a rotation — which is the cyclic-reference pathology of section 4.5 finding 1: a token touches
# every layer before returning to layer 0, so LRU evicts each expert exactly before it is needed
# again. Below the one-token working set LRU cannot hit at all; frequency, which sees that layer 0's
# three experts are demanded twice as often as layer 1's five, can.
def cyclic_experts(_graph, layer, token):
    if layer == 0:
        return (0, 1, 2)
    return tuple((token + i) % 5 + 3 for i in range(3))


cyclic = [make_trace("cyclic", [scripted(2, 6, UNIFORM, cyclic_experts)])]
cyclic_list = trace_list("sim-cyclic", cyclic)
cyclic_case = check_case("sim-cyclic", cyclic_list, uniform_ir, uniform_block * 6, asserts={
    "stream/one_token_working_set_keys": 6,
    "stream/one_token_working_set_bytes": uniform_block * 6,
    "stream/distinct_key_count": 8,
})
working_set = cyclic_case["stream"]["one_token_working_set_bytes"]
below = [e["bytes"] for e in cyclic_case["budgets"] if e["bytes"] < working_set]
at_or_above = [e["bytes"] for e in cyclic_case["budgets"] if e["bytes"] >= working_set]
if not below or not at_or_above:
    fail("sim-cyclic: the sweep does not straddle the one-token working set")
for budget in below:
    row = by_policy(cyclic_case, "token_major", budget)
    if row["lru"]["hits"] != 0:
        fail("sim-cyclic: lru hit %d time(s) at %d, below the one-token working set %d"
             % (row["lru"]["hits"], budget, working_set))
    if row["topk_prefetch_k8"]["bytes_fetched"] <= row["lru"]["bytes_fetched"]:
        fail("sim-cyclic: topk_prefetch_k8 must be charged for its own traffic at %d" % budget)
# The cliff is one-sided only for LRU: at the widest budget still under the working set, frequency
# and the offline optimum both clear it. At one or two blocks nothing can hit a six-key cycle, so
# the claim is made where it is a claim.
edge = by_policy(cyclic_case, "token_major", max(below))
if edge["lfu"]["hits"] <= 0 or edge["belady"]["hits"] <= edge["lfu"]["hits"]:
    fail("sim-cyclic: lfu must clear the LRU cliff at %d and belady must beat it" % max(below))
if by_policy(cyclic_case, "token_major", min(at_or_above))["lru"]["hits"] <= 0:
    fail("sim-cyclic: lru must hit once the budget reaches the one-token working set")

# ---- score-discriminates-lfu: router mass, not selection count, owns eviction ---------------
# Three equally frequent experts cycle through a two-block budget. Count LFU sees a perfect tie
# and misses every demand; weighted LFU preserves the two high-mass experts and hits them on the
# following tokens. The score must survive eviction for this separation to remain true.
def score_experts(_graph, _layer, _token):
    return (0, 1, 2)


def score_weights(_graph, _layer, _token, slot):
    return (100, 5000, 4900)[slot]


score_trace = make_trace(
    "score-discriminates-lfu",
    [scripted(1, 3, UNIFORM, score_experts, weight=score_weights)],
)
score_case = check_case(
    "score-discriminates-lfu",
    trace_list("score-discriminates-lfu", [score_trace]),
    uniform_ir,
    uniform_block * 2,
)
score_row = by_policy(score_case, "token_major", uniform_block * 2)
if score_row["lfu"]["hits"] != 0 or score_row["router_weight_lfu"]["hits"] != 2:
    fail("score-discriminates-lfu: expected lfu=0 and router_weight_lfu=2 hits, got %d and %d"
         % (score_row["lfu"]["hits"], score_row["router_weight_lfu"]["hits"]))
if score_row["router_weight_lfu"]["bytes_fetched"] >= score_row["lfu"]["bytes_fetched"]:
    fail("score-discriminates-lfu: weighted policy must fetch fewer bytes than count lfu")

# ---- sim-prefetch-useless: a prefetch that never pays for itself ----------------------------
# The same cyclic stream at the smallest legal budget. Every prefetched block is evicted by the
# demands of the token position it precedes, so no prefetch is ever hit, and both degrees fetch
# strictly more than the baseline. Section 2.4's "topk_prefetch charges its own traffic" and the
# `prefetch_fetches` / `prefetch_useful` accounting are what this row exercises.
useless = check_case("sim-prefetch-useless", cyclic_list, uniform_ir, uniform_block)
for budget in [entry["bytes"] for entry in useless["budgets"]
               if entry["bytes"] == uniform_block]:
    row = by_policy(useless, "token_major", budget)
    for policy in ("topk_prefetch_k1", "topk_prefetch_k8"):
        if row[policy]["prefetch_fetches"] <= 0:
            fail("sim-prefetch-useless: %s issued no prefetch at %d" % (policy, budget))
        if row[policy]["prefetch_useful"] != 0:
            fail("sim-prefetch-useless: %s reported %d useful prefetch(es) at %d"
                 % (policy, row[policy]["prefetch_useful"], budget))
        if row[policy]["bytes_fetched"] <= row["lru"]["bytes_fetched"]:
            fail("sim-prefetch-useless: %s must fetch more than lru at %d" % (policy, budget))

# ---- verdict-no-policy: headroom is left, and no candidate takes it -------------------------
# Three documents whose frequency structure leaves every candidate at or above the baseline's byte
# total while `belady` keeps a large headroom: the gate's "a better policy may exist and none of
# these is it".
unstable = [make_trace("jk-%d" % i, [moe(1 + i, 2, 4, UNIFORM)]) for i in range(5)]
no_policy = [make_trace("no-policy-%d" % i, [moe(3 + i, 2, 4, UNIFORM)]) for i in range(3)]
no_policy_case = check_case("verdict-no-policy",
                            trace_list("verdict-no-policy", no_policy),
                            uniform_ir, uniform_expert_total >> 1, asserts={
                                "verdict/result": "NO_POLICY_BEATS_BASELINE",
                                "verdict/best_policy": "",
                                "verdict/gain_per_mille": 0,
                                "verdict/jackknife_stable": False,
                                "verdict/jackknife_folds": 3,
                            })
if no_policy_case["verdict"]["headroom_per_mille"] < 50:
    fail("verdict-no-policy: NO_POLICY_BEATS_BASELINE requires headroom at or above the floor")

# ---- jackknife-unstable: a candidate clears the floor and one fold takes it back -------------
unstable_case = check_case("jackknife-unstable", trace_list("jackknife-unstable", unstable),
                           uniform_ir, uniform_expert_total >> 1, asserts={
                               "verdict/jackknife_stable": False,
                               "verdict/jackknife_folds": 5,
                           })
if unstable_case["verdict"]["result"] == "BEATS_BASELINE":
    fail("jackknife-unstable: an unstable win must not be reported as BEATS_BASELINE")
if unstable_case["verdict"]["jackknife_min_gain_per_mille"] >= 50:
    fail("jackknife-unstable: the fixture no longer has a fold below the effect floor")
unstable_row = by_policy(unstable_case, "token_major",
                         unstable_case["verdict"]["budget_bytes"])
cleared = [name for name in oracle.CANDIDATES
           if 1000 * unstable_row[name]["bytes_fetched"]
           <= (1000 - 50) * unstable_case["verdict"]["baseline_bytes_fetched"]]
if not cleared:
    fail("jackknife-unstable: no candidate clears the pooled effect floor, so the jackknife "
         "never runs and the case asserts nothing")

# ---- jackknife-second-candidate: the qualifying policy is not the lowest-byte one ------------
# The lowest-byte candidate clears the pooled effect floor and then loses a fold; a later, larger
# candidate clears every fold. `best_policy` must name the qualifying one, which is what section
# 2.8's BEATS_BASELINE row requires and what a lowest-byte-only answer gets wrong.
second = [make_trace("jk2-%d" % i, [moe(73 + i, 2, 4, UNIFORM)]) for i in range(4)]
second_case = check_case("jackknife-second-candidate",
                         trace_list("jackknife-second-candidate", second),
                         uniform_ir, uniform_expert_total >> 2, asserts={
                             "verdict/result": "BEATS_BASELINE",
                             "verdict/jackknife_stable": True,
                             "verdict/jackknife_folds": 4,
                         })
second_row = by_policy(second_case, "token_major", second_case["verdict"]["budget_bytes"])
second_baseline = second_case["verdict"]["baseline_bytes_fetched"]
lowest_name = min((name for name in oracle.CANDIDATES),
                  key=lambda name: (second_row[name]["bytes_fetched"],
                                    oracle.POLICY_NAMES.index(name)))
if second_case["verdict"]["best_policy"] == lowest_name:
    fail("jackknife-second-candidate: the fixture no longer separates the lowest-byte candidate "
         "from the qualifying one")
if 1000 * second_row[lowest_name]["bytes_fetched"] > (1000 - 50) * second_baseline:
    fail("jackknife-second-candidate: the lowest-byte candidate must clear the pooled effect floor")
if (second_row[second_case["verdict"]["best_policy"]]["bytes_fetched"]
        <= second_row[lowest_name]["bytes_fetched"]):
    fail("jackknife-second-candidate: the qualifying policy must fetch more than the lowest-byte "
         "one, or the case proves nothing")
if second_case["verdict"]["best_bytes_fetched"] != \
        second_row[second_case["verdict"]["best_policy"]]["bytes_fetched"]:
    fail("jackknife-second-candidate: best_bytes_fetched does not belong to best_policy")

# ---- budget-clamp: the low sweep points cannot hold the largest expert ----------------------
clamped = check_case("budget-clamp", basic_list, uniform_ir, uniform_largest)
if len(clamped["budgets"]) != 8:
    fail("budget-clamp: the operand coincides with a clamped sweep point, so eight entries")
if not clamped["budgets"][0]["clamped"]:
    fail("budget-clamp: the lowest sweep point must report clamped")
if clamped["budgets"][0]["bytes"] != uniform_largest:
    fail("budget-clamp: the clamp floor is largest_expert_bytes")
if [entry["bytes"] for entry in clamped["budgets"]] != sorted(
        entry["bytes"] for entry in clamped["budgets"]):
    fail("budget-clamp: the sweep is not ascending")
if sum(1 for entry in clamped["budgets"] if entry["requested"]) != 1:
    fail("budget-clamp: exactly one entry is the requested one")

# ---- budget-coincides / budget-inserted ----------------------------------------------------
coincides = check_case("budget-coincides", basic_list, uniform_ir, uniform_expert_total >> 1)
if len(coincides["budgets"]) != 8:
    fail("budget-coincides: an operand equal to a sweep point is not duplicated")
inserted_budget = (uniform_expert_total >> 1) + uniform_largest
inserted = check_case("budget-inserted", basic_list, uniform_ir, inserted_budget)
if len(inserted["budgets"]) != 9:
    fail("budget-inserted: an operand between two sweep points is a ninth entry")
if [entry["bytes"] for entry in inserted["budgets"]] != sorted(
        entry["bytes"] for entry in inserted["budgets"]):
    fail("budget-inserted: the ninth entry was not inserted in ascending position")

# ---- determinism: the same inputs produce a byte-identical document -------------------------
runs = {run(["--simulate-residency", str(basic_list), str(uniform_ir),
             str(basic_budget)], expect_exit=0).stdout for _ in range(3)}
if len(runs) != 1:
    fail("determinism: three runs produced different documents")

# ---- the golden: one checked-in document, normalized on its two path operands ---------------
golden_path = Path(root_dir) / "eval/fixtures/residency-sim/sim-basic.golden.json"
golden_actual = normalized(json.loads(next(iter(runs))))
if os.environ.get("ALIGN_LLM_RESIDENCY_SIM_UPDATE_GOLDEN") == "1":
    golden_path.parent.mkdir(parents=True, exist_ok=True)
    golden_path.write_text(json.dumps(golden_actual, indent=1, ensure_ascii=False) + "\n",
                           encoding="utf-8")
    sys.stderr.write("residency sim smoke: golden rewritten\n")
elif not golden_path.exists():
    fail("the golden %s is missing" % golden_path)
elif json.loads(golden_path.read_text()) != golden_actual:
    fail("sim-basic no longer matches the checked-in golden")

# ---- B1: a materially longer scratch directory changes nothing but bytes_read ---------------
# `inputs.bytes_read` grows with the scratch directory's name because a `--expert-trace` document
# embeds its own transcript path (section 6, correction 9), and the golden normalizes that one
# field away rather than pinning it. Setting `TMPDIR` cannot exercise that: BSD `mktemp -d` on
# macOS ignores `TMPDIR` for a bare `-d` invocation and always resolves under `/var/folders`, so a
# `TMPDIR`-based control measures the same directory twice. An explicit template forces a real,
# much longer directory instead.
short_work_dir = work_dir
long_root = short_work_dir.parent / ("b1-long-workdir-" + "x" * 131)
long_root.mkdir(parents=True, exist_ok=True)
long_work_dir = Path(subprocess.run(
    ["mktemp", "-d", str(long_root / "tmp.XXXXXXXX")],
    capture_output=True, text=True, check=True).stdout.strip())
work_dir = long_work_dir
try:
    long_ir, _ = derive_ir("olmoe-full")
    long_basic = [make_trace("b1-basic-%d" % i, [moe(11 + i, 2, 4, UNIFORM)]) for i in range(4)]
    long_list = trace_list("sim-basic", long_basic)
    long_document = check_case("b1-long-workdir", long_list, long_ir, basic_budget)
finally:
    work_dir = short_work_dir

if len(str(long_work_dir)) <= len(str(short_work_dir)):
    fail("b1-long-workdir: the scratch directory did not actually get longer (%d <= %d chars); "
         "the self-check is not exercising anything"
         % (len(str(long_work_dir)), len(str(short_work_dir))))
if long_document["inputs"]["bytes_read"] == document["inputs"]["bytes_read"]:
    fail("b1-long-workdir: bytes_read did not change with the scratch directory's length")
if normalized(long_document) != normalized(document):
    fail("b1-long-workdir: a longer work_dir changed the document beyond the path-dependent fields")
sys.stderr.write(
    "residency sim smoke: b1 work_dir %d -> %d chars, bytes_read %d -> %d\n"
    % (len(str(short_work_dir)), len(str(long_work_dir)),
       document["inputs"]["bytes_read"], long_document["inputs"]["bytes_read"]))

# -------------------------------------------------------------------------------------------
# Section 2.6. One fixture per reachable code, plus the ordering assertion.

def error_case(name, listing, ir_path, budget, code, detail=None, asserts=None):
    document = check_case(name, listing, ir_path, budget, expect_exit=2, asserts=asserts)
    if document["status"] != "error" or document["error_code"] != code:
        fail("%s: reported %r/%r, expected %r"
             % (name, document["status"], document["error_code"], code))
    if detail is not None and document["error_detail"] != detail:
        fail("%s: detail %r, expected %r" % (name, document["error_detail"], detail))
    if document["budgets"] or document["orders"]:
        fail("%s: a failed run must not report a sweep or a replay" % name)
    if document["stream"]["demand_count"] != 0:
        fail("%s: a failed run reports an empty stream" % name)
    return document


def write_json(name, payload):
    path = work_dir / ("%s.json" % name)
    path.write_text(json.dumps(payload), encoding="utf-8")
    return path


def edited_ir(name, mutate):
    payload = json.loads(uniform_ir.read_text())
    mutate(payload)
    return write_json(name, payload)


def edited_trace(name, mutate):
    payload = json.loads(basic[0].read_text())
    mutate(payload)
    return write_json(name, payload)


missing = work_dir / "absent.json"
missing_list = work_dir / "absent.txt"

error_case("budget-malformed", basic_list, uniform_ir, "12x", "R3_BUDGET_MALFORMED")
error_case("budget-negative", basic_list, uniform_ir, "-1", "R3_BUDGET_MALFORMED")
error_case("budget-empty", basic_list, uniform_ir, "", "R3_BUDGET_MALFORMED")
error_case("budget-overflow", basic_list, uniform_ir, "9" * 20, "R3_BUDGET_MALFORMED")
# A budget above `MAX_BYTE_TOTAL` parses as an `i64` and still cannot be reported: the document
# expresses it as a per-mille ratio of the expert footprint, and that multiplication would wrap.
error_case("budget-above-byte-ceiling", basic_list, uniform_ir,
           str(((1 << 63) - 1) // 1000 + 1), "R3_BUDGET_MALFORMED")
error_case("list-unreadable", missing_list, uniform_ir, basic_budget, "R3_TRACE_LIST_UNREADABLE")

empty_list = work_dir / "empty.txt"
