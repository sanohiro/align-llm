    edited_trace("t-duplicate-order", duplicate_selection)]), uniform_ir, basic_budget,
    "R3_SELECTION_UNPACKABLE", detail="1")


def drop_expert_block(payload):
    payload["blocks"] = [b for b in payload["blocks"]
                         if not (b["kind"] == "ExpertBlock" and b["layer"] == 0
                                 and b["expert"] == 0)]


missing_block_ir = edited_ir("ir-missing-block", drop_expert_block)
demanded = json.loads(basic[0].read_text())["selections"]
if not any(s["layer"] == 0 and s["expert"] == 0 for s in demanded):
    fail("expert-block-missing: the seeded router never demands (0, 0); pick another fixture")
error_case("missing-expert-block", basic_list, missing_block_ir, basic_budget,
           "R3_MISSING_EXPERT_BLOCK", detail="0:0")


def empty_selections(payload):
    payload["selections"] = []
    for graph in payload["graphs"]:
        graph["tokens_truncated"] = True


error_case("empty-stream", trace_list("empty-stream", [
    edited_trace("t-empty", empty_selections)]), uniform_ir, basic_budget, "R3_EMPTY_STREAM")

# `validation-order`: an input failing two conditions reports the earlier code. A malformed budget
# beside an unreadable list reports the budget, and an unreadable list beside a broken Model IR
# reports the list.
error_case("order-budget-before-list", missing_list, uniform_ir, "12x", "R3_BUDGET_MALFORMED")
error_case("order-list-before-ir", missing_list, not_json, basic_budget,
           "R3_TRACE_LIST_UNREADABLE")
