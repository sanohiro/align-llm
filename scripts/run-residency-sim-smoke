# Early exit. An arity failure produces no output at all and leaves the destination untouched.

untouched = work_dir / "untouched.json"
for args in (["--simulate-residency"],
             ["--simulate-residency", str(basic_list)],
             ["--simulate-residency", str(basic_list), str(uniform_ir)],
             ["--simulate-residency", str(basic_list), str(uniform_ir), str(basic_budget),
              str(untouched), "extra"]):
    completed = run(args, expect_exit=2)
    if completed.stdout:
        fail("arity-no-output: %r produced stdout" % args)
if untouched.exists():
    fail("arity-no-output: the destination was written by an arity failure")

for args in (["--simulate-residency", "", str(uniform_ir), str(basic_budget)],
             ["--simulate-residency", str(basic_list), "a" * 4097, str(basic_budget)],
             ["--simulate-residency", str(basic_list), str(uniform_ir), str(basic_budget),
              "a" * 4097]):
    completed = run(args, expect_exit=2)
    if completed.stdout:
        fail("path-guard: %r produced stdout" % args)

if failures:
    sys.stderr.write("residency sim smoke: %d failure(s)\n" % len(failures))
    raise SystemExit(1)

print("residency sim smoke: %d model IR(s), %d trace(s), every policy at every sweep budget "
      "against the independent oracle, both CLI forms, the golden, determinism, "
      "the section 2.6 error corpus, and CLI arity/isolation PASS" % (2, len(made)))
