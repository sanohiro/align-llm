def duplicate_block(payload):
    first = next(b for b in payload["blocks"] if b["kind"] == "ExpertBlock")
    payload["blocks"].append(dict(first))


error_case("ir-expert-duplicate", basic_list, edited_ir("ir-dup", duplicate_block), basic_budget,
           "R3_EXPERT_BLOCK_DUPLICATE", detail="0:0")


def range_block(payload):
    first = next(b for b in payload["blocks"] if b["kind"] == "ExpertBlock")
    first["expert"] = 99


error_case("ir-expert-range", basic_list, edited_ir("ir-range", range_block), basic_budget,
           "R3_EXPERT_BLOCK_RANGE", detail="0:99")


def sized_block(size):
    def mutate(payload):
        for block in payload["blocks"]:
            if block["kind"] == "ExpertBlock" and block["layer"] == 0 and block["expert"] == 0:
                block["byte_size"] = size
    return mutate


def every_block(size):
    def mutate(payload):
        for block in payload["blocks"]:
            if block["kind"] == "ExpertBlock":
                block["byte_size"] = size
    return mutate


# A block of no bytes would be admitted into every cache for free and could never be evicted for
# capacity; a negative one is not a size at all and used to be misreported as a missing block.
error_case("ir-expert-size-zero", basic_list, edited_ir("ir-size-zero", sized_block(0)),
           basic_budget, "R3_EXPERT_BLOCK_SIZE", detail="0:0")
error_case("ir-expert-size-negative", basic_list, edited_ir("ir-size-neg", sized_block(-4096)),
           basic_budget, "R3_EXPERT_BLOCK_SIZE", detail="0:0")
# Sixteen experts of 2^50 bytes carry `total_expert_bytes` past MAX_BYTE_TOTAL on the ninth block;
# four experts of 2^47 do not, but sixty demands against them carry `demanded_byte_total` past it.
# Both are refused with a code rather than wrapping into a plausible-looking total. Both budgets are
# themselves legal operands, so step 3 does not fire first.
error_case("ir-byte-total-overflow", basic_list,
           edited_ir("ir-huge", every_block(1 << 50)), str(1 << 50), "R3_BYTE_TOTAL_OVERFLOW")


def edited_mixed_ir(name, mutate):
    payload = json.loads(mixed_ir.read_text())
    mutate(payload)
    return write_json(name, payload)


error_case("stream-byte-total-overflow", trace_list("stream-huge", mixed_traces),
           edited_mixed_ir("mixed-huge", every_block(1 << 47)), str(1 << 47),
           "R3_BYTE_TOTAL_OVERFLOW")
error_case("budget-too-small", basic_list, uniform_ir, uniform_largest - 1, "R3_BUDGET_TOO_SMALL")

absent_trace = work_dir / "absent-trace.txt"
absent_trace.write_text("%s\n" % missing, encoding="utf-8")
