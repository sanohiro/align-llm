error_case("list-empty", empty_list, uniform_ir, basic_budget, "R3_TRACE_LIST_EMPTY")
newline_only = work_dir / "newline.txt"
newline_only.write_text("\n", encoding="utf-8")
error_case("list-blank-line", newline_only, uniform_ir, basic_budget, "R3_PATH", detail="1")
blank_middle = work_dir / "blank-middle.txt"
