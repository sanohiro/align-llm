#!/usr/bin/env bash
set -euo pipefail

# R7-RUNTIME-PROVIDER section 4.1 hosted owner, extended by R8-OLMOE-PROVIDER. It builds tiny F32
# Qwen and OLMoE GGUFs, derives each exact model-IR document, packs each real GGUF, and runs the
# public provider CLI with the deterministic stub engine. No model download, network service, or
# llama.cpp process is needed.

unset ALIGN_LLM_GGML_INCLUDE ALIGN_LLM_GGML_LIB ALIGN_LLM_GGML_FORCE
export PYTHONDONTWRITEBYTECODE=1

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
compiler="${ALIGNC:-${root_dir}/scripts/alignc}"
work_dir=$(mktemp -d)
shim_dir="${work_dir}/lib"
ordinary_main="${work_dir}/ordinary-main"
runtime_main="${work_dir}/runtime-main"
runtime_api="${work_dir}/runtime-provider-api-smoke"
sampler_smoke="${work_dir}/runtime-sampler-smoke"
main_saved=0

cleanup() {
  status=$?
  if [ "${main_saved}" = 1 ] && [ -f "${ordinary_main}" ]; then
    cp "${ordinary_main}" "${root_dir}/main"
  fi
  rm -rf "${work_dir}"
  exit "${status}"
}
trap cleanup EXIT HUP INT TERM

"${root_dir}/scripts/run-runtime-provider-gate" --self-test
static_shim_dir="${work_dir}/static-shim"
ALIGN_LLM_GGML_SHIM_DIR="${static_shim_dir}" ALIGN_LLM_GGML_SHIM_STATIC=1 \
  "${root_dir}/scripts/build-ggml-shim" >/dev/null
test -f "${static_shim_dir}/libalign_ggml_shim.a"
test ! -e "${static_shim_dir}/align_ggml_shim.o"
if ALIGN_LLM_GGML_SHIM_STATIC=invalid "${root_dir}/scripts/build-ggml-shim" >/dev/null 2>&1; then
  echo "runtime provider smoke: FAIL invalid static shim selector was accepted" >&2
  exit 1
fi
python3 "${root_dir}/scripts/runtime_provider_fixture.py" "${work_dir}"
python3 "${root_dir}/scripts/olmoe_provider_fixture.py" "${work_dir}"

python3 - "${root_dir}/main" "${work_dir}" <<'PY'
import json
import subprocess
import sys
from pathlib import Path

binary, work = sys.argv[1], Path(sys.argv[2])
manifest = json.loads((work / "runtime-manifest.json").read_text(encoding="utf-8"))
for key in ("model", "immediate_eog_model", "after_one_eog_model"):
    model = work / manifest[key]
    stem = model.stem
    geometry = work / (stem + "-model-ir.json")
    pack = work / (stem + ".alignpack")
    pack_document = work / (stem + "-pack.json")
    for args in (
        [binary, "--model-ir", str(model), str(geometry)],
        [binary, "--pack", str(model), str(pack), str(pack_document)],
    ):
        result = subprocess.run(args, capture_output=True, check=False)
        if result.returncode != 0:
            raise SystemExit(
                "runtime provider smoke: FAIL fixture preparation %r: %s"
                % (args[1:], result.stderr.decode("utf-8", "replace"))
            )
olmoe = json.loads((work / "olmoe-runtime-manifest.json").read_text(encoding="utf-8"))
for key in ("model", "immediate_eog_model", "sampled_immediate_eog_model",
            "sampled_after_one_eog_model"):
    model = work / olmoe[key]
    stem = model.stem
    geometry = work / (stem + "-model-ir.json")
    pack = work / (stem + ".alignpack")
    pack_document = work / (stem + "-pack.json")
    for args in (
        [binary, "--model-ir", str(model), str(geometry)],
        [binary, "--pack", str(model), str(pack), str(pack_document)],
    ):
        result = subprocess.run(args, capture_output=True, check=False)
        if result.returncode != 0:
            raise SystemExit(
                "runtime provider smoke: FAIL OLMoE fixture preparation %r: %s"
                % (args[1:], result.stderr.decode("utf-8", "replace"))
            )
oversize_replacement = work / "oversize-replacement-model-ir.json"
with oversize_replacement.open("wb") as destination:
    # One byte beyond the generation boundary proves that the capped reopen, rather than the
    # later identity comparison, owns the refusal. Keep the sparse fixture below the installed
    # worker's 512 MiB RLIMIT_FSIZE so the owner reaches the behavior it is meant to exercise.
    destination.seek(16_777_216)
    destination.write(b"x")
PY

cp "${root_dir}/main" "${ordinary_main}"
main_saved=1
ALIGN_LLM_GGML_SHIM_DIR="${shim_dir}" ALIGN_LLM_GGML_FORCE=engine \
  "${root_dir}/scripts/build-ggml-shim" >/dev/null
python3 - "${shim_dir}" <<'PY'
import ctypes
import sys
from pathlib import Path

library = next(Path(sys.argv[1]).glob("libalign_ggml_shim.*"))
shim = ctypes.CDLL(str(library))
shim.align_ggml_context_open.argtypes = [ctypes.c_int64]
shim.align_ggml_context_open.restype = ctypes.c_void_p
shim.align_ggml_context_close.argtypes = [ctypes.c_void_p]
shim.align_ggml_slots_init.argtypes = [ctypes.c_void_p, ctypes.c_int64]
shim.align_ggml_slots_init.restype = ctypes.c_int32
shim.align_ggml_slot_new_strided_tensor_3d.argtypes = [
    ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int64, ctypes.c_int32,
    ctypes.c_int64, ctypes.c_int64, ctypes.c_int64, ctypes.c_int64,
]
shim.align_ggml_slot_new_strided_tensor_3d.restype = ctypes.c_int32
shim.align_ggml_slot_nbytes.argtypes = [ctypes.c_void_p, ctypes.c_int64]
shim.align_ggml_slot_nbytes.restype = ctypes.c_int64

slots = ctypes.create_string_buffer(16 + 4 * 8)
context = shim.align_ggml_context_open(4096)
if not context or shim.align_ggml_slots_init(slots, len(slots)) != 0:
    raise SystemExit("runtime provider smoke: FAIL strided constructor setup")
new = shim.align_ggml_slot_new_strided_tensor_3d
vectors = (
    ("success", new(context, slots, 0, 0, 2, 3, 4, 32), 0),
    ("null-context", new(None, slots, 1, 0, 2, 3, 4, 32), -6),
    ("zero-shape", new(context, slots, 1, 0, 0, 3, 4, 32), -4),
    ("unsupported-type", new(context, slots, 1, 999, 2, 3, 4, 32), -3),
    ("short-stride", new(context, slots, 1, 0, 2, 3, 4, 23), -4),
    ("row-overflow", new(context, slots, 1, 0, 2**63 - 1, 3, 4, 32), -4),
    ("slot-range", new(context, slots, 4, 0, 2, 3, 4, 32), -9),
)
for label, actual, expected in vectors:
    if actual != expected:
        raise SystemExit(
            "runtime provider smoke: FAIL strided %s returned %d, not %d"
            % (label, actual, expected)
        )
if shim.align_ggml_slot_nbytes(slots, 0) != 120:
    raise SystemExit("runtime provider smoke: FAIL strided reachable span")
shim.align_ggml_context_close(context)
PY
(
  cd "${root_dir}"
  export LIBRARY_PATH="${shim_dir}${LIBRARY_PATH:+:${LIBRARY_PATH}}"
  diagnostic="${work_dir}/alignc-diagnostic.txt"
  if ! "${compiler}" build src/main.align >/dev/null 2>"${diagnostic}"; then
    cat "${diagnostic}" >&2
    exit 1
  fi
  mv main "${runtime_main}"
  if ! "${compiler}" build src/runtime_provider_api_smoke.align >/dev/null 2>"${diagnostic}"; then
    cat "${diagnostic}" >&2
    exit 1
  fi
  mv runtime_provider_api_smoke "${runtime_api}"
  if ! "${compiler}" build src/runtime_sampler_smoke.align >/dev/null 2>"${diagnostic}"; then
    cat "${diagnostic}" >&2
    exit 1
  fi
  mv runtime_sampler_smoke "${sampler_smoke}"
  cp "${ordinary_main}" main
)

export DYLD_LIBRARY_PATH="${shim_dir}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}"
export LD_LIBRARY_PATH="${shim_dir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
sampler_output=$("${sampler_smoke}" 2>&1)
if [ "${sampler_output}" != "runtime sampler smoke: PASS" ]; then
  printf '%s\n' "runtime provider smoke: FAIL sampler output: ${sampler_output}" >&2
  exit 1
fi
normal_model="${work_dir}/runtime-qwen2.gguf"
normal_pack="${work_dir}/runtime-qwen2.alignpack"
normal_geometry="${work_dir}/runtime-qwen2-model-ir.json"
set +e
api_output=$("${runtime_api}" "${normal_model}" "${normal_pack}" "${normal_geometry}" \
  "${work_dir}/runtime-qwen2-immediate-eog.alignpack" \
  "${work_dir}/oversize-replacement-model-ir.json" \
  "${work_dir}/runtime-olmoe.gguf" "${work_dir}/runtime-olmoe.alignpack" \
  "${work_dir}/runtime-olmoe-model-ir.json" \
  "${work_dir}/runtime-olmoe-sampled-immediate-eog.gguf" \
  "${work_dir}/runtime-olmoe-sampled-immediate-eog.alignpack" \
  "${work_dir}/runtime-olmoe-sampled-immediate-eog-model-ir.json" \
  "${work_dir}/runtime-olmoe-sampled-after-one-eog.gguf" \
  "${work_dir}/runtime-olmoe-sampled-after-one-eog.alignpack" \
  "${work_dir}/runtime-olmoe-sampled-after-one-eog-model-ir.json" 2>&1)
api_status=$?
set -e
if [ "${api_status}" -ne 0 ] || [ "${api_output}" != "runtime provider API smoke: PASS" ]; then
  printf '%s\n' "runtime provider smoke: FAIL API status ${api_status}, output: ${api_output}" >&2
  exit 1
fi
python3 - "${runtime_main}" "${work_dir}" <<'PY'
import json
import subprocess
import sys
from pathlib import Path

binary, work = sys.argv[1], Path(sys.argv[2])
manifest = json.loads((work / "runtime-manifest.json").read_text(encoding="utf-8"))
checks = 0


def require(condition, message):
    global checks
    checks += 1
    if not condition:
        raise SystemExit("runtime provider smoke: FAIL " + message)


def paths(key):
    model = work / manifest[key]
    stem = model.stem
    return model, work / (stem + ".alignpack"), work / (stem + "-model-ir.json")


def invoke(label, key="model", max_tokens=3, *, pack_key=None, geometry=None, extra=()):
    model, pack, derived = paths(key)
    if pack_key is not None:
        _, pack, _ = paths(pack_key)
    result_path = work / (label + "-result.json")
    args = [
        binary,
        "--provider",
        "align-runtime",
        str(model),
        str(pack),
        str(geometry or derived),
        "x",
        str(result_path),
        str(max_tokens),
        *extra,
    ]
    result = subprocess.run(args, capture_output=True, check=False, timeout=30)
    record = json.loads(result_path.read_text(encoding="utf-8")) if result_path.exists() else None
    return result, record


def successful(label, key, max_tokens, completion_tokens):
    result, record = invoke(label, key, max_tokens)
    require(result.returncode == 0, "%s exited %d: %s" % (
        label, result.returncode, result.stderr.decode("utf-8", "replace")))
    require(record is not None, label + " wrote no GenerationRecord")
    require(record["schema_version"] == 2 and record["operation"] == "generate", label + " schema")
    require(record["provider"] == "align-runtime" and record["endpoint"] == "in-process",
            label + " provider identity")
    require(record["status"] == "ok" and record["error"] == "", label + " status")
    require(record["completion_tokens"] == completion_tokens, "%s completion count %r" % (
        label, record["completion_tokens"]))
    require(record["prompt_tokens"] == manifest["prompt_tokens"], "%s prompt count %r" % (
        label, record["prompt_tokens"]))
    require(record["total_tokens"] == manifest["prompt_tokens"] + completion_tokens,
            label + " total count")
    require(record["token_count_exact"] is True, label + " exact token count")
    return record


one = successful("max-one", "model", 1, 1)
three = successful("max-three", "model", 3, 3)
immediate = successful("immediate-eog", "immediate_eog_model", 3, 0)
after_one = successful("after-one-eog", "after_one_eog_model", 3, 1)
require(len(one["output"].encode("utf-8")) == 1, "max-one output width")
require(len(three["output"].encode("utf-8")) == 3, "max-three output width")
require(immediate["output"] == "", "immediate EOG leaked into completion")
require(after_one["output"] == one["output"], "post-step EOG leaked or first id drifted")

for label, max_tokens in (("zero-max", 0), ("over-max", 129)):
    result, record = invoke(label, max_tokens=max_tokens)
    require(result.returncode != 0 and record is not None, label + " was not recorded as failure")
    require(record["status"] == "error" and record["error"] == "invalid", label + " error mapping")

drift = work / "drift-model-ir.json"
_, _, normal_geometry = paths("model")
drift.write_bytes(normal_geometry.read_bytes() + b"\n")
result, record = invoke("geometry-drift", geometry=drift)
require(result.returncode != 0 and record["status"] == "error", "geometry drift was accepted")

oversize_geometry = work / "oversize-model-ir.json"
with oversize_geometry.open("wb") as destination:
    destination.seek(16_777_216)
    destination.write(b"x")
result, record = invoke("geometry-oversize", geometry=oversize_geometry)
require(result.returncode != 0 and record["status"] == "error", "oversize geometry was accepted")

result, record = invoke("identity-drift", pack_key="immediate_eog_model")
require(result.returncode != 0 and record["status"] == "error", "pack identity drift was accepted")

result, record = invoke("extra-cli-operand", extra=("extra",))
require(result.returncode != 0 and record is None, "runtime CLI accepted an extra operand")

olmoe = json.loads((work / "olmoe-runtime-manifest.json").read_text(encoding="utf-8"))


def invoke_olmoe(label, key="model", max_tokens=1, budget=None, extra=()):
    model = work / olmoe[key]
    stem = model.stem
    result_path = work / (label + "-result.json")
    args = [
        binary,
        "--provider",
        "align-runtime",
        str(model),
        str(work / (stem + ".alignpack")),
        str(work / (stem + "-model-ir.json")),
        "x",
        str(result_path),
        str(max_tokens),
    ]
    if budget is not None:
        args.append(str(budget))
    args.extend(extra)
    result = subprocess.run(args, capture_output=True, check=False, timeout=30)
    record = json.loads(result_path.read_text(encoding="utf-8")) if result_path.exists() else None
    return result, record


budget = olmoe["cache_budget_bytes"]
result, record = invoke_olmoe("olmoe-max-one", budget=budget)
require(result.returncode == 0 and record is not None and record["status"] == "ok",
        "OLMoE max-one generation failed")
require(len(record["output"].encode("utf-8")) == 1 and record["completion_tokens"] == 1,
        "OLMoE max-one completion drifted: %r" % record)
result, record = invoke_olmoe("olmoe-max-two", max_tokens=2, budget=budget)
require(result.returncode == 0 and record is not None and record["status"] == "ok",
        "OLMoE one-step generation failed")
require(record["completion_tokens"] == 2, "OLMoE one-step token count drifted")
result, record = invoke_olmoe(
    "olmoe-immediate-eog", key="immediate_eog_model", max_tokens=3, budget=budget)
require(result.returncode == 0 and record is not None and record["output"] == ""
        and record["completion_tokens"] == 0,
        "OLMoE immediate EOG was consumed or leaked")
for label, rejected_budget in (("olmoe-zero-budget", None), ("olmoe-small-budget", 1),
                               ("olmoe-negative-budget", -1)):
    result, record = invoke_olmoe(label, budget=rejected_budget)
    require(result.returncode != 0 and record is not None and record["status"] == "error",
            label + " was accepted")
result, record = invoke("qwen-positive-budget", extra=(str(budget),))
require(result.returncode != 0 and record is not None and record["status"] == "error",
        "Qwen accepted an expert-cache budget")
result, record = invoke_olmoe("olmoe-extra-cli", budget=budget, extra=("extra",))
require(result.returncode != 0 and record is None, "OLMoE CLI accepted an extra operand")

PY

# Item 66's combined-wrap fallback: the first (dense-plus-cache) wrap is refused, the original
# dense-only retry succeeds, and the same OLMoE request completes through compact claim tensors.
ALIGN_LLM_GGML_SHIM_DIR="${shim_dir}" ALIGN_LLM_GGML_FORCE=engine+cache-wrap \
  "${root_dir}/scripts/build-ggml-shim" >/dev/null
python3 - "${runtime_main}" "${work_dir}" <<'PY'
import json
import subprocess
import sys
from pathlib import Path

binary, work = sys.argv[1], Path(sys.argv[2])
manifest = json.loads((work / "olmoe-runtime-manifest.json").read_text(encoding="utf-8"))
model = work / manifest["model"]
stem = model.stem
result_path = work / "olmoe-cache-wrap-fallback-result.json"
result = subprocess.run(
    [binary, "--provider", "align-runtime", str(model),
     str(work / (stem + ".alignpack")), str(work / (stem + "-model-ir.json")),
     "x", str(result_path), "2", str(manifest["cache_budget_bytes"])],
    capture_output=True, check=False, timeout=30,
)
record = json.loads(result_path.read_text(encoding="utf-8")) if result_path.exists() else None
if result.returncode != 0 or record is None or record.get("status") != "ok" \
        or record.get("completion_tokens") != 2:
    raise SystemExit("runtime provider smoke: FAIL combined cache-wrap fallback: %r" % record)
PY

# The diagnostic decode API deliberately reports non-finite primary logits without failing. Text
# generation must be stricter: no arbitrary argmax may cross the provider boundary. Replacing the
# dynamically loaded forced shim is sufficient because every CLI assertion above ran in a completed
# process and the next process resolves this same absolute install name afresh.
ALIGN_LLM_GGML_SHIM_DIR="${shim_dir}" ALIGN_LLM_GGML_FORCE=engine+inf-readback \
  "${root_dir}/scripts/build-ggml-shim" >/dev/null
python3 - "${runtime_main}" "${work_dir}" <<'PY'
import json
import subprocess
import sys
from pathlib import Path

binary, work = sys.argv[1], Path(sys.argv[2])
result_path = work / "nonfinite-result.json"
result = subprocess.run(
    [binary, "--provider", "align-runtime", str(work / "runtime-qwen2.gguf"),
     str(work / "runtime-qwen2.alignpack"), str(work / "runtime-qwen2-model-ir.json"),
     "x", str(result_path), "1"],
    capture_output=True,
    check=False,
    timeout=30,
)
record = json.loads(result_path.read_text(encoding="utf-8")) if result_path.exists() else None
if (result.returncode == 0 or record is None or record.get("status") != "error"
        or record.get("output") != ""):
    raise SystemExit("runtime provider smoke: FAIL non-finite logits produced completion text")

olmoe = json.loads((work / "olmoe-runtime-manifest.json").read_text(encoding="utf-8"))
model = work / olmoe["model"]
stem = model.stem
result_path = work / "olmoe-nonfinite-result.json"
result = subprocess.run(
    [binary, "--provider", "align-runtime", str(model),
     str(work / (stem + ".alignpack")), str(work / (stem + "-model-ir.json")),
     "x", str(result_path), "1", str(olmoe["cache_budget_bytes"])],
    capture_output=True,
    check=False,
    timeout=30,
)
record = json.loads(result_path.read_text(encoding="utf-8")) if result_path.exists() else None
if (result.returncode == 0 or record is None or record.get("status") != "error"
        or record.get("output") != ""):
    raise SystemExit("runtime provider smoke: FAIL non-finite OLMoE logits produced completion text")
PY

echo "runtime provider smoke: PASS (sampler vectors plus 61 CLI assertions)"
