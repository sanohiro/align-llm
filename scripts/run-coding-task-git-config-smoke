#!/usr/bin/env bash

set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
runner="${project_root}/eval/runners/run-coding-task.py"
task="${project_root}/eval/tasks/coding-v1/python-inclusive-range/task.json"
patch="${project_root}/eval/baselines/patches/python-inclusive-range.patch"
output_file="$(mktemp)"
template_dir="$(mktemp -d)"
tool_dir="$(mktemp -d)"
python_path="$(mktemp -d)"
mkdir -p "${template_dir}/info"
printf '%s\n' "*.py" > "${template_dir}/info/exclude"
printf '%s\n' '#!/usr/bin/env sh' 'exit 97' >"${tool_dir}/python3"
chmod +x "${tool_dir}/python3"
printf '%s\n' 'raise RuntimeError("ambient PYTHONPATH reached validation")' \
  >"${python_path}/unittest.py"
python_bin="$(command -v python3)"
trap 'rm -f "${output_file}"; rm -r "${template_dir}" "${tool_dir}" "${python_path}"' EXIT

cd "${project_root}"
GIT_CONFIG_COUNT=2 \
GIT_CONFIG_KEY_0=i18n.commitEncoding \
GIT_CONFIG_VALUE_0=ISO-8859-1 \
GIT_CONFIG_KEY_1=init.templateDir \
GIT_CONFIG_VALUE_1="${template_dir}" \
  python3 "${runner}" "${task}" "${patch}" >"${output_file}" 2>&1

if ! grep -Fq "fixture revision: 1adf3697ea82a2da6fa9b9aa76f24fb51625ffca" "${output_file}"; then
  printf '%s\n' "coding task fixture changed under ambient Git configuration" >&2
  cat "${output_file}" >&2
  exit 1
fi

printf '%s\n' "coding task ambient Git configuration: isolated"

PATH="${tool_dir}:${PATH}" \
PYTHONPATH="${python_path}" \
  "${python_bin}" "${runner}" "${task}" "${patch}" >"${output_file}" 2>&1

if ! grep -Fq "post-repair validation exit code: 0" "${output_file}"; then
  printf '%s\n' "coding task validation used ambient Python settings" >&2
  cat "${output_file}" >&2
  exit 1
fi

printf '%s\n' "coding task ambient Python settings: isolated"

if [[ ! -x "${project_root}/main" ]]; then
  make -C "${project_root}" build
fi
PATH="${tool_dir}:${PATH}" \
PYTHONPATH="${python_path}" \
  "${project_root}/main" --eval "${project_root}/eval/tasks/coding-v1.json" \
  >"${output_file}" 2>&1

if ! grep -Fq '"task_id":"python-inclusive-range","verdict":"PASS"' "${output_file}"; then
  printf '%s\n' "coding corpus dispatch used ambient Python settings" >&2
  cat "${output_file}" >&2
  exit 1
fi

printf '%s\n' "coding corpus Python dispatch: absolute and isolated"
