#!/usr/bin/env python3
"""Measure paired retained Qwen3.5 CUDA requests across native modes."""

from __future__ import annotations

import hashlib
import json
import os
import re
import statistics
import subprocess
import tempfile
import time
from pathlib import Path
from contextlib import ExitStack

from gpu_session_client import Session


LIST_REQUEST = ("List the integers from 1 to 1000 in ascending order, separated "
                "by single spaces. Output only the integers.")
CASES = (("short", LIST_REQUEST, 56, 16),
         ("chunked", "hello " * 144 + LIST_REQUEST, 200, 32),
         ("wider-attention", "hello " * 274 + LIST_REQUEST, 330, 64))
SYSTEM = "You are a coding assistant. Return a concise patch-oriented answer."


def timed(session: Session, request: dict, prompt: int, completion: int) -> tuple[int, dict]:
    started = time.perf_counter_ns()
    result = session.generate(request)
    elapsed = time.perf_counter_ns() - started
    if result["prompt_tokens"] != prompt or result["completion_tokens"] != completion:
        raise RuntimeError(f"unexpected actual request work: {result}")
    return elapsed, result


def prepare_reference(binary: Path, model: Path, work: Path, label: str,
                      user: str, prompt: int) -> tuple[Path, Path]:
    system_path = work / "system.txt"
    user_path = work / f"{label}-user.txt"
    ids_path = work / f"{label}-ids.json"
    rendered_path = work / f"{label}-rendered.txt"
    system_path.write_text(SYSTEM, encoding="utf-8")
    user_path.write_text(user, encoding="utf-8")
    ids = subprocess.check_output([str(binary), "--prepare-prompt", str(model),
                                   str(system_path), str(user_path)], timeout=30)
    if len(json.loads(ids)) != prompt:
        raise RuntimeError(f"{label}: llama comparison prompt length changed")
    ids_path.write_bytes(ids)
    rendered_path.write_bytes(subprocess.check_output(
        [str(binary), "--detokenize", str(model), str(ids_path), "render-control"],
        timeout=30))
    return rendered_path, ids_path


def timed_many(session: Session, request: dict, prompt: int, completion: int,
               repetitions: int, label: str) -> tuple[int, dict]:
    samples = []
    first_output = None
    result = None
    for _ in range(repetitions):
        elapsed, result = timed(session, request, prompt, completion)
        if first_output is not None and result["output"] != first_output:
            raise RuntimeError(f"{label}: repeated request output changed")
        first_output = result["output"]
        samples.append(elapsed)
    if repetitions > 1:
        print(f"{label} samples_ns={json.dumps(samples, separators=(',', ':'))}", flush=True)
    return sum(samples) // len(samples), result


def check_loaded_shim(session: Session, expected: Path, digest: str) -> None:
    identity = expected.stat()
    mappings = []
    for line in Path(f"/proc/{session.process.pid}/maps").read_text().splitlines():
        fields = line.split(None, 5)
        if len(fields) == 6 and Path(fields[5]).name.startswith("libalign_ggml_shim.so"):
            mappings.append(fields)
    if not mappings or any(fields[5] != str(expected) for fields in mappings):
        raise RuntimeError("previous native session loaded a different shim path")
    device = (os.major(identity.st_dev), os.minor(identity.st_dev))
    if any(tuple(int(part, 16) for part in fields[3].split(":")) != device
           or int(fields[4]) != identity.st_ino for fields in mappings):
        raise RuntimeError("previous native session shim mapping identity changed")
    with expected.open("rb") as stream:
        if hashlib.file_digest(stream, "sha256").hexdigest() != digest:
            raise RuntimeError("previous native shim differs from the recorded baseline")
    print(f"previous_native_loaded_shim={expected} sha256={digest}", flush=True)


def llama_request(reference: Path, binary: Path, model: Path, work: Path,
                  label: str, rendered: Path, ids: Path,
                  prompt: int, completion: int) -> tuple[int, str]:
    process = subprocess.run([str(reference), str(model), str(rendered), str(ids),
                              str(completion)], capture_output=True, timeout=180, check=False)
    if process.returncode:
        raise RuntimeError(f"{label}: pinned llama.cpp failed: {process.stderr[-1000:]!r}")
    rows = re.findall(r"iteration=(\d+) prompt=(\d+) elapsed_ns=(\d+) "
                      r"prefill_ns=(\d+) decode_ns=(\d+) ids=([0-9,]+)",
                      process.stdout.decode("utf-8"))
    if len(rows) != 3 or rows[-1][0] != "2" or int(rows[-1][1]) != prompt:
        raise RuntimeError(f"{label}: incomplete pinned llama.cpp reference")
    generated = [int(value) for value in rows[-1][5].split(",") if value]
    if len(generated) != completion:
        raise RuntimeError(f"{label}: pinned llama.cpp actual output count differs")
    output_ids = work / f"{label}-llama-output.json"
    output_ids.write_text(json.dumps(generated) + "\n", encoding="utf-8")
    output = subprocess.check_output([str(binary), "--detokenize", str(model),
                                      str(output_ids), "render-control"], timeout=30).decode()
    return int(rows[-1][2]), output


def main() -> None:
    repeat_text = os.environ.get("QWEN35_CUDA_PAIR_REQUESTS", "1")
    if not repeat_text.isascii() or not repeat_text.isdecimal() or not 1 <= int(repeat_text) <= 20:
        raise RuntimeError("QWEN35_CUDA_PAIR_REQUESTS must be an integer from 1 to 20")
    repetitions = int(repeat_text)
    measure_mode = os.environ.get("QWEN35_CUDA_MEASURE_MODE", "state-copy")
    if measure_mode not in ("state-copy", "q6-head", "input-batch", "workspace-retain", "prefill-cache"):
        raise RuntimeError("unknown QWEN35_CUDA_MEASURE_MODE")
    model = Path(os.environ["QWEN35_GGUF"]).resolve()
    pack = Path(os.environ["QWEN35_ALIGNPACK"]).resolve()
    geometry = Path(os.environ["QWEN35_MODEL_IR"]).resolve()
    options = Path(os.environ["QWEN35_RUNTIME_OPTIONS"]).resolve()
    binary = Path(os.environ["QWEN35_NATIVE_COPY_BINARY"]).resolve()
    baseline_value = os.environ.get("QWEN35_CUDA_BASELINE_BINARY")
    baseline = Path(baseline_value).resolve() if baseline_value else None
    baseline_digest = None
    baseline_shim = None
    baseline_shim_digest = None
    if baseline is not None:
        if measure_mode not in ("q6-head", "input-batch", "workspace-retain", "prefill-cache"):
            raise RuntimeError("previous native binary requires q6-head or input-batch mode")
        with baseline.open("rb") as stream:
            baseline_digest = hashlib.file_digest(stream, "sha256").hexdigest()
        if baseline_digest != os.environ["QWEN35_CUDA_BASELINE_SHA256"]:
            raise RuntimeError("previous native binary differs from the recorded baseline")
        baseline_shim = Path(os.environ["QWEN35_CUDA_BASELINE_SHIM"]).resolve()
        baseline_shim_digest = os.environ["QWEN35_CUDA_BASELINE_SHIM_SHA256"]
        with baseline_shim.open("rb") as stream:
            if hashlib.file_digest(stream, "sha256").hexdigest() != baseline_shim_digest:
                raise RuntimeError("previous native shim differs from the recorded baseline")
    reference_value = os.environ.get("QWEN35_LLAMA_BENCH")
    reference = Path(reference_value).resolve() if reference_value else None
    reference_digest = None
    reference_revision = None
    if reference is not None:
        with reference.open("rb") as stream:
            reference_digest = hashlib.file_digest(stream, "sha256").hexdigest()
        if reference_digest != os.environ["QWEN35_LLAMA_BENCH_SHA256"]:
            raise RuntimeError("llama.cpp benchmark binary differs from the recorded reference")
        source = Path(os.environ["QWEN35_LLAMA_SOURCE"]).resolve()
        reference_revision = subprocess.check_output(
            ["git", "-C", str(source), "rev-parse", "HEAD"],
            timeout=30).decode("ascii").strip()
        if reference_revision != "bb4caa7540188872173c44d161602d9271386413":
            raise RuntimeError("llama.cpp source is not the pinned revision")
    with model.open("rb") as stream:
        digest = hashlib.file_digest(stream, "sha256").hexdigest()
    if digest != os.environ["QWEN35_EXPECTED_SHA256"]:
        raise RuntimeError("GGUF differs from the recorded real-model source")
    bundle = Path(json.loads(options.read_text(encoding="utf-8"))["backend_bundle"])
    with (bundle / "libggml-cuda.so").open("rb") as stream:
        plugin_hash = hashlib.file_digest(stream, "sha256").hexdigest()
    print(f"measure_mode={measure_mode} model_sha256={digest} plugin_sha256={plugin_hash} "
          f"llama_bench_sha256={reference_digest or 'none'} "
          f"llama_source_commit={reference_revision or 'none'} "
          f"previous_native_sha256={baseline_digest or 'none'} "
          f"align_requests_per_arm={repetitions} llama_warm_intervals_per_pair=1", flush=True)
    command = [str(binary), "--runtime-session", str(model), str(pack),
               str(geometry), str(options), "0"]
    environment = os.environ.copy()
    environment.pop("ALIGN_LLM_RETAIN_WORKSPACE", None)
    environment.pop("ALIGN_LLM_PREFILL_GRAPH_CACHE", None)
    environment["ALIGN_LLM_NATIVE_CONV_COPY"] = "0"
    environment["ALIGN_LLM_NATIVE_PREFILL_STATE_COPY"] = "0"
    environment["ALIGN_LLM_NATIVE_COPY_GREEDY"] = "0"
    ordinary_selection = dict(environment, ALIGN_LLM_NATIVE_STATE_COPY="0",
                              ALIGN_LLM_NATIVE_Q6_HEAD="0")
    native_selection = dict(environment,
                            ALIGN_LLM_NATIVE_STATE_COPY="1" if measure_mode == "state-copy" else "0",
                            ALIGN_LLM_NATIVE_Q6_HEAD="1" if measure_mode == "q6-head" else "0")
    previous_selection = native_selection
    if measure_mode == "input-batch":
        ordinary_selection.update(ALIGN_LLM_NATIVE_Q6_HEAD="1", ALIGN_LLM_PREFILL_CHUNK="128",
                                  ALIGN_LLM_BATCH_DECODE_INPUTS="0")
        native_selection.update(ALIGN_LLM_NATIVE_Q6_HEAD="1", ALIGN_LLM_PREFILL_CHUNK="128",
                                ALIGN_LLM_BATCH_DECODE_INPUTS="1")
        previous_selection = dict(ordinary_selection)
    if measure_mode == "workspace-retain":
        for arm in (ordinary_selection, native_selection):
            arm.update(ALIGN_LLM_NATIVE_STATE_COPY="0", ALIGN_LLM_NATIVE_Q6_HEAD="1",
                       ALIGN_LLM_PREFILL_CHUNK="128", ALIGN_LLM_BATCH_DECODE_INPUTS="1")
        ordinary_selection["ALIGN_LLM_RETAIN_WORKSPACE"] = "0"
        native_selection["ALIGN_LLM_RETAIN_WORKSPACE"] = "1"
        previous_selection = dict(ordinary_selection)
        previous_selection.pop("ALIGN_LLM_RETAIN_WORKSPACE")
    if measure_mode == "prefill-cache":
        for arm in (ordinary_selection, native_selection):
            arm.update(ALIGN_LLM_NATIVE_STATE_COPY="0", ALIGN_LLM_NATIVE_Q6_HEAD="1",
                       ALIGN_LLM_PREFILL_CHUNK="128", ALIGN_LLM_BATCH_DECODE_INPUTS="1",
                       ALIGN_LLM_RETAIN_WORKSPACE="1", ALIGN_LLM_PREFILL_FINAL_LOGITS="1",
                       ALIGN_LLM_PREFILL_LAST_FFN_ROW="0")
        ordinary_selection["ALIGN_LLM_PREFILL_GRAPH_CACHE"] = "0"
        native_selection["ALIGN_LLM_PREFILL_GRAPH_CACHE"] = "1"
        previous_selection = dict(ordinary_selection)
        previous_selection.pop("ALIGN_LLM_PREFILL_GRAPH_CACHE")
    with tempfile.TemporaryDirectory(prefix="qwen35-cuda-measure-") as temporary, \
         Session(command, timeout=180, env=ordinary_selection) as ordinary, \
         Session(command, timeout=180, env=native_selection) as native, ExitStack() as stack:
        previous = (stack.enter_context(Session([str(baseline), *command[1:]],
                                               timeout=180, env=previous_selection))
                    if baseline else None)
        if previous is not None:
            check_loaded_shim(previous, baseline_shim, baseline_shim_digest)
        work = Path(temporary)
        for label, user, prompt, completion in CASES:
            prepared = (prepare_reference(binary, model, work, label, user, prompt)
                        if reference else None)
            request = dict(schema_version=1, system=SYSTEM, user=user,
                           max_tokens=completion, temperature=0.0, seed=None)
            for _ in range(2):
                warm_control = timed(ordinary, request, prompt, completion)[1]["output"]
                warm_native = timed(native, request, prompt, completion)[1]["output"]
                if warm_control != warm_native:
                    raise RuntimeError(f"{label}: warmup outputs differ")
                if previous is not None:
                    warm_previous = timed(previous, request, prompt, completion)[1]["output"]
                    expected_warm = warm_native if measure_mode in ("workspace-retain", "prefill-cache") else \
                        timed(native, request, prompt, completion)[1]["output"]
                    if warm_previous != expected_warm:
                        raise RuntimeError(f"{label}: previous native warmup outputs differ")
            pairs = []
            previous_pairs = []
            for at in range(5):
                old = (timed_many(previous, request, prompt, completion, repetitions,
                                  f"{label} pair={at} previous")
                       if previous is not None and at % 2 == 0 else None)
                llama = (llama_request(reference, binary, model, work, label,
                                       prepared[0], prepared[1], prompt, completion)
                         if reference and at % 2 else None)
                if at % 2 == 0:
                    control, expected = timed_many(ordinary, request, prompt, completion,
                                                   repetitions, f"{label} pair={at} ordinary")
                    selected, actual = timed_many(native, request, prompt, completion,
                                                  repetitions, f"{label} pair={at} native")
                else:
                    selected, actual = timed_many(native, request, prompt, completion,
                                                  repetitions, f"{label} pair={at} native")
                    control, expected = timed_many(ordinary, request, prompt, completion,
                                                   repetitions, f"{label} pair={at} ordinary")
                if actual["output"] != expected["output"]:
                    raise RuntimeError(f"{label} pair {at}: output differs")
                if previous is not None and old is None:
                    old = timed_many(previous, request, prompt, completion, repetitions,
                                     f"{label} pair={at} previous")
                if old is not None:
                    if old[1]["output"] != actual["output"]:
                        raise RuntimeError(f"{label} pair {at}: previous native output differs")
                    previous_pairs.append((old[0], selected))
                if reference and llama is None:
                    llama = llama_request(reference, binary, model, work, label,
                                          prepared[0], prepared[1], prompt, completion)
                if llama is not None and llama[1] != actual["output"]:
                    raise RuntimeError(f"{label} pair {at}: pinned llama.cpp output differs")
                pairs.append((control, selected, llama[0] if llama else None))
                comparison = (f" llama_ms={llama[0] / 1e6:.3f}" if llama else "")
                if old is not None:
                    comparison += f" previous_native_ms={old[0] / 1e6:.3f}"
                print(f"{label} pair={at} ordinary_ms={control / 1e6:.3f} "
                      f"native_ms={selected / 1e6:.3f}{comparison}", flush=True)
            gains = [(base - candidate) / 1e6 for base, candidate, _ in pairs]
            print(f"{label}: median_native_gain_ms={statistics.median(gains):.3f} "
                  f"native_wins={sum(gain > 0 for gain in gains)}/5", flush=True)
            if previous_pairs:
                previous_gains = [(old - selected) / 1e6 for old, selected in previous_pairs]
                print(f"{label}: median_gain_vs_previous_native_ms="
                      f"{statistics.median(previous_gains):.3f} "
                      f"native_wins_vs_previous={sum(gain > 0 for gain in previous_gains)}/5",
                      flush=True)
            if reference:
                llama_gains = [(llama_ns - candidate) / 1e6
                               for _, candidate, llama_ns in pairs]
                print(f"{label}: median_gain_vs_llama_ms={statistics.median(llama_gains):.3f} "
                      f"native_wins_vs_llama={sum(gain > 0 for gain in llama_gains)}/5",
                      flush=True)


if __name__ == "__main__":
    main()
