#!/usr/bin/env python3
"""Measure paired retained Qwen3.5 CUDA requests across copy modes."""

from __future__ import annotations

import hashlib
import json
import os
import re
import statistics
import subprocess
import tempfile
import time
from pathlib import Path

from gpu_session_client import Session


LIST_REQUEST = ("List the integers from 1 to 1000 in ascending order, separated "
                "by single spaces. Output only the integers.")
CASES = (("short", LIST_REQUEST, 56, 16),
         ("chunked", "hello " * 144 + LIST_REQUEST, 200, 32),
         ("wider-attention", "hello " * 274 + LIST_REQUEST, 330, 64))
SYSTEM = "You are a coding assistant. Return a concise patch-oriented answer."


def timed(session: Session, request: dict, prompt: int, completion: int) -> tuple[int, dict]:
    started = time.perf_counter_ns()
    result = session.generate(request)
    elapsed = time.perf_counter_ns() - started
    if result["prompt_tokens"] != prompt or result["completion_tokens"] != completion:
        raise RuntimeError(f"unexpected actual request work: {result}")
    return elapsed, result


def prepare_reference(binary: Path, model: Path, work: Path, label: str,
                      user: str, prompt: int) -> tuple[Path, Path]:
    system_path = work / "system.txt"
    user_path = work / f"{label}-user.txt"
    ids_path = work / f"{label}-ids.json"
    rendered_path = work / f"{label}-rendered.txt"
    system_path.write_text(SYSTEM, encoding="utf-8")
    user_path.write_text(user, encoding="utf-8")
    ids = subprocess.check_output([str(binary), "--prepare-prompt", str(model),
                                   str(system_path), str(user_path)], timeout=30)
    if len(json.loads(ids)) != prompt:
        raise RuntimeError(f"{label}: llama comparison prompt length changed")
    ids_path.write_bytes(ids)
    rendered_path.write_bytes(subprocess.check_output(
        [str(binary), "--detokenize", str(model), str(ids_path), "render-control"],
        timeout=30))
    return rendered_path, ids_path


def llama_request(reference: Path, binary: Path, model: Path, work: Path,
                  label: str, rendered: Path, ids: Path,
                  prompt: int, completion: int) -> tuple[int, str]:
    process = subprocess.run([str(reference), str(model), str(rendered), str(ids),
                              str(completion)], capture_output=True, timeout=180, check=False)
    if process.returncode:
        raise RuntimeError(f"{label}: pinned llama.cpp failed: {process.stderr[-1000:]!r}")
    rows = re.findall(r"iteration=(\d+) prompt=(\d+) elapsed_ns=(\d+) "
                      r"prefill_ns=(\d+) decode_ns=(\d+) ids=([0-9,]+)",
                      process.stdout.decode("utf-8"))
    if len(rows) != 3 or rows[-1][0] != "2" or int(rows[-1][1]) != prompt:
        raise RuntimeError(f"{label}: incomplete pinned llama.cpp reference")
    generated = [int(value) for value in rows[-1][5].split(",") if value]
    if len(generated) != completion:
        raise RuntimeError(f"{label}: pinned llama.cpp actual output count differs")
    output_ids = work / f"{label}-llama-output.json"
    output_ids.write_text(json.dumps(generated) + "\n", encoding="utf-8")
    output = subprocess.check_output([str(binary), "--detokenize", str(model),
                                      str(output_ids), "render-control"], timeout=30).decode()
    return int(rows[-1][2]), output


def main() -> None:
    model = Path(os.environ["QWEN35_GGUF"]).resolve()
    pack = Path(os.environ["QWEN35_ALIGNPACK"]).resolve()
    geometry = Path(os.environ["QWEN35_MODEL_IR"]).resolve()
    options = Path(os.environ["QWEN35_RUNTIME_OPTIONS"]).resolve()
    binary = Path(os.environ["QWEN35_NATIVE_COPY_BINARY"]).resolve()
    reference_value = os.environ.get("QWEN35_LLAMA_BENCH")
    reference = Path(reference_value).resolve() if reference_value else None
    with model.open("rb") as stream:
        digest = hashlib.file_digest(stream, "sha256").hexdigest()
    if digest != os.environ["QWEN35_EXPECTED_SHA256"]:
        raise RuntimeError("GGUF differs from the recorded real-model source")
    bundle = Path(json.loads(options.read_text(encoding="utf-8"))["backend_bundle"])
    with (bundle / "libggml-cuda.so").open("rb") as stream:
        plugin_hash = hashlib.file_digest(stream, "sha256").hexdigest()
    print(f"model_sha256={digest} plugin_sha256={plugin_hash}", flush=True)
    command = [str(binary), "--runtime-session", str(model), str(pack),
               str(geometry), str(options), "0"]
    environment = os.environ.copy()
    environment["ALIGN_LLM_NATIVE_CONV_COPY"] = "0"
    environment["ALIGN_LLM_NATIVE_PREFILL_STATE_COPY"] = "0"
    environment["ALIGN_LLM_NATIVE_COPY_GREEDY"] = "0"
    with tempfile.TemporaryDirectory(prefix="qwen35-cuda-measure-") as temporary, \
         Session(command, timeout=180,
                 env=dict(environment, ALIGN_LLM_NATIVE_STATE_COPY="0")) as ordinary, \
         Session(command, timeout=180,
                 env=dict(environment, ALIGN_LLM_NATIVE_STATE_COPY="1")) as native:
        work = Path(temporary)
        for label, user, prompt, completion in CASES:
            prepared = (prepare_reference(binary, model, work, label, user, prompt)
                        if reference else None)
            request = dict(schema_version=1, system=SYSTEM, user=user,
                           max_tokens=completion, temperature=0.0, seed=None)
            for _ in range(2):
                if timed(ordinary, request, prompt, completion)[1]["output"] != \
                        timed(native, request, prompt, completion)[1]["output"]:
                    raise RuntimeError(f"{label}: warmup outputs differ")
            pairs = []
            for at in range(5):
                llama = (llama_request(reference, binary, model, work, label,
                                       prepared[0], prepared[1], prompt, completion)
                         if reference and at % 2 else None)
                if at % 2 == 0:
                    control, expected = timed(ordinary, request, prompt, completion)
                    selected, actual = timed(native, request, prompt, completion)
                else:
                    selected, actual = timed(native, request, prompt, completion)
                    control, expected = timed(ordinary, request, prompt, completion)
                if actual["output"] != expected["output"]:
                    raise RuntimeError(f"{label} pair {at}: output differs")
                if reference and llama is None:
                    llama = llama_request(reference, binary, model, work, label,
                                          prepared[0], prepared[1], prompt, completion)
                if llama is not None and llama[1] != actual["output"]:
                    raise RuntimeError(f"{label} pair {at}: pinned llama.cpp output differs")
                pairs.append((control, selected, llama[0] if llama else None))
                comparison = (f" llama_ms={llama[0] / 1e6:.3f}" if llama else "")
                print(f"{label} pair={at} ordinary_ms={control / 1e6:.3f} "
                      f"native_ms={selected / 1e6:.3f}{comparison}", flush=True)
            gains = [(base - candidate) / 1e6 for base, candidate, _ in pairs]
            print(f"{label}: median_native_gain_ms={statistics.median(gains):.3f} "
                  f"native_wins={sum(gain > 0 for gain in gains)}/5", flush=True)
            if reference:
                llama_gains = [(llama_ns - candidate) / 1e6
                               for _, candidate, llama_ns in pairs]
                print(f"{label}: median_gain_vs_llama_ms={statistics.median(llama_gains):.3f} "
                      f"native_wins_vs_llama={sum(gain > 0 for gain in llama_gains)}/5",
                      flush=True)


if __name__ == "__main__":
    main()
