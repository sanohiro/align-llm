#!/usr/bin/env python3
"""Focused format, materialization, and failure-contract checks for FRESH-WORKER."""

from __future__ import annotations

import hashlib
import importlib.machinery
import importlib.util
import json
import os
import stat
import subprocess
import sys
import tempfile
from collections import OrderedDict
from pathlib import Path

from fresh_attestation import (
    IMAGE_KEY_ID,
    INVOCATION_PREDICATE_TYPE,
    RUN_KEY_ID,
    ed25519_public_key,
    signed_envelope,
)


REPOSITORY = Path(__file__).resolve().parent.parent
WORKER = REPOSITORY / "scripts/fresh-align-compiler"


def load_worker():
    loader = importlib.machinery.SourceFileLoader("fresh_align_compiler", str(WORKER))
    specification = importlib.util.spec_from_loader(loader.name, loader)
    if specification is None:
        raise AssertionError("worker module specification is unavailable")
    module = importlib.util.module_from_spec(specification)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


def require(condition: bool, message: str) -> None:
    if not condition:
        raise AssertionError(message)


def digest_node(module, root: Path, staged_file_mode: str) -> OrderedDict:
    entries = []
    for child in sorted(root.iterdir(), key=lambda path: os.fsencode(path.name)):
        value = child.lstat()
        if stat.S_ISDIR(value.st_mode):
            node = digest_node(module, child, staged_file_mode)
        else:
            raw = child.read_bytes()
            node = OrderedDict(
                (
                    ("kind", "file"),
                    ("mode", f"{stat.S_IMODE(value.st_mode):04o}"),
                    ("staged_mode", staged_file_mode),
                    ("size", len(raw)),
                    ("sha256", hashlib.sha256(raw).hexdigest()),
                    ("entries", []),
                )
            )
        entries.append(OrderedDict((("name", child.name), *node.items())))
    value = root.lstat()
    node = OrderedDict(
        (
            ("kind", "dir"),
            ("mode", f"{stat.S_IMODE(value.st_mode):04o}"),
            ("staged_mode", "0700"),
            ("size", 0),
            ("sha256", "0" * 64),
            ("entries", entries),
        )
    )
    node["sha256"] = module.sha256(module.digest_tree_preimage(node))
    return node


def canonical_wire_cases(module) -> None:
    value = OrderedDict(
        (
            ("schema_version", 1),
            ("name", "a\n\t\"\\\b\f\r"),
            ("values", [None, True, False, 0, 18446744073709551615]),
        )
    )
    raw = module.canonical_json(value)
    require(module.parse_canonical(raw, len(raw)) == value, "canonical round trip failed")
    for invalid in (
        b'{"a":1,"a":2}\n',
        b'{"a": 1}',
        b'{\n  "a": -1\n}\n',
        b'{\n  "a": 1.0\n}\n',
        b'{\n  "a": NaN\n}\n',
    ):
        try:
            module.parse_canonical(invalid, 1024)
        except (ValueError, json.JSONDecodeError):
            continue
        raise AssertionError(f"invalid canonical JSON accepted: {invalid!r}")


def digest_golden(module, temporary: Path) -> None:
    source = temporary / "golden"
    source.mkdir(mode=0o755)
    (source / "a").write_bytes(b"abc")
    (source / "a").chmod(0o644)
    node = digest_node(module, source, "0444")
    require(
        node["sha256"] == "595f8a4c893a5e141d751b0c1e00d709790a5c7632edacf7fe26442a91c509be",
        "digest-tree golden changed",
    )
    count, size = module.validate_tree_manifest(node, str(source))
    require((count, size) == (2, 3), "digest-tree summary changed")
    destination = temporary / "copy"
    module.copy_tree_manifest(node, source, destination)
    require((destination / "a").read_bytes() == b"abc", "runtime copy bytes changed")
    require(stat.S_IMODE((destination / "a").stat().st_mode) == 0o444, "runtime staged mode changed")

    changed = OrderedDict(node)
    changed["sha256"] = "0" * 64
    try:
        module.validate_tree_manifest(changed, str(source))
    except ValueError:
        pass
    else:
        raise AssertionError("wrong structural digest accepted")

    runtime = temporary / "runtime-hardlinks"
    runtime.mkdir(mode=0o755)
    (runtime / "original").write_bytes(b"shared runtime bytes")
    (runtime / "original").chmod(0o644)
    os.link(runtime / "original", runtime / "alias")
    runtime_node = digest_node(module, runtime, "0444")
    require(
        module.validate_tree_manifest(runtime_node, str(runtime)) == (3, 40),
        "stable runtime hardlinks were rejected",
    )
    runtime_copy = temporary / "runtime-hardlinks-copy"
    module.copy_tree_manifest(runtime_node, runtime, runtime_copy)
    require(
        (runtime_copy / "original").read_bytes()
        == (runtime_copy / "alias").read_bytes()
        == b"shared runtime bytes",
        "runtime hardlink bytes changed during private copy",
    )
    cache_node = digest_node(module, runtime, "0600")
    try:
        module.validate_tree_manifest(cache_node, str(runtime), policy="cache")
    except OSError:
        pass
    else:
        raise AssertionError("cache hardlinks were accepted")


def cache_cases(module, temporary: Path) -> None:
    root = temporary / "cargo"
    path = root / "registry/index"
    path.mkdir(parents=True, mode=0o755)
    (root / "git/checkouts").mkdir(parents=True, mode=0o755)
    (root / "git/db").mkdir(mode=0o755)
    (root / "registry/cache").mkdir(mode=0o755)
    (root / "registry/src").mkdir(mode=0o755)
    (path / "a").write_bytes(b"abc")
    (path / "a").chmod(0o644)
    node = digest_node(module, root, "0600")
    count, size = module.validate_tree_manifest(node, str(root), policy="cache")
    manifest = OrderedDict(
        (
            ("schema_version", 2),
            ("allowed_prefixes", list(module.ALLOWED_CACHE_PREFIXES)),
            ("root", node),
            ("entry_count", count - 1),
            ("total_size", size),
        )
    )
    manifest_path = temporary / "cache.json"
    manifest_raw = module.canonical_json(manifest)
    manifest_path.write_bytes(manifest_raw)
    control = {
        "cargo_cache": {
            "root": str(root),
            "manifest": str(manifest_path),
            "manifest_sha256": module.sha256(manifest_raw),
            "entry_count": count - 1,
        }
    }
    module.validate_cache(control)
    destination = temporary / "cargo-copy"
    destination.mkdir(mode=0o700)
    module.copy_cache(control, manifest, destination)
    require((destination / "registry/index/a").read_bytes() == b"abc", "cache copy changed")
    require(stat.S_IMODE((destination / "registry/index/a").stat().st_mode) == 0o600, "cache mode changed")


def public_error_cases(module) -> None:
    error = module.WorkerError("BUILD", "build")
    require((error.category, error.phase, error.cleanup_failed) == ("BUILD", "build", False), "error envelope changed")
    require("CLEANUP" not in module.PUBLIC_CATEGORIES, "cleanup became a primary category")
    require(module.ROOT_CHILDREN[-1] == "descriptor", "private-root layout changed")


def run_attestation_cases(module) -> None:
    seed = bytes(range(32))
    public_key = ed25519_public_key(seed)
    manifest_raw = module.canonical_json(OrderedDict((('schema_version', 2),)))
    predicate = OrderedDict(
        (
            ("schema_version", 1),
            ("image_attestation_sha256", "1" * 64),
            ("manifest_sha256", module.sha256(manifest_raw)),
            ("repository_object_format", "sha1"),
            ("repository_head", "2" * 40),
            ("align_repo_relative", "../align"),
            ("controller_path", module.CONTROLLER_PATH),
            ("controller_sha256", "3" * 64),
            ("supervisor_identity", IMAGE_KEY_ID),
            ("supervisor_version", module.SUPERVISOR_VERSION),
            ("supervisor_key_id", RUN_KEY_ID),
            ("supervisor_key_sha256", module.sha256(public_key)),
        )
    )

    def envelope(value):
        return signed_envelope(
            value,
            payload_type=INVOCATION_PREDICATE_TYPE,
            key_id=RUN_KEY_ID,
            seed=seed,
        )

    accepted = module.invocation_predicate(envelope(predicate), manifest_raw, public_key)
    require(accepted == predicate, "signed invocation predicate changed")

    invalid_signature = bytearray(envelope(predicate))
    offset = invalid_signature.index(b'"sig": "') + len(b'"sig": "')
    invalid_signature[offset] = ord("A") if invalid_signature[offset] != ord("A") else ord("B")
    for raw, key in (
        (bytes(invalid_signature), public_key),
        (envelope(predicate), b"\0" * 32),
    ):
        try:
            module.invocation_predicate(raw, manifest_raw, key)
        except ValueError:
            pass
        else:
            raise AssertionError("invalid invocation signature accepted")

    for field, value in (
        ("image_attestation_sha256", "not-a-digest"),
        ("supervisor_identity", "replayed-supervisor"),
        ("supervisor_version", "2.0.0"),
        ("supervisor_key_id", "wrong-key"),
    ):
        changed = OrderedDict(predicate)
        changed[field] = value
        try:
            module.invocation_predicate(envelope(changed), manifest_raw, public_key)
        except ValueError:
            pass
        else:
            raise AssertionError(f"invalid invocation tuple accepted: {field}")


def cleanup_success_case(module, temporary: Path) -> None:
    roots = temporary / "success-roots"
    roots.mkdir(mode=0o700)
    roots_fd = os.open(roots, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    roots_identity = module.snapshot_fd(roots_fd)
    root_name = module.ROOT_PREFIX + "success"
    admitted = roots / root_name
    admitted.mkdir(mode=0o700)
    root_fd = os.open(admitted, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    root_identity = module.snapshot_fd(root_fd)
    (admitted / "owned").write_bytes(b"owned")
    lock = temporary / "success-lock"
    lock.write_bytes(b"")
    lock_fd = os.open(lock, os.O_RDWR | os.O_CLOEXEC)
    admission = module.Admission(
        lock_fd,
        roots_fd,
        roots_identity,
        root_fd,
        root_identity,
        root_name,
        Path(f"/proc/{os.getpid()}/fd/{root_fd}"),
    )
    module.cleanup(admission)
    require(not admitted.exists(), "owned private root remained after cleanup")


def private_mount_case(module, temporary: Path) -> None:
    roots = temporary / "mount-roots"
    roots.mkdir(mode=0o700)
    admitted = roots / "mount-root"
    admitted.mkdir(mode=0o700)
    directory = admitted / "directory"
    directory.mkdir(mode=0o700)
    regular = admitted / "regular"
    regular.write_bytes(b"mount bytes")
    regular.chmod(0o444)
    roots_fd = os.open(roots, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    root_fd = os.open(admitted, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    lock_fd = os.open(regular, os.O_RDONLY | os.O_CLOEXEC)
    admission = module.Admission(
        lock_fd,
        roots_fd,
        module.snapshot_fd(roots_fd),
        root_fd,
        module.snapshot_fd(root_fd),
        admitted.name,
        Path(f"/proc/{os.getpid()}/fd/{root_fd}"),
    )
    descriptors: tuple[int, ...] = ()
    try:
        arguments, descriptors = module.private_bind_arguments(
            admission,
            (
                (admission.root_path / "directory", "/directory", "dir", True),
                (admission.root_path / "regular", "/regular", "file", False),
            ),
        )
        require(
            arguments
            == [
                "--bind-fd",
                str(descriptors[0]),
                "/directory",
                "--ro-bind-fd",
                str(descriptors[1]),
                "/regular",
            ],
            "private descriptor bind argv changed",
        )
        require(
            stat.S_ISDIR(os.fstat(descriptors[0]).st_mode)
            and stat.S_ISREG(os.fstat(descriptors[1]).st_mode),
            "private mount descriptors did not retain source identity",
        )
        try:
            module.open_private_mount(
                admission, admission.root_path.parent / "escape", "dir"
            )
        except OSError:
            pass
        else:
            raise AssertionError("private mount source escaped the admitted root")
    finally:
        module.close_private_mounts(descriptors)
        os.close(root_fd)
        os.close(roots_fd)
        os.close(lock_fd)


def cleanup_replacement_case(module, temporary: Path) -> None:
    roots = temporary / "roots"
    roots.mkdir(mode=0o700)
    root_name = module.ROOT_PREFIX + "replacement"
    admitted = roots / root_name
    admitted.mkdir(mode=0o700)
    (admitted / "owned").write_bytes(b"owned")
    roots_fd = os.open(roots, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    root_fd = os.open(admitted, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    lock = temporary / "lock"
    lock.write_bytes(b"")
    lock_fd = os.open(lock, os.O_RDWR | os.O_CLOEXEC)
    admission = module.Admission(
        lock_fd,
        roots_fd,
        module.snapshot_fd(roots_fd),
        root_fd,
        module.snapshot_fd(root_fd),
        root_name,
        Path(f"/proc/{os.getpid()}/fd/{root_fd}"),
    )
    moved = roots / "moved-admitted-root"
    admitted.rename(moved)
    admitted.mkdir(mode=0o700)
    marker = admitted / "replacement-marker"
    marker.write_bytes(b"replacement")
    try:
        module.cleanup(admission)
    except module.CleanupError:
        pass
    else:
        raise AssertionError("replacement private root was accepted for cleanup")
    require(marker.read_bytes() == b"replacement", "cleanup deleted a replacement root")
    require((moved / "owned").read_bytes() == b"owned", "cleanup changed the admitted root on mismatch")
    for descriptor in (root_fd, roots_fd, lock_fd):
        os.close(descriptor)


def bounded_tool_cases(module) -> None:
    python_fd = os.open("/usr/bin/python3", os.O_RDONLY | os.O_CLOEXEC)
    try:
        try:
            module.run_tool(
                python_fd,
                ("python3", "-c", f"import os; os.write(1, b'x' * {module.MAX_STREAM_BYTES + 1})"),
                timeout=5,
            )
        except ValueError:
            pass
        else:
            raise AssertionError("tool stream cap-plus-one was buffered or accepted")
        try:
            module.run_tool(
                python_fd,
                ("python3", "-c", "import time; time.sleep(5)"),
                timeout=1,
            )
        except subprocess.TimeoutExpired:
            pass
        else:
            raise AssertionError("tool deadline was not enforced")
    finally:
        os.close(python_fd)


def source_identity_cases(module, temporary: Path) -> None:
    git_path = Path("/usr/bin/git")
    require(git_path.is_file(), "Git fixture executable is unavailable")
    git_fd = os.open(git_path, os.O_RDONLY | os.O_CLOEXEC)
    environment = {
        "PATH": "/usr/bin:/bin",
        "LC_ALL": "C",
        "HOME": "/nonexistent",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_AUTHOR_NAME": "FRESH-WORKER",
        "GIT_AUTHOR_EMAIL": "fresh-worker@example.invalid",
        "GIT_COMMITTER_NAME": "FRESH-WORKER",
        "GIT_COMMITTER_EMAIL": "fresh-worker@example.invalid",
    }
    try:
        for object_format in ("sha1", "sha256"):
            root = temporary / f"source-{object_format}"
            root.mkdir(mode=0o700)
            subprocess.run(
                [str(git_path), "init", "-q", f"--object-format={object_format}"],
                cwd=root,
                env=environment,
                check=True,
            )
            (root / "dir").mkdir(mode=0o755)
            (root / "dir/file").write_bytes(b"source\n")
            (root / "dir/file").chmod(0o644)
            (root / "dir.file").write_bytes(b"source sibling\n")
            (root / "dir.file").chmod(0o644)
            os.symlink("dir/file", root / "link")
            subprocess.run([str(git_path), "add", "--all"], cwd=root, env=environment, check=True)
            subprocess.run([str(git_path), "commit", "-q", "-m", "fixture"], cwd=root, env=environment, check=True)
            (root / "target").mkdir(mode=0o700)
            (root / "main").write_bytes(b"output")
            (root / "main").chmod(0o755)
            root_fd = os.open(root, os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
            try:
                identity = module.source_identity("project-source", root_fd, git_fd)
            finally:
                os.close(root_fd)
            require(identity.object_format == object_format, "source object format changed")
            require(
                [entry.path for entry in identity.entries]
                == [b"dir", b"dir.file", b"dir/file", b"link"],
                "source entry raw-byte order changed",
            )
            require(identity.manifest_digest == module.sha256(identity.manifest_raw), "source manifest digest changed")
            if object_format == "sha1":
                linked = temporary / "source-linked"
                subprocess.run(
                    [str(git_path), "worktree", "add", "-q", "--detach", str(linked), "HEAD"],
                    cwd=root,
                    env=environment,
                    check=True,
                )
                linked_fd = os.open(linked, os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
                try:
                    linked_identity = module.source_identity("project-source", linked_fd, git_fd)
                    view = temporary / "baseline-view"
                    view.mkdir(mode=0o700)
                    module.copy_git_view(linked_identity, view)
                finally:
                    os.close(linked_fd)
                require(linked_identity.revision == identity.revision, "linked source identity changed")
                resolved = subprocess.run(
                    [str(git_path), "--git-dir", str(view), "rev-parse", "HEAD"],
                    env=environment,
                    check=True,
                    capture_output=True,
                    text=True,
                ).stdout.strip()
                require(resolved == identity.revision, "linked baseline view changed")
                admitted_git = root / ".git-admitted"
                (root / ".git").rename(admitted_git)
                (root / ".git").mkdir(mode=0o700)
                try:
                    try:
                        module.assert_git_view(linked_identity.view)
                    except ValueError:
                        pass
                    else:
                        raise AssertionError("linked common-directory replacement was accepted")
                finally:
                    (root / ".git").rmdir()
                    admitted_git.rename(root / ".git")
                module.close_git_view(linked_identity.view)
            module.close_git_view(identity.view)

            subprocess.run(
                [str(git_path), "pack-refs", "--all"], cwd=root, env=environment, check=True
            )
            packed_fd = os.open(root, os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
            try:
                packed_identity = module.source_identity("project-source", packed_fd, git_fd)
            finally:
                os.close(packed_fd)
            require(packed_identity.revision, "packed Git ref identity was not retained")
            module.close_git_view(packed_identity.view)

            mutation_fd = os.open(root, os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
            try:
                mutation_identity = module.source_identity("project-source", mutation_fd, git_fd)
            finally:
                os.close(mutation_fd)
            (root / "dir/file").write_bytes(b"changed after capture\n")
            rejected_copy = temporary / f"rejected-copy-{object_format}"
            rejected_copy.mkdir(mode=0o700)
            try:
                module.copy_source(mutation_identity, rejected_copy)
            except (OSError, ValueError):
                pass
            else:
                raise AssertionError("source mutation during copy was accepted")
            module.close_git_view(mutation_identity.view)
            subprocess.run(
                [str(git_path), "checkout", "--", "dir/file"], cwd=root, env=environment, check=True
            )

            marker = temporary / f"fsmonitor-{object_format}"
            helper = temporary / f"fsmonitor-{object_format}.sh"
            helper.write_text(f"#!/bin/sh\ntouch '{marker}'\nexit 0\n", encoding="utf-8")
            helper.chmod(0o755)
            subprocess.run(
                [str(git_path), "config", "core.fsmonitor", str(helper)],
                cwd=root,
                env=environment,
                check=True,
            )
            rejected_fd = os.open(root, os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
            try:
                try:
                    module.source_identity("project-source", rejected_fd, git_fd)
                except ValueError:
                    pass
                else:
                    raise AssertionError("local core.fsmonitor configuration was accepted")
            finally:
                os.close(rejected_fd)
            require(not marker.exists(), "local core.fsmonitor executed before source admission")
            subprocess.run(
                [str(git_path), "config", "--unset", "core.fsmonitor"],
                cwd=root,
                env=environment,
                check=True,
            )

            filter_marker = temporary / f"filter-{object_format}"
            subprocess.run(
                [
                    str(git_path),
                    "config",
                    "filter.evil.clean",
                    f"sh -c 'touch {filter_marker}'",
                ],
                cwd=root,
                env=environment,
                check=True,
            )
            filter_fd = os.open(root, os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
            try:
                try:
                    module.source_identity("project-source", filter_fd, git_fd)
                except ValueError:
                    pass
                else:
                    raise AssertionError("local filter configuration was accepted")
            finally:
                os.close(filter_fd)
            require(not filter_marker.exists(), "local filter executed before source admission")
            subprocess.run(
                [str(git_path), "config", "--unset", "filter.evil.clean"],
                cwd=root,
                env=environment,
                check=True,
            )

            alternates = root / ".git/objects/info/alternates"
            alternates.write_text("/tmp\n", encoding="utf-8")
            alternate_fd = os.open(root, os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
            try:
                try:
                    module.source_identity("project-source", alternate_fd, git_fd)
                except ValueError:
                    pass
                else:
                    raise AssertionError("Git object alternate was accepted")
            finally:
                os.close(alternate_fd)
                alternates.unlink()
    finally:
        os.close(git_fd)


def main() -> int:
    require(stat.S_IMODE(WORKER.stat().st_mode) == 0o755, "worker mode is not 0755")
    require(WORKER.stat().st_size <= 4_194_304, "worker exceeds bootstrap bound")
    module = load_worker()
    canonical_wire_cases(module)
    run_attestation_cases(module)
    bounded_tool_cases(module)
    with tempfile.TemporaryDirectory(prefix="fresh-worker-unit-") as name:
        temporary = Path(name)
        digest_golden(module, temporary)
        cache_cases(module, temporary)
        source_identity_cases(module, temporary)
        private_mount_case(module, temporary)
        cleanup_success_case(module, temporary)
        cleanup_replacement_case(module, temporary)
    public_error_cases(module)
    print("fresh worker unit smoke: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
