#!/usr/bin/env python3
"""Focused format, materialization, and failure-contract checks for FRESH-WORKER."""

from __future__ import annotations

import hashlib
import importlib.machinery
import importlib.util
import json
import os
import stat
import subprocess
import sys
import tempfile
from collections import OrderedDict
from pathlib import Path


REPOSITORY = Path(__file__).resolve().parent.parent
WORKER = REPOSITORY / "scripts/fresh-align-compiler"


def load_worker():
    loader = importlib.machinery.SourceFileLoader("fresh_align_compiler", str(WORKER))
    specification = importlib.util.spec_from_loader(loader.name, loader)
    if specification is None:
        raise AssertionError("worker module specification is unavailable")
    module = importlib.util.module_from_spec(specification)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


def require(condition: bool, message: str) -> None:
    if not condition:
        raise AssertionError(message)


def digest_node(module, root: Path, staged_file_mode: str) -> OrderedDict:
    entries = []
    for child in sorted(root.iterdir(), key=lambda path: os.fsencode(path.name)):
        value = child.lstat()
        if stat.S_ISDIR(value.st_mode):
            node = digest_node(module, child, staged_file_mode)
        else:
            raw = child.read_bytes()
            node = OrderedDict(
                (
                    ("kind", "file"),
                    ("mode", f"{stat.S_IMODE(value.st_mode):04o}"),
                    ("staged_mode", staged_file_mode),
                    ("size", len(raw)),
                    ("sha256", hashlib.sha256(raw).hexdigest()),
                    ("entries", []),
                )
            )
        entries.append(OrderedDict((("name", child.name), *node.items())))
    value = root.lstat()
    node = OrderedDict(
        (
            ("kind", "dir"),
            ("mode", f"{stat.S_IMODE(value.st_mode):04o}"),
            ("staged_mode", "0700"),
            ("size", 0),
            ("sha256", "0" * 64),
            ("entries", entries),
        )
    )
    node["sha256"] = module.sha256(module.digest_tree_preimage(node))
    return node


def canonical_wire_cases(module) -> None:
    value = OrderedDict(
        (
            ("schema_version", 1),
            ("name", "a\n\t\"\\\b\f\r"),
            ("values", [None, True, False, 0, 18446744073709551615]),
        )
    )
    raw = module.canonical_json(value)
    require(module.parse_canonical(raw, len(raw)) == value, "canonical round trip failed")
    for invalid in (
        b'{"a":1,"a":2}\n',
        b'{"a": 1}',
        b'{\n  "a": -1\n}\n',
        b'{\n  "a": 1.0\n}\n',
        b'{\n  "a": NaN\n}\n',
    ):
        try:
            module.parse_canonical(invalid, 1024)
        except (ValueError, json.JSONDecodeError):
            continue
        raise AssertionError(f"invalid canonical JSON accepted: {invalid!r}")


def digest_golden(module, temporary: Path) -> None:
    source = temporary / "golden"
    source.mkdir(mode=0o755)
    (source / "a").write_bytes(b"abc")
    (source / "a").chmod(0o644)
    node = digest_node(module, source, "0444")
    require(
        node["sha256"] == "595f8a4c893a5e141d751b0c1e00d709790a5c7632edacf7fe26442a91c509be",
        "digest-tree golden changed",
    )
    count, size = module.validate_tree_manifest(node, str(source))
    require((count, size) == (2, 3), "digest-tree summary changed")
    destination = temporary / "copy"
    module.copy_tree_manifest(node, source, destination)
    require((destination / "a").read_bytes() == b"abc", "runtime copy bytes changed")
    require(stat.S_IMODE((destination / "a").stat().st_mode) == 0o444, "runtime staged mode changed")

    changed = OrderedDict(node)
    changed["sha256"] = "0" * 64
    try:
        module.validate_tree_manifest(changed, str(source))
    except ValueError:
        pass
    else:
        raise AssertionError("wrong structural digest accepted")


def cache_cases(module, temporary: Path) -> None:
    root = temporary / "cargo"
    path = root / "registry/index"
    path.mkdir(parents=True, mode=0o755)
    (root / "git/checkouts").mkdir(parents=True, mode=0o755)
    (root / "git/db").mkdir(mode=0o755)
    (root / "registry/cache").mkdir(mode=0o755)
    (root / "registry/src").mkdir(mode=0o755)
    (path / "a").write_bytes(b"abc")
    (path / "a").chmod(0o644)
    node = digest_node(module, root, "0600")
    count, size = module.validate_tree_manifest(node, str(root), policy="cache")
    manifest = OrderedDict(
        (
            ("schema_version", 2),
            ("allowed_prefixes", list(module.ALLOWED_CACHE_PREFIXES)),
            ("root", node),
            ("entry_count", count - 1),
            ("total_size", size),
        )
    )
    manifest_path = temporary / "cache.json"
    manifest_raw = module.canonical_json(manifest)
    manifest_path.write_bytes(manifest_raw)
    control = {
        "cargo_cache": {
            "root": str(root),
            "manifest": str(manifest_path),
            "manifest_sha256": module.sha256(manifest_raw),
            "entry_count": count - 1,
        }
    }
    module.validate_cache(control)
    destination = temporary / "cargo-copy"
    destination.mkdir(mode=0o700)
    module.copy_cache(control, manifest, destination)
    require((destination / "registry/index/a").read_bytes() == b"abc", "cache copy changed")
    require(stat.S_IMODE((destination / "registry/index/a").stat().st_mode) == 0o600, "cache mode changed")


def public_error_cases(module) -> None:
    error = module.WorkerError("BUILD", "build")
    require((error.category, error.phase, error.cleanup_failed) == ("BUILD", "build", False), "error envelope changed")
    require("CLEANUP" not in module.PUBLIC_CATEGORIES, "cleanup became a primary category")
    require(module.ROOT_CHILDREN[-1] == "descriptor", "private-root layout changed")


def source_identity_cases(module, temporary: Path) -> None:
    git_path = Path("/usr/bin/git")
    require(git_path.is_file(), "Git fixture executable is unavailable")
    git_fd = os.open(git_path, os.O_RDONLY | os.O_CLOEXEC)
    environment = {
        "PATH": "/usr/bin:/bin",
        "LC_ALL": "C",
        "HOME": "/nonexistent",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_AUTHOR_NAME": "FRESH-WORKER",
        "GIT_AUTHOR_EMAIL": "fresh-worker@example.invalid",
        "GIT_COMMITTER_NAME": "FRESH-WORKER",
        "GIT_COMMITTER_EMAIL": "fresh-worker@example.invalid",
    }
    try:
        for object_format in ("sha1", "sha256"):
            root = temporary / f"source-{object_format}"
            root.mkdir(mode=0o700)
            subprocess.run(
                [str(git_path), "init", "-q", f"--object-format={object_format}"],
                cwd=root,
                env=environment,
                check=True,
            )
            (root / "dir").mkdir(mode=0o755)
            (root / "dir/file").write_bytes(b"source\n")
            (root / "dir/file").chmod(0o644)
            os.symlink("dir/file", root / "link")
            subprocess.run([str(git_path), "add", "--all"], cwd=root, env=environment, check=True)
            subprocess.run([str(git_path), "commit", "-q", "-m", "fixture"], cwd=root, env=environment, check=True)
            (root / "target").mkdir(mode=0o700)
            (root / "main").write_bytes(b"output")
            (root / "main").chmod(0o755)
            root_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
            try:
                identity = module.source_identity("project-source", root_fd, git_fd)
            finally:
                os.close(root_fd)
            require(identity.object_format == object_format, "source object format changed")
            require([entry.path for entry in identity.entries] == [b"dir", b"dir/file", b"link"], "source entry closure changed")
            require(identity.manifest_digest == module.sha256(identity.manifest_raw), "source manifest digest changed")
            if object_format == "sha1":
                linked = temporary / "source-linked"
                subprocess.run(
                    [str(git_path), "worktree", "add", "-q", "--detach", str(linked), "HEAD"],
                    cwd=root,
                    env=environment,
                    check=True,
                )
                linked_fd = os.open(linked, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
                try:
                    linked_identity = module.source_identity("project-source", linked_fd, git_fd)
                    view = temporary / "baseline-view"
                    view.mkdir(mode=0o700)
                    module.copy_git_view(linked_fd, git_fd, view)
                finally:
                    os.close(linked_fd)
                require(linked_identity.revision == identity.revision, "linked source identity changed")
                resolved = subprocess.run(
                    [str(git_path), "--git-dir", str(view), "rev-parse", "HEAD"],
                    env=environment,
                    check=True,
                    capture_output=True,
                    text=True,
                ).stdout.strip()
                require(resolved == identity.revision, "linked baseline view changed")
    finally:
        os.close(git_fd)


def main() -> int:
    require(stat.S_IMODE(WORKER.stat().st_mode) == 0o755, "worker mode is not 0755")
    require(WORKER.stat().st_size <= 4_194_304, "worker exceeds bootstrap bound")
    module = load_worker()
    canonical_wire_cases(module)
    with tempfile.TemporaryDirectory(prefix="fresh-worker-unit-") as name:
        temporary = Path(name)
        digest_golden(module, temporary)
        cache_cases(module, temporary)
        source_identity_cases(module, temporary)
    public_error_cases(module)
    print("fresh worker unit smoke: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
