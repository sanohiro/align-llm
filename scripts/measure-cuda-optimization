#!/usr/bin/env python3
"""Source-bound paired CUDA intervention measurement; never a product entrypoint."""
import argparse
from contextlib import contextmanager
import hashlib
import json
import os
from pathlib import Path
import statistics
import signal
import sys
import tempfile
import subprocess
import time

from gpu_independent_acceptance import verify_build, source_files
from gpu_qualification_input import admit
from gpu_session_client import Session as BaseSession, qualification_environment

ROOT = Path(__file__).resolve().parent.parent
CONTROL = '4bf801112a03521bf9a1ed9a47cc45cd613cebd3'
SYSTEM = 'You are a helpful assistant. Follow the output format exactly.'
SHORT = 'List the integers from 1 through 500 in ascending order, separated by single spaces. Output only the integers.'
LONG = 'Repository context (irrelevant to this formatting task):\n' + 'alpha beta gamma delta\n' * 128 + '\n' + SHORT
CASES = [('cold-short', SHORT), ('warm-short-cached', SHORT), ('warm-long-changed', LONG), ('warm-long-cached', LONG)]
CASE_NAMES = tuple(name for name, _ in CASES)
COUNTS = ('output', 'prompt_tokens', 'completion_tokens', 'total_tokens', 'token_count_exact')
# A protocol names its case list, its compared metrics (the first is the primary metric),
# its default primary row and the measured-clock budget the plan settles for it.
PROTOCOLS = {name: dict(table, case_names=tuple(case for case, _ in table['cases'])) for name, table in {
    'request': dict(cases=list(CASES), metrics=('client_ns',), primary='olmoe:warm-long-cached', measured_budget_ns=None),
    'startup': dict(cases=list(CASES[:1]), metrics=('startup_ns', 'client_ns'), primary='olmoe:cold-short',
        measured_budget_ns=900000000000),
}.items()}
ARM_METRICS = ('startup_ns',)
IO_FIELDS = ('rchar', 'read_bytes')
MEMINFO_FIELDS = ('MemTotal', 'MemAvailable', 'Cached', 'Buffers')


class Cancelled(RuntimeError):
    pass


class Session(BaseSession):
    def close(self, *, check=True):
        # Keep first cancellation pending while the shared helper owns shutdown.
        previous = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGTERM, signal.SIGINT})
        try:
            return super().close(check=check)
        finally:
            signal.pthread_sigmask(signal.SIG_SETMASK, previous)


@contextmanager
def cancellation_scope():
    def cancel(number, _frame):
        # A second interrupt must not interrupt owned-worker cleanup.
        for item in (signal.SIGTERM, signal.SIGINT):
            signal.signal(item, signal.SIG_IGN)
        raise Cancelled('measurement cancelled by signal ' + str(number))
    previous = {number: signal.signal(number, cancel) for number in (signal.SIGTERM, signal.SIGINT)}
    try:
        yield
    finally:
        for number, handler in previous.items():
            signal.signal(number, handler)


def digest(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def remaining(deadline):
    value = min(300, deadline - time.monotonic())
    if value <= 0:
        raise TimeoutError('model campaign deadline exhausted')
    return value


def quality(result):
    if result['completion_tokens'] != 128:
        return False
    values = result['output'].strip().split()
    if values and values[-1] != str(len(values)) and str(len(values)).startswith(values[-1]):
        values.pop()
    return len(values) >= 16 and all(value == str(index) for index, value in enumerate(values, 1))


def campaign_policy(protocol, control_commit, primary):
    if protocol not in PROTOCOLS:
        raise ValueError('protocol must name a measurement protocol settled by the plan')
    table = PROTOCOLS[protocol]
    names = table['case_names']
    primary = table['primary'] if primary is None else primary
    if len(control_commit) != 40 or control_commit.strip('0123456789abcdef'):
        raise ValueError('control commit must be a full lowercase hexadecimal commit')
    model, separator, case = primary.partition(':')
    if not separator or model not in ('qwen2', 'olmoe') or case not in names:
        raise ValueError('primary must be MODEL:CASE naming a measured model and request case')
    return dict(protocol=protocol, control_commit=control_commit,
        primary=dict(model=model, case=case, metric=table['metrics'][0]))


def parse_proc_io(text):
    # Read amplification is the loader hypothesis; keep the raw counters, not a derived claim.
    values = {}
    for line in text.splitlines():
        key, separator, value = line.partition(':')
        if separator and key.strip() in IO_FIELDS:
            values[key.strip()] = int(value.strip())
    if len(values) != len(IO_FIELDS):
        raise ValueError('worker I/O accounting is incomplete')
    return values


def parse_meminfo(text):
    values = {}
    for line in text.splitlines():
        key, separator, value = line.partition(':')
        if separator and key.strip() in MEMINFO_FIELDS:
            parts = value.split()
            if len(parts) != 2 or parts[1] != 'kB':
                raise ValueError('unexpected /proc/meminfo unit')
            values[key.strip()] = int(parts[0])
    if len(values) != len(MEMINFO_FIELDS):
        raise ValueError('/proc/meminfo is incomplete')
    return values


def unescape_mount(field):
    result = bytearray()
    index = 0
    while index < len(field):
        tail = field[index + 1:index + 4]
        if field[index] == '\\' and len(tail) == 3 and all(c in '01234567' for c in tail):
            result.append(int(tail, 8))
            index += 4
        else:
            result.extend(field[index].encode())
            index += 1
    return result.decode('utf-8', 'replace')


def filesystem_type(mounts, path):
    # Startup time depends on the model directory's filesystem; record it, do not infer it.
    best = None
    for line in mounts.splitlines():
        fields = line.split()
        if len(fields) < 3:
            continue
        point = unescape_mount(fields[1])
        if (path == point or path.startswith(point.rstrip('/') + '/')) and (best is None or len(point) > len(best[0])):
            best = (point, unescape_mount(fields[2]))
    if best is None:
        raise ValueError('no mount point covers ' + path)
    return best[1]


def measured_ns(arms):
    total = 0
    for arm in arms:
        total += arm.get('startup_ns', 0)
        total += sum(request.get('client_ns', 0) for request in arm.get('requests', []))
    return total


def reductions(arms, model, case, metric='client_ns', primary=('olmoe', 'warm-long-cached', 'client_ns')):
    # startup_ns is an arm clock and client_ns a request clock; both pair on the same request row.
    def clock(arm, request):
        value = (arm if metric in ARM_METRICS else request).get(metric)
        if type(value) is not int or value <= 0:
            raise ValueError('missing or invalid paired ' + metric + ' clock')
        return value
    result = []
    for pair in range(5):
        selected = [a for a in arms if a['model'] == model and a['pair'] == pair]
        if len(selected) != 2 or {a['arm'] for a in selected} != {'control', 'candidate'}:
            raise ValueError('missing or duplicate paired arm')
        rows = {}
        for arm in selected:
            matching = [r for r in arm['requests'] if r['case'] == case]
            if arm['status'] != 'PASS' or len(matching) != 1 or not matching[0]['quality']:
                raise ValueError('incomplete or failed quality arm')
            rows[arm['arm']] = (arm, matching[0])
        a, b = rows['control'], rows['candidate']
        if any(a[1]['result'][k] != b[1]['result'][k] for k in COUNTS):
            raise ValueError('paired output or token-count mismatch')
        control_clock, candidate_clock = clock(*a), clock(*b)
        result.append((control_clock - candidate_clock) / control_clock)
    median = statistics.median(result)
    selected = (model, case, metric) == tuple(primary)
    passed = median >= .15 and sum(r > 0 for r in result) >= 4 if selected else median >= -.05
    return dict(metric=metric, primary=selected, paired_reductions=result, median_reduction=median, passed=passed)


def identity(source, build):
    record = verify_build(build, True, session=True)
    head = subprocess.check_output(['git', '-C', str(source), 'rev-parse', 'HEAD'], text=True).strip()
    if subprocess.check_output(['git', '-C', str(source), 'status', '--porcelain']):
        raise ValueError('source checkout is dirty')
    if head != record['source_commit'] or source_files(source) != record['source_files']:
        raise ValueError('source checkout differs from build closure')
    return record


def idle_gpu(observation):
    for row in observation.splitlines():
        utilization, _memory, graphics, memory_clock = map(int, row.split(','))
        # The observed Windows display baseline is 5-7% at the 210/405 MHz idle clocks.
        if utilization > 5 and not (utilization <= 10 and graphics <= 300 and memory_clock <= 500):
            return False
    return bool(observation.strip())


def host_observation():
    # Timing is valid only in a coordinated quiet window on this shared WSL host.
    def cpu():
        return list(map(int, Path('/proc/stat').read_text().splitlines()[0].split()[1:9]))
    before = cpu()
    started = time.monotonic()
    time.sleep(2)
    after = cpu()
    elapsed = time.monotonic() - started
    delta = [b - a for a, b in zip(before, after)]
    busy = sum(delta[i] for i in (0, 1, 2, 5, 6, 7)) / os.sysconf('SC_CLK_TCK') / elapsed
    wait = delta[4] / os.sysconf('SC_CLK_TCK') / elapsed
    gpu = subprocess.check_output(['nvidia-smi', '--query-gpu=utilization.gpu,memory.used,clocks.gr,clocks.mem',
        '--format=csv,noheader,nounits'], text=True, timeout=30).strip()
    processes = subprocess.check_output(['nvidia-smi', '--query-compute-apps=pid,process_name',
        '--format=csv,noheader'], text=True, timeout=30).strip()
    return dict(busy_cpu_cores=busy, iowait_cores=wait, gpu=gpu, compute_processes=processes,
        memory=parse_meminfo(Path('/proc/meminfo').read_text()),
        quiet=busy < .5 and wait < .2 and not processes and idle_gpu(gpu))


def settled_host(observe):
    observations = []
    streak = 0
    for _ in range(10):
        row = observe()
        observations.append(row)
        streak = streak + 1 if row['quiet'] else 0
        if streak == 3:
            return dict(row, quiet=True, observations=observations)
    return dict(observations[-1], quiet=False, observations=observations)


def quiet_host():
    # Settling is outside every measured clock and retains all busy observations.
    time.sleep(10)
    return settled_host(host_observation)


def run(args):
    destination = args.output.absolute()
    destination.mkdir(mode=0o700)
    record = dict(schema_version=2, protocol=args.protocol, status='FAIL', arms=[], comparisons=[])
    worker = None
    try:
        # The campaign policy is settled in the plan; the receipt records the exact values used.
        record['policy'] = campaign_policy(args.protocol, args.control_commit, args.primary)
        protocol = PROTOCOLS[record['policy']['protocol']]
        cases = protocol['cases']
        admitted = admit(args.profile.resolve(strict=True))
        profile = admitted.records['profile']
        if len(profile['models']) != 2 or {m['model_id'] for m in profile['models']} != {'qwen2', 'olmoe'} or len(profile['runtime_options']) != 1:
            raise ValueError('campaign requires both models and one resident CUDA option')
        option = {k: v for k, v in profile['runtime_options'][0].items() if k != 'option_id'}
        if option['backend'] != 'cuda' or option['placement'] != 'resident' or option['prefetch'] != 'off':
            raise ValueError('campaign requires resident CUDA without prefetch')
        if option['host_budget_bytes'] < 1073741824 or option['device_budget_bytes'] < 6000000000 or any(m['runtime_cache_budget_bytes'] > 1073741824 for m in profile['models']):
            raise ValueError('campaign budget cannot be admitted')
        option.update(host_budget_bytes=1073741824, device_budget_bytes=6000000000)
        option["backend_bundle"] = str((admitted.root / option["backend_bundle"]).resolve(strict=True))
        builds = {name: getattr(args, name).resolve(strict=True) for name in ('control', 'candidate')}
        sources = {name: getattr(args, name + '_source').resolve(strict=True) for name in builds}
        if sources['candidate'] != ROOT:
            raise ValueError('measurement must execute from its exact candidate source tree')
        identities = {name: identity(sources[name], builds[name]) for name in builds}
        a, b = identities['control'], identities['candidate']
        if a['source_commit'] != record['policy']['control_commit']:
            raise ValueError('control build is not the nominated control commit')
        if any(a[k] != b[k] for k in ('align_revision', 'compiler_sha256', 'bundle_id')) or b['bundle_id'] != admitted.records['bundle']['bundle_id']:
            raise ValueError('campaign compiler or bundle mismatch')
        stable_libs = lambda i: {k: v for k, v in i['libraries'].items() if 'shim' not in k}
        if stable_libs(a) != stable_libs(b):
            raise ValueError('non-shim libraries differ')
        models = {m['model_id']: m for m in profile['models']}
        mounts = Path('/proc/mounts').read_text()
        filesystems = {name: filesystem_type(mounts, str((admitted.root / model['model_path']).resolve(strict=True).parent))
            for name, model in models.items()}
        record['identities'] = dict(builds=identities, filesystems=filesystems, profile_sha256=digest(args.profile),
            inputs={k: v.sha256 for k, v in admitted.files.items()}, options=option,
            tool_sha256=digest(Path(__file__)), plan_sha256=digest(ROOT / 'docs/specs/cuda-optimization-enablement.md'),
            gpu=subprocess.check_output(['nvidia-smi', '--query-gpu=name,uuid,driver_version,memory.total', '--format=csv,noheader'], text=True, timeout=30).strip())
        options_path = destination / 'options.json'
        options_path.write_text(json.dumps(option, separators=(',', ':')) + '\n')
        for model_name in ('qwen2', 'olmoe'):
            deadline = time.monotonic() + 2400
            model = models[model_name]
            for pair in range(5):
                for name in (('control', 'candidate') if pair % 2 == 0 else ('candidate', 'control')):
                    row = dict(model=model_name, pair=pair, arm=name, status='FAIL', requests=[])
                    record['arms'].append(row)
                    work = destination / f'{model_name}-{pair}-{name}'
                    work.mkdir()
                    command = [str(builds[name] / 'main'), '--runtime-session',
                        *(str((admitted.root / model[k]).resolve(strict=True)) for k in ('model_path', 'pack_path', 'geometry_path')),
                        str(options_path), str(model['runtime_cache_budget_bytes'])]
                    row['command'] = command
                    row['host_before'] = quiet_host()
                    if not row['host_before']['quiet']:
                        raise ValueError('shared host is busy before arm; coordinate a quiet window')
                    # Scratch preparation and deadline arithmetic stay outside the readiness clock.
                    env = qualification_environment(work)
                    timeout = remaining(deadline)
                    print(work.name + ': start', flush=True)
                    started = time.monotonic_ns()
                    worker = Session(command, timeout=timeout, env=env)
                    row['startup_ns'] = time.monotonic_ns() - started
                    retained = os.fdopen(os.dup(worker.log.fileno()), 'rb')
                    normal = False
                    try:
                        for case, prompt in cases:
                            worker.timeout = remaining(deadline)
                            before = time.monotonic_ns()
                            result = worker.generate(dict(schema_version=1, system=SYSTEM, user=prompt, max_tokens=128, temperature=0.0, seed=None))
                            elapsed = time.monotonic_ns() - before
                            row['requests'].append(dict(case=case, client_ns=elapsed, worker_ns=result['elapsed_ns'], quality=quality(result), result=result))
                            print(f'{work.name} {case}: {elapsed / 1e9:.3f}s quality={quality(result)}', flush=True)
                        row['worker_io'] = parse_proc_io(Path(f'/proc/{worker.process.pid}/io').read_text())
                        normal = True
                    finally:
                        try:
                            worker.close(check=normal)
                        finally:
                            with retained:
                                retained.seek(0)
                                log = retained.read(16 * 1024 * 1024 + 1)
                            (work / 'worker.log').write_bytes(log[:16 * 1024 * 1024])
                            if len(log) > 16 * 1024 * 1024:
                                raise ValueError('worker log exceeds bound')
                    row['host_after'] = quiet_host()
                    if not row['host_after']['quiet']:
                        raise ValueError('shared host is busy after arm; timing is invalid')
                    row['status'] = 'PASS'
                    (destination / 'result.json').write_text(json.dumps(record, indent=2) + '\n')
                    budget = protocol['measured_budget_ns']
                    if budget is not None and measured_ns(record['arms']) > budget:
                        raise ValueError('measured clocks exceed the protocol budget')
            primary = record['policy']['primary']
            for metric in protocol['metrics']:
                for case, _ in cases:
                    record['comparisons'].append(dict(model=model_name, case=case, **reductions(record['arms'], model_name,
                        case, metric, primary=(primary['model'], primary['case'], primary['metric']))))
        admitted.recheck()
        if digest(Path(__file__)) != record['identities']['tool_sha256'] or digest(ROOT / 'docs/specs/cuda-optimization-enablement.md') != record['identities']['plan_sha256']:
            raise ValueError('measurement tool or plan changed during campaign')
        if {name: identity(sources[name], builds[name]) for name in builds} != identities:
            raise ValueError('build identity changed during campaign')
        if not all(row['passed'] for row in record['comparisons']):
            raise ValueError('performance floor or guardrail not met')
        record['status'] = 'PASS'
    except Exception as error:
        record['error'] = str(error)
        print('FAIL: ' + str(error), flush=True)
    finally:
        # Covers failures between successful construction and the per-arm cleanup scope.
        if worker is not None:
            try:
                worker.close(check=False)
            except Exception as error:
                record['status'] = 'FAIL'
                record['error'] = 'worker cleanup failed: ' + str(error)
        (destination / 'result.json').write_text(json.dumps(record, indent=2) + '\n')
    return 0 if record['status'] == 'PASS' else 1


def cancellation_test(*, construction=False, shutdown=False, protocol='request'):
    with tempfile.TemporaryDirectory(prefix='cuda-measure-cancel-') as temporary:
        work = Path(temporary)
        (work / 'profile.json').write_text('{}')
        worker_code = ("import os,struct,time\nfrom pathlib import Path\n"
            "import sys\nraw=b'{\"schema_version\":1,\"status\":\"ready\"}'\n"
            "sys.stdout.buffer.write(struct.pack('<I',len(raw))+raw);sys.stdout.buffer.flush()\n"
            + "Path(" + repr(str(work / 'worker.pid')) + ").write_text(str(os.getpid()))\n"
            + "time.sleep(60)\n")
        (work / 'main').write_text('#!' + sys.executable + '\n' + worker_code)
        (work / 'main').chmod(0o700)
        child_code = r"""
import sys, importlib.util
from importlib.machinery import SourceFileLoader
from pathlib import Path
from types import SimpleNamespace
sys.path.insert(0,sys.argv[1])
loader=SourceFileLoader('measured',str(Path(sys.argv[1])/'measure-cuda-optimization'))
spec=importlib.util.spec_from_loader(loader.name,loader)
m=importlib.util.module_from_spec(spec);loader.exec_module(m)
w=Path(sys.argv[2]); source=m.ROOT
models=[dict(model_id=name, model_path='profile.json', pack_path='profile.json',
 geometry_path='profile.json', runtime_cache_budget_bytes=0) for name in ('qwen2','olmoe')]
option=dict(backend='cuda',placement='resident',prefetch='off',backend_bundle='profile.json',
 host_budget_bytes=1073741824,device_budget_bytes=6000000000)
admitted=SimpleNamespace(root=w, files={}, recheck=lambda:None, records=dict(
 profile=dict(models=models,runtime_options=[option]), bundle=dict(bundle_id='fixture')))
m.admit=lambda path:admitted
nominated='0457a7d4d4645bb733b4cbf96126c5d79c4da31d'
m.identity=lambda source,build:dict(source_commit=nominated,align_revision='pin',
 compiler_sha256='compiler',bundle_id='fixture',libraries={})
m.quiet_host=lambda:dict(quiet=True)
if sys.argv[3]=='construction':
 def fail_dup(fd): raise m.Cancelled('measurement cancelled by signal at log ownership')
 m.os.dup=fail_dup
m.subprocess.check_output=lambda *a,**k:'fixture GPU'
args=SimpleNamespace(output=w/'result',profile=w/'profile.json',control=w,candidate=w,
 control_source=source,candidate_source=source,control_commit=nominated,
 protocol=sys.argv[4],primary=None)
bad=SimpleNamespace(**vars(args)); bad.candidate_source=w; bad.output=w/'wrong-source'
assert m.run(bad)==1
assert 'exact candidate source tree' in m.json.loads((bad.output/'result.json').read_text())['error']
# The nominated control is per campaign: the shipped default must be refused here.
stale=SimpleNamespace(**vars(args)); stale.control_commit=m.CONTROL; stale.output=w/'wrong-control'
assert m.run(stale)==1
stale_record=m.json.loads((stale.output/'result.json').read_text())
assert 'nominated control commit' in stale_record['error']
assert stale_record['policy']['control_commit']==m.CONTROL
bogus=SimpleNamespace(**vars(args)); bogus.primary='olmoe:nonexistent'; bogus.output=w/'wrong-primary'
assert m.run(bogus)==1
bogus_record=m.json.loads((bogus.output/'result.json').read_text())
assert 'MODEL:CASE' in bogus_record['error']
# Schema 2 names the protocol even when the policy itself is refused.
assert bogus_record['schema_version']==2 and bogus_record['protocol']==sys.argv[4]
unknown=SimpleNamespace(**vars(args)); unknown.protocol='no-such-protocol'; unknown.output=w/'wrong-protocol'
assert m.run(unknown)==1
assert 'settled by the plan' in m.json.loads((unknown.output/'result.json').read_text())['error']
assert not (w/'worker.pid').exists()
if sys.argv[3]=='shutdown':
 for table in m.PROTOCOLS.values(): table['cases']=[]
 original_wait=m.subprocess.Popen.wait
 def observed_wait(process, *a, **k):
  (w/'shutdown.wait').write_text(str(process.pid))
  return original_wait(process,*a,**k)
 m.subprocess.Popen.wait=observed_wait
with m.cancellation_scope():
 raise SystemExit(m.run(args))
"""
        child = subprocess.Popen([sys.executable, '-c', child_code, str(ROOT / 'scripts'), str(work),
            'construction' if construction else 'shutdown' if shutdown else 'plain', protocol],
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, start_new_session=True)
        pid = None
        try:
            deadline = time.monotonic() + 15
            while not (work / 'worker.pid').exists():
                if child.poll() is not None or time.monotonic() >= deadline:
                    raise AssertionError('cancellation fixture did not start: ' + child.communicate(timeout=2)[1].decode())
                time.sleep(.02)
            pid = int((work / 'worker.pid').read_text())
            if shutdown:
                while not (work / 'shutdown.wait').exists():
                    if child.poll() is not None or time.monotonic() >= deadline:
                        raise AssertionError('worker never entered shutdown wait')
                    time.sleep(.02)
            if not construction:
                child.send_signal(signal.SIGTERM)
            _, error = child.communicate(timeout=25)
            assert child.returncode == 1, error.decode()
            record = json.loads((work / 'result/result.json').read_text())
            assert record['status'] == 'FAIL' and 'cancelled by signal' in record['error']
            assert record['arms'][0]['status'] == 'FAIL'
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                pass
            else:
                raise AssertionError('cancelled measurement left a worker alive')
        finally:
            if child.poll() is None:
                os.killpg(child.pid, signal.SIGKILL)
                child.communicate(timeout=5)
            if pid is not None:
                try:
                    os.killpg(pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass


def self_test():
    assert idle_gpu('7, 1516, 210, 405') and idle_gpu('0, 1516, 2790, 10501')
    assert not idle_gpu('7, 1516, 2790, 10501') and not idle_gpu('80, 1516, 210, 405')
    ready = settled_host(lambda: dict(quiet=True))
    assert ready['quiet'] and len(ready['observations']) == 3
    transient = iter([True, True, False, True, True, True])
    ready = settled_host(lambda: dict(quiet=next(transient)))
    assert ready['quiet'] and len(ready['observations']) == 6
    busy = settled_host(lambda: dict(quiet=False))
    assert not busy['quiet'] and len(busy['observations']) == 10
    result = dict(output=' '.join(map(str, range(1, 40))), prompt_tokens=42, completion_tokens=128, total_tokens=170, token_count_exact=True)
    assert quality(result) and not quality(dict(result, output='wrong'))
    arms = [dict(model='olmoe', pair=i, arm=name, status='PASS', requests=[dict(case='warm-long-cached', client_ns=100 if name == 'control' else 80, quality=True, result=dict(result))]) for i in range(5) for name in ('control', 'candidate')]
    assert reductions(arms, 'olmoe', 'warm-long-cached')['passed']
    arms[-1]['requests'][0]['client_ns'] = 200
    arms[-3]['requests'][0]['client_ns'] = 200
    assert not reductions(arms, 'olmoe', 'warm-long-cached')['passed']
    qwen = [dict(model='qwen2', pair=i, arm=name, status='PASS', requests=[dict(case='warm-long-cached',
        client_ns=100 if name == 'control' else 80, quality=True, result=dict(result))]) for i in range(5) for name in ('control', 'candidate')]
    selected = reductions(qwen, 'qwen2', 'warm-long-cached', primary=('qwen2', 'warm-long-cached', 'client_ns'))
    assert selected['primary'] and selected['passed'] and not reductions(qwen, 'qwen2', 'warm-long-cached')['primary']
    qwen[-1]['requests'][0]['client_ns'] = 200
    qwen[-3]['requests'][0]['client_ns'] = 200
    # Three of five faster fails the selected primary and still clears the same row as a guardrail.
    assert not reductions(qwen, 'qwen2', 'warm-long-cached', primary=('qwen2', 'warm-long-cached', 'client_ns'))['passed']
    assert reductions(qwen, 'qwen2', 'warm-long-cached')['passed']
    startup = [dict(model='olmoe', pair=i, arm=name, status='PASS', startup_ns=100 if name == 'control' else 80,
        requests=[dict(case='cold-short', client_ns=100, quality=True, result=dict(result))])
        for i in range(5) for name in ('control', 'candidate')]
    assert all(t['case_names'] == tuple(c for c, _ in t['cases']) for t in PROTOCOLS.values())
    target = ('olmoe', 'cold-short', 'startup_ns')
    row = reductions(startup, 'olmoe', 'cold-short', 'startup_ns', primary=target)
    assert row['primary'] and row['passed'] and row['metric'] == 'startup_ns'
    # The same model/case on the guardrail metric is never the primary row of a startup campaign.
    guard = reductions(startup, 'olmoe', 'cold-short', 'client_ns', primary=target)
    assert not guard['primary'] and guard['passed'] and guard['median_reduction'] == 0
    startup[-1]['startup_ns'] = 200
    startup[-3]['startup_ns'] = 200
    assert not reductions(startup, 'olmoe', 'cold-short', 'startup_ns', primary=target)['passed']
    assert reductions(startup, 'olmoe', 'cold-short', 'startup_ns')['passed']
    for missing in ('startup_ns', 'client_ns'):
        absent = json.loads(json.dumps(startup))
        (absent[0] if missing == 'startup_ns' else absent[0]['requests'][0]).pop(missing)
        try:
            reductions(absent, 'olmoe', 'cold-short', missing, primary=target)
        except ValueError:
            pass
        else:
            raise AssertionError('missing paired clock accepted')
    assert measured_ns(startup) == sum(a['startup_ns'] for a in startup) + 1000
    assert measured_ns([dict(requests=[]), dict(startup_ns=7, requests=[dict(client_ns=3)])]) == 10
    assert parse_proc_io('rchar: 12\nwchar: 5\nsyscr: 3\nread_bytes: 4096\nwrite_bytes: 0\n') == dict(rchar=12, read_bytes=4096)
    assert parse_meminfo('MemTotal:  65799856 kB\nMemFree: 37055868 kB\nMemAvailable: 63585416 kB\n'
        'Buffers: 74056 kB\nCached: 26915484 kB\nSwapCached: 0 kB\n') == dict(
        MemTotal=65799856, MemAvailable=63585416, Cached=26915484, Buffers=74056)
    for broken in ('rchar: 12\n', 'MemTotal: 1 kB\n'):
        for parser in (parse_proc_io, parse_meminfo):
            try:
                parser(broken)
            except ValueError:
                pass
            else:
                raise AssertionError('incomplete /proc text accepted')
    try:
        parse_meminfo('MemTotal: 1\nMemAvailable: 1 kB\nCached: 1 kB\nBuffers: 1 kB\n')
    except ValueError:
        pass
    else:
        raise AssertionError('/proc/meminfo without its unit accepted')
    mounts = ('/dev/sdc / ext4 rw 0 0\nnone /mnt/wsl tmpfs rw 0 0\n'
        'C:\\134 /mnt/c 9p rw 0 0\n/dev/sdd /home/hiro/models\\040cache ext4 rw 0 0\n')
    assert filesystem_type(mounts, '/home/hiro/.cache/align-llm/cuda-kit/inputs') == 'ext4'
    assert filesystem_type(mounts, '/mnt/c/models') == '9p' and filesystem_type(mounts, '/mnt/wsl') == 'tmpfs'
    assert filesystem_type(mounts, '/home/hiro/models cache/inputs') == 'ext4'
    assert filesystem_type(Path('/proc/mounts').read_text(), str(ROOT))
    try:
        filesystem_type('none /mnt/wsl tmpfs rw 0 0\n', '/home/hiro')
    except ValueError:
        pass
    else:
        raise AssertionError('uncovered path accepted')
    assert campaign_policy('request', '0457a7d4d4645bb733b4cbf96126c5d79c4da31d', 'qwen2:warm-long-cached') == dict(
        protocol='request', control_commit='0457a7d4d4645bb733b4cbf96126c5d79c4da31d',
        primary=dict(model='qwen2', case='warm-long-cached', metric='client_ns'))
    assert campaign_policy('request', CONTROL, 'olmoe:warm-long-cached')['primary'] == dict(
        model='olmoe', case='warm-long-cached', metric='client_ns')
    # Each protocol resolves its own settled default primary row and metric.
    assert campaign_policy('request', CONTROL, None)['primary'] == dict(model='olmoe', case='warm-long-cached', metric='client_ns')
    assert campaign_policy('startup', CONTROL, None)['primary'] == dict(model='olmoe', case='cold-short', metric='startup_ns')
    assert campaign_policy('startup', CONTROL, 'qwen2:cold-short')['primary']['model'] == 'qwen2'
    for invalid in (('request', '0457a7d', 'qwen2:warm-long-cached'), ('request', CONTROL.upper(), 'qwen2:warm-long-cached'),
            ('request', 'z' * 40, 'qwen2:warm-long-cached'), ('request', CONTROL, 'qwen2'),
            ('request', CONTROL, 'llama:warm-long-cached'), ('request', CONTROL, 'qwen2:no-such-case'),
            ('request', CONTROL, ':warm-long-cached'), ('no-such-protocol', CONTROL, 'qwen2:warm-long-cached'),
            ('startup', CONTROL, 'qwen2:warm-long-cached'), ('startup', CONTROL, 'olmoe:warm-long-changed')):
        try:
            campaign_policy(*invalid)
        except ValueError:
            pass
        else:
            raise AssertionError('invalid campaign policy accepted')
    for bad in (arms[:-1], json.loads(json.dumps(arms))):
        if len(bad) == 10:
            bad[-1]['requests'][0]['result']['output'] = 'different'
        try:
            reductions(bad, 'olmoe', 'warm-long-cached')
        except ValueError:
            pass
        else:
            raise AssertionError('invalid evidence accepted')
    cancellation_test()
    cancellation_test(construction=True)
    cancellation_test(shutdown=True)
    cancellation_test(protocol='startup')
    print('CUDA measurement self-test PASS (protocol policy, paired decisions, /proc parsers and SIGTERM worker cleanup)')


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--self-test', action='store_true')
    for name in ('profile', 'control-source', 'control', 'candidate-source', 'candidate', 'output'):
        parser.add_argument('--' + name, type=Path)
    parser.add_argument('--protocol', choices=sorted(PROTOCOLS), default='request')
    parser.add_argument('--control-commit', default=CONTROL)
    parser.add_argument('--primary', default=None)
    args = parser.parse_args()
    if args.self_test:
        self_test()
    else:
        if any(getattr(args, name) is None for name in ('profile', 'control_source', 'control', 'candidate_source', 'candidate', 'output')):
            parser.error('all campaign operands are required')
        with cancellation_scope():
            raise SystemExit(run(args))
