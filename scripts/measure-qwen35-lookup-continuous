#!/usr/bin/env python3
"""Measure complete Qwen3.5 lookup-trial requests against the normal Align path."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import statistics
import subprocess
import tempfile
import time


ROOT = Path(__file__).resolve().parent.parent
EXECUTION_ENV = (
    "ALIGN_LLM_NATIVE_STATE_COPY", "ALIGN_LLM_NATIVE_CONV_COPY",
    "ALIGN_LLM_NATIVE_SWIGLU",
    "ALIGN_LLM_NATIVE_PREFILL_STATE_COPY", "ALIGN_LLM_NATIVE_COPY_GREEDY",
    "ALIGN_LLM_SHARED_LOGITS", "ALIGN_LLM_NEON_GREEDY", "ALIGN_LLM_GRAPH_GREEDY",
    "ALIGN_LLM_PREFILL_CHUNK", "ALIGN_LLM_PREFILL_FINAL_LOGITS",
    "ALIGN_LLM_PREFILL_LAST_FFN_ROW", "ALIGN_LLM_MAPPED_WEIGHTS",
)


def digest(path: Path) -> str:
    with path.open("rb") as source:
        return hashlib.file_digest(source, "sha256").hexdigest()


def one_request(args: argparse.Namespace, env: dict[str, str], work: Path,
                case: dict, arm: str) -> dict:
    prompt_path = work / "prompt.json"
    eog_path = work / "eog.json"
    prompt_path.write_text(json.dumps(case["prompt_token_ids"]) + "\n")
    eog_path.write_text(json.dumps([args.eog_token_id]) + "\n")
    command = [str(args.binary), str(args.gguf), str(args.pack), str(args.geometry),
               str(args.options), str(prompt_path), str(eog_path),
               str(len(case["greedy_token_ids"])), arm, "1"]
    started = time.perf_counter_ns()
    result = subprocess.run(command, cwd=ROOT, env=env, capture_output=True,
                            text=True, timeout=args.timeout_seconds, check=False)
    wall_ns = time.perf_counter_ns() - started
    if result.returncode:
        raise RuntimeError(f"{case['name']} {arm} failed ({result.returncode}): "
                           f"{result.stderr[-2500:]}")
    parsed = json.loads(result.stdout)
    if not isinstance(parsed, list) or len(parsed) != 1 or not isinstance(parsed[0], dict):
        raise ValueError("Align receipt must contain exactly one request")
    receipt = parsed[0]
    expected = case["greedy_token_ids"]
    if receipt.get("token_ids") != expected:
        actual = receipt.get("token_ids")
        mismatch = next((i for i, (a, b) in enumerate(zip(actual, expected)) if a != b),
                        min(len(actual), len(expected))) if isinstance(actual, list) else -1
        raise ValueError(f"{case['name']} {arm} differs from pinned greedy stream "
                         f"at output index {mismatch}")
    elapsed_ns = receipt.get("elapsed_ns")
    if type(elapsed_ns) is not int or elapsed_ns <= 0 or elapsed_ns > wall_ns:
        raise ValueError("invalid complete-generation timing")
    for field in ("lookup_attempts", "draft_hits", "verify_groups", "complete_groups",
                  "discarded_groups", "generated_drafts", "prefill_ns",
                  "serial_decode_ns", "lookup_ns", "graph_build_ns",
                  "target_compute_ns", "target_readback_ns"):
        if type(receipt.get(field)) is not int or receipt[field] < 0:
            raise ValueError(f"invalid Align trial counter {field}")
    if arm == "normal" and any(receipt[field] for field in
                               ("lookup_attempts", "draft_hits", "verify_groups",
                                "complete_groups", "discarded_groups", "generated_drafts",
                                "prefill_ns", "serial_decode_ns")):
        raise ValueError("normal path emitted trial counters")
    draft_count = 1 if arm == "trial1" else 3
    if arm in ("trial", "trial1") and (receipt["discarded_groups"] > 1
                           or receipt["verify_groups"] != receipt["complete_groups"]
                           + receipt["discarded_groups"]
                           or receipt["generated_drafts"] != draft_count * receipt["complete_groups"]
                           or receipt["prefill_ns"] <= 0
                           or receipt["prefill_ns"] + receipt["serial_decode_ns"]
                           > elapsed_ns):
        raise ValueError("trial state counters violate one-strike contract")
    return {"wall_ns": wall_ns, "generation_ns": elapsed_ns,
            "startup_load_ns": wall_ns - elapsed_ns,
            "generated_tokens": len(expected),
            "stats": {field: receipt[field] for field in (
                "lookup_attempts", "draft_hits", "verify_groups", "complete_groups",
                "discarded_groups", "generated_drafts", "prefill_ns",
                "serial_decode_ns", "lookup_ns", "graph_build_ns",
                "target_compute_ns", "target_readback_ns")}}


def one_reference(args: argparse.Namespace, env: dict[str, str], work: Path,
                  case: dict) -> dict:
    prompt_path = work / "prompt.json"
    expected_path = work / "expected.json"
    prompt_path.write_text(json.dumps(case["prompt_token_ids"]) + "\n")
    expected_path.write_text(json.dumps(case["greedy_token_ids"]) + "\n")
    started = time.perf_counter_ns()
    reference_env = dict(env)
    reference_env.pop("DYLD_LIBRARY_PATH", None)
    result = subprocess.run([str(args.reference_binary), str(args.gguf),
                             str(prompt_path), str(expected_path)],
                            cwd=ROOT, env=reference_env, capture_output=True,
                            text=True, timeout=args.timeout_seconds, check=False)
    wall_ns = time.perf_counter_ns() - started
    if result.returncode:
        raise RuntimeError(f"{case['name']} pinned llama.cpp failed "
                           f"({result.returncode}): {result.stderr[-2500:]}")
    receipt = json.loads(result.stdout)
    for field in ("startup_load_ns", "generation_ns", "prefill_ns", "decode_ns"):
        if type(receipt.get(field)) is not int or receipt[field] < 0:
            raise ValueError(f"invalid pinned llama.cpp {field}")
    if (receipt["generation_ns"] <= 0 or receipt["generation_ns"] > wall_ns
            or receipt["prefill_ns"] + receipt["decode_ns"] != receipt["generation_ns"]
            or receipt.get("prompt_tokens") != len(case["prompt_token_ids"])
            or receipt.get("generated_tokens") != len(case["greedy_token_ids"])):
        raise ValueError("pinned llama.cpp workload or timing mismatch")
    return dict(receipt, wall_ns=wall_ns)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ("fixture", "binary", "gguf", "pack", "geometry", "options",
                 "output"):
        parser.add_argument(f"--{name}", required=True, type=Path)
    parser.add_argument("--library-path", required=True)
    parser.add_argument("--reference-binary", type=Path)
    parser.add_argument("--reference-only", action="store_true")
    parser.add_argument("--pairs", type=int, default=5)
    parser.add_argument("--timeout-seconds", type=int, default=300)
    args = parser.parse_args()
    if not 1 <= args.pairs <= 20 or not 30 <= args.timeout_seconds <= 1200:
        parser.error("--pairs must be 1..20 and --timeout-seconds must be 30..1200")
    for name in ("fixture", "binary", "gguf", "pack", "geometry", "options"):
        value = getattr(args, name).resolve()
        if not value.is_file():
            parser.error(f"--{name} must name a file")
        setattr(args, name, value)
    if args.reference_only and args.reference_binary is None:
        parser.error("--reference-only requires --reference-binary")
    if args.reference_binary is not None:
        args.reference_binary = args.reference_binary.resolve()
        if not args.reference_binary.is_file():
            parser.error("--reference-binary must name a file")
    fixture = json.loads(args.fixture.read_text())
    if fixture.get("schema_version") != 1 or len(fixture.get("cases", [])) != 3 \
            or fixture.get("gguf_sha256") != digest(args.gguf):
        raise ValueError("fixture or GGUF identity differs from the pinned corpus")
    args.eog_token_id = fixture.get("eog_token_id")
    if type(args.eog_token_id) is not int or args.eog_token_id < 0:
        raise ValueError("invalid fixture EOG token")
    for case in fixture["cases"]:
        if not case.get("prompt_token_ids") or not case.get("greedy_token_ids"):
            raise ValueError("empty fixture case")
    env = dict(os.environ, DYLD_LIBRARY_PATH=args.library_path)
    measured = {"schema_version": 1,
                "gguf_sha256": fixture["gguf_sha256"],
                "pack_sha256": digest(args.pack),
                "fixture_sha256": digest(args.fixture),
                "binary_sha256": digest(args.binary),
                "reference_binary_sha256": digest(args.reference_binary)
                if args.reference_binary is not None else None,
                "geometry_sha256": digest(args.geometry),
                "options_sha256": digest(args.options),
                "execution_env": {name: env.get(name) for name in EXECUTION_ENV},
                "pairs_requested": args.pairs,
                "cases": []}
    with tempfile.TemporaryDirectory(prefix="qwen35-lookup-continuous-") as temporary:
        work = Path(temporary)
        for case in fixture["cases"]:
            row = {"name": case["name"], "prompt_tokens": len(case["prompt_token_ids"]),
                   "expected_tokens": len(case["greedy_token_ids"])}
            if not args.reference_only:
                # Prime each arm without using those requests as measurements.
                one_request(args, env, work, case, "normal")
                one_request(args, env, work, case, "trial")
                row["pairs"] = []
                for pair in range(args.pairs):
                    order = ("normal", "trial") if pair % 2 == 0 else ("trial", "normal")
                    sample = {"order": list(order)}
                    for arm in order:
                        sample[arm] = one_request(args, env, work, case, arm)
                    row["pairs"].append(sample)
                    print(f"{case['name']} pair {pair + 1}/{args.pairs}: "
                          f"normal {sample['normal']['generation_ns'] / 1e6:.3f} ms, "
                          f"trial {sample['trial']['generation_ns'] / 1e6:.3f} ms", flush=True)
                deltas = [(pair["normal"]["generation_ns"] - pair["trial"]["generation_ns"])
                          / 1e6 for pair in row["pairs"]]
                row["paired_normal_minus_trial_median_ms"] = statistics.median(deltas)
                row["trial_wins"] = sum(delta > 0 for delta in deltas)
            if args.reference_binary is not None:
                one_request(args, env, work, case, "trial")
                one_reference(args, env, work, case)
                row["reference_pairs"] = []
                for pair in range(args.pairs):
                    order = ("trial", "reference") if pair % 2 == 0 else ("reference", "trial")
                    sample = {"order": list(order)}
                    for arm in order:
                        sample[arm] = (one_request(args, env, work, case, "trial")
                                       if arm == "trial" else one_reference(args, env, work, case))
                    row["reference_pairs"].append(sample)
                    print(f"{case['name']} reference pair {pair + 1}/{args.pairs}: "
                          f"trial {sample['trial']['generation_ns'] / 1e6:.3f} ms, "
                          f"llama {sample['reference']['generation_ns'] / 1e6:.3f} ms", flush=True)
                deltas = [(pair["reference"]["generation_ns"]
                           - pair["trial"]["generation_ns"]) / 1e6
                          for pair in row["reference_pairs"]]
                row["paired_reference_minus_trial_median_ms"] = statistics.median(deltas)
                row["trial_reference_wins"] = sum(delta > 0 for delta in deltas)
            measured["cases"].append(row)
    args.output.parent.mkdir(parents=True, exist_ok=True)
    temporary_output = args.output.with_name(args.output.name + ".tmp")
    temporary_output.write_text(json.dumps(measured, indent=2) + "\n")
    temporary_output.replace(args.output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
