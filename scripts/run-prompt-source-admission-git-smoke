#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
compiler="${ALIGNC:-${project_root}/scripts/alignc}"
scratch="$(mktemp -d)"
scratch="$(cd "${scratch}" && pwd -P)"
complete=0
owner_pid=""
cleanup() { status=$?; if [[ -n "$owner_pid" ]]; then kill -TERM "$owner_pid" 2>/dev/null || true; wait "$owner_pid" || true; fi; if [[ "$complete" == 1 ]]; then rm -rf "$scratch"; else printf 'source admission Git fixture preserved: %s\n' "$scratch" >&2; fi; exit "$status"; }
trap cleanup EXIT
mkdir "${scratch}/image" "${scratch}/project"
cp "$(command -v git)" "${scratch}/image/git"
sha() { shasum -a 256 | cut -d ' ' -f 1; }
image_hash="$(sha < "${scratch}/image/git")"
"${compiler}" check-per-unit "${project_root}/src/prompt_source_admission_git_smoke.align"
(cd "${scratch}" && "${compiler}" build "${project_root}/src/prompt_source_admission_git_smoke.align")
owner="${scratch}/prompt_source_admission_git_smoke"
if [[ "$(uname -s)" != Linux ]]; then "${owner}" Darwin "${scratch}/image" "${image_hash}" - - - - - -; complete=1; exit; fi
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
export GIT_AUTHOR_NAME=fixture GIT_AUTHOR_EMAIL=fixture@example.invalid GIT_COMMITTER_NAME=fixture GIT_COMMITTER_EMAIL=fixture@example.invalid
printf abc > "${scratch}/project/a"
printf '{}' > "${scratch}/project/two"
chmod 644 "${scratch}/project/"*
first="$(sha < "${scratch}/project/a")"
last="$(sha < "${scratch}/project/two")"
invoke() { "$owner" Linux "$scratch/image" "$image_hash" "$scratch/project" "$repo" "$1" "$first" "$last" "$2"; }
for format in sha1 sha256; do
  repo="${scratch}/${format}"
  git init -q --initial-branch=main --object-format="${format}" "${repo}"
  cp "${scratch}/project/a" "${repo}/a"
  git -C "${repo}" add a
  git -C "${repo}" commit -qm first
  previous="$(git -C "${repo}" rev-parse HEAD)"
  cp "${scratch}/project/two" "${repo}/two"
  git -C "${repo}" add two
  git -C "${repo}" commit -qm second
  revision="$(git -C "${repo}" rev-parse HEAD)"
  invoke "$revision" ready
  invoke "$previous" invalid
  invoke "$revision" empty
  invoke "$revision" pre-cancel-empty
  invoke "$revision" expired
  invoke BAD invalid
  git -C "${repo}" worktree add -q -b linked "${repo}-linked"
  ordinary="$repo"
  repo="${repo}-linked"
  invoke "$revision" ready
  repo="$ordinary"
done
cat > "${scratch}/backend.c" <<'C'
#include <stdio.h>
#include <string.h>
#include <unistd.h>
int main(void) {
  char mode[32]={0}; FILE *input=fopen(".git/admission-case","r");
  if(!input)return 8;
  fgets(mode,sizeof(mode),input); fclose(input);
  if(!strcmp(mode,"stopped"))return 7;
  FILE *ready=fopen(".git/admission-ready","w"); if(ready)fclose(ready);
  sleep(20); return 0;
}
C
cc "${scratch}/backend.c" -o "${scratch}/image/git"
image_hash="$(sha < "${scratch}/image/git")"
for mode in stopped timeout; do
  printf %s "$mode" > "$repo/.git/admission-case"
  invoke "$revision" "$mode"
done
printf cancel > "$repo/.git/admission-case"
rm -f "$repo/.git/admission-ready"
"$owner" Linux "$scratch/image" "$image_hash" "$scratch/project" "$repo" "$revision" "$first" "$last" cancel &
owner_pid=$!
for attempt in $(seq 1 200); do if [[ -e "$repo/.git/admission-ready" ]]; then break; fi; sleep 0.01; done
test -e "$repo/.git/admission-ready"
kill -TERM "$owner_pid"
wait "$owner_pid"
owner_pid=""
complete=1
printf 'source admission Git: 17 complete-set and transport cases PASS\n'
