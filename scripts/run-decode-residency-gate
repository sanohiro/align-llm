#!/usr/bin/env bash
set -euo pipefail

# R3-DECODE-RESIDENCY: the decode half of roadmap section R3's question —
# 対象ハードウェア条件で、baselineより有効なpolicyを特定できること — asked of a demand stream that
# contains real generated tokens rather than of prefill replayed in decode order.
#
# `docs/specs/r3-residency-sim.md` section 4.5 and its section 5.2 are explicit about the limit of
# the recorded R3 result: every trace it replayed was one prefill graph, printed over six of the
# eight router slots, and the document says so rather than claiming a decode measurement. R2c's
# patched instrument removed both limits and `scripts/run-decode-locality-gate` is its first
# consumer; this runner is the residency consumer of the same capture.
#
# It captures one prompt-plus-decode transcript per prompt from the same checked-in corpus with the
# same contractual flags `scripts/run-decode-locality-gate` established, derives one
# `R2_ACTIVATION_TRACE` per transcript with `main --expert-trace`, deletes the transcript, admits
# the corpus with R2D's `require_full_router_axes`, and runs `main --simulate-residency` three
# times over one capture:
#
#   mixed         every admitted graph — the prompt's prefill graph and its decode graphs — pooled
#                 into one continuing stream, which is what a session of short requests looks like
#   decode-only   the same documents with graph 0 projected away and every remaining graph ordinal
#                 left as captured, so the stream is generated tokens and nothing else
#   prefill-only  the same documents with every decode graph projected away, so the stream is
#                 prompt tokens and nothing else — at the same full eight-slot router axis
#
# The third arm exists to separate the two things R2c changed at once. Against the prefill-only,
# six-of-eight-slot stream `docs/specs/r3-residency-sim.md` section 7.4 recorded, the mixed and
# decode-only arms differ in *both* coverage and phase, so a verdict that moved could be caused by
# either. The prefill-only arm holds corpus, budget, admission rule, and slot axis fixed and removes
# only the decode graphs: if it agrees with the other two, the movement is a coverage effect and the
# section must not attribute it to decode.
#
# Each list is a *projection for the simulator*, not a re-derived R2A document: exactly the two
# arrays `main --simulate-residency` reads — `graphs` and `selections` — are filtered, and every
# other block (`input`, `graph`, `locality`) still describes the whole captured transcript.
# Keeping the ordinals is the point of the projection. Renumbering them would turn the first decode
# graph into a `single_token_first_graph`, which is `docs/specs/r2a-expert-trace.md` section 2.5.6's
# name for "the transcript cannot tell a one-token prompt from a decode step", and the arm would
# then be measuring a phase it does not have. The projections live in
# `scripts/residency_projection.py` so that `scripts/run-residency-sim-smoke` exercises the same
# implementation against its independent oracle rather than a second copy of it.
#
#   ALIGN_LLM_GGUF_MODEL             path to a MoE model.         NO DEFAULT - absent is N/A, exit 0
#   ALIGN_LLM_LLAMA_EVAL_CALLBACK    path to the PATCHED instrument
#                                    (scripts/llama-eval-callback-toolchain ensure instrument).
#                                    NO DEFAULT - absent is N/A, exit 0
#   ALIGN_LLM_LOCALITY_PROMPTS       prompt corpus (default eval/prompts/expert-locality-v1.txt);
#                                    named and missing is exit 1, never N/A
#   ALIGN_LLM_LOCALITY_PROMPT_COUNT  prompts to use, from the top of the corpus (default 40)
#   ALIGN_LLM_DECODE_STEPS           generated tokens per prompt (default 16)
#   ALIGN_LLM_RESIDENCY_BUDGET       the BUDGET_BYTES operand, a positive decimal integer; default
#                                    25 per cent of the model's expert byte footprint, which is the
#                                    point R3 recorded
#
# Opt-in, never in an aggregate, never in CI, and no `Makefile` target — the same standing
# `scripts/run-decode-locality-gate`, `scripts/run-expert-locality-gate`, and
# `scripts/run-r2c-instrument-qualification` have, because R2c's fetched measurement dependency
# cannot execute in CI. A missing or unusable subject prints one exact N/A line and exits 0 without
# claiming a measurement.
#
# The gate is a measurement, not a pass/fail owner test. It exits 0 on every `verdict.result` of
# every arm — `BEATS_BASELINE`, `NO_POLICY_BEATS_BASELINE`, and `NO_HEADROOM` are all answers to the
# roadmap question — and exits nonzero only when the instrument, the corpus, or a parser prevented a
# measurement from being taken at all.

unset GIT_DIR GIT_COMMON_DIR GIT_WORK_TREE
export PYTHONDONTWRITEBYTECODE=1

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
instrument="${ALIGN_LLM_LLAMA_EVAL_CALLBACK:-}"
model="${ALIGN_LLM_GGUF_MODEL:-}"
prompts="${ALIGN_LLM_LOCALITY_PROMPTS:-$root_dir/eval/prompts/expert-locality-v1.txt}"
prompt_count="${ALIGN_LLM_LOCALITY_PROMPT_COUNT:-40}"
decode_steps="${ALIGN_LLM_DECODE_STEPS:-16}"

if [ -z "$instrument" ]; then
  printf '%s\n' "decode residency gate: N/A (ALIGN_LLM_LLAMA_EVAL_CALLBACK unset)"
  exit 0
fi
if [ ! -x "$instrument" ]; then
  printf '%s\n' "decode residency gate: N/A (ALIGN_LLM_LLAMA_EVAL_CALLBACK is not executable)"
  exit 0
fi
if [ -z "$model" ]; then
  printf '%s\n' "decode residency gate: N/A (ALIGN_LLM_GGUF_MODEL unset)"
  exit 0
fi
if [ ! -f "$model" ]; then
  printf '%s\n' "decode residency gate: N/A (ALIGN_LLM_GGUF_MODEL is absent)"
  exit 0
fi
if [ ! -f "$prompts" ]; then
  printf '%s\n' "decode residency gate: the prompt corpus $prompts is absent" >&2
  exit 1
fi
if [ ! -x "$root_dir/main" ]; then
  printf '%s\n' "decode residency gate: the product executable is missing; run 'make build'" >&2
  exit 1
fi
# A named override that cannot be honoured is an error, not a silent default. Without the range
# check `ALIGN_LLM_LOCALITY_PROMPT_COUNT=0` would run no instrument at all and still print a
# MEASURED block whose corpus identity records `0` prompts, and a non-numeric value would reach `[`
# as a string comparison rather than an integer one.
case "$prompt_count" in
  ''|*[!0-9]*)
    printf '%s\n' "decode residency gate: ALIGN_LLM_LOCALITY_PROMPT_COUNT must be a positive integer" >&2
    exit 1 ;;
esac
if [ "$prompt_count" -lt 1 ] || [ "$prompt_count" -gt 1000 ]; then
  printf '%s\n' "decode residency gate: ALIGN_LLM_LOCALITY_PROMPT_COUNT must be between 1 and 1000" >&2
  exit 1
fi
case "$decode_steps" in
  ''|*[!0-9]*)
    printf '%s\n' "decode residency gate: ALIGN_LLM_DECODE_STEPS must be a positive integer" >&2
    exit 1 ;;
esac
if [ "$decode_steps" -lt 1 ] || [ "$decode_steps" -gt 128 ]; then
  printf '%s\n' "decode residency gate: ALIGN_LLM_DECODE_STEPS must be between 1 and 128" >&2
  exit 1
fi

temp_dir=$(mktemp -d)
cleanup() {
  rm -rf "$temp_dir"
}
# A signal must remove the transcript too: one 16-step transcript is roughly fifteen megabytes, and
# a run interrupted at the terminal is the ordinary way this gate ends early.
trap cleanup EXIT HUP INT TERM

before=$(python3 - "$model" <<'PY'
import os, sys
info = os.stat(sys.argv[1])
print("%d %d" % (info.st_size, info.st_mtime_ns))
PY
)

# The corpus is read once, in file order, and the first `prompt_count` lines are used. The order is
# part of the corpus identity recorded below, and it is also the trace-list order, which
# `docs/specs/r3-residency-sim.md` section 2.2.2 makes part of the input identity.
selected=()
while IFS= read -r line || [ -n "$line" ]; do
  [ -n "$line" ] || continue
  selected+=("$line")
  [ "${#selected[@]}" -lt "$prompt_count" ] || break
done <"$prompts"
if [ "${#selected[@]}" -lt "$prompt_count" ]; then
  printf '%s\n' "decode residency gate: the corpus holds ${#selected[@]} prompts, $prompt_count requested" >&2
  exit 1
fi

corpus_identity=$(python3 - "$prompts" "$prompt_count" <<'PY'
import hashlib, sys
from pathlib import Path
raw = Path(sys.argv[1]).read_bytes()
print("%s %s %d %d"
      % (Path(sys.argv[1]).name, hashlib.md5(raw, usedforsecurity=False).hexdigest(), len(raw), int(sys.argv[2])))
PY
)

instrument_timeout=""
if command -v timeout >/dev/null 2>&1; then
  instrument_timeout="timeout 900"
elif command -v gtimeout >/dev/null 2>&1; then
  instrument_timeout="gtimeout 900"
fi

# The Model IR is derived once, from the same file the instrument is reading, and it is the only
# cost model the simulator has.
"$root_dir/main" --model-ir "$model" "$temp_dir/model-ir.json" >/dev/null || {
  status=$?
  printf '%s\n' "decode residency gate: --model-ir exited $status" >&2
  exit 1
}

budget="${ALIGN_LLM_RESIDENCY_BUDGET:-}"
budget_source="ALIGN_LLM_RESIDENCY_BUDGET"
if [ -z "$budget" ]; then
  budget_source="the computed 25-per-cent default"
  # 25 per cent of the expert footprint, expressed as `total >> 2` so the default is the exact
  # sweep point `docs/specs/r3-residency-sim.md` section 4.5 and section 7.4 recorded.
  budget=$(python3 - "$temp_dir/model-ir.json" <<'PY'
import json, sys
document = json.load(open(sys.argv[1]))
total = sum(b["byte_size"] for b in document["blocks"] if b["kind"] == "ExpertBlock")
print(total >> 2)
PY
  )
fi
# A named override that cannot be honoured is an error, not a value that surfaces an hour later as
# a parser diagnostic from the product. `BUDGET_BYTES` is a positive decimal integer with no sign,
# no separator, and no exponent (`src/residency_sim.align` `parse_budget`), and this runner also
# divides by it before the replays, so `0` and a non-numeric value must be refused here. The ceiling
# is the simulator's own `MAX_BYTE_TOTAL`, `I64_MAX / 1000`, because every byte total is multiplied
# by 1000 before it is divided. The product remains the authority on the exact rule; this check only
# guarantees the operand reaches it as an integer the runner can also reason about.
case "$budget" in
  ''|*[!0-9]*)
    printf '%s\n' "decode residency gate: $budget_source must be a positive decimal integer" >&2
    exit 1 ;;
esac
# The digit-count guard runs first: `[ -gt ]` parses its operands as C integers, so a value wider
# than the type would fail as a shell arithmetic error rather than as this runner's diagnostic.
if [ "${#budget}" -gt 16 ] || [ "$budget" -lt 1 ] || [ "$budget" -gt 9223372036854775 ]; then
  printf '%s\n' \
    "decode residency gate: $budget_source is $budget, outside 1..9223372036854775" >&2
  exit 1
fi

# The a-priori demand bound, checked before the instrument is launched at all. `MAX_DEMANDS` is
# 262,144 (`src/residency_sim.align`), and the decode half of this capture is exactly known in
# advance: every decode graph carries one token, R2c prints every one of the `n_expert_used` router
# slots, and every layer is present because a one-token graph has no token-reduced tail. So
# `prompts * steps * n_layer * n_expert_used` is a lower bound on the pooled stream that needs no
# measurement, and exceeding the cap on that term alone can only end in `R3_SELECTION_TOO_MANY`
# after an hour of capture. The exact total, prefill included, is re-checked after the capture.
python3 - "$temp_dir/model-ir.json" "$prompt_count" "$decode_steps" <<'PY' || exit 1
import json
import sys

MAX_DEMANDS = 262144
document = json.load(open(sys.argv[1]))
prompts, steps = int(sys.argv[2]), int(sys.argv[3])
n_layer = document["model"]["n_layer"]
used = document["model"]["n_expert_used"]
decode_demands = prompts * steps * n_layer * used
if decode_demands > MAX_DEMANDS:
    raise SystemExit(
        "decode residency gate: %d prompt(s) x %d step(s) x %d layer(s) x %d slot(s) = %d decode "
        "demand(s), above the simulator's MAX_DEMANDS %d before a single prefill token is counted."
        " Lower ALIGN_LLM_LOCALITY_PROMPT_COUNT or ALIGN_LLM_DECODE_STEPS."
        % (prompts, steps, n_layer, used, decode_demands, MAX_DEMANDS))
print("  decode demand bound %d = %d x %d x %d x %d, cap %d"
      % (decode_demands, prompts, steps, n_layer, used, MAX_DEMANDS))
PY

# Exercise the product's exact validation order before launching the expensive instrument. A valid
# budget and Model IR reach the deliberately absent trace at step 8; any earlier semantic code is a
# prerequisite failure. This avoids duplicating the simulator's Model IR and budget rules here.
printf '%s\n' "$temp_dir/prerequisite-missing.json" >"$temp_dir/prerequisite-traces.txt"
set +e
"$root_dir/main" --simulate-residency "$temp_dir/prerequisite-traces.txt" \
  "$temp_dir/model-ir.json" "$budget" >"$temp_dir/prerequisite-result.json"
prerequisite_status=$?
set -e
python3 - "$temp_dir/prerequisite-result.json" "$prerequisite_status" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
status = int(sys.argv[2])
try:
    document = json.loads(path.read_text(encoding="utf-8"))
except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
    raise SystemExit("decode residency gate: prerequisite validation produced no document: %s"
                     % exc)
code = document.get("error_code")
detail = document.get("error_detail")
if status != 2 or document.get("status") != "error" \
        or code != "R3_TRACE_UNREADABLE" or detail != "1":
    raise SystemExit("decode residency gate: prerequisite validation failed: %s %s (exit %d)"
                     % (code or "NO_CODE", detail or "NO_DETAIL", status))
PY

"$instrument" --version >"$temp_dir/version.txt" 2>&1 || {
  status=$?
  printf '%s\n' "decode residency gate: the instrument exited $status for --version" >&2
  tail -20 "$temp_dir/version.txt" >&2 || true
  exit 1
}

mkdir -p "$temp_dir/documents"
printf '%s\n' "decode residency gate: capturing ${#selected[@]} transcripts at -n $decode_steps" >&2
start_ns=$(python3 -c 'import time; print(time.monotonic_ns())')
index=0
for prompt in "${selected[@]}"; do
  transcript="$temp_dir/transcript.txt"
  # The flags are contractual, not incidental, and are exactly `scripts/run-decode-locality-gate`'s
  # so that the two decode measurements are taken over the same capture. `-fa off` keeps attention
  # unfused so the graph shape stays the one `docs/specs/r2a-expert-trace.md` section 2.2 was
  # measured against; `-ctk f32 -ctv f32` keeps the cache tensors in a printable type; `-nr`
  # suppresses the reasoning wrapper so the prompt reaches the tokenizer verbatim; `-c 512` bounds
  # the context. `-n N` is R2c's decode meaning: at most N additional one-token graphs, stopping
  # before an end-of-generation token. `--temp 0 --seed 42` pins greedy decode with the instrument's
  # default sampler, and the seed is recorded so a sampled arm can never be mistaken for this one.
  # `ulimit -f` caps the transcript at 256 MiB.
  (
    ulimit -f 262144
    exec $instrument_timeout "$instrument" -m "$model" -p "$prompt" \
      -n "$decode_steps" --temp 0 --seed 42 -t 4 \
      -fa off -ctk f32 -ctv f32 -nr -c 512 \
      </dev/null >"$transcript" 2>"$temp_dir/instrument.log"
  ) || {
    status=$?
    if [ -n "$instrument_timeout" ] && [ "$status" -eq 124 ]; then
      printf '%s\n' "decode residency gate: the instrument did not finish within 900 s on prompt $index" >&2
    else
      printf '%s\n' "decode residency gate: the instrument exited $status on prompt $index" >&2
    fi
    tail -20 "$temp_dir/instrument.log" >&2 || true
    exit 1
  }
  label=$(printf '%03d' "$index")
  "$root_dir/main" --expert-trace "$transcript" >"$temp_dir/documents/$label.json" || {
    status=$?
    printf '%s\n' "decode residency gate: --expert-trace exited $status on prompt $index" >&2
    python3 - "$temp_dir/documents/$label.json" <<'PY' >&2 || true
import json, sys
from pathlib import Path
try:
    document = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
except Exception:
    raise SystemExit(0)
print("decode residency gate: the parser refused the transcript: %s %s"
      % (document.get("error_code"), document.get("error_detail")))
PY
    exit 1
  }
  # The transcripts are the bulk of the run and none is retained: the documents are the evidence.
  rm -f "$transcript"
  index=$((index + 1))
done
end_ns=$(python3 -c 'import time; print(time.monotonic_ns())')

after=$(python3 - "$model" <<'PY'
import os, sys
info = os.stat(sys.argv[1])
print("%d %d" % (info.st_size, info.st_mtime_ns))
PY
)
if [ "$before" != "$after" ]; then
  printf '%s\n' "decode residency gate: the model's size or mtime changed during the run" >&2
  exit 1
fi

python3 - "$root_dir" "$temp_dir" "$budget" "$corpus_identity" "$start_ns" "$end_ns" \
  "$decode_steps" <<'PY'
import json
import subprocess
import sys
from pathlib import Path

root_dir = Path(sys.argv[1])
temp_dir = Path(sys.argv[2])
budget = sys.argv[3]
corpus_identity = sys.argv[4]
elapsed_ns = int(sys.argv[6]) - int(sys.argv[5])
decode_steps = int(sys.argv[7])

sys.path.insert(0, str(root_dir / "scripts"))
from expert_locality_gate import GateError, require_full_router_axes   # noqa: E402
from residency_projection import ARM_NAMES, PROJECTIONS, declared_demands   # noqa: E402
# Section 2.4's policy set and its candidate subset are read from the independent oracle rather than
# hand-copied here: the references are not candidates. `null` and `compulsory` are bounds, `belady`
# is the offline optimum the headroom term is measured against, and `lru` is the declared baseline.
# A hand-copied list would let this runner and the hosted owner disagree about what a candidate is.
from residency_oracle import CANDIDATES, POLICY_NAMES   # noqa: E402

MAX_DEMANDS = 262144
MAX_SIMULATION_STEPS = 1 << 32
MARGIN_PER_MILLE = 50
EXPECTED_POLICIES = list(POLICY_NAMES)

document_dir = temp_dir / "documents"
paths = sorted(document_dir.glob("*.json"))
labels = [path.stem for path in paths]
documents = [json.loads(path.read_text(encoding="utf-8")) for path in paths]

# R2c's full-axis, decode-capable print form is the whole premise of this arm, so it is admitted
# rather than assumed. `require_full_router_axes` is R2D's rule and is shared verbatim: every
# retained (graph, layer, token) group carries exactly slots 0..n_expert_used-1, `slots_truncated`
# is false, and no graph reports a truncated token axis. A historical compact build-10566 document
# fails all three and is refused here instead of quietly producing a six-slot stream under a decode
# capability name.
try:
    require_full_router_axes(documents, labels)
except GateError as error:
    raise SystemExit("decode residency gate: full-axis admission failed: %s" % error)


# The projected arms are written to disk and read back, so what is counted below is exactly the
# bytes `main --simulate-residency` will parse rather than the in-memory object that produced them.
# `mixed` needs no projection directory: the captured documents are already its trace list.
arm_dirs = {"mixed": document_dir}
arm_documents = {"mixed": documents}
for arm in ARM_NAMES:
    if arm == "mixed":
        continue
    arm_dir = temp_dir / arm.replace("_", "-")
    arm_dir.mkdir(parents=True, exist_ok=True)
    for label, document in zip(labels, documents):
        (arm_dir / ("%s.json" % label)).write_text(
            json.dumps(PROJECTIONS[arm](document)), encoding="utf-8")
    arm_dirs[arm] = arm_dir
    arm_documents[arm] = [json.loads((arm_dir / ("%s.json" % label)).read_text(encoding="utf-8"))
                          for label in labels]

arm_demands = {name: sum(declared_demands(row) for row in rows)
               for name, rows in arm_documents.items()}
# A projection removes whole graphs and admission is decided per graph, so the two projections must
# partition the capture exactly. If they do not, one of them dropped or duplicated a selection and
# every rate below would be measured on a stream nobody described.
if arm_demands["prefill_only"] + arm_demands["decode_only"] != arm_demands["mixed"]:
    raise SystemExit(
        "decode residency gate: the projections do not partition the capture: prefill-only %d + "
        "decode-only %d != mixed %d"
        % (arm_demands["prefill_only"], arm_demands["decode_only"], arm_demands["mixed"]))
for name, total in sorted(arm_demands.items()):
    if total > MAX_DEMANDS:
        raise SystemExit(
            "decode residency gate: the %s arm's stream is %d demand(s), above the simulator's "
            "MAX_DEMANDS %d. Lower ALIGN_LLM_LOCALITY_PROMPT_COUNT or ALIGN_LLM_DECODE_STEPS."
            % (name, total, MAX_DEMANDS))
    if total <= 0:
        raise SystemExit("decode residency gate: the %s arm's stream is empty" % name)

ir_path = temp_dir / "model-ir.json"
ir_document = json.loads(ir_path.read_text(encoding="utf-8"))
expert_sizes = [b["byte_size"] for b in ir_document["blocks"] if b["kind"] == "ExpertBlock"]
key_space = ir_document["model"]["n_layer"] * ir_document["model"]["n_expert"]
smallest = min(expert_sizes)

# The section 2.7 cost guard, asserted rather than hoped for: the simulator refuses with
# `R3_SIMULATION_COST` when `demand_count * min(key_space, budget / smallest_expert_bytes)` exceeds
# 2^32, and both arms must sit inside it before the replays are launched.
resident_bound = min(key_space, int(budget) // smallest)
cost = {name: total * resident_bound for name, total in arm_demands.items()}
for name, value in sorted(cost.items()):
    if value > MAX_SIMULATION_STEPS:
        raise SystemExit(
            "decode residency gate: the %s arm's simulation cost %d exceeds MAX_SIMULATION_STEPS %d"
            % (name, value, MAX_SIMULATION_STEPS))

results = {}
for name in ARM_NAMES:
    listing = temp_dir / ("traces-%s.txt" % name)
    listing.write_text("".join("%s\n" % path for path in sorted(arm_dirs[name].glob("*.json"))),
                       encoding="utf-8")
    completed = subprocess.run(
        [str(root_dir / "main"), "--simulate-residency", str(listing), str(ir_path), str(budget)],
        capture_output=True, text=True)
    if not completed.stdout.strip():
        raise SystemExit("decode residency gate: the %s arm exited %d with no document (stderr %r)"
                         % (name, completed.returncode, completed.stderr[:400]))
    document = json.loads(completed.stdout)
    if document["status"] != "ok":
        raise SystemExit("decode residency gate: the %s arm could not be measured: %s %s"
                         % (name, document["error_code"], document["error_detail"]))
    if completed.returncode != 0:
        raise SystemExit("decode residency gate: the %s arm exited %d on an ok document"
                         % (name, completed.returncode))
    results[name] = document

problems = []


def check_graph_phases(name, stream):
    """What each arm's projection must have done to the phase census, asserted per arm.

    `graph_phases` is the only field that states *which phase* was replayed, so an arm that silently
    replayed the wrong graphs — a projection that filtered nothing, filtered everything, or
    renumbered an ordinal — would still produce a well-formed document with plausible byte totals.
    Every number below is known before the capture runs: one prefill graph per prompt, no
    `single_token_first_graph` because `docs/specs/r2a-expert-trace.md` section 2.5.6 gives that name
    to a one-token graph at ordinal 0 and every prompt in the corpus is longer than one token, and
    the two projections partition the mixed arm's decode and prefill census between them.
    """
    phases = stream["graph_phases"]
    mixed_phases = results["mixed"]["stream"]["graph_phases"]
    expected = {
        # arm            prefill                 decode                       single_token_first
        "mixed":        (len(labels),            mixed_phases["decode"],      0),
        "decode_only":  (0,                      mixed_phases["decode"],      0),
        "prefill_only": (mixed_phases["prefill"], 0,                          0),
    }[name]
    for field, want in zip(("prefill", "decode", "single_token_first_graph"), expected):
        if phases[field] != want:
            problems.append("%s: graph_phases %s is %d, the arm replays %d"
                            % (name, field, phases[field], want))
    if name == "mixed" and phases["decode"] < 1:
        problems.append("%s: the capture produced no decode graph at all, so no arm can separate "
                        "prefill from decode" % name)
    if name != "mixed" and arm_demands[name] >= arm_demands["mixed"]:
        problems.append("%s: the projection did not shrink the stream (%d demand(s) against the "
                        "mixed arm's %d)" % (name, arm_demands[name], arm_demands["mixed"]))


def check_arm(name, document):
    """The contract properties of one arm, asserted rather than described."""
    inputs, stream, verdict = document["inputs"], document["stream"], document["verdict"]
    if document["kind"] != "R3_RESIDENCY_SIM" or document["schema_version"] != 1:
        problems.append("%s: the document is not R3_RESIDENCY_SIM schema 1" % name)
    check_graph_phases(name, stream)
    if inputs["admitted_trace_count"] != inputs["listed_trace_count"]:
        problems.append("%s: a listed trace was not admitted" % name)
    if stream["pooling"] != "continuing":
        problems.append("%s: the stream is not the continuing pooled stream" % name)
    if stream["demand_count"] != arm_demands[name]:
        problems.append("%s: the simulator replayed %d demand(s), the corpus holds %d"
                        % (name, stream["demand_count"], arm_demands[name]))
    if stream["slot_coverage_per_mille"] != 1000:
        problems.append("%s: the full-axis capture must print every router slot, coverage is %d "
                        "per mille" % (name, stream["slot_coverage_per_mille"]))
    if [order["order"] for order in document["orders"]] != ["token_major", "layer_major"]:
        problems.append("%s: both replay orders are not reported" % name)
    if [order["verdict_bearing"] for order in document["orders"]] != [True, False]:
        problems.append("%s: the verdict-bearing order is not token_major" % name)
    for order in document["orders"]:
        reported = [row["policy"] for row in order["policies"]]
        if sorted(set(reported)) != sorted(EXPECTED_POLICIES):
            problems.append("%s/%s: the policy set is not the ten rows of section 2.4, it is %r"
                            % (name, order["order"], sorted(set(reported))))
        if len(reported) != len(EXPECTED_POLICIES) * len(document["budgets"]):
            problems.append("%s/%s: %d policy rows for %d budget(s)"
                            % (name, order["order"], len(reported), len(document["budgets"])))
    if verdict["order"] != "token_major" or verdict["baseline_policy"] != "lru":
        problems.append("%s: the verdict is not defined on token_major against the lru baseline"
                        % name)
    if verdict["rule_version"] != 1 or verdict["margin_per_mille"] != MARGIN_PER_MILLE:
        problems.append("%s: the verdict rule is not rule_version 1 at a 50 per mille floor" % name)
    if verdict["result"] not in ("BEATS_BASELINE", "NO_POLICY_BEATS_BASELINE", "NO_HEADROOM"):
        problems.append("%s: the verdict is not one of the three section 2.8 results" % name)
    if verdict["jackknife_folds"] != inputs["admitted_trace_count"]:
        problems.append("%s: the jackknife did not run one fold per admitted document" % name)
    rows = by_policy(document, "token_major", verdict["budget_bytes"])
    # Everything below reads named rows out of that table. A document that did not report the ten
    # rows of section 2.4 at the verdict's own budget is a reportable problem, not a traceback: the
    # structural findings already recorded above are what a reader needs, and a `KeyError` here
    # would destroy them along with the rest of the output.
    if set(rows) != set(EXPECTED_POLICIES):
        problems.append("%s: token_major reports %r at the verdict budget, not the ten rows of "
                        "section 2.4" % (name, sorted(rows)))
        return []
    for policy, cell in rows.items():
        if cell["hits"] + cell["misses"] != cell["demands"]:
            problems.append("%s/%s does not account for every demand" % (name, policy))
        if cell["bytes_fetched"] < rows["compulsory"]["bytes_fetched"]:
            problems.append("%s/%s beat the compulsory lower bound" % (name, policy))
    if rows["belady"]["bytes_fetched"] > rows["lru"]["bytes_fetched"]:
        problems.append("%s: belady is not optimal at the requested budget" % name)
    # Section 2.8's BEATS_BASELINE row names the *qualifying* candidate, which need not be the
    # lowest-byte one: a lower-byte candidate can clear the pooled floor and then lose a fold. The
    # runner reports what the document names and checks that it qualifies, rather than recomputing
    # a winner of its own. On the two non-winning results `best_policy` is still populated whenever
    # some candidate fetched fewer bytes than the baseline — it is then the lowest-byte candidate
    # and *not* a winner, which is why the verdict line and not the byte table is what a reader
    # must go by.
    baseline = verdict["baseline_bytes_fetched"]
    best = verdict["best_policy"]
    cleared = [policy for policy in CANDIDATES
               if 1000 * rows[policy]["bytes_fetched"] <= (1000 - MARGIN_PER_MILLE) * baseline]
    if best:
        if best not in CANDIDATES:
            problems.append("%s: best_policy %r is not one of the section 2.4 candidates"
                            % (name, best))
        elif rows[best]["bytes_fetched"] != verdict["best_bytes_fetched"]:
            problems.append("%s: best_bytes_fetched does not belong to best_policy" % name)
        elif verdict["best_bytes_fetched"] >= baseline:
            problems.append("%s: best_policy %s does not fetch fewer bytes than the baseline"
                            % (name, best))
    elif verdict["best_bytes_fetched"] != baseline:
        problems.append("%s: no best_policy, but best_bytes_fetched is not the baseline" % name)
    if verdict["result"] == "BEATS_BASELINE":
        if best not in cleared:
            problems.append("%s: BEATS_BASELINE named %r, which does not clear the pooled effect "
                            "floor" % (name, best))
        if not verdict["jackknife_stable"] \
                or verdict["jackknife_min_gain_per_mille"] < MARGIN_PER_MILLE:
            problems.append("%s: BEATS_BASELINE without a stable jackknife" % name)
    else:
        if verdict["jackknife_stable"]:
            problems.append("%s: %s with a stable jackknife" % (name, verdict["result"]))
        if verdict["result"] == "NO_HEADROOM" and verdict["headroom_per_mille"] >= MARGIN_PER_MILLE:
            problems.append("%s: NO_HEADROOM with %d per mille of headroom"
                            % (name, verdict["headroom_per_mille"]))
        if verdict["result"] == "NO_POLICY_BEATS_BASELINE" \
                and verdict["headroom_per_mille"] < MARGIN_PER_MILLE:
            problems.append("%s: NO_POLICY_BEATS_BASELINE with %d per mille of headroom"
                            % (name, verdict["headroom_per_mille"]))
    return cleared


def by_policy(document, order, budget_bytes):
    """One order's policy rows at one budget, selected by the reported `order` name.

    The name is what selects the block. Indexing `orders` positionally would silently read the
    `layer_major` rows under the `token_major` label on any document whose order list is not in the
    expected sequence — and the check that the sequence *is* expected only records a problem, which
    is reported after this table has already been read.
    """
    blocks = [entry for entry in document["orders"] if entry["order"] == order]
    if len(blocks) != 1:
        raise SystemExit("decode residency gate: the document reports %d %s block(s), expected 1"
                         % (len(blocks), order))
    return {row["policy"]: row for row in blocks[0]["policies"]
            if row["budget_bytes"] == budget_bytes}


def per_mille_gain(baseline, value):
    """`(baseline - value) * 1000 / baseline` with C truncation toward zero.

    `src/residency_sim.align`'s `per_mille` divides with Align's integer division, which truncates
    toward zero; Python's `//` floors. The two agree on a saving and differ by one per mille on a
    loss, which is exactly the rows above the baseline this table prints.
    """
    if baseline <= 0:
        return 0
    numerator = 1000 * (baseline - value)
    magnitude = abs(numerator) // baseline
    return magnitude if numerator >= 0 else -magnitude


version_text = (temp_dir / "version.txt").read_text(encoding="utf-8", errors="replace").strip()
model_block = results["mixed"]["model"]

print("decode residency gate: MEASURED")
print("  instrument build")
for line in version_text.splitlines():
    print("    %s" % line.strip())
print("  corpus             %s" % corpus_identity)
print("  decode steps       %d requested per prompt (greedy: --temp 0 --seed 42)" % decode_steps)
print("  model              %s n_layer %d n_expert %d n_expert_used %d"
      % (model_block["arch"], model_block["n_layer"], model_block["n_expert"],
         model_block["n_expert_used"]))
print("  expert blocks      %d, %d byte(s) total, %d..%d per expert, uniform %s"
      % (model_block["expert_block_count"], model_block["total_expert_bytes"],
         model_block["smallest_expert_bytes"], model_block["largest_expert_bytes"],
         "yes" if model_block["uniform_expert_bytes"] else "no"))
print("  budget             %s byte(s) = %d per mille of the expert footprint"
      % (budget, results["mixed"]["verdict"]["budget_bytes"] * 1000
         // model_block["total_expert_bytes"]))
print("  demand bound       %s, MAX_DEMANDS %d"
      % (", ".join("%s %d" % (name, arm_demands[name]) for name in ARM_NAMES), MAX_DEMANDS))
print("  simulation cost    %s, MAX_SIMULATION_STEPS %d (resident bound %d key(s))"
      % (", ".join("%s %d" % (name, cost[name]) for name in ARM_NAMES), MAX_SIMULATION_STEPS,
         resident_bound))
print()

ARMS = (("mixed", "mixed         prefill graph + decode graphs, one continuing pooled stream"),
        ("decode_only", "decode-only   graph 0 projected away, ordinals as captured"),
        ("prefill_only", "prefill-only  decode graphs projected away — the coverage control arm"))

cleared_by_arm = {}
for name, title in ARMS:
    document = results[name]
    cleared = check_arm(name, document)
    cleared_by_arm[name] = cleared
    stream, verdict = document["stream"], document["verdict"]
    rows = by_policy(document, "token_major", verdict["budget_bytes"])
    print("  %s" % title)
    print("    traces           %d admitted of %d listed, %d byte(s) read"
          % (document["inputs"]["admitted_trace_count"], document["inputs"]["listed_trace_count"],
             document["inputs"]["bytes_read"]))
    print("    stream           %d demand(s) over %d token position(s), %d distinct key(s)"
          % (stream["demand_count"], stream["token_position_count"], stream["distinct_key_count"]))
    print("    graph phases     %s" % json.dumps(stream["graph_phases"], sort_keys=True))
    print("    layers demanded  %s" % stream["layers_demanded"])
    # `one_token_working_set_*` is measured over the pooled stream's *first* token position only
    # (`src/residency_sim.align`: the scan stops at the first demand whose token ordinal is not 0),
    # so the phase it reports is the phase of that position, not an average over the arm. In the
    # mixed and prefill-only arms that position is a prompt token; in the decode-only arm it is a
    # generated one, which is why the two differ by exactly the prefill graph's reduced last layer.
    print("    one token        %d expert(s), %d byte(s) at the stream's first token position, a "
          "%s token - the LRU cliff"
          % (stream["one_token_working_set_keys"], stream["one_token_working_set_bytes"],
             "generated" if name == "decode_only" else "prompt"))
    print("    token_major at the requested budget")
    print("      %-18s %18s %10s %14s" % ("policy", "bytes fetched", "hit ‰", "vs lru ‰"))
    # `check_arm` records a problem and stops when the ten rows of section 2.4 are not all present.
    # This block must not then raise on the same document: the recorded problems are printed to
    # stderr after the human block, and a `KeyError` here would take them down with it.
    reported = [policy for policy in EXPECTED_POLICIES if policy in rows]
    if len(reported) != len(EXPECTED_POLICIES):
        print("      (incomplete: %d of %d section 2.4 rows at this budget; see the problems below)"
              % (len(reported), len(EXPECTED_POLICIES)))
    for policy in reported:
        cell = rows[policy]
        gain = per_mille_gain(verdict["baseline_bytes_fetched"], cell["bytes_fetched"])
        mark = ""
        if policy == "lru":
            mark = "  <- baseline"
        elif policy == verdict["best_policy"]:
            mark = ("  <- best qualifying candidate" if verdict["result"] == "BEATS_BASELINE"
                    else "  <- lowest-byte candidate, does NOT qualify")
        elif policy in cleared:
            mark = "  (clears the floor, not the jackknife)"
        print("      %-18s %18d %10d %14d%s"
              % (policy, cell["bytes_fetched"], cell["hit_per_mille"], gain, mark))
    print("    verdict (rule_version %d, bytes_fetched on token_major)" % verdict["rule_version"])
    print("      budget         %d byte(s)" % verdict["budget_bytes"])
    print("      baseline       lru %d byte(s) fetched" % verdict["baseline_bytes_fetched"])
    print("      best_policy    %s %d byte(s) fetched (%s)"
          % (verdict["best_policy"] or "-", verdict["best_bytes_fetched"],
             "the qualifying candidate" if verdict["result"] == "BEATS_BASELINE"
             else "the lowest-byte candidate; it does NOT qualify"))
    print("      candidates clearing the pooled floor: %s" % (", ".join(cleared) or "none"))
    print("      gain           %d per mille (floor %d)"
          % (verdict["gain_per_mille"], verdict["margin_per_mille"]))
    print("      headroom       %d per mille to the offline optimum"
          % verdict["headroom_per_mille"])
    # Section 2.8 resamples only over candidates that clear the pooled effect floor, so when none
    # does the fold loop never runs and `jackknife_min_gain_per_mille` is the untested initial 0
    # rather than a measured minimum. Printing `40 fold(s), minimum gain 0` without that word reads
    # as a measured instability. `jackknife_folds` still reports how many folds the document is
    # *partitioned* into, which is a property of the corpus and is true either way.
    print("      jackknife      %s; %d fold(s) available, minimum gain %s, stable %s"
          % ("tested" if cleared else "NOT tested (no candidate cleared the pooled floor)",
             verdict["jackknife_folds"],
             ("%d per mille" % verdict["jackknife_min_gain_per_mille"]) if cleared
             else "not measured",
             "yes" if verdict["jackknife_stable"] else "no"))
    print("      result         %s" % verdict["result"])
    print("    sweep (pooled effect floor only: section 2.8 resamples at the requested budget, so")
    print("           no row below carries a jackknife of its own)")
    # The share column reports the document's own `per_mille_of_expert_bytes` rather than a percent
    # derived from it: dividing by ten here would print the 125-per-mille row as "12%", which
    # understates the operating point the prose then has to describe.
    print("      %14s %8s %10s %10s %-18s %s"
          % ("budget", "share", "gain", "headroom", "best", "result"))
    sweep = {row["budget_bytes"]: row for row in verdict["sweep_best"]}
    for entry in document["budgets"]:
        row = sweep[entry["bytes"]]
        print("      %14d %7d‰ %9d‰ %9d‰ %-18s %s"
              % (entry["bytes"], entry["per_mille_of_expert_bytes"], row["gain_per_mille"],
                 row["headroom_per_mille"], row["best_policy"] or "-", row["result"]))
    print()

print("  caveats")
print("    - the decode-only and prefill-only lists are projections of the captured documents: only")
print("      `graphs` and `selections`, the two arrays the simulator reads, are filtered, and every")
print("      other block still describes the whole transcript")
print("    - the prefill-only arm is the coverage control, not a third result: it holds corpus,")
print("      budget, admission, and the full eight-slot axis fixed and removes only the decode")
print("      graphs, so a verdict it shares with the other two arms is NOT attributable to decode")
print("    - one_token_working_set_* is the first pooled token position only, so the mixed and")
print("      prefill-only arms report a prompt token's working set and decode-only a generated")
print("      one; they are not per-arm averages")
print("    - decode is greedy (--temp 0 --seed 42) and bounded at %d step(s) with -c 512, so this"
      % decode_steps)
print("      is one continuation per prompt, not a distribution over continuations")
print("    - the first decode graph of a token-reduced prefill layer is a compulsory miss the")
print("      prefill capture never charged: the instrument reduces the last layer's token axis, so")
print("      that layer is demanded for the first time in decode")
print("    - bytes are counted, never converted to seconds: this makes no performance claim")
print("    - cross-prompt reuse still carries part of the cache pressure in both arms, so the")
print("      result reads as \"across a session of many short requests\"")
print()
print("  elapsed            %.1f s for %d capture(s) (diagnostic only; no performance claim)"
      % (elapsed_ns / 1e9, len(labels)))
print("  transcripts        deleted; the %d document(s) were the evidence" % len(labels))
print()

for name, _ in ARMS:
    document = results[name]
    stream, verdict = document["stream"], document["verdict"]
    # `jackknife_tested` is the field that keeps the two zeros apart: a `jackknife_min_per_mille=0`
    # under `jackknife_tested=no` is the untested initial value, not a fold that measured no gain.
    tested = "yes" if cleared_by_arm[name] else "no"
    print("decode-residency-gate arm=%s verdict=%s budget=%d baseline_bytes=%d best=%s "
          "best_bytes=%d gain_per_mille=%d headroom_per_mille=%d jackknife_tested=%s "
          "jackknife_folds=%d jackknife_min_per_mille=%d jackknife_stable=%s demands=%d "
          "token_positions=%d distinct_keys=%d slot_coverage_per_mille=%d prefill_graphs=%d "
          "decode_graphs=%d single_first_graphs=%d one_token_ws_keys=%d one_token_ws_bytes=%d "
          "prompts=%d decode_steps=%d"
          % (name, verdict["result"], verdict["budget_bytes"], verdict["baseline_bytes_fetched"],
             verdict["best_policy"] or "none", verdict["best_bytes_fetched"],
             verdict["gain_per_mille"], verdict["headroom_per_mille"], tested,
             verdict["jackknife_folds"], verdict["jackknife_min_gain_per_mille"],
             "yes" if verdict["jackknife_stable"] else "no", stream["demand_count"],
             stream["token_position_count"], stream["distinct_key_count"],
             stream["slot_coverage_per_mille"], stream["graph_phases"]["prefill"],
             stream["graph_phases"]["decode"], stream["graph_phases"]["single_token_first_graph"],
             stream["one_token_working_set_keys"], stream["one_token_working_set_bytes"],
             len(labels), decode_steps))

if problems:
    sys.stdout.flush()
    for problem in problems:
        sys.stderr.write("decode residency gate: %s\n" % problem)
    raise SystemExit(1)
