#!/usr/bin/env bash
set -euo pipefail

unset GIT_DIR GIT_COMMON_DIR GIT_WORK_TREE

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
temp_dir=$(mktemp -d)
repo_dir="$temp_dir/repository"
selection_path="$temp_dir/selection.json"
zero_selection_path="$temp_dir/zero-selection.json"
sparse_repo_dir="$temp_dir/sparse-repository"
sparse_selection_path="$temp_dir/sparse-selection.json"
failed_path="$temp_dir/failed.json"

cleanup() {
  rm -rf "$temp_dir"
}
trap cleanup EXIT

python3 - "$repo_dir" "$sparse_repo_dir" <<'PY'
from pathlib import Path
import sys

repo = Path(sys.argv[1])
sparse_repo = Path(sys.argv[2])
(repo / "src").mkdir(parents=True)
(repo / "tests").mkdir()
(repo / "src" / "app.align").write_text("module app\n", encoding="utf-8")
(repo / "src" / "app_test.align").write_text("module app_test\n", encoding="utf-8")
(repo / "src" / "other_test.align").write_text("module other_test\n", encoding="utf-8")
(repo / "src" / "app_z_test.py").write_text("def test_app_src():\n    assert True\n", encoding="utf-8")
(repo / "tests" / "test_app.py").write_text("def test_app():\n    assert True\n", encoding="utf-8")
(repo / "tests" / "test_other.py").write_text("def test_other():\n    assert True\n", encoding="utf-8")
(repo / "README.md").write_text("fixture\n", encoding="utf-8")

(sparse_repo / "src").mkdir(parents=True)
(sparse_repo / "tests").mkdir()
(sparse_repo / "src" / "app.align").write_text("module app\n", encoding="utf-8")
(sparse_repo / "src" / "app_test.align").write_text("module app_test\n", encoding="utf-8")
(sparse_repo / "tests" / "test_other.py").write_text("def test_other():\n    assert True\n", encoding="utf-8")
PY

git init -q "$repo_dir"
git -C "$repo_dir" config user.email smoke@example.invalid
git -C "$repo_dir" config user.name "Test Selection Smoke"
git -C "$repo_dir" add --all
git -C "$repo_dir" commit -qm initial
git init -q "$sparse_repo_dir"
git -C "$sparse_repo_dir" config user.email smoke@example.invalid
git -C "$sparse_repo_dir" config user.name "Sparse Test Selection Smoke"
git -C "$sparse_repo_dir" add --all
git -C "$sparse_repo_dir" commit -qm initial

"$root_dir/main" --select-tests "$repo_dir" src/app.align "$selection_path"
"$root_dir/main" --select-tests "$repo_dir" pkg/value.align "$zero_selection_path"
"$root_dir/main" --select-tests "$sparse_repo_dir" src/app.align "$sparse_selection_path"

python3 - "$repo_dir" "$selection_path" "$zero_selection_path" "$sparse_selection_path" <<'PY'
import json
import subprocess
import sys
from pathlib import Path

repo = Path(sys.argv[1])
selection = json.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))
zero_selection = json.loads(Path(sys.argv[3]).read_text(encoding="utf-8"))
sparse_selection = json.loads(Path(sys.argv[4]).read_text(encoding="utf-8"))
revision = subprocess.check_output(
    ["git", "-C", str(repo), "rev-parse", "HEAD"], text=True
).strip()

assert selection["schema_version"] == 1, selection
assert selection["root"] == str(repo), selection
assert selection["revision"] == revision, selection
assert selection["status"] == "ok", selection
assert selection["error_code"] == -1, selection
assert selection["changed_path"] == "src/app.align", selection
assert selection["candidate_count"] == 4, selection
assert selection["candidates"] == [
    {
        "path": "src/app_test.align",
        "score": 120,
        "reason": "basename-match+same-directory",
    },
    {"path": "src/app_z_test.py", "score": 120, "reason": "basename-match+same-directory"},
    {"path": "tests/test_app.py", "score": 100, "reason": "basename-match"},
    {"path": "src/other_test.align", "score": 20, "reason": "same-directory"},
], selection

assert zero_selection["candidate_count"] == 5, zero_selection
assert zero_selection["candidates"] == [
    {"path": "src/app_test.align", "score": 0, "reason": "generic"},
    {"path": "src/app_z_test.py", "score": 0, "reason": "generic"},
    {"path": "src/other_test.align", "score": 0, "reason": "generic"},
    {"path": "tests/test_app.py", "score": 0, "reason": "generic"},
    {"path": "tests/test_other.py", "score": 0, "reason": "generic"},
], zero_selection

assert sparse_selection["candidate_count"] == 1, sparse_selection
assert sparse_selection["candidates"] == [
    {
        "path": "src/app_test.align",
        "score": 120,
        "reason": "basename-match+same-directory",
    },
], sparse_selection
PY

mkdir "$temp_dir/not-a-repository"
if "$root_dir/main" --select-tests "$temp_dir/not-a-repository" src/app.align "$failed_path"; then
  exit 1
fi
python3 - "$failed_path" <<'PY'
import json
import sys
from pathlib import Path

failed = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
assert failed["schema_version"] == 1, failed
assert failed["status"] == "error", failed
assert failed["error_code"] == 128, failed
assert failed["changed_path"] == "src/app.align", failed
assert failed["candidate_count"] == 0, failed
assert failed["candidates"] == [], failed
PY

printf '%s\n' "related-test selection smoke: deterministic path ranking and failure persistence PASS"
