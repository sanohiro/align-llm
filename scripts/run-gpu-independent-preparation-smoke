#!/usr/bin/env python3
"""Own backend expectation projection and independent-only preparation refusal."""
import copy
import importlib.util
from importlib.machinery import SourceFileLoader
import json
from pathlib import Path
import tempfile
from types import SimpleNamespace
from unittest.mock import patch
from gpu_backend_recipe import RecipeError

ROOT=Path(__file__).resolve().parent.parent
loader=SourceFileLoader('preparation_owner',str(ROOT/'scripts/prepare-gpu-independent-corpus'))
spec=importlib.util.spec_from_loader(loader.name,loader)
m=importlib.util.module_from_spec(spec);loader.exec_module(m)

def rejected(fn):
    try: fn()
    except (ValueError,KeyError,RecipeError): return
    raise AssertionError('invalid preparation accepted')

def main():
    template=m.validate(json.loads(m.TEMPLATE.read_text()))
    original=copy.deepcopy(template)
    for entry in template['models']:
        completed=[]
        for case in entry['cases']:
            if case['input_mode']=='continuation':
                assert m.continuation(case,completed,entry['eog_token_ids'])==case['prompt_token_ids']
                rejected(lambda:m.continuation(case,[],entry['eog_token_ids']))
                rejected(lambda:m.continuation(case,completed,[]))
            production=dict(prompt_ids=case['prompt_token_ids'],token_ids=case['expected_token_ids'],text=case['expected_output_utf8'])
            expected=copy.deepcopy(case)
            case.update(expected_token_ids=[999],teacher_forced_token_ids=[999],expected_output_utf8='wrong')
            m.project(case,production)
            assert case==expected
            rejected(lambda:m.project(case,dict(production,prompt_ids=[-1])))
            rejected(lambda:m.project(case,dict(production,token_ids=[True])))
            rejected(lambda:m.project(case,dict(production,token_ids=[])))
            rejected(lambda:m.project(case,dict(production,token_ids=[0]*(case['maximum_tokens']+1))))
            completed.append(case)
    assert m.seal(template)==original
    incomplete=copy.deepcopy(template);incomplete['models'][0]['cases'].pop()
    rejected(lambda:m.validate(m.seal(incomplete)))
    with tempfile.TemporaryDirectory() as directory:
        root=Path(directory);profile=root/'profile';profile.write_text('{}');reference=root/'reference';reference.mkdir()
        models=[dict(entry['model']) for entry in template['models']]
        admitted=SimpleNamespace(records={'profile':dict(models=models,runtime_options=[dict(placement='resident',prefetch='off')]),'bundle':dict(ggml=dict(commit='pin'))})
        args=SimpleNamespace(profile=profile,reference=reference,output=root/'output')
        with patch.object(m,'admit',return_value=admitted),patch.object(m,'verify_build',return_value=dict(ggml_commit='wrong',driver_sha256='wrong')):
            rejected(lambda:m.run(args));assert not args.output.exists()
        build=dict(ggml_commit='pin',driver_sha256=m.digest(ROOT/'eval/gpu/reference-acquire.cpp'))
        models[0]['model_sha256']='0'*64
        with patch.object(m,'admit',return_value=admitted),patch.object(m,'verify_build',return_value=build):
            rejected(lambda:m.run(args));assert not args.output.exists()
    print('independent preparation owner: PASS')

if __name__=='__main__': main()
