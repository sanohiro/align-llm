class BoundaryError(RuntimeError):
    pass


def ggml_header_identities(directory: Path) -> list[dict[str, Any]]:
    rows = []
    for name in GGML_HEADER_NAMES:
        path = directory / name
        if not path.is_file():
            raise BoundaryError(f"configured ggml include directory lacks {name}")
        rows.append({
            "name": name, "bytes": path.stat().st_size, "sha256": base.file_sha256(path),
        })
    return rows


def source_identities() -> tuple[str, ...]:
    return (
        base.file_sha256(PREDECESSOR_PATH),
        base.file_sha256(ROOT / "src/olmoe_remaining_decode_overhead_gate.align"),
        base.file_sha256(ROOT / "src/olmoe_decode_pass_residual_gate.align"),
        base.file_sha256(ROOT / "src/olmoe_decode_pass_other_gate.align"),
        base.file_sha256(ROOT / "src/moe_decode_step.align"),
        base.file_sha256(ROOT / "src/moe_model_forward.align"),
        base.file_sha256(ROOT / "src/ggml_ffi.align"),
        base.file_sha256(ROOT / "scripts/ggml_shim.c"),
        base.file_sha256(ROOT / "scripts/ggml_shim_stub.c"),
        base.file_sha256(ROOT / "scripts/build-ggml-shim"),
    )


def shared_contract(path: Path) -> bytes:
    source = path.read_bytes()
    begin = b"/* --- BEGIN R4.5 SHARED SHIM CONTRACT --- */"
    end = b"/* --- END R4.5 SHARED SHIM CONTRACT --- */"
    if source.count(begin) != 1 or source.count(end) != 1:
        raise BoundaryError("shared shim markers drifted")
    first = source.index(begin)
    last = source.index(end, first) + len(end)
    return source[first:last]


def validate_imported_contract() -> None:
    predecessor.validate_imported_contract()
    actual = (
        predecessor.MODEL_BYTES, predecessor.MODEL_SHA256, predecessor.SERVER_BUILD,
        predecessor.BUDGET, predecessor.SEED, predecessor.FULL_TOKENS,
        predecessor.TEMPERATURE_MICROS, predecessor.FULL_OUTPUT_SHA256,
        predecessor.REPETITIONS, predecessor.CEILING_SECONDS,
        predecessor.RECORDED_FULL_HELPER_VALUES_NS,
        predecessor.RECORDED_FULL_HELPER_MEDIAN_NS,
        predecessor.RECORDED_PLANE_BOUNDARY_VALUES_NS,
        predecessor.RECORDED_PLANE_BOUNDARY_MEDIAN_NS,
        predecessor.BASELINE_VALUES_NS, predecessor.BASELINE_MEDIAN_NS,
        predecessor.FULL_HELPER_VALUES_NS, predecessor.FULL_HELPER_MEDIAN_NS,
        predecessor.FLOOR_NS, predecessor.EXPECTED_ALIGN_REVISION,
        predecessor.EXPECTED_COMPILER_SHA256, predecessor.EXPECTED_PACK_SHA256,
        predecessor.EXPECTED_GEOMETRY_SHA256, predecessor.EXPECTED_SERVER_SHA256,
        predecessor.EXPECTED_TASK_SHA256, predecessor.EXPECTED_PROMPT_SHA256,
        predecessor.EXPECTED_C_COMPILER_SHA256,
        predecessor.EXPECTED_C_COMPILER_VERSION_SHA256,
        predecessor.EXPECTED_LINKER_SEARCH_SHA256, predecessor.EXPECTED_GGML_LIBRARIES,
        predecessor.EXPECTED_BASELINE_HOST, predecessor.EXPECTED_BASELINE_HOST_SHA256,
        *source_identities(),
    )
    expected = (
        MODEL_BYTES, MODEL_SHA256, SERVER_BUILD, BUDGET, SEED, FULL_TOKENS,
        TEMPERATURE_MICROS, FULL_OUTPUT_SHA256, REPETITIONS, CEILING_SECONDS,
        BASELINE_VALUES_NS, BASELINE_MEDIAN_NS, BASELINE_PLANE_VALUES_NS,
        BASELINE_PLANE_MEDIAN_NS, PREDECESSOR_OTHER_VALUES_NS, PREDECESSOR_OTHER_MEDIAN_NS,
        PREDECESSOR_FULL_VALUES_NS, PREDECESSOR_FULL_MEDIAN_NS, PREDECESSOR_FLOOR_NS,
        EXPECTED_ALIGN_REVISION, EXPECTED_COMPILER_SHA256, EXPECTED_PACK_SHA256,
        EXPECTED_GEOMETRY_SHA256, EXPECTED_SERVER_SHA256, EXPECTED_TASK_SHA256,
        EXPECTED_PROMPT_SHA256, EXPECTED_C_COMPILER_SHA256,
        EXPECTED_C_COMPILER_VERSION_SHA256, EXPECTED_LINKER_SEARCH_SHA256,
        EXPECTED_GGML_LIBRARIES, EXPECTED_BASELINE_HOST, EXPECTED_BASELINE_HOST_SHA256,
        EXPECTED_PREDECESSOR_SHA256, EXPECTED_SHARED_HELPER_SHA256,
        EXPECTED_RESIDUAL_HELPER_SHA256, EXPECTED_OTHER_HELPER_SHA256,
        EXPECTED_DECODE_SOURCE_SHA256, EXPECTED_OUTCOME_SOURCE_SHA256,
        EXPECTED_FFI_SOURCE_SHA256, EXPECTED_REAL_SHIM_SHA256,
        EXPECTED_STUB_SHIM_SHA256, EXPECTED_BUILD_SHIM_SHA256,
    )
    if actual != expected:
        raise BoundaryError("imported item 60 contract, evidence, or source drifted")
    if diagnosis.integer_median(BASELINE_VALUES_NS) != BASELINE_MEDIAN_NS:
        raise BoundaryError("item 60 full-helper baseline median drifted")
    if diagnosis.integer_median(BASELINE_PLANE_VALUES_NS) != BASELINE_PLANE_MEDIAN_NS:
        raise BoundaryError("item 60 plane-boundary baseline median drifted")
    minimum = (BASELINE_MEDIAN_NS * FLOOR_PPM + 999_999) // 1_000_000
    if minimum != MINIMUM_GAIN_NS or BASELINE_MEDIAN_NS - minimum != CANDIDATE_CEILING_NS:
        raise BoundaryError("item 61 performance gate drifted")
    real = shared_contract(ROOT / "scripts/ggml_shim.c")
    stub = shared_contract(ROOT / "scripts/ggml_shim_stub.c")
    if real != stub:
        raise BoundaryError("real and stub shared shim contracts drifted")


def aggregate(samples: list[dict[str, Any]]) -> dict[str, Any]:
    predecessor.aggregate(samples)
    walls = [sample["full_helper_wall_ns"] for sample in samples]
    boundaries = [
        sample["full"]["pass_other"]["plane_roundtrip_compare_ns"] for sample in samples
    ]
    candidate_median = diagnosis.integer_median(walls)
    boundary_median = diagnosis.integer_median(boundaries)
    gain_ns = BASELINE_MEDIAN_NS - candidate_median
    gain_ppm = gain_ns * 1_000_000 // BASELINE_MEDIAN_NS
    decision = (
        "MET"
        if gain_ns >= MINIMUM_GAIN_NS
        and gain_ppm >= FLOOR_PPM
        and candidate_median <= CANDIDATE_CEILING_NS
        else "NOT_MET"
    )
    return {
        "candidate_full_helper_wall_values_ns": walls,
        "candidate_full_helper_wall_median_ns": candidate_median,
        "candidate_plane_boundary_values_ns": boundaries,
        "candidate_plane_boundary_median_ns": boundary_median,
        "baseline_median_ns": BASELINE_MEDIAN_NS,
        "gain_ns": gain_ns,
        "gain_ppm": gain_ppm,
        "floor_ppm": FLOOR_PPM,
        "minimum_gain_ns": MINIMUM_GAIN_NS,
        "candidate_ceiling_ns": CANDIDATE_CEILING_NS,
        "decision": decision,
    }


def predecessor_result(result: dict[str, Any]) -> dict[str, Any]:
    samples = result["samples"]
    candidate = dict(result["candidate"])
    candidate.pop("ggml_headers")
    return {
        "schema_version": 1,
        "artifact_kind": "R8_OLMOE_DECODE_PASS_OTHER_DIAGNOSIS",
        "status": "COMPLETE",
        "model": result["model"],
        "baseline": {
            "other_pass_values_ns": PREDECESSOR_OTHER_VALUES_NS,
            "other_pass_median_ns": PREDECESSOR_OTHER_MEDIAN_NS,
            "full_helper_wall_values_ns": PREDECESSOR_FULL_VALUES_NS,
            "full_helper_wall_median_ns": PREDECESSOR_FULL_MEDIAN_NS,
            "floor_ns": PREDECESSOR_FLOOR_NS,
        },
        "candidate": candidate,
        "task": result["task"],
        "environment": result["environment"],
        "samples": samples,
        "aggregate": predecessor.aggregate(samples),
        "elapsed_ns": result["elapsed_ns"],
    }


def validate_result(result: dict[str, Any]) -> None:
    diagnosis.require_exact_keys(result, TOP_KEYS, "result")
    if (
        result["schema_version"] != 1
        or result["artifact_kind"] != "R8_OLMOE_PLANE_ROUNDTRIP_BOUNDARY"
        or result["status"] != "COMPLETE"
    ):
        raise BoundaryError("result identity drifted")
    if not isinstance(result["candidate"], dict):
        raise BoundaryError("result candidate was not an object")
    diagnosis.require_exact_keys(result["candidate"], CANDIDATE_KEYS, "result candidate")
    if result["candidate"]["ggml_headers"] != EXPECTED_GGML_HEADERS:
        raise BoundaryError("result ggml header identity drifted")
    predecessor.validate_result(predecessor_result(result))
    expected_baseline = {
        "full_helper_wall_values_ns": BASELINE_VALUES_NS,
        "full_helper_wall_median_ns": BASELINE_MEDIAN_NS,
        "plane_boundary_values_ns": BASELINE_PLANE_VALUES_NS,
        "plane_boundary_median_ns": BASELINE_PLANE_MEDIAN_NS,
        "floor_ppm": FLOOR_PPM,
        "minimum_gain_ns": MINIMUM_GAIN_NS,
        "candidate_ceiling_ns": CANDIDATE_CEILING_NS,
    }
    diagnosis.require_exact_keys(result["baseline"], BASELINE_KEYS, "result baseline")
    if result["baseline"] != expected_baseline:
        raise BoundaryError("result baseline drifted")
    expected_aggregate = aggregate(result["samples"])
    diagnosis.require_exact_keys(result["aggregate"], AGGREGATE_KEYS, "result aggregate")
    if result["aggregate"] != expected_aggregate:
        raise BoundaryError("result aggregate drifted")
    if not diagnosis.is_int(result["elapsed_ns"]) or result["elapsed_ns"] <= 0:
        raise BoundaryError("result elapsed interval was invalid")


def prerequisites() -> tuple[Path, Path, Path, Path, Path, Path] | None:
    rows = (
        ("ALIGN_LLM_OLMOE_MODEL", base.configured_file("ALIGN_LLM_OLMOE_MODEL")),
        ("ALIGN_LLM_MOE_ALIGNPACK", base.configured_file("ALIGN_LLM_MOE_ALIGNPACK")),
        ("ALIGN_LLM_MOE_GEOMETRY", base.configured_file("ALIGN_LLM_MOE_GEOMETRY")),
        ("ALIGN_LLM_GGML_INCLUDE", base.configured_directory("ALIGN_LLM_GGML_INCLUDE")),
        ("ALIGN_LLM_GGML_LIB", base.configured_directory("ALIGN_LLM_GGML_LIB")),
        ("ALIGN_LLM_LLAMA_SERVER", base.configured_file("ALIGN_LLM_LLAMA_SERVER", executable=True)),
    )
    missing = next((name for name, path in rows if path is None), None)
    if missing is not None:
        print(f"R8-OLMOE-PLANE-ROUNDTRIP-BOUNDARY: N/A ({missing} unset)")
        return None
    return tuple(path.resolve() for _, path in rows)  # type: ignore[return-value]


def synthetic_samples(wall: int, boundary: int = 100) -> list[dict[str, Any]]:
    samples = predecessor.synthetic_samples({
        "PLANE_ROUNDTRIP_COMPARE": boundary,
        "GRAPH_MEMBER_SPEC": 1,
        "LAYER_STEP_ACCOUNTING": 1,
        "OTHER_PASS_REMAINDER": 1,
    })
    for sample in samples:
        sample["full_helper_wall_ns"] = wall
    return samples


def synthetic_result(samples: list[dict[str, Any]]) -> dict[str, Any]:
    inherited = predecessor.synthetic_result(samples)
    candidate = dict(inherited["candidate"])
    candidate["ggml_headers"] = [dict(row) for row in EXPECTED_GGML_HEADERS]
    return {
        "schema_version": 1,
        "artifact_kind": "R8_OLMOE_PLANE_ROUNDTRIP_BOUNDARY",
        "status": "COMPLETE",
        "model": inherited["model"],
        "baseline": {
            "full_helper_wall_values_ns": BASELINE_VALUES_NS,
            "full_helper_wall_median_ns": BASELINE_MEDIAN_NS,
            "plane_boundary_values_ns": BASELINE_PLANE_VALUES_NS,
            "plane_boundary_median_ns": BASELINE_PLANE_MEDIAN_NS,
            "floor_ppm": FLOOR_PPM,
            "minimum_gain_ns": MINIMUM_GAIN_NS,
            "candidate_ceiling_ns": CANDIDATE_CEILING_NS,
        },
        "candidate": candidate,
        "task": inherited["task"],
        "environment": inherited["environment"],
        "samples": samples,
        "aggregate": aggregate(samples),
        "elapsed_ns": 1,
    }


def expect_error(action: Any, message: str) -> None:
    try:
        action()
    except (
        BoundaryError, predecessor.OtherError, predecessor.predecessor.ResidualError,
        diagnosis.DiagnosisError, transfer.TransferError,
    ):
        return
    raise BoundaryError(message)


def complete_result_after_cleanup(result: dict[str, Any], started_ns: int) -> dict[str, Any]:
    completed = dict(result)
    elapsed_ns = time.monotonic_ns() - started_ns
    if elapsed_ns > CEILING_SECONDS * 1_000_000_000:
        raise BoundaryError(
            f"complete qualification exceeded its 8-minute ceiling ({elapsed_ns / 1e9:.1f}s)"
        )
    completed["elapsed_ns"] = elapsed_ns
    validate_result(completed)
    return completed


def self_test() -> int:
    if predecessor.self_test() != 0:
        raise BoundaryError("item 60 inherited self-test failed")
    validate_imported_contract()
    at_gate = aggregate(synthetic_samples(CANDIDATE_CEILING_NS))
    if at_gate["gain_ns"] != MINIMUM_GAIN_NS or at_gate["gain_ppm"] != FLOOR_PPM \
            or at_gate["decision"] != "MET":
        raise BoundaryError("candidate at the exact gate did not ship")
    above = aggregate(synthetic_samples(CANDIDATE_CEILING_NS + 1))
    if above["gain_ppm"] != FLOOR_PPM - 1 or above["decision"] != "NOT_MET":
        raise BoundaryError("candidate above the exact gate shipped")
    slower = aggregate(synthetic_samples(BASELINE_MEDIAN_NS + 1))
    if slower["gain_ns"] >= 0 or slower["decision"] != "NOT_MET":
        raise BoundaryError("negative gain shipped")

    malformed = synthetic_samples(CANDIDATE_CEILING_NS)
    malformed[0]["full_helper_wall_ns"] = True
    expect_error(lambda: aggregate(malformed), "boolean candidate wall was accepted")
    malformed = synthetic_samples(CANDIDATE_CEILING_NS)
    malformed[0]["full"]["pass_other"]["plane_roundtrip_compare_ns"] = True
    expect_error(lambda: aggregate(malformed), "boolean plane-boundary time was accepted")
    with mock.patch.object(predecessor, "SEED", 6):
        expect_error(validate_imported_contract, "drifted imported workload was accepted")

    with tempfile.TemporaryDirectory(prefix="align-r8-olmoe-header-self-test-") as raw:
        include = Path(raw)
        expected_headers = []
        for index, name in enumerate(GGML_HEADER_NAMES, 1):
            content = bytes([index]) * index
            (include / name).write_bytes(content)
            expected_headers.append({
                "name": name, "bytes": len(content), "sha256": base.bytes_sha256(content),
            })
        if ggml_header_identities(include) != expected_headers:
            raise BoundaryError("ggml header identities were not deterministic")
        (include / GGML_HEADER_NAMES[0]).write_bytes(b"mutated")
        if ggml_header_identities(include) == expected_headers:
            raise BoundaryError("mutated ggml header identity was accepted")
        (include / GGML_HEADER_NAMES[0]).unlink()
        expect_error(
            lambda: ggml_header_identities(include),
            "missing consumed ggml header was accepted",
        )

    result = synthetic_result(synthetic_samples(CANDIDATE_CEILING_NS))
    validate_result(result)
    malformed_result = dict(result)
    malformed_result["extra"] = 1
    expect_error(lambda: validate_result(malformed_result), "non-exact result was accepted")
    for section, field, value in (
        ("baseline", "minimum_gain_ns", False),
        ("candidate", "provider", "bogus-runtime"),
        ("candidate", "ggml_headers", []),
        ("environment", "host_fingerprint_sha256", "0" * 64),
        ("aggregate", "decision", "NOT_MET"),
    ):
        malformed_result = dict(result)
        malformed_result[section] = dict(result[section])
        malformed_result[section][field] = value
        expect_error(
            lambda malformed_result=malformed_result: validate_result(malformed_result),
            f"malformed result {section}.{field} was accepted",
        )
    incomplete_result = dict(result)
    incomplete_result["elapsed_ns"] = 0
    with mock.patch.object(time, "monotonic_ns", return_value=2_000):
        finalized = complete_result_after_cleanup(incomplete_result, 1_000)
    if finalized["elapsed_ns"] != 1_000:
        raise BoundaryError("cleanup-inclusive elapsed time was not finalized")
    with mock.patch.object(
        time, "monotonic_ns", return_value=CEILING_SECONDS * 1_000_000_000 + 1_001,
    ):
        expect_error(
            lambda: complete_result_after_cleanup(incomplete_result, 1_000),
            "post-cleanup ceiling excess was accepted",
        )
    with mock.patch.dict(os.environ, {}, clear=True), mock.patch("builtins.print") as printed:
        if prerequisites() is not None:
            raise BoundaryError("missing prerequisites did not produce N/A")
    printed.assert_called_once_with(
        "R8-OLMOE-PLANE-ROUNDTRIP-BOUNDARY: N/A (ALIGN_LLM_OLMOE_MODEL unset)"
    )
    print("R8-OLMOE-PLANE-ROUNDTRIP-BOUNDARY self-test: PASS")
    return 0


def main() -> int:
    if sys.argv[1:] == ["--self-test"]:
        return self_test()
    if len(sys.argv) != 1:
        raise BoundaryError("OLMoE plane round-trip qualification accepts no arguments")
    required = prerequisites()
    if required is None:
        return 0
    model, pack, geometry, include, library, server = required
    started_ns = time.monotonic_ns()
    deadline = time.monotonic() + CEILING_SECONDS

    with tempfile.TemporaryDirectory(prefix="align-r8-olmoe-plane-roundtrip-") as raw:
        work = Path(raw)
        clean_env = transfer.phase.decision.decision_environment()
        linker_search = transfer.phase.decision.validate_linker_search(clean_env)
        if linker_search:
            clean_env["LIBRARY_PATH"] = linker_search
        host_environment = transfer.qualification_host(clean_env, deadline)
        source_status = owner.run_process(
            ["git", "status", "--porcelain", "--untracked-files=all"],
            deadline=deadline, maximum=30, env=clean_env,
        )
        if source_status.stdout:
            raise BoundaryError("real qualification requires a clean worktree")
        align_llm_head = owner.run_process(
            ["git", "rev-parse", "HEAD"], deadline=deadline, maximum=30, env=clean_env,
        ).stdout.decode("ascii").strip()
        validate_imported_contract()
        align_revision = (ROOT / ".align-revision").read_text(encoding="utf-8").strip()
        owner.require_no_matching_process(server, model, deadline, clean_env)
        if model.stat().st_size != MODEL_BYTES or base.file_sha256(model) != MODEL_SHA256:
            raise BoundaryError("configured OLMoE GGUF does not have the pinned identity")
        pack_sha256 = base.file_sha256(pack)
        geometry_sha256 = base.file_sha256(geometry)
        server_sha256 = base.file_sha256(server)
        task_sha256 = base.file_sha256(diagnosis.TASK)
        prompt_sha256 = base.bytes_sha256(diagnosis.PROMPT_TEXT.encode("utf-8"))
        ggml_libraries = base.library_identities(library)
        ggml_headers = ggml_header_identities(include)
        if ggml_headers != EXPECTED_GGML_HEADERS:
            raise BoundaryError("configured ggml header identity drifted")
        linker_search_sha256 = (
            None if not linker_search else base.bytes_sha256(linker_search.encode("utf-8"))
        )
        diagnosis.validate_external_identity(
            align_revision=align_revision, pack_sha256=pack_sha256,
            geometry_sha256=geometry_sha256, server_sha256=server_sha256,
            task_sha256=task_sha256, prompt_sha256=prompt_sha256,
            ggml_libraries=ggml_libraries, linker_search_sha256=linker_search_sha256,
        )
        version = owner.run_process(
            [str(server), "--version"], deadline=deadline, maximum=30, env=clean_env,
        )
        if SERVER_BUILD not in (version.stdout + version.stderr).decode("utf-8", "replace"):
            raise BoundaryError("llama-server build identity drifted")

        with predecessor.predecessor.built_helper_for(
            work, include, library, clean_env, deadline,
            "src/olmoe_decode_pass_other_gate.align",
            "olmoe_decode_pass_other_gate",
            "olmoe-decode-pass-other-gate",
        ) as built:
            diagnosis.validate_toolchain_identity(built)
            samples = []
            for index in range(1, REPETITIONS + 1):
                samples.append(
                    predecessor.measure_sample(
                        index, built, server, model, pack, geometry, clean_env, deadline,
                    )
                )
                predecessor.validate_repeatability(samples)

            final_status = owner.run_process(
                ["git", "status", "--porcelain", "--untracked-files=all"],
                deadline=deadline, maximum=30, env=clean_env,
            )
            final_head = owner.run_process(
                ["git", "rev-parse", "HEAD"], deadline=deadline, maximum=30, env=clean_env,
            ).stdout.decode("ascii").strip()
            if final_status.stdout or final_head != align_llm_head:
                raise BoundaryError("align-llm source changed during qualification")
            expected_sources = (
                EXPECTED_PREDECESSOR_SHA256, EXPECTED_SHARED_HELPER_SHA256,
                EXPECTED_RESIDUAL_HELPER_SHA256, EXPECTED_OTHER_HELPER_SHA256,
                EXPECTED_DECODE_SOURCE_SHA256, EXPECTED_OUTCOME_SOURCE_SHA256,
                EXPECTED_FFI_SOURCE_SHA256, EXPECTED_REAL_SHIM_SHA256,
                EXPECTED_STUB_SHIM_SHA256, EXPECTED_BUILD_SHIM_SHA256,
            )
            if source_identities() != expected_sources:
                raise BoundaryError("qualification sources changed during the run")
            owner.verify_identities((
                ("model", model, MODEL_SHA256), ("pack", pack, pack_sha256),
                ("geometry", geometry, geometry_sha256), ("server", server, server_sha256),
                ("task", diagnosis.TASK, task_sha256),
                ("compiler", built["compiler"], built["compiler_sha256"]),
                ("C compiler", built["c_compiler"], built["c_compiler_sha256"]),
                ("shim", built["shim"], built["shim_sha256"]),
                ("helper", built["helper"], built["helper_sha256"]),
            ))
            if base.library_identities(library) != ggml_libraries:
                raise BoundaryError("ggml library identities changed during qualification")
            if ggml_header_identities(include) != ggml_headers:
                raise BoundaryError("ggml headers changed during qualification")
            owner.require_no_matching_process(server, model, deadline, clean_env)

            task_document = json.loads(diagnosis.TASK.read_text(encoding="utf-8"))
            aggregate_result = aggregate(samples)
            result = {
                "schema_version": 1,
                "artifact_kind": "R8_OLMOE_PLANE_ROUNDTRIP_BOUNDARY",
                "status": "COMPLETE",
                "model": {"bytes": MODEL_BYTES, "sha256": MODEL_SHA256, "architecture": "olmoe"},
                "baseline": {
                    "full_helper_wall_values_ns": BASELINE_VALUES_NS,
                    "full_helper_wall_median_ns": BASELINE_MEDIAN_NS,
                    "plane_boundary_values_ns": BASELINE_PLANE_VALUES_NS,
                    "plane_boundary_median_ns": BASELINE_PLANE_MEDIAN_NS,
                    "floor_ppm": FLOOR_PPM,
                    "minimum_gain_ns": MINIMUM_GAIN_NS,
                    "candidate_ceiling_ns": CANDIDATE_CEILING_NS,
                },
                "candidate": {
                    "provider": "align-runtime", "align_llm_head": align_llm_head,
                    "align_revision": align_revision,
                    "compiler_sha256": built["compiler_sha256"],
                    "helper_sha256": built["helper_sha256"],
                    "shim_sha256": built["shim_sha256"], "ggml_libraries": ggml_libraries,
                    "ggml_headers": ggml_headers,
                    "pack_sha256": pack_sha256, "geometry_sha256": geometry_sha256,
                    "cache_budget_bytes": BUDGET,
                },
                "task": {
                    "task_id": task_document["id"], "task_sha256": task_sha256,
                    "prompt_sha256": prompt_sha256, "maximum_tokens": FULL_TOKENS,
                    "temperature_micros": TEMPERATURE_MICROS, "seed": SEED,
                    "full_output_sha256": FULL_OUTPUT_SHA256,
                },
                "environment": {
                    **host_environment,
                    "c_compiler_sha256": built["c_compiler_sha256"],
                    "c_compiler_version_sha256": built["c_compiler_version_sha256"],
                    "linker_search_sha256": linker_search_sha256,
                },
                "samples": samples,
                "aggregate": aggregate_result,
            }
    result = complete_result_after_cleanup(result, started_ns)
    elapsed_ns = result["elapsed_ns"]
    aggregate_result = result["aggregate"]
    print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))
    print(
        "R8-OLMOE-PLANE-ROUNDTRIP-BOUNDARY: COMPLETE "
        f"decision={aggregate_result['decision']} "
        f"candidate={aggregate_result['candidate_full_helper_wall_median_ns'] / 1e9:.3f}s "
        f"gain_ppm={aggregate_result['gain_ppm']} "
        f"boundary={aggregate_result['candidate_plane_boundary_median_ns'] / 1e9:.3f}s "
        f"elapsed={elapsed_ns / 1e9:.2f}s",
        file=sys.stderr,
    )
    return 0


def interrupted(signal_number: int, _frame: object) -> None:
    owner.stop_owned_processes()
    raise SystemExit(128 + signal_number)


if __name__ == "__main__":
    signal.signal(signal.SIGINT, interrupted)
    signal.signal(signal.SIGTERM, interrupted)
    try:
        raise SystemExit(main())
    except (
        BoundaryError, predecessor.OtherError, predecessor.predecessor.ResidualError,
        transfer.TransferError, diagnosis.DiagnosisError, transfer.phase.DiagnosisError,
        owner.DiagnosisError, transfer.phase.decision.DecisionError, base.DecisionError,
        OSError, ValueError, KeyError, TypeError, json.JSONDecodeError,
        subprocess.TimeoutExpired,
    ) as error:
        owner.stop_owned_processes()
        print(f"R8-OLMOE-PLANE-ROUNDTRIP-BOUNDARY: FAIL {error}", file=sys.stderr)
        raise SystemExit(1)
