#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
compiler="${ALIGNC:-${project_root}/scripts/alignc}"
scratch="$(mktemp -d)"
scratch="$(cd "$scratch" && pwd -P)"
trap 'status=$?; if [ "$status" -eq 0 ]; then rm -rf "$scratch"; else echo "Preserved attempt fixture: $scratch" >&2; fi' EXIT
"$compiler" check-per-unit "$project_root/src/prompt_task_attempt_smoke.align"
(cd "$scratch" && "$compiler" build "$project_root/src/prompt_task_attempt_smoke.align")
if [[ "$(uname -s)" != Linux ]]; then
  "$scratch/prompt_task_attempt_smoke" Darwin - - - - - - -
  exit 0
fi
mkdir "$scratch/image" "$scratch/source" "$scratch/oracle"
cp "$(command -v git)" "$scratch/image/git"
git_hash="$(sha256sum "$scratch/image/git" | cut -d ' ' -f 1)"
printf 'before\n' > "$scratch/source/a"
chmod 644 "$scratch/source/a"
oracle_env=(env -i HOME=/tmp/home PATH=/usr/bin:/bin TMPDIR=/tmp LC_ALL=C
  GIT_CONFIG_NOSYSTEM=1 GIT_ATTR_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_NO_REPLACE_OBJECTS=1
  'GIT_AUTHOR_NAME=align-llm fixture' GIT_AUTHOR_EMAIL=fixture@align-llm.invalid GIT_AUTHOR_DATE=2026-01-01T00:00:00Z
  'GIT_COMMITTER_NAME=align-llm fixture' GIT_COMMITTER_EMAIL=fixture@align-llm.invalid GIT_COMMITTER_DATE=2026-01-01T00:00:00Z)
"${oracle_env[@]}" git -C "$scratch/oracle" init -q --initial-branch=main --object-format=sha1
blob="$(printf 'before\n' | "${oracle_env[@]}" git -C "$scratch/oracle" hash-object -w --stdin)"
tree="$(printf '100644 blob %s\ta\n' "$blob" | "${oracle_env[@]}" git -C "$scratch/oracle" mktree)"
revision="$(printf 'Create deterministic evaluation fixture\n' | "${oracle_env[@]}" git -C "$scratch/oracle" commit-tree "$tree")"
cat > "$scratch/patch-input" <<'PATCH'
diff --git a/a b/a
--- a/a
+++ b/a
@@ -1 +1 @@
-before
+after
PATCH
hash=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
for mode in fixture fixture-parent provider testfail unchanged outside prose duplicate unterminated baseline containment timeout cleanup malformed source-limit; do
  mkdir "$scratch/workspace"
  if [[ "$mode" == source-limit ]]; then dd if=/dev/zero bs=262145 count=1 2>/dev/null | tr '\000' x > "$scratch/source/a"; fi
  provider=LOCAL_OPENAI
  kind=PROVIDER_EDIT
  if [[ "$mode" == fixture || "$mode" == fixture-parent ]]; then provider=FIXTURE; kind=FIXTURE_PATCH; fi
  # Construct the previously admitted native input in an independent fixture language. Digests
  # unrelated to this owner are placeholders; generated measurements are checked independently.
  jq -cn --arg root "$scratch" --arg hash "$hash" --arg revision "$revision" \
    --arg provider "$provider" --arg kind "$kind" --arg mode "$mode" --rawfile patch "$scratch/patch-input" -f "$project_root/eval/fixtures/product-cutover-attempt-input.jq" > "$scratch/input"
  content=$'FILE: a\n```\nafter secret\n```'
  case "$mode" in
    unchanged) content=$'FILE: a\n```\nbefore\n```' ;;
    outside) content=$'FILE: ../outside\n```\nafter\n```' ;;
    prose) content='no file declaration' ;;
    duplicate) content=$'FILE: a\n```\nafter\n```\nFILE: a\n```\nagain\n```' ;;
    unterminated) content=$'FILE: a\n```\nafter' ;;
  esac
  jq -cj --arg content "$content" --arg hash "$hash" -n '{schema_version:1,artifact_kind:"PROMPT_GENERATION_RESPONSE",request_id:"task-s1-candidate",status:"GENERATED",error_code:"NONE",error:"",provider_kind:"LOCAL_OPENAI",provider_model:"model",provider_request_sha256:$hash,seed_result:"APPLIED",applied_seed:7,http_status:200,content:$content,dispatch_start_ns:1,dispatch_end_ns:2,content_sha256:""}' > "$scratch/unsigned"
  response_hash="$(sha256sum "$scratch/unsigned" | cut -d ' ' -f 1)"
  jq -cj --arg hash "$response_hash" '.content_sha256=$hash' "$scratch/unsigned" > "$scratch/response"
  if [[ "$mode" == malformed ]]; then printf '{}' > "$scratch/response"; fi
  "$scratch/prompt_task_attempt_smoke" Linux "$scratch/input" "$scratch/image" "$git_hash" "$scratch/source" "$scratch" "$scratch/response" "$mode" > "$scratch/result"
  jq -cj '.content_sha256=""' "$scratch/result" > "$scratch/canonical"
  [[ "$(sha256sum "$scratch/canonical" | cut -d ' ' -f 1)" == "$(jq -r .content_sha256 "$scratch/result")" ]]
  for record in expected_record attempt_record skipped_record row_record attestation_record; do
    jq -cj '.content_sha256=""' "$scratch/$record" > "$scratch/canonical"
    [[ "$(sha256sum "$scratch/canonical" | cut -d ' ' -f 1)" == "$(jq -r .content_sha256 "$scratch/$record")" ]]
  done
  jq -e --slurpfile expected "$scratch/expected_record" --slurpfile measurement "$scratch/result" '
    .artifact_kind=="TASK_ATTEMPT_RECORD" and .attempt_index==1 and .attempt_kind=="INITIAL" and
    .measurement==$measurement[0] and .measurement_sha256==$measurement[0].content_sha256 and
    .generation_request==$measurement[0].generation_request and .seed_attestation==$measurement[0].seed_attestation and
    .generation_request.content_sha256==$expected[0].generation_request_sha256 and .adapter_request_sha256==$expected[0].adapter_request_sha256
    ' "$scratch/attempt_record" >/dev/null
  jq -e '.status=="SKIPPED" and .attempt_index==2 and .attempt_kind=="REPAIR" and (.measurement|not) and (.adapter_request_sha256|not) and .adapter_elapsed_ns==0 and .repair_preparation_ns==5' "$scratch/skipped_record" >/dev/null
  jq -e --slurpfile measurement "$scratch/result" --slurpfile attempt "$scratch/attempt_record" '
    .measurement==$measurement[0] and .attempts[0]==$attempt[0] and .repair_loop_count==0 and
    .evaluation_input.generation_request_sha256==$measurement[0].generation_request.content_sha256 and
    .evaluation_input.adapter_request_sha256==$attempt[0].adapter_request_sha256 and
    (if .measurement.status=="PASS" then .generation_to_passing_patch_ns==$attempt[0].adapter_elapsed_ns and
      .time_to_passing_patch_ns==($attempt[0].adapter_elapsed_ns+20000000) else
      (.generation_to_passing_patch_ns|not) and (.time_to_passing_patch_ns|not) end) and
    (.attempts|length)==(if .measurement.status=="FAIL" then 2 else 1 end)
    ' "$scratch/row_record" >/dev/null
  jq -cj '.evaluation_input|.content_sha256=""' "$scratch/row_record" > "$scratch/canonical"
  [[ "$(sha256sum "$scratch/canonical" | cut -d ' ' -f 1)" == "$(jq -r .evaluation_input.content_sha256 "$scratch/row_record")" ]]
  jq -e --slurpfile attempt "$scratch/attempt_record" '
    .status=="COMPLETE" and .snapshot_request_sha256==$attempt[0].snapshot_request_sha256 and
    .before_input_snapshot_sha256==.after_input_snapshot_sha256 and
    .after_input_snapshot_sha256==$attempt[0].input_snapshot_sha256
    ' "$scratch/attestation_record" >/dev/null
  rm "$scratch/expected_record" "$scratch/attempt_record" "$scratch/skipped_record" "$scratch/row_record" "$scratch/attestation_record"
  jq -e '.schema_version==4 and .environment_probe.schema_version==2 and .environment_probe.producer=="ALIGN_TASK" and .product_runtime==.environment_probe.runtime_identity and (.diagnostic_stdout|contains("secret")|not) and (.diagnostic_stderr|contains("secret")|not)' "$scratch/result" >/dev/null
  case "$mode" in
    fixture|fixture-parent)
      jq -e '.status=="PASS" and .seed_attestation.provider_kind=="FIXTURE" and .seed_attestation.result=="APPLIED" and .generation_to_passing_patch_ns>0 and (.completion_bytes|not) and (.edit_set|not)' "$scratch/result" >/dev/null
      jq -cj '{provider_kind:"FIXTURE",provider_model:.seed_attestation.provider_model,rendered_prompt_sha256:.rendered_prompt_sha256,max_tokens:.generation_request.max_tokens,temperature_micros:.generation_request.temperature_micros,paired_seed:.generation_request.paired_seed}' "$scratch/result" > "$scratch/fixture-request"
      [[ "$(sha256sum "$scratch/fixture-request" | cut -d ' ' -f 1)" == "$(jq -r .seed_attestation.provider_request_sha256 "$scratch/result")" ]]
      ;;
    provider) jq -e '.status=="PASS" and .generation_to_passing_patch_ns>0 and (.edit_set|length)==1 and .edit_set[0].body_text=="after [REDACTED]\n"' "$scratch/result" >/dev/null ;;
    testfail) jq -e '.status=="FAIL" and .failure_kind=="TEST" and (.generation_to_passing_patch_ns|not)' "$scratch/result" >/dev/null ;;
    unchanged) jq -e '.status=="FAIL" and .edit_refusal=="UNCHANGED_FILES" and (.edit_set|length)==1 and .patch_size_bytes==0' "$scratch/result" >/dev/null ;;
    outside) jq -e '.status=="POLICY_VIOLATION" and .edit_refusal=="PATH_NOT_EDITABLE" and (.edit_set|not)' "$scratch/result" >/dev/null ;;
    prose) jq -e '.status=="FAIL" and .failure_kind=="PATCH" and .edit_refusal=="NO_FILE_BLOCK" and .completion_text=="no file declaration"' "$scratch/result" >/dev/null ;;
    duplicate) jq -e '.status=="FAIL" and .edit_refusal=="DUPLICATE_PATH" and .diagnostic_summary=="the response declares a twice"' "$scratch/result" >/dev/null ;;
    unterminated) jq -e '.status=="FAIL" and .edit_refusal=="UNTERMINATED_BLOCK" and .diagnostic_summary=="a fenced file block is not terminated"' "$scratch/result" >/dev/null ;;
    containment) jq -e '.status=="ERROR" and .failure_kind=="CONTAINMENT" and .containment_passed==false' "$scratch/result" >/dev/null ;;
    cleanup) jq -e '.status=="ERROR" and .failure_kind=="CLEANUP" and .cleanup_passed==false and (.generation_to_passing_patch_ns|not)' "$scratch/result" >/dev/null ;;
    *) jq -e '.status=="ERROR" and .failure_kind=="ADAPTER" and .cleanup_passed==true' "$scratch/result" >/dev/null ;;
  esac
  [[ ! -e "$scratch/workspace" && ! -e "$scratch/attempt.patch" ]]
  if [[ "$mode" == source-limit ]]; then
    [[ "$(wc -c < "$scratch/source/a")" -eq 262145 ]]
  else
    [[ "$(cat "$scratch/source/a")" == before ]]
  fi
  printf 'task attempt: %s PASS\n' "$mode"
done
echo 'native task attempt: 15 lifecycle and measurement cases PASS (trusted commands; installed containment not qualified)'
