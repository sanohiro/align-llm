#!/usr/bin/env bash

# c7-persisted-result-cli-smoke.
#
# `docs/specs/c7-persisted-result.md` section 13 names this runner for the "CLI dispatch and
# malformed invocation" row: no-mode help, both valid arities, missing and extra operands, unknown
# selectors, and conflicting C7 selectors. It also closes the "Same-path input/output" path
# validation row, the "CLI option/environment isolation" row, and the section 3.3 stable summary
# block for `PASS` and for the valid semantic `FAIL` that exits nonzero after publication.
#
# Every rejection asserts its exact process exit, not merely a nonzero one: section 8.3 `Invalid`
# rows are exit 2 and the absent-file filesystem row is exit 1, which is what pins the section 8.1
# row-3 typed `map_err` inside the hosted lane. It also covers both sides of the section 3.2
# 4,096-byte path bound.
#
# The expected artifact bytes come from the independent `scripts/c7_persisted_result_fixtures.py`
# table, never from the produced files.

set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
executable="${project_root}/main"
work_dir="$(mktemp -d)"
trap 'rm -rf "${work_dir}"' EXIT

if [ ! -x "${executable}" ]; then
  printf '%s\n' "c7 persisted result cli smoke: ${executable} is missing; run make build first" >&2
  exit 1
fi

python3 - "${project_root}" "${work_dir}" <<'PY'
import sys
from pathlib import Path

sys.path.insert(0, str(Path(sys.argv[1]) / "scripts"))
import c7_persisted_result_fixtures as fixtures

fixtures.require_golden()
work = Path(sys.argv[2])
pass_input, pass_artifact, pass_status = fixtures.expected_pair(
    "upper-equal", 4, 5, 0, 9, 2, fixtures.ESCAPED_NOTE
)
fail_input, fail_artifact, fail_status = fixtures.expected_pair(
    "expected-mismatch", 2, 3, 0, 9, 2, None
)
if pass_status != "PASS" or fail_status != "FAIL":
    raise SystemExit("c7 persisted result cli smoke: fixture statuses drifted")
(work / "pass.input.json").write_bytes(pass_input.encode("utf-8"))
(work / "pass.input.control.json").write_bytes(pass_input.encode("utf-8"))
(work / "fail.input.json").write_bytes(fail_input.encode("utf-8"))
(work / "pass.expected.json").write_bytes(pass_artifact.encode("utf-8"))
(work / "fail.expected.json").write_bytes(fail_artifact.encode("utf-8"))

# Section 8.1/8.2 row 3: the shipped `core.json` decoder reports its own `Error.Code(_)` for a
# malformed document, so without the typed `map_err` these three exit 1 instead of 2. They are the
# hosted-lane regression guard for that mapping at the process boundary.
(work / "malformed.input.json").write_bytes(pass_input[:-8].encode("utf-8"))
(work / "malformed.result.json").write_bytes(pass_artifact[:-8].encode("utf-8"))
(work / "mutated.result.json").write_bytes(
    pass_artifact.replace('"observed":2', '"observed":1').encode("utf-8")
)
PY

run_case() {
  name="$1"
  shift
  set +e
  "$@" >"${work_dir}/${name}.out" 2>"${work_dir}/${name}.err"
  printf '%s\n' "$?" >"${work_dir}/${name}.code"
  set -e
}

# Unknown-selector compatibility: the existing dispatcher prints help and returns Ok(()).
run_case no-mode "${executable}"
run_case unknown-selector "${executable}" --unknown-flag
run_case unknown-prefix "${executable}" --persist

# Exact arity, checked before path validation or any file operation.
run_case persist-no-operand "${executable}" --persist-result
run_case persist-one-operand "${executable}" --persist-result "${work_dir}/pass.input.json"
run_case persist-extra-operand "${executable}" --persist-result \
  "${work_dir}/pass.input.json" "${work_dir}/arity.result.json" extra
run_case verify-no-operand "${executable}" --verify-result
run_case verify-extra-operand "${executable}" --verify-result \
  "${work_dir}/pass.input.json" extra

# A second C7 selector in an operand position is rejected before path validation.
run_case persist-selector-as-input "${executable}" --persist-result \
  --verify-result "${work_dir}/conflict.result.json"
run_case persist-selector-as-output "${executable}" --persist-result \
  "${work_dir}/pass.input.json" --persist-result
run_case verify-selector-as-operand "${executable}" --verify-result --persist-result

# Exact-string path overlap is rejected before any read or write.
run_case same-path "${executable}" --persist-result \
  "${work_dir}/pass.input.json" "${work_dir}/pass.input.json"

# Section 3.2 / section 8.1 row 1 path byte bound, on both sides of the inclusive limit. The
# 4,096-byte destination is accepted by path validation and reaches the filesystem, where every
# supported host rejects it with its own `PATH_MAX` errno; the 4,097-byte destination never gets
# that far and is the application's own `Error.Invalid`.
path_bound_input="${work_dir}/pass.input.json"
python3 - "${work_dir}" <<'PY'
import sys
from pathlib import Path

work = Path(sys.argv[1])
prefix = f"{work}/"
for name, total in (("path-at-bound", 4096), ("path-over-bound", 4097)):
    filler = "x" * (total - len(prefix) - len(".json"))
    path = f"{prefix}{filler}.json"
    if len(path.encode("utf-8")) != total:
        raise SystemExit(f"c7 persisted result cli smoke: {name} path is not {total} bytes")
    (work / f"{name}.path").write_text(path, encoding="utf-8")
PY
run_case path-at-bound "${executable}" --persist-result "${path_bound_input}" \
  "$(cat "${work_dir}/path-at-bound.path")"
run_case path-over-bound "${executable}" --persist-result "${path_bound_input}" \
  "$(cat "${work_dir}/path-over-bound.path")"

# The supported paths.
run_case persist-pass "${executable}" --persist-result \
  "${work_dir}/pass.input.json" "${work_dir}/pass.result.json"
run_case verify-pass "${executable}" --verify-result "${work_dir}/pass.result.json"
run_case persist-fail "${executable}" --persist-result \
  "${work_dir}/fail.input.json" "${work_dir}/fail.result.json"
run_case verify-fail "${executable}" --verify-result "${work_dir}/fail.result.json"
run_case verify-absent "${executable}" --verify-result "${work_dir}/absent.result.json"

# Section 8.1/8.2 row 3 and the section 8.3 malformed rows, observed as process exits.
run_case persist-malformed-input "${executable}" --persist-result \
  "${work_dir}/malformed.input.json" "${work_dir}/malformed.result.out.json"
run_case verify-malformed-artifact "${executable}" --verify-result \
  "${work_dir}/malformed.result.json"
run_case verify-mutated-artifact "${executable}" --verify-result \
  "${work_dir}/mutated.result.json"

# Section 9.1: no environment variable, locale, or C7-looking name changes the bytes or status.
run_case persist-perturbed-environment env \
  LANG=en_US.UTF-8 \
  LC_ALL=en_US.UTF-8 \
  LC_NUMERIC=de_DE.UTF-8 \
  TZ=Pacific/Kiritimati \
  C7_ALGORITHM=bounded-bucket-v2 \
  C7_SEED=1 \
  PERSISTED_RESULT_STATUS=FAIL \
  ALIGN_LLM_TEMP_ROOT="${work_dir}/absent-root" \
  "${executable}" --persist-result \
  "${work_dir}/pass.input.json" "${work_dir}/perturbed.result.json"

python3 - "${work_dir}" <<'PY'
import sys
from pathlib import Path

work = Path(sys.argv[1])


def read(name: str, suffix: str) -> str:
    return (work / f"{name}.{suffix}").read_text(encoding="utf-8")


def code(name: str) -> int:
    return int(read(name, "code").strip())


def summary_block(status: str, expected: int, observed: int) -> str:
    return (
        "persisted-result:\n"
        "status:\n"
        f"{status}\n"
        "expected:\n"
        f"{expected}\n"
        "observed:\n"
        f"{observed}\n"
    )


failures: list[str] = []


def require(condition: bool, message: str) -> None:
    if not condition:
        failures.append(message)


# Unknown selectors keep the existing help path and exit 0 with no C7 output.
help_text = read("no-mode", "out")
require(code("no-mode") == 0, "no-mode did not exit 0")
require("--persist-result <input.json> <result.json>" in help_text, "help lacks --persist-result")
require("--verify-result <result.json>" in help_text, "help lacks --verify-result")
for name in ("unknown-selector", "unknown-prefix"):
    require(code(name) == 0, f"{name} did not exit 0")
    require(read(name, "out") == help_text, f"{name} did not print the current help block")

# Arity, selector-conflict, path-overlap, path-bound, and malformed-document rejections. Section
# 8.3 makes every one of these an `Error.Invalid` row, and `Error.Invalid` is process exit 2, so the
# assertion is the exact code and not merely "nonzero": the malformed rows exit 1 without the
# section 8.1 row-3 typed `map_err`, which a nonzero check would not have caught.
rejected_invalid = (
    "persist-no-operand",
    "persist-one-operand",
    "persist-extra-operand",
    "verify-no-operand",
    "verify-extra-operand",
    "persist-selector-as-input",
    "persist-selector-as-output",
    "verify-selector-as-operand",
    "same-path",
    "path-over-bound",
    "persist-malformed-input",
    "verify-malformed-artifact",
    "verify-mutated-artifact",
)
for name in rejected_invalid:
    require(code(name) == 2, f"{name} exited {code(name)}, expected 2 (Error.Invalid)")
    require(read(name, "out") == "", f"{name} printed a summary block")

# Section 8.1/8.2 row 2: a genuinely absent file stays the mapped filesystem error, which is
# `Error.NotFound` and process exit 1. This is the negative control for the row-3 mapping above.
require(code("verify-absent") == 1, f"verify-absent exited {code('verify-absent')}, expected 1")
require(read("verify-absent", "out") == "", "verify-absent printed a summary block")

# Section 3.2 path bound: the 4,096-byte destination is accepted by row 1 and reaches the
# filesystem, which rejects it with the host's own `PATH_MAX` errno (63 on Darwin, 36 on Linux).
# The observable claim is that it is neither a success nor the row-1 `Error.Invalid` exit 2.
at_bound = code("path-at-bound")
require(
    at_bound not in (0, 2),
    f"path-at-bound exited {at_bound}; a 4,096-byte destination must pass path validation and "
    "reach the filesystem",
)
require(read("path-at-bound", "out") == "", "path-at-bound printed a summary block")

for absent in (
    "arity.result.json",
    "conflict.result.json",
    "absent.result.json",
    "malformed.result.out.json",
):
    require(not (work / absent).exists(), f"{absent} was created by a rejected invocation")
require(
    (work / "pass.input.json").read_bytes() == (work / "pass.input.control.json").read_bytes(),
    "the same-path invocation modified its input",
)

# PASS: exit 0, exact summary block, canonical artifact.
require(code("persist-pass") == 0, "persist-pass did not exit 0")
require(read("persist-pass", "out") == summary_block("PASS", 2, 2), "persist-pass summary mismatch")
require(code("verify-pass") == 0, "verify-pass did not exit 0")
require(read("verify-pass", "out") == summary_block("PASS", 2, 2), "verify-pass summary mismatch")
require(
    (work / "pass.result.json").read_bytes() == (work / "pass.expected.json").read_bytes(),
    "the PASS artifact bytes are not canonical",
)

# Valid semantic FAIL: the artifact is written and reloaded, the summary is printed, and only then
# does the CLI take the existing Error.Invalid exit.
require(code("persist-fail") == 2, f"persist-fail exited {code('persist-fail')}, expected 2")
require(read("persist-fail", "out") == summary_block("FAIL", 2, 1), "persist-fail summary mismatch")
require(code("verify-fail") == 2, f"verify-fail exited {code('verify-fail')}, expected 2")
require(read("verify-fail", "out") == summary_block("FAIL", 2, 1), "verify-fail summary mismatch")
require(
    (work / "fail.result.json").read_bytes() == (work / "fail.expected.json").read_bytes(),
    "the FAIL artifact bytes are not canonical",
)

# Section 9.1 option/environment isolation: identical summary and identical bytes.
require(code("persist-perturbed-environment") == 0, "the perturbed environment changed the status")
require(
    read("persist-perturbed-environment", "out") == summary_block("PASS", 2, 2),
    "the perturbed environment changed the summary",
)
require(
    (work / "perturbed.result.json").read_bytes() == (work / "pass.expected.json").read_bytes(),
    "the perturbed environment changed the published bytes",
)

if failures:
    raise SystemExit(
        "c7 persisted result cli smoke failed:\n  " + "\n  ".join(failures)
    )

print(
    "c7 persisted result cli smoke: help compatibility, exact arity, selector-conflict, same-path "
    "and path-bound rejection, exact exit 2 for every section 8.3 Invalid row including the three "
    "malformed-document rows, exit 1 for the absent-file filesystem row, stable PASS/FAIL "
    "summaries with their exits, and environment isolation PASS"
)
PY
