#!/usr/bin/env python3
"""Owner smoke for `scripts/prompt-measurement-adapter.py`: admission, handoff, parameterization.

The adapter's sealed-input machinery is Linux-only — it needs `memfd_create`, `F_ADD_SEALS`,
`/proc/self/fd`, and `PR_SET_CHILD_SUBREAPER`. On a host without them this smoke verifies every row
that does not require a launch and prints a documented SKIP for the rest, exactly as the shipped
`prompt-evaluate-smoke` degrades. A full-fidelity run is a Linux run.
"""

from __future__ import annotations

import hashlib
import importlib.util
import json
import os
import signal
import subprocess
import sys
import tempfile
import time
from collections.abc import Mapping
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parent.parent
ADAPTER = ROOT / "scripts" / "prompt-measurement-adapter.py"
LINUX = sys.platform.startswith("linux")

# The Git fixture's child PATH is selected by a coherent profile, never interpolated from the
# environment. The fresh aggregate stages its authenticated tools under one root and puts only that
# root on PATH, so a hard-coded host PATH leaves `git` unresolvable inside it; but a caller-supplied
# PATH string would let any environment redirect the fixture's `git`. `scripts/check-baseline-chain`
# resolves its own Git child PATH exactly this way: the complete fresh marker set selects the
# literal staged tool root, an environment carrying none of those variables selects the fixed host
# directories, and any partial or unexpected combination is refused rather than trusted.
FRESH_MARKER = "ALIGN_LLM_FRESH_COMPILER"
TOOL_ROOT = "ALIGN_LLM_TOOL_ROOT"
FRESH_TOOL_PATH = "/tools"
HOST_TOOL_PATH = "/usr/bin:/bin"


class FixtureProfileError(RuntimeError):
    """The fresh tool-root profile for the Git fixture is neither absent nor complete."""


def fixture_tool_path(values: Mapping[str, str] | None = None) -> str:
    """Select the Git fixture's child PATH from the fresh profile, without interpolating it."""
    values = os.environ if values is None else values
    marker = values.get(FRESH_MARKER)
    tool_root = values.get(TOOL_ROOT)
    if marker is None and tool_root is None:
        return HOST_TOOL_PATH
    if marker == "1" and tool_root == FRESH_TOOL_PATH:
        return FRESH_TOOL_PATH
    raise FixtureProfileError(
        "the fresh tool-root profile for the Git fixture is incomplete: "
        f"{FRESH_MARKER}={marker!r}, {TOOL_ROOT}={tool_root!r}"
    )


# The Git fixture must not start background work. `git commit` runs auto maintenance, and a recent
# Git detaches that run *before* it decides whether any task is due, so even a one-object
# repository forks a process that is orphaned immediately. Git 2.47 does this and Git 2.39 does
# not, which is why the row below failed only on a host carrying a recent Git. Loading the adapter
# enables `PR_SET_CHILD_SUBREAPER` on this harness process, so this process adopts that orphan
# and — never having waited for it — keeps it as a zombie for the rest of the run. The
# `post-admission-replacement` row runs the adapter inside this process, where an adopted zombie is
# indistinguishable from a descendant the generation child left behind and fails the containment
# check. Refusing background maintenance keeps the harness's own process tree exactly what it
# spawned, which is what that row must present to the adapter.
NO_BACKGROUND_MAINTENANCE = ("-c", "gc.auto=0", "-c", "maintenance.auto=false")

RENDERED_TEXT = "Repair round_to_minutes so an exact half minute rounds away from zero."

# The launch rows drive the adapter against a real pinned corpus fixture, because the settled
# response format is whole-file content and the synthesized patch is only meaningful against the
# exact pinned bytes the validation runner will check out.
FIXTURE_SOURCE_DIR = "eval/fixtures/prompt-v1-duration-rounding/repository"
FIXTURE_EDIT_PATH = "src/duration.py"
EDITED_CONTENT = (
    '"""Billable duration helpers."""\n'
    "\n"
    "import math\n"
    "\n"
    "\n"
    "def round_to_minutes(seconds: int) -> int:\n"
    '    """Round a whole-second duration to whole minutes."""\n'
    "    return math.trunc(seconds / 60 + math.copysign(0.5, seconds))\n"
)
# One complete generation response in the settled format, with prose on both sides.
RESPONSE_TEXT = (
    "Here is the repair.\n\n"
    f"FILE: {FIXTURE_EDIT_PATH}\n"
    "```python\n"
    f"{EDITED_CONTENT}"
    "```\n\n"
    "That makes the tie round away from zero.\n"
)


def task_definition(identity: str) -> dict:
    return {
        "schema_version": 1,
        "id": identity,
        "source_dir": FIXTURE_SOURCE_DIR,
        "allowed_edits": [FIXTURE_EDIT_PATH],
        "validation_argv": ["python3", "tests/test_duration.py", "-v"],
        "validation_timeout_seconds": 10,
    }


def expected_patch() -> str:
    """The whole-file-replacement hunk, rebuilt here independently of the adapter."""
    old = (ROOT / FIXTURE_SOURCE_DIR / FIXTURE_EDIT_PATH).read_text(encoding="utf-8")
    old_lines = old.split("\n")[:-1] if old.endswith("\n") else old.split("\n")
    new_lines = EDITED_CONTENT.split("\n")[:-1]
    return (
        f"diff --git a/{FIXTURE_EDIT_PATH} b/{FIXTURE_EDIT_PATH}\n"
        f"--- a/{FIXTURE_EDIT_PATH}\n"
        f"+++ b/{FIXTURE_EDIT_PATH}\n"
        f"@@ -1,{len(old_lines)} +1,{len(new_lines)} @@\n"
        + "".join(f"-{line}\n" for line in old_lines)
        + "".join(f"+{line}\n" for line in new_lines)
    )


def canonical(value: Any) -> bytes:
    return json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode("utf-8")


def digest_bytes(value: Any) -> bytes:
    def omit_none(item: Any) -> Any:
        if isinstance(item, dict):
            return {key: omit_none(child) for key, child in item.items() if child is not None}
        if isinstance(item, list):
            return [omit_none(child) for child in item]
        return item

    return canonical(omit_none(value))


def bind(value: dict) -> dict:
    value["content_sha256"] = ""
    value["content_sha256"] = hashlib.sha256(digest_bytes(value)).hexdigest()
    return value


def store(path: Path, value: dict) -> dict:
    bind(value)
    path.write_bytes(canonical(value))
    return value


def raw_digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def require(condition: bool, message: str) -> None:
    if not condition:
        raise RuntimeError(message)


def reap_adopted_children() -> None:
    """Wait for every orphan this harness process has adopted, and for nothing else.

    Loading the adapter enables `PR_SET_CHILD_SUBREAPER` here, so this process inherits any orphan
    a child leaves behind and an inherited orphan that exits stays a zombie until this process
    waits for it. Reaping is the adopter's duty, and the only in-process row must not hand the
    adapter a process tree carrying one. Every call site is a point where no launched child of this
    harness is still running, so this waits for adopted processes only.
    """
    while True:
        try:
            pid, _ = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            return
        if pid == 0:
            return


def load_adapter():
    spec = importlib.util.spec_from_file_location("prompt_measurement_adapter", ADAPTER)
    require(spec is not None and spec.loader is not None, "measurement adapter could not be loaded")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


class Fixture:
    """One complete adapter invocation: declared artifacts, a synthetic child, and a runner."""

    def __init__(self, root: Path, name: str) -> None:
        self.name = name
        self.root = root / name
        self.workspace = self.root / "workspace"
        self.workspace.mkdir(parents=True)
        self.variant_path = self.root / "variant.json"
        self.rendered_path = self.root / "rendered.json"
        self.policy_path = self.root / "generation.json"
        self.control_path = self.root / "control.json"
        self.request_path = self.root / "adapter-request.json"
        self.result_path = self.workspace / "measurement.json"
        self.child_path = self.root / "generation-child"
        self.runner_path = self.root / "validation-runner.py"
        self.task_path = self.root / "task-definition.json"
        self.marker = self.root / "replacement-ran"

        self.variant = store(self.variant_path, {
            "schema_version": 1, "artifact_kind": "PROMPT_VARIANT", "variant_id": "baseline-v1",
            "base_prompt": {}, "repo_prompt": {}, "learned_prompt_append": "",
            "context_policy": {}, "candidate_id": "baseline-v1", "content_sha256": "",
        })
        self.rendered = store(self.rendered_path, {
            "schema_version": 1, "artifact_kind": "RENDERED_PROMPT", "task_id": "task",
            "variant_id": "baseline-v1", "variant_sha256": self.variant["content_sha256"],
            "task_prompt_sha256": "1" * 64, "context_sources_sha256": "2" * 64,
            "text": RENDERED_TEXT, "content_sha256": "",
        })
        self.control = store(self.control_path, {
            "schema_version": 1, "artifact_kind": "EVALUATION_PROVIDER_CONTROL",
            "provider_control_id": "control", "provider_kind": "LOCAL_OPENAI",
            "endpoint": "http://127.0.0.1:8000/v1/chat/completions", "endpoint_id": "fixture",
            "model": "fixture-model", "api_key_env": None, "tokenize_endpoint": None,
            "timeout_ns": 20_000_000_000, "max_response_bytes": 262_144, "content_sha256": "",
        })
        self.policy = store(self.policy_path, {
            "schema_version": 1, "artifact_kind": "GENERATION_POLICY",
            "generation_policy_id": "policy", "evaluation_provider_kind": "LOCAL_OPENAI",
            "evaluation_provider_endpoint_id": "fixture", "evaluation_provider_model": "fixture-model",
            "provider_control_sha256": self.control["content_sha256"],
            "provider_service_revision": "fixture-v1", "max_prompt_bytes": 65_536,
            "max_tokens": 512, "temperature_micros": 0, "seed_mode": "PAIRED_FIXED",
            "seed_base": 100, "content_sha256": "",
        })
        self.task_path.write_bytes(canonical(task_definition("task")))
        self.write_child()
        self.write_runner()

    def write_child(
        self, *, exit_code: int = 0, body: str | None = None, sleep: float = 0.0,
        content: str | None = None, prologue: str = "",
    ) -> None:
        """A synthetic generation child with exactly the `./main prompt generate` boundary.

        The real child is `src/prompt_generate.align`, whose own end-to-end behaviour is owned by
        `prompt-generate-smoke`. This synthetic child exists so the handoff failure rows —
        truncation, nonzero exit, timeout — are deterministic and platform-independent.

        `prologue` runs before anything else in the child. It is how a containment row shapes this
        child's own process tree before the adapter inspects it.
        """
        response = (
            body if body is not None
            else "json.dumps(response, ensure_ascii=False, separators=(',', ':'))"
        )
        self.child_path.write_text(
            "#!/usr/bin/env python3\n"
            "import hashlib, json, os, sys, time\n"
            + prologue
            + f"time.sleep({sleep!r})\n"
            "request = json.loads(open(sys.argv[3], encoding='utf-8').read())\n"
            "response = {\n"
            "  'schema_version': 1, 'artifact_kind': 'PROMPT_GENERATION_RESPONSE',\n"
            "  'request_id': request['request_id'], 'status': 'GENERATED', 'error_code': 'NONE',\n"
            "  'error': '', 'provider_kind': request['provider_kind'],\n"
            "  'provider_model': request['provider_model'],\n"
            "  'provider_request_sha256': hashlib.sha256(b'dispatched-bytes').hexdigest(),\n"
            "  'seed_result': 'APPLIED', 'applied_seed': request['paired_seed'],\n"
            "  'http_status': 200, 'content': " + repr(content if content is not None else RESPONSE_TEXT) + ",\n"
            "  'dispatch_start_ns': 1, 'dispatch_end_ns': 2, 'content_sha256': '',\n"
            "}\n"
            "response['content_sha256'] = hashlib.sha256(\n"
            "  json.dumps(response, ensure_ascii=False, separators=(',', ':')).encode()).hexdigest()\n"
            f"open(sys.argv[4], 'w', encoding='utf-8').write({response})\n"
            f"raise SystemExit({exit_code})\n",
            encoding="utf-8",
        )
        self.child_path.chmod(0o755)

    def write_runner(self, *, expect_patch: str | None = None, exit_code: int | None = None) -> None:
        """A validation runner that proves the sealed task definition and patch reached it."""
        if exit_code is not None:
            self.runner_path.write_text(f"raise SystemExit({exit_code})\n", encoding="utf-8")
            return
        self.runner_path.write_text(
            "import sys\n"
            "from pathlib import Path\n"
            "task = Path(sys.argv[2]).read_text()\n"
            "patch = Path(sys.argv[3]).read_text()\n"
            "valid = task == " + repr(canonical(task_definition("task")).decode("utf-8"))
            + " and patch == "
            + repr(expect_patch if expect_patch is not None else expected_patch()) + "\n"
            "raise SystemExit(0 if valid else 4)\n",
            encoding="utf-8",
        )

    def request(self, **overrides: Any) -> dict:
        value = {
            "schema_version": 1, "artifact_kind": "TASK_ADAPTER_REQUEST",
            "evaluation_id": "evaluation", "task_id": "task", "sample_index": 1,
            "variant": "CANDIDATE", "variant_path": str(self.variant_path),
            "variant_sha256": self.variant["content_sha256"],
            "rendered_prompt_path": str(self.rendered_path),
            "rendered_prompt_sha256": self.rendered["content_sha256"],
            "generation_policy_path": str(self.policy_path),
            "generation_policy_sha256": self.policy["content_sha256"],
            "provider_control_path": str(self.control_path),
            "provider_control_sha256": self.control["content_sha256"],
            "workspace_path": str(self.workspace), "result_path": str(self.result_path),
            "paired_seed": 100, "credential_env_name": None,
            "environment_policy_sha256": "3" * 64,
            "validation_runner_path": str(self.runner_path),
            "validation_runner_sha256": raw_digest(self.runner_path),
            "task_definition_path": str(self.task_path),
            "task_definition_sha256": raw_digest(self.task_path),
            "validation_argv": ["--retained-inputs", "%TASK%", "%PATCH%"],
            "patch_path": None, "patch_sha256": None,
            "generation_child_path": str(self.child_path),
            "generation_child_sha256": raw_digest(self.child_path),
            "task_deadline_ns": 30_000_000_000,
            "content_sha256": "",
        }
        value.update(overrides)
        bind(value)
        self.request_path.write_bytes(canonical(value))
        return value

    def invoke(self, timeout: int = 120) -> tuple[subprocess.CompletedProcess[bytes], dict | None]:
        completed = subprocess.run(
            [
                sys.executable, str(ADAPTER),
                "--prompt-variant", str(self.variant_path),
                "--rendered-prompt", str(self.rendered_path),
                "--sample-index", "1", "--paired-seed", "100",
                "--adapter-request", str(self.request_path),
                "--result", str(self.result_path),
            ],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, timeout=timeout,
        )
        result = (
            json.loads(self.result_path.read_text(encoding="utf-8"))
            if self.result_path.exists() else None
        )
        return completed, result


def assert_not_scoreable(name: str, result: dict | None, failure_kind: str) -> None:
    require(result is not None, f"{name}: no measurement document was written")
    require(
        result["status"] == "ERROR" and result["failure_kind"] == failure_kind,
        f"{name}: expected ERROR/{failure_kind}, got {result['status']}/{result['failure_kind']}"
        f" ({result['diagnostic_summary']!r})",
    )
    require(
        result["generation_to_passing_patch_ns"] is None
        and result["benchmark_regression_ppm"] is None,
        f"{name}: an ERROR row carried a scoreable time",
    )
    require(
        result["build_status"] == "ERROR" and result["test_status"] == "ERROR",
        f"{name}: an ERROR row carried a non-error stage state",
    )
    claimed = result["content_sha256"]
    recomputed = dict(result)
    recomputed["content_sha256"] = ""
    require(
        hashlib.sha256(digest_bytes(recomputed)).hexdigest() == claimed,
        f"{name}: measurement content digest does not bind the record",
    )


def status_field(pid: int, field: str) -> str:
    """Return one `/proc/PID/status` field value."""
    return next(
        line for line in Path(f"/proc/{pid}/status").read_text().splitlines()
        if line.startswith(field)
    ).split()[1]


def fork_zombie_leader() -> int:
    """Fork a child that becomes a zombie thread-group leader with a live worker thread.

    The child starts a worker thread and then leaves its own leader thread through
    `pthread_exit`, which the kernel takes as a plain thread exit rather than a group exit.
    A leader cannot be released while its group still holds a task, so it stays in
    `State: Z` with `Threads: 2` while the worker keeps executing. That is the reviewer's
    reproduction of a zombie entry that is still a live process. It is the portable
    construction: it needs no architecture syscall table and no compiler at test time, and
    it was verified on `x86_64` and `aarch64` glibc CPython.
    """
    child = os.fork()
    if child == 0:
        try:
            import ctypes
            import threading

            running = threading.Event()

            def worker() -> None:
                running.set()
                time.sleep(600)

            threading.Thread(target=worker, daemon=True).start()
            running.wait(5.0)
            ctypes.CDLL(None).pthread_exit(None)
        except BaseException:
            pass
        os._exit(97)
    return child


def await_zombie_leader(pid: int) -> None:
    """Block until `pid` is a zombie leader whose group still holds another task."""
    deadline = time.monotonic() + 5.0
    state, tasks = "", ""
    while time.monotonic() < deadline:
        try:
            state = status_field(pid, "State:")
            tasks = status_field(pid, "Threads:")
        except (OSError, StopIteration):
            break
        if state == "Z" and tasks != "1":
            return
        time.sleep(0.01)
    raise RuntimeError(
        f"the synthetic zombie leader never reached State Z with a live task: {state!r}/{tasks!r}"
    )


def unit_rows(module) -> list[str]:
    """Rows that need no launch: request admission, field order, and the response contract."""
    covered: list[str] = []
    require(
        module.REQUEST_FIELDS[23:] == (
            "validation_argv", "patch_path", "patch_sha256", "generation_child_path",
            "generation_child_sha256", "task_deadline_ns", "content_sha256",
        ),
        "the task-parameterization fields are not appended before content_sha256",
    )
    require(
        module.REQUEST_FIELDS[18:24] == (
            "environment_policy_sha256", "validation_runner_path", "validation_runner_sha256",
            "task_definition_path", "task_definition_sha256", "validation_argv",
        ),
        "the extended adapter request field order changed",
    )
    covered.append("request-field-order")

    # The `EvaluationInputIdentity.adapter_request_sha256` preimage is the canonical request with an
    # empty digest field, so the golden below is the exact preimage both owners must agree on.
    golden = {name: None for name in module.REQUEST_FIELDS}
    golden.update({
        "schema_version": 1, "artifact_kind": "TASK_ADAPTER_REQUEST", "evaluation_id": "e",
        "task_id": "t", "sample_index": 1, "variant": "CANDIDATE", "variant_path": "/v",
        "variant_sha256": "a" * 64, "rendered_prompt_path": "/r", "rendered_prompt_sha256": "b" * 64,
        "generation_policy_path": "/g", "generation_policy_sha256": "c" * 64,
        "provider_control_path": "/p", "provider_control_sha256": "d" * 64,
        "workspace_path": "/w", "result_path": "/m", "paired_seed": 1,
        "credential_env_name": None, "environment_policy_sha256": "e" * 64,
        "validation_runner_path": "/runner", "validation_runner_sha256": "f" * 64,
        "task_definition_path": "/task", "task_definition_sha256": "0" * 64,
        "validation_argv": ["--retained-inputs", "%TASK%", "%PATCH%"],
        "patch_path": None, "patch_sha256": None, "generation_child_path": "/child",
        "generation_child_sha256": "1" * 64, "task_deadline_ns": 30_000_000_000,
        "content_sha256": "",
    })
    expected_preimage = (
        '{"schema_version":1,"artifact_kind":"TASK_ADAPTER_REQUEST","evaluation_id":"e",'
        '"task_id":"t","sample_index":1,"variant":"CANDIDATE","variant_path":"/v",'
        '"variant_sha256":"' + "a" * 64 + '","rendered_prompt_path":"/r",'
        '"rendered_prompt_sha256":"' + "b" * 64 + '","generation_policy_path":"/g",'
        '"generation_policy_sha256":"' + "c" * 64 + '","provider_control_path":"/p",'
        '"provider_control_sha256":"' + "d" * 64 + '","workspace_path":"/w","result_path":"/m",'
        '"paired_seed":1,"environment_policy_sha256":"' + "e" * 64 + '",'
        '"validation_runner_path":"/runner","validation_runner_sha256":"' + "f" * 64 + '",'
        '"task_definition_path":"/task","task_definition_sha256":"' + "0" * 64 + '",'
        '"validation_argv":["--retained-inputs","%TASK%","%PATCH%"],'
        '"generation_child_path":"/child","generation_child_sha256":"' + "1" * 64 + '",'
        '"task_deadline_ns":30000000000,"content_sha256":""}'
    )
    require(
        module.canonical_digest_bytes(golden).decode("utf-8") == expected_preimage,
        "the extended adapter request digest preimage changed:\n"
        f"  {module.canonical_digest_bytes(golden).decode('utf-8')}",
    )
    covered.append("adapter-request-preimage")

    # The two-process handoff contract: every malformed response shape is a failed handoff.
    with tempfile.TemporaryDirectory(prefix="prompt-measurement-unit-") as directory:
        scratch = Path(directory).resolve()
        good = {
            "schema_version": 1, "artifact_kind": "PROMPT_GENERATION_RESPONSE", "request_id": "r",
            "status": "GENERATED", "error_code": "NONE", "error": "", "provider_kind": "LOCAL_OPENAI",
            "provider_model": "m", "provider_request_sha256": "a" * 64, "seed_result": "APPLIED",
            "applied_seed": 100, "http_status": 200, "content": RESPONSE_TEXT,
            "dispatch_start_ns": 1, "dispatch_end_ns": 2, "content_sha256": "",
        }
        bind(good)
        accepted = scratch / "good.json"
        accepted.write_bytes(canonical(good))
        module.validated_generation_response(accepted, 100)
        covered.append("handoff-accepts-valid-response")

        rows = (
            ("handoff-absent-response", None),
            ("handoff-truncated-response", canonical(good)[: len(canonical(good)) // 2]),
            ("handoff-tampered-digest", canonical({**good, "applied_seed": 101})),
            ("handoff-reordered-fields", canonical(
                {"artifact_kind": "PROMPT_GENERATION_RESPONSE", **good}
            )),
            ("handoff-non-generated-status", canonical(bind({
                **good, "status": "PROVIDER_ERROR", "error_code": "PROVIDER_TIMEOUT",
            }))),
            ("handoff-missing-content", canonical(bind(
                {key: child for key, child in good.items() if key != "content"}
            ))),
            ("handoff-wrong-seed", canonical(bind({**good, "applied_seed": 101}))),
            ("handoff-applied-seed-on-unsupported", canonical(bind({
                **good, "seed_result": "UNSUPPORTED",
            }))),
            ("handoff-unknown-seed-result", canonical(bind({**good, "seed_result": "MAYBE"}))),
            ("handoff-bad-request-digest", canonical(bind({
                **good, "provider_request_sha256": "not-a-digest",
            }))),
        )
        for name, payload in rows:
            path = scratch / f"{name}.json"
            if payload is not None:
                path.write_bytes(payload)
            try:
                module.validated_generation_response(path, 100)
            except module.GenerationFailure:
                covered.append(name)
                continue
            raise RuntimeError(f"{name}: a failed handoff was accepted")

    # A `FIXTURE` control never dispatches a model provider, so this adapter never admits it.
    require("FIXTURE" in ADAPTER.read_text(encoding="utf-8"), "the FIXTURE rejection was removed")
    covered.append("fixture-control-rejected")
    covered += edit_format_rows(module)
    covered += redaction_order_rows(module)
    covered += deadline_rows(module)
    covered += fixture_path_rows()
    return covered


def fixture_path_rows() -> list[str]:
    """The Git fixture's child PATH comes from a coherent profile in both directions."""
    covered: list[str] = []
    require(fixture_tool_path({}) == HOST_TOOL_PATH, "an absent profile lost the host PATH")
    require(
        fixture_tool_path({"HOME": "/somewhere", "PATH": "/injected"}) == HOST_TOOL_PATH,
        "an unrelated environment stopped selecting the host PATH",
    )
    covered.append("fixture-path-absent-profile")
    require(
        fixture_tool_path({FRESH_MARKER: "1", TOOL_ROOT: FRESH_TOOL_PATH}) == FRESH_TOOL_PATH,
        "the complete fresh profile lost the staged tool root",
    )
    covered.append("fixture-path-fresh-profile")
    partials = (
        ("fixture-path-marker-only", {FRESH_MARKER: "1"}),
        ("fixture-path-root-only", {TOOL_ROOT: FRESH_TOOL_PATH}),
        ("fixture-path-wrong-marker", {FRESH_MARKER: "0", TOOL_ROOT: FRESH_TOOL_PATH}),
        # The environment may never supply the PATH string itself, only match the pinned profile.
        ("fixture-path-untrusted-root", {FRESH_MARKER: "1", TOOL_ROOT: "/attacker:/usr/bin"}),
    )
    for name, values in partials:
        try:
            selected = fixture_tool_path(values)
        except FixtureProfileError:
            covered.append(name)
            continue
        raise RuntimeError(f"{name}: an incoherent profile selected {selected!r}")
    return covered


def deadline_rows(module) -> list[str]:
    """The task deadline is a declared request field and is validated before any launch."""
    covered: list[str] = []
    require(
        module.REQUEST_FIELDS.index("task_deadline_ns") == len(module.REQUEST_FIELDS) - 2,
        "the task deadline is not appended immediately before content_sha256",
    )
    covered.append("task-deadline-field-order")
    with tempfile.TemporaryDirectory(prefix="prompt-measurement-deadline-") as directory:
        scratch = Path(directory).resolve()
        fixture = Fixture(scratch, "deadline-admission")
        for label, value in (("zero", 0), ("negative", -1), ("non-integer", "30"), ("boolean", True)):
            request = fixture.request()
            request["task_deadline_ns"] = value
            bind(request)
            fixture.request_path.write_bytes(canonical(request))
            try:
                module.load_request(fixture.request_path)
            except module.AdapterError:
                covered.append(f"task-deadline-{label}")
                continue
            raise RuntimeError(f"task-deadline-{label}: an invalid task deadline was admitted")
        request = fixture.request()
        require(
            module.load_request(fixture.request_path)["task_deadline_ns"]
            == request["task_deadline_ns"],
            "task-deadline-admitted: a valid task deadline was not decoded",
        )
        covered.append("task-deadline-admitted")
    return covered


def redaction_order_rows(module) -> list[str]:
    """Redaction runs before every truncation, including the ones a boundary can split."""
    covered: list[str] = []
    secret = "sk-.*+?[a-z]$-SECRET"
    raw = secret.encode("utf-8")

    # A credential split across two reads must still be redacted: the capture holds back the bytes
    # that can still begin an occurrence instead of admitting a prefix that nothing can match later.
    capture = module.BoundedCapture(secret)
    capture.append(b"before " + raw[:5])
    capture.append(raw[5:] + b" after")
    observed = capture.bytes()
    require(
        raw not in observed and observed == b"before [REDACTED] after",
        f"boundary-split credential survived the capture: {observed!r}",
    )
    covered.append("redact-split-chunk")

    # A credential straddling the diagnostic bound must be redacted before the bound applies, so no
    # prefix of it can be retained by the truncation.
    capture = module.BoundedCapture(secret)
    filler = b"x" * (module.DIAGNOSTIC_LIMIT - len(raw) // 2)
    capture.append(filler + raw + b"tail")
    observed = capture.bytes()
    require(
        raw not in observed and not any(
            observed.endswith(raw[:index]) for index in range(1, len(raw))
        ),
        "a credential straddling the diagnostic bound was truncated before redaction",
    )
    require(observed.endswith(module.TRUNCATION_MARKER), "the bounded capture lost its marker")
    covered.append("redact-before-truncation-bound")

    # An empty credential is the ordinary `api_key_env: None` path and changes nothing.
    plain = module.BoundedCapture(None)
    plain.append(b"ordinary output\n")
    require(plain.bytes() == b"ordinary output\n", "the uncredentialed capture altered its bytes")
    covered.append("redact-empty-pattern")

    # Every diagnostic string is redacted before it is sliced to the diagnostic bound.
    detail = "failed: " + secret * 4_000
    bounded = module.bounded_diagnostic(detail, secret)
    require(
        raw not in bounded and len(bounded) <= module.DIAGNOSTIC_LIMIT,
        "a diagnostic string was truncated before redaction",
    )
    covered.append("redact-bounded-diagnostic")

    # The same order holds for the byte helper the nonzero-exit detail slice uses.
    prefix = b"y" * 250
    reduced = module.redacted_bytes(prefix + raw, secret)[:256]
    require(raw not in reduced, "the child-exit detail was sliced before redaction")
    covered.append("redact-child-exit-detail")
    return covered


def edit_format_rows(module) -> list[str]:
    """The settled section 11.3 whole-file response format: parse, allowlist, and synthesized diff.

    These rows need no launch, so the response contract is fully covered on every host.
    """
    covered: list[str] = []
    allowed = ("src/one.py", "src/two.py")

    accepted = (
        (
            "blocks-single",
            "FILE: src/one.py\n```\nalpha\n```\n",
            [("src/one.py", "alpha\n")],
        ),
        (
            "blocks-multiple",
            "FILE: src/one.py\n```\nalpha\n```\nFILE: src/two.py\n```\nbeta\ngamma\n```\n",
            [("src/one.py", "alpha\n"), ("src/two.py", "beta\ngamma\n")],
        ),
        (
            "blocks-language-tag",
            "FILE: src/one.py\n```python\nalpha\n```\n",
            [("src/one.py", "alpha\n")],
        ),
        (
            "blocks-surrounding-prose",
            "Sure! Here is the change you asked for.\n\nFILE: src/one.py\n\nHere it is:\n\n"
            "```python\nalpha\n```\n\nLet me know if you want anything else.\n",
            [("src/one.py", "alpha\n")],
        ),
        (
            "blocks-nested-fence",
            "FILE: src/one.py\n````python\nDOC = '''\n```\nnested\n```\n'''\n````\n",
            [("src/one.py", "DOC = '''\n```\nnested\n```\n'''\n")],
        ),
        (
            "blocks-crlf-and-decorated-header",
            "**FILE: `src/one.py`**\r\n```python\r\nalpha\r\n```\r\n",
            [("src/one.py", "alpha\n")],
        ),
        (
            "blocks-dot-slash-path",
            "FILE: ./src/one.py\n```\nalpha\n```\n",
            [("src/one.py", "alpha\n")],
        ),
        (
            "blocks-empty-body",
            "FILE: src/one.py\n```\n```\n",
            [("src/one.py", "")],
        ),
    )
    for name, response, expected in accepted:
        observed = module.validated_edit_set(response, allowed)
        require(observed == expected, f"{name}: parsed {observed!r}, expected {expected!r}")
        covered.append(name)

    refused = (
        ("blocks-absent", "I cannot help with that.\n", module.EditFormatError),
        ("blocks-prose-only-fence", "```python\nalpha\n```\n", module.EditFormatError),
        ("blocks-unterminated", "FILE: src/one.py\n```python\nalpha\n", module.EditFormatError),
        ("blocks-header-without-block", "FILE: src/one.py\nFILE: src/two.py\n```\nbeta\n```\n",
         module.EditFormatError),
        ("blocks-duplicate-path", "FILE: src/one.py\n```\na\n```\nFILE: src/one.py\n```\nb\n```\n",
         module.EditFormatError),
        ("blocks-outside-allowlist", "FILE: src/legacy.py\n```\nalpha\n```\n", module.PolicyViolation),
        ("blocks-absolute-path", "FILE: /etc/passwd\n```\nalpha\n```\n", module.PolicyViolation),
        ("blocks-escaping-path", "FILE: ../outside.py\n```\nalpha\n```\n", module.PolicyViolation),
    )
    for name, response, expected_error in refused:
        try:
            module.validated_edit_set(response, allowed)
        except expected_error:
            covered.append(name)
            continue
        raise RuntimeError(f"{name}: an invalid edit set was accepted")

    # The synthesized hunk is a plain whole-file replacement, and it really applies: the row builds
    # a pinned checkout with the exact fixture recipe and runs `git apply` over the adapter's bytes.
    with tempfile.TemporaryDirectory(prefix="prompt-measurement-diff-") as directory:
        scratch = Path(directory).resolve()
        source = scratch / "source"
        (source / "src").mkdir(parents=True)
        (source / "src" / "one.py").write_text("alpha\nbeta\n", encoding="utf-8")
        golden = (
            "diff --git a/src/one.py b/src/one.py\n"
            "--- a/src/one.py\n"
            "+++ b/src/one.py\n"
            "@@ -1,2 +1,1 @@\n"
            "-alpha\n"
            "-beta\n"
            "+gamma\n"
        )
        raw = module.synthesized_patch([("src/one.py", "gamma\n")], source)
        require(raw.decode("utf-8") == golden, f"diff-golden: {raw.decode('utf-8')!r}")
        covered.append("diff-golden")

        environment = {
            "HOME": str(scratch), "PATH": fixture_tool_path(), "GIT_CONFIG_NOSYSTEM": "1",
            "GIT_CONFIG_GLOBAL": os.devnull, "LC_ALL": "C",
            "GIT_AUTHOR_NAME": "smoke", "GIT_AUTHOR_EMAIL": "smoke@invalid",
            "GIT_COMMITTER_NAME": "smoke", "GIT_COMMITTER_EMAIL": "smoke@invalid",
        }
        for argv in (
            ["init", "-q", "--initial-branch=main"],
            ["add", "--all"],
            ["commit", "-q", "-m", "fixture"],
        ):
            subprocess.run(
                ["git", *NO_BACKGROUND_MAINTENANCE, *argv],
                cwd=source, env=environment, check=True, capture_output=True,
            )
        patch_path = scratch / "candidate.patch"
        patch_path.write_bytes(raw)
        applied = subprocess.run(
            ["git", *NO_BACKGROUND_MAINTENANCE, "apply", str(patch_path)],
            cwd=source, env=environment, capture_output=True,
        )
        require(
            applied.returncode == 0
            and (source / "src" / "one.py").read_text(encoding="utf-8") == "gamma\n",
            f"diff-applies: git apply refused the synthesized patch: {applied.stderr!r}",
        )
        covered.append("diff-applies")

        # A response that reproduces the pinned bytes changes nothing and is not a patch.
        (source / "src" / "one.py").write_text("alpha\nbeta\n", encoding="utf-8")
        try:
            module.synthesized_patch([("src/one.py", "alpha\nbeta\n")], source)
        except module.EditFormatError:
            covered.append("diff-unchanged")
        else:
            raise RuntimeError("diff-unchanged: an empty patch was produced")

        # The fenced block format always reconstructs a final newline, so a pinned file that has
        # none is reproduced exactly when the line sequences agree. That must still be the
        # unchanged-content refusal, not a spurious newline-only hunk.
        (source / "src" / "one.py").write_text("alpha\nbeta", encoding="utf-8")
        try:
            module.synthesized_patch([("src/one.py", "alpha\nbeta\n")], source)
        except module.EditFormatError:
            covered.append("diff-unchanged-without-trailing-newline")
        else:
            raise RuntimeError(
                "diff-unchanged-without-trailing-newline: a newline-only patch was produced"
            )
        # A real edit to the same file is still a real hunk.
        changed = module.synthesized_patch([("src/one.py", "alpha\ngamma\n")], source).decode("utf-8")
        require(
            "+gamma\n" in changed and "-beta\n" in changed,
            f"diff-changed-without-trailing-newline: {changed!r}",
        )
        covered.append("diff-changed-without-trailing-newline")
        (source / "src" / "one.py").write_text("alpha\nbeta\n", encoding="utf-8")

        # A file the pinned tree does not carry is created rather than diffed against nothing.
        created = module.synthesized_patch([("src/new.py", "delta\n")], source).decode("utf-8")
        require(
            created.startswith(
                "diff --git a/src/new.py b/src/new.py\nnew file mode 100644\n--- /dev/null\n"
            ) and created.endswith("@@ -0,0 +1,1 @@\n+delta\n"),
            f"diff-created-file: {created!r}",
        )
        covered.append("diff-created-file")
    return covered


def launch_rows(root: Path) -> list[str]:
    """Rows that require the Linux sealed-input and containment machinery."""
    covered: list[str] = []

    fixture = Fixture(root, "sealed-success")
    fixture.request()
    completed, result = fixture.invoke()
    require(
        completed.returncode == 0 and not completed.stdout and not completed.stderr,
        f"sealed-success: the adapter was not silent: {completed.stderr!r}",
    )
    require(result is not None, "sealed-success: no measurement document was written")
    require(
        result["status"] == "PASS" and result["failure_kind"] == "NONE"
        and result["build_status"] == "PASS" and result["test_status"] == "PASS"
        and result["cleanup_passed"] and result["containment_passed"],
        f"sealed-success: the admitted launch did not pass: {result!r}",
    )
    require(
        isinstance(result["generation_to_passing_patch_ns"], int)
        and result["generation_to_passing_patch_ns"] > 0,
        "sealed-success: a passing row carries a positive measured time",
    )
    require(
        result["patch_size_bytes"] == len(expected_patch().encode("utf-8")),
        "sealed-success: the produced patch bytes were not the synthesized whole-file diff",
    )
    # The provider identity, request digest, and seed attestation are copied verbatim.
    expected_provider_sha = hashlib.sha256(b"dispatched-bytes").hexdigest()
    require(
        result["seed_attestation"]["provider_request_sha256"] == expected_provider_sha
        and result["generation_request"]["provider_request_sha256"] == expected_provider_sha
        and result["seed_attestation"]["result"] == "APPLIED"
        and result["seed_attestation"]["applied_seed"] == 100
        and result["seed_attestation"]["requested_seed"] == 100
        and result["seed_attestation"]["provider_kind"] == "LOCAL_OPENAI"
        and result["seed_attestation"]["provider_model"] == "fixture-model",
        f"sealed-success: the response identities were not copied verbatim: {result!r}",
    )
    require(
        result["environment_probe"]["producer"] == "MEASUREMENT_ADAPTER"
        and result["environment_probe"]["runtime_identity"] == "PYTHON:" + raw_digest(ADAPTER),
        "sealed-success: the environment probe does not declare this adapter's runtime",
    )
    require(
        not any(entry.name.startswith("generation-") for entry in os.scandir(fixture.workspace)),
        "sealed-success: a handoff document survived in the evaluator workspace",
    )
    covered.append("sealed-success")

    # A declared digest mismatch is rejected before launch: no runner marker can exist.
    for name, field, target in (
        ("child-digest-mismatch", "generation_child_sha256", "child"),
        ("runner-digest-mismatch", "validation_runner_sha256", "runner"),
        ("task-digest-mismatch", "task_definition_sha256", "task"),
    ):
        fixture = Fixture(root, name)
        marker = fixture.root / "launched"
        fixture.write_runner(exit_code=0)
        fixture.runner_path.write_text(
            "from pathlib import Path\n"
            f"Path({str(marker)!r}).write_text('ran')\n",
            encoding="utf-8",
        )
        request = fixture.request()
        request[field] = "9" * 64
        bind(request)
        fixture.request_path.write_bytes(canonical(request))
        completed, result = fixture.invoke()
        assert_not_scoreable(name, result, "ADAPTER")
        require(not marker.exists(), f"{name}: a rejected row still launched the runner")
        covered.append(name)

    # A post-admission replacement of the public pathname never runs: only the retained descriptor
    # is launched, and the retained input verifies unchanged after the child returns.
    # This is the one row that runs the adapter inside the harness process, so the harness's own
    # process tree is the tree the adapter's containment check sees. Nothing this harness launched
    # is still running here; any process still present is one this subreaper adopted, and reaping
    # it is this process's own duty rather than a containment failure of the generation child.
    reap_adopted_children()
    fixture = Fixture(root, "post-admission-replacement")
    fixture.request()
    module = load_adapter()
    original_popen = module.subprocess.Popen

    def replace_after_admission(*arguments, **keywords):
        fixture.child_path.write_text(
            "#!/usr/bin/env python3\n"
            "from pathlib import Path\n"
            f"Path({str(fixture.marker)!r}).write_text('replacement ran')\n"
            "raise SystemExit(99)\n",
            encoding="utf-8",
        )
        fixture.child_path.chmod(0o755)
        fixture.runner_path.write_text(
            "from pathlib import Path\n"
            f"Path({str(fixture.marker)!r}).write_text('replacement ran')\n"
            "raise SystemExit(99)\n",
            encoding="utf-8",
        )
        return original_popen(*arguments, **keywords)

    module.subprocess.Popen = replace_after_admission
    try:
        code = module.main([
            "--prompt-variant", str(fixture.variant_path),
            "--rendered-prompt", str(fixture.rendered_path),
            "--sample-index", "1", "--paired-seed", "100",
            "--adapter-request", str(fixture.request_path),
            "--result", str(fixture.result_path),
        ])
    finally:
        module.subprocess.Popen = original_popen
    result = json.loads(fixture.result_path.read_text(encoding="utf-8"))
    require(
        code == 0 and result["status"] == "PASS" and not fixture.marker.exists(),
        f"post-admission-replacement: the replacement crossed the retained boundary: {result!r}",
    )
    covered.append("post-admission-replacement")

    # The descendant scan reports every live descendant and omits only a fully terminated one.
    # This process is a subreaper because the adapter is loaded here, so an orphan that has already
    # exited is reparented here and stays a zombie until it is waited for. A direct fork reaches the
    # same `/proc` shape without racing an orphan. A zombie with a single task has terminated and
    # cannot escape containment; counting it fails containment for a process that no longer runs,
    # which is exactly what a recent Git's detached auto-maintenance produced above.
    reap_adopted_children()
    zombie = os.fork()
    if zombie == 0:
        os._exit(0)
    deadline = time.monotonic() + 5.0
    state = ""
    while time.monotonic() < deadline:
        state = status_field(zombie, "State:")
        if state == "Z":
            break
        time.sleep(0.01)
    require(state == "Z", "adopted-zombie-descendant: the synthetic child never became a zombie")
    require(
        zombie not in module.owned_descendant_ids(),
        "adopted-zombie-descendant: a fully terminated zombie child was counted as a live descendant",
    )
    os.waitpid(zombie, 0)
    covered.append("adopted-zombie-descendant")

    # A zombie thread-group leader whose worker thread is still running is `State: Z` too, but it
    # is a live process and must be reported. This row fails if the `Threads:` discriminator is
    # dropped and every zombie is omitted again.
    leader = fork_zombie_leader()
    try:
        await_zombie_leader(leader)
        require(
            leader in module.owned_descendant_ids(),
            "zombie-leader-descendant: a zombie leader with a live worker thread was not reported",
        )
    finally:
        os.kill(leader, signal.SIGKILL)
        os.waitpid(leader, 0)
    covered.append("zombie-leader-descendant")

    live = subprocess.Popen(
        [sys.executable, "-c", "import time\ntime.sleep(30)\n"], start_new_session=True,
    )
    try:
        deadline = time.monotonic() + 5.0
        seen = False
        while time.monotonic() < deadline and not seen:
            seen = live.pid in module.owned_descendant_ids()
            if not seen:
                time.sleep(0.01)
        require(seen, "live-descendant-detected: a live descendant was not reported by the scan")
    finally:
        live.kill()
        live.wait()
    covered.append("live-descendant-detected")

    # A generation child that leaves an already-exited orphan behind is still a clean pass: the
    # adopted zombie cannot escape containment. The orphan leads its own session, so it is only
    # reachable through the descendant scan: a zombie still holds its process group open, and the
    # private-group check is a separate contract.
    fixture = Fixture(root, "generation-child-adopted-zombie")
    fixture.write_child(
        prologue=(
            "pid = os.fork()\n"
            "if pid == 0:\n"
            "    os.setsid()\n"
            "    os._exit(0)\n"
            "deadline = time.monotonic() + 5.0\n"
            "while time.monotonic() < deadline:\n"
            "    state = next(\n"
            "        line for line in open(f'/proc/{pid}/status', encoding='utf-8').read().splitlines()\n"
            "        if line.startswith('State:')\n"
            "    ).split()[1]\n"
            "    if state == 'Z':\n"
            "        break\n"
            "    time.sleep(0.01)\n"
            "assert state == 'Z'\n"
        ),
    )
    fixture.request()
    completed, result = fixture.invoke()
    require(
        completed.returncode == 0 and result is not None and result["status"] == "PASS"
        and result["failure_kind"] == "NONE" and result["containment_passed"]
        and result["cleanup_passed"],
        f"generation-child-adopted-zombie: an adopted zombie failed containment: {result!r}",
    )
    covered.append("generation-child-adopted-zombie")

    # The two-process handoff failure rows.
    fixture = Fixture(root, "child-nonzero-exit")
    fixture.write_child(exit_code=3)
    fixture.request()
    _, result = fixture.invoke()
    assert_not_scoreable("child-nonzero-exit", result, "ADAPTER")
    covered.append("child-nonzero-exit")

    fixture = Fixture(root, "child-truncated-response")
    fixture.write_child(body="json.dumps(response)[:12]")
    fixture.request()
    _, result = fixture.invoke()
    assert_not_scoreable("child-truncated-response", result, "ADAPTER")
    covered.append("child-truncated-response")

    fixture = Fixture(root, "child-absent-response")
    fixture.write_child(body="''")
    fixture.request()
    _, result = fixture.invoke()
    assert_not_scoreable("child-absent-response", result, "ADAPTER")
    covered.append("child-absent-response")

    fixture = Fixture(root, "child-timeout")
    fixture.write_child(sleep=5.0)
    request = fixture.request()
    control = dict(fixture.control)
    control["timeout_ns"] = 300_000_000
    store(fixture.control_path, control)
    fixture.request(provider_control_sha256=control["content_sha256"])
    policy = dict(fixture.policy)
    policy["provider_control_sha256"] = control["content_sha256"]
    store(fixture.policy_path, policy)
    fixture.request(
        provider_control_sha256=control["content_sha256"],
        generation_policy_sha256=policy["content_sha256"],
    )
    started = time.monotonic()
    _, result = fixture.invoke()
    require(time.monotonic() - started < 30, "child-timeout: the adapter did not bound the child")
    assert_not_scoreable("child-timeout", result, "ADAPTER")
    covered.append("child-timeout")

    # The contained validation runner is bounded by the declared task deadline, not by the much
    # larger provider-control deadline that bounds the generation child. A runner that outlives the
    # task deadline is stopped well before the provider deadline could expire.
    fixture = Fixture(root, "task-deadline-bounds-runner")
    fixture.runner_path.write_text("import time\ntime.sleep(30)\n", encoding="utf-8")
    fixture.request(
        validation_runner_sha256=raw_digest(fixture.runner_path),
        task_deadline_ns=300_000_000,
    )
    started = time.monotonic()
    _, result = fixture.invoke()
    elapsed = time.monotonic() - started
    require(
        elapsed < 15,
        f"task-deadline-bounds-runner: the runner was not bounded by the task deadline ({elapsed:.1f}s)",
    )
    assert_not_scoreable("task-deadline-bounds-runner", result, "ADAPTER")
    covered.append("task-deadline-bounds-runner")

    # A credential that reaches the generation child's stderr must not survive the nonzero-exit
    # detail slice, which is a truncation that runs after redaction.
    fixture = Fixture(root, "credential-child-exit-detail")
    secret = "sk-child-exit-.*+?[a-z]$-SECRET"
    fixture.child_path.write_text(
        "#!/usr/bin/env python3\n"
        "import sys\n"
        "sys.stderr.write('x' * 250 + " + repr(secret) + " + 'tail')\n"
        "raise SystemExit(9)\n",
        encoding="utf-8",
    )
    fixture.child_path.chmod(0o755)
    control = dict(fixture.control)
    control["api_key_env"] = "ALIGN_LLM_MEASUREMENT_KEY"
    store(fixture.control_path, control)
    policy = dict(fixture.policy)
    policy["provider_control_sha256"] = control["content_sha256"]
    store(fixture.policy_path, policy)
    fixture.request(
        credential_env_name="ALIGN_LLM_MEASUREMENT_KEY",
        provider_control_sha256=control["content_sha256"],
        generation_policy_sha256=policy["content_sha256"],
        generation_child_sha256=raw_digest(fixture.child_path),
    )
    environment = dict(os.environ)
    environment["ALIGN_LLM_MEASUREMENT_KEY"] = secret
    subprocess.run(
        [
            sys.executable, str(ADAPTER),
            "--prompt-variant", str(fixture.variant_path),
            "--rendered-prompt", str(fixture.rendered_path),
            "--sample-index", "1", "--paired-seed", "100",
            "--adapter-request", str(fixture.request_path),
            "--result", str(fixture.result_path),
        ],
        env=environment, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, timeout=120,
    )
    result = json.loads(fixture.result_path.read_text(encoding="utf-8"))
    assert_not_scoreable("credential-child-exit-detail", result, "ADAPTER")
    require(
        secret.encode("utf-8") not in fixture.result_path.read_bytes(),
        "credential-child-exit-detail: a credential survived the child-exit detail slice",
    )
    covered.append("credential-child-exit-detail")

    # A response whose file block names a path outside the declared editable set is refused before
    # the validation runner is launched, and the row stays a scored policy violation whose seed
    # attestation still names the real dispatched request.
    fixture = Fixture(root, "edit-outside-allowlist")
    marker = fixture.root / "launched"
    fixture.write_child(content="FILE: src/legacy.py\n```python\nrewritten\n```\n")
    fixture.runner_path.write_text(
        f"from pathlib import Path\nPath({str(marker)!r}).write_text('ran')\n", encoding="utf-8",
    )
    fixture.request(
        generation_child_sha256=raw_digest(fixture.child_path),
        validation_runner_sha256=raw_digest(fixture.runner_path),
    )
    _, result = fixture.invoke()
    require(
        result is not None and result["status"] == "POLICY_VIOLATION"
        and result["failure_kind"] == "POLICY" and result["policy_violation_count"] == 1
        and result["build_status"] == "NOT_RUN" and result["test_status"] == "NOT_RUN"
        and result["generation_to_passing_patch_ns"] is None
        and result["seed_attestation"]["result"] == "APPLIED"
        and result["seed_attestation"]["provider_request_sha256"]
        == hashlib.sha256(b"dispatched-bytes").hexdigest(),
        f"edit-outside-allowlist: wrong classification: {result!r}",
    )
    require(not marker.exists(), "edit-outside-allowlist: the validation runner was launched")
    covered.append("edit-outside-allowlist")

    # A response carrying no file block at all is the patch-absent outcome: a scored `FAIL`/`PATCH`
    # with both stages `NOT_RUN`, not an adapter error.
    fixture = Fixture(root, "edit-absent")
    marker = fixture.root / "launched"
    fixture.write_child(content="I would rather explain the bug than patch it.\n")
    fixture.runner_path.write_text(
        f"from pathlib import Path\nPath({str(marker)!r}).write_text('ran')\n", encoding="utf-8",
    )
    fixture.request(
        generation_child_sha256=raw_digest(fixture.child_path),
        validation_runner_sha256=raw_digest(fixture.runner_path),
    )
    _, result = fixture.invoke()
    require(
        result is not None and result["status"] == "FAIL" and result["failure_kind"] == "PATCH"
        and result["build_status"] == "NOT_RUN" and result["test_status"] == "NOT_RUN"
        and result["policy_violation_count"] == 0
        and result["generation_to_passing_patch_ns"] is None
        and result["seed_attestation"]["result"] == "APPLIED",
        f"edit-absent: wrong classification: {result!r}",
    )
    require(not marker.exists(), "edit-absent: the validation runner was launched")
    covered.append("edit-absent")

    # Task parameterization: the manifest-driven runner and task definition are what execute, and a
    # different declared task definition changes the measured outcome without touching the adapter.
    fixture = Fixture(root, "task-parameterization")
    fixture.task_path.write_bytes(canonical(task_definition("other")))
    fixture.request()
    _, result = fixture.invoke()
    require(
        result is not None and result["status"] == "FAIL" and result["failure_kind"] == "TEST"
        and result["test_status"] == "FAIL",
        f"task-parameterization: a different declared task did not change the outcome: {result!r}",
    )
    covered.append("task-parameterization")

    # A declared fixture-style patch pair replaces the generated content.
    fixture = Fixture(root, "declared-patch")
    declared = fixture.root / "declared.patch"
    declared.write_text("the declared patch\n", encoding="utf-8")
    fixture.write_runner(expect_patch="the declared patch\n")
    fixture.request(
        validation_runner_sha256=raw_digest(fixture.runner_path),
        patch_path=str(declared),
        patch_sha256=raw_digest(declared),
    )
    _, result = fixture.invoke()
    require(
        result is not None and result["status"] == "PASS"
        and result["patch_size_bytes"] == len("the declared patch\n"),
        f"declared-patch: the declared patch was not the admitted one: {result!r}",
    )
    covered.append("declared-patch")

    # An oversized rendered prompt is a pre-run policy violation with no dispatch at all.
    fixture = Fixture(root, "policy-violation")
    policy = dict(fixture.policy)
    policy["max_prompt_bytes"] = len(RENDERED_TEXT.encode("utf-8")) - 1
    store(fixture.policy_path, policy)
    fixture.write_child(exit_code=97)
    fixture.request(
        generation_policy_sha256=policy["content_sha256"],
        generation_child_sha256=raw_digest(fixture.child_path),
    )
    _, result = fixture.invoke()
    require(
        result is not None and result["status"] == "POLICY_VIOLATION"
        and result["failure_kind"] == "POLICY" and result["policy_violation_count"] == 1
        and result["build_status"] == "NOT_RUN" and result["test_status"] == "NOT_RUN"
        and result["generation_to_passing_patch_ns"] is None
        and result["seed_attestation"]["provider_request_sha256"] == "0" * 64,
        f"policy-violation: the pre-run policy violation dispatched work: {result!r}",
    )
    covered.append("policy-violation")

    # The credential value reaches the generation child and nothing else, and no persisted byte of
    # it survives.
    fixture = Fixture(root, "credential-handoff")
    secret = "sk-measurement-.*+?[a-z]$-SECRET"
    fixture.child_path.write_text(
        "#!/usr/bin/env python3\n"
        "import hashlib, json, os, sys\n"
        "assert os.environ['ALIGN_LLM_MEASUREMENT_KEY'] == " + repr(secret) + "\n"
        "request = json.loads(open(sys.argv[3], encoding='utf-8').read())\n"
        "response = {\n"
        "  'schema_version': 1, 'artifact_kind': 'PROMPT_GENERATION_RESPONSE',\n"
        "  'request_id': request['request_id'], 'status': 'GENERATED', 'error_code': 'NONE',\n"
        "  'error': '', 'provider_kind': request['provider_kind'],\n"
        "  'provider_model': request['provider_model'],\n"
        "  'provider_request_sha256': hashlib.sha256(b'dispatched-bytes').hexdigest(),\n"
        "  'seed_result': 'APPLIED', 'applied_seed': request['paired_seed'],\n"
        "  'http_status': 200, 'content': " + repr(RESPONSE_TEXT) + ",\n"
        "  'dispatch_start_ns': 1, 'dispatch_end_ns': 2, 'content_sha256': '',\n"
        "}\n"
        "response['content_sha256'] = hashlib.sha256(\n"
        "  json.dumps(response, ensure_ascii=False, separators=(',', ':')).encode()).hexdigest()\n"
        "open(sys.argv[4], 'w', encoding='utf-8').write(\n"
        "  json.dumps(response, ensure_ascii=False, separators=(',', ':')))\n",
        encoding="utf-8",
    )
    fixture.child_path.chmod(0o755)
    fixture.runner_path.write_text(
        "import os, sys\n"
        "raise SystemExit(0 if 'ALIGN_LLM_MEASUREMENT_KEY' not in os.environ else 7)\n",
        encoding="utf-8",
    )
    control = dict(fixture.control)
    control["api_key_env"] = "ALIGN_LLM_MEASUREMENT_KEY"
    store(fixture.control_path, control)
    policy = dict(fixture.policy)
    policy["provider_control_sha256"] = control["content_sha256"]
    store(fixture.policy_path, policy)
    fixture.request(
        credential_env_name="ALIGN_LLM_MEASUREMENT_KEY",
        provider_control_sha256=control["content_sha256"],
        generation_policy_sha256=policy["content_sha256"],
        generation_child_sha256=raw_digest(fixture.child_path),
        validation_runner_sha256=raw_digest(fixture.runner_path),
    )
    environment = dict(os.environ)
    environment["ALIGN_LLM_MEASUREMENT_KEY"] = secret
    completed = subprocess.run(
        [
            sys.executable, str(ADAPTER),
            "--prompt-variant", str(fixture.variant_path),
            "--rendered-prompt", str(fixture.rendered_path),
            "--sample-index", "1", "--paired-seed", "100",
            "--adapter-request", str(fixture.request_path),
            "--result", str(fixture.result_path),
        ],
        env=environment, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, timeout=120,
    )
    result = json.loads(fixture.result_path.read_text(encoding="utf-8"))
    require(
        completed.returncode == 0 and result["status"] == "PASS",
        f"credential-handoff: the credentialed run did not pass: {result!r} {completed.stderr!r}",
    )
    require(
        secret.encode("utf-8") not in fixture.result_path.read_bytes()
        and secret not in completed.stdout.decode("utf-8", "replace")
        and secret not in completed.stderr.decode("utf-8", "replace"),
        "credential-handoff: a credential byte survived into the persisted measurement",
    )
    covered.append("credential-handoff")
    return covered


def main() -> int:
    require(ADAPTER.is_file(), "the measurement adapter is missing")
    module = load_adapter()
    covered = unit_rows(module)
    if LINUX and module.CHILD_SUBREAPER_ENABLED:
        with tempfile.TemporaryDirectory(prefix="prompt-measurement-adapter-") as directory:
            covered += launch_rows(Path(directory).resolve())
    else:
        print(
            "prompt measurement adapter: SKIP: the sealed-input and containment rows need Linux "
            f"(memfd_create, F_ADD_SEALS, /proc/self/fd, PR_SET_CHILD_SUBREAPER); host is "
            f"{sys.platform}"
        )
        # The unavailable-containment path must still refuse to produce a scoreable row.
        with tempfile.TemporaryDirectory(prefix="prompt-measurement-adapter-") as directory:
            fixture = Fixture(Path(directory).resolve(), "containment-unavailable")
            fixture.request()
            _, result = fixture.invoke()
            assert_not_scoreable("containment-unavailable", result, "ADAPTER")
            require(
                "containment is unavailable" in result["diagnostic_summary"],
                f"containment-unavailable: wrong diagnostic: {result['diagnostic_summary']!r}",
            )
            covered.append("containment-unavailable")
    require(len(covered) == len(set(covered)), "a smoke row name was reused")
    print(f"prompt measurement adapter rows: {len(covered)}")
    print("prompt measurement adapter: PASS")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, json.JSONDecodeError, subprocess.TimeoutExpired) as error:
        print(f"prompt measurement adapter: FAIL: {error}", file=sys.stderr)
        raise SystemExit(1)
