#!/usr/bin/env bash
set -euo pipefail
if [ "$#" != 3 ]; then
    echo 'usage: run-cuda-graph-optimization-smoke GGML_SOURCE CORE_LIB BACKEND_PLUGIN' >&2
    exit 2
fi
root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
test_dir=$(mktemp -d)
trap 'rm -rf "$test_dir"' EXIT
test "$(git -C "$1" rev-parse HEAD)" = bb4caa7540188872173c44d161602d9271386413
test -z "$(git -C "$1" status --porcelain)"
"${CC:-cc}" -std=c11 -O2 -Wall -Wextra -Werror -ffp-contract=off \
    -DALIGN_GGML_FP_CONTRACT_OFF=1 -I"$1/ggml/include" \
    "$root_dir/scripts/cuda_graph_optimization_smoke.c" -L"$2" -Wl,-rpath,"$2" \
    -lggml -lggml-base -ldl -lm -o "$test_dir/owner"
unset GGML_CUDA_GRAPH_OPT GGML_CUDA_DISABLE_GRAPHS GGML_CUDA_DISABLE_FUSION
"$test_dir/owner" "$3" 1
GGML_CUDA_GRAPH_OPT=0 "$test_dir/owner" "$3" 0
GGML_CUDA_GRAPH_OPT=1 "$test_dir/owner" "$3" 1
GGML_CUDA_GRAPH_OPT=bad "$test_dir/owner" "$3" -1
