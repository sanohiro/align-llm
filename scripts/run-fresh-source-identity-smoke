#!/usr/bin/env python3
"""Focused descriptor-relative source identity acceptance smoke."""

from __future__ import annotations

import os
import shutil
import subprocess
import tempfile
from collections import OrderedDict
from pathlib import Path

import fresh_source_identity as source_identity
from fresh_source import validate_source_manifest_bytes
from fresh_source_identity import (
    SourceIdentityError,
    capture_align_source,
    capture_project_source,
    open_relative_directory,
)


def git(path: Path, *arguments: str, output: bool = False) -> str:
    result = subprocess.run(
        ["/usr/bin/git", "-C", str(path), *arguments],
        check=True,
        stdout=subprocess.PIPE if output else subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env={"GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null", "LC_ALL": "C"},
        text=True,
    )
    return result.stdout.strip() if output else ""


def commit(path: Path, message: str = "fixture") -> str:
    git(path, "add", "-A")
    git(path, "commit", "-qm", message)
    return git(path, "rev-parse", "HEAD", output=True)


def repository(path: Path, *, two_commits: bool = False, object_format: str = "sha1") -> str:
    path.mkdir(parents=True)
    git(path, "init", "-q", f"--object-format={object_format}")
    git(path, "config", "user.name", "Source Identity Smoke")
    git(path, "config", "user.email", "source-identity@example.invalid")
    (path / "dir").mkdir()
    (path / "dir" / "file").write_bytes(b"abc")
    (path / "run").write_bytes(b"#!/bin/sh\nexit 0\n")
    (path / "run").chmod(0o755)
    (path / "link").symlink_to("dir/file")
    head = commit(path)
    if two_commits:
        (path / "second").write_bytes(b"second")
        head = commit(path, "second")
    return head


def root_fd(path: Path) -> int:
    return os.open(path, os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)


def reject(callable_value, label: str) -> None:
    try:
        value = callable_value()
    except SourceIdentityError:
        return
    if hasattr(value, "close"):
        value.close()
    raise AssertionError(f"{label} was accepted")


def capture_project(path: Path):
    fd = root_fd(path)
    try:
        head = git(path, "rev-parse", "HEAD", output=True)
        object_format = git(path, "rev-parse", "--show-object-format", output=True)
        return fd, capture_project_source(fd, head, object_format)
    except Exception:
        os.close(fd)
        raise


def assert_basic_capture(path: Path) -> None:
    (path / "target").mkdir()
    (path / "main").write_bytes(b"output")
    before = git(path, "status", "--porcelain=v1", "-z", "--untracked-files=all", output=True)
    fd, handle = capture_project(path)
    try:
        manifest = validate_source_manifest_bytes(handle.identity.manifest_bytes)
        assert manifest["kind"] == "project-source"
        assert [bytes.fromhex(entry["path_hex"]) for entry in manifest["entries"]] == [
            b"dir",
            b"dir/file",
            b"link",
            b"run",
        ]
        assert handle.identity.exceptions[1].present
        assert handle.identity.exceptions[2].present
        assert handle.identity.exceptions[0].kind == "directory"
        handle.recheck()
        assert git(path, "status", "--porcelain=v1", "-z", "--untracked-files=all", output=True) == before
    finally:
        handle.close()
    os.fstat(fd)
    handle.close()
    reject(handle.recheck, "closed source handle")
    reject(lambda: capture_project_source(fd, "0" * 40, "sha1"), "project HEAD mismatch")
    reject(lambda: capture_project_source(fd, "0" * 64, "sha256"), "project object-format mismatch")
    os.close(fd)


def assert_sha256_project(path: Path) -> None:
    repository(path, object_format="sha256")
    fd, handle = capture_project(path)
    try:
        assert handle.identity.object_format == "sha256"
        assert len(handle.identity.revision) == 64
        handle.recheck()
    finally:
        handle.close()
        os.close(fd)


def assert_linked_worktree(root: Path) -> None:
    primary = root / "primary"
    repository(primary)
    linked = root / "linked"
    git(primary, "worktree", "add", "-q", "-b", "linked-fixture", str(linked), "HEAD")
    fd, handle = capture_project(linked)
    try:
        assert (linked / ".git").is_file()
        assert handle.identity.exceptions[0].kind == "regular"
        handle.recheck()
    finally:
        handle.close()
        os.close(fd)


def assert_align_capture(root: Path) -> None:
    project = root / "project"
    align = root / "align"
    align256 = root / "align256"
    repository(project)
    revision = repository(align)
    revision256 = repository(align256, object_format="sha256")
    (align / "target").mkdir()
    fd = root_fd(project)
    try:
        handle = capture_align_source(fd, b"../align", revision)
        try:
            assert handle.identity.kind == "align-source"
            assert handle.identity.object_format == "sha1"
            assert handle.identity.exceptions[2].present is False
            handle.recheck()
        finally:
            handle.close()
        reject(lambda: capture_align_source(fd, b"../align", "0" * 40), "wrong Align revision")
        reject(lambda: capture_align_source(fd, b"../missing", revision), "missing Align root")
        reject(lambda: capture_align_source(fd, b"/absolute", revision), "absolute Align root")
        reject(lambda: capture_align_source(fd, b"../align256", revision256), "SHA-256 Align root")
    finally:
        os.close(fd)


def assert_resolver(root: Path) -> None:
    project = root / "project"
    sibling = root / "sibling"
    root.mkdir(parents=True)
    project.mkdir()
    sibling.mkdir()
    (root / "alias").symlink_to("sibling")
    fd = root_fd(project)
    try:
        handle = open_relative_directory(fd, b"../sibling")
        handle.assert_stable()
        handle.close()
        os.fstat(fd)
        reject(lambda: open_relative_directory(fd, b"../alias"), "symlinked directory")
        reject(lambda: open_relative_directory(fd, b""), "empty directory")
        reject(lambda: open_relative_directory(fd, b"./../sibling"), "dot directory component")
        reject(lambda: open_relative_directory(fd, b"/sibling"), "absolute directory")
    finally:
        os.close(fd)


def assert_mutations(root: Path) -> None:
    cases = ("content", "mode", "untracked", "staged", "assume", "skip", "hardlink")
    for case in cases:
        path = root / case
        repository(path)
        if case == "content":
            fd, handle = capture_project(path)
            (path / "dir" / "file").write_bytes(b"changed")
            reject(handle.recheck, "content mutation")
            handle.close()
            os.close(fd)
        elif case == "mode":
            (path / "dir" / "file").chmod(0o600)
            reject(lambda: capture_project(path), "invalid tracked mode")
        elif case == "untracked":
            (path / "extra").write_bytes(b"extra")
            reject(lambda: capture_project(path), "untracked input")
        elif case == "staged":
            (path / "dir" / "file").write_bytes(b"staged")
            git(path, "add", "dir/file")
            reject(lambda: capture_project(path), "staged input")
        elif case == "assume":
            git(path, "update-index", "--assume-unchanged", "dir/file")
            reject(lambda: capture_project(path), "assume-unchanged input")
        elif case == "skip":
            git(path, "update-index", "--skip-worktree", "dir/file")
            reject(lambda: capture_project(path), "skip-worktree input")
        else:
            os.link(path / "dir" / "file", path / "hardlink")
            commit(path, "tracked hard link")
            reject(lambda: capture_project(path), "tracked hard link")


def assert_symlink_rejections(root: Path) -> None:
    chain = root / "chain"
    repository(chain)
    (chain / "link").unlink()
    (chain / "link").symlink_to("second")
    (chain / "second").symlink_to("dir/file")
    commit(chain, "contained chain")
    fd, handle = capture_project(chain)
    try:
        handle.recheck()
        (chain / "link").unlink()
        (chain / "link").symlink_to("dir/file")
        reject(handle.recheck, "symlink target replacement")
    finally:
        handle.close()
        os.close(fd)

    for label, target in (("absolute", "/etc/passwd"), ("escape", "../outside"), ("missing", "missing")):
        path = root / label
        repository(path)
        (path / "link").unlink()
        (path / "link").symlink_to(target)
        commit(path, label)
        reject(lambda: capture_project(path), f"{label} symlink")
    path = root / "cycle"
    repository(path)
    (path / "link").unlink()
    (path / "a").symlink_to("b")
    (path / "b").symlink_to("a")
    commit(path, "cycle")
    reject(lambda: capture_project(path), "cyclic symlink")


def assert_policy_rejections(root: Path) -> None:
    configurations = (
        ("filter", "filter.host.clean", "/bin/false"),
        ("fsmonitor", "core.fsmonitor", "/bin/false"),
        ("hooks", "core.hooksPath", "/does/not/exist"),
        ("worktree", "core.worktree", "."),
        ("partial", "extensions.partialClone", "origin"),
        ("worktree-config", "extensions.worktreeConfig", "true"),
        ("include-if", "includeIf.gitdir:/tmp/.path", "/does/not/exist"),
    )
    for label, key, value in configurations:
        configured = root / label
        repository(configured)
        git(configured, "config", key, value)
        reject(lambda path=configured: capture_project(path), f"local {label} configuration")

    replaced = root / "replace"
    repository(replaced, two_commits=True)
    head = git(replaced, "rev-parse", "HEAD", output=True)
    parent = git(replaced, "rev-parse", "HEAD^", output=True)
    git(replaced, "replace", head, parent)
    git(replaced, "pack-refs", "--all", "--prune")
    reject(lambda: capture_project(replaced), "replacement ref")

    alternate = root / "alternate"
    repository(alternate)
    info = alternate / ".git" / "objects" / "info"
    info.mkdir(exist_ok=True)
    (info / "alternates").write_text("/does/not/exist\n", encoding="ascii")
    reject(lambda: capture_project(alternate), "alternate object store")

    shallow = root / "shallow"
    repository(shallow)
    (shallow / ".git" / "shallow").write_bytes(b"")
    reject(lambda: capture_project(shallow), "shallow metadata")

    promisor = root / "promisor"
    repository(promisor)
    pack = promisor / ".git" / "objects" / "pack"
    pack.mkdir(exist_ok=True)
    (pack / "fixture.promisor").write_bytes(b"")
    reject(lambda: capture_project(promisor), "promisor pack metadata")


def assert_output_rejections(root: Path) -> None:
    tracked = root / "tracked-target"
    repository(tracked)
    (tracked / "target").mkdir()
    (tracked / "target" / "tracked").write_bytes(b"x")
    commit(tracked, "tracked target")
    reject(lambda: capture_project(tracked), "tracked target output")

    bad_target = root / "bad-target"
    repository(bad_target)
    (bad_target / "target").mkdir(mode=0o777)
    (bad_target / "target").chmod(0o777)
    reject(lambda: capture_project(bad_target), "world-writable target output")

    bad_main = root / "bad-main"
    repository(bad_main)
    (bad_main / "main").write_bytes(b"output")
    (bad_main / "main").chmod(0o600)
    reject(lambda: capture_project(bad_main), "invalid main output")


def assert_output_identity(root: Path) -> None:
    path = root / "exceptions"
    repository(path)
    fd, absent = capture_project(path)
    absent_bytes = absent.identity.manifest_bytes
    absent.close()
    os.close(fd)
    (path / "target").mkdir()
    (path / "target" / "ignored").write_bytes(b"not consumed")
    (path / "main").write_bytes(b"not consumed")
    fd, present = capture_project(path)
    try:
        assert present.identity.manifest_bytes == absent_bytes
        (path / "target" / "ignored").write_bytes(b"changed but still not consumed")
        (path / "main").write_bytes(b"changed but still not consumed")
        present.recheck()
    finally:
        present.close()
        os.close(fd)


def assert_aba_rejections(root: Path) -> None:
    file_case = root / "file"
    repository(file_case)
    fd, handle = capture_project(file_case)
    original = file_case / "dir" / "file"
    replacement = file_case / "dir" / "replacement"
    replacement.write_bytes(b"abc")
    os.replace(replacement, original)
    reject(handle.recheck, "same-byte source replacement")
    handle.close()
    os.close(fd)

    index_case = root / "index"
    repository(index_case)
    fd, handle = capture_project(index_case)
    git(index_case, "update-index", "--assume-unchanged", "dir/file")
    reject(handle.recheck, "index flag mutation")
    handle.close()
    os.close(fd)

    policy_case = root / "policy"
    repository(policy_case)
    fd, handle = capture_project(policy_case)
    git(policy_case, "config", "filter.late.clean", "/bin/false")
    reject(handle.recheck, "Git policy mutation")
    handle.close()
    os.close(fd)

    object_case = root / "object"
    repository(object_case)
    fd, handle = capture_project(object_case)
    object_id = git(object_case, "rev-parse", "HEAD:dir/file", output=True)
    loose_object = object_case / ".git" / "objects" / object_id[:2] / object_id[2:]
    loose_object.unlink()
    reject(handle.recheck, "missing Git blob object")
    handle.close()
    os.close(fd)

    root_case = root / "root"
    repository(root_case)
    fd, handle = capture_project(root_case)
    moved = root / "moved"
    os.rename(root_case, moved)
    shutil.copytree(moved, root / "root", symlinks=True)
    reject(handle.recheck, "source root pathname replacement")
    handle.close()
    os.close(fd)


def assert_structural_rejections(root: Path) -> None:
    nested = root / "nested-git"
    repository(nested)
    (nested / "dir" / ".git").write_bytes(b"control")
    reject(lambda: capture_project(nested), "nested Git control")

    folded = root / "case-fold"
    repository(folded)
    (folded / "A").write_bytes(b"upper")
    (folded / "a").write_bytes(b"lower")
    commit(folded, "case fold")
    reject(lambda: capture_project(folded), "case-fold collision")

    noncommit = root / "noncommit-head"
    repository(noncommit)
    blob = git(noncommit, "rev-parse", "HEAD:dir/file", output=True)
    (noncommit / ".git" / "HEAD").write_text(f"{blob}\n", encoding="ascii")
    reject(lambda: capture_project(noncommit), "non-commit HEAD")


def assert_bounds(root: Path) -> None:
    count = root / "count"
    repository(count)
    previous_entries = source_identity.MAX_ENTRIES
    try:
        source_identity.MAX_ENTRIES = 2
        reject(lambda: capture_project(count), "source entry count cap")
    finally:
        source_identity.MAX_ENTRIES = previous_entries

    size = root / "size"
    repository(size)
    previous_size = source_identity.MAX_FILE_BYTES
    try:
        source_identity.MAX_FILE_BYTES = 2
        reject(lambda: capture_project(size), "source file byte cap")
    finally:
        source_identity.MAX_FILE_BYTES = previous_size


def assert_object_query_rejections() -> None:
    tree_id = "1" * 40
    blob_id = "2" * 40
    tree_entries = [(b"f", "file", "100644", blob_id)]
    manifest_entries = [OrderedDict((("path_hex", "66"), ("size", 3)))]
    original_git = source_identity._git

    def run(lines: bytes, label: str) -> None:
        def fake_git(*_args, **_kwargs):
            return lines

        source_identity._git = fake_git
        reject(
            lambda: source_identity._verify_object_store(
                None, tree_entries, tree_id, manifest_entries
            ),
            label,
        )

    try:
        run(f"{tree_id} tree 10\n{blob_id} missing\n".encode(), "missing Git object")
        run(f"{tree_id} tree 10\n{blob_id} tree 3\n".encode(), "wrong Git object type")
        run(f"{tree_id} tree 10\n{blob_id} blob 4\n".encode(), "wrong Git object size")
        run(f"{'3' * 40} tree 10\n{blob_id} blob 3\n".encode(), "wrong Git object ID")
    finally:
        source_identity._git = original_git


def main() -> None:
    original = dict(os.environ)
    fd_baseline = len(os.listdir("/proc/self/fd"))
    try:
        os.environ.update(
            {
                "GIT_DIR": "/does/not/exist",
                "GIT_OBJECT_DIRECTORY": "/does/not/exist",
                "GIT_CONFIG_GLOBAL": "/does/not/exist",
                "GIT_CEILING_DIRECTORIES": "/",
            }
        )
        with tempfile.TemporaryDirectory(prefix="fresh-source-identity-") as temporary:
            root = Path(temporary)
            repository(root / "ordinary")
            assert_basic_capture(root / "ordinary")
            assert_sha256_project(root / "sha256-project")
            assert_linked_worktree(root / "linked-case")
            assert_align_capture(root / "align-case")
            assert_resolver(root / "resolver-case")
            assert_mutations(root / "mutation-case")
            assert_symlink_rejections(root / "symlink-case")
            assert_policy_rejections(root / "policy-case")
            assert_output_rejections(root / "output-case")
            assert_output_identity(root / "output-identity-case")
            assert_aba_rejections(root / "aba-case")
            assert_structural_rejections(root / "structural-case")
            assert_bounds(root / "bound-case")
            assert_object_query_rejections()
    finally:
        os.environ.clear()
        os.environ.update(original)
    assert len(os.listdir("/proc/self/fd")) == fd_baseline
    print("fresh source identity smoke: PASS")


if __name__ == "__main__":
    main()
