#!/usr/bin/env python3
"""Owner smoke for `scripts/prompt-template-adapter.py`: the second hop and the version-3 result.

`docs/specs/c4-repair-template.md` sections 6.1, 7.1, and 7.2 own this contract. Three groups:

1. **The second hop of the import chain**, which is portable. Verify-then-execute over one byte
   sequence for the repair adapter, a mutated repair file rejected, every consumed name present and
   of the expected kind, `repair.BASE_ADAPTER_SHA256` cross-checked, the identity cross-derivation
   and its mismatch case, `main()` not run by module execution, one module per process, and section
   3.2's **bounded-divergence golden** against the repair adapter's `measurement()`/`assemble()`.
2. **The refusal vocabulary**, also portable and the heart of this file. Every one of the nine
   frozen raise sites is driven against the **real loaded module** and its message asserted to map
   to its section 3.3 code, plus an unmapped message and a cross-class message rejected. That is
   what makes a message-prefix mapping over a digest-pinned file a checked assumption rather than
   an assumed one.
3. **The version-3 measurement**, which needs Linux for the same reason the two earlier adapter
   smokes do: `memfd_create`, `F_ADD_SEALS`, `/proc/self/fd`, and `PR_SET_CHILD_SUBREAPER`.

No provider is contacted. The generation child is a synthetic script with exactly the
`./main prompt generate` boundary, so every mode of section 7.2 is deterministic.
"""

from __future__ import annotations

import difflib
import hashlib
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path
from types import ModuleType
from typing import Any

ROOT = Path(__file__).resolve().parent.parent
REPAIR_ADAPTER = ROOT / "scripts" / "prompt-repair-adapter.py"
TEMPLATE_ADAPTER = ROOT / "scripts" / "prompt-template-adapter.py"
DIVERGENCE_GOLDEN = ROOT / "eval" / "fixtures" / "c4-repair-template" / "adapter-divergence.diff"
LINUX = sys.platform.startswith("linux")

FIXTURE_SOURCE_DIR = "eval/fixtures/prompt-v1-duration-rounding/repository"
FIXTURE_EDIT_PATH = "src/duration.py"
SECOND_EDIT_PATH = "tests/test_duration.py"
PINNED_CONTENT = (ROOT / FIXTURE_SOURCE_DIR / FIXTURE_EDIT_PATH).read_text(encoding="utf-8")
EDITED_CONTENT = (
    '"""Billable duration helpers."""\n'
    "\n"
    "import math\n"
    "\n"
    "\n"
    "def round_to_minutes(seconds: int) -> int:\n"
    '    """Round a whole-second duration to whole minutes."""\n'
    "    return math.trunc(seconds / 60 + math.copysign(0.5, seconds))\n"
)
RESPONSE_TEXT = (
    "Here is the repair.\n\n"
    f"FILE: {FIXTURE_EDIT_PATH}\n"
    "```python\n"
    f"{EDITED_CONTENT}"
    "```\n\n"
    "That makes the tie round away from zero.\n"
)
RENDERED_TEXT = "Repair the failing task.\n"


def require(condition: bool, detail: str) -> None:
    if not condition:
        raise RuntimeError(detail)


def canonical(value: Any) -> bytes:
    return json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode("utf-8")


def digest_bytes(value: Any) -> bytes:
    def omit_none(item: Any) -> Any:
        if isinstance(item, dict):
            return {key: omit_none(child) for key, child in item.items() if child is not None}
        if isinstance(item, list):
            return [omit_none(child) for child in item]
        return item

    return canonical(omit_none(value))


def bind(value: dict) -> dict:
    value["content_sha256"] = ""
    value["content_sha256"] = hashlib.sha256(digest_bytes(value)).hexdigest()
    return value


def store(path: Path, value: dict) -> dict:
    bind(value)
    path.write_bytes(canonical(value))
    return value


def raw_digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def load_template_adapter() -> ModuleType:
    """Load this file's subject the way any consumer would, without running its `main()`."""
    module = ModuleType("prompt_template_adapter_under_test")
    module.__file__ = str(TEMPLATE_ADAPTER)
    exec(compile(TEMPLATE_ADAPTER.read_bytes(), str(TEMPLATE_ADAPTER), "exec"), module.__dict__)
    return module


# --- Section 3.2: the second-hop bounded-divergence golden ---------------------------------------
#
# The normalizer is `c4-repair-editset.md` section 11.3 deviation 9's, unchanged, applied one hop
# up. Only the two named functions' lines are compared, full-line `#` comments and blank lines are
# removed, and trailing whitespace is stripped. Nothing else is normalized: no identifier
# rewriting, no prefix stripping, no reordering, no whitespace-insensitive comparison. Every
# executable difference survives into the diff, which is the property that makes it worth having.

DIVERGENCE_FUNCTIONS = ("measurement", "assemble")


def function_source(text: str, name: str) -> list[str]:
    lines = text.split("\n")
    start = None
    for ordinal, line in enumerate(lines):
        if line.startswith(f"def {name}("):
            start = ordinal
            break
    require(start is not None, f"the divergence golden cannot find `def {name}(`")
    end = len(lines)
    for ordinal in range(start + 1, len(lines)):
        line = lines[ordinal]
        if line and not line[0].isspace() and not line.startswith(")"):
            end = ordinal
            break
    return lines[start:end]


def normalized_source(text: str, name: str) -> list[str]:
    output = []
    for line in function_source(text, name):
        stripped = line.rstrip()
        if not stripped.strip():
            continue
        if stripped.lstrip().startswith("#"):
            continue
        output.append(stripped)
    return output


def divergence_diff() -> str:
    repair_text = REPAIR_ADAPTER.read_text(encoding="utf-8")
    template_text = TEMPLATE_ADAPTER.read_text(encoding="utf-8")
    parts = []
    for name in DIVERGENCE_FUNCTIONS:
        parts.extend(difflib.unified_diff(
            normalized_source(repair_text, name),
            normalized_source(template_text, name),
            fromfile=f"scripts/prompt-repair-adapter.py:{name}",
            tofile=f"scripts/prompt-template-adapter.py:{name}",
            lineterm="",
            n=3,
        ))
        parts.append("")
    return "\n".join(parts)


def check_divergence(update: bool) -> None:
    observed = divergence_diff()
    if update:
        DIVERGENCE_GOLDEN.parent.mkdir(parents=True, exist_ok=True)
        DIVERGENCE_GOLDEN.write_text(observed, encoding="utf-8")
        sys.stdout.write(f"prompt template adapter: WROTE {DIVERGENCE_GOLDEN}\n")
        return
    require(DIVERGENCE_GOLDEN.exists(), "the bounded-divergence golden is missing")
    expected = DIVERGENCE_GOLDEN.read_text(encoding="utf-8")
    if observed != expected:
        difference = "\n".join(difflib.unified_diff(
            expected.split("\n"), observed.split("\n"),
            fromfile="golden", tofile="observed", lineterm="",
        ))
        raise RuntimeError(
            "the near-copy of measurement()/assemble() diverged from the checked-in golden:\n"
            + difference
        )


# --- Section 6.1: the nine raise sites, driven against the real loaded module --------------------


def refusal_rows(template: ModuleType, frozen: ModuleType, scratch: Path) -> None:
    """Every frozen raise site, its real message, and the code section 3.3 assigns it.

    Nothing here is a re-implementation of a frozen condition: each row calls the frozen function
    with an input that makes it raise, catches the real exception, and asserts the mapping over
    `str(failure)`. A message change in the pinned file turns this red before it can persist a
    wrong code, which is the whole mitigation section 6.6 claims.
    """
    allowed = (FIXTURE_EDIT_PATH, SECOND_EDIT_PATH)
    long_body = "x" * (frozen.MAXIMUM_EDIT_BYTES + 1)
    many = "".join(
        f"FILE: {FIXTURE_EDIT_PATH}\n```\nbody {ordinal}\n```\n\n"
        for ordinal in range(frozen.MAXIMUM_FILE_BLOCKS + 1)
    )
    cases: tuple[tuple[str, str, Any], ...] = (
        ("NO_FILE_BLOCK", "EditFormatError",
         lambda: frozen.validated_edit_set("no blocks at all\n", allowed)),
        ("HEADER_WITHOUT_BLOCK", "EditFormatError",
         lambda: frozen.parse_file_blocks(f"FILE: {FIXTURE_EDIT_PATH}\nprose, no fence\n")),
        ("UNTERMINATED_BLOCK", "EditFormatError",
         lambda: frozen.parse_file_blocks(f"FILE: {FIXTURE_EDIT_PATH}\n```\nbody\n")),
        ("TOO_MANY_BLOCKS", "EditFormatError", lambda: frozen.parse_file_blocks(many)),
        ("DUPLICATE_PATH", "EditFormatError", lambda: frozen.validated_edit_set(
            f"FILE: {FIXTURE_EDIT_PATH}\n```\na\n```\n\nFILE: {FIXTURE_EDIT_PATH}\n```\nb\n```\n",
            allowed,
        )),
        ("BODY_TOO_LARGE", "EditFormatError", lambda: frozen.validated_edit_set(
            f"FILE: {FIXTURE_EDIT_PATH}\n```\n{long_body}\n```\n", allowed,
        )),
        ("UNCHANGED_FILES", "EditFormatError", lambda: frozen.synthesized_patch(
            [(FIXTURE_EDIT_PATH, PINNED_CONTENT)], ROOT / FIXTURE_SOURCE_DIR,
        )),
        ("PATH_NOT_EDITABLE", "PolicyViolation", lambda: frozen.validated_edit_set(
            "FILE: src/legacy.py\n```\nprint(1)\n```\n", allowed,
        )),
        ("PATH_ESCAPES_SOURCE", "PolicyViolation",
         lambda: frozen.pinned_source(ROOT / FIXTURE_SOURCE_DIR, "../../escaped.py")),
    )
    seen: set[str] = set()
    for code, kind, drive in cases:
        expected = getattr(frozen, kind)
        try:
            drive()
        except expected as failure:
            observed = template.edit_refusal_code(str(failure))
            require(
                observed == code,
                f"{code}: the frozen message {str(failure)!r} mapped to {observed!r}",
            )
            admitted = (
                template.EDIT_REFUSAL_PATCH_CODES if kind == "EditFormatError"
                else template.EDIT_REFUSAL_POLICY_CODES
            )
            require(
                template.classified_refusal(str(failure), admitted) == code,
                f"{code}: the class-aware mapping rejected its own class",
            )
            other = (
                template.EDIT_REFUSAL_POLICY_CODES if kind == "EditFormatError"
                else template.EDIT_REFUSAL_PATCH_CODES
            )
            require(
                template.classified_refusal(str(failure), other) is None,
                f"{code}: a message was accepted into the other exception's class",
            )
            seen.add(code)
        else:
            raise RuntimeError(f"{code}: the frozen site did not raise")
    require(len(seen) == 9, f"only {len(seen)} of the nine raise sites were driven")

    # Malformed input: the mapping is total. An unmapped message is never a silent `NONE`.
    require(
        template.edit_refusal_code("something the frozen module never said") is None,
        "an unmapped message was given a refusal code",
    )
    require(
        template.classified_refusal("something else", template.EDIT_REFUSAL_PATCH_CODES) is None,
        "an unmapped message was classified",
    )
    # The three messages sharing the `the response declares ` prefix stay distinguishable.
    require(
        template.edit_refusal_code("the response declares src/a.py twice") == "DUPLICATE_PATH",
        "the parameterized duplicate-path message collided with a fixed message",
    )
    _ = scratch


# --- Section 7.1: the second hop ------------------------------------------------------------------


def hop_rows(template: ModuleType) -> ModuleType:
    path = template.repair_adapter_path()
    require(path == REPAIR_ADAPTER.resolve(), "the repair adapter path is not the corpus member")

    raw = template.verified_repair_adapter(path)
    require(
        hashlib.sha256(raw).hexdigest() == template.REPAIR_ADAPTER_SHA256,
        "verify-then-execute returned bytes that are not the pinned ones",
    )
    require(raw == REPAIR_ADAPTER.read_bytes(), "the verified bytes are not the repair adapter's")

    with tempfile.TemporaryDirectory(prefix="prompt-template-adapter-smoke-") as scratch_name:
        scratch = Path(scratch_name)
        mutated = scratch / "mutated-repair.py"
        mutated.write_bytes(raw[:-1] + b" ")
        failed = False
        try:
            template.verified_repair_adapter(mutated)
        except template.TemplateAdapterError:
            failed = True
        require(failed, "a one-byte-mutated repair adapter was accepted")

        module = template.execute_repair_adapter(path, raw)
        template.assert_import_contract(module)
        require(module.__name__ != "__main__", "the repair module was executed under __main__")

        # Early exit: executing a module body must not run its `main()`.
        marker = scratch / "main-ran"
        stub_names = "\n".join(
            f"{name} = " + (
                "type('Stub', (ValueError,), {})" if kind == "class"
                else "1" if kind == "int"
                else "'x'" if kind == "str"
                else "lambda *a, **k: None"
            )
            for name, kind in template.CONSUMED_NAMES
        )
        stub_path = scratch / "stub-repair.py"
        stub_path.write_text(
            stub_names + "\n"
            "def main(arguments=None):\n"
            f"    open({str(marker)!r}, 'w').write('ran')\n"
            "    return 0\n"
            "if __name__ == '__main__':\n"
            "    raise SystemExit(main())\n",
            encoding="utf-8",
        )
        stub = template.execute_repair_adapter(stub_path, stub_path.read_bytes())
        require(not marker.exists(), "executing the repair module ran its main()")
        template.assert_import_contract(stub)

        # Malformed input: a missing consumed name, and one rebound to a non-callable.
        delattr(stub, "edit_set_blocks")
        failed = False
        try:
            template.assert_import_contract(stub)
        except template.TemplateAdapterError:
            failed = True
        require(failed, "a repair module missing `edit_set_blocks` was accepted")
        stub.edit_set_blocks = 3
        failed = False
        try:
            template.assert_import_contract(stub)
        except template.TemplateAdapterError:
            failed = True
        require(failed, "a repair module whose `edit_set_blocks` is not callable was accepted")

        identity = template.repair_runtime_identity(raw, module)
        require(
            identity == "PYTHON:" + template.REPAIR_ADAPTER_SHA256,
            "the repair runtime identity is not the pinned digest",
        )
        failed = False
        try:
            template.repair_runtime_identity(raw[:-1], module)
        except template.TemplateAdapterError:
            failed = True
        require(failed, "an identity mismatch between the two derivations was accepted")

    require(
        template.runtime_identity() == "PYTHON:" + raw_digest(TEMPLATE_ADAPTER),
        "the template adapter's own runtime identity is not its own digest",
    )
    require(
        template.runtime_identity() != "PYTHON:" + template.REPAIR_ADAPTER_SHA256,
        "the template adapter reports the repair adapter's runtime identity",
    )

    # Cleanup: one repair module per process, and the frozen module reached only through it, so
    # exactly one frozen object exists and `PR_SET_CHILD_SUBREAPER` has exactly one writer.
    require(template._REPAIR is None, "a repair module was loaded before `repair_adapter()` ran")
    repair, repair_raw = template.repair_adapter()
    require(repair_raw == raw, "`repair_adapter()` returned bytes it did not verify")
    failed = False
    try:
        template.repair_adapter()
    except template.TemplateAdapterError:
        failed = True
    require(failed, "a second repair-adapter load in one process was accepted")

    frozen, _ = repair.base_adapter()
    require(
        "PYTHON:" + repair.BASE_ADAPTER_SHA256 == frozen.runtime_identity(),
        "the frozen digest constant disagrees with the loaded frozen module",
    )
    failed = False
    try:
        repair.base_adapter()
    except repair.BaseAdapterError:
        failed = True
    require(failed, "a second frozen-module load in one process was accepted")

    probe = template.environment_probe(frozen)
    require(probe["producer"] == "MEASUREMENT_ADAPTER", "the probe's producer role moved")
    require(
        probe["runtime_identity"] == template.runtime_identity(),
        "the probe does not carry this adapter's own identity",
    )
    return frozen


# --- The launch fixture ---------------------------------------------------------------------------


def task_definition(identity: str, allowed: list[str] | None = None) -> dict:
    return {
        "schema_version": 1,
        "id": identity,
        "source_dir": FIXTURE_SOURCE_DIR,
        "allowed_edits": allowed if allowed is not None else [FIXTURE_EDIT_PATH],
        "validation_argv": ["python3", "tests/test_duration.py", "-v"],
        "validation_timeout_seconds": 10,
    }


class Fixture:
    """One complete template-adapter invocation with a synthetic generation child and runner."""

    def __init__(self, root: Path, name: str, allowed: list[str] | None = None) -> None:
        self.name = name
        self.root = root / name
        self.workspace = self.root / "workspace"
        self.workspace.mkdir(parents=True)
        self.variant_path = self.root / "variant.json"
        self.rendered_path = self.root / "rendered.json"
        self.policy_path = self.root / "generation.json"
        self.control_path = self.root / "control.json"
        self.request_path = self.root / "adapter-request.json"
        self.result_path = self.workspace / "measurement.json"
        self.child_path = self.root / "generation-child"
        self.runner_path = self.root / "validation-runner.py"
        self.task_path = self.root / "task-definition.json"

        self.variant = store(self.variant_path, {
            "schema_version": 1, "artifact_kind": "PROMPT_VARIANT", "variant_id": "baseline-v1",
            "base_prompt": {}, "repo_prompt": {}, "learned_prompt_append": "",
            "context_policy": {}, "candidate_id": "baseline-v1", "content_sha256": "",
        })
        self.rendered = store(self.rendered_path, {
            "schema_version": 1, "artifact_kind": "RENDERED_PROMPT", "task_id": "task",
            "variant_id": "baseline-v1", "variant_sha256": self.variant["content_sha256"],
            "task_prompt_sha256": "1" * 64, "context_sources_sha256": "2" * 64,
            "text": RENDERED_TEXT, "content_sha256": "",
        })
        self.control = store(self.control_path, {
            "schema_version": 1, "artifact_kind": "EVALUATION_PROVIDER_CONTROL",
            "provider_control_id": "control", "provider_kind": "LOCAL_OPENAI",
            "endpoint": "http://127.0.0.1:8000/v1/chat/completions", "endpoint_id": "fixture",
            "model": "fixture-model", "api_key_env": None, "tokenize_endpoint": None,
            "timeout_ns": 20_000_000_000, "max_response_bytes": 262_144, "content_sha256": "",
        })
        self.policy = store(self.policy_path, {
            "schema_version": 1, "artifact_kind": "GENERATION_POLICY",
            "generation_policy_id": "policy", "evaluation_provider_kind": "LOCAL_OPENAI",
            "evaluation_provider_endpoint_id": "fixture",
            "evaluation_provider_model": "fixture-model",
            "provider_control_sha256": self.control["content_sha256"],
            "provider_service_revision": "fixture-v1", "max_prompt_bytes": 65_536,
            "max_tokens": 512, "temperature_micros": 0, "seed_mode": "PAIRED_FIXED",
            "seed_base": 100, "content_sha256": "",
        })
        self.task_path.write_bytes(canonical(task_definition("task", allowed)))
        self.write_child()
        self.write_runner()

    def write_child(self, *, content: str | None = None, exit_code: int = 0) -> None:
        self.child_path.write_text(
            "#!/usr/bin/env python3\n"
            "import hashlib, json, sys\n"
            "request = json.loads(open(sys.argv[3], encoding='utf-8').read())\n"
            "response = {\n"
            "  'schema_version': 1, 'artifact_kind': 'PROMPT_GENERATION_RESPONSE',\n"
            "  'request_id': request['request_id'], 'status': 'GENERATED', 'error_code': 'NONE',\n"
            "  'error': '', 'provider_kind': request['provider_kind'],\n"
            "  'provider_model': request['provider_model'],\n"
            "  'provider_request_sha256': hashlib.sha256(b'dispatched-bytes').hexdigest(),\n"
            "  'seed_result': 'APPLIED', 'applied_seed': request['paired_seed'],\n"
            "  'http_status': 200, 'content': "
            + repr(content if content is not None else RESPONSE_TEXT) + ",\n"
            "  'dispatch_start_ns': 1, 'dispatch_end_ns': 2, 'content_sha256': '',\n"
            "}\n"
            "response['content_sha256'] = hashlib.sha256(\n"
            "  json.dumps(response, ensure_ascii=False, separators=(',', ':')).encode()).hexdigest()\n"
            "open(sys.argv[4], 'w', encoding='utf-8').write(\n"
            "  json.dumps(response, ensure_ascii=False, separators=(',', ':')))\n"
            f"raise SystemExit({exit_code})\n",
            encoding="utf-8",
        )
        self.child_path.chmod(0o755)

    def write_runner(self, *, exit_code: int = 4) -> None:
        self.runner_path.write_text(f"raise SystemExit({exit_code})\n", encoding="utf-8")

    def request(self, **overrides: Any) -> dict:
        value = {
            "schema_version": 1, "artifact_kind": "TASK_ADAPTER_REQUEST",
            "evaluation_id": "evaluation", "task_id": "task", "sample_index": 1,
            "variant": "CANDIDATE", "variant_path": str(self.variant_path),
            "variant_sha256": self.variant["content_sha256"],
            "rendered_prompt_path": str(self.rendered_path),
            "rendered_prompt_sha256": self.rendered["content_sha256"],
            "generation_policy_path": str(self.policy_path),
            "generation_policy_sha256": self.policy["content_sha256"],
            "provider_control_path": str(self.control_path),
            "provider_control_sha256": self.control["content_sha256"],
            "workspace_path": str(self.workspace), "result_path": str(self.result_path),
            "paired_seed": 100, "credential_env_name": None,
            "environment_policy_sha256": "3" * 64,
            "validation_runner_path": str(self.runner_path),
            "validation_runner_sha256": raw_digest(self.runner_path),
            "task_definition_path": str(self.task_path),
            "task_definition_sha256": raw_digest(self.task_path),
            "validation_argv": ["--retained-inputs", "%TASK%", "%PATCH%"],
            "patch_path": None, "patch_sha256": None,
            "generation_child_path": str(self.child_path),
            "generation_child_sha256": raw_digest(self.child_path),
            "task_deadline_ns": 30_000_000_000,
            "content_sha256": "",
        }
        value.update(overrides)
        bind(value)
        self.request_path.write_bytes(canonical(value))
        return value

    def invoke(self, environment: dict[str, str] | None = None, timeout: int = 120):
        child_environment = dict(os.environ)
        if environment:
            child_environment.update(environment)
        completed = subprocess.run(
            [
                sys.executable, str(TEMPLATE_ADAPTER),
                "--prompt-variant", str(self.variant_path),
                "--rendered-prompt", str(self.rendered_path),
                "--sample-index", "1", "--paired-seed", "100",
                "--adapter-request", str(self.request_path),
                "--result", str(self.result_path),
            ],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, timeout=timeout,
            env=child_environment,
        )
        result = (
            json.loads(self.result_path.read_text(encoding="utf-8"))
            if self.result_path.exists() else None
        )
        return completed, result


V3_FIELDS = (
    "schema_version", "artifact_kind", "status", "failure_kind", "build_status", "test_status",
    "repair_loop_count", "unrelated_diff_count", "patch_size_bytes", "public_api_change_count",
    "policy_violation_count", "cleanup_passed", "containment_passed", "benchmark_regression_ppm",
    "generation_to_passing_patch_ns", "rendered_prompt_sha256", "generation_request",
    "environment_probe", "seed_attestation", "diagnostic_summary", "diagnostic_stdout",
    "diagnostic_stderr", "edit_set", "edit_set_total_bytes", "patch_sha256",
    "base_adapter_runtime_identity", "edit_refusal", "completion_bytes", "completion_sha256",
    "completion_text", "content_sha256",
)


def assert_version_three_shape(name: str, result: dict | None, template: ModuleType) -> None:
    require(result is not None, f"{name}: no measurement document was written")
    require(tuple(result) == V3_FIELDS, f"{name}: version-3 field order is {tuple(result)!r}")
    require(result["schema_version"] == 3, f"{name}: schema_version is not 3")
    probe = result["environment_probe"]
    require(probe["producer"] == "MEASUREMENT_ADAPTER", f"{name}: producer moved")
    require(
        probe["runtime_identity"] == "PYTHON:" + raw_digest(TEMPLATE_ADAPTER),
        f"{name}: the probe reports another file's runtime identity",
    )
    require(
        probe["runtime_identity"] != result["base_adapter_runtime_identity"],
        f"{name}: the probe reports the base adapter's identity",
    )
    code = result["edit_refusal"]
    require(
        code in ("NONE",) + template.EDIT_REFUSAL_PATCH_CODES + template.EDIT_REFUSAL_POLICY_CODES,
        f"{name}: edit_refusal {code!r} is outside the ten-code vocabulary",
    )
    require(
        (code in template.EDIT_REFUSAL_PATCH_CODES) == (result["failure_kind"] == "PATCH"),
        f"{name}: the refusal class disagrees with failure_kind",
    )
    if code in template.EDIT_REFUSAL_POLICY_CODES:
        require(
            result["status"] == "POLICY_VIOLATION" and result["failure_kind"] == "POLICY",
            f"{name}: a POLICY-class refusal is not a policy violation",
        )
    if code == "UNCHANGED_FILES":
        require(result["edit_set"] is not None, f"{name}: UNCHANGED_FILES discarded its blocks")
        require(result["patch_sha256"] is None, f"{name}: UNCHANGED_FILES carried a patch digest")
    elif code != "NONE":
        require(result["edit_set"] is None, f"{name}: a no-set refusal carried blocks")
    require(
        (result["completion_bytes"] is None) == (result["completion_sha256"] is None),
        f"{name}: the completion identity members disagree on presence",
    )
    if result["completion_text"] is not None:
        require(
            code != "NONE" and code != "UNCHANGED_FILES",
            f"{name}: completion_text was persisted on {code}",
        )
        require(
            len(result["completion_text"].encode("utf-8")) <= template.COMPLETION_LIMIT,
            f"{name}: completion_text exceeds COMPLETION_LIMIT",
        )
    claimed = result["content_sha256"]
    recomputed = dict(result)
    recomputed["content_sha256"] = ""
    require(
        hashlib.sha256(digest_bytes(recomputed)).hexdigest() == claimed,
        f"{name}: measurement content digest does not bind the record",
    )


def launch_rows(template: ModuleType) -> None:
    with tempfile.TemporaryDirectory(prefix="prompt-template-adapter-smoke-") as scratch_name:
        scratch = Path(scratch_name)

        # Success: `FAIL`/`TEST` carries `NONE`, its blocks, and no completion text.
        failing = Fixture(scratch, "test-fail")
        failing.request()
        completed, result = failing.invoke()
        require(completed.returncode == 0, f"test-fail: adapter exited {completed.returncode}")
        assert_version_three_shape("test-fail", result, template)
        require(
            result["status"] == "FAIL" and result["failure_kind"] == "TEST",
            f"test-fail: got {result['status']}/{result['failure_kind']}",
        )
        require(result["edit_refusal"] == "NONE", "test-fail: a refusal was recorded")
        require(result["edit_set"] is not None, "test-fail: no edit set was carried")
        require(result["completion_text"] is None, "test-fail: a completion excerpt was persisted")
        require(
            result["completion_bytes"] == len(RESPONSE_TEXT.encode("utf-8")),
            "test-fail: completion_bytes is not the completion's length",
        )
        require(
            result["completion_sha256"]
            == hashlib.sha256(RESPONSE_TEXT.encode("utf-8")).hexdigest(),
            "test-fail: completion_sha256 does not digest the completion",
        )

        # Success: `PASS`.
        passing = Fixture(scratch, "pass")
        passing.write_runner(exit_code=0)
        passing.request(validation_runner_sha256=raw_digest(passing.runner_path))
        completed, result = passing.invoke()
        require(completed.returncode == 0, f"pass: adapter exited {completed.returncode}")
        assert_version_three_shape("pass", result, template)
        require(result["status"] == "PASS", f"pass: got {result['status']}")
        require(result["edit_refusal"] == "NONE", "pass: a refusal was recorded")
        require(result["completion_text"] is None, "pass: a completion excerpt was persisted")

        # Failure, and the mode this capability exists for: `UNCHANGED_FILES` keeps its blocks.
        unchanged = Fixture(scratch, "unchanged")
        unchanged.write_child(
            content=f"Here it is.\n\nFILE: {FIXTURE_EDIT_PATH}\n```\n{PINNED_CONTENT}```\n",
        )
        unchanged.request(generation_child_sha256=raw_digest(unchanged.child_path))
        completed, result = unchanged.invoke()
        require(completed.returncode == 0, f"unchanged: adapter exited {completed.returncode}")
        assert_version_three_shape("unchanged", result, template)
        require(
            result["status"] == "FAIL" and result["failure_kind"] == "PATCH",
            f"unchanged: got {result['status']}/{result['failure_kind']}",
        )
        require(
            result["edit_refusal"] == "UNCHANGED_FILES",
            f"unchanged: got refusal {result['edit_refusal']!r}",
        )
        require(result["edit_set"] is not None, "unchanged: the blocks were discarded again")
        require(
            result["edit_set"][0]["body_text"] == PINNED_CONTENT,
            "unchanged: the kept block is not the reproduced file",
        )
        require(result["patch_size_bytes"] == 0, "unchanged: a patch size was carried")
        require(
            result["completion_text"] is None,
            "unchanged: a completion excerpt was persisted where the blocks already explain it",
        )
        require(
            result["diagnostic_summary"] == "the response reproduced the pinned files unchanged",
            "unchanged: the summary is not the frozen message the code was mapped from",
        )

        # Failure: each no-set code carries no blocks and **does** carry the completion excerpt.
        no_set_cases = (
            ("NO_FILE_BLOCK", "I would change src/duration.py to round away from zero.\n"),
            ("HEADER_WITHOUT_BLOCK",
             f"FILE: {FIXTURE_EDIT_PATH}\nprose\nFILE: {SECOND_EDIT_PATH}\n```\na\n```\n"),
            ("UNTERMINATED_BLOCK", f"FILE: {FIXTURE_EDIT_PATH}\n```\nbody without a close\n"),
            ("DUPLICATE_PATH",
             f"FILE: {FIXTURE_EDIT_PATH}\n```\na\n```\n\nFILE: {FIXTURE_EDIT_PATH}\n```\nb\n```\n"),
            ("PATH_NOT_EDITABLE", "FILE: src/legacy.py\n```\nprint(1)\n```\n"),
        )
        for code, content in no_set_cases:
            case = Fixture(scratch, f"no-set-{code.lower()}")
            case.write_child(content=content)
            case.request(generation_child_sha256=raw_digest(case.child_path))
            completed, result = case.invoke()
            require(completed.returncode == 0, f"{code}: adapter exited {completed.returncode}")
            assert_version_three_shape(code, result, template)
            require(result["edit_refusal"] == code, f"{code}: got {result['edit_refusal']!r}")
            require(result["edit_set"] is None, f"{code}: blocks were carried")
            require(
                result["completion_text"] == content,
                f"{code}: the completion excerpt is not the model's own text",
            )
            require(
                result["completion_sha256"] == hashlib.sha256(content.encode("utf-8")).hexdigest(),
                f"{code}: completion_sha256 does not digest the completion",
            )

        # Malformed input: a completion whose encoded result would exceed `RESULT_LIMIT`. The text
        # is dropped whole and the identity members survive, so the measurement is never `ERROR`.
        dense = "\x01" * (template.COMPLETION_LIMIT - 1) + "\n"
        heavy = Fixture(scratch, "result-limit")
        heavy.write_child(content=dense)
        heavy.request(generation_child_sha256=raw_digest(heavy.child_path))
        completed, result = heavy.invoke()
        require(completed.returncode == 0, f"result-limit: adapter exited {completed.returncode}")
        assert_version_three_shape("result-limit", result, template)
        require(
            result["edit_refusal"] == "NO_FILE_BLOCK",
            f"result-limit: got {result['edit_refusal']!r}",
        )
        require(
            result["completion_text"] is None,
            "result-limit: an over-large completion was not dropped whole",
        )
        require(
            result["completion_bytes"] == len(dense.encode("utf-8"))
            and result["completion_sha256"] is not None,
            "result-limit: the identity members did not survive the drop",
        )
        require(result["status"] == "FAIL", "result-limit: the capture turned a measurement into an error")

        # Failure: `ERROR` before the parse. No response exists, so no completion identity does.
        broken = Fixture(scratch, "generation-error")
        broken.write_child(exit_code=3)
        broken.request(generation_child_sha256=raw_digest(broken.child_path))
        completed, result = broken.invoke()
        require(completed.returncode == 0, f"generation-error: adapter exited {completed.returncode}")
        assert_version_three_shape("generation-error", result, template)
        require(result["status"] == "ERROR", f"generation-error: got {result['status']}")
        require(result["edit_refusal"] == "NONE", "generation-error: a refusal was recorded")
        require(result["completion_bytes"] is None, "generation-error: a completion was persisted")

        # Early exit: the declared-patch path parses no response, so `edit_refusal` is `NONE` and
        # `edit_set` is `None`, but a response *was* received and its identity is recorded.
        declared = Fixture(scratch, "declared-patch")
        patch_path = declared.root / "declared.patch"
        patch_path.write_bytes(b"diff --git a/x b/x\n")
        declared.request(patch_path=str(patch_path), patch_sha256=raw_digest(patch_path))
        completed, result = declared.invoke()
        require(completed.returncode == 0, f"declared-patch: adapter exited {completed.returncode}")
        assert_version_three_shape("declared-patch", result, template)
        require(result["edit_refusal"] == "NONE", "declared-patch: a refusal was recorded")
        require(result["edit_set"] is None, "declared-patch: an edit set was carried")
        require(result["completion_text"] is None, "declared-patch: an excerpt was persisted")
        require(
            result["completion_sha256"] is not None,
            "declared-patch: a received response left no identity",
        )

        # Redaction: the credential never reaches the persisted excerpt, and it changes the digest.
        credential = "sk-c4-template-smoke-secret"
        leaky_content = f"I will not answer. token {credential}\n"
        leaky = Fixture(scratch, "redaction")
        leaky.write_child(content=leaky_content)
        leaky.control = store(leaky.control_path, {
            **{key: value for key, value in leaky.control.items() if key != "content_sha256"},
            "api_key_env": "C4_TEMPLATE_SMOKE_TOKEN", "content_sha256": "",
        })
        leaky.policy = store(leaky.policy_path, {
            **{key: value for key, value in leaky.policy.items() if key != "content_sha256"},
            "provider_control_sha256": leaky.control["content_sha256"], "content_sha256": "",
        })
        leaky.request(
            credential_env_name="C4_TEMPLATE_SMOKE_TOKEN",
            provider_control_sha256=leaky.control["content_sha256"],
            generation_policy_sha256=leaky.policy["content_sha256"],
            generation_child_sha256=raw_digest(leaky.child_path),
        )
        completed, result = leaky.invoke({"C4_TEMPLATE_SMOKE_TOKEN": credential})
        require(completed.returncode == 0, f"redaction: adapter exited {completed.returncode}")
        assert_version_three_shape("redaction", result, template)
        require(
            credential.encode("utf-8") not in leaky.result_path.read_bytes(),
            "redaction: the credential survived into the persisted measurement",
        )
        require(
            "[REDACTED]" in result["completion_text"],
            "redaction: the carried completion was not redacted",
        )
        require(
            result["completion_sha256"]
            != hashlib.sha256(leaky_content.encode("utf-8")).hexdigest(),
            "redaction: completion_sha256 digests the unredacted bytes and is a credential oracle",
        )


def main(arguments: list[str] | None = None) -> int:
    values = sys.argv[1:] if arguments is None else list(arguments)
    update = "--update-golden" in values
    check_divergence(update)
    if update:
        return 0
    template = load_template_adapter()
    frozen = hop_rows(template)
    with tempfile.TemporaryDirectory(prefix="prompt-template-refusal-") as scratch_name:
        refusal_rows(template, frozen, Path(scratch_name))
    if LINUX:
        launch_rows(template)
        sys.stdout.write(
            "prompt template adapter: PASS import chain, nine-site refusal mapping, and the "
            "version-3 measurement\n"
        )
    else:
        sys.stdout.write(
            "prompt template adapter: PASS import chain, nine-site refusal mapping, and the "
            "bounded-divergence golden\n"
            "prompt template adapter: SKIP: the sealed-input and containment rows need Linux "
            "(memfd_create, F_ADD_SEALS, /proc/self/fd, PR_SET_CHILD_SUBREAPER); this host is "
            f"{sys.platform}\n"
        )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (RuntimeError, OSError, ValueError, KeyError) as failure:
        sys.stderr.write(f"prompt template adapter: FAIL {failure}\n")
        raise SystemExit(1)
