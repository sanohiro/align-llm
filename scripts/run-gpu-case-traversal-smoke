#!/usr/bin/env python3
"""Compare geometry-derived traversal with independently enumerated tiny-model streams."""

import copy
import hashlib
import pathlib
import struct
import sys
import tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "scripts"))
from gpu_backend_recipe import RecipeError
from gpu_qualification_stream import Frame
from gpu_qualification_traversal import Router, Traversal


CASE = {"prompt_token_ids": [1, 2], "teacher_forced_token_ids": [3],
        "maximum_tokens": 2, "expected_token_ids": [1, 2]}
TOLERANCE = {name + "_tolerance_f32_bits": "00000000" for name in ("absolute", "relative", "near_tie")}


def geometry(routed):
    return {"kind": "R1_MODEL_IR", "schema_version": 2, "model": {
        "arch": "olmoe" if routed else "qwen2", "n_layer": 2, "n_embd": 3,
        "n_vocab": 5, "n_expert": 4 if routed else 0, "n_expert_used": 2 if routed else 0,
        "context_length": 128,
    }}


def golden(routed):
    # Frozen tensor sequence for two generation positions and a DIFFERENT forced token.
    production = [(1, 0xffffffff, 0, 5, 1), (1, 0xffffffff, 1, 5, 1)]
    diagnostic = [(2, 0, 0, 3, 2), (2, 1, 0, 3, 1), (6, 0xffffffff, 0, 5, 1),
                  (2, 0, 1, 3, 1), (2, 1, 1, 3, 1), (6, 0xffffffff, 1, 5, 1)]
    rows = []
    for kind, layer, step, width, height in production + diagnostic + diagnostic:
        if routed and kind == 2:
            for _ in range(height):
                rows.extend(((3, layer, step, 4, 1, struct.pack("<4f", 4, 3, 2, 1)),
                             (4, layer, step, 2, 1, struct.pack("<2i", 0, 1)),
                             (5, layer, step, 2, 1, struct.pack("<2f", .6, .4))))
        rows.append((kind, layer, step, width, height, b"\0" * (width * height * 4)))
    body = bytearray()
    offsets = []
    for ordinal, (kind, layer, step, width, height, data) in enumerate(rows):
        body.extend(struct.pack("<6I2Q", kind, layer, step, width, height, 0, len(data), ordinal))
        offsets.append(24 + len(body))
        body.extend(data)
    body.extend(struct.pack("<6I2Q", 0, 0, 0, 0, 0, 0, 0, len(rows)))
    return struct.pack("<8sIIQ", b"G1TRACE1", 2 if routed else 1, 0, len(body) + 24) + body, offsets


def rejected(call, message):
    try:
        call()
    except RecipeError as error:
        assert message in str(error), (message, str(error))
    else:
        raise AssertionError("invalid case traversal passed")


def main():
    with tempfile.TemporaryDirectory(prefix="gpu-traversal-") as raw:
        root = pathlib.Path(raw).resolve()
        cpu, gpu = root / "cpu", root / "gpu"
        for routed in (False, True):
            plan = Traversal.derive(geometry(routed), CASE)
            data, offsets = golden(routed)
            assert plan.columns == 10 and plan.layer_count == 8 and plan.final_count == 30
            assert plan.scalar_count == (120 if routed else 60)
            assert plan.router_count == (10 if routed else 0)
            assert plan.frame_count == (44 if routed else 14)
            assert plan.maximum_bytes == len(data) == (2384 if routed else 864)
            instructions = list(plan.instructions())
            if routed:
                assert instructions[2:5] == [Router(0, 0, 4, 2, 2), Router(0, 0, 4, 2, 5), Frame(2, 0, 0, 3, 2, 24, 8)]
            else:
                assert instructions[2] == Frame(2, 0, 0, 3, 2, 24, 2)
                assert instructions[3] == Frame(2, 1, 0, 3, 1, 12, 3)
            cpu.write_bytes(data)
            gpu.write_bytes(data)
            def compare(**updates):
                return plan.compare(cpu, gpu, **(dict(
                    reference_sha256=hashlib.sha256(data).hexdigest(), reference_token_ids=[1, 2],
                    candidate_token_ids=[1, 2], comparison=TOLERANCE) | updates))
            numeric, nonfinite, routing_failure = compare()
            assert nonfinite == routing_failure == numeric["mismatch_count"] == 0
            assert numeric["actual_scalar_count"] == numeric["expected_scalar_count"] == plan.scalar_count
            assert numeric["max_absolute_f64_bits"] == numeric["max_relative_f64_bits"] == "0" * 16
            # Production, reproduction and forced replay must all affect the single outcome.
            indices = (0, 13, 43) if routed else (0, 4, 13)
            for index in indices:
                changed = bytearray(data)
                struct.pack_into("<f", changed, offsets[index], 1)
                gpu.write_bytes(changed)
                assert compare()[0]["mismatch_count"] == 1
            struct.pack_into("<f", changed, offsets[-1], float("nan"))
            gpu.write_bytes(changed)
            assert compare()[1] == 1
            gpu.write_bytes(data)
            rejected(lambda: compare(candidate_token_ids=[1, 3]), "token prefix")
            rejected(lambda: compare(reference_token_ids=[1]), "token prefix")

        for key, value, message in (
            ("n_embd", 1 << 25, "payload bound"), ("n_layer", 1 << 30, "stream byte bound"),
            ("n_expert", 1 << 21, "n_expert"), ("n_expert_used", 5, "n_expert_used"),
            ("context_length", 2, "context"), ("n_layer", True, "n_layer"),
        ):
            g = geometry(True)
            g["model"][key] = value
            rejected(lambda: Traversal.derive(g, CASE), message)
        for key, value, message in (
            ("prompt_token_ids", [], "numeric prompt"), ("prompt_token_ids", [0] * 2049, "numeric prompt"),
            ("teacher_forced_token_ids", [], "forced tokens"),
            ("teacher_forced_token_ids", [5], "vocabulary"),
            ("expected_token_ids", [], "expected tokens"), ("maximum_tokens", 129, "maximum tokens"),
        ):
            rejected(lambda: Traversal.derive(geometry(False), CASE | {key: value}), message)
        # Canonical chunk order is independent of the native writer and math kernel.
        g = geometry(False)
        g["model"]["context_length"] = 2048
        long_case = CASE | {"prompt_token_ids": [1] * 257}
        plan = Traversal.derive(g, long_case)
        assert plan.prefill_chunks == 3 and plan.layer_count == 12
        prefill = [row for row in plan.instructions() if isinstance(row, Frame) and row.kind == 2 and row.step == 0]
        assert [(row.layer, row.height) for row in prefill] == [(0, 128), (0, 128), (0, 1), (1, 1)] * 2
        assert plan.columns == 2 * (257 + 1) + 4
        # One-layer prefill is reduced; multiple forced steps do not inherit production's stop.
        g = geometry(True)
        g["model"]["n_layer"] = 1
        plan = Traversal.derive(g, CASE | {"expected_token_ids": [0], "teacher_forced_token_ids": [0, 0, 0]})
        assert plan.columns == 5 and plan.layer_count == 5 and plan.router_count == 5
        assert plan.final_count == 30 and max(item.step for item in plan.instructions()) == 3
    print("gpu case traversal: PASS (independent tensor counts, byte goldens and complete paired outcomes)")


if __name__ == "__main__":
    main()
