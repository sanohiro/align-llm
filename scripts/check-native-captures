#!/usr/bin/env python3
"""Verify source bytes or paired F32 diagnostic captures; never a product path."""
import argparse
from array import array
import json
import math
from pathlib import Path
import sys


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    sub=parser.add_subparsers(dest='mode',required=True)
    weights=sub.add_parser('weights')
    weights.add_argument('gguf',type=Path);weights.add_argument('geometry',type=Path);weights.add_argument('capture',type=Path)
    logits=sub.add_parser('logits')
    logits.add_argument('control',type=Path);logits.add_argument('candidate',type=Path)
    args=parser.parse_args()
    if args.mode=='weights':
        geometry=json.loads(args.geometry.read_text())
        count=0
        with args.gguf.open('rb') as source:
            for block in geometry['blocks']:
                if block['kind']!='MlpBlock':continue
                for t in block['tensors']:
                    role=t['role'].removeprefix('ffn_')
                    if role not in ('gate','up','down'):raise ValueError('unexpected FFN role')
                    actual=(args.capture/f"{block['layer']:02d}-{role}.bin").read_bytes()
                    source.seek(t['absolute_offset']);expected=source.read(t['nbytes'])
                    if len(actual)!=t['nbytes'] or actual!=expected:raise ValueError('weight capture mismatch')
                    count+=1
        if count==0:raise ValueError('no FFN weights')
        print(f'GGUF weight bytes PASS: {count} tensors')
        return
    names=sorted(p.name for p in args.control.glob('*.bin'))
    if not names or names!=sorted(p.name for p in args.candidate.glob('*.bin')):
        raise ValueError('missing or differing capture sets')
    maximum=0.;total=0.;elements=0
    for name in names:
        a=array('f');b=array('f')
        a.frombytes((args.control/name).read_bytes());b.frombytes((args.candidate/name).read_bytes())
        if sys.byteorder!='little':a.byteswap();b.byteswap()
        if not a or len(a)!=len(b):raise ValueError('capture extent mismatch')
        ai=bi=0
        for i,(x,y) in enumerate(zip(a,b)):
            delta=abs(x-y)
            if not math.isfinite(x) or not math.isfinite(y) or delta>0.01:
                raise ValueError(f'logit bound/nonfinite failure: {name} at {i}: {x} vs {y}')
            maximum=max(maximum,delta);total+=delta;elements+=1
            if x>a[ai]:ai=i
            if y>b[bi]:bi=i
        if ai!=bi:raise ValueError(f'greedy argmax mismatch: {name}: {ai} vs {bi}')
    print(json.dumps(dict(status='PASS',vectors=len(names),elements=elements,max_abs=maximum,mean_abs=total/elements,tolerance_abs=0.01,greedy_argmax='identical')))

if __name__=='__main__':main()
