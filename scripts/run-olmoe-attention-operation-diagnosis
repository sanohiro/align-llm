HELPER_KEYS = previous.HELPER_KEYS | {"attention_operations"}
OPERATION_KEYS = {"total_ns", "projections_ns", "attention_core_ns", "output_residual_ns"}
CLASS_ORDER = ("PROJECTIONS", "ATTENTION_CORE", "OUTPUT_RESIDUAL")
CLASS_FIELDS = {
    "PROJECTIONS": "projections_ns",
    "ATTENTION_CORE": "attention_core_ns",
    "OUTPUT_RESIDUAL": "output_residual_ns",
}
TOP_KEYS = previous.TOP_KEYS
BOUNDARY_KEYS = {
    "phase_a_rows", "projection_first_row", "projection_last_row", "core_first_row",
    "core_last_row", "output_residual_first_row", "output_residual_last_row",
    "router_first_row", "router_last_row", "projection_anchor", "core_anchor",
    "output_residual_anchor", "execution",
}
AGGREGATE_KEYS = {
    "full_helper_wall_values_ns", "full_helper_wall_median_ns", "attention_values_ns",
    "attention_median_ns", "class_values_ns", "class_medians_ns", "selected_class",
    "selected_class_median_ns", "selected_class_share_ppm", "floor_ppm", "floor_ns",
    "decision",
}


class AttentionOperationError(RuntimeError):
    pass


def source_identities() -> tuple[str, ...]:
    return tuple(base.file_sha256(path) for path in SOURCE_PATHS)


def validate_imported_contract() -> None:
    actual = (
        previous.MODEL_BYTES, previous.MODEL_SHA256, previous.SERVER_BUILD, previous.BUDGET,
        previous.SEED, previous.FULL_TOKENS, previous.TEMPERATURE_MICROS,
        previous.FULL_OUTPUT_SHA256, previous.FULL_CACHE_BYTES_FETCHED, previous.REPETITIONS,
        previous.CEILING_SECONDS, previous.BASELINE_VALUES_NS, previous.BASELINE_MEDIAN_NS,
        previous.FLOOR_PPM, previous.FLOOR_NS,
    )
    expected = (
        MODEL_BYTES, MODEL_SHA256, SERVER_BUILD, BUDGET, SEED, FULL_TOKENS,
        TEMPERATURE_MICROS, FULL_OUTPUT_SHA256, FULL_CACHE_BYTES_FETCHED, REPETITIONS,
        CEILING_SECONDS, BASELINE_VALUES_NS, BASELINE_MEDIAN_NS, FLOOR_PPM, FLOOR_NS,
    )
    if actual != expected:
        raise AttentionOperationError("imported item 71 workload or baseline drifted")
    if source_identities() != EXPECTED_SOURCE_IDENTITIES:
        raise AttentionOperationError("item 72 source chain drifted")
    if diagnosis.integer_median(BASELINE_VALUES_NS) != BASELINE_MEDIAN_NS:
        raise AttentionOperationError("item 68 baseline median drifted")
    expected_floor = (BASELINE_MEDIAN_NS * FLOOR_PPM + 999_999) // 1_000_000
    if expected_floor != FLOOR_NS:
        raise AttentionOperationError("item 72 materiality floor drifted")


def inherited_record(record: dict[str, Any]) -> dict[str, Any]:
    inherited = dict(record)
    inherited.pop("attention_operations")
    return inherited


def inherited_sample(sample: dict[str, Any]) -> dict[str, Any]:
    inherited = dict(sample)
    inherited["conditioning"] = inherited_record(sample["conditioning"])
    inherited["full"] = inherited_record(sample["full"])
    return inherited


def validate_helper_record(record: dict[str, Any], maximum_tokens: int) -> None:
    diagnosis.require_exact_keys(record, HELPER_KEYS, "helper record")
    previous.validate_helper_record(inherited_record(record), maximum_tokens)
    detail = record["attention_operations"]
    if not isinstance(detail, dict):
        raise AttentionOperationError("attention operation detail was not an object")
    diagnosis.require_exact_keys(detail, OPERATION_KEYS, "attention operations")
    if any(not diagnosis.is_int(detail[name]) or detail[name] < 0 for name in OPERATION_KEYS):
        raise AttentionOperationError("attention operation timing was invalid")
    children = sum(detail[CLASS_FIELDS[name]] for name in CLASS_ORDER)
    if children != detail["total_ns"]:
        raise AttentionOperationError("attention operation slices did not partition their total")
    if detail["total_ns"] != record["phase_a_operations"]["attention_and_residual_ns"]:
        raise AttentionOperationError("attention operation total did not match its phase-A parent")
    if maximum_tokens == 2:
        if any(detail.values()):
            raise AttentionOperationError("conditioning entered remaining attention operations")
    elif any(detail[name] <= 0 for name in OPERATION_KEYS):
        raise AttentionOperationError("full attention operation clock was not positive")


def validate_sample(sample: dict[str, Any], expected_index: int) -> None:
    previous.validate_sample(inherited_sample(sample), expected_index)
    validate_helper_record(sample["conditioning"], 2)
    validate_helper_record(sample["full"], FULL_TOKENS)


def validate_repeatability(samples: list[dict[str, Any]]) -> None:
    previous.validate_repeatability([inherited_sample(sample) for sample in samples])


def measure_request(
    helper: Path, model: Path, pack: Path, geometry: Path, maximum_tokens: int,
    runtime_env: dict[str, str], deadline: float,
) -> tuple[dict[str, Any], int]:
    started_ns = time.monotonic_ns()
    completed = owner.run_process(
        [str(helper), str(model), str(pack), str(geometry), diagnosis.PROMPT_TEXT,
         str(maximum_tokens), str(SEED)],
        deadline=deadline, maximum=240, env=runtime_env,
    )
    helper_wall_ns = time.monotonic_ns() - started_ns
    try:
        record = json.loads(completed.stdout.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as error:
        raise AttentionOperationError("helper did not emit one JSON record") from error
    if not isinstance(record, dict):
        raise AttentionOperationError("helper record was not an object")
    validate_helper_record(record, maximum_tokens)
    if helper_wall_ns < record["phases"]["elapsed_ns"]:
        raise AttentionOperationError("helper wall interval did not contain helper elapsed")
    return record, helper_wall_ns


def measure_sample(
    index: int, built: dict[str, Any], server: Path, model: Path, pack: Path,
    geometry: Path, clean_env: dict[str, str], deadline: float,
) -> dict[str, Any]:
    owner.require_no_matching_process(server, model, deadline, clean_env)
    conditioning, _ = measure_request(
        built["helper"], model, pack, geometry, 2, built["runtime_env"], deadline,
    )
    owner.require_no_matching_process(server, model, deadline, clean_env)
    try:
        full, full_wall = measure_request(
            built["helper"], model, pack, geometry, FULL_TOKENS,
            built["runtime_env"], deadline,
        )
    finally:
        owner.require_no_matching_process(server, model, deadline, clean_env)
    sample = {
        "index": index, "conditioning": conditioning, "full": full,
        "full_helper_wall_ns": full_wall,
        "isolation": {"matching_before": 0, "matching_between": 0, "matching_after": 0},
    }
    validate_sample(sample, index)
    return sample


def select_class(class_medians: dict[str, int]) -> tuple[str, str]:
    selected = CLASS_ORDER[0]
    for name in CLASS_ORDER[1:]:
        if class_medians[name] > class_medians[selected]:
            selected = name
    selected_median = class_medians[selected]
    if selected_median < FLOOR_NS:
        decision = "NO_MATERIAL_ATTENTION_CLASS"
    elif selected == "PROJECTIONS":
        decision = "PROJECTION_SUBDIAGNOSIS_REQUIRED"
    elif selected == "ATTENTION_CORE":
        decision = "ATTENTION_CORE_SUBDIAGNOSIS_REQUIRED"
    else:
        decision = "MEASURED_OUTPUT_RESIDUAL_SEAM_ELIGIBLE"
    return selected, decision


def aggregate(samples: list[dict[str, Any]]) -> dict[str, Any]:
    if len(samples) != REPETITIONS:
        raise AttentionOperationError("aggregate requires four samples")
    for index, sample in enumerate(samples, 1):
        validate_sample(sample, index)
    validate_repeatability(samples)
    walls = [sample["full_helper_wall_ns"] for sample in samples]
    attention = [sample["full"]["attention_operations"]["total_ns"] for sample in samples]
    class_values = {
        name: [sample["full"]["attention_operations"][field] for sample in samples]
        for name, field in CLASS_FIELDS.items()
    }
    class_medians = {
        name: diagnosis.integer_median(class_values[name]) for name in CLASS_ORDER
    }
    selected, decision = select_class(class_medians)
    attention_median = diagnosis.integer_median(attention)
    if attention_median <= 0:
        raise AttentionOperationError("attention median was not positive")
    return {
        "full_helper_wall_values_ns": walls,
        "full_helper_wall_median_ns": diagnosis.integer_median(walls),
        "attention_values_ns": attention,
        "attention_median_ns": attention_median,
        "class_values_ns": class_values,
        "class_medians_ns": class_medians,
        "selected_class": selected,
        "selected_class_median_ns": class_medians[selected],
        "selected_class_share_ppm": class_medians[selected] * 1_000_000 // attention_median,
        "floor_ppm": FLOOR_PPM,
        "floor_ns": FLOOR_NS,
        "decision": decision,
    }


def inherited_result(result: dict[str, Any]) -> dict[str, Any]:
    samples = [inherited_sample(sample) for sample in result["samples"]]
    return {
        "schema_version": 1,
        "artifact_kind": previous.ARTIFACT_KIND,
        "status": "COMPLETE",
        "model": result["model"],
        "baseline": result["baseline"],
        "candidate": result["candidate"],
        "intervention": result["intervention"],
        "boundary": {
            "phase_a_rows": 37, "attention_first_row": 0, "attention_last_row": 31,
            "router_first_row": 32, "router_last_row": 36, "split_anchor": "ffn_inp",
            "execution": "ORDERED_BORROWED_GRAPH_SLICES",
        },
        "task": result["task"],
        "environment": result["environment"],
        "samples": samples,
        "aggregate": previous.aggregate(samples),
        "elapsed_ns": result["elapsed_ns"],
    }


def boundary_record() -> dict[str, Any]:
    return {
        "phase_a_rows": 37,
        "projection_first_row": 0, "projection_last_row": 13,
        "core_first_row": 14, "core_last_row": 27,
        "output_residual_first_row": 28, "output_residual_last_row": 31,
        "router_first_row": 32, "router_last_row": 36,
        "projection_anchor": "v_reshaped", "core_anchor": "attention_value_contiguous",
        "output_residual_anchor": "ffn_inp",
        "execution": "ORDERED_BORROWED_GRAPH_SLICES",
    }


def validate_result(result: dict[str, Any]) -> None:
    diagnosis.require_exact_keys(result, TOP_KEYS, "result")
    if (result["schema_version"] != 1 or result["artifact_kind"] != ARTIFACT_KIND
            or result["status"] != "COMPLETE"):
        raise AttentionOperationError("result identity drifted")
    previous.validate_result(inherited_result(result))
    expected_baseline = {
        "full_helper_wall_values_ns": BASELINE_VALUES_NS,
        "full_helper_wall_median_ns": BASELINE_MEDIAN_NS,
        "floor_ppm": FLOOR_PPM, "floor_ns": FLOOR_NS,
    }
    diagnosis.require_exact_keys(result["baseline"], previous.BASELINE_KEYS, "result baseline")
    if result["baseline"] != expected_baseline:
        raise AttentionOperationError("result baseline drifted")
    diagnosis.require_exact_keys(result["boundary"], BOUNDARY_KEYS, "result boundary")
    if result["boundary"] != boundary_record():
        raise AttentionOperationError("attention boundary drifted")
    diagnosis.require_exact_keys(result["aggregate"], AGGREGATE_KEYS, "result aggregate")
    if result["aggregate"] != aggregate(result["samples"]):
        raise AttentionOperationError("result aggregate drifted")
    if not diagnosis.is_int(result["elapsed_ns"]) or result["elapsed_ns"] <= 0:
        raise AttentionOperationError("result elapsed interval was invalid")


def prerequisites() -> tuple[Path, Path, Path, Path, Path, Path] | None:
    rows = (
        ("ALIGN_LLM_OLMOE_MODEL", base.configured_file("ALIGN_LLM_OLMOE_MODEL")),
        ("ALIGN_LLM_MOE_ALIGNPACK", base.configured_file("ALIGN_LLM_MOE_ALIGNPACK")),
        ("ALIGN_LLM_MOE_GEOMETRY", base.configured_file("ALIGN_LLM_MOE_GEOMETRY")),
        ("ALIGN_LLM_GGML_INCLUDE", base.configured_directory("ALIGN_LLM_GGML_INCLUDE")),
        ("ALIGN_LLM_GGML_LIB", base.configured_directory("ALIGN_LLM_GGML_LIB")),
        ("ALIGN_LLM_LLAMA_SERVER", base.configured_file(
            "ALIGN_LLM_LLAMA_SERVER", executable=True)),
    )
    missing = next((name for name, path in rows if path is None), None)
    if missing is not None:
        print(f"R8-OLMOE-ATTENTION-OPERATION-DIAGNOSIS: N/A ({missing} unset)")
        return None
    return tuple(path.resolve() for _, path in rows)  # type: ignore[return-value]


def synthetic_samples() -> list[dict[str, Any]]:
    samples = previous.synthetic_samples()
    for sample in samples:
        sample["conditioning"]["attention_operations"] = {
            "total_ns": 0, "projections_ns": 0, "attention_core_ns": 0,
            "output_residual_ns": 0,
        }
        total = sample["full"]["phase_a_operations"]["attention_and_residual_ns"]
        sample["full"]["attention_operations"] = {
            "total_ns": total, "projections_ns": total - 3, "attention_core_ns": 1,
            "output_residual_ns": 2,
        }
    return samples


def synthetic_result(samples: list[dict[str, Any]]) -> dict[str, Any]:
    inherited = previous.synthetic_result([inherited_sample(sample) for sample in samples])
    return {
        "schema_version": 1, "artifact_kind": ARTIFACT_KIND, "status": "COMPLETE",
        "model": inherited["model"],
        "baseline": {
            "full_helper_wall_values_ns": BASELINE_VALUES_NS,
            "full_helper_wall_median_ns": BASELINE_MEDIAN_NS,
            "floor_ppm": FLOOR_PPM, "floor_ns": FLOOR_NS,
        },
        "candidate": inherited["candidate"],
        "intervention": previous.intervention_record(),
        "boundary": boundary_record(),
        "task": inherited["task"], "environment": inherited["environment"],
        "samples": samples, "aggregate": aggregate(samples), "elapsed_ns": 1,
    }


def expect_error(action: Any, message: str) -> None:
    try:
        action()
    except Exception:
        return
    raise AttentionOperationError(message)


def complete_result_after_cleanup(result: dict[str, Any], started_ns: int) -> dict[str, Any]:
    completed = dict(result)
    elapsed_ns = time.monotonic_ns() - started_ns
    if elapsed_ns > CEILING_SECONDS * 1_000_000_000:
        raise AttentionOperationError(
            f"complete diagnosis exceeded its 8-minute ceiling ({elapsed_ns / 1e9:.1f}s)"
        )
    completed["elapsed_ns"] = elapsed_ns
    validate_result(completed)
    return completed


def self_test() -> int:
    validate_imported_contract()
    samples = synthetic_samples()
    result = synthetic_result(samples)
    validate_result(result)
    decisions = (
        ({"PROJECTIONS": FLOOR_NS, "ATTENTION_CORE": 1, "OUTPUT_RESIDUAL": 1},
         "PROJECTION_SUBDIAGNOSIS_REQUIRED"),
        ({"PROJECTIONS": 1, "ATTENTION_CORE": FLOOR_NS, "OUTPUT_RESIDUAL": 1},
         "ATTENTION_CORE_SUBDIAGNOSIS_REQUIRED"),
        ({"PROJECTIONS": 1, "ATTENTION_CORE": 1, "OUTPUT_RESIDUAL": FLOOR_NS},
         "MEASURED_OUTPUT_RESIDUAL_SEAM_ELIGIBLE"),
    )
    for medians, expected in decisions:
        if select_class(medians)[1] != expected:
            raise AttentionOperationError(f"material class did not select {expected}")
    tied = {name: FLOOR_NS for name in CLASS_ORDER}
    if select_class(tied) != ("PROJECTIONS", "PROJECTION_SUBDIAGNOSIS_REQUIRED"):
        raise AttentionOperationError("declared-order tie break drifted")
    below = {"PROJECTIONS": FLOOR_NS - 1, "ATTENTION_CORE": 1, "OUTPUT_RESIDUAL": 1}
    if select_class(below)[1] != "NO_MATERIAL_ATTENTION_CLASS":
        raise AttentionOperationError("below-floor class selected a successor")
    malformed = synthetic_samples()
    malformed[0]["full"]["attention_operations"]["attention_core_ns"] = True
    expect_error(lambda: aggregate(malformed), "boolean operation clock was accepted")
    malformed = synthetic_samples()
    malformed[0]["full"]["attention_operations"]["attention_core_ns"] += 1
    expect_error(lambda: aggregate(malformed), "overlapping operation clocks were accepted")
    malformed = synthetic_samples()
    malformed[0]["full"]["attention_operations"]["total_ns"] -= 1
    expect_error(lambda: aggregate(malformed), "wrong parent operation clock was accepted")
    malformed_result = dict(result)
    malformed_result["boundary"] = dict(result["boundary"])
    malformed_result["boundary"]["core_last_row"] = 26
    expect_error(lambda: validate_result(malformed_result), "drifted graph boundary was accepted")
    actual_file_sha256 = base.file_sha256
    changed_source = ROOT / "src/moe_decode_step.align"

    def changed_hash(path: Path) -> str:
        return "0" * 64 if path == changed_source else actual_file_sha256(path)

    with mock.patch.object(base, "file_sha256", side_effect=changed_hash):
        expect_error(validate_imported_contract, "changed producer source was accepted")
    with mock.patch.dict(os.environ, {}, clear=True), mock.patch("builtins.print") as printed:
        if prerequisites() is not None:
            raise AttentionOperationError("missing prerequisites did not produce N/A")
    printed.assert_called_once_with(
        "R8-OLMOE-ATTENTION-OPERATION-DIAGNOSIS: N/A (ALIGN_LLM_OLMOE_MODEL unset)"
    )
    print("R8-OLMOE-ATTENTION-OPERATION-DIAGNOSIS self-test: PASS")
    return 0


def main() -> int:
    if sys.argv[1:] == ["--self-test"]:
        return self_test()
    if len(sys.argv) != 1:
        raise AttentionOperationError("attention operation diagnosis accepts no arguments")
    required = prerequisites()
    if required is None:
        return 0
    model, pack, geometry, include, library, server = required
    started_ns = time.monotonic_ns()
    deadline = time.monotonic() + CEILING_SECONDS

    with tempfile.TemporaryDirectory(prefix="align-r8-olmoe-attention-operation-") as raw:
        work = Path(raw)
        clean_env = transfer.phase.decision.decision_environment()
        linker_search = transfer.phase.decision.validate_linker_search(clean_env)
        if linker_search:
            clean_env["LIBRARY_PATH"] = linker_search
        host_environment = transfer.qualification_host(clean_env, deadline)
        status = owner.run_process(
            ["git", "status", "--porcelain", "--untracked-files=all"],
            deadline=deadline, maximum=30, env=clean_env,
        )
        if status.stdout:
            raise AttentionOperationError("real diagnosis requires a clean worktree")
        align_llm_head = owner.run_process(
            ["git", "rev-parse", "HEAD"], deadline=deadline, maximum=30, env=clean_env,
        ).stdout.decode("ascii").strip()
        validate_imported_contract()
        align_revision = (ROOT / ".align-revision").read_text(encoding="utf-8").strip()
        owner.require_no_matching_process(server, model, deadline, clean_env)
        if model.stat().st_size != MODEL_BYTES or base.file_sha256(model) != MODEL_SHA256:
            raise AttentionOperationError("configured OLMoE GGUF does not have pinned identity")
        pack_sha256 = base.file_sha256(pack)
        geometry_sha256 = base.file_sha256(geometry)
        server_sha256 = base.file_sha256(server)
        task_sha256 = base.file_sha256(diagnosis.TASK)
        prompt_sha256 = base.bytes_sha256(diagnosis.PROMPT_TEXT.encode("utf-8"))
        ggml_libraries = base.library_identities(library)
        ggml_headers = previous.previous.compute.predecessor.ggml_header_identities(include)
        linker_search_sha256 = (
            None if not linker_search else base.bytes_sha256(linker_search.encode("utf-8"))
        )
        diagnosis.validate_external_identity(
            align_revision=align_revision, pack_sha256=pack_sha256,
            geometry_sha256=geometry_sha256, server_sha256=server_sha256,
            task_sha256=task_sha256, prompt_sha256=prompt_sha256,
            ggml_libraries=ggml_libraries, linker_search_sha256=linker_search_sha256,
        )
        version = owner.run_process(
            [str(server), "--version"], deadline=deadline, maximum=30, env=clean_env,
        )
        if SERVER_BUILD not in (version.stdout + version.stderr).decode("utf-8", "replace"):
            raise AttentionOperationError("llama-server build identity drifted")

        with previous.previous.compute.other.predecessor.built_helper_for(
            work, include, library, clean_env, deadline,
            "src/olmoe_attention_operation_gate.align", "olmoe_attention_operation_gate",
            "olmoe-attention-operation-gate",
        ) as built:
            diagnosis.validate_toolchain_identity(built)
            samples = []
            for index in range(1, REPETITIONS + 1):
                samples.append(
                    measure_sample(index, built, server, model, pack, geometry, clean_env, deadline)
                )
                validate_repeatability(samples)

            final_status = owner.run_process(
                ["git", "status", "--porcelain", "--untracked-files=all"],
                deadline=deadline, maximum=30, env=clean_env,
            )
            final_head = owner.run_process(
                ["git", "rev-parse", "HEAD"], deadline=deadline, maximum=30, env=clean_env,
            ).stdout.decode("ascii").strip()
            if final_status.stdout or final_head != align_llm_head:
                raise AttentionOperationError("align-llm source changed during diagnosis")
            if source_identities() != EXPECTED_SOURCE_IDENTITIES:
                raise AttentionOperationError("diagnosis sources changed during measurement")
            owner.verify_identities((
                ("model", model, MODEL_SHA256), ("pack", pack, pack_sha256),
                ("geometry", geometry, geometry_sha256), ("server", server, server_sha256),
                ("task", diagnosis.TASK, task_sha256),
                ("compiler", built["compiler"], built["compiler_sha256"]),
                ("C compiler", built["c_compiler"], built["c_compiler_sha256"]),
                ("shim", built["shim"], built["shim_sha256"]),
                ("helper", built["helper"], built["helper_sha256"]),
            ))
            if base.library_identities(library) != ggml_libraries:
                raise AttentionOperationError("ggml libraries changed during diagnosis")
            if previous.previous.compute.predecessor.ggml_header_identities(include) != ggml_headers:
                raise AttentionOperationError("ggml headers changed during diagnosis")
            owner.require_no_matching_process(server, model, deadline, clean_env)

            task_document = json.loads(diagnosis.TASK.read_text(encoding="utf-8"))
            result = {
                "schema_version": 1, "artifact_kind": ARTIFACT_KIND, "status": "COMPLETE",
                "model": {"bytes": MODEL_BYTES, "sha256": MODEL_SHA256, "architecture": "olmoe"},
                "baseline": {
                    "full_helper_wall_values_ns": BASELINE_VALUES_NS,
                    "full_helper_wall_median_ns": BASELINE_MEDIAN_NS,
                    "floor_ppm": FLOOR_PPM, "floor_ns": FLOOR_NS,
                },
                "candidate": {
                    "provider": "align-runtime", "align_llm_head": align_llm_head,
                    "align_revision": align_revision, "compiler_sha256": built["compiler_sha256"],
                    "helper_sha256": built["helper_sha256"], "shim_sha256": built["shim_sha256"],
                    "ggml_libraries": ggml_libraries, "ggml_headers": ggml_headers,
                    "pack_sha256": pack_sha256, "geometry_sha256": geometry_sha256,
                    "cache_budget_bytes": BUDGET,
                },
                "intervention": previous.intervention_record(),
                "boundary": boundary_record(),
                "task": {
                    "task_id": task_document["id"], "task_sha256": task_sha256,
                    "prompt_sha256": prompt_sha256, "maximum_tokens": FULL_TOKENS,
                    "temperature_micros": TEMPERATURE_MICROS, "seed": SEED,
                    "full_output_sha256": FULL_OUTPUT_SHA256,
                },
                "environment": {
                    **host_environment, "c_compiler_sha256": built["c_compiler_sha256"],
                    "c_compiler_version_sha256": built["c_compiler_version_sha256"],
                    "linker_search_sha256": linker_search_sha256,
                },
                "samples": samples, "aggregate": aggregate(samples),
            }
    result = complete_result_after_cleanup(result, started_ns)
    detail = result["aggregate"]
    print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))
    print(
        "R8-OLMOE-ATTENTION-OPERATION-DIAGNOSIS: COMPLETE "
        f"decision={detail['decision']} selected={detail['selected_class']} "
        f"median={detail['selected_class_median_ns'] / 1e9:.3f}s "
        f"attention={detail['attention_median_ns'] / 1e9:.3f}s "
        f"elapsed={result['elapsed_ns'] / 1e9:.2f}s",
        file=sys.stderr,
    )
    return 0


def interrupted(signal_number: int, _frame: object) -> None:
    owner.stop_owned_processes()
    raise SystemExit(128 + signal_number)


if __name__ == "__main__":
    signal.signal(signal.SIGINT, interrupted)
    signal.signal(signal.SIGTERM, interrupted)
    try:
        raise SystemExit(main())
    except Exception as error:
        owner.stop_owned_processes()
        print(f"R8-OLMOE-ATTENTION-OPERATION-DIAGNOSIS: FAIL {error}", file=sys.stderr)
        raise SystemExit(1)
