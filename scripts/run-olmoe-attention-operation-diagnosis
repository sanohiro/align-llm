#!/usr/bin/env python3
"""Diagnose OLMoE attention as projection, core, and output/residual slices."""

from __future__ import annotations

import importlib.util
from importlib.machinery import SourceFileLoader
import json
import os
import signal
import sys
import tempfile
import time
from pathlib import Path
from typing import Any
from unittest import mock


ROOT = Path(__file__).resolve().parents[1]
PREDECESSOR_PATH = ROOT / "scripts/run-olmoe-phase-a-operation-diagnosis"
PREDECESSOR_LOADER = SourceFileLoader(
    "olmoe_phase_a_for_attention_operation_diagnosis", str(PREDECESSOR_PATH)
)
PREDECESSOR_SPEC = importlib.util.spec_from_loader(
    PREDECESSOR_LOADER.name, PREDECESSOR_LOADER
)
if PREDECESSOR_SPEC is None or PREDECESSOR_SPEC.loader is None:
    raise RuntimeError("cannot load the phase-A operation owner")
previous = importlib.util.module_from_spec(PREDECESSOR_SPEC)
sys.modules[PREDECESSOR_LOADER.name] = previous
PREDECESSOR_SPEC.loader.exec_module(previous)

base = previous.base
diagnosis = previous.diagnosis
owner = previous.owner
transfer = previous.transfer

ARTIFACT_KIND = "R8_OLMOE_ATTENTION_OPERATION_DIAGNOSIS"
MODEL_BYTES = previous.MODEL_BYTES
MODEL_SHA256 = previous.MODEL_SHA256
SERVER_BUILD = previous.SERVER_BUILD
BUDGET = previous.BUDGET
SEED = previous.SEED
FULL_TOKENS = previous.FULL_TOKENS
TEMPERATURE_MICROS = previous.TEMPERATURE_MICROS
FULL_OUTPUT_SHA256 = previous.FULL_OUTPUT_SHA256
FULL_CACHE_BYTES_FETCHED = previous.FULL_CACHE_BYTES_FETCHED
REPETITIONS = previous.REPETITIONS
CEILING_SECONDS = previous.CEILING_SECONDS
BASELINE_VALUES_NS = previous.BASELINE_VALUES_NS
BASELINE_MEDIAN_NS = previous.BASELINE_MEDIAN_NS
FLOOR_PPM = previous.FLOOR_PPM
FLOOR_NS = previous.FLOOR_NS


def unique_paths(paths: tuple[Path, ...]) -> tuple[Path, ...]:
    result: list[Path] = []
    for path in paths:
        if path not in result:
            result.append(path)
    return tuple(result)


