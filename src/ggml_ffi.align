pub fn op_rms_norm(
  ctx: raw, borrow slots: slice<u8>, out: i64, a: i64, eps_bits: i64, label: str,
) -> Result<(), Fault> {
  unsafe {
    return r5_result(align_ggml_op_rms_norm(ctx, slots, out, a, eps_bits as i32) as i64, label)
  }
}

pub fn op_mul(
  ctx: raw, borrow slots: slice<u8>, out: i64, a: i64, b: i64, label: str) -> Result<(), Fault> {
