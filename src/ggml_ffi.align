    return r5_result(align_ggml_slot_get(slots, index, bytes, offset, size) as i64, label)
  }
}

// Mandatory for every oracle node. Without it `ggml_gallocr` reuses an intermediate's memory and
// the bytes read back are not the node computed — section 5.6's recorded risk, hit by the probe.
pub fn slot_mark_output(borrow slots: slice<u8>, index: i64, label: str) -> Result<(), Fault> {
  unsafe {
    return r5_result(align_ggml_slot_mark_output(slots, index) as i64, label)
  }
}

pub fn op_get_rows(
  ctx: raw, borrow slots: slice<u8>, out: i64, a: i64, b: i64, label: str) -> Result<(), Fault> {
