    return r5_result(align_ggml_op_mul_mat(ctx, slots, out, a, b) as i64, label)
  }
}

pub fn op_reshape_3d(
  ctx: raw, borrow slots: slice<u8>, out: i64, a: i64,
  ne0: i64, ne1: i64, ne2: i64, label: str,
) -> Result<(), Fault> {
  unsafe {
    return r5_result(align_ggml_op_reshape_3d(ctx, slots, out, a, ne0, ne1, ne2) as i64, label)
  }
}

pub fn op_permute(
  ctx: raw, borrow slots: slice<u8>, out: i64, a: i64,
  p0: i64, p1: i64, p2: i64, p3: i64, label: str,
) -> Result<(), Fault> {
  unsafe {
    return r5_result(
      align_ggml_op_permute(ctx, slots, out, a, p0 as i32, p1 as i32, p2 as i32, p3 as i32) as i64,
      label)
  }
}

// `ggml_cont_3d` covers both shapes the layer needs: the transposed V is genuinely 3-D and
// `kqv_out` is the `ne2 = 1` case the plan called `cont_2d` (section 6, correction C4).
pub fn op_cont_3d(
  ctx: raw, borrow slots: slice<u8>, out: i64, a: i64,
  ne0: i64, ne1: i64, ne2: i64, label: str,
) -> Result<(), Fault> {
  unsafe {
    return r5_result(align_ggml_op_cont_3d(ctx, slots, out, a, ne0, ne1, ne2) as i64, label)
  }
}

// Every float crosses as an `i32` bit pattern and the shim `memcpy`s it into a `float`. Section 2.6
// verified that `f32` crosses this boundary correctly in both directions; the design still does not
// use it, because `r1-qwen-model-ir.md` publishes the authoritative values as IEEE-754 hex and a
// bit pattern is the only form in which "the same scalar the GGUF stores" is a checkable claim.
pub fn op_rope_neox(
  ctx: raw, borrow slots: slice<u8>, out: i64, a: i64, pos: i64,
  n_dims: i64, mode: i64, n_ctx_orig: i64, freq_base_bits: i64, label: str,
) -> Result<(), Fault> {
  unsafe {
    return r5_result(
      align_ggml_op_rope_neox(
        ctx, slots, out, a, pos, n_dims as i32, mode as i32, n_ctx_orig as i32,
        freq_base_bits as i32) as i64,
      label)
  }
}

pub fn op_soft_max_ext(
  ctx: raw, borrow slots: slice<u8>, out: i64, a: i64, mask: i64,
  scale_bits: i64, max_bias_bits: i64, label: str,
) -> Result<(), Fault> {
  unsafe {
    return r5_result(
      align_ggml_op_soft_max_ext(
        ctx, slots, out, a, mask, scale_bits as i32, max_bias_bits as i32) as i64,
      label)
  }
}

pub fn op_swiglu_split(
  ctx: raw, borrow slots: slice<u8>, out: i64, a: i64, b: i64, label: str) -> Result<(), Fault> {
  unsafe {
    return r5_result(align_ggml_op_swiglu_split(ctx, slots, out, a, b) as i64, label)
  }
}

// R5B section 3.6. `ggml_pad` appends zeroes at the **end** of each axis, so the source occupies
// the leading positions and the padded lanes are zero. Each `p` is validated non-negative and
// bounded by the shim, and the result's element count is validated against the shim's own cap
// before the handle is stored, so a malformed width cannot ask ggml for a terabyte.
pub fn op_pad(
  ctx: raw, borrow slots: slice<u8>, out: i64, a: i64,
  p0: i64, p1: i64, p2: i64, p3: i64, label: str,
) -> Result<(), Fault> {
  unsafe {
    return r5_result(
      align_ggml_op_pad(ctx, slots, out, a, p0 as i32, p1 as i32, p2 as i32, p3 as i32) as i64,
      label)
  }
}

// R6 section 2.5. `ggml_concat(a, b, dim)`, modelled on `op_argsort`: the selector is refused in
// Align before the call so a malformed axis is `R5_GGML_INIT` naming the row rather than a status
// the shim has to invent a meaning for, and it is narrowed to `i32` only at the call.
//
// Section 2.4 is why `dim` is a parameter rather than a constant: a decode layer concatenates K on
// axis 1 and V on axis 0, and a single shared value here would be a silent transpose that every
// shape check downstream would accept.
pub fn op_concat(
  ctx: raw, borrow slots: slice<u8>, out: i64, a: i64, b: i64, dim: i64, label: str,
) -> Result<(), Fault> {
  if dim < 0 || dim > 3 {
    return Err(r5_fault(STATUS_INIT, label))
  }
  unsafe {
    return r5_result(align_ggml_op_concat(ctx, slots, out, a, b, dim as i32) as i64, label)
  }
}

// R5B section 6, correction C5. `n` bytes from `source` into `window` at `offset`, with every bound
// checked in C before the copy. This is how the one reused weight window is filled thirty times.
//
// The two lengths the shim bounds the copy against are the **views'** own lengths, never a caller's
// declaration of them (section 6, correction C20). A declared length is a claim; `slice.len()` is
// the range the borrow actually covers, and a `memcpy` bounded by the first would write outside the
// second the moment the two disagree.
pub fn window_copy(
  borrow window: slice<u8>,
  offset: i64,
  borrow source: slice<u8>,
  n: i64,
  label: str,
) -> Result<(), Fault> {
  unsafe {
    return r5_result(
      align_ggml_window_copy(window, window.len(), offset, source, source.len(), n) as i64, label)
  }
}

// R8-OLMOE-KV-PLANE-STAGING-TRANSFER section 2. One bounded native transpose replaces the
// per-scalar Align loops. Both lengths come from the borrowed views, and C validates the complete
// K/V source ranges, exact combined destination, and non-overlap before writing any byte.
pub fn stage_kv(
  borrow plane: slice<u8>,
  k_base: i64,
  v_base: i64,
  borrow stage: slice<u8>,
  head_dim: i64,
  n_head_kv: i64,
  n_past: i64,
  label: str,
) -> Result<(), Fault> {
  unsafe {
    return r5_result(align_ggml_stage_kv(
        plane, plane.len(), k_base, v_base, stage, stage.len(),
        head_dim, n_head_kv, n_past) as i64, label)
  }
}

pub KV_LAYOUT_K := 0
pub KV_LAYOUT_V := 1

// R8-OLMOE-PLANE-ROUNDTRIP-BOUNDARY section 2. The native return is encoded so the complete result
// crosses in one scalar: zero is exact, a positive value is mismatch-column-plus-one, and a
// negative value is an existing shim status. Both borrowed slice lengths cross independently and C
// validates their complete read ranges before comparing any byte.
pub fn compare_kv_plane(
  borrow consumed: slice<u8>,
  borrow plane: slice<u8>,
  plane_base: i64,
  head_dim: i64,
  n_head_kv: i64,
  columns: i64,
  layout: i64,
  label: str,
) -> Result<i64, Fault> {
  if layout != KV_LAYOUT_K && layout != KV_LAYOUT_V {
    return Err(r5_fault(STATUS_BOUNDS, label))
  }
  unsafe {
    result := align_ggml_compare_kv_plane(
      consumed, consumed.len(), plane, plane.len(), plane_base,
      head_dim, n_head_kv, columns, layout as i32)
    if result < 0 { return Err(r5_fault(result, label)) }
    return Ok(result - 1)
  }
}

// Intervention B keeps the exact result encoding above, but resolves a ggml-owned host-visible
// tensor through its slot so Oracle B does not copy it into an Align window before comparison.
pub fn slot_compare_kv_plane(
  borrow slots: slice<u8>,
  index: i64,
  borrow plane: slice<u8>,
  plane_base: i64,
  head_dim: i64,
  n_head_kv: i64,
  columns: i64,
  layout: i64,
  label: str,
) -> Result<i64, Fault> {
  if layout != KV_LAYOUT_K && layout != KV_LAYOUT_V {
    return Err(r5_fault(STATUS_BOUNDS, label))
  }
  unsafe {
    result := align_ggml_slot_compare_kv_plane(
      slots, index, plane, plane.len(), plane_base,
      head_dim, n_head_kv, columns, layout as i32)
    if result < 0 { return Err(r5_fault(result, label)) }
    return Ok(result - 1)
  }
}

// ---------------------------------------------------------------------------------------------
// R5D — the routed layer's five new wrappers
//
// `docs/specs/r5d-moe-layer-forward.md` section 3.5. Each is one `unsafe` block containing one
// foreign call, in the shape every R5A wrapper already has.
// ---------------------------------------------------------------------------------------------

// `ggml_argsort`'s two orders, validated in C. `ggml_top_k` is deliberately **not** wrapped: its
// own header says the indices it returns are in no particular order, and section 2.2 fact 3
// measured the slot order of `ffn_moe_topk-0` to be descending probability and section 2.3 measured
// that order to be load-bearing to the last bit.
pub SORT_ORDER_ASC := 0
pub SORT_ORDER_DESC := 1

// `mask == -1` means "no mask", which is the widened input domain of `op_soft_max_ext`. It is a
// named constant rather than a bare `-1` at the call site so the node table reads as data.
pub SOFT_MAX_NO_MASK := -1

pub fn op_argsort(
  ctx: raw, borrow slots: slice<u8>, out: i64, a: i64, order: i64, label: str,
) -> Result<(), Fault> {
  if order != SORT_ORDER_ASC && order != SORT_ORDER_DESC {
    return Err(r5_fault(STATUS_INIT, label))
  }
  unsafe {
    return r5_result(align_ggml_op_argsort(ctx, slots, out, a, order as i32) as i64, label)
  }
}

// The stacked-expert matrix multiply. `as_slot` holds a `{ne0, ne1, U}` tensor, `b` the activation,
// and `ids` a `{n_expert_used, T}` i32 tensor of **compact** slot indices in `[0, U)`. Section 2.3
// measured the compact form byte-identical to llama.cpp's whole-tensor shape.
pub fn op_mul_mat_id(
  ctx: raw, borrow slots: slice<u8>, out: i64, as_slot: i64, b: i64, ids: i64, label: str,
) -> Result<(), Fault> {
  unsafe {
    return r5_result(align_ggml_op_mul_mat_id(ctx, slots, out, as_slot, b, ids) as i64, label)
  }
}

// A 2-D window on a tensor, addressed by dimension **selector**. `nb1_dim` names the axis whose
// stride becomes the view's row stride and `offset_dim` names the axis the offset counts in, so the
// caller supplies two small integers in `[0, 3]` and an index — never a byte count and never a
// pointer. The expert reduction's slot `i` is `view_2d(weighted, n_embd, T, nb1_dim: 2,
// offset_dim: 1, offset_index: i)`.
pub fn op_view_2d(
  ctx: raw,
  borrow slots: slice<u8>,
  out: i64,
  a: i64,
  ne0: i64,
  ne1: i64,
  nb1_dim: i64,
  offset_dim: i64,
  offset_index: i64,
  label: str,
) -> Result<(), Fault> {
  if nb1_dim < 0 || nb1_dim > 3 || offset_dim < 0 || offset_dim > 3 {
    return Err(r5_fault(STATUS_INIT, label))
  }
  unsafe {
    return r5_result(
      align_ggml_op_view_2d(
        ctx, slots, out, a, ne0, ne1, nb1_dim as i32, offset_dim as i32, offset_index) as i64,
      label)
  }
}

// The stacked expert operand. It mirrors `slot_new_tensor_2d` — same operand-table gate, same type
// bound — with `ne2` the compact stack's depth `U`, which is the design's one data-dependent shape
// parameter.
pub fn slot_new_tensor_3d(
  ctx: raw,
  borrow slots: slice<u8>,
  out: i64,
  kind: i64,
  ne0: i64,
  ne1: i64,
  ne2: i64,
  label: str,
) -> Result<(), Fault> {
  if !type_representable(kind) { return Err(r5_fault(STATUS_TYPE, label)) }
  unsafe {
    return r5_result(
      align_ggml_slot_new_tensor_3d(ctx, slots, out, kind as i32, ne0, ne1, ne2) as i64, label)
  }
}

// A stacked expert operand whose planes live in fixed-size cache slots. The shim owns every byte
// calculation and installs the expert stride only after proving the final reachable byte fits.
pub fn slot_new_strided_tensor_3d(
  ctx: raw,
  borrow slots: slice<u8>,
  out: i64,
  kind: i64,
  ne0: i64,
  ne1: i64,
  ne2: i64,
  slice_stride: i64,
  label: str,
) -> Result<(), Fault> {
  if !type_representable(kind) { return Err(r5_fault(STATUS_TYPE, label)) }
  unsafe {
    return r5_result(
      align_ggml_slot_new_strided_tensor_3d(
        ctx, slots, out, kind as i32, ne0, ne1, ne2, slice_stride) as i64,
      label)
  }
}

// The `{n_expert_used, T}` id tensors. Like `slot_new_i32_1d` it does **not** go through the
// `mul_mat` operand table, because that table is the left-operand predicate and widening it to
// admit `I32` would let a quantized-weight path accept an index tensor (section 2.8).
pub fn slot_new_i32_2d(
  ctx: raw, borrow slots: slice<u8>, out: i64, ne0: i64, ne1: i64, label: str,
) -> Result<(), Fault> {
  unsafe {
    return r5_result(align_ggml_slot_new_i32_2d(ctx, slots, out, ne0, ne1) as i64, label)
  }
}

// The context size a graph of `node_capacity` tensors needs, asked of the linked library so Align
// never guesses one. A negative answer is an implausible capacity and the caller reports `R5_ABI`.
pub fn graph_context_bytes(node_capacity: i64) -> i64 {
  unsafe {
    return align_ggml_graph_context_bytes(node_capacity)
  }
}

pub fn graph_new(ctx: raw) -> raw {
  unsafe {
    return align_ggml_graph_new(ctx)
  }
}

// A qualification-only contiguous view over an already-built graph. `suffix = false` includes the
// unique boundary node; `suffix = true` starts immediately after it. The returned graph borrows all
// tensor pointers and must die before their source contexts and allocator.
pub fn graph_partition(
  ctx: raw, graph: raw, borrow slots: slice<u8>, boundary_slot: i64, suffix: bool,
) -> raw {
  unsafe {
    return align_ggml_graph_partition(
      ctx, graph, slots, boundary_slot, if suffix { 1 } else { 0 })
  }
}

// A qualification-only operation-class view over an already-built graph. Every populated slot in
// the inclusive range must occur exactly once in the source graph. The selected nodes retain the
// source graph's topological order even when dependency traversal interleaves their slot numbers.
pub fn graph_select_slot_range(
  ctx: raw, graph: raw, borrow slots: slice<u8>, first_slot: i64, last_slot: i64,
) -> raw {
  unsafe {
    return align_ggml_graph_select_slot_range(ctx, graph, slots, first_slot, last_slot)
  }
}

pub fn graph_expand(
  graph: raw, borrow slots: slice<u8>, index: i64, label: str) -> Result<(), Fault> {
  unsafe {
    return r5_result(align_ggml_graph_expand(graph, slots, index) as i64, label)
  }
}

pub fn graph_node_count(graph: raw) -> i64 {
  unsafe {
    return align_ggml_graph_node_count(graph) as i64
  }
}

pub fn gallocr_new(backend: raw) -> raw {
  unsafe {
    return align_ggml_gallocr_new(backend)
  }
}

// Section 2.6's `bool` translation, and the reason two entry points had to be wrapped at all:
// `ggml_gallocr_reserve` and `ggml_gallocr_alloc_graph` both return `bool`, which is not an FFI type
// at this pin, so a `false` becomes `STATUS_ALLOC` and then `R5_ALLOC`.
pub fn gallocr_reserve(galloc: raw, graph: raw, label: str) -> Result<(), Fault> {
  unsafe {
    return r5_result(align_ggml_gallocr_reserve(galloc, graph) as i64, label)
  }
}

pub fn gallocr_alloc(galloc: raw, graph: raw, label: str) -> Result<(), Fault> {
  unsafe {
    return r5_result(align_ggml_gallocr_alloc(galloc, graph) as i64, label)
  }
}

pub fn gallocr_bytes(galloc: raw) -> i64 {
  unsafe {
    return align_ggml_gallocr_bytes(galloc)
  }
}

// Total and idempotent against a null handle, because the teardown of section 3.9 runs on every
// exit path from construction onward.
pub fn gallocr_free(galloc: raw) {
  unsafe {
    align_ggml_gallocr_free(galloc)
  }
}

// Returns the `ggml_status` verbatim; `0` is success and section 3.8 step 24 maps anything else to
// `R5_COMPUTE` with detail `status[<n>]`.
pub fn graph_compute(backend: raw, graph: raw) -> i64 {
  unsafe {
    return align_ggml_graph_compute(backend, graph) as i64
  }
}
