  unsafe {
    return r5_result(
      align_ggml_slot_new_tensor_2d(ctx, slots, out, kind as i32, ne0, ne1) as i64, label)
  }
}

// The two index inputs. They do not go through the `mul_mat` operand table because that table is
// the left-operand predicate and `I32` is deliberately not in it.
pub fn slot_new_i32_1d(
  ctx: raw,
  borrow slots: slice<u8>,
  out: i64,
  ne0: i64,
  label: str,
) -> Result<(), Fault> {
  unsafe {
    return r5_result(align_ggml_slot_new_i32_1d(ctx, slots, out, ne0) as i64, label)
  }
}

pub fn slot_place(
  handle: raw,
  borrow slots: slice<u8>,
  index: i64,
  borrow addr: slice<u8>,
  label: str,
) -> Result<(), Fault> {
