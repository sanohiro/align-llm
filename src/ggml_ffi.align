module ggml_ffi

// R4.5-EXTERNAL-BUFFER-SPIKE (`docs/specs/r4-5-external-buffer.md` sections 3.4 and 3.9). The
// **only** module in this repository that contains an `extern` declaration or an `unsafe` block,
// and `scripts/run-ggml-spike-smoke` asserts exactly that: it greps `src/` for an `unsafe {` block
// opener and for an `extern "C"` line and requires each list to be this file alone. The assertion
// is deliberately about the *block*, not about the word — the sibling modules discuss the boundary
// in prose and `src/prompt_verifier_smoke.align` names an `unsafe_workspace` parameter, so a bare
// `grep -rl unsafe src/` would name files that hold no unsafe code (section 6, correction C19).
//
// The block below names exactly one library — the repository's own shim — and that is the whole of
// section 3.2's build-input decision. `src/main.align`'s import graph never reaches this module, so
// `make build` is untouched on a host that has never heard of ggml; the shim is built from
// `scripts/ggml_shim.c` when `ALIGN_LLM_GGML_INCLUDE` is set and from `scripts/ggml_shim_stub.c`
// when it is not, and the Align source is byte-identical either way because a `link` clause is
// compile-time and unconditional and Align has no conditional compilation.
//
// Section 3.1 is why a C shim is not a convenience: at this pin a `layout(C)` struct cannot cross by
// value on `arm64-apple-darwin`, cannot contain a `raw` field, and `bool` is not an FFI type, so
// `ggml_init`'s `struct ggml_init_params` is unreachable by every route. `docs/align-requests.md`
// carries the language-owned half of that as a recorded gap; this module is the application-side
// answer and consumes no hypothetical surface.
//
// Everything above the extern block is safe: every wrapper returns a `Result` or a scalar, every
// handle is an opaque `raw`, no view over foreign memory is ever formed, and no handle is ever
// aggregated into a record or returned as a view. A function containing `unsafe` is inferred
// Impure, so nothing here can enter a `par_map` — the danger stays visible and traceable.

// Section 3.4's status vocabulary, shared byte-for-byte with both C files. `0` is success; every
// negative value maps to exactly one `R4_5_*` code in `code_for` below, which is the single place
// the mapping exists.
pub STATUS_OK := 0
pub STATUS_UNAVAILABLE := -1
pub STATUS_ABI := -2
pub STATUS_TYPE := -3
pub STATUS_SHAPE := -4
pub STATUS_ALIGNMENT := -5
pub STATUS_INIT := -6
pub STATUS_BOUNDS := -7
// R5A-DENSE-LAYER-FORWARD (`docs/specs/r5a-dense-layer-forward.md` sections 3.5 and 3.8). Two more
// shared values: a `ggml_gallocr` predicate that answered `false`, and a node-slot store refusal.
pub STATUS_ALLOC := -8
pub STATUS_SLOT := -9

// Outside the `ggml_status` range (`-2 ..= 2`), so a null argument handed to the compute wrapper is
// never mistaken for a backend verdict.
pub COMPUTE_NULL := -1000

// The longest backend name this capability will carry. `ggml_backend_name` returns a `const char *`
// and a `str` cannot be formed over foreign memory at this pin, so the name is copied into an
// Align-owned byte range and decoded there.
pub MAX_BACKEND_NAME_BYTES := 64

// R5C-METAL-PREFILL-ARM (`docs/specs/r5c-metal-prefill.md` sections 3.4 and 3.8). The device
// selector, the numeric-property selector, and the text selector, shared byte-for-byte with both C
// files. `DEVICE_KIND_GPU` is `GGML_BACKEND_DEVICE_TYPE_GPU`: the arm names no Metal-specific entry
// point and includes no `ggml-metal.h`, because the device-generic capability flag is the whole
// host-pointer surface Metal exposes (`r4-5-external-buffer.md` section 2.5).
pub DEVICE_KIND_CPU := 0
pub DEVICE_KIND_GPU := 1

// One field per call rather than one record, because a `layout(C)` struct cannot cross this
// boundary by value at this pin and `bool` is not an FFI type (`docs/align-requests.md` Request 32).
pub DEVICE_PROP_TYPE_ID := 0
pub DEVICE_PROP_HOST_PTR := 1
pub DEVICE_PROP_HOST_BUFFER := 2
pub DEVICE_PROP_ALIGNMENT := 3
pub DEVICE_PROP_MEMORY_FREE := 4
pub DEVICE_PROP_MEMORY_TOTAL := 5

pub DEVICE_TEXT_NAME := 0
pub DEVICE_TEXT_DESCRIPTION := 1

// The longest device name or description this capability carries. `MTL0` and `Apple M1` are the
// two this host produces; the bound exists because the shim writes at most the capacity the caller
// declares and never NUL-terminates.
pub MAX_DEVICE_TEXT_BYTES := 128

pub Fault { code: string, detail: string }

fn fault(code: str, detail: str) -> Fault =
Fault { code: code.clone(), detail: detail.clone() }

fn int_text(value: i64) -> string {
  b := builder()
  b.write_int(value)
  return b.to_string()
}

fn labelled_fault(code: str, label: str, value: i64) -> Fault {
  b := builder()
  b.write(label)
  b.write("[")
  b.write_int(value)
  b.write("]")
  rendered := b.to_string()
  rendered_view: str := rendered
  return fault(code, rendered_view)
}

// The one `match` section 4.2 asks for: every negative shim status becomes exactly one `R4_5_*`
// code. A status this module does not know is `R4_5_ABI` rather than a silent success, because an
// unknown value from a foreign library is precisely the drift the code exists to name.
pub fn code_for(status: i64) -> str {
  if status == STATUS_UNAVAILABLE { return "R4_5_GGML_UNAVAILABLE" }
  if status == STATUS_TYPE { return "R4_5_TYPE_UNSUPPORTED" }
  if status == STATUS_SHAPE { return "R4_5_SHAPE" }
  if status == STATUS_ALIGNMENT { return "R4_5_ALIGNMENT" }
  if status == STATUS_INIT { return "R4_5_GGML_INIT" }
  // A bounds refusal is not a constructor failure: the shim returns it when a copy in or out would
  // exceed `ggml_nbytes` of the tensor it was handed, which is the container's declared size and
  // ggml's own size disagreeing. `R4_5_SHAPE` is that disagreement's own code — step 16's
  // `ggml_nbytes(A) != member.nbytes` check reports the identical condition — and the wrapper's
  // `label` names the object, so the detail stays specific (section 6, correction C18).
  if status == STATUS_BOUNDS { return "R4_5_SHAPE" }
  return "R4_5_ABI"
}

// The same mapping for the R5A arm, which owns its own code vocabulary. It is a second `match`
// rather than a parameterized one because the two arms' codes are two contracts: `R4_5_SHAPE` and
// `R5_SHAPE` are different documents' fields, and a shared renderer would let one arm's rename
// silently change the other's output (`docs/specs/r5a-dense-layer-forward.md` section 4.2).
pub fn r5_code_for(status: i64) -> str {
  if status == STATUS_UNAVAILABLE { return "R5_GGML_UNAVAILABLE" }
  if status == STATUS_TYPE { return "R5_TYPE_UNSUPPORTED" }
  if status == STATUS_SHAPE { return "R5_SHAPE" }
  if status == STATUS_ALIGNMENT { return "R5_ALIGNMENT" }
  if status == STATUS_INIT { return "R5_GGML_INIT" }
  if status == STATUS_BOUNDS { return "R5_SHAPE" }
  if status == STATUS_ALLOC { return "R5_ALLOC" }
  if status == STATUS_SLOT { return "R5_SLOT" }
  return "R5_ABI"
}

// ---------------------------------------------------------------------------------------------
// The boundary
// ---------------------------------------------------------------------------------------------

extern "C" link("align_ggml_shim") {
  fn align_ggml_available() -> i32
  fn align_ggml_tensor_alignment() -> i32
  fn align_ggml_blck_size(kind: i32) -> i32
  fn align_ggml_type_size(kind: i32) -> i32
  fn align_ggml_table_drift() -> i32
  fn align_ggml_type_ok(kind: i32, ne0: i64) -> i32
  fn align_ptr_align_mod(p: slice<u8>, modulus: i64) -> i64
  fn align_ggml_device_open() -> raw
  // R5C section 3.4. The registry's own device selection for either kind, its numeric properties,
  // its buffer type's maximum length, and its two names.
  fn align_ggml_device_by_kind(kind: i32) -> raw
  fn align_ggml_device_props(device: raw, field: i32) -> i64
  fn align_ggml_device_buft_max_size(device: raw) -> i64
  fn align_ggml_device_text(device: raw, which: i32, out: slice<u8>, cap: i32) -> i32
  fn align_ggml_backend_open(device: raw) -> raw
  fn align_ggml_backend_name(backend: raw, out: slice<u8>, cap: i32) -> i32
  fn align_ggml_backend_close(backend: raw) -> ()
  fn align_ggml_context_open(mem_bytes: i64) -> raw
  fn align_ggml_context_close(ctx: raw) -> ()
  fn align_ggml_buffer_from_host(device: raw, p: slice<u8>, size: i64) -> raw
  fn align_ggml_buffer_free(buffer: raw) -> ()
  fn align_ggml_new_tensor_2d(ctx: raw, kind: i32, ne0: i64, ne1: i64) -> raw
  fn align_ggml_tensor_place(buffer: raw, tensor: raw, addr: slice<u8>) -> i32
  fn align_ggml_alloc_remaining(ctx: raw, backend: raw) -> raw
  fn align_ggml_tensor_set(tensor: raw, data: slice<u8>, offset: i64, size: i64) -> i32
  fn align_ggml_mul_mat(ctx: raw, a: raw, b: raw) -> raw
  fn align_ggml_compute(backend: raw, ctx: raw, result: raw) -> i32
  fn align_ggml_tensor_get(tensor: raw, out: slice<u8>, offset: i64, size: i64) -> i32
  fn align_ggml_tensor_nbytes(tensor: raw) -> i64
  fn align_ggml_tensor_data_offset(tensor: raw, base: slice<u8>) -> i64

  // R5A. The node-slot store, the one-op wrappers, and the graph. Section 2.6 is why the store
  // exists: `raw` is refused as a struct field **and** as an array element at this pin, so a
  // thirty-two-node graph's handles cannot live in Align and every node is addressed by `i64`.
  fn align_ggml_slots_init(slots: slice<u8>, bytes: i64) -> i32
  fn align_ggml_slots_capacity(slots: slice<u8>) -> i64
  fn align_ggml_slots_ok(slots: slice<u8>) -> i32
  fn align_ggml_slots_high_water(slots: slice<u8>) -> i64
  fn align_ggml_fp_contract_off() -> i32
  fn align_ggml_slot_copy(destination: slice<u8>, to: i64, source: slice<u8>, from: i64) -> i32
  fn align_ggml_slot_nbytes(slots: slice<u8>, index: i64) -> i64
  fn align_ggml_slot_ne(slots: slice<u8>, index: i64, dim: i32) -> i64
  fn align_ggml_slot_data_offset(slots: slice<u8>, index: i64, base: slice<u8>) -> i64
  fn align_ggml_slot_new_tensor_1d(
    ctx: raw, slots: slice<u8>, out: i64, kind: i32, ne0: i64) -> i32
  fn align_ggml_slot_new_tensor_2d(
    ctx: raw, slots: slice<u8>, out: i64, kind: i32, ne0: i64, ne1: i64) -> i32
  fn align_ggml_slot_new_i32_1d(ctx: raw, slots: slice<u8>, out: i64, ne0: i64) -> i32
  fn align_ggml_slot_place(handle: raw, slots: slice<u8>, index: i64, addr: slice<u8>) -> i32
  fn align_ggml_slot_set(
    slots: slice<u8>, index: i64, bytes: slice<u8>, offset: i64, size: i64) -> i32
  fn align_ggml_slot_get(
    slots: slice<u8>, index: i64, bytes: slice<u8>, offset: i64, size: i64) -> i32
  fn align_ggml_slot_mark_output(slots: slice<u8>, index: i64) -> i32
  fn align_ggml_op_get_rows(ctx: raw, slots: slice<u8>, out: i64, a: i64, b: i64) -> i32
  fn align_ggml_op_rms_norm(ctx: raw, slots: slice<u8>, out: i64, a: i64, eps_bits: i32) -> i32
  fn align_ggml_op_mul(ctx: raw, slots: slice<u8>, out: i64, a: i64, b: i64) -> i32
  fn align_ggml_op_add(ctx: raw, slots: slice<u8>, out: i64, a: i64, b: i64) -> i32
  fn align_ggml_op_mul_mat(ctx: raw, slots: slice<u8>, out: i64, a: i64, b: i64) -> i32
  fn align_ggml_op_reshape_3d(
    ctx: raw, slots: slice<u8>, out: i64, a: i64, ne0: i64, ne1: i64, ne2: i64) -> i32
  fn align_ggml_op_permute(
    ctx: raw, slots: slice<u8>, out: i64, a: i64, p0: i32, p1: i32, p2: i32, p3: i32) -> i32
  fn align_ggml_op_cont_3d(
    ctx: raw, slots: slice<u8>, out: i64, a: i64, ne0: i64, ne1: i64, ne2: i64) -> i32
  fn align_ggml_op_rope_neox(
    ctx: raw, slots: slice<u8>, out: i64, a: i64, pos: i64,
    n_dims: i32, mode: i32, n_ctx_orig: i32, freq_base_bits: i32) -> i32
  fn align_ggml_op_soft_max_ext(
    ctx: raw, slots: slice<u8>, out: i64, a: i64, mask: i64,
    scale_bits: i32, max_bias_bits: i32) -> i32
  fn align_ggml_op_swiglu_split(ctx: raw, slots: slice<u8>, out: i64, a: i64, b: i64) -> i32

  // R5B-MODEL-PREFILL-FORWARD (`docs/specs/r5b-model-prefill-forward.md` section 3.6). The **one**
  // new symbol: `ggml_pad`, which widens K and V to the reference instrument's declared attention
  // width. The plan named a second, `cont_2d`; section 6 correction C1 records that
  // `align_ggml_op_cont_3d` already covers the narrowed `kqv_out` at `ne2 = 1`, exactly as
  // `r5a-dense-layer-forward.md` correction C4 established, so it was never written.
  fn align_ggml_op_pad(
    ctx: raw, slots: slice<u8>, out: i64, a: i64, p0: i32, p1: i32, p2: i32, p3: i32) -> i32

  // R6-DECODE-KV-STEP1 (`docs/specs/r6-decode-kv-step1.md` section 2.5). The **one** new symbol:
  // `ggml_concat`, which joins the KV plane's past columns to this step's single new column. It is
  // the whole difference between a prefill layer graph and a decode layer graph; every other row of
  // the decode table is a prefill row with `tokens = 1`.
  //
  // `dim` is an axis **selector** in `[0, 3]`, validated in Align before the call and again in C.
  // Section 2.4 records that K and V concatenate on different axes — K's column axis is 1 after its
  // `CONT_3D` and V's is 0 after its own — so the selector is a per-row column of the node table and
  // never a shared constant.
  fn align_ggml_op_concat(
    ctx: raw, slots: slice<u8>, out: i64, a: i64, b: i64, dim: i32) -> i32

  // R5D-MOE-LAYER-FORWARD (`docs/specs/r5d-moe-layer-forward.md` section 3.5). The **five** new
  // symbols the routed half of an OLMoE layer needs, and nothing else. Section 2.8 verified each
  // against the two C files at the pin: `align_ggml_slot_new_tensor_2d` gates on the `mul_mat`
  // operand table, which has no `I32` row and must not gain one, so the remapped id tensor gets its
  // own constructor beside `slot_new_i32_1d`; the stacked expert operand is genuinely 3-D; and
  // `align_ggml_op_soft_max_ext` is **widened** rather than duplicated, because `mask == -1` is a
  // new input domain of an existing symbol and R5B correction C1 records that the cheapest new
  // shim symbol is the one you do not add.
  //
  // `align_ggml_op_view_2d` takes dimension **selectors** and never byte counts: `nb1 = a->nb[
  // nb1_dim]` and `offset = offset_index * a->nb[offset_dim]` are computed in C from the tensor's
  // own strides, so Align cannot compute a stride or forge an offset and the view's extent is
  // checked against `a`'s `nbytes` on the C side.
  fn align_ggml_op_argsort(ctx: raw, slots: slice<u8>, out: i64, a: i64, order: i32) -> i32
  fn align_ggml_op_mul_mat_id(
    ctx: raw, slots: slice<u8>, out: i64, as_slot: i64, b: i64, ids: i64) -> i32
  fn align_ggml_op_view_2d(
    ctx: raw, slots: slice<u8>, out: i64, a: i64, ne0: i64, ne1: i64,
    nb1_dim: i32, offset_dim: i32, offset_index: i64) -> i32
  fn align_ggml_slot_new_tensor_3d(
    ctx: raw, slots: slice<u8>, out: i64, kind: i32, ne0: i64, ne1: i64, ne2: i64) -> i32
  fn align_ggml_slot_new_strided_tensor_3d(
    ctx: raw, slots: slice<u8>, out: i64, kind: i32,
    ne0: i64, ne1: i64, ne2: i64, slice_stride: i64) -> i32
  fn align_ggml_slot_new_i32_2d(ctx: raw, slots: slice<u8>, out: i64, ne0: i64, ne1: i64) -> i32

  // The second new symbol, and section 6 correction C5's whole subject: a bounded `memcpy` between
  // two Align-owned ranges. Align's `buffer` is append-only and `pread` overwrites from index 0, so
  // a window that is allocated once and refilled thirty times cannot be refilled from Align.
  fn align_ggml_window_copy(
    window: slice<u8>, window_bytes: i64, offset: i64,
    source: slice<u8>, source_bytes: i64, n: i64) -> i32
  fn align_ggml_stage_kv(
    plane: slice<u8>, plane_bytes: i64, k_base: i64, v_base: i64,
    stage: slice<u8>, stage_bytes: i64,
    head_dim: i64, n_head_kv: i64, n_past: i64) -> i32
  fn align_ggml_compare_kv_plane(
    consumed: slice<u8>, consumed_bytes: i64, plane: slice<u8>, plane_bytes: i64,
    plane_base: i64, head_dim: i64, n_head_kv: i64, columns: i64, layout: i32) -> i64
  fn align_ggml_slot_compare_kv_plane(
    slots: slice<u8>, index: i64, plane: slice<u8>, plane_bytes: i64,
    plane_base: i64, head_dim: i64, n_head_kv: i64, columns: i64, layout: i32) -> i64
  fn align_ggml_graph_context_bytes(node_capacity: i64) -> i64
  fn align_ggml_graph_new(ctx: raw) -> raw
  fn align_ggml_graph_partition(
    ctx: raw, graph: raw, slots: slice<u8>, boundary_slot: i64, suffix: i32) -> raw
  fn align_ggml_graph_select_slot_range(
    ctx: raw, graph: raw, slots: slice<u8>, first_slot: i64, last_slot: i64) -> raw
  fn align_ggml_graph_expand(graph: raw, slots: slice<u8>, index: i64) -> i32
  fn align_ggml_graph_node_count(graph: raw) -> i32
  fn align_ggml_gallocr_new(backend: raw) -> raw
  fn align_ggml_gallocr_reserve(galloc: raw, graph: raw) -> i32
  fn align_ggml_gallocr_alloc(galloc: raw, graph: raw) -> i32
  fn align_ggml_gallocr_bytes(galloc: raw) -> i64
  fn align_ggml_gallocr_free(galloc: raw) -> ()
  fn align_ggml_graph_compute(backend: raw, graph: raw) -> i32
}

// The hosted static shim contains the deterministic engine as well as the ordinary unavailable
// path, so its one archive object carries libm references even when the executable never selects
// that engine. The pinned ELF driver places its automatic `-lm` before user-declared archives;
// repeat the shim's direct dependency after `-lalign_ggml_shim` so a clean static link is ordered
// correctly. Align Request 54 owns removing this explicit repetition once the driver orders its
// support libraries after user archives. An empty block is sufficient because `link` records the
// library dependency independently of foreign declarations.
extern "C" link("m") {}

// ---------------------------------------------------------------------------------------------
// The safe API above them
// ---------------------------------------------------------------------------------------------

// `raw.null()` and `p.is_null()` are the only pointer constructions in the capability, and they
// live here for the same reason every `extern` does: the smoke's `unsafe {` block scan over `src/`
// must name exactly one file. `src/ggml_spike.align` holds handles as opaque values and never
// forms one itself.
pub fn null_handle() -> raw {
  unsafe {
    return raw.null()
  }
}

pub fn handle_absent(handle: raw) -> bool {
  unsafe {
    return handle.is_null()
  }
}

pub fn available() -> bool {
  unsafe {
    return align_ggml_available() != 0
  }
}

// Section 3.8's ABI probe. `TENSOR_ALIGNMENT` is not a public constant in any shipped ggml header
// (section 6, correction C1), so the real shim reports the linked library's own
// `ggml_backend_buft_get_alignment` for the CPU device and the stub reports the checked-in `32`.
pub fn tensor_alignment() -> i64 {
  unsafe {
    return align_ggml_tensor_alignment() as i64
  }
}

// A ggml type id is a `u32` container field, so it is bounded here before it is narrowed: a value
// that does not fit `i32` would otherwise truncate into a different, possibly valid, type id.
fn type_representable(kind: i64) -> bool {
  return kind >= 0 && kind <= 2147483647
}

pub fn blck_size(kind: i64) -> i64 {
  if !type_representable(kind) { return STATUS_TYPE }
  unsafe {
    return align_ggml_blck_size(kind as i32) as i64
  }
}

pub fn type_size(kind: i64) -> i64 {
  if !type_representable(kind) { return STATUS_TYPE }
  unsafe {
    return align_ggml_type_size(kind as i32) as i64
  }
}

// `-1` when every row of the checked-in `mul_mat` operand table agrees with the linked ggml,
// otherwise the first `ggml_type` that disagrees. Section 5.6's drift guard, widened from three
// Q4_K constants to the whole table (section 6, correction C2).
pub fn table_drift() -> i64 {
  unsafe {
    return align_ggml_table_drift() as i64
  }
}

pub fn type_ok(kind: i64, ne0: i64) -> Result<(), Fault> {
  if !type_representable(kind) {
    return Err(labelled_fault("R4_5_TYPE_UNSUPPORTED", "type", kind))
  }
  unsafe {
    status := align_ggml_type_ok(kind as i32, ne0) as i64
    if status == STATUS_OK { return Ok(()) }
    if status == STATUS_TYPE {
      return Err(labelled_fault(code_for(status), "type", kind))
    }
    if status == STATUS_SHAPE {
      return Err(labelled_fault(code_for(status), "ne0", ne0))
    }
    return Err(labelled_fault(code_for(status), "type", kind))
  }
}

// The `mul_mat` left-operand predicate as a bare status rather than a `Result`. The R5A arm checks
// thirteen members inside one loop, and a `match` on a `Result` inside a loop is markedly more
// expensive to check at this pin than a scalar comparison (`docs/specs/r5a-dense-layer-forward.md`
// section 6, correction C8), so the caller — which already knows the role name — maps the status.
pub fn type_ok_status(kind: i64, ne0: i64) -> i64 {
  if !type_representable(kind) { return STATUS_TYPE }
  unsafe {
    return align_ggml_type_ok(kind as i32, ne0) as i64
  }
}

// `(address) mod modulus` for the base of an Align byte range. Align has no `raw`-to-integer cast
// and no `==` on `raw` (section 2.6), so section 3.8 step 14's alignment rule — the step that keeps
// `GGML_ASSERT` and `abort()` unreachable — is evaluated on this scalar.
pub fn align_mod(borrow region: slice<u8>, modulus: i64) -> i64 {
  unsafe {
    return align_ptr_align_mod(region, modulus)
  }
}

// Every constructor below returns a bare `raw` and reports failure as a null handle rather than as
// `Result<raw, Fault>`: at this pin a `Result` ok payload must be a scalar and `raw` is refused
// (section 6, correction C3). `src/ggml_spike.align` tests each handle with `.is_null()` at the one
// place that knows which object it asked for, which is also the place section 3.8 step 13 names in
// its detail.
pub fn device_open() -> raw {
  unsafe {
    return align_ggml_device_open()
  }
}

pub fn backend_open(device: raw) -> raw {
  unsafe {
    return align_ggml_backend_open(device)
  }
}

// R5C section 3.4. A null handle is "the registry has no device of that kind", which the GPU arm
// reports as `R5C_GPU_UNAVAILABLE` at section 3.9 step 20a — a document with a verdict, not a
// signal. It returns a bare `raw` for the same reason every constructor here does: a `Result` ok
// payload must be a scalar at this pin and `raw` is refused.
pub fn device_by_kind(kind: i64) -> raw {
  if kind != DEVICE_KIND_CPU && kind != DEVICE_KIND_GPU { return null_handle() }
  unsafe {
    return align_ggml_device_by_kind(kind as i32)
  }
}

// One numeric property of one device. Negative answers are the shim's own status vocabulary, so a
// caller that reads a capability flag as a truth value must range-check it first — which is why
// `device_flag` below is a separate function rather than a comparison at each call site.
pub fn device_props(device: raw, field: i64) -> i64 {
  if field < DEVICE_PROP_TYPE_ID || field > DEVICE_PROP_MEMORY_TOTAL { return STATUS_ABI }
  unsafe {
    return align_ggml_device_props(device, field as i32)
  }
}

// A capability flag as a `bool`. `1` is true and **everything else** — `0`, a negative status, an
// unknown field — is false, so an ABI drift that made the shim answer with a status reads as
// "the device does not advertise it" rather than as "it does" (section 3.9 step 20b is fail-closed).
pub fn device_flag(device: raw, field: i64) -> bool {
  return device_props(device, field) == 1
}

// Section 3.5's one new bound. `ggml_backend_buft_get_max_size` reports `SIZE_MAX` for the CPU
// buffer type, which both C files clamp to `i64`'s maximum rather than truncating, so a device that
// declares no limit reads as the largest limit instead of as a negative one.
pub fn device_buft_max_size(device: raw) -> i64 {
  unsafe {
    return align_ggml_device_buft_max_size(device)
  }
}

// The device's name or description, copied into caller memory and decoded there, in the same shape
// as `backend_name`: `buffer(n)` reserves capacity without publishing length, so the range is
// written before the call and the shim writes at most the capacity the caller declares.
pub fn device_text(device: raw, which: i64) -> string {
  if which != DEVICE_TEXT_NAME && which != DEVICE_TEXT_DESCRIPTION { return "".clone() }
  mut window: buffer := buffer(MAX_DEVICE_TEXT_BYTES)
  mut i := 0
  loop {
    if i >= MAX_DEVICE_TEXT_BYTES { break }
    window.put_u8(0 as u8)
    i = i + 1
  }
  unsafe {
    written := align_ggml_device_text(
      device, which as i32, window.bytes(), MAX_DEVICE_TEXT_BYTES as i32) as i64
    if written <= 0 || written > MAX_DEVICE_TEXT_BYTES {
      return "".clone()
    }
    view := window.bytes()
    return match view[0..written].as_str() {
      Ok(text) => text.clone(),
      Err(_) => "".clone(),
    }
  }
}

// The backend's name, copied into caller memory and decoded there. The buffer is filled before the
// call because `buffer(n)` reserves capacity without publishing length, and the shim writes at most
// the capacity the caller declares.
pub fn backend_name(backend: raw) -> string {
  mut window: buffer := buffer(MAX_BACKEND_NAME_BYTES)
  mut i := 0
  loop {
    if i >= MAX_BACKEND_NAME_BYTES { break }
    window.put_u8(0 as u8)
    i = i + 1
  }
  unsafe {
    written := align_ggml_backend_name(backend, window.bytes(), MAX_BACKEND_NAME_BYTES as i32) as i64
    if written <= 0 || written > MAX_BACKEND_NAME_BYTES {
      return "".clone()
    }
    view := window.bytes()
    return match view[0..written].as_str() {
      Ok(text) => text.clone(),
      Err(_) => "".clone(),
    }
  }
}

pub fn backend_close(backend: raw) {
  unsafe {
    align_ggml_backend_close(backend)
  }
}

pub fn context_open(mem_bytes: i64) -> raw {
  unsafe {
    return align_ggml_context_open(mem_bytes)
  }
}

pub fn context_close(ctx: raw) {
  unsafe {
    align_ggml_context_close(ctx)
  }
}

// The call section 2.4 measured aborting on a misaligned pointer. The shim validates alignment and
// size and returns `NULL` rather than letting `GGML_ASSERT` take the process down; `ggml_spike`
// has already refused a misaligned base one step earlier, so this is the fail-closed second gate.
pub fn buffer_from_host(device: raw, borrow region: slice<u8>, size: i64) -> raw {
  unsafe {
    return align_ggml_buffer_from_host(device, region, size)
  }
}

// Total and idempotent against `raw.null()`, because the teardown of section 3.9 runs on every exit
// path from construction onward, including the ones where only some handles exist.
pub fn buffer_free(handle: raw) {
  unsafe {
    align_ggml_buffer_free(handle)
  }
}

pub fn new_tensor_2d(ctx: raw, kind: i64, ne0: i64, ne1: i64) -> raw {
  if !type_representable(kind) { return null_handle() }
  unsafe {
    return align_ggml_new_tensor_2d(ctx, kind as i32, ne0, ne1)
  }
}

// The status-returning wrappers keep their `Fault`, because a placement or a copy can fail for more
// than one reason and the caller must not have to guess which.
pub fn tensor_place(handle: raw, tensor: raw, borrow addr: slice<u8>, label: str) -> Result<(), Fault> {
  unsafe {
    status := align_ggml_tensor_place(handle, tensor, addr) as i64
    if status == STATUS_OK { return Ok(()) }
    return Err(fault(code_for(status), label))
  }
}

pub fn alloc_remaining(ctx: raw, backend: raw) -> raw {
  unsafe {
    return align_ggml_alloc_remaining(ctx, backend)
  }
}

pub fn tensor_set(tensor: raw, borrow data: slice<u8>, offset: i64, size: i64, label: str) -> Result<(), Fault> {
  unsafe {
    status := align_ggml_tensor_set(tensor, data, offset, size) as i64
    if status == STATUS_OK { return Ok(()) }
    return Err(fault(code_for(status), label))
  }
}

pub fn mul_mat(ctx: raw, a: raw, b: raw) -> raw {
  unsafe {
    return align_ggml_mul_mat(ctx, a, b)
  }
}

// Returns the `ggml_status` verbatim. `0` is `GGML_STATUS_SUCCESS`; section 3.8 step 15 maps
// anything else to `R4_5_COMPUTE` with detail `status[<n>]`.
//
// `ggml_abort` is `abort()`. A kernel that hits an internal assertion terminates the process with
// no unwinding, no `Drop`, no document, and no error code, and no Align line runs after it. Section
// 3.9 states that plainly; what this capability does about it is to make every *reachable* failure
// unreachable — validated types, validated shapes, validated alignments, bounds-checked sizes, and
// null-checked constructors — not to claim the boundary is safe.
pub fn compute(backend: raw, ctx: raw, result: raw) -> i64 {
  unsafe {
    return align_ggml_compute(backend, ctx, result) as i64
  }
}

pub fn tensor_get(tensor: raw, borrow out: slice<u8>, offset: i64, size: i64, label: str) -> Result<(), Fault> {
  unsafe {
    status := align_ggml_tensor_get(tensor, out, offset, size) as i64
    if status == STATUS_OK { return Ok(()) }
    return Err(fault(code_for(status), label))
  }
}

pub fn tensor_nbytes(tensor: raw) -> i64 {
  unsafe {
    return align_ggml_tensor_nbytes(tensor)
  }
}

// The gate's second clause as a number: how far into the Align-owned buffer ggml's own data pointer
// lands. `EXTERNAL` is this value equalling the member's interior offset; anything else is
// `COPIED`, which is a successful run reporting the answer the roadmap asked for.
pub fn tensor_data_offset(tensor: raw, borrow base: slice<u8>) -> i64 {
  unsafe {
    return align_ggml_tensor_data_offset(tensor, base)
  }
}

// ---------------------------------------------------------------------------------------------
// R5A — the safe API over the node-slot store, the one-op wrappers, and the graph
//
// `docs/specs/r5a-dense-layer-forward.md` sections 3.5 and 4.2. Every function below is one
// `unsafe` block containing one foreign call, and every one that can fail returns a `Result` whose
// `Fault` carries an `R5_*` code and the caller's own label. No handle is ever aggregated, no view
// over foreign memory is ever formed, and the slot store's bytes stay Align's throughout.
// ---------------------------------------------------------------------------------------------

// The one `Fault` constructor the R5A wrappers share: the shim's status, mapped once, plus the
// label the caller already knows — the node id, the role, or the object being constructed.
fn r5_fault(status: i64, label: str) -> Fault = fault(r5_code_for(status), label)

fn r5_result(status: i64, label: str) -> Result<(), Fault> {
  if status == STATUS_OK { return Ok(()) }
  return Err(r5_fault(status, label))
}

pub fn slots_init(borrow slots: slice<u8>, bytes: i64, label: str) -> Result<(), Fault> {
  unsafe {
    return r5_result(align_ggml_slots_init(slots, bytes) as i64, label)
  }
}

// The store's own declared capacity, or a negative value for a window this file did not write.
// Published so the document reports the capacity the *shim* believes in rather than the constant
// Align asked for, which is the difference that makes the forced narrow-capacity build a real test.
pub fn slots_capacity(borrow slots: slice<u8>) -> i64 {
  unsafe {
    return align_ggml_slots_capacity(slots)
  }
}

pub fn slots_ok(borrow slots: slice<u8>) -> bool {
  unsafe {
    return align_ggml_slots_ok(slots) != 0
  }
}

// The highest slot the shim actually wrote, plus one. It is scanned from the store rather than
// derived from the node table, so it is a measurement instead of a restatement of a constant
// (`docs/specs/r5a-dense-layer-forward.md` section 6, correction C16).
pub fn slots_high_water(borrow slots: slice<u8>) -> i64 {
  unsafe {
    return align_ggml_slots_high_water(slots)
  }
}

// `true` when the loaded shim was built with floating-point contraction disabled **and observed
// not to contract**: the shim answers from a one-ulp behavioural probe, not from its build define.
// The engine's kernels are what the checked-in golden documents were generated from, and whether
// `a * b + c` becomes one fused multiply-add is a per-compiler, per-target choice, so this is part
// of the ABI the document publishes rather than a build preference. It is necessary and not
// sufficient — the kernels also call libm — and the goldens remain the detector (section 6,
// correction C15).
pub fn fp_contract_off() -> bool {
  unsafe {
    return align_ggml_fp_contract_off() != 0
  }
}

pub fn slot_copy(
  borrow destination: slice<u8>,
  to: i64,
  borrow source: slice<u8>,
  from: i64,
  label: str,
) -> Result<(), Fault> {
  unsafe {
    return r5_result(align_ggml_slot_copy(destination, to, source, from) as i64, label)
  }
}

pub fn slot_nbytes(borrow slots: slice<u8>, index: i64) -> i64 {
  unsafe {
    return align_ggml_slot_nbytes(slots, index)
  }
}

// `ne[dim]` of the tensor in slot `index`, or `-1`. The document's `nodes[].ne0..ne3` come from
// here rather than from the node table, so a shape the implementation computed and a shape the
// design intended cannot silently be the same number.
pub fn slot_ne(borrow slots: slice<u8>, index: i64, dim: i64) -> i64 {
  if dim < 0 || dim > 3 { return -1 }
  unsafe {
    return align_ggml_slot_ne(slots, index, dim as i32)
  }
}

pub fn slot_data_offset(borrow slots: slice<u8>, index: i64, borrow base: slice<u8>) -> i64 {
  unsafe {
    return align_ggml_slot_data_offset(slots, index, base)
  }
}

pub fn slot_new_tensor_1d(
  ctx: raw,
  borrow slots: slice<u8>,
  out: i64,
  kind: i64,
  ne0: i64,
  label: str,
) -> Result<(), Fault> {
  if !type_representable(kind) { return Err(r5_fault(STATUS_TYPE, label)) }
  unsafe {
    return r5_result(align_ggml_slot_new_tensor_1d(ctx, slots, out, kind as i32, ne0) as i64, label)
  }
}

pub fn slot_new_tensor_2d(
  ctx: raw,
  borrow slots: slice<u8>,
  out: i64,
  kind: i64,
  ne0: i64,
  ne1: i64,
  label: str,
) -> Result<(), Fault> {
