fn owned(index: i64) -> Result<prompt_generation_evidence.Evidence, Error> {
  request_source := REQUEST.clone()
  rendered_source := RENDERED.clone()
  policy_source := POLICY.clone()
  control_source := CONTROL.clone()
  request := prompt_artifacts.decode_task_adapter_request(request_source)?
  rendered := prompt_artifacts.decode_rendered_prompt_artifact(rendered_source)?
  policy := prompt_artifacts.decode_generation_policy(policy_source)?
  control := prompt_artifacts.decode_evaluation_provider_control(control_source)?
  if index == 3 { return prompt_generation_evidence.absent(request, rendered, policy, control) }
  sources := [RESPONSE_0, RESPONSE_1, RESPONSE_2]
  response_source := sources[index].clone()
  response := prompt_artifacts.decode_prompt_generation_response(response_source)?
  return prompt_generation_evidence.responded(request, rendered, policy, control, response)
}

fn attestation_text(borrow value: prompt_artifacts.SeedCapabilityAttestation) -> Result<string, Error> {
  return json.encode_bounded(value, 2097152)
}

fn generation_text(borrow value: prompt_artifacts.GenerationRequestIdentity) -> Result<string, Error> {
  return json.encode_bounded(value, 2097152)
}

pub fn main() -> Result<(), Error> {
  attestations := [ATTESTATION_0, ATTESTATION_1, ATTESTATION_2, ATTESTATION_3]
  generations := [GENERATION_0, GENERATION_1, GENERATION_2, GENERATION_3]
  mut index := 0
  loop {
    if index == 4 { break }
    evidence := owned(index)?
    attestation := attestation_text(evidence.attestation)?
    generation := generation_text(evidence.generation)?
    if attestation != attestations[index] || generation != generations[index] { print(index); return Err(Error.Invalid) }
    index = index + 1
  }
  print("prompt generation evidence smoke passed: four canonical golden pairs and owner expiry")
  return Ok(())
}
