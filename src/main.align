fn provider_demo(args: array<str>) -> Result<(), Error> {
  if args.len() < 8 {
    return Err(Error.Invalid)
  }
  kind := parse_provider_kind(args[2])?
  mode := if args.len() >= 9 { args[8] } else { "generate" }
  if mode != "generate" && mode != "stream" {
    return Err(Error.Invalid)
  }
  api_key := load_api_key(args[5])?
  api_key_view: str := api_key
  tokenize_endpoint := if args.len() >= 10 && args[9] != "-" { args[9] } else { "" }
  timeout_ns := if args.len() >= 11 { parse_i64(args[10])? } else { 30_000_000_000 }
  if timeout_ns < 0 {
    return Err(Error.Invalid)
  }
  config := model.ProviderConfig {
    kind: kind,
    endpoint: args[3],
    model: args[4],
    api_key: api_key_view,
    timeout_ns: timeout_ns,
    tokenize_endpoint: tokenize_endpoint,
    // The pre-C6e demo keeps the shipped 256 KiB proposal-response allowance explicitly.
    max_response_bytes: 262_144,
  }
  request := model.GenerationRequest {
    system: "You are a coding assistant. Return a concise patch-oriented answer.",
    user: args[6],
    max_tokens: 256,
    temperature: 0.0,
    seed: None,
  }
  info := provider.model_info(config)
  started := time.instant()
  generated := if mode == "stream" {
    provider.stream(config, request)
  } else {
    provider.generate(config, request)
  }
  elapsed := time.instant() - started
  match generated {
    Ok(text) => {
      prompt_count := count_prompt(config, request)
      completion_count := count_or_unknown(config, text)
      total := if prompt_count.count >= 0 && completion_count.count >= 0 {
        prompt_count.count + completion_count.count
      } else {
        -1
      }
      exact := prompt_count.exact && completion_count.exact
      text_view: str := text
      record := result.GenerationRecord {
        schema_version: 2,
        operation: mode,
        provider: info.provider,
        model: info.model,
        endpoint: info.endpoint,
        status: "ok",
        output: text_view,
        prompt_tokens: prompt_count.count,
        completion_tokens: completion_count.count,
        total_tokens: total,
        token_count_exact: exact,
        elapsed_ns: elapsed,
        error: "",
        error_code: -1,
      }
      result.save(args[7], record)?
      print("provider:")
      print(info.provider)
      print("model:")
      print(info.model)
      print("operation:")
      print(mode)
      print("status:")
      print("PASS")
      print("output:")
      print(text)
    }
    Err(e) => {
      record := result.GenerationRecord {
        schema_version: 2,
        operation: mode,
        provider: info.provider,
        model: info.model,
        endpoint: info.endpoint,
        status: "error",
        output: "",
        prompt_tokens: -1,
        completion_tokens: -1,
        total_tokens: -1,
        token_count_exact: false,
        elapsed_ns: elapsed,
        error: error_label(e),
        error_code: error_code(e),
      }
      result.save(args[7], record)?
      return Err(e)
    }
  }
  return Ok(())
}

fn prompt_state_demo(args: array<str>) -> Result<(), Error> {
  if args.len() != 5 {
    return Err(Error.Invalid)
  }
  operation := args[2]
  if operation == "experiment" {
    proposed := prompt_experiment.experiment_file(args[3], args[4])
    print("prompt operation:")
    print(operation)
    print("status:")
    print(prompt_experiment.status_label(proposed))
    print("output:")
    print(args[4])
    if !prompt_experiment.status_success(proposed) {
      return Err(Error.Invalid)
    }
    return Ok(())
  }
  if operation == "generate" {
    generated := prompt_generate.generate_file(args[3], args[4])
    print("prompt operation:")
    print(operation)
    print("status:")
    print(prompt_generate.status_label(generated))
    print("output:")
    print(args[4])
    if !prompt_generate.status_success(generated) {
      return Err(Error.Invalid)
    }
    return Ok(())
  }
  if operation == "evaluate" {
    evaluated := prompt_evaluate.evaluate_file(args[3], args[4])
    print("prompt operation:")
    print(operation)
    print("status:")
    print(prompt_evaluate.status_label(evaluated))
    print("output:")
    print(args[4])
    if !prompt_evaluate.status_success(evaluated) {
      return Err(Error.Invalid)
    }
    return Ok(())
  }
  status := if operation == "accept" {
    prompt_state.accept_file(args[3], args[4])?
  } else if operation == "rollback" {
    prompt_state.rollback_file(args[3], args[4])?
  } else {
    return Err(Error.Invalid)
  }
  print("prompt operation:")
  print(operation)
  print("status:")
  print(prompt_state.command_status_label(status))
  print("output:")
  print(args[4])
  if !prompt_state.command_status_success(status) {
    return Err(Error.Invalid)
  }
  return Ok(())
}

// C7-PERSISTED-RESULT CLI adapter (`docs/specs/c7-persisted-result.md` sections 3.2 and 3.3).
fn c7_selector(value: str) -> bool {
  return value == "--persist-result" || value == "--verify-result"
}

// The section 3.2 dispatch contract: exact arity first, then the rejection of a second C7
// selector in an operand position, and only then the module's own path validation and file work.
// No option parser consumes a path operand as a hidden flag, and no ambient option, environment
// variable, locale, or seed reaches the module.
fn persisted_result_demo(args: array<str>) -> Result<(), Error> {
  persist := args[1] == "--persist-result"
  if persist {
    if args.len() != 4 {
      return Err(Error.Invalid)
    }
    if c7_selector(args[2]) || c7_selector(args[3]) {
      return Err(Error.Invalid)
    }
  } else {
    if args.len() != 3 {
      return Err(Error.Invalid)
    }
    if c7_selector(args[2]) {
      return Err(Error.Invalid)
    }
  }
  summary := if persist {
    persisted_result.persist_file(args[2], args[3])?
  } else {
    persisted_result.verify_file(args[2])?
  }
  // Section 3.3 stable summary: exactly seven logical lines, in this order.
  print("persisted-result:")
  print("status:")
  match summary.status {
    Pass => print("PASS"),
    Fail => print("FAIL"),
  }
  print("expected:")
  print(summary.expected)
  print("observed:")
  print(summary.observed)
  // A valid semantic FAIL is persisted and reported data; the CLI maps it to the existing
  // `Error.Invalid` process exit after the artifact has been written and reloaded.
  match summary.status {
    Pass => { return Ok(()) },
    Fail => { return Err(Error.Invalid) },
  }
}

SUMMARY_HEX := "0123456789abcdef"

// The section 2.3 summary block is a fixed sequence of logical lines that a consumer reads
// positionally, and `general.architecture` is attacker-controlled text from the container. A value
// carrying a newline would inject lines into that block, so every control byte — `< 0x20` and
// `0x7f` — is replaced by `\xNN` before it is printed. The JSON document is unaffected: its
// encoder already escapes the same bytes. Runs of ordinary bytes are copied whole; a control byte
// is ASCII, so a run boundary is always a scalar boundary and `value[a..b]` cannot abort.
fn sanitize_summary_line(value: str) -> string {
  b := builder()
  view := value.bytes()
  mut start := 0
  mut index := 0
  loop {
    if index >= view.len() { break }
    byte := view.u8(index) as i64
    if byte < 32 || byte == 127 {
      if index > start {
        b.write(value[start..index])
      }
      high := byte / 16
      low := byte % 16
      b.write("\\x")
      b.write(SUMMARY_HEX[high..high + 1])
      b.write(SUMMARY_HEX[low..low + 1])
      start = index + 1
    }
    index = index + 1
  }
  if start < view.len() {
    b.write(value[start..view.len()])
  }
  return b.to_string()
}

// R0-GGUF-INSPECT CLI adapter (`docs/specs/r0-gguf-inspection.md` sections 2.2 and 2.3). The arm
// holds no GGUF knowledge: it validates arity, calls `gguf.inspect`, writes or prints the document,
// prints the summary block, and maps the inspection status to the process exit. Arity is checked
// before any path or file work, so an arity failure produces no output at all.
fn inspect_gguf_demo(args: array<str>) -> Result<(), Error> {
  if args.len() < 3 || args.len() > 4 {
    return Err(Error.Invalid)
  }
  inspected := gguf.inspect(args[2])?
  document_view: str := inspected.document
  if args.len() == 3 {
    // The machine form: the document and one newline, and nothing else.
    print(document_view)
  } else {
    fs.write_file(args[3], document_view)?
    // Section 2.3 stable summary. The JSON document remains the authoritative result.
    print("gguf inspection:")
    print("status:")
    match inspected.status {
      Ok => print("OK"),
      Error => print("ERROR"),
    }
    print("architecture:")
    architecture_view: str := inspected.architecture
    // `-` is reserved for an absent, non-STRING, or non-UTF-8 `general.architecture`. A key that is
    // present and empty prints an empty line, which is the value the container actually declares.
    if inspected.architecture_present {
      sanitized := sanitize_summary_line(architecture_view)
      sanitized_view: str := sanitized
      print(sanitized_view)
    } else {
      print("-")
    }
    print("version:")
    print(inspected.version)
    print("tensors:")
    print(inspected.tensor_count)
    print("metadata:")
    print(inspected.metadata_kv_count)
    print("alignment:")
    print(inspected.alignment)
    print("data offset:")
    print(inspected.data_offset)
    print("bytes read:")
    print(inspected.bytes_read)
    match inspected.status {
      Ok => {},
      Error => {
        print("error:")
        error_view: str := inspected.error_code
        print(error_view)
      },
    }
  }
  // A structural defect is persisted and reported data; the CLI maps it to the existing
  // `Error.Invalid` process exit after the document has been emitted.
  match inspected.status {
    Ok => { return Ok(()) },
    Error => { return Err(Error.Invalid) },
  }
}

// R1-QWEN-MODEL-IR / R1B-GPTOSS-MOE-IR CLI adapter (`docs/specs/r1-qwen-model-ir.md` sections 2.2
// and 2.4; `docs/specs/r1b-gptoss-moe-ir.md` section 2.2). The arm holds no GGUF and no architecture
// knowledge beyond the dispatch itself: it validates arity, reads the container table exactly once,
// selects the frontend from the container's own `general.architecture` field, writes or prints the
// document, prints the summary block, and maps the derivation status to the process exit. Arity is
// checked before any path or file work, so an arity failure produces no output at all.
//
// There is no `--arch` flag. A flag would be a second source of truth for a fact the file already
// states, and a mismatch between the two would need an error code of its own; the file wins because
// the file is the subject. `gpt-oss` selects the MoE frontend and every other value — including an
// absent, non-STRING, or non-UTF-8 one — selects the qwen2 frontend, whose own step-4 re-check
// rejects it as `R1_UNSUPPORTED_ARCH` with the architecture as the detail.
fn model_ir_demo(args: array<str>) -> Result<(), Error> {
  if args.len() < 3 || args.len() > 4 {
    return Err(Error.Invalid)
  }
  table := gguf.read_table(args[2])?
  architecture_view: str := table.architecture
  ir := if table.architecture_present && architecture_view == "gpt-oss" {
    frontend_gpt_oss.build_model_ir(table, args[2])
  } else {
    frontend_qwen.build_model_ir(table, args[2])
  }
  document_view: str := ir.document
  if args.len() == 3 {
    // The machine form: the document and one newline, and nothing else.
    print(document_view)
  } else {
    fs.write_file(args[3], document_view)?
    // Section 2.4 stable summary. The JSON document remains the authoritative result.
    print("qwen model ir:")
    print("status:")
    match ir.status {
      Ok => print("OK"),
      Error => print("ERROR"),
    }
    print("arch:")
    arch_view: str := ir.arch
    // `-` is reserved for an architecture the container does not supply — absent, non-STRING, or
    // non-UTF-8 — so a key that is present and empty prints an empty line. This is the R0 contract
    // reused verbatim, not a second escaping grammar.
    if ir.arch_present {
      sanitized := sanitize_summary_line(arch_view)
      sanitized_view: str := sanitized
      print(sanitized_view)
    } else {
      print("-")
    }
    print("layers:")
    print(ir.n_layer)
    print("embd:")
    print(ir.n_embd)
    print("heads:")
    print(ir.n_head)
    print("heads kv:")
    print(ir.n_head_kv)
    print("head dim:")
    print(ir.head_dim)
    print("ff:")
    print(ir.n_ff)
    print("vocab:")
    print(ir.n_vocab)
    print("experts:")
    print(ir.n_expert)
    print("context:")
    print(ir.context_length)
    print("blocks:")
    print(ir.block_count)
    print("tensor bytes:")
    print(ir.total_tensor_bytes)
    print("size sum:")
    if ir.size_sum_ok {
      print("OK")
    } else {
      print("MISMATCH")
    }
    match ir.status {
      Ok => {},
      Error => {
        print("error:")
        error_view: str := ir.error_code
        print(error_view)
        print("detail:")
        detail_view: str := ir.error_detail
        // The detail names a container-supplied key or tensor name, so it is escaped for the same
        // reason `arch` is: the block is read positionally.
        sanitized_detail := sanitize_summary_line(detail_view)
        sanitized_detail_view: str := sanitized_detail
        print(sanitized_detail_view)
      },
    }
  }
  // A model defect is persisted and reported data; the CLI maps it to the existing `Error.Invalid`
  // process exit after the document has been emitted.
  match ir.status {
    Ok => { return Ok(()) },
    Error => { return Err(Error.Invalid) },
  }
}

// R2A-EXPERT-TRACE-CAPTURE CLI adapter (`docs/specs/r2a-expert-trace.md` section 2.3). The arm holds
// no transcript grammar: it validates arity, derives the document exactly once, writes or prints it,
// prints the summary block, and maps the derivation status to the process exit. Arity is checked
// before any path or file work, so an arity failure produces no output at all.
//
// There is no `--build`, no `--arch`, and no `--strict` flag, and there is no acquisition verb: the
// transcript is a file that already exists, which is what keeps the whole-stdout limitation of the
// shipped `std.process` surface out of this capability entirely.
fn expert_trace_demo(args: array<str>) -> Result<(), Error> {
  if args.len() < 3 || args.len() > 4 {
    return Err(Error.Invalid)
  }
  traced := expert_trace.build_trace(args[2])?
  document_view: str := traced.document
  if args.len() == 3 {
    // The machine form: the document and one newline, and nothing else.
    print(document_view)
  } else {
    fs.write_file(args[3], document_view)?
    // Section 2.3 stable summary. The JSON document remains the authoritative result.
    print("expert trace:")
    print("status:")
    match traced.status {
      Ok => print("OK"),
      Error => print("ERROR"),
    }
    print("graphs:")
    print(traced.graph_count)
    print("layers:")
    print(traced.n_layer)
    print("tokens observed:")
    print(traced.tokens_observed)
    print("tokens total:")
    print(traced.tokens_total)
    print("moe:")
    if traced.moe_present {
      print("YES")
    } else {
      print("NO")
    }
    // `-` is reserved for a value the transcript does not supply, reusing the R0 convention rather
    // than inventing a second one.
    print("experts:")
    if traced.moe_present && traced.n_expert >= 0 {
      print(traced.n_expert)
    } else {
      print("-")
    }
    print("experts used:")
    if traced.moe_present && traced.n_expert_used >= 0 {
      print(traced.n_expert_used)
    } else {
      print("-")
    }
    print("selections:")
    print(traced.selection_count)
    // Per mille rather than a decimal: the summary block is a stable stdout contract and this
    // repository has no float formatting contract. The JSON document carries the exact
    // numerator/denominator pair and is the authoritative result.
    print("reuse:")
    if traced.reuse_present {
      print(traced.reuse_per_mille)
    } else {
      print("-")
    }
    match traced.status {
      Ok => {},
      Error => {
        print("error:")
        error_view: str := traced.error_code
        print(error_view)
        print("detail:")
        detail_view: str := traced.error_detail
        // The detail names a transcript-supplied identifier, so it is escaped for the same reason
        // `arch` is in the R1 arm: the block is read positionally.
        sanitized_detail := sanitize_summary_line(detail_view)
        sanitized_detail_view: str := sanitized_detail
        print(sanitized_detail_view)
      },
    }
  }
  // A transcript defect is persisted and reported data; the CLI maps it to the existing
  // `Error.Invalid` process exit after the document has been emitted.
  match traced.status {
    Ok => { return Ok(()) },
    Error => { return Err(Error.Invalid) },
  }
}

// A repair provider that declines to fix anything (always gives up). It lets the loop's control
// exits be demonstrated without a model: an already-passing check needs no provider, and a
// persistently failing check ends in GAVE_UP on the first iteration. A real provider (LLM + patch
// apply) is a drop-in of the same `fn(str, str, i64) -> bool` shape.
fn decline_repair(stdout: str, stderr: str, code: i64) -> bool {
  return false
}

// A deterministic repair fixture: it accepts only a stdout diagnostic, writes the marker that
// makes the next verification pass, and therefore proves stdout reaches the provider and a repair
// is re-verified. The shell runner removes the marker before and after the smoke test.
fn repair_from_stdout(stdout: str, stderr: str, code: i64) -> bool {
  if stdout != "FIX_ME" {
    return false
  }
  if stderr != "DETAILS" {
    return false
  }
  if code != 23 {
    return false
  }
  marker := match env.get("ALIGN_LLM_TEMP_ROOT") {
    Some(root) => path.join(root, "loop-smoke-marker"),
    None => "/tmp/loop-smoke-marker".clone(),
  }
  return match fs.write_file(marker, "fixed") {
    Ok(_) => true,
    Err(_) => false,
  }
}

// A provider that asks for another verification without changing the command outcome. This
// deterministically exercises exhaustion of a positive iteration budget.
fn accept_without_change(stdout: str, stderr: str, code: i64) -> bool {
  return stdout == "STILL_FAIL"
}

// Exercise the provider-independent coding loop (repair.drive) as a real client against git, with
// the declining provider. Prints each scenario's outcome label and iteration count.
fn loop_demo() {
  marker := match env.get("ALIGN_LLM_TEMP_ROOT") {
    Some(root) => path.join(root, "loop-smoke-marker"),
    None => "/tmp/loop-smoke-marker".clone(),
  }
  r1 := repair.drive(decline_repair, "git", ["git", "rev-parse", "--verify", "HEAD"].to_array(), ".", 30_000_000_000, 0, 3)
  print("loop: already-passing")
  print(repair.outcome_label(r1.outcome))
  print(r1.iterations)
  r2 := repair.drive(decline_repair, "git", ["git", "rev-parse", "--verify", "refs/heads/__align_llm_absent__"].to_array(), ".", 30_000_000_000, 0, 3)
  print("loop: persistent-failure")
  print(repair.outcome_label(r2.outcome))
  print(r2.iterations)
  r3 := repair.drive(
    repair_from_stdout,
    "sh",
    ["sh", "-c", "if test -f \"${ALIGN_LLM_TEMP_ROOT:-/tmp}/loop-smoke-marker\"; then exit 0; else printf FIX_ME; printf DETAILS 1>&2; exit 23; fi"].to_array(),
    ".",
    30_000_000_000,
    0,
    2,
  )
  print("loop: stdout-repair")
  print(repair.outcome_label(r3.outcome))
  print(r3.iterations)
  match fs.remove(marker) {
    Ok(_) => {},
    Err(_) => {},
  }
  r4 := repair.drive(accept_without_change, "sh", ["sh", "-c", "printf STILL_FAIL; exit 1"].to_array(), ".", 30_000_000_000, 0, 2)
  print("loop: exhausted")
  print(repair.outcome_label(r4.outcome))
  print(r4.iterations)
  r5 := repair.drive(decline_repair, "sh", ["sh", "-c", "sleep 1"].to_array(), ".", 1_000_000, 0, 1)
  print("loop: timeout")
  print(repair.outcome_label(r5.outcome))
  print(r5.iterations)
  r6 := repair.drive(decline_repair, "__must_not_execute__", ["__must_not_execute__"].to_array(), ".", 30_000_000_000, 0, 0)
  print("loop: zero-budget")
  print(repair.outcome_label(r6.outcome))
  print(r6.iterations)
}

// Exercise the newly shipped std.process captured-run surface (Align Request 1,
// Slice 4/5) as a real client: run `git status --porcelain` in the repo root,
// capturing its output, with a 30s timeout that surfaces a hang as Error.Timeout.
fn self_check() -> Result<(), Error> {
  code := verify.run_captured("git", ["git", "status", "--porcelain"].to_array(), ".", 30_000_000_000)?
  print("exit code:")
  print(code)
  return Ok(())
}

pub fn main(args: array<str>) -> Result<(), Error> {
  if args.len() == 1 {
    print_help()
  } else {
    if args[1] == "--version" {
      print(project.version())
    } else {
      if args[1] == "--status" {
        print(project.status())
      } else {
        if args[1] == "--selfcheck" {
          self_check()?
        } else {
          if args[1] == "prompt" {
            prompt_state_demo(args)?
          } else {
            if args[1] == "--provider" {
              provider_demo(args)?
            } else {
              if args[1] == "--evaluate-patch" {
                patch_evaluation_demo(args)?
              } else {
                if args[1] == "--verify-loop" {
                  verification_loop_demo(args)?
                } else {
                  if args[1] == "--select-tests" {
                    select_tests_demo(args)?
                  } else {
                    if args[1] == "--index" {
                      index_demo(args)?
                    } else {
                      if args[1] == "--eval" {
                        corpus := if args.len() >= 3 { args[2] } else { "eval/tasks/smoke-v1.json" }
                        eval.run_suite(corpus)?
                      } else {
                        if args[1] == "--loop" {
                          loop_demo()
                        } else {
                          if args[1] == "--inspect-gguf" {
                            inspect_gguf_demo(args)?
                          } else {
                            if args[1] == "--model-ir" {
                              model_ir_demo(args)?
                            } else if args[1] == "--expert-trace" {
                              expert_trace_demo(args)?
                            } else if c7_selector(args[1]) {
                              persisted_result_demo(args)?
                            } else {
                              print_help()
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return Ok(())
}
