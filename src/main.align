// Keep the bootstrap entry point dependency-free while Align's package layer is still evolving.
fn print_help() {
  print(project.name())
  print("Local LLM coding infrastructure written in Align")
  print("Usage: main [--version | --status | --selfcheck | --index <repo> <index.json> [timeout-ns] | --select-tests <repo> <changed-path> <tests.json> [timeout-ns] | --evaluate-patch <repo> <patch.diff> <evaluation.json> [timeout-ns] | --verify-loop <task.json> <result.json> | --eval [corpus] | --loop]")
  print("       main --persist-result <input.json> <result.json>")
  print("       main --verify-result <result.json>")
  print("       main --inspect-gguf <model.gguf> [inspection.json]")
  print("       main --model-ir <model.gguf> [model-ir.json]")
  print("       main --expert-trace <callback.log> [trace.json]")
  print("       main prompt <experiment|generate|evaluate|accept|rollback> <request.json> <result.json>")
  print("       main --provider <cloud|openai-local|llama> <endpoint> <model> <api-key-env|-> <prompt> <result.json> [generate|stream] [tokenize-endpoint|-] [timeout-ns]")
}

fn parse_provider_kind(value: str) -> Result<model.ProviderKind, Error> {
  if value == "cloud" {
    return Ok(model.ProviderKind.CloudOpenAI)
  }
  if value == "openai-local" {
    return Ok(model.ProviderKind.LocalOpenAI)
  }
  if value == "llama" {
    return Ok(model.ProviderKind.LlamaCpp)
  }
  return Err(Error.Invalid)
}

fn error_label(e: Error) -> str = match e {
  NotFound => "not-found",
  Invalid => "invalid",
  Denied => "denied",
  Timeout => "timeout",
  Code(_) => "provider-status",
}

fn error_code(e: Error) -> i64 = match e {
  NotFound => -1,
  Invalid => -1,
  Denied => -1,
  Timeout => -1,
  Code(code) => code as i64,
}

fn parse_i64(value: str) -> Result<i64, Error> {
  number: i64 := json.decode(value)?
  return Ok(number)
}

fn count_or_unknown(config: model.ProviderConfig, text: str) -> model.TokenCount {
  return match provider.count_tokens(config, text) {
    Ok(count) => count,
    Err(_) => model.TokenCount { count: -1, exact: false },
  }
}

fn count_prompt(config: model.ProviderConfig, request: model.GenerationRequest) -> model.TokenCount {
  return provider.count_prompt(config, request)
}

fn load_api_key(name: str) -> Result<string, Error> {
  if name == "-" {
    return Ok("".clone())
  }
  return match env.get(name) {
    Some(value) => Ok(value),
    None => Err(Error.Denied),
  }
}

fn index_demo(args: array<str>) -> Result<(), Error> {
  if args.len() < 4 {
    return Err(Error.Invalid)
  }
  timeout_ns := if args.len() >= 5 { parse_i64(args[4])? } else { 30_000_000_000 }
  if timeout_ns < 0 {
    return Err(Error.Invalid)
  }
  built := repo_index.build(args[2], timeout_ns)
  fs.write_file(args[3], built.document)?
  print("index:")
  print("status:")
  match built.status {
    Ready => print("PASS"),
    Partial => print("PARTIAL"),
    Failed => print("FAIL"),
  }
  print("files:")
  print(built.file_count)
  print("symbols:")
  print(built.symbol_count)
  print("imports:")
  print(built.import_count)
  print("references:")
  print(built.reference_count)
  print("test candidates:")
  print(built.test_count)
  match built.status {
    Ready => { return Ok(()) },
    Partial => { return Err(Error.Invalid) },
    Failed => { return Err(Error.Invalid) },
  }
}

