module eval

import core.json
import std.fs
import std.time
import verify
import eval_retirement

// Deterministic scoring for the fixed coding-eval set (roadmap C0). The corpus is a
// declared JSON record checked into eval/tasks/. Each task runs one captured,
// timeout-bounded validation command and is scored only by observable exit status.

pub Verdict { Pass, Fail, Timeout, RunError }

pub fn verdict_label(v: Verdict) -> str = match v {
  Pass => "PASS",
  Fail => "FAIL",
  Timeout => "TIMEOUT",
  RunError => "ERROR",
}

TaskSpec {
  id: string,
  cmd: string,
  argv: array<string>,
  cwd: string,
  timeout_ns: i64,
  expected_code: i64,
}

TaskCorpus { schema_version: i64, corpus_id: string, task_files: array<string> }

TaskResult {
  schema_version: i64,
  task_id: str,
  verdict: str,
  expected_code: i64,
  actual_code: i64,
  duration_ns: i64,
  stdout: str,
  stderr: str,
}

SuiteResult {
  schema_version: i64,
  corpus_id: str,
  task_count: i64,
  pass_count: i64,
  fail_count: i64,
}

fn score(status: verify.RunStatus, code: i64, expected: i64) -> Verdict = match status {
  Completed => if code == expected { Verdict.Pass } else { Verdict.Fail },
  TimedOut => Verdict.Timeout,
  SpawnFailed => Verdict.RunError,
}

fn run_one(task_id: str, cmd: str, argv: slice<str>, cwd: str, timeout_ns: i64, expected_code: i64) -> Result<Verdict, Error> {
  started := time.instant()
  captured := verify.run(cmd, argv, cwd, timeout_ns)
  elapsed := time.instant() - started
  verdict := score(captured.status, captured.code, expected_code)
  stdout: str := captured.stdout
  stderr: str := captured.stderr
  result := TaskResult {
    schema_version: 1,
    task_id: task_id,
    verdict: verdict_label(verdict),
    expected_code: expected_code,
    actual_code: captured.code,
    duration_ns: elapsed,
    stdout: stdout,
    stderr: stderr,
  }
  print(json.encode(result)?)
  return Ok(verdict)
}

fn run_task(borrow task: TaskSpec) -> Result<Verdict, Error> {
  return arena temporary {
    mut arguments: array_builder<str> := array_builder(temporary)
    mut index := 0
    loop {
      if index == task.argv.len() { break }
      arguments.push(task.argv[index])
      index = index + 1
    }
    argv := arguments.build()
    run_one(task.id, task.cmd, argv, task.cwd, task.timeout_ns, task.expected_code)
  }
}

// Admit the entire corpus into owned records before any command or result line.
// The final JSON line is stable score data; per-task duration is measurement metadata.
pub fn run_suite(path: str) -> Result<(), Error> {
  data := fs.read_file(path)?
  corpus: TaskCorpus := json.decode(data)?
  if corpus.schema_version != 1 || corpus.corpus_id == "coding-v1" {
    return Err(Error.Invalid)
  }
  if corpus.task_files.len() == 0 {
    return Err(Error.Invalid)
  }

  mut i := 0
  mut admitted: array_builder<TaskSpec> := array_builder()
  loop {
    if i >= corpus.task_files.len() {
      break
    }
    task_data := fs.read_file(corpus.task_files[i])?
    task: TaskSpec := json.decode(task_data)?
    // Exercise both halves of Request 3 as a real client. The second decoded record is the one
    // actually executed, so a scalar-array encode regression cannot silently retain the old argv.
    encoded := json.encode(task)?
    roundtrip: TaskSpec := json.decode(encoded)?
    eval_retirement.admit(roundtrip.cmd, roundtrip.argv, roundtrip.cwd)?
    admitted.push(roundtrip)
    i = i + 1
  }
  tasks := admitted.build()
  mut passed := 0
  i = 0
  loop {
    if i == tasks.len() { break }
    verdict := run_task(tasks[i])?
    match verdict {
      Pass => {
        passed = passed + 1
      },
      _ => {},
    }
    i = i + 1
  }

  total := corpus.task_files.len()
  failed := total - passed
  corpus_id: str := corpus.corpus_id
  summary := SuiteResult {
    schema_version: 1,
    corpus_id: corpus_id,
    task_count: total,
    pass_count: passed,
    fail_count: failed,
  }
  print(json.encode(summary)?)
  if failed != 0 {
    return Err(Error.Invalid)
  }
  return Ok(())
}
