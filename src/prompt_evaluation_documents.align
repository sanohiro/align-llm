module prompt_evaluation_documents

import prompt_artifacts
import std.crypto
import std.encoding

fn digest(value: str) -> string {
  hash := crypto.sha256(value)
  return encoding.hex_encode(hash[0..hash.len()]).clone()
}

// Existing bounded encoders consume their record. Decode the original again only
// after checking the normalized canonical digest, preserving every owned field.

pub fn experiment(source: str) -> Result<prompt_artifacts.PromptExperimentResult, Error> {
  if source.len() > 2097152 { return Err(Error.Invalid) }
  mut normalized := prompt_artifacts.decode_prompt_experiment_result(source)?
  if normalized.schema_version != 1 || normalized.artifact_kind != "PROMPT_EXPERIMENT_RESULT" { return Err(Error.Invalid) }
  claimed := normalized.content_sha256.clone()
  normalized.content_sha256 = "".clone()
  canonical := prompt_artifacts.encode_prompt_experiment_result_bounded(normalized, 2097152)?
  if digest(canonical) != claimed { return Err(Error.Invalid) }
  return prompt_artifacts.decode_prompt_experiment_result(source)
}

