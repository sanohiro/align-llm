module prompt_capture_smoke

import prompt_capture
import std.encoding

Case { raw: str, key: str, limit: i64, expected: str }

fn capture(borrow config: prompt_capture.Pattern, raw: slice<u8>, cuts: i64) -> Result<array<u8>, Error> {
  mut output := buffer(config.limit)
  mut state := prompt_capture.cursor()
  prompt_capture.append(config, output, state, raw[0..0])?
  mut start := 0
  mut end := 1
  mut bit := 1
  loop {
    if end >= raw.len() { break }
    if (cuts / bit) % 2 == 1 {
      prompt_capture.append(config, output, state, raw[start..end])?
      prompt_capture.append(config, output, state, raw[end..end])?
      start = end
    }
    end = end + 1
    bit = bit * 2
  }
  prompt_capture.append(config, output, state, raw[start..raw.len()])?
  result := prompt_capture.finish(config, output, state)?
  again := prompt_capture.finish(config, output, state)?
  if encoding.hex_encode(result[0..result.len()]) != encoding.hex_encode(again[0..again.len()]) { return Err(Error.Invalid) }
  match prompt_capture.append(config, output, state, raw[0..0]) {
    Err(_) => {}, Ok(_) => { return Err(Error.Invalid) },
  }
  return Ok(result)
}

fn check_case(item: Case, exhaustive: bool) -> Result<(), Error> {
  raw := encoding.hex_decode(item.raw)?
  config := prompt_capture.pattern(item.key, item.limit)?
  mut maximum := 1
  mut index := 1
  loop {
    if index >= raw.bytes().len() { break }
    maximum = maximum * 2
    index = index + 1
  }
  mut mask := 0
  loop {
    if mask == maximum { break }
    actual := capture(config, raw.bytes(), mask)?
    if encoding.hex_encode(actual[0..actual.len()]) != item.expected {
      print("capture differential mismatch")
      print(item.raw)
      print(item.key)
      print(encoding.hex_encode(actual[0..actual.len()]))
      print(item.expected)
      return Err(Error.Invalid)
    }
    if !exhaustive && mask == 0 && maximum > 1 { mask = maximum - 1 } else { mask = mask + 1 }
  }
  return Ok(())
}

fn expired() -> Result<array<u8>, Error> {
  config := prompt_capture.pattern("ED]x", 64)?
  return capture(config, "ED]xx".bytes(), 7)
}

fn independent_streams() -> Result<(), Error> {
  config := prompt_capture.pattern("aba", 64)?
  mut stdout := buffer(64)
  mut stderr := buffer(64)
  mut out_state := prompt_capture.cursor()
  mut err_state := prompt_capture.cursor()
  prompt_capture.append(config, stdout, out_state, "ab".bytes())?
  prompt_capture.append(config, stderr, err_state, "a".bytes())?
  prompt_capture.append(config, stdout, out_state, "aba".bytes())?
  prompt_capture.append(config, stderr, err_state, "bab".bytes())?
  out := prompt_capture.finish(config, stdout, out_state)?
  err := prompt_capture.finish(config, stderr, err_state)?
  if encoding.hex_encode(out[0..out.len()]) != "5b52454441435445445d6261"
    || encoding.hex_encode(err[0..err.len()]) != "5b52454441435445445d62" { return Err(Error.Invalid) }
  return Ok(())
}

// Exercise the worker ceiling and retained task ceiling with bytewise expectations.
// A pending credential prefix makes overflow occur in finish rather than append.
fn large_capture(limit: i64, overflow: bool, pending: bool) -> Result<(), Error> {
  config := prompt_capture.pattern(if pending { "ab" } else { "" }, limit)?
  mut output := buffer(limit)
  mut state := prompt_capture.cursor()
  mut chunk := buffer(65536)
  mut index := 0
  loop {
    if index == 4096 { break }
    chunk.append("xxxxxxxxxxxxxxxx")
    index = index + 1
  }
  count := if pending && !overflow { limit - 1 } else { limit }
  mut remaining := count
  loop {
    if remaining == 0 { break }
    size := if remaining < 65536 { remaining } else { 65536 }
    prompt_capture.append(config, output, state, chunk.bytes()[0..size])?
    remaining = remaining - size
  }
  if pending {
    prompt_capture.append(config, output, state, "a".bytes())?
    if state.truncated || state.matched != 1 { return Err(Error.Invalid) }
  } else if overflow {
    prompt_capture.append(config, output, state, "x".bytes())?
  }
  actual := prompt_capture.finish(config, output, state)?
  again := prompt_capture.finish(config, output, state)?
  if actual.len() != limit || again.len() != limit || state.truncated != overflow || !state.closed || state.matched != 0 {
    return Err(Error.Invalid)
  }
  marker := "\n[output truncated]"
  prefix := if overflow { limit - marker.len() } else { count }
  index = 0
  loop {
    if index == limit { break }
    expected := if index < prefix { 120 as u8 } else if overflow { marker.bytes()[index - prefix] } else { 97 as u8 }
    if actual[index] != expected || again[index] != expected { return Err(Error.Invalid) }
    index = index + 1
  }
  match prompt_capture.append(config, output, state, "x".bytes()) {
    Err(_) => {}, Ok(_) => { return Err(Error.Invalid) },
  }
  return Ok(())
}

fn main() -> Result<(), Error> {
  match prompt_capture.pattern("x", -1) { Err(_) => {}, Ok(_) => { return Err(Error.Invalid) } }
  match prompt_capture.pattern("x", 2097153) { Err(_) => {}, Ok(_) => { return Err(Error.Invalid) } }
  maximum := prompt_capture.pattern("", 65536)?
  maximum_output := capture(maximum, "".bytes(), 0)?
  if maximum_output.len() != 0 { return Err(Error.Invalid) }
  large_capture(65536, false, false)?
  large_capture(65536, true, true)?
  large_capture(2097152, false, false)?
  large_capture(2097152, true, false)?
  large_capture(2097152, false, true)?
  large_capture(2097152, true, true)?
  independent_streams()?
  owned := expired()?
  if encoding.hex_encode(owned[0..owned.len()]) != "5b52454441435445445d78" { return Err(Error.Invalid) }
