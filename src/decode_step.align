module decode_step

import std.crypto
import std.encoding
import std.fs
import std.time
import alignpack
import alignpack_read
import ggml_ffi
import kv_plane
import layer_forward
import layer_qwen2
import model_forward

// R6-DECODE-KV-STEP1 (`docs/specs/r6-decode-kv-step1.md`) and R6-STEP-N
// (`docs/specs/r6-step-n.md`). The `--decode-step` arm: the Align-owned KV plane of R6 section 2.2,
// the decode graph shape of R6 section 2.4, the split of token ids from positions of R6 section 2.6,
// the validation order of R6-STEP-N section 2.7, the `R6_DECODE_STEP` schema-2 document of
// R6-STEP-N section 2.9, and oracles A', B, and C' of R6-STEP-N section 3.4.
//
// R6 computes **one** decode step at `n_past = T` and stops. R6-STEP-N makes the same arm answer
// "what are the next `N` tokens": a `STEPS` operand, a write-back of each step's own K and V
// column into the plane, per-step iteration of the three things that depend on `n_past` (the node
// table, the offset mask, the position image), and a token-id gate. It needs no new ggml op, FFI
// symbol, node row, or slot -- R6's decode row table is already parameterised by `n_past`.
//
// R5B computes a whole prefill and stops. Every K and V it produces is a graph-internal node that
// dies with its graph — `src/model_forward.align` opens three fresh `ggml_context`s per graph and
// frees them at the end of that graph — so the model can answer "what are the logits for this
// prompt" and cannot answer "what comes next". This module adds the smallest thing that changes
// that: host bytes that carry every layer's post-RoPE K and its V across the graph boundary, and
// one decode step at `n_past = T` that reads them.
//
// It is a **new module** rather than another thousand lines of `src/model_forward.align` for that
// module's own reason: at this pin the checker's per-function cost is superlinear in body length and
// `src/model_forward.align` is already 4,500 lines. It holds no `unsafe` and no `extern`; every
// foreign call crosses `src/ggml_ffi.align`. The container reader, the window discipline, the plan,
// the member tables, the digests, and every renderer that means the same thing are **imported** from
// `src/model_forward.align` rather than copied, exactly as R5B imports R5A.
//
// What this module owns and does not delegate: the arity guard, the operand grammar, the validation
// order, the plane's layout and lifetime, the decode graph's inputs, both concat axes, the offset
// mask, oracle A's second-graph transcript comparison, oracle B's byte round trip, and the document.

// R6-KV-PERSIST section 2.8. Schema 3 adds `plane.source`, the `kv` object, and
// `timings.first_token_ns`. R6-RESIDENT-WEIGHTS section 3.5 takes **schema 4** and adds the
// `weights` object. Its own section 9.4 predicted 3 and settled the number at merge: KV-PERSIST
// merged first and took 3, so this capability takes 4. The **kind is unchanged** in both cases: the
// document describes the same thing, and where the plane came from and where the weights live are
// fields rather than kinds.
// R6-PREFIX-SUFFIX-PREFILL section 2.9 takes **schema 5** and adds the `suffix` object; on a
// completed suffix pass `output` and `oracle_logits` describe that pass's own logits and the
// container's vector stays published in `kv`. The **kind is unchanged** for the fourth time: the
// document describes the same thing, and how the plane reached `n_past` is a field, not a kind.
// R6-PREFIX-KEY section 2.7 takes **schema 6** and adds the `store` object. The **kind is unchanged**
// for the fifth time: the document describes the same thing, and whether the plane's provenance was
// chosen by the caller's two path operands or by a content-addressed lookup is a field, not a kind.
// No existing field changes meaning and no path is added — `store.key` is a digest, so it is
// golden-stable on every host and under every temporary directory.
SCHEMA_VERSION := 6
DOCUMENT_KIND := "R6_DECODE_STEP"

// Section 2.8's vocabulary. `R6_*` is what this arm owns; the ggml seam's `R5_*` codes reach the
// document unchanged through `ggml_ffi.r5_code_for`, which is total and needs no edit, and the
// container's `R4_*`/`R5_*` codes reach it unchanged through the imported plan stage.
CODE_TOKENS := "R6_TOKENS"
CODE_GEOMETRY := "R6_GEOMETRY"
CODE_ARCH := "R6_ARCH_UNSUPPORTED"
CODE_KV_WIDTH := "R6_KV_WIDTH"
// R6-STEP-N section 2.7. The one new code this capability adds. There is deliberately no
// `R6_STEP_FAILED`: a step that fails fails for a reason that already has a code, and a wrapper
// would give every seam code two names depending on where it was raised. What the loop adds is a
// **locator**, and the locator is the `step[<k>]` detail prefix `prefix_step` writes.
CODE_STEPS := "R6_STEPS"
CODE_PLANE_UNAVAILABLE := "R6_PLANE_UNAVAILABLE"
CODE_PLANE_WRITE := "R6_PLANE_WRITE"
CODE_PLANE_MISMATCH := "R6_PLANE_MISMATCH"
CODE_TRANSCRIPT := "R6_TRANSCRIPT"
CODE_ORACLE_MISSING := "R6_ORACLE_MISSING"
CODE_GEOMETRY_UNREADABLE := "R6_GEOMETRY_UNREADABLE"
// R6-RESIDENT-WEIGHTS section 3.1 and 3.2. `R6_RESIDENT` is the operand's grammar; the other two
// are the arena's own budget and its one observable reservation failure. There is deliberately no
// code for an out-of-memory host: `buffer(cap)` cannot report a failed reservation and `append`
// cannot fail (Request 35), so that host **aborts** rather than producing a document. Section 3.6
// states that rather than hiding it, and `scripts/run-decode-step` preflights physical memory.
// R6-PREFIX-SUFFIX-PREFILL section 2.7. The one new code this capability adds, over the four
// details it actually emits: `suffix[<text>]` (unparseable, empty, or trailing-separator),
// `prefix[<n>]` (a suffix onto a prefix of fewer than two tokens — section 11.2's defect makes the
// container such a run would load hold the wrong plane), `sequence[<n>]`
// (`T_prefix + S > MAX_PREFILL_TOKENS`), and `token[<index>]` — `parse_tokens`' own **index** of the
// offending id, which is what `R6_TOKENS` reports and therefore what this code reports too. There
// is deliberately no `count[0]` detail: `parse_tokens` refuses an empty list outright, so a non-`-`
// operand can never parse to zero ids and the check would be unreachable. There is deliberately
// no `R6_SUFFIX_FAILED`: a suffix pass that fails fails for a reason that already has a code, and
// what the pass adds is a **locator**, the `suffix[]` detail prefix `prefix_suffix` writes.
//
// The sequence cap names `R6_SUFFIX` and not `R6_TOKENS` because on a suffix run `TOKENS` is pinned
// by the container it must match (L12) and `SUFFIX` is the only operand a caller can shorten.
CODE_SUFFIX := "R6_SUFFIX"
CODE_RESIDENT := "R6_RESIDENT"
CODE_RESIDENT_BUDGET := "R6_RESIDENT_BUDGET"
CODE_RESIDENT_UNAVAILABLE := "R6_RESIDENT_UNAVAILABLE"
// There is deliberately no `R6_ORACLE_SHAPE`. A transcript node whose printed axes do not match the
// arm's own is `R5_ORACLE_SHAPE`, raised inside `model_forward.compare_transcript_graph` and
// reaching this document unchanged through `fault_into`, exactly as every other seam code does
// (section 10.3). A second name for one condition would make two documents disagree about it.

// Section 2.2. The plane is one `buffer`, and this is the ceiling a malformed width would have to
// clear before a single byte is reserved. It is `MAX_ATTENTION_WIDTH` times the largest geometry
// this arm accepts with room to spare, and it is checked before `buffer(n)` is called.
MAX_PLANE_BYTES := 8589934592
MAX_DETAIL_BYTES := 256

PLANE_TENSOR_K := 0
PLANE_TENSOR_V := 1

ROUNDTRIP_ABSENT := 0
ROUNDTRIP_IDENTICAL := 1
ROUNDTRIP_MISMATCH := 2

// R6-KV-PERSIST section 2.8's `plane.source`. `"-"` is "the plane does not exist", which is what a
// document refused before step 9 must say; it is never `"PREFILL"` by default, because a default
// would claim a pass this arm did not run.
PLANE_SOURCE_ABSENT := 0
PLANE_SOURCE_PREFILL := 1
PLANE_SOURCE_LOADED := 2

pub fn plane_source_label(value: i64) -> str {
  if value == PLANE_SOURCE_PREFILL { return "PREFILL" }
  if value == PLANE_SOURCE_LOADED { return "LOADED" }
  return "-"
}

// R6-PREFIX-KEY section 2.7's `store.outcome`. `"absent"` is "no store was asked for, **or** the run
// was refused before the key was derived" — which is itself information, and it is never `"miss"` by
// default, because a default would claim a lookup this arm did not perform.
STORE_ABSENT := 0
STORE_HIT := 1
STORE_MISS := 2

pub fn store_outcome_label(value: i64) -> str {
  if value == STORE_HIT { return "hit" }
  if value == STORE_MISS { return "miss" }
  return "absent"
}

// Section 3.3, oracle B. The one place this capability claims byte identity, and it claims it about
// bytes rather than about arithmetic.
pub fn plane_tensor_label(value: i64) -> str {
  if value == PLANE_TENSOR_K { return "k" }
  if value == PLANE_TENSOR_V { return "v" }
  return "-"
}

pub fn roundtrip_label(value: i64) -> str {
  if value == ROUNDTRIP_IDENTICAL { return "IDENTICAL" }
  if value == ROUNDTRIP_MISMATCH { return "MISMATCH" }
  return "-"
}

// ---------------------------------------------------------------------------------------------
// The two records this document adds to R5B's
// ---------------------------------------------------------------------------------------------

// Section 2.9's `plane` object. Every field is a measurement of the object section 2.2 describes:
// what it cost, how much of it was written, how long the two crossings took, and whether the bytes
// that went in are the bytes that came back.
pub Plane {
  bytes: i64,
  stride: i64,
  layers: i64,
  columns_written: i64,
  readback_ns: i64,
  upload_ns: i64,
  roundtrip_verdict: i64,
  roundtrip_bytes_compared: i64,
  first_mismatch_layer: i64,
  // `0` is K, `1` is V, `-1` is "no mismatch". A scalar and not a name, so `Plane` holds no owned
  // string at all: at this pin a record carrying one cannot be a `borrow mut` argument beside the
  // rest of a graph runner's without the region checker refusing every short-lived operand in the
  // same call. `render_plane` names the tensor on the wire, which is where a reader needs the word.
  first_mismatch_tensor: i64,
  first_mismatch_column: i64,
  // R6-STEP-N section 2.9. Which step's round trip disagreed. `-1` is "no mismatch"; a mismatch that
  // named a layer, a tensor, and a column but not a step would leave a reader guessing which of `N`
  // graphs produced it.
  first_mismatch_step: i64,
}

pub fn empty_plane() -> Plane = Plane {
  bytes: 0,
  stride: 0,
  layers: 0,
  columns_written: 0,
  readback_ns: 0,
  upload_ns: 0,
  roundtrip_verdict: ROUNDTRIP_ABSENT,
  roundtrip_bytes_compared: 0,
  first_mismatch_layer: -1,
  first_mismatch_tensor: -1,
  first_mismatch_column: -1,
  first_mismatch_step: -1,
}

// R6-STEP-N section 2.9's `decode` object at schema 2: **loop-level only**. Step 1's token is still
// the prefill's own `argmax` and is never an operand — R6 section 2.1 records why, and its section
// 3.1 measured it: an operand would let a caller pass a token llama.cpp did not sample, and the
// transcript oracle would then compare two different sequences and still report `PASS`. Every step
// after the first consumes the previous step's own `argmax`, which is what makes the `N` ids one
// chain rooted at a byte-exact `d_1` (R6-STEP-N section 3.2).
//
// The scalars schema 1 published about *the* step — `sha256`, `bit_sum`, `element_count`,
// `nonfinite_count`, `argmax`, `token_id` — are gone from this record's rendered form because there
// is no longer exactly one step. They live per step in `model_forward.StepColumns`. The fields kept
// here are the ones that mean something about the whole loop: a count, a bound, a sum, or a maximum.
pub Decode {
  n_past: i64,
  n_past_last: i64,
  steps_requested: i64,
  steps_completed: i64,
  // The **most recent** step's scalars. They are working state for the loop — the token the next
  // step consumes, and the digest oracle C' is compared against — and are not rendered as
  // `decode.*` at schema 2.
  token_id: i64,
  argmax: i64,
  sha256: string,
  bit_sum: i64,
  element_count: i64,
  nonfinite_count: i64,
  compute_ns: i64,
  node_count: i64,
  graph_count: i64,
  slot_high_water: i64,
}

pub fn empty_decode() -> Decode = Decode {
  n_past: 0,
  n_past_last: 0,
  steps_requested: 0,
  steps_completed: 0,
  token_id: -1,
  argmax: -1,
  sha256: "".clone(),
  bit_sum: 0,
  element_count: 0,
  nonfinite_count: 0,
  compute_ns: 0,
  node_count: 0,
  graph_count: 0,
  slot_high_water: 0,
}

// ---------------------------------------------------------------------------------------------
// The failure sink
//
// `src/model_forward.align` has the identical three functions and this module deliberately does not
// call them. At this pin the region checker refuses a **cross-module** call that takes the caller's
// own `borrow mut` parameter together with a short-lived operand — a string literal, or the
// `Result` a wrapper just produced — with "cannot retain a shorter-lived view through this mutable
// borrow", because it cannot see that the callee clones. Inside one module it can. Every graph
// stage below takes `o` as a parameter and hands it a temporary on nearly every line, so the sink
// lives here; `docs/align-requests.md` owns the language half of that.
// ---------------------------------------------------------------------------------------------

// `error_detail` is a diagnostic, not a contract on the operand's completeness, so a longer one is
// truncated at a UTF-8 scalar boundary and the truncation is not marked. The scan walks back over
// continuation bytes (`0x80..0xBF`), so the cut can never split a scalar and the slice can never
// abort. Cutting at a fixed byte index instead aborts the process on an operand whose 256th byte
// falls inside a multibyte scalar, which turns a refusal into no document at all; it reached this
// module through `resident_detail` and `suffix_detail`. `docs/specs/r6-moe-resident-dense.md`
// section 13 item 15 records the repair. This is `src/model_ir.align`'s form, adopted verbatim.
fn bounded_detail(value: str) -> string {
  view := value.bytes()
  if view.len() <= MAX_DETAIL_BYTES {
    return value.clone()
  }
  mut cut := MAX_DETAIL_BYTES
  loop {
    if cut <= 0 { break }
    byte := view.u8(cut) as i64
    if byte < 128 || byte >= 192 { break }
    cut = cut - 1
  }
  return value[0..cut].clone()
}

fn fail(borrow mut o: model_forward.Outcome, code: str, detail: str) {
  if o.code.len() == 0 {
    o.code = code.clone()
    o.detail = bounded_detail(detail)
  }
}

fn fault_into(borrow mut o: model_forward.Outcome, borrow f: ggml_ffi.Fault) {
  code_view: str := f.code
  detail_view: str := f.detail
  fail(o, code_view, detail_view)
}

fn pack_fault_into(borrow mut o: model_forward.Outcome, borrow f: alignpack_read.Fault) {
  code_view: str := f.code
  detail_view: str := f.detail
  fail(o, code_view, detail_view)
}

fn take(borrow mut o: model_forward.Outcome, outcome: Result<(), ggml_ffi.Fault>) {
  match outcome {
    Ok(_) => {},
    Err(f) => { fault_into(o, f) },
  }
}

// The per-graph bookkeeping, module-local for the same reason the failure sink is. It is
// `model_forward.account` line for line except for its last statement: that module accumulates
// `r.reference_compute_ns`, and this arm runs no second ggml context — its self-reference oracle is
// the byte-plane source comparison (section 2.8 step 15) — so `run_step_graph` never sets that
// field and accumulating a value nothing writes would be dead. The `slot_high_water` maximum below
// is **not** optional and dropping it was a defect: without it a run that fails inside the prefill
// publishes `graph.slot_high_water` 0 and the document says nothing about how far the schedule got.
fn account(
  borrow r: model_forward.GraphResult,
  primary: bool,
  borrow mut graphs: array_builder<i64>,
  borrow mut o: model_forward.Outcome,
) {
  graphs.push(r.activation_bytes)
  if r.activation_bytes > o.activation_bytes_peak { o.activation_bytes_peak = r.activation_bytes }
  if r.slot_high_water > o.slot_high_water { o.slot_high_water = r.slot_high_water }
  if primary {
    o.node_count_total = o.node_count_total + r.node_count
    o.compute_ns = o.compute_ns + r.compute_ns
  } else {
    o.reconciliation_node_count = o.reconciliation_node_count + r.node_count
    o.reconciliation_compute_ns = o.reconciliation_compute_ns + r.compute_ns
  }
}

fn check_types(borrow m: model_forward.GraphMembers, layer: i64, borrow mut o: model_forward.Outcome) {
  mut at := 0
  loop {
    if at >= m.count || o.code.len() > 0 { break }
    status := ggml_ffi.type_ok_status(m.ggml_type[at], m.ne0[at])
    if status != 0 {
      code := if status == ggml_ffi.STATUS_TYPE { "R5_TYPE_UNSUPPORTED" } else { "R5_SHAPE" }
      fail(o, code, model_forward.layer_named(layer, "role", model_forward.graph_member_label(m, at)))
    }
    at = at + 1
  }
}

fn take_pack(borrow mut o: model_forward.Outcome, outcome: Result<(), alignpack_read.Fault>) {
  match outcome {
    Ok(_) => {},
    Err(f) => { pack_fault_into(o, f) },
  }
}

// ---------------------------------------------------------------------------------------------
// Details
// ---------------------------------------------------------------------------------------------

fn plane_detail(layer: i64, tensor: str) -> string {
  b := builder()
  b.write("layer[")
  b.write_int(layer)
  b.write("]tensor[")
  b.write(tensor)
  b.write("]")
  return b.to_string()
}

// R6-STEP-N section 2.7's locator. Every detail raised inside the loop is prefixed `step[<k>]`,
// written at one place rather than threaded through forty call sites: the loop records the code
// count before the step and calls this afterwards, so a seam code raised anywhere inside the step —
// `R5_COMPUTE` at a layer graph, `R6_PLANE_MISMATCH` at the round trip, `R6_ORACLE_MISSING` at the
// transcript — reaches the document with the step it came from and with its own code unchanged.
//
// `bounded_detail`'s 256-byte cap is unchanged and applied again after the prefix, which costs at
// most nine bytes against a `k` of at most `MAX_DECODE_STEPS`.
fn prefix_step(borrow mut o: model_forward.Outcome, step: i64) {
  if o.code.len() == 0 { return }
  b := builder()
  b.write("step[")
  b.write_int(step)
  b.write("]")
  detail_view: str := o.detail
  b.write(detail_view)
  joined := b.to_string()
  joined_view: str := joined
  o.detail = bounded_detail(joined_view)
}

// R6-PREFIX-SUFFIX-PREFILL section 2.7's locator. Every detail raised inside the suffix pass is
// prefixed `suffix[]` — the same shape as `step[<k>]` with **no index**, because there is exactly
// one suffix pass. `bounded_detail`'s 256-byte cap is unchanged and applied again after the prefix,
// which costs eight bytes.
fn prefix_suffix(borrow mut o: model_forward.Outcome) {
  if o.code.len() == 0 { return }
  b := builder()
  b.write("suffix[]")
  detail_view: str := o.detail
  b.write(detail_view)
  joined := b.to_string()
  joined_view: str := joined
  o.detail = bounded_detail(joined_view)
}

// `suffix[<text>]`, bounded to 256 bytes, so an operand of any length names itself in the document
// without the document growing with it. It is `resident_detail`'s shape and `RESIDENT`'s precedent.
fn suffix_detail(value: str) -> string {
  d := builder()
  d.write("suffix[")
  bounded := bounded_detail(value)
  bounded_view: str := bounded
  d.write(bounded_view)
  d.write("]")
  return d.to_string()
}

// R6-RESIDENT-WEIGHTS section 3.1. `resident[<text>]`, bounded to 256 bytes by `bounded_detail`,
// so an operand of any length names itself in the document without the document growing with it.
fn resident_detail(value: str) -> string {
  d := builder()
  d.write("resident[")
  bounded := bounded_detail(value)
  bounded_view: str := bounded
  d.write(bounded_view)
  d.write("]")
  return d.to_string()
}

fn steps_detail(value: str) -> string {
  b := builder()
  b.write("steps[")
  b.write(value)
  b.write("]")
  return b.to_string()
}

fn steps_detail_int(value: i64) -> string {
  b := builder()
  b.write("steps[")
  b.write_int(value)
  b.write("]")
  return b.to_string()
}

fn plane_column_detail(layer: i64, tensor: str, column: i64) -> string {
  b := builder()
  b.write("layer[")
  b.write_int(layer)
  b.write("]tensor[")
  b.write(tensor)
  b.write("]col[")
  b.write_int(column)
  b.write("]")
  return b.to_string()
}

// ---------------------------------------------------------------------------------------------
// The top ten, and the prefill's logits oracle
//
// Both are `src/model_forward.align`'s, reimplemented here for the failure sink's reason: a
// cross-module call cannot take this frame's `borrow mut` builders beside this frame's views. The
// arithmetic is that module's, line for line, including the range-checked conversion that keeps an
// infinity or a NaN from wrapping into a false pass.
// ---------------------------------------------------------------------------------------------

fn top_k(borrow region: slice<u8>, borrow mut index: array_builder<i64>,
  borrow mut bits: array_builder<i64>) {
  count := region.len() / 4
  mut taken := model_forward.zero_column(
    if count < model_forward.TOP_K { count } else { model_forward.TOP_K })
  mut picked := 0
  loop {
    if picked >= model_forward.TOP_K || picked >= count { break }
    mut best := -1
    mut best_value: f32 := 0.0 as f32
    mut at := 0
    loop {
      if at >= count { break }
      mut used := false
      mut seen := 0
      loop {
        if seen >= picked { break }
        if taken[seen] == at { used = true }
        seen = seen + 1
      }
      if !used {
        value := region.f32_le(at * 4)
        if best < 0 || value > best_value {
          best = at
          best_value = value
        }
      }
      at = at + 1
    }
    if best < 0 { break }
    taken[picked] = best
    index.push(best)
    bits.push(region.u32_le(best * 4) as i64)
    picked = picked + 1
  }
}

// The **prefill's** logits against a `llama-debug --save-logits` blob. Section 2.1 records that the
// blob references the prefill's final position and not the step's, and section 3.1 measured why
// there is no blob for the step: `llama-debug` performs exactly one `llama_decode` and `-n` is inert
// for it. The prefill here runs at the declared `KV_WIDTH`, which is R5B's reconciliation width, so
// the contract is **byte identity** and nothing less.
fn compare_prefill_logits(
  logits_path: str,
  borrow primary: slice<u8>,
  n_vocab: i64,
  borrow top: model_forward.TopColumns,
  borrow mut o: model_forward.Outcome,
) {
  handle := match fs.open_rw(logits_path) {
    Ok(value) => value,
    Err(failure) => {
      fail(o, "R5_LOGITS_UNREADABLE", model_forward.error_name(failure))
      return
    },
  }
  size := match handle.len() {
    Ok(value) => value,
    Err(failure) => {
      fail(o, "R5_LOGITS_UNREADABLE", model_forward.error_name(failure))
      return
    },
  }
  if size != n_vocab * 4 {
    fail(o, "R5_LOGITS_SHAPE", model_forward.labelled("bytes", size))
    return
  }
  mut image: buffer := buffer(0)
  mut counters := alignpack_read.new_counters()
  take_pack(o, alignpack_read.read_exact(handle, image, counters, "R5_LOGITS_UNREADABLE", 0, size))
  if o.code.len() > 0 { return }
  view := image.bytes()
  if view.len() != size {
    fail(o, "R5_LOGITS_UNREADABLE", "short")
    return
  }
  reference := model_forward.digest_region(view)
  o.logits_reference_sha256 = reference.sha.clone()
  o.logits_reference_bit_sum = reference.bit_sum
  o.logits_argmax_reference = reference.argmax
  if reference.nonfinite > 0 {
    fail(o, "R5_LOGITS_NONFINITE", model_forward.labelled("elements", reference.nonfinite))
    return
  }
  o.logits_byte_identical = crypto.constant_time_equal(primary, view)
  o.logits_elements = n_vocab
  mut worst := 0
  mut at := 0
  loop {
    if at >= n_vocab { break }
    primary_scaled := model_forward.logit_ten_thousandths(primary, at)
    reference_scaled := model_forward.logit_ten_thousandths(view, at)
    unrepresentable := primary_scaled == model_forward.LOGIT_UNREPRESENTABLE
      || reference_scaled == model_forward.LOGIT_UNREPRESENTABLE
    difference := if unrepresentable { 0 } else { primary_scaled - reference_scaled }
    magnitude := if unrepresentable {
      model_forward.LOGIT_SCALE_LIMIT_TEN_THOUSANDTHS
    } else if difference < 0 {
      0 - difference
    } else {
      difference
    }
    if magnitude > worst { worst = magnitude }
    at = at + 1
  }
  o.logits_max_abs = worst
  mut reference_index: array_builder<i64> := array_builder()
  mut reference_bits: array_builder<i64> := array_builder()
  top_k(view, reference_index, reference_bits)
  reference_top := reference_index.build()
  mut agreement := 0
  mut rank := 0
  loop {
    if rank >= top.index.len() || rank >= reference_top.len() { break }
    if top.index[rank] != reference_top[rank] { break }
    agreement = agreement + 1
    rank = rank + 1
  }
  o.logits_top_k_agreement = agreement
  o.logits_compared_reconciliation = true
  o.logits_verdict = if o.logits_byte_identical {
    model_forward.LOGITS_IDENTICAL
  } else {
    model_forward.LOGITS_FAIL
  }
}

// ---------------------------------------------------------------------------------------------
// The plane's arithmetic (section 2.2)
//
// Layer-major, then tensor, then column. For layer `l`, K occupies `[stride*(2*l), stride*(2*l+1))`
// and V the next `stride` bytes, where `stride = KV_WIDTH * n_head_kv * head_dim * 4`. Within a
// tensor the order is exactly ggml's own for a `{head_dim, n_head_kv, KV_WIDTH}` f32 tensor:
// `head_dim` fastest, then `n_head_kv`, then column — which is precisely the shape of the prefill's
// post-RoPE K node and of its reshaped V node, so the readback is one contiguous copy per layer.
// ---------------------------------------------------------------------------------------------

pub fn plane_stride(borrow g: layer_qwen2.Geometry, width: i64) -> i64 =
width * g.n_head_kv * g.head_dim * 4

pub fn plane_bytes_for(borrow g: layer_qwen2.Geometry, width: i64) -> i64 =
g.n_layer * 2 * plane_stride(g, width)

fn plane_k_offset(stride: i64, layer: i64) -> i64 = stride * (2 * layer)

fn plane_v_offset(stride: i64, layer: i64) -> i64 = stride * (2 * layer + 1)

// One column of one layer's K or V, in bytes.
fn plane_column_bytes(borrow g: layer_qwen2.Geometry) -> i64 = g.n_head_kv * g.head_dim * 4

// ---------------------------------------------------------------------------------------------
// The two staging transposes (section 2.2, and section 3.3's oracle B)
//
// The plane is `{head_dim, n_head_kv, column}` because that is the shape the prefill produces and a
// contiguous readback is the only crossing that cannot reorder anything. The decode graph wants a
// different order on each tensor: K's past operand is `{head_dim, n_past, n_head_kv}` and V's is
// `{n_past, head_dim, n_head_kv}`, because row 15's and row 21's `CONT_3D`s materialize different
// permutations. The two loops below are that difference, written out once each.
//
// They are the reason oracle B exists. A transposed plane, an off-by-one stride, or a K/V swap is
// numerically plausible and would survive oracle A's four printed decimals; it does not survive a
// byte comparison of what the graph actually consumed against what the prefill actually wrote.
// ---------------------------------------------------------------------------------------------

fn stage_past_k(
  borrow mut stage: buffer,
  borrow plane: slice<u8>,
  base: i64,
  head_dim: i64,
  n_head_kv: i64,
  n_past: i64,
) {
  mut head := 0
  loop {
    if head >= n_head_kv { break }
    mut column := 0
    loop {
      if column >= n_past { break }
      mut lane := 0
      loop {
        if lane >= head_dim { break }
        at := base + (lane + head_dim * (head + n_head_kv * column)) * 4
        stage.put_u32_le(plane.u32_le(at))
        lane = lane + 1
      }
      column = column + 1
    }
    head = head + 1
  }
}

fn stage_past_v(
  borrow mut stage: buffer,
  borrow plane: slice<u8>,
  base: i64,
  head_dim: i64,
  n_head_kv: i64,
  n_past: i64,
) {
  mut head := 0
  loop {
    if head >= n_head_kv { break }
    mut lane := 0
    loop {
      if lane >= head_dim { break }
      mut column := 0
      loop {
        if column >= n_past { break }
        at := base + (lane + head_dim * (head + n_head_kv * column)) * 4
        stage.put_u32_le(plane.u32_le(at))
        column = column + 1
      }
      lane = lane + 1
    }
    head = head + 1
  }
}

// Oracle B on one layer's K. `consumed` is the concatenated operand the decode graph actually
// reduced over, read back after compute; its first `n_past` columns must be the plane's bytes.
fn compare_past_k(
  borrow consumed: slice<u8>,
  borrow plane: slice<u8>,
  base: i64,
  head_dim: i64,
  n_head_kv: i64,
  n_past: i64,
  columns: i64,
) -> i64 {
  mut head := 0
  loop {
    if head >= n_head_kv { break }
    mut column := 0
    loop {
      if column >= n_past { break }
      mut lane := 0
      loop {
        if lane >= head_dim { break }
        from := base + (lane + head_dim * (head + n_head_kv * column)) * 4
        into := (lane + head_dim * (column + columns * head)) * 4
        if plane.u32_le(from) != consumed.u32_le(into) { return column }
        lane = lane + 1
      }
      column = column + 1
    }
    head = head + 1
  }
  return -1
}

fn compare_past_v(
  borrow consumed: slice<u8>,
  borrow plane: slice<u8>,
  base: i64,
  head_dim: i64,
  n_head_kv: i64,
  n_past: i64,
  columns: i64,
) -> i64 {
  mut head := 0
  loop {
    if head >= n_head_kv { break }
    mut lane := 0
    loop {
      if lane >= head_dim { break }
      mut column := 0
      loop {
        if column >= n_past { break }
        from := base + (lane + head_dim * (head + n_head_kv * column)) * 4
        into := (column + columns * (lane + head_dim * head)) * 4
        if plane.u32_le(from) != consumed.u32_le(into) { return column }
        column = column + 1
      }
      lane = lane + 1
    }
    head = head + 1
  }
  return -1
}

// ---------------------------------------------------------------------------------------------
// The decode graph's node walk and its two extra inputs
// ---------------------------------------------------------------------------------------------

// `src/model_forward.align`'s walk with two differences: it consults the decode condition, and it
// dispatches `OP_CONCAT`. Everything else — `when` selecting rows and `alt_when` selecting operands,
// both as data — is that module's, unchanged.
fn build_decode_nodes(
  ctx: raw,
  borrow slots: slice<u8>,
  borrow nodes: layer_qwen2.NodeTable,
  last: bool,
  wide: bool,
  decode: bool,
) -> Result<(), ggml_ffi.Fault> {
  mut row := 0
  loop {
    if row >= nodes.count { break }
    if layer_qwen2.mf_row_issued_at(nodes.when[row], last, wide, decode) {
      op := nodes.op[row]
      out := nodes.out[row]
      swap := nodes.alt_when[row] != layer_qwen2.WHEN_ALWAYS
        && layer_qwen2.mf_row_issued_at(nodes.alt_when[row], last, wide, decode)
      a := if swap && nodes.alt_a[row] >= 0 { nodes.alt_a[row] } else { nodes.a[row] }
      b := if swap && nodes.alt_b[row] >= 0 { nodes.alt_b[row] } else { nodes.b[row] }
      tag := model_forward.labelled("node", row)
      label: str := tag
      if op == layer_qwen2.OP_GET_ROWS {
        ggml_ffi.op_get_rows(ctx, slots, out, a, b, label)?
      }
      if op == layer_qwen2.OP_RMS_NORM {
        ggml_ffi.op_rms_norm(ctx, slots, out, a, nodes.p0[row], label)?
      }
      if op == layer_qwen2.OP_MUL {
        ggml_ffi.op_mul(ctx, slots, out, a, b, label)?
      }
      if op == layer_qwen2.OP_ADD {
        ggml_ffi.op_add(ctx, slots, out, a, b, label)?
      }
      if op == layer_qwen2.OP_MUL_MAT {
        ggml_ffi.op_mul_mat(ctx, slots, out, a, b, label)?
      }
      if op == layer_qwen2.OP_RESHAPE_3D {
        ggml_ffi.op_reshape_3d(
          ctx, slots, out, a, nodes.p0[row], nodes.p1[row], nodes.p2[row], label)?
      }
      if op == layer_qwen2.OP_PERMUTE {
        ggml_ffi.op_permute(
          ctx, slots, out, a, nodes.p0[row], nodes.p1[row], nodes.p2[row], nodes.p3[row], label)?
      }
      if op == layer_qwen2.OP_CONT_3D {
        ggml_ffi.op_cont_3d(ctx, slots, out, a, nodes.p0[row], nodes.p1[row], nodes.p2[row], label)?
      }
      if op == layer_qwen2.OP_ROPE {
        ggml_ffi.op_rope_neox(
          ctx, slots, out, a, b, nodes.p0[row], nodes.p1[row], nodes.p2[row], nodes.p3[row], label)?
      }
      if op == layer_qwen2.OP_SOFT_MAX {
        ggml_ffi.op_soft_max_ext(ctx, slots, out, a, b, nodes.p0[row], nodes.p1[row], label)?
      }
      if op == layer_qwen2.OP_SWIGLU {
        ggml_ffi.op_swiglu_split(ctx, slots, out, a, b, label)?
      }
      if op == layer_qwen2.OP_PAD {
        ggml_ffi.op_pad(
          ctx, slots, out, a, nodes.p0[row], nodes.p1[row], nodes.p2[row], nodes.p3[row], label)?
      }
      // Section 2.5's one new op. `p0` is the axis: 1 for K, 0 for V, per row and never shared.
      if op == layer_qwen2.OP_CONCAT {
        ggml_ffi.op_concat(ctx, slots, out, a, b, nodes.p0[row], label)?
      }
      row = row + 1
    } else {
      row = row + 1
    }
  }
  return Ok(())
}

// The decode layer graph's inputs. The four `src/model_forward.align` already builds, plus the two
// section 2.3 adds: the plane's past K and its past V, at slots 64 and 65 so the prefill's slot map
// and every golden that records it stay exactly where they were.
fn decode_layer_inputs(
  ctx: raw,
  borrow slots: slice<u8>,
  borrow g: layer_qwen2.Geometry,
  width: i64,
  n_past: i64,
  // R6-PREFIX-SUFFIX-PREFILL section 2.6. The number of columns this graph computes: `1` for a
  // decode step, `S` for the suffix pass. The two **plane** slots below do not mention it — they are
  // sized by `n_past`, which is what the plane holds — so the slot map is unchanged.
  tokens: i64,
) -> Result<(), ggml_ffi.Fault> {
  ggml_ffi.slot_new_tensor_2d(
    ctx, slots, layer_qwen2.MF_SLOT_CUR, layer_qwen2.GGML_TYPE_F32, g.n_embd, tokens, "cur")?
  ggml_ffi.slot_new_i32_1d(ctx, slots, layer_qwen2.MF_SLOT_POS, tokens, "inp_pos")?
  ggml_ffi.slot_new_tensor_2d(
    ctx, slots, layer_qwen2.MF_SLOT_MASK, layer_qwen2.GGML_TYPE_F32, width, tokens, "kq_mask")?
  ggml_ffi.slot_new_i32_1d(ctx, slots, layer_qwen2.MF_SLOT_OUT_IDS, 1, "out_ids")?
  ggml_ffi.slot_new_tensor_3d(
    ctx, slots, layer_qwen2.MF_SLOT_KPAST, layer_qwen2.GGML_TYPE_F32,
    g.head_dim, n_past, g.n_head_kv, "k_past")?
  ggml_ffi.slot_new_tensor_3d(
    ctx, slots, layer_qwen2.MF_SLOT_VPAST, layer_qwen2.GGML_TYPE_F32,
    n_past, g.head_dim, g.n_head_kv, "v_past")?
  return Ok(())
}

fn decode_layer_values(
  borrow slots: slice<u8>,
  borrow g: layer_qwen2.Geometry,
  width: i64,
  n_past: i64,
  tokens: i64,
  borrow cur: slice<u8>,
  borrow positions: slice<u8>,
  borrow mask: slice<u8>,
  borrow out_ids: slice<u8>,
  borrow past_k: slice<u8>,
  borrow past_v: slice<u8>,
) -> Result<(), ggml_ffi.Fault> {
  past := n_past * g.n_head_kv * g.head_dim * 4
  ggml_ffi.slot_set(slots, layer_qwen2.MF_SLOT_CUR, cur, 0, g.n_embd * tokens * 4, "cur")?
  ggml_ffi.slot_set(slots, layer_qwen2.MF_SLOT_POS, positions, 0, tokens * 4, "inp_pos")?
  ggml_ffi.slot_set(slots, layer_qwen2.MF_SLOT_MASK, mask, 0, width * tokens * 4, "kq_mask")?
  ggml_ffi.slot_set(slots, layer_qwen2.MF_SLOT_OUT_IDS, out_ids, 0, 4, "out_ids")?
  ggml_ffi.slot_set(slots, layer_qwen2.MF_SLOT_KPAST, past_k, 0, past, "k_past")?
  ggml_ffi.slot_set(slots, layer_qwen2.MF_SLOT_VPAST, past_v, 0, past, "v_past")?
  return Ok(())
}

// ---------------------------------------------------------------------------------------------
// The four node rows this module addresses by number
//
// Section 2.2 establishes the prefill's two by **reading the table** rather than by name: row 9
// reshapes `n+5` and row 12 ropes it, so `n+5` is K; row 10 reshapes `n+7` and nothing ropes it, so
// `n+7` is V. Only Q and K are roped, which is what distinguishes them. The decode table's two are
// its `CONCAT`s, which are the operands the attention actually reduces over and therefore the only
// pair oracle B can honestly compare.
// ---------------------------------------------------------------------------------------------

PREFILL_K_ROW := 12
PREFILL_V_ROW := 10
DECODE_K_CONCAT_ROW := 16
DECODE_V_CONCAT_ROW := 22

// ---------------------------------------------------------------------------------------------
// One graph
//
// `src/model_forward.align`'s `run_graph` with the reference arm removed — R6's self-reference
// oracle is the byte-plane source comparison, not a second ggml context (section 2.8 step 15) — and
// with the three things this capability adds: the decode graph's two extra inputs, the plane
// readback on a prefill layer, and oracle B's round trip on a decode layer.
//
// Every ggml object below the backend is a bare local, because `raw` cannot be aggregated, and every
// one of them is freed before this function returns, which is what makes reusing the weight window
// for the next block safe. The plane is **not** a ggml object and is not freed here: it is an
// ordinary Align `buffer` owned by `execute` and freed at that scope's end on every path.
// ---------------------------------------------------------------------------------------------

fn run_step_graph(
  device: raw,
  backend: raw,
  // R6-RESIDENT-WEIGHTS section 3.2. `null` is streaming mode and this graph wraps its own window;
  // a live handle is the run-scope resident wrap, which this graph **places into and does not
  // free**. The two lifetimes are counted in two different pairs (section 4.3) so that the
  // per-graph balance check below keeps its exact meaning rather than being loosened.
  resident_buffer: raw,
  context_bytes: i64,
  borrow spec: model_forward.GraphSpec,
  borrow g: layer_qwen2.Geometry,
  borrow m: model_forward.GraphMembers,
  borrow nodes: layer_qwen2.NodeTable,
  borrow oracle: layer_qwen2.OracleTable,
  borrow window: slice<u8>,
  borrow slot_view: slice<u8>,
  borrow cur: slice<u8>,
  borrow token_ids: slice<u8>,
  borrow positions: slice<u8>,
  borrow mask: slice<u8>,
  borrow out_ids: slice<u8>,
  borrow past_k: slice<u8>,
  borrow past_v: slice<u8>,
  borrow node_window: slice<u8>,
  borrow output_view: slice<u8>,
  borrow plane: slice<u8>,
  borrow scan: layer_forward.TranscriptScan,
  borrow starts: array<i64>,
  borrow lengths: array<i64>,
  decode: bool,
  capture: bool,
  n_past: i64,
  stride: i64,
  borrow mut breach: bool,
  borrow mut state: Plane,
  borrow mut result: model_forward.GraphResult,
  borrow mut o: model_forward.Outcome,
) {
  mut weight_ctx := ggml_ffi.null_handle()
  mut input_ctx := ggml_ffi.null_handle()
  mut graph_ctx := ggml_ffi.null_handle()
  mut weight_buffer := ggml_ffi.null_handle()
  // The wrap this graph must free, which is the wrap this graph created. In resident mode it stays
  // `null` and the teardown below is a no-op for it.
  mut owned_buffer := ggml_ffi.null_handle()
  mut input_buffer := ggml_ffi.null_handle()
  mut graph := ggml_ffi.null_handle()
  mut galloc := ggml_ffi.null_handle()
  layer_graph := spec.kind == model_forward.GRAPH_LAYER

  take(o, ggml_ffi.slots_init(slot_view, slot_view.len(), "slots"))
  if o.code.len() == 0 {
    weight_ctx = ggml_ffi.context_open(context_bytes)
    input_ctx = ggml_ffi.context_open(context_bytes)
    graph_ctx = ggml_ffi.context_open(context_bytes)
    if ggml_ffi.handle_absent(weight_ctx) || ggml_ffi.handle_absent(input_ctx)
      || ggml_ffi.handle_absent(graph_ctx) {
      fail(o, "R5_GGML_INIT", "context")
    } else {
      o.contexts_created = o.contexts_created + 3
    }
  }
  if o.code.len() == 0 && !ggml_ffi.handle_absent(resident_buffer) {
    weight_buffer = resident_buffer
  } else if o.code.len() == 0 {
    wrap_started := time.instant()
    weight_buffer = ggml_ffi.buffer_from_host(device, window, window.len())
    o.wrap_ns = o.wrap_ns + (time.instant() - wrap_started)
    if ggml_ffi.handle_absent(weight_buffer) {
      fail(o, "R5_GGML_INIT", "weight_buffer")
    } else {
      owned_buffer = weight_buffer
      o.ggml_buffers_created = o.ggml_buffers_created + 1
      o.wrap_count = o.wrap_count + 1
    }
  }
  if o.code.len() == 0 {
    alignment := o.tensor_alignment
    model_forward.graph_alignment(m, window, alignment, spec.layer, o)
  }
  if o.code.len() == 0 {
    take(o, model_forward.graph_weights(weight_ctx, weight_buffer, slot_view, window, m))
  }
  if o.code.len() == 0 { model_forward.graph_identity(slot_view, window, m, o) }
  if o.code.len() == 0 {
    if decode && layer_graph {
      take(o, decode_layer_inputs(input_ctx, slot_view, g, spec.width, n_past, spec.tokens_in))
    } else {
      take(o, model_forward.graph_inputs(input_ctx, slot_view, spec))
    }
  }
  if o.code.len() == 0 {
    input_buffer = ggml_ffi.alloc_remaining(input_ctx, backend)
    if ggml_ffi.handle_absent(input_buffer) {
      fail(o, "R5_GGML_INIT", "input_buffer")
    } else {
      o.ggml_buffers_created = o.ggml_buffers_created + 1
    }
  }
  if o.code.len() == 0 {
    if decode && layer_graph {
      take(o, decode_layer_values(
          slot_view, g, spec.width, n_past, spec.tokens_in, cur, positions, mask, out_ids, past_k,
          past_v))
    } else {
      take(o, model_forward.graph_input_values(
          slot_view, spec, cur, token_ids, positions, mask, out_ids))
    }
  }
  if o.code.len() == 0 {
    graph = ggml_ffi.graph_new(graph_ctx)
    galloc = ggml_ffi.gallocr_new(backend)
    if ggml_ffi.handle_absent(graph) || ggml_ffi.handle_absent(galloc) {
      fail(o, "R5_GGML_INIT", "graph")
    } else {
      o.graphs_created = o.graphs_created + 1
      o.gallocrs_created = o.gallocrs_created + 1
    }
  }
  if o.code.len() == 0 {
    take(o, build_decode_nodes(graph_ctx, slot_view, nodes, spec.last, spec.wide, decode))
  }
  // Mandatory, and for the reason `ggml_ffi.slot_mark_output` states: without it `ggml_gallocr`
  // reuses an intermediate's memory and the bytes read back are not the node computed. The plane
  // would then be filled with whatever the next tenant left, which is a failure mode that looks like
  // arithmetic.
  //
  // R6-STEP-N section 4.5: the **decode** layer graph marks the same two rows, because the write-back
  // reads them. They are nodes the graph already contains — row 12 is its post-RoPE K and row 10 its
  // reshaped V, both `{head_dim, n_head_kv, 1}` — so the node count is unchanged and no new op, FFI
  // symbol, or slot is added. The concat outputs (rows 16 and 22) are deliberately not the source:
  // row 22's V is transposed, so its new column is strided, and a strided write-back would be a
  // second layout to get wrong.
  write_back := decode && layer_graph
  if o.code.len() == 0 && (capture || write_back) {
    take(o, ggml_ffi.slot_mark_output(slot_view, nodes.out[PREFILL_K_ROW], "k_plane"))
    take(o, ggml_ffi.slot_mark_output(slot_view, nodes.out[PREFILL_V_ROW], "v_plane"))
  }
  if o.code.len() == 0 && decode && layer_graph {
    take(o, ggml_ffi.slot_mark_output(
        slot_view, nodes.out[DECODE_K_CONCAT_ROW], "k_concat"))
    take(o, ggml_ffi.slot_mark_output(
        slot_view, nodes.out[DECODE_V_CONCAT_ROW], "v_concat"))
  }
  if o.code.len() == 0 && spec.compare {
    take(o, model_forward.mark_outputs(
        slot_view, oracle, nodes, spec.oracle_base, spec.oracle_count))
  }
  if o.code.len() == 0 {
    take(o, ggml_ffi.graph_expand(graph, slot_view, spec.output_slot, "output"))
  }
  if o.code.len() == 0 {
    take(o, ggml_ffi.gallocr_reserve(
        galloc, graph, model_forward.labelled("graph", spec.index)))
    result.activation_bytes = ggml_ffi.gallocr_bytes(galloc)
  }
  if o.code.len() == 0 {
    take(o, ggml_ffi.gallocr_alloc(
        galloc, graph, model_forward.labelled("graph", spec.index)))
    result.node_count = ggml_ffi.graph_node_count(graph)
    result.slot_high_water = ggml_ffi.slots_high_water(slot_view)
  }
  if o.code.len() == 0 {
    started := time.instant()
    status := ggml_ffi.graph_compute(backend, graph)
    result.compute_ns = time.instant() - started
    if status != 0 {
      fail(
        o, "R5_COMPUTE", model_forward.layer_named(spec.layer, "status", model_forward.int_text(status)))
    }
  }
  if o.code.len() == 0 {
    span := ggml_ffi.slot_nbytes(slot_view, spec.output_slot)
    result.out_ne0 = ggml_ffi.slot_ne(slot_view, spec.output_slot, 0)
    result.out_ne1 = ggml_ffi.slot_ne(slot_view, spec.output_slot, 1)
    result.out_bytes = span
    if span <= 0 || span > output_view.len() {
      fail(o, "R5_RESIDUAL", model_forward.labelled("layer", spec.layer))
    } else {
      take(
        o, ggml_ffi.slot_get(slot_view, spec.output_slot, output_view, 0, span, "output"))
    }
  }
  if o.code.len() == 0 && capture {
    capture_plane(slot_view, nodes, plane, g, spec.layer, spec.tokens_in, 0, stride, state, o)
  }
  // R6-STEP-N section 2.4's ordering invariant, in the order it names. R6 stated the invariant as an
  // **exclusion** — the plane is never both a `slot_get` destination and a `slot_set` source in one
  // call — and named that as why step 2 was out of scope. What replaces it is **disjointness plus
  // ordering**: this graph uploaded columns `0 .. n_past-1` before compute, and now, after a
  // completed compute, writes column `n_past` and only that column. The two byte ranges are disjoint
  // by construction and no call is ever both.
  //
  // The write-back precedes the verification on purpose. R6 compared `n_past` columns of an
  // `n_past + 1`-wide operand and left the new column unchecked until — under R6 — never. Here the
  // comparison bound is `n_past + 1`, so the column the graph produced (rows 12/10) and the column
  // the plane holds are compared through a *different* node (rows 16/22): a write-back one lane off,
  // in the wrong tensor, or at the wrong column dies in its own step.
  //
  // R6-PREFIX-SUFFIX-PREFILL section 2.4 keeps the same shape over **three** ranges: the suffix pass
  // uploaded columns `0 .. T_prefix-1`, and now writes columns `T_prefix .. T_prefix+S-1` and only
  // those. The uploaded range and the written range are disjoint by construction, adjacent, and
  // separated by a completed compute; the only generalisation is that the written range has length
  // `spec.tokens_in` rather than 1. The comparison bound below moves with it, so the columns this
  // pass produced are compared through a different node in the pass that produced them.
  if o.code.len() == 0 && write_back {
    capture_plane(slot_view, nodes, plane, g, spec.layer, spec.tokens_in, n_past, stride, state, o)
  }
  if o.code.len() == 0 && write_back {
    verify_plane(
      slot_view, nodes, plane, node_window, g, spec.layer, n_past, spec.tokens_in, stride, state, o)
  }
  if o.code.len() == 0 && spec.compare && o.transcript_present {
    match model_forward.compare_transcript_graph(
      slot_view, oracle, nodes, spec, scan, starts, lengths, node_window, breach, o) {
      Ok(_) => {},
      Err(f) => { fault_into(o, f) },
    }
  }
  model_forward.teardown_graph(
    galloc, ggml_ffi.null_handle(), graph_ctx, ggml_ffi.null_handle(), owned_buffer, weight_ctx,
    ggml_ffi.null_handle(), ggml_ffi.null_handle(), input_buffer, input_ctx, o)
}

// R6 section 2.2's "written by", generalised by R6-STEP-N section 2.4. One layer's post-RoPE K and
// its V, read back into the plane at that layer's two offsets, starting at column `first_column`.
// Both nodes are `{head_dim, n_head_kv, tokens}`, which is the plane's own order, so each is one
// contiguous copy and nothing is reordered on the way in.
//
// The prefill calls it once per layer with `first_column = 0` and `tokens = T`; decode step `k`
// calls it once per layer with `first_column = n_past` and `tokens = 1`. **That is the only
// difference, and it is why "grown in place" is not a reallocation:** the buffer is `KV_WIDTH`
// columns wide from the start, and growth means writing further into it.
fn capture_plane(
  borrow slots: slice<u8>,
  borrow nodes: layer_qwen2.NodeTable,
  borrow plane: slice<u8>,
  borrow g: layer_qwen2.Geometry,
  layer: i64,
  tokens: i64,
  first_column: i64,
  stride: i64,
  borrow mut state: Plane,
  borrow mut o: model_forward.Outcome,
) {
  column_bytes := plane_column_bytes(g)
  span := tokens * column_bytes
  offset := first_column * column_bytes
  k_at := plane_k_offset(stride, layer) + offset
  v_at := plane_v_offset(stride, layer) + offset
  if span <= 0 || first_column < 0 || offset + span > stride
    || plane_v_offset(stride, layer) + stride > plane.len() {
    fail(o, CODE_PLANE_WRITE, plane_detail(layer, "k"))
    return
  }
  started := time.instant()
  if ggml_ffi.slot_nbytes(slots, nodes.out[PREFILL_K_ROW]) != span {
    fail(o, CODE_PLANE_WRITE, plane_detail(layer, "k"))
    return
  }
  if ggml_ffi.slot_nbytes(slots, nodes.out[PREFILL_V_ROW]) != span {
    fail(o, CODE_PLANE_WRITE, plane_detail(layer, "v"))
    return
  }
  k_region := plane[k_at..k_at + span]
  v_region := plane[v_at..v_at + span]
  take(
    o, ggml_ffi.slot_get(slots, nodes.out[PREFILL_K_ROW], k_region, 0, span, "k_plane"))
  if o.code.len() == 0 {
    take(
      o, ggml_ffi.slot_get(slots, nodes.out[PREFILL_V_ROW], v_region, 0, span, "v_plane"))
  }
  state.readback_ns = state.readback_ns + (time.instant() - started)
  if o.code.len() == 0 {
    // `plane.layers` counts the layers the plane holds, not the number of write-backs: at `N` steps
    // a running total would report `n_layer * (N + 1)`. A maximum is the honest reading and it is
    // the same number R6 published.
    if layer + 1 > state.layers { state.layers = layer + 1 }
    // `columns_written` is advanced by the **prefill** here and by the step loop only after a step
    // has completed every one of its layers. A per-layer advance would let a run that failed at
    // layer 4 of step `k` publish `T + k` columns when only `T + k - 1` were verified.
    if first_column == 0 { state.columns_written = tokens }
  }
}

// R6-STEP-N section 3.4, oracle B. The K and V the decode graph **actually consumed** — its two
// `CONCAT` nodes, read back after compute — must agree with the plane byte for byte over columns
// `0 .. n_past`, on every layer. This is the oracle that tests what this capability adds: the
// readback, the layout, the two offsets, the upload, both concat axes, and now the write-back.
//
// Two things changed from R6. It is **cumulative**: at step `k` the comparison covers the prefill's
// `T` columns *and* every column a previous step wrote, so a write-back that was correct when it
// happened and was corrupted later is caught. And it **includes the new column** (`n_past + 1`
// columns, not `n_past`), because the write-back precedes it.
fn verify_plane(
  borrow slots: slice<u8>,
  borrow nodes: layer_qwen2.NodeTable,
  borrow plane: slice<u8>,
  borrow node_window: slice<u8>,
  borrow g: layer_qwen2.Geometry,
  layer: i64,
  n_past: i64,
  // R6-PREFIX-SUFFIX-PREFILL section 3.4. The columns this pass wrote: `1` for a decode step, `S`
  // for the suffix pass. At `tokens = 1` the bound below is R6-STEP-N's expression character for
  // character, which is what keeps every existing step's byte count identical.
  tokens: i64,
  stride: i64,
  borrow mut state: Plane,
  borrow mut o: model_forward.Outcome,
) {
  columns := n_past + tokens
  span := columns * plane_column_bytes(g)
  k_at := plane_k_offset(stride, layer)
  v_at := plane_v_offset(stride, layer)
  // Both refusals below are `R6_PLANE_MISMATCH`, so both must leave the record the code names.
  // A document that carried the code and still reported `roundtrip_verdict: "-"` with
  // `first_mismatch_layer: -1` would say "the round trip failed" and "the round trip was never
  // attempted" in the same breath; `column: -1` is the honest column, because the disagreement is
  // the operand's whole extent and not one of its columns.
  if span <= 0 || span > node_window.len() {
    state.roundtrip_verdict = ROUNDTRIP_MISMATCH
    state.first_mismatch_layer = layer
    state.first_mismatch_tensor = PLANE_TENSOR_K
    state.first_mismatch_column = -1
    fail(o, CODE_PLANE_MISMATCH, plane_column_detail(layer, "k", -1))
    return
  }
  // The two concat rows are checked together but reported separately: naming `k` when only the V
  // concat is the wrong size would send a reader to the wrong half of the layout. K is named when
  // it is the row that disagrees, otherwise V is.
  k_bytes := ggml_ffi.slot_nbytes(slots, nodes.out[DECODE_K_CONCAT_ROW])
  v_bytes := ggml_ffi.slot_nbytes(slots, nodes.out[DECODE_V_CONCAT_ROW])
  if k_bytes != span || v_bytes != span {
    mut tensor := PLANE_TENSOR_V
    if k_bytes != span { tensor = PLANE_TENSOR_K }
    label: str := plane_tensor_label(tensor)
    state.roundtrip_verdict = ROUNDTRIP_MISMATCH
    state.first_mismatch_layer = layer
    state.first_mismatch_tensor = tensor
    state.first_mismatch_column = -1
    fail(o, CODE_PLANE_MISMATCH, plane_column_detail(layer, label, -1))
    return
  }
  take(
    o, ggml_ffi.slot_get(slots, nodes.out[DECODE_K_CONCAT_ROW], node_window, 0, span, "k_concat"))
  if o.code.len() > 0 { return }
  bad := compare_past_k(
    node_window, plane, k_at, g.head_dim, g.n_head_kv, columns, columns)
  if bad >= 0 {
    state.roundtrip_verdict = ROUNDTRIP_MISMATCH
    state.first_mismatch_layer = layer
    state.first_mismatch_tensor = PLANE_TENSOR_K
    state.first_mismatch_column = bad
    fail(o, CODE_PLANE_MISMATCH, plane_column_detail(layer, "k", bad))
    return
  }
  take(
    o, ggml_ffi.slot_get(slots, nodes.out[DECODE_V_CONCAT_ROW], node_window, 0, span, "v_concat"))
  if o.code.len() > 0 { return }
  worst := compare_past_v(
    node_window, plane, v_at, g.head_dim, g.n_head_kv, columns, columns)
  if worst >= 0 {
    state.roundtrip_verdict = ROUNDTRIP_MISMATCH
    state.first_mismatch_layer = layer
    state.first_mismatch_tensor = PLANE_TENSOR_V
    state.first_mismatch_column = worst
    fail(o, CODE_PLANE_MISMATCH, plane_column_detail(layer, "v", worst))
    return
  }
  state.roundtrip_bytes_compared =
  state.roundtrip_bytes_compared + 2 * columns * plane_column_bytes(g)
}

// ---------------------------------------------------------------------------------------------
// R6-KV-PERSIST: the container, in both directions
//
// Section 2.7's module split lands here. `src/kv_plane.align` owns the format — the constants, the
// header, the identity record, the region arithmetic, the digests, and the writer, all of which are
// expressible with borrowed views and by-value returns. The two functions below are what stays with
// the plane's **owner**: the token image the writer needs, and the chunked refill that writes into
// this frame's own `mut plane: buffer`. A cross-module call taking `borrow mut buffer` beside this
// frame's other locals is exactly the shape Request 49 refuses, so the byte movement stays here and
// no compatibility layer is built around the gap.
// ---------------------------------------------------------------------------------------------

fn kv_width_detail(from_file: i64, from_operand: i64) -> string {
  b := builder()
  b.write("kv_width[")
  b.write_int(from_file)
  b.write("]!=[")
  b.write_int(from_operand)
  b.write("]")
  return b.to_string()
}

fn kv_columns_detail(columns: i64, tokens: i64) -> string {
  b := builder()
  b.write("columns[")
  b.write_int(columns)
  b.write("]!=[")
  b.write_int(tokens)
  b.write("]")
  return b.to_string()
}

fn publish_header(borrow h: kv_plane.KvHeader, borrow mut o: model_forward.Outcome) {
  o.kv_format_version = h.format_version
  o.kv_plane_layout_version = h.plane_layout_version
  o.kv_total_bytes = h.total_bytes
  o.kv_header_bytes = h.header_bytes
  o.kv_plane_offset = h.plane_offset
  o.kv_plane_bytes = h.plane_bytes
  o.kv_logits_bytes = h.logits_bytes
  o.kv_columns_persisted = h.columns_persisted
  o.kv_token_count = h.token_count
  o.kv_n_vocab = h.n_vocab
  o.kv_prefill_argmax = h.prefill_argmax
  o.kv_pack_total_bytes = h.pack_total_bytes
}

// Steps W1 to W4 of section 2.6, run only after step 10 has verified the prefill plane and only
// after the prefill's own logit vector has been digested. The whole container is assembled from
// values this process computed; nothing is read back, because a read-back of bytes written a
// microsecond ago proves this process's arithmetic and not the file — and this process's arithmetic
// is what `scripts/kv_plane_reader.py` checks independently, from the specification.
fn save_plane(
  destination: str,
  borrow g: layer_qwen2.Geometry,
  borrow tokens: model_forward.TokenColumns,
  borrow plane_view: slice<u8>,
  borrow logits_view: slice<u8>,
  borrow pack_digest: slice<u8>,
  borrow geometry_digest: slice<u8>,
  width: i64,
  prefill_argmax: i64,
  pack_total_bytes: i64,
  // R6-PREFIX-KEY section 2.6's step W5. `true` when this save is a **store miss** rather than a
  // `KV_SAVE`, and it changes exactly one thing: a create that fails reports `store[create]` — the
  // operand — instead of the mapped error name. The cause is not guessed, because `fs.create_rw`'s
  // failure at this pin cannot separate "no such directory", "that is a file", and "not writable"
  // (Request 53), and naming the operand is the discipline `R6_KV_IDENTITY`'s details already follow.
  store_mode: bool,
  borrow mut o: model_forward.Outcome,
) {
  mut ids: buffer := buffer(tokens.count * 4)
  mut at := 0
  loop {
    if at >= tokens.count { break }
    ids.put_u32_le(model_forward.column_at(tokens.ids, at) as u32)
    at = at + 1
  }
  ids_view := ids.bytes()
  if ids_view.len() != tokens.count * 4 {
    fail(o, "R4_WINDOW_UNAVAILABLE", "kv_tokens")
    return
  }
  h := kv_plane.plan_header(
    g.n_layer, g.n_head_kv, g.head_dim, width, tokens.count, g.n_vocab, prefill_argmax,
    pack_total_bytes)
  publish_header(h, o)
  if !h.ok {
    header_code: str := h.code
    header_detail: str := h.detail
    fail(o, header_code, header_detail)
    return
  }
  written := kv_plane.write_container(
    destination, h, pack_digest, geometry_digest, ids_view, logits_view, plane_view)
  o.kv_destination = written.destination
  o.kv_write_ns = written.write_ns
  o.kv_geometry_sha256 = encoding.hex_encode(geometry_digest)
  o.kv_source_sha256 = encoding.hex_encode(pack_digest)
  tokens_sha: str := written.tokens_sha256
  logits_sha: str := written.logits_sha256
  plane_sha: str := written.plane_sha256
  o.kv_tokens_sha256 = tokens_sha.clone()
  o.kv_logits_sha256 = logits_sha.clone()
  o.kv_plane_sha256 = plane_sha.clone()
  if written.failed {
    write_code: str := written.code
    write_detail: str := written.detail
    // W5. The create is the only failure that reaches W1 with the destination untouched, so the two
    // are distinguished by the outcome the writer reports rather than by a second probe.
    if store_mode && write_code == kv_plane.CODE_UNWRITABLE
      && written.destination == kv_plane.DESTINATION_UNTOUCHED {
      fail(o, write_code, "store[create]")
      return
    }
    // W5, second half (section 12, D16). `R6_KV_CLEANUP_FAILED` is the **only** writer code whose
    // detail is the destination itself (`kv_plane.align`'s W4 reports `bounded_detail(destination)`
    // so a `KV_SAVE` caller learns which file it must remove by hand). Under a store that
    // destination is the arm's own derived name, and section 2.7's "no path is published" governs a
    // refusal detail exactly as it governs a document field: a golden would otherwise become a
    // function of the caller's `STORE` directory. The operand replaces it, as `store[create]`
    // replaces the mapped error name above; the key is already published in `store.key`, so a
    // caller that wants the file it must remove forms `STORE + "/" + key + ".akvp"`.
    if store_mode && write_code == kv_plane.CODE_CLEANUP_FAILED {
      fail(o, write_code, "store[cleanup]")
      return
    }
    fail(o, write_code, write_detail)
    return
  }
  o.kv_verdict = kv_plane.VERDICT_SAVED
}

// Steps L1 to L14 of section 2.6, in order, cheapest first: a wrong file costs 384 bytes and one
// `fstat`, and the plane's 29 MB is read only once every field agrees.
//
// **The refill is chunked, and that is forced by the language.** Align's `buffer` is append-only
// and `f.pread` overwrites from index 0 and always requests the destination's whole capacity, so a
// short read cannot be resumed mid-buffer. The plane is read in `model_forward.CHUNK_BYTES` rounds
// through one transient that is refilled in place and **never rebound** (Request 39's measured
// cost), and each round crosses into the plane through `model_forward.window_put` — the bounded
// `memcpy` R5B added, Request 38's second consumer, with no new shim symbol.
//
// The tail read is short **by exactly the remaining bytes** rather than an over-read, and that is a
// proof rather than a hope: the plane is the container's last region and `f.len() == total_bytes`
// was established at L7 before this function reads a byte of it.
fn load_plane(
  source: str,
  borrow g: layer_qwen2.Geometry,
  borrow tokens: model_forward.TokenColumns,
  borrow plane_view: slice<u8>,
  borrow logits_view: slice<u8>,
  borrow pack_digest: slice<u8>,
  borrow geometry_digest: slice<u8>,
  width: i64,
  borrow mut state: Plane,
  borrow mut o: model_forward.Outcome,
) {
  started := time.instant()
  // L1.
  src := match fs.open_rw(source) {
    Ok(handle) => handle,
    Err(failure) => {
      fail(o, kv_plane.CODE_UNREADABLE, model_forward.error_name(failure))
      return
    },
  }
  // L2 to L7, inside the format owner.
  h := kv_plane.read_header(src)
  publish_header(h, o)
  if !h.ok {
    header_code: str := h.code
    header_detail: str := h.detail
    fail(o, header_code, header_detail)
    return
  }
  // L6's third part, taken here rather than inside `read_header` because it is the one reserved-space
  // rule that needs L7's validated offsets: section 2.3's region-order property 4 says every padding
  // byte is written and zero, and the five digests do not cover the gaps. The independent reader has
  // always enforced it; the arm enforces it too, because the property belongs to the format.
  if !kv_plane.padding_zero(src, h) {
    fail(o, kv_plane.CODE_RESERVED, "padding")
    return
  }
  // L8. The shape the file claims against the geometry this run loaded, field by field, so the
  // common mistake reports the field rather than an opaque digest mismatch.
  if h.n_layer != g.n_layer {
    fail(o, kv_plane.CODE_GEOMETRY, "n_layer")
    return
  }
  if h.n_head_kv != g.n_head_kv {
    fail(o, kv_plane.CODE_GEOMETRY, "n_head_kv")
    return
  }
  if h.head_dim != g.head_dim {
    fail(o, kv_plane.CODE_GEOMETRY, "head_dim")
    return
  }
  if h.n_vocab != g.n_vocab {
    fail(o, kv_plane.CODE_GEOMETRY, "n_vocab")
    return
  }
  derived := kv_plane.plane_bytes_for_shape(g.n_layer, g.n_head_kv, g.head_dim, h.kv_width)
  if h.plane_bytes != derived {
    fail(o, kv_plane.CODE_GEOMETRY, "plane_bytes")
    return
  }
  mut counters := alignpack_read.new_counters()
  mut record: buffer := buffer(0)
  take_pack(o, alignpack_read.read_exact(
      src, record, counters, kv_plane.CODE_UNREADABLE, h.identity_offset,
      kv_plane.IDENTITY_RECORD_BYTES))
  if o.code.len() > 0 { return }
  record_view := record.bytes()
  if record_view.len() != kv_plane.IDENTITY_RECORD_BYTES {
    fail(o, kv_plane.CODE_TRUNCATED, "identity")
    return
  }
  o.kv_source_sha256 = kv_plane.identity_hex(record_view, kv_plane.DIGEST_PACK)
  o.kv_geometry_sha256 = kv_plane.identity_hex(record_view, kv_plane.DIGEST_GEOMETRY)
  o.kv_tokens_sha256 = kv_plane.identity_hex(record_view, kv_plane.DIGEST_TOKENS)
  o.kv_logits_sha256 = kv_plane.identity_hex(record_view, kv_plane.DIGEST_LOGITS)
  o.kv_plane_sha256 = kv_plane.identity_hex(record_view, kv_plane.DIGEST_PLANE)
  // L6's second half: the identity record's own twenty-four reserved bytes.
  if !kv_plane.identity_reserved_ok(record_view) {
    fail(o, kv_plane.CODE_RESERVED, "identity_reserved")
    return
  }
  // L9. Model identity is the **pack's** header-region digest, not the GGUF's: `REFERENCE` is
  // optional and a load run may not have the model at all, so binding to an operand the caller did
  // not supply would make the identity unverifiable on the ordinary path.
  if !kv_plane.identity_matches(record_view, kv_plane.DIGEST_PACK, pack_digest) {
    fail(o, kv_plane.CODE_IDENTITY, "pack")
    return
  }
  pack_total := kv_plane.identity_pack_total_bytes(record_view)
  o.kv_pack_total_bytes = pack_total
  if pack_total != o.total_bytes {
    fail(o, kv_plane.CODE_IDENTITY, "pack_total_bytes")
    return
  }
  // L10.
  if !kv_plane.identity_matches(record_view, kv_plane.DIGEST_GEOMETRY, geometry_digest) {
    fail(o, kv_plane.CODE_IDENTITY, "geometry")
    return
  }
  // L11. R6's existing code, deliberately reused: the condition is "the plane is not the width this
  // run needs", and two codes for one condition is how two documents come to disagree about it.
  if h.kv_width != width {
    detail := kv_width_detail(h.kv_width, width)
    detail_view: str := detail
    fail(o, CODE_KV_WIDTH, detail_view)
    return
  }
  // L12. The ids the container carries, against the ids this run parsed, then the stream's digest.
  if h.token_count != tokens.count {
    fail(o, kv_plane.CODE_TOKENS, model_forward.labelled("count", h.token_count))
    return
  }
  mut stream: buffer := buffer(0)
  take_pack(o, alignpack_read.read_exact(
      src, stream, counters, kv_plane.CODE_UNREADABLE, h.token_stream_offset,
      h.token_stream_bytes))
  if o.code.len() > 0 { return }
  stream_view := stream.bytes()
  if stream_view.len() != h.token_stream_bytes {
    fail(o, kv_plane.CODE_TRUNCATED, "token_stream")
    return
  }
  mut index := 0
  loop {
    if index >= tokens.count { break }
    if kv_plane.token_at(stream_view, index) != model_forward.column_at(tokens.ids, index) {
      fail(o, kv_plane.CODE_TOKENS, kv_plane.int_text(index))
      return
    }
    index = index + 1
  }
  if !kv_plane.region_matches(stream_view, record_view, kv_plane.DIGEST_TOKENS) {
    fail(o, kv_plane.CODE_DIGEST, "tokens")
    return
  }
  // L13.
  if h.columns_persisted != h.token_count {
    detail := kv_columns_detail(h.columns_persisted, h.token_count)
    detail_view: str := detail
    fail(o, kv_plane.CODE_NPAST, detail_view)
    return
  }
  // L14. The two large regions, in one reused transient, digested **after** they land in this
  // frame's buffers — so the comparison covers the refill as well as the file.
  mut transient: buffer := buffer(model_forward.CHUNK_BYTES)
  if !refill(src, transient, logits_view, h.logits_offset, h.logits_bytes, "kv_logits", o) {
    return
  }
  if !kv_plane.region_matches(logits_view, record_view, kv_plane.DIGEST_LOGITS) {
    fail(o, kv_plane.CODE_DIGEST, "logits")
    return
  }
  loaded := model_forward.digest_region(logits_view)
  if loaded.argmax != h.prefill_argmax {
    fail(o, kv_plane.CODE_HEADER, "prefill_argmax")
    return
  }
  if !refill(src, transient, plane_view, h.plane_offset, h.plane_bytes, "kv_plane", o) {
    return
  }
  if !kv_plane.region_matches(plane_view, record_view, kv_plane.DIGEST_PLANE) {
    fail(o, kv_plane.CODE_DIGEST, "plane")
    return
  }
  o.reader_pread_count = o.reader_pread_count + counters.pread_count
  o.reader_bytes_read = o.reader_bytes_read + counters.bytes_read
  o.kv_read_ns = time.instant() - started
  o.kv_verdict = kv_plane.VERDICT_LOADED
  o.plane_source = PLANE_SOURCE_LOADED
  // The prefill's own two publications, made by the load instead: `layers` is a maximum over the
  // layers the plane holds and `columns_written` is the prefill's column count, both exactly what
  // `capture_plane` would have set had the prefill run.
  state.layers = g.n_layer
  state.columns_written = h.columns_persisted
}

// One region, moved from the container into a caller-owned view in `CHUNK_BYTES` rounds. `true` is
// "the whole region landed"; every other path has already named its code.
fn refill(
  borrow src: file,
  borrow mut transient: buffer,
  borrow destination: slice<u8>,
  offset: i64,
  bytes: i64,
  label: str,
  borrow mut o: model_forward.Outcome,
) -> bool {
  if bytes < 0 || destination.len() != bytes {
    fail(o, kv_plane.CODE_TRUNCATED, label)
    return false
  }
  mut copied := 0
  loop {
    if copied >= bytes { break }
    count := match src.pread(transient, offset + copied) {
      Ok(value) => value,
      Err(failure) => {
        fail(o, kv_plane.CODE_UNREADABLE, model_forward.error_name(failure))
        return false
      },
    }
    if count <= 0 {
      fail(o, kv_plane.CODE_TRUNCATED, label)
      return false
    }
    view := transient.bytes()
    remaining := bytes - copied
    take := if count > remaining { remaining } else { count }
    if view.len() < take {
      fail(o, kv_plane.CODE_TRUNCATED, label)
      return false
    }
    piece := view[0..take]
    take_pack(o, model_forward.window_put(destination, copied, piece, take, label))
    if o.code.len() > 0 { return false }
    copied = copied + take
  }
  return true
}

// ---------------------------------------------------------------------------------------------
// Oracle A — the decode transcript (section 3.3)
//
// `llama-eval-callback -n N` emits exactly `N + 1` graphs and every node name repeats across them,
// so the scan is told how many to skip. R6-STEP-N section 3.1 measured the counting and it is exact:
// graph `j` (`j = 2 .. N+1`) consumes `d_{j-1}`, and this arm's step `k` consumes `d_k`, so **this
// arm's `N` decode graphs are llama.cpp's graphs 2 through `N+1`, one for one** and step `k` skips
// `k` graphs. Comparing our decode graph against llama.cpp's prefill graph, or against the wrong
// decode graph, would agree on the nodes that do not depend on the KV cache and could still report
// `PASS`; `instrument_graph == k + 1` is published per step so that a reader does not have to take
// the alignment on trust.
//
// Coverage is R5B's, unchanged: nineteen rows per layer plus the head's two and the embedding's one,
// of which `kq-L` and `kq_soft_max-L` are matched, shape-checked against `KV_WIDTH`, and excluded
// from element comparison because the instrument prints their axes ambiguously. The decode table's
// two identity narrowing rows are excluded **by construction** — no oracle row names them — because
// llama.cpp's decode graph has no narrowing at all and a row with no counterpart cannot be compared.
// ---------------------------------------------------------------------------------------------

fn prepare_decode_transcript(
  transcript_path: str,
  borrow oracle: layer_qwen2.OracleTable,
  n_layer: i64,
  kv_width: i64,
  step: i64,
  borrow mut scan: layer_forward.TranscriptScan,
  borrow mut ranges: model_forward.OracleRanges,
  borrow mut o: model_forward.Outcome,
) {
  started := time.instant()
  scan = layer_forward.scan_transcript_after(transcript_path, oracle, step)
  o.oracle_lines = scan.line_count
  o.oracle_callback_lines = scan.callback_line_count
  o.oracle_expected = 1 + 17 * n_layer + layer_qwen2.MF_HEAD_ORACLE_COUNT
  if scan.code.len() > 0 {
    detail_view: str := scan.detail
    fail(o, CODE_TRANSCRIPT, detail_view)
    o.oracle_ns = time.instant() - started
    return
  }
  mut starts := model_forward.zero_column(oracle.count)
  mut lengths := model_forward.zero_column(oracle.count)
  mut element := 0
  loop {
    if element >= scan.element_node.len() { break }
    row := scan.element_node[element]
    if lengths[row] == 0 { starts[row] = element }
    lengths[row] = lengths[row] + 1
    element = element + 1
  }
  ranges = model_forward.OracleRanges { start: starts, length: lengths }
  check_decode_coverage(oracle, ranges, scan, n_layer, kv_width, o)
  if o.code.len() == 0 { o.oracle_layers_matched = n_layer }
  o.oracle_layers_expected = n_layer
  o.oracle_ns = o.oracle_ns + (time.instant() - started)
}

// R6-STEP-N section 3.4. Oracle A' is **per step**, so its accumulators are per step: the loop zeroes
// them before each step, reads the step's own numbers out afterwards, and folds them into the
// aggregate `oracle_decode` publishes. Without this, `max_abs` would be a maximum over the whole run
// reported as though it belonged to every step, and `elements_compared > 0` — the specific guard
// against a comparison that passes because it compared nothing — could be satisfied at step 7 by
// work step 1 did.
fn reset_step_oracle(borrow mut o: model_forward.Outcome) {
  o.oracle_matched = 0
  o.oracle_elements = 0
  o.oracle_max_abs = 0
  o.oracle_max_sum = 0
  o.oracle_worst_layer = -1
  o.oracle_worst_node = "".clone()
  o.oracle_worst_element = -1
  o.oracle_layers_matched = 0
  o.oracle_layers_expected = 0
  o.oracle_expected = 0
}

// The three structural rules, in R5B's order and with R6's codes. Step 14 of section 2.8 is the
// second of them: the transcript's own `kq` `ne0` **is** the instrument's reduction width, and it is
// validated against the operand rather than read as one. An oracle that configures the thing it
// verifies is the one property no amount of downstream checking repairs.
fn check_decode_coverage(
  borrow oracle: layer_qwen2.OracleTable,
  borrow ranges: model_forward.OracleRanges,
  borrow scan: layer_forward.TranscriptScan,
  n_layer: i64,
  kv_width: i64,
  borrow mut o: model_forward.Outcome,
) {
  mut row := 0
  loop {
    if row >= oracle.count || o.code.len() > 0 { break }
    id := layer_qwen2.oracle_id(oracle, row)
    layer := model_forward.oracle_layer_of(n_layer, row)
    if scan.matched[row] == 0 {
      fail(o, CODE_ORACLE_MISSING, model_forward.layer_named(layer, "node", id))
      break
    }
    if oracle.compared[row] == 0 && scan.ne0[row] != kv_width {
      fail(o, CODE_KV_WIDTH, model_forward.layer_named(layer, "node", id))
      break
    }
    if oracle.compared[row] == 1 {
      expected := model_forward.printed_count(scan.ne0[row])
        * model_forward.printed_count(scan.ne1[row])
        * model_forward.printed_count(scan.ne2[row])
        * model_forward.printed_count(scan.ne3[row])
      if ranges.length[row] != expected {
        fail(o, CODE_ORACLE_MISSING, model_forward.layer_named(layer, "node", id))
        break
      }
    }
    row = row + 1
  }
}

// ---------------------------------------------------------------------------------------------
// The decoded token's embedding row
//
// The prefill's embedding window holds only the `T` rows the prompt needs, gathered at `0 .. T-1`;
// the decoded token's row is not among them, and it cannot be, because it is not known until the
// prefill's head has run. The decode pass refills the window with exactly one row — the argmax's —
// and its graph gathers row 0 of it. This is the whole reason section 2.6 splits token ids from
// positions: the row index here is 0 and the position is `n_past`.
// ---------------------------------------------------------------------------------------------

fn decode_embed_members(
  borrow g: layer_qwen2.Geometry, borrow e: model_forward.Ends, token: i64,
) -> model_forward.GraphMembers {
  names := builder()
  names.write("token_embd")
  mut name_start: array_builder<i64> := array_builder()
  mut name_end: array_builder<i64> := array_builder()
  mut kind: array_builder<i64> := array_builder()
  mut ne0: array_builder<i64> := array_builder()
  mut rows: array_builder<i64> := array_builder()
  mut nbytes: array_builder<i64> := array_builder()
  mut window: array_builder<i64> := array_builder()
  mut dims: array_builder<i64> := array_builder()
  mut source: array_builder<i64> := array_builder()
  mut pack: array_builder<i64> := array_builder()
  mut pieces: array_builder<i64> := array_builder()
  mut stride: array_builder<i64> := array_builder()
  name_start.push(0)
  name_end.push(10)
  kind.push(e.embed_type)
  ne0.push(g.n_embd)
  rows.push(1)
  nbytes.push(e.row_bytes)
  window.push(0)
  dims.push(2)
  source.push(e.embed_source + token * e.row_bytes)
  pack.push(e.embed_pack_offset + token * e.row_bytes)
  pieces.push(1)
  stride.push(e.row_bytes)
  return model_forward.GraphMembers {
    count: 1,
    names: names.to_string(),
    name_start: name_start.build(),
    name_end: name_end.build(),
    ggml_type: kind.build(),
    ne0: ne0.build(),
    rows: rows.build(),
    nbytes: nbytes.build(),
    window: window.build(),
    n_dims: dims.build(),
    source: source.build(),
    pack: pack.build(),
    pieces: pieces.build(),
    stride: stride.build(),
    gathered: false,
  }
}

// ---------------------------------------------------------------------------------------------
// Steps 3 to 6 of section 2.8
//
// Strictly ordered, each running only if every earlier one passed. `KV_WIDTH` is fail-closed and has
// no default, exactly as `--model-forward`'s is and for the same reason: it is what makes the
// comparison against the transcript meaningful. Its lower bound is `T + 1` and not `T`, because the
// decode step's own column has to fit.
// ---------------------------------------------------------------------------------------------

fn stage_inputs(
  tokens_text: str,
  suffix_text: str,
  width_text: str,
  steps_text: str,
  geometry_path: str,
  expected_geometry: str,
  generation: bool,
  kv_requested: bool,
  max_steps: i64,
  borrow mut tokens: model_forward.TokenColumns,
  borrow mut o: model_forward.Outcome,
) -> layer_qwen2.Geometry {
  mut g := layer_qwen2.empty_geometry()
  lexical := layer_forward.parse_tokens(tokens_text, 9223372036854775807)
  if !lexical.ok {
    detail_view: str := lexical.detail
    fail(o, CODE_TOKENS, detail_view)
    return g
  }
  // Step 3b (R6-STEP-N section 2.7). `STEPS` is decided **before** `KV_WIDTH`, because `N` must be a
  // number before `T + N` is one; with both invalid the code is `R6_STEPS`. The plane bound
  // `T + N <= KV_WIDTH` is step 6's and raises `R6_KV_WIDTH`, not this code: the condition there is
  // "the plane is too narrow for this run", and R6 already owns that sentence.
  steps := model_forward.parse_index(steps_text)
  if steps < 0 {
    unparsed := steps_detail(steps_text)
    unparsed_view: str := unparsed
    fail(o, CODE_STEPS, unparsed_view)
    return g
  }
  if steps < 1 || steps > max_steps {
    ranged := steps_detail_int(steps)
    ranged_view: str := ranged
    fail(o, CODE_STEPS, ranged_view)
    return g
  }
  o.decode_steps_requested = steps
  // Step 3c (R6-PREFIX-SUFFIX-PREFILL section 2.7). `SUFFIX` parses in **`TOKENS`'s own grammar**,
  // through the same `parse_tokens`, so the two operands cannot drift apart in what they accept.
  // It is decided after `STEPS` and before `KV_WIDTH`, and after step 3 because `T_prefix` must be
  // a number before `T_prefix + S` is one.
  //
  // The cap is on the **sequence** and not on `S`, and the cap is the **oracle's**: oracle C''
  // runs `--model-forward` at `TOKENS,SUFFIX`, so a cap on `S` alone would let this arm accept a
  // run whose own acceptance oracle it refuses. The refusal names `R6_SUFFIX` rather than
  // `R6_TOKENS` because on a suffix run `TOKENS` is pinned by the container it must match and
  // `SUFFIX` is the only operand a caller can shorten.
  if o.suffix_requested {
    lexical_suffix := layer_forward.parse_tokens(suffix_text, 9223372036854775807)
    if !lexical_suffix.ok {
      // The **operand**, not `parse_tokens`' index: `suffix[<text>]` names the thing the caller
      // wrote, bounded to 256 bytes, which is `RESIDENT`'s precedent and is what makes an
      // unparseable list, an empty one, and a trailing separator one refusal a caller can act on.
      unparsed := suffix_detail(suffix_text)
      unparsed_view: str := unparsed
      fail(o, CODE_SUFFIX, unparsed_view)
      return g
    }
    // R6-PREFIX-SUFFIX-PREFILL section 2.3's fifth refusal is **gone**, lifted by
    // MF-SINGLE-TOKEN-LOGITS (roadmap item 36). That capability required `T_prefix >= 2` and raised
    // `R6_SUFFIX prefix[<n>]` for one reason: a one-token prefill computed the embedding of token 0
    // whatever `TOKENS` said, so a container saved for a one-token prefix held the wrong plane and
    // oracle S's equality would silently not have held. `model_forward.fill_members` and
    // `compare_source` now gather by `tokens.ids[piece]` on the embedding member whatever the count,
    // so a one-token prefix is an ordinary prefix and `ds-suffix-prefix-one` is a passing oracle-S
    // row. Nothing replaces the check: the sequence cap below is the only bound on `T_prefix`.
    sequence := lexical.count + lexical_suffix.count
    if sequence > layer_qwen2.MAX_PREFILL_TOKENS {
      ranged := model_forward.labelled("sequence", sequence)
      ranged_view: str := ranged
      fail(o, CODE_SUFFIX, ranged_view)
      return g
    }
    o.suffix_token_count = lexical_suffix.count
    o.suffix_n_past_base = lexical.count
    o.suffix_first_column = lexical.count
    o.suffix_sequence_length = sequence
  }
  geometry_text := match fs.read_file(geometry_path) {
    Ok(value) => value,
    Err(failure) => {
      fail(o, CODE_GEOMETRY_UNREADABLE, model_forward.error_name(failure))
      return g
    },
  }
  geometry_view: str := geometry_text
  if generation && geometry_view != expected_geometry {
    fail(o, CODE_GEOMETRY, "identity")
    return g
  }
  g = layer_qwen2.parse_geometry(geometry_view)
  o.arch = g.arch.clone()
  o.n_layer = g.n_layer
  o.n_embd = g.n_embd
  o.n_head = g.n_head
  o.n_head_kv = g.n_head_kv
  o.head_dim = g.head_dim
  o.n_ff = g.n_ff
  o.n_vocab = g.n_vocab
  o.context_length = g.context_length
  o.rms_eps_bits = g.rms_eps_bits
  o.rope_type = g.rope_type
  o.rope_dim_count = g.rope_dim_count
  o.rope_freq_base_bits = g.rope_freq_base_bits
  o.attn_scale_bits = g.attn_scale_bits
  if g.code.len() > 0 {
    detail_view: str := g.detail
    // Step 5. `src/layer_qwen2.align` refuses a routed container by design and names the field it
    // refused on, so the routed case is separated here rather than re-derived: OLMoE is a declared
    // non-goal of section 1.3 and it deserves a code that says so.
    if detail_view == "n_expert" {
      fail(o, CODE_ARCH, detail_view)
    } else {
      fail(o, CODE_GEOMETRY, detail_view)
    }
    return g
  }
  parsed := layer_forward.parse_tokens(tokens_text, g.n_vocab)
  if !parsed.ok {
    detail_view: str := parsed.detail
    fail(o, CODE_TOKENS, detail_view)
    return g
  }
  // Step 3', now over both lists. `SUFFIX` is re-checked against the **real** `n_vocab` in the same
  // pass `TOKENS` is, and reports `parse_tokens`' own `token[<index>]` under this capability's code
  // — the same shape `R6_TOKENS` reports and for the same reason.
  suffix_count := if o.suffix_requested {
    checked_suffix := layer_forward.parse_tokens(suffix_text, g.n_vocab)
    if !checked_suffix.ok {
      detail_view: str := checked_suffix.detail
      fail(o, CODE_SUFFIX, detail_view)
      return g
    }
    checked_suffix.count
  } else {
    0
  }
  // Step 6, generalised twice. At `N = 1` and no suffix the bound is R6's `T + 1 <= KV_WIDTH`,
  // character for character. This **widens an existing condition** rather than adding one: two
  // codes for "the plane is too narrow for this run" is how two documents come to disagree about it.
  width := model_forward.parse_index(width_text)
  if width < parsed.count + suffix_count + steps || width > layer_qwen2.MAX_ATTENTION_WIDTH {
    fail(o, CODE_KV_WIDTH, model_forward.labelled("kv_width", width))
    return g
  }
  // Step 6a (R6-KV-PERSIST section 2.5). The persisted-and-digested bounds, checked **before the
  // pack is opened and long before a prefill runs**, so a caller who asks for an unpersistable
  // configuration learns it in milliseconds rather than after paying for a prefill. It refuses
  // rather than skipping the digest: a persisted artifact whose identity cannot be computed is not
  // an identity, and the one thing the digest exists to catch — a torn write — would go undetected.
  if kv_requested {
    planned := kv_plane.plan_header(
      g.n_layer, g.n_head_kv, g.head_dim, width, parsed.count, g.n_vocab, 0, 0)
    plane_bytes := kv_plane.plane_bytes_for_shape(g.n_layer, g.n_head_kv, g.head_dim, width)
    logits_bytes := kv_plane.mul_checked(g.n_vocab, 4)
    if plane_bytes < 0 || plane_bytes > kv_plane.MAX_KV_PLANE_BYTES {
      fail(o, kv_plane.CODE_TOO_LARGE, model_forward.labelled("plane", plane_bytes))
      return g
    }
    if logits_bytes < 0 || logits_bytes > kv_plane.MAX_KV_LOGITS_BYTES {
      fail(o, kv_plane.CODE_TOO_LARGE, model_forward.labelled("logits", logits_bytes))
      return g
    }
    if !planned.ok || planned.total_bytes > kv_plane.MAX_KV_CONTAINER_BYTES {
      fail(o, kv_plane.CODE_TOO_LARGE, model_forward.labelled("container", planned.total_bytes))
      return g
    }
  }
  mut ids: array_builder<i64> := array_builder()
  mut copy_at := 0
  loop {
    if copy_at >= parsed.count { break }
    ids.push(parsed.ids[copy_at])
    copy_at = copy_at + 1
  }
  o.token_count = parsed.count
  o.narrow_layer = g.n_layer - 1
  o.narrow_index = parsed.count - 1
  o.attention_width = parsed.count
  o.reconciliation_width = width
  tokens = model_forward.TokenColumns { count: parsed.count, ids: ids.build() }
  return g
}

// ---------------------------------------------------------------------------------------------
// The decode pass (steps 11 and 12 of section 2.8)
//
// One embedding gather for the decoded token, `n_layer` decode layer graphs, and the head. Each
// layer stages its own past K and past V out of the plane — the two transposes above — uploads them
// with `slot_set`, and, after compute, reads back the two `CONCAT` operands and compares their past
// columns to the plane byte for byte.
//
// The staging buffers are allocated inside the loop on purpose. Align's `buffer` is append-only, so
// a window that is written once cannot be rewritten; a fresh reservation per layer is 12 KiB on the
// real model at width 256 and is freed at the iteration's end, which is cheaper than the machinery a
// reusable one would need and impossible to get wrong.
// ---------------------------------------------------------------------------------------------

fn decode_pass(
  borrow pak: file,
  device: raw,
  backend: raw,
  resident_buffer: raw,
  context_bytes: i64,
  borrow g: layer_qwen2.Geometry,
  borrow ends: model_forward.Ends,
  borrow table: layer_qwen2.MemberTable,
  borrow plan: model_forward.Plan,
  borrow tokens: model_forward.TokenColumns,
  borrow head_members: model_forward.GraphMembers,
  borrow window: slice<u8>,
  borrow layout: model_forward.ResidentLayout,
  resident: bool,
  borrow slot_view: slice<u8>,
  borrow ids_view: slice<u8>,
  borrow pos_view: slice<u8>,
  borrow mask_view: slice<u8>,
  borrow out_ids_view: slice<u8>,
  borrow residual_view: slice<u8>,
  borrow logits_view: slice<u8>,
  borrow node_view: slice<u8>,
  borrow plane_view: slice<u8>,
  borrow oracle: layer_qwen2.OracleTable,
  borrow embed_nodes: layer_qwen2.NodeTable,
  borrow decode_nodes: layer_qwen2.NodeTable,
  borrow head_nodes: layer_qwen2.NodeTable,
  borrow scan: layer_forward.TranscriptScan,
  borrow starts: array<i64>,
  borrow lengths: array<i64>,
  token_id: i64,
  n_past: i64,
  // R6-PREFIX-SUFFIX-PREFILL section 2.6. The columns this pass computes: `1` for a decode step,
  // `S` for the suffix pass. The **whole** difference between the two is this number, the ids and
  // positions the caller supplies, and which embedding-member builder the line below picks.
  tokens_in: i64,
  // `true` for the one suffix pass, `false` for every decode step. It selects nothing about the
  // graph — `tokens_in` does that — and exists only so the pass's pack reads land in
  // `suffix.pack_bytes` instead of `weights.step_pack_bytes`, which R6-RESIDENT-WEIGHTS section 3.4
  // defines as "the pack bytes the decode **steps** alone read".
  suffix_pass: bool,
  width: i64,
  stride: i64,
  borrow mut breach: bool,
  borrow mut activation: array_builder<i64>,
  borrow mut state: Plane,
  borrow mut decoded: Decode,
  borrow mut o: model_forward.Outcome,
) {
  mut transient: buffer := buffer(model_forward.CHUNK_BYTES)
  mut counters := alignpack_read.new_counters()
  past_bytes := n_past * g.n_head_kv * g.head_dim * 4
  // The seam R6-PREFIX-SUFFIX-PREFILL section 4.4 owns: the suffix pass takes the **prefill's**
  // embedding-member builder and the **decode's** layer node table. `decode_embed_members` gathers
  // one row and would produce a shape error at `S > 1`; the prefill's layer table would compute the
  // right shapes at the wrong positions and produce a plausible wrong number.
  //
  // At `tokens_in == 1` the decode builder is kept for **both** callers. It was originally kept
  // because `model_forward.fill_members` gathered by `tokens.ids[piece]` only when `pieces > 1`;
  // MF-SINGLE-TOKEN-LOGITS (roadmap item 36) removed that, so the two builders now agree byte for
  // byte at one row and the branch is a specialization rather than a correction. It stays because a
  // suffix of one token **is** the decode step's own single-row window, whose graph gathers row 0 —
  // exactly what `[0 .. S-1]` is at `S = 1` — and one builder for that shape is one thing to read.
  embed_members := if tokens_in > 1 {
    model_forward.build_embed_members(g, ends, tokens_in)
  } else {
    decode_embed_members(g, ends, token_id)
  }
  embed_base := layout.base[0]
  embed_view := window[embed_base..embed_base + layout.span[0]]
  if resident && tokens_in > 1 {
    // The prefill's own staging loop, at `S` rows: `S` host copies out of the resident table and
    // **zero pack bytes**, which is why `suffix.pack_bytes` is exactly 0 on the resident leg.
    mut piece := 0
    loop {
      if piece >= tokens_in || o.code.len() > 0 { break }
      take_pack(o, model_forward.stage_embed_row(
          window, layout.table_at, embed_base, layout.span[0], embed_members.stride[0], g.n_vocab,
          tokens.ids[piece], piece))
      piece = piece + 1
    }
  } else if resident {
    // Section 3.3, and the whole claim: one 2,016-byte host copy out of the resident table, and
    // **zero pack bytes** for this step's embedding row.
    // `embed_members.stride[0]` and not `ends.row_bytes`: the two are the same number by
    // construction, and this is the stride of the member the graph is about to read, which is the
    // one the copy has to agree with. The prefill's own call below uses the same source.
    take_pack(o, model_forward.stage_embed_row(
        window, layout.table_at, embed_base, layout.span[0], embed_members.stride[0], g.n_vocab,
        token_id, 0))
  } else {
    take_pack(
      o, model_forward.fill_members(pak, embed_members, tokens, embed_view, transient, counters))
  }
  if o.code.len() > 0 { return }
  o.window_reuse_count = o.window_reuse_count + 1
  // R6-PREFIX-SUFFIX-PREFILL section 3.6. **The suffix pass compares against no transcript, and
  // this is a declared absence rather than an omission.** The R2C-patched `llama-eval-callback`
  // computes one prefill graph for the whole prompt and then `N` decode graphs; it has no way to be
  // told "prefill these `T_prefix` tokens, stop, then prefill these `S` more", because that needs a
  // KV cache persisted across two invocations and its CLI has no operand for one. So the pass's
  // three specs carry `compare = false` and its scan is never consulted — and what replaces oracle
  // A' is not weaker in the dimension that matters: the pass's logits are compared byte for byte
  // against `--model-forward`, against the single-shot `--decode-step`, and against
  // `llama-debug --save-logits`.
  compare := !suffix_pass
  mut embed_result := model_forward.empty_graph_result()
  spec := model_forward.spec_for(
    model_forward.GRAPH_EMBED, 0, -1, tokens_in, width, false, false, 0, 1,
    layer_qwen2.mf_embed_output_slot(), false, compare, g.n_embd)
  run_step_graph(
    device, backend, resident_buffer, context_bytes, spec, g, embed_members, embed_nodes, oracle,
    embed_view, slot_view,
    residual_view, ids_view, pos_view, mask_view, out_ids_view, plane_view, plane_view, node_view,
    residual_view, plane_view, scan, starts, lengths, true, false, n_past, stride, breach, state,
    embed_result, o)
  account(embed_result, false, activation, o)
  decoded.node_count = decoded.node_count + embed_result.node_count
  decoded.compute_ns = decoded.compute_ns + embed_result.compute_ns
  if decoded.slot_high_water < embed_result.slot_high_water {
    decoded.slot_high_water = embed_result.slot_high_water
  }
  mut layer := 0
  loop {
    if layer >= g.n_layer || o.code.len() > 0 { break }
    members := model_forward.build_layer_members(table, plan, layer)
    layer_base := layout.base[1 + layer]
    layer_view := window[layer_base..layer_base + layout.span[1 + layer]]
    read_started := time.instant()
    if !resident {
      take_pack(
        o, model_forward.fill_members(pak, members, tokens, layer_view, transient, counters))
    }
    o.pread_ns = o.pread_ns + (time.instant() - read_started)
    o.window_reuse_count = o.window_reuse_count + 1
    if o.code.len() > 0 { break }
    mut stage_k: buffer := buffer(past_bytes)
    mut stage_v: buffer := buffer(past_bytes)
    upload_started := time.instant()
    stage_past_k(
      stage_k, plane_view, plane_k_offset(stride, layer), g.head_dim, g.n_head_kv, n_past)
    stage_past_v(
      stage_v, plane_view, plane_v_offset(stride, layer), g.head_dim, g.n_head_kv, n_past)
    state.upload_ns = state.upload_ns + (time.instant() - upload_started)
    past_k_view := stage_k.bytes()
    past_v_view := stage_v.bytes()
    if past_k_view.len() != past_bytes || past_v_view.len() != past_bytes {
      fail(o, CODE_PLANE_UNAVAILABLE, plane_detail(layer, "stage"))
      break
    }
    last := layer == g.n_layer - 1
    mut result := model_forward.empty_graph_result()
    layer_spec := model_forward.spec_for(
      model_forward.GRAPH_LAYER, 1 + layer, layer, tokens_in, width, last, false,
      layer_qwen2.mf_oracle_layer_base(layer), layer_qwen2.MF_LAYER_ORACLE_COUNT,
      layer_qwen2.mf_decode_layer_output_slot(), false, compare, g.n_embd)
    run_step_graph(
      device, backend, resident_buffer, context_bytes, layer_spec, g, members, decode_nodes,
      oracle, layer_view,
      slot_view, residual_view, ids_view, pos_view, mask_view, out_ids_view, past_k_view,
      past_v_view, node_view, residual_view, plane_view, scan, starts, lengths, true, false,
      n_past, stride, breach, state, result, o)
    account(result, false, activation, o)
    decoded.node_count = decoded.node_count + result.node_count
    decoded.compute_ns = decoded.compute_ns + result.compute_ns
    if decoded.slot_high_water < result.slot_high_water {
      decoded.slot_high_water = result.slot_high_water
    }
    if o.ggml_buffers_created != o.ggml_buffers_freed || o.contexts_created != o.contexts_freed
      || o.gallocrs_created != o.gallocrs_freed {
      o.graph_balance_failures = o.graph_balance_failures + 1
    }
    layer = layer + 1
  }
  if o.code.len() > 0 { return }
  head_base := layout.base[1 + g.n_layer]
  head_view := window[head_base..head_base + layout.span[1 + g.n_layer]]
  read_started := time.instant()
  if !resident {
    take_pack(
      o, model_forward.fill_members(pak, head_members, tokens, head_view, transient, counters))
  }
  o.pread_ns = o.pread_ns + (time.instant() - read_started)
  o.window_reuse_count = o.window_reuse_count + 1
  if o.code.len() > 0 { return }
  mut head_result := model_forward.empty_graph_result()
  head_spec := model_forward.spec_for(
    model_forward.GRAPH_HEAD, 1 + g.n_layer, g.n_layer, 1, width, false, false,
    layer_qwen2.mf_oracle_head_base(g.n_layer), layer_qwen2.MF_HEAD_ORACLE_COUNT,
    layer_qwen2.mf_head_output_slot(), false, compare, g.n_embd)
  run_step_graph(
    device, backend, resident_buffer, context_bytes, head_spec, g, head_members, head_nodes,
    oracle, head_view,
    slot_view, residual_view, ids_view, pos_view, mask_view, out_ids_view, plane_view, plane_view,
    node_view, logits_view, plane_view, scan, starts, lengths, true, false, n_past, stride, breach,
    state, head_result, o)
  account(head_result, false, activation, o)
  decoded.node_count = decoded.node_count + head_result.node_count
  decoded.compute_ns = decoded.compute_ns + head_result.compute_ns
  if decoded.slot_high_water < head_result.slot_high_water {
    decoded.slot_high_water = head_result.slot_high_water
  }
  decoded.graph_count = decoded.graph_count + g.n_layer + 2
  if o.code.len() > 0 { return }
  if head_result.out_bytes != g.n_vocab * 4 {
    fail(o, "R5_RESIDUAL", model_forward.labelled("layer", g.n_layer))
    return
  }
  digest := model_forward.digest_region(logits_view)
  decoded.sha256 = digest.sha.clone()
  decoded.bit_sum = digest.bit_sum
  decoded.element_count = g.n_vocab
  decoded.nonfinite_count = digest.nonfinite
  decoded.argmax = digest.argmax
  o.reader_pread_count = o.reader_pread_count + counters.pread_count
  o.reader_bytes_read = o.reader_bytes_read + counters.bytes_read
  // R6-RESIDENT-WEIGHTS section 3.4's **primary metric**: the pack bytes the decode steps alone
  // read, accumulated here because this function is the only place a decode step reads the pack.
  // It is a counter and not a clock, it is identical across runs, and in resident mode it is
  // exactly zero. The suffix pass keeps its own counter for the same reason (section 2.10).
  if suffix_pass {
    o.suffix_pack_bytes = o.suffix_pack_bytes + counters.bytes_read
  } else {
    o.step_pack_bytes = o.step_pack_bytes + counters.bytes_read
  }
}

// ---------------------------------------------------------------------------------------------
// The decode loop (step 11' of R6-STEP-N section 2.7)
//
// `N` greedy steps over one plane. Three things depend on `n_past` and are therefore rebuilt at each
// step — the node table, the offset mask, and the position image — and everything else is built once
// and reused. The embedding row is a fourth per-step object and it is a pack read, which is where
// this loop's `O(N x model bytes)` cost lives; section 6 risk 1 measures it rather than hiding it.
//
// `decode_ids_image` is deliberately **not** per step. It is the row index into the gathered
// embedding window and the window holds exactly one row: the token changes, the row index does not.
// That is R6 section 2.6's id/position split doing its job, and it is why the loop needs no fourth
// per-step input.
//
// The per-step results are a **column set** rather than `Outcome` fields, for R6 section 10.6's
// reason: `model_forward.Outcome` is 1,608 bytes at this head — R6 recorded 1,328, R6-STEP-N
// section 2.9's seven loop scalars add 56, and R6-KV-PERSIST section 2.8's `kv` object and
// `plane.source` add 224 — and it is passed by value at some twenty-five call sites, so `N`
// per-step scalars would make it grow with an operand.
fn generation_eog(borrow ids: array<i64>, token: i64) -> bool {
  mut at := 0
  loop {
    if at >= ids.len() { break }
    if ids[at] == token { return true }
    at = at + 1
  }
  return false
}

fn decode_loop(
  borrow pak: file,
  device: raw,
  backend: raw,
  resident_buffer: raw,
  context_bytes: i64,
  borrow g: layer_qwen2.Geometry,
  borrow ends: model_forward.Ends,
  borrow table: layer_qwen2.MemberTable,
  borrow plan: model_forward.Plan,
  borrow tokens: model_forward.TokenColumns,
  borrow head_members: model_forward.GraphMembers,
  borrow window: slice<u8>,
  borrow layout: model_forward.ResidentLayout,
  resident: bool,
  borrow slot_view: slice<u8>,
  borrow ids_view: slice<u8>,
  borrow pos_all: slice<u8>,
  borrow mask_all: slice<u8>,
  borrow out_ids_view: slice<u8>,
  borrow residual_view: slice<u8>,
  borrow logits_view: slice<u8>,
  borrow node_view: slice<u8>,
  borrow plane_view: slice<u8>,
  borrow oracle: layer_qwen2.OracleTable,
  borrow embed_nodes: layer_qwen2.NodeTable,
  borrow head_nodes: layer_qwen2.NodeTable,
  transcript_path: str,
  first_token: i64,
  first_n_past: i64,
  steps: i64,
  generation: bool,
  borrow eog_ids: array<i64>,
  generation_max: i64,
  width: i64,
  stride: i64,
  origin: i64,
  borrow mut breach: bool,
  borrow mut activation: array_builder<i64>,
  borrow mut state: Plane,
  borrow mut decoded: Decode,
  borrow mut o: model_forward.Outcome,
) -> model_forward.StepColumns {
  mut digests: array_builder<string> := array_builder()
  mut worst_names: array_builder<string> := array_builder()
  mut n_past_column: array_builder<i64> := array_builder()
  mut token_column: array_builder<i64> := array_builder()
  mut argmax_column: array_builder<i64> := array_builder()
  mut bit_column: array_builder<i64> := array_builder()
  mut element_column: array_builder<i64> := array_builder()
  mut nonfinite_column: array_builder<i64> := array_builder()
  mut compute_column: array_builder<i64> := array_builder()
  mut node_column: array_builder<i64> := array_builder()
  mut plane_column: array_builder<i64> := array_builder()
  mut verdict_column: array_builder<i64> := array_builder()
  mut max_abs_column: array_builder<i64> := array_builder()
  mut max_sum_column: array_builder<i64> := array_builder()
  mut elements_column: array_builder<i64> := array_builder()
  mut matched_column: array_builder<i64> := array_builder()
  mut expected_column: array_builder<i64> := array_builder()
  mut layers_column: array_builder<i64> := array_builder()
  mut graph_column: array_builder<i64> := array_builder()
  mut worst_layer_column: array_builder<i64> := array_builder()
  mut aggregate_max_abs := 0
  mut aggregate_max_sum := 0
  mut aggregate_elements := 0
  mut aggregate_matched := 0
  mut aggregate_expected := 0
  mut aggregate_layers := 0
  mut aggregate_worst_layer := -1
  mut aggregate_worst_element := -1
  mut aggregate_worst_node: string := "".clone()
  mut worst_unset := true
  mut aggregate_verdict := model_forward.ORACLE_ABSENT
  mut any_breach := false
  mut token := first_token
  mut step := 1
  loop {
    if o.code.len() > 0 { break }
    if generation {
      // `first_token` is generated id 1. Step `k` consumes generated id `k` and produces id
      // `k + 1`, so the maximum is reached before step `generation_max`, and EOG is classified
      // before another graph can consume it.
      if step >= generation_max || generation_eog(eog_ids, token) { break }
    } else if step > steps {
      break
    }
    n_past := first_n_past + step - 1
    // Oracle A' selects transcript graph `k + 1` by skipping `k`. The rescan is `O(N x file)` and is
    // accepted and measured (section 6 risk 3): the alternative holds `N` graphs' element ranges in
    // memory and is a new data structure for a cost measured in seconds.
    reset_step_oracle(o)
    breach = false
    mut scan := layer_forward.empty_transcript_scan()
    mut ranges := model_forward.empty_ranges()
    if o.transcript_present {
      prepare_decode_transcript(transcript_path, oracle, g.n_layer, width, step, scan, ranges, o)
    }
    if o.code.len() > 0 {
      prefix_step(o, step)
      break
    }
    // `tokens = 1`: the loop's own calls pass the literal, so every existing decode step's node
    // table is byte-unchanged by construction (R6-PREFIX-SUFFIX-PREFILL section 2.5).
    step_nodes := layer_qwen2.mf_decode_layer_node_table(g, n_past, 1, width)
    pos_view := pos_all[(step - 1) * 4..step * 4]
    mask_view := mask_all[(step - 1) * width * 4..step * width * 4]
    before_nodes := decoded.node_count
    before_compute := decoded.compute_ns
    before_high_water := decoded.slot_high_water
    decoded.token_id = token
    decode_pass(
      pak, device, backend, resident_buffer, context_bytes, g, ends, table, plan, tokens,
      head_members, window, layout, resident,
      slot_view, ids_view, pos_view, mask_view, out_ids_view, residual_view, logits_view, node_view,
      plane_view, oracle, embed_nodes, step_nodes, head_nodes, scan, ranges.start, ranges.length,
      token, n_past, 1, false, width, stride, breach, activation, state, decoded, o)
    if o.code.len() > 0 {
      // Section 2.8. A failure inside step `k` publishes `steps_completed = k - 1` and `k - 1`
      // complete objects: **a partial step publishes no object**, because a half-filled row is a row
      // that says a step happened and no step happened. The plane keeps the `T + k - 1` columns some
      // completed step verified, and nothing reads the rest, because this loop is the only reader
      // and it has stopped.
      //
      // **And no counts either.** The loop-level `node_count`, `compute_ns`, `graph_count`, and
      // `slot_high_water` are aggregates over the published rows, so the partial step's own share is
      // rolled back here rather than left in a sum no row accounts for. `graph_count` is advanced
      // once per completed pass and needs no rollback; the other three accumulate per graph and do.
      // The step that failed is named by `error_detail`, which is where "how far it got" belongs.
      decoded.node_count = before_nodes
      decoded.compute_ns = before_compute
      decoded.slot_high_water = before_high_water
      if state.roundtrip_verdict == ROUNDTRIP_MISMATCH && state.first_mismatch_step < 0 {
        state.first_mismatch_step = step
      }
      prefix_step(o, step)
      break
    }
    // R6-KV-PERSIST section 1.4's labelled diagnostic, taken at the one instant it names: step 1's
    // argmax is available. It is **reported and never claimed** — section 1.4 gives four concrete
    // reasons why a number measured on this host cannot bear a TTFT claim — and `normalize` zeroes
    // it, so no golden and no acceptance decision depends on it.
    if step == 1 { o.first_token_ns = time.instant() - origin }
    if breach { any_breach = true }
    step_verdict := if !o.transcript_present {
      model_forward.ORACLE_ABSENT
    } else if o.oracle_elements <= 0 {
      model_forward.ORACLE_FAIL
    } else if o.oracle_max_abs <= model_forward.TOLERANCE_TEN_THOUSANDTHS && !breach {
      model_forward.ORACLE_PASS
    } else {
      model_forward.ORACLE_FAIL
    }
    state.columns_written = n_past + 1
    decoded.steps_completed = step
    decoded.n_past_last = n_past
    n_past_column.push(n_past)
    token_column.push(token)
    argmax_column.push(decoded.argmax)
    bit_column.push(decoded.bit_sum)
    element_column.push(decoded.element_count)
    nonfinite_column.push(decoded.nonfinite_count)
    compute_column.push(decoded.compute_ns - before_compute)
    node_column.push(decoded.node_count - before_nodes)
    plane_column.push(n_past)
    verdict_column.push(step_verdict)
    max_abs_column.push(o.oracle_max_abs)
    max_sum_column.push(o.oracle_max_sum)
    elements_column.push(o.oracle_elements)
    matched_column.push(o.oracle_matched)
    expected_column.push(o.oracle_expected)
    layers_column.push(o.oracle_layers_matched)
    graph_column.push(if o.transcript_present { step + 1 } else { 0 })
    worst_layer_column.push(o.oracle_worst_layer)
    step_sha: str := decoded.sha256
    digests.push(step_sha.clone())
    step_worst: str := o.oracle_worst_node
    worst_names.push(step_worst.clone())
    if o.transcript_present && (o.oracle_max_abs > aggregate_max_abs || worst_unset) {
      worst_unset = false
      aggregate_max_abs = o.oracle_max_abs
      aggregate_worst_layer = o.oracle_worst_layer
      aggregate_worst_element = o.oracle_worst_element
      aggregate_worst_node = step_worst.clone()
      o.decode_oracle_worst_step = step
    }
    if o.oracle_max_sum > aggregate_max_sum { aggregate_max_sum = o.oracle_max_sum }
    aggregate_elements = aggregate_elements + o.oracle_elements
    aggregate_matched = aggregate_matched + o.oracle_matched
    aggregate_expected = aggregate_expected + o.oracle_expected
    aggregate_layers = o.oracle_layers_matched
    aggregate_verdict = if aggregate_verdict == model_forward.ORACLE_FAIL {
      model_forward.ORACLE_FAIL
    } else {
      step_verdict
    }
    // Both are claims about a comparison, so neither is advanced when there was none to make: a
    // document with `oracle_decode.present: false` must not report a step count and a graph range
    // for a graph it never opened.
    if o.transcript_present {
      o.decode_oracle_steps_compared = o.decode_oracle_steps_compared + 1
      o.decode_oracle_graph_last = step + 1
    }
    // The chain: this step's `argmax` is the next step's input. A divergence at step `j` cannot be
    // absorbed later — it changes step `j`'s `embd`, and every later step's input, `embd`, and
    // logits — so the `N` ids are gated as one chain rooted at a byte-exact `d_1`.
    token = decoded.argmax
    step = step + 1
  }
  // Section 2.8: **never `IDENTICAL` on an error document.** A run that stopped inside step `k` did
  // verify `T + k - 1` columns, and saying `IDENTICAL` about them would read as a claim about the
  // run rather than about the columns some completed step checked; `columns_written` is where that
  // number is published. A mismatch is sticky and keeps its own verdict.
  if o.code.len() == 0 && state.roundtrip_verdict == ROUNDTRIP_ABSENT
    && state.roundtrip_bytes_compared > 0 {
    state.roundtrip_verdict = ROUNDTRIP_IDENTICAL
  }
  breach = any_breach
  o.oracle_max_abs = aggregate_max_abs
  o.oracle_max_sum = aggregate_max_sum
  o.oracle_elements = aggregate_elements
  o.oracle_matched = aggregate_matched
  o.oracle_expected = aggregate_expected
  o.oracle_layers_matched = aggregate_layers
  o.oracle_layers_expected = g.n_layer
  o.oracle_worst_layer = aggregate_worst_layer
  o.oracle_worst_element = aggregate_worst_element
  aggregate_view: str := aggregate_worst_node
  o.oracle_worst_node = aggregate_view.clone()
  if o.transcript_present && o.code.len() == 0 { o.oracle_verdict = aggregate_verdict }
  return model_forward.StepColumns {
    count: decoded.steps_completed,
    n_past: n_past_column.build(),
    token_id: token_column.build(),
    argmax: argmax_column.build(),
    bit_sum: bit_column.build(),
    element_count: element_column.build(),
    nonfinite_count: nonfinite_column.build(),
    compute_ns: compute_column.build(),
    node_count: node_column.build(),
    plane_column: plane_column.build(),
    oracle_verdict: verdict_column.build(),
    oracle_max_abs: max_abs_column.build(),
    oracle_max_sum: max_sum_column.build(),
    oracle_elements: elements_column.build(),
    oracle_nodes_matched: matched_column.build(),
    oracle_nodes_expected: expected_column.build(),
    oracle_layers: layers_column.build(),
    oracle_graph: graph_column.build(),
    oracle_worst_layer: worst_layer_column.build(),
    digests: digests.build(),
    worst_names: worst_names.build(),
  }
}

// ---------------------------------------------------------------------------------------------
// The prefill pass (steps 9 and 10 of section 2.8)
//
// R5B's schedule, run at the declared `KV_WIDTH` so its K and V are the same padded operands
// llama.cpp's are, with one addition: every layer graph marks its post-RoPE K and its V as outputs
// and reads them into the plane before its contexts are freed. Nothing else about it changes, and
// nothing about it is compared: oracle A is the **decode** graph's oracle, and the prefill graphs
// run with `compare = false` so a transcript's first graph is never matched against them.
// ---------------------------------------------------------------------------------------------

fn prefill_pass(
  borrow pak: file,
  device: raw,
  backend: raw,
  resident_buffer: raw,
  context_bytes: i64,
  borrow g: layer_qwen2.Geometry,
  borrow table: layer_qwen2.MemberTable,
  borrow plan: model_forward.Plan,
  borrow tokens: model_forward.TokenColumns,
  borrow embed_members: model_forward.GraphMembers,
  borrow head_members: model_forward.GraphMembers,
  borrow window: slice<u8>,
  borrow layout: model_forward.ResidentLayout,
  resident: bool,
  borrow slot_view: slice<u8>,
  borrow index_view: slice<u8>,
  borrow mask_view: slice<u8>,
  borrow out_ids_view: slice<u8>,
  borrow residual_view: slice<u8>,
  borrow logits_view: slice<u8>,
  borrow node_view: slice<u8>,
  borrow plane_view: slice<u8>,
  borrow oracle: layer_qwen2.OracleTable,
  borrow embed_nodes: layer_qwen2.NodeTable,
  borrow layer_nodes: layer_qwen2.NodeTable,
  borrow head_nodes: layer_qwen2.NodeTable,
  borrow scan: layer_forward.TranscriptScan,
  borrow starts: array<i64>,
  borrow lengths: array<i64>,
  width: i64,
  stride: i64,
  reference_path: str,
  borrow mut breach: bool,
  borrow mut state: Plane,
  borrow mut activation: array_builder<i64>,
  borrow mut o: model_forward.Outcome,
) -> model_forward.ScheduleColumns {
  // The reader's scratch buffer and its two counter pairs are locals, not the caller's. At this pin
  // a cross-module call cannot take the caller's own `borrow mut` parameter beside a shorter-lived
  // local operand, and every window fill here does exactly that; owning them in the frame that fills
  // the window is the shape the checker accepts. Their totals are added to `o` before returning, so
  // the document's `pack.reader_*` and `reference.*` counts are unchanged.
  mut transient: buffer := buffer(model_forward.CHUNK_BYTES)
  mut counters := alignpack_read.new_counters()
  mut source_counters := alignpack_read.new_counters()
  digests := builder()
  mut attention_block: array_builder<i64> := array_builder()
  mut mlp_block: array_builder<i64> := array_builder()
  mut attention_bytes: array_builder<i64> := array_builder()
  mut mlp_bytes: array_builder<i64> := array_builder()
  mut attn_v_type: array_builder<i64> := array_builder()
  mut ffn_down_type: array_builder<i64> := array_builder()
  mut pread_column: array_builder<i64> := array_builder()
  mut compute_column: array_builder<i64> := array_builder()
  mut node_column: array_builder<i64> := array_builder()
  mut bit_column: array_builder<i64> := array_builder()
  mut sum_column: array_builder<i64> := array_builder()
  mut ne0_column: array_builder<i64> := array_builder()
  mut ne1_column: array_builder<i64> := array_builder()
  mut nonfinite_column: array_builder<i64> := array_builder()
  mut rows := 0
  // Step 19's embedding read, one `pread` group per row, moved here from `execute` because at this
  // pin the caller's `borrow mut tokens` cannot travel into a foreign call beside this frame's own
  // scratch buffer. The window is untouched between the two points, so the bytes and the order are
  // the same ones R5B reads.
  embed_base := layout.base[0]
  embed_view := window[embed_base..embed_base + layout.span[0]]
  embed_started := time.instant()
  if resident {
    // R6-RESIDENT-WEIGHTS section 3.3. The rows are gathered out of the resident table into the
    // arena's own staging region: `T` host copies of `row_bytes` each and **no pack read**.
    mut piece := 0
    loop {
      if piece >= tokens.count || o.code.len() > 0 { break }
      take_pack(o, model_forward.stage_embed_row(
          window, layout.table_at, embed_base, layout.span[0], embed_members.stride[0], g.n_vocab,
          tokens.ids[piece], piece))
      piece = piece + 1
    }
  } else {
    take_pack(
      o, model_forward.fill_members(pak, embed_members, tokens, embed_view, transient, counters))
  }
  o.pread_ns = o.pread_ns + (time.instant() - embed_started)
  // `window.reuse_count` counts the graphs that read their weights out of the one Align-owned
  // region, which is what it has always measured on the streamed path (one refill per graph) and is
  // the same number in resident mode, where the region is filled once and read by every graph.
  o.window_reuse_count = o.window_reuse_count + 1
  // Oracle B's byte precondition, and R5B's rule unchanged: every member the schedule reads is
  // compared byte for byte against the source GGUF at its own `source_offset` before its graph runs,
  // so a numeric divergence can never be reported when the cause is a container that does not
  // describe the model.
  if o.reference_present {
    take_pack(o, model_forward.compare_source_file(
        reference_path, embed_members, tokens, embed_view, -1, transient, source_counters))
  }
  mut embed_result := model_forward.empty_graph_result()
  spec := model_forward.spec_for(
    model_forward.GRAPH_EMBED, 0, -1, tokens.count, width, false, false, 0, 1,
    layer_qwen2.mf_embed_output_slot(), false, false, g.n_embd)
  run_step_graph(
    device, backend, resident_buffer, context_bytes, spec, g, embed_members, embed_nodes, oracle,
    embed_view, slot_view,
    residual_view, index_view, index_view, mask_view, out_ids_view, plane_view, plane_view,
    node_view, residual_view, plane_view, scan, starts, lengths, false, false, tokens.count,
    stride, breach, state, embed_result, o)
  account(embed_result, true, activation, o)
  mut layer := 0
  loop {
    if layer >= g.n_layer || o.code.len() > 0 { break }
    members := model_forward.build_layer_members(table, plan, layer)
    layer_base := layout.base[1 + layer]
    layer_view := window[layer_base..layer_base + layout.span[1 + layer]]
    read_started := time.instant()
    if !resident {
      take_pack(
        o, model_forward.fill_members(pak, members, tokens, layer_view, transient, counters))
    }
    layer_pread := time.instant() - read_started
    o.pread_ns = o.pread_ns + layer_pread
    o.window_reuse_count = o.window_reuse_count + 1
    if o.code.len() == 0 && o.reference_present {
      take_pack(o, model_forward.compare_source_file(
          reference_path, members, tokens, layer_view, layer, transient, source_counters))
    }
    if o.code.len() > 0 { break }
    last := layer == g.n_layer - 1
    mut result := model_forward.empty_graph_result()
    layer_spec := model_forward.spec_for(
      model_forward.GRAPH_LAYER, 1 + layer, layer, tokens.count, width, last, true,
      layer_qwen2.mf_oracle_layer_base(layer), layer_qwen2.MF_LAYER_ORACLE_COUNT,
      layer_qwen2.mf_layer_output_slot(), false, false, g.n_embd)
    run_step_graph(
      device, backend, resident_buffer, context_bytes, layer_spec, g, members, layer_nodes, oracle,
      layer_view,
      slot_view, residual_view, index_view, index_view, mask_view, out_ids_view, plane_view,
      plane_view, node_view, residual_view, plane_view, scan, starts, lengths, false, true,
      tokens.count, stride, breach, state, result, o)
    account(result, true, activation, o)
    if o.ggml_buffers_created != o.ggml_buffers_freed || o.contexts_created != o.contexts_freed
      || o.gallocrs_created != o.gallocrs_freed {
      o.graph_balance_failures = o.graph_balance_failures + 1
    }
    if o.code.len() == 0 {
      span := result.out_bytes
      expected := g.n_embd * (if last { 1 } else { tokens.count }) * 4
      if span != expected {
        fail(o, "R5_RESIDUAL", model_forward.labelled("layer", layer))
      } else {
        compared := residual_view[0..span]
        digest := model_forward.digest_region(compared)
        sha_view: str := digest.sha
        digests.write(sha_view)
        bit_column.push(digest.bit_sum)
        sum_column.push(digest.sum_millionths)
        nonfinite_column.push(digest.nonfinite)
        ne0_column.push(result.out_ne0)
        ne1_column.push(result.out_ne1)
        attention_block.push(plan.attention_index[layer])
        mlp_block.push(plan.mlp_index[layer])
        attention_bytes.push(plan.attention_member_bytes[layer])
        mlp_bytes.push(plan.mlp_member_bytes[layer])
        attn_v_type.push(plan.m_type[layer * table.count + 5])
        ffn_down_type.push(plan.m_type[layer * table.count + 11])
        pread_column.push(layer_pread)
        compute_column.push(result.compute_ns)
        node_column.push(result.node_count)
        rows = rows + 1
      }
    }
    layer = layer + 1
  }
  if o.code.len() == 0 {
    prefill_head(
      pak, device, backend, resident_buffer, context_bytes, g, head_members, window, layout,
      resident, slot_view, index_view,
      mask_view, out_ids_view, residual_view, logits_view, node_view, plane_view, oracle,
      head_nodes, scan, starts, lengths, width, stride, tokens, reference_path, breach, state,
      activation, o)
  }
  o.reader_pread_count = o.reader_pread_count + counters.pread_count
  o.reader_bytes_read = o.reader_bytes_read + counters.bytes_read
  o.reference_pread_count = o.reference_pread_count + source_counters.pread_count
  o.reference_bytes_read = o.reference_bytes_read + source_counters.bytes_read
  return model_forward.ScheduleColumns {
    count: rows,
    digests: digests.to_string(),
    attention_block: attention_block.build(),
    mlp_block: mlp_block.build(),
    attention_bytes: attention_bytes.build(),
    mlp_bytes: mlp_bytes.build(),
    attn_v_type: attn_v_type.build(),
    ffn_down_type: ffn_down_type.build(),
    pread_ns: pread_column.build(),
    compute_ns: compute_column.build(),
    node_count: node_column.build(),
    bit_sum: bit_column.build(),
    sum_millionths: sum_column.build(),
    ne0: ne0_column.build(),
    ne1: ne1_column.build(),
    nonfinite: nonfinite_column.build(),
  }
}

// The prefill's last graph. It is its own function because the loop above already fills one, and a
// two-hundred-line body is the shape `docs/specs/r5b-model-prefill-forward.md` section 5.5 says the
// checker charges superlinearly for.
fn prefill_head(
  borrow pak: file,
  device: raw,
  backend: raw,
  resident_buffer: raw,
  context_bytes: i64,
  borrow g: layer_qwen2.Geometry,
  borrow head_members: model_forward.GraphMembers,
  borrow window: slice<u8>,
  borrow layout: model_forward.ResidentLayout,
  resident: bool,
  borrow slot_view: slice<u8>,
  borrow index_view: slice<u8>,
  borrow mask_view: slice<u8>,
  borrow out_ids_view: slice<u8>,
  borrow residual_view: slice<u8>,
  borrow logits_view: slice<u8>,
  borrow node_view: slice<u8>,
  borrow plane_view: slice<u8>,
  borrow oracle: layer_qwen2.OracleTable,
  borrow head_nodes: layer_qwen2.NodeTable,
  borrow scan: layer_forward.TranscriptScan,
  borrow starts: array<i64>,
  borrow lengths: array<i64>,
  width: i64,
  stride: i64,
  borrow tokens: model_forward.TokenColumns,
  reference_path: str,
  borrow mut breach: bool,
  borrow mut state: Plane,
  borrow mut activation: array_builder<i64>,
  borrow mut o: model_forward.Outcome,
) {
  mut transient: buffer := buffer(model_forward.CHUNK_BYTES)
  mut counters := alignpack_read.new_counters()
  mut source_counters := alignpack_read.new_counters()
  head_base := layout.base[1 + g.n_layer]
  head_view := window[head_base..head_base + layout.span[1 + g.n_layer]]
  head_started := time.instant()
  if !resident {
    take_pack(
      o, model_forward.fill_members(pak, head_members, tokens, head_view, transient, counters))
  }
  o.head_pread_ns = time.instant() - head_started
  o.pread_ns = o.pread_ns + o.head_pread_ns
  o.window_reuse_count = o.window_reuse_count + 1
  if o.code.len() == 0 && o.reference_present {
    take_pack(o, model_forward.compare_source_file(
        reference_path, head_members, tokens, head_view, g.n_layer, transient, source_counters))
  }
  if o.code.len() > 0 { return }
  mut head_result := model_forward.empty_graph_result()
  head_spec := model_forward.spec_for(
    model_forward.GRAPH_HEAD, 1 + g.n_layer, g.n_layer, 1, width, false, false,
    layer_qwen2.mf_oracle_head_base(g.n_layer), layer_qwen2.MF_HEAD_ORACLE_COUNT,
    layer_qwen2.mf_head_output_slot(), false, false, g.n_embd)
  run_step_graph(
    device, backend, resident_buffer, context_bytes, head_spec, g, head_members, head_nodes, oracle,
    head_view,
    slot_view, residual_view, index_view, index_view, mask_view, out_ids_view, plane_view,
    plane_view, node_view, logits_view, plane_view, scan, starts, lengths, false, false,
    tokens.count, stride, breach, state, head_result, o)
  account(head_result, true, activation, o)
  o.head_compute_ns = head_result.compute_ns
  o.head_node_count = head_result.node_count
  if o.ggml_buffers_created != o.ggml_buffers_freed || o.contexts_created != o.contexts_freed
    || o.gallocrs_created != o.gallocrs_freed {
    o.graph_balance_failures = o.graph_balance_failures + 1
  }
  if o.code.len() == 0 && head_result.out_bytes != g.n_vocab * 4 {
    fail(o, "R5_RESIDUAL", model_forward.labelled("layer", g.n_layer))
  }
  o.reader_pread_count = o.reader_pread_count + counters.pread_count
  o.reader_bytes_read = o.reader_bytes_read + counters.bytes_read
  o.reference_pread_count = o.reference_pread_count + source_counters.pread_count
  o.reference_bytes_read = o.reference_bytes_read + source_counters.bytes_read
}

// ---------------------------------------------------------------------------------------------
// R6-RESIDENT-WEIGHTS section 3.2 — the one-time fill
//
// Every fixed weight member the run touches, read **once**, in graph order, straight into its own
// interior offset in the arena, through the same `CHUNK_BYTES` rounds `read_into_window` already
// uses. It runs before the backend opens and before the wrap exists, so a failure here is an
// ordinary pack failure with an ordinary pack code and nothing has to be released.
//
// The full `token_embd.weight` table is read first and at interior offset zero. It is the one
// member no graph declares, because the graphs declare **gathered rows**; section 3.3 records why
// holding the whole table is what makes "zero pack bytes per decode step" exactly true rather than
// approximately true.
//
// Section 2.4 measured Darwin's `pread(2)` refusing `nbyte >= 2 GiB`, and Request 38 records that
// `align_rt_io_file_pread` always asks for the buffer's whole capacity, so a single whole-arena
// read is not merely undesirable here but impossible. The chunked fill is not a workaround for a
// hypothetical surface: it is what the streamed path already does.
// ---------------------------------------------------------------------------------------------

fn fill_resident(
  borrow pak: file,
  borrow g: layer_qwen2.Geometry,
  borrow table: layer_qwen2.MemberTable,
  borrow plan: model_forward.Plan,
  borrow ends: model_forward.Ends,
  borrow tokens: model_forward.TokenColumns,
  borrow head_members: model_forward.GraphMembers,
  borrow window: slice<u8>,
  borrow layout: model_forward.ResidentLayout,
  borrow mut o: model_forward.Outcome,
) {
  mut transient: buffer := buffer(model_forward.CHUNK_BYTES)
  mut counters := alignpack_read.new_counters()
  started := time.instant()
  take_pack(o, model_forward.read_into_window(
      pak, transient, window, layout.table_at, ends.embed_pack_offset, ends.embed_nbytes,
      "R4_PACK_UNREADABLE", "token_embd", counters))
  mut layer := 0
  loop {
    if layer >= g.n_layer || o.code.len() > 0 { break }
    members := model_forward.build_layer_members(table, plan, layer)
    layer_base := layout.base[1 + layer]
    layer_view := window[layer_base..layer_base + layout.span[1 + layer]]
    take_pack(
      o, model_forward.fill_members(pak, members, tokens, layer_view, transient, counters))
    layer = layer + 1
  }
  if o.code.len() == 0 {
    head_base := layout.base[1 + g.n_layer]
    head_view := window[head_base..head_base + layout.span[1 + g.n_layer]]
    take_pack(
      o, model_forward.fill_members(pak, head_members, tokens, head_view, transient, counters))
  }
  o.resident_fill_ns = time.instant() - started
  o.resident_fill_pread_count = counters.pread_count
  o.resident_fill_bytes = counters.bytes_read
  o.pread_ns = o.pread_ns + o.resident_fill_ns
  o.reader_pread_count = o.reader_pread_count + counters.pread_count
  o.reader_bytes_read = o.reader_bytes_read + counters.bytes_read
}

// ---------------------------------------------------------------------------------------------
// The schedule: one prefill, one plane, one step
//
// Every buffer this capability owns is reserved here, once, and every view over one is length-
// checked before a graph sees it. The plane is the last of them and the one section 2.2 is about:
// it is an ordinary Align `buffer`, freed by Align at this scope's end on **every** path — success,
// a refused operand, a ggml failure, or a round-trip mismatch — so there is no manual free to
// forget and no exit that can leave a stale plane behind.
// ---------------------------------------------------------------------------------------------

fn schedule_decode(
  borrow pak: file,
  borrow g: layer_qwen2.Geometry,
  borrow table: layer_qwen2.MemberTable,
  borrow plan: model_forward.Plan,
  borrow ends: model_forward.Ends,
  borrow tokens: model_forward.TokenColumns,
  // R6-PREFIX-SUFFIX-PREFILL section 2.2. The `SUFFIX` operand's ids, already validated against the
  // real `n_vocab` and against the sequence cap. `count == 0` is "no suffix" and is what every
  // schema-4-era invocation means.
  borrow suffix_tokens: model_forward.TokenColumns,
  borrow embed_members: model_forward.GraphMembers,
  borrow head_members: model_forward.GraphMembers,
  borrow window: slice<u8>,
  borrow layout: model_forward.ResidentLayout,
  resident: bool,
  device: raw,
  context_bytes: i64,
  width: i64,
  residual_bytes: i64,
  logits_bytes: i64,
  readback_bytes: i64,
  reference_path: str,
  transcript_path: str,
  logits_path: str,
  // R6-PREFIX-KEY section 2.5. On a **store** run exactly one of these two carries the key's path
  // and the other is empty, decided by `fs.exists` at L0 rather than by an operand — so every line
  // below is the load path or the save path this arm already shipped, unchanged. `store_mode` is
  // true only on a miss, and it exists for step W5's detail alone.
  kv_save_path: str,
  kv_load_path: str,
  store_mode: bool,
  borrow pack_digest: slice<u8>,
  borrow geometry_digest: slice<u8>,
  steps: i64,
  generation: bool,
  borrow eog_ids: array<i64>,
  generation_max: i64,
  origin: i64,
  borrow mut schedule: model_forward.ScheduleColumns,
  borrow mut graphs: model_forward.GraphColumns,
  borrow mut top: model_forward.TopColumns,
  borrow mut stepped: model_forward.StepColumns,
  borrow mut o: model_forward.Outcome,
) {
  // The plane's and the step's bookkeeping are **locals of this frame**, published into `o` on the
  // way out. They are not out-parameters for the reason `publish` records: a `borrow mut` argument
  // whose owner is the caller's own parameter cannot travel in the same call as this frame's local
  // views, and every graph call below hands the callee both.
  mut state := empty_plane()
  mut decoded := empty_decode()
  // R6-PREFIX-SUFFIX-PREFILL section 2.6. `S` columns at `n_past = T_prefix`, then the existing
  // loop from `n_past = T_prefix + S`. `suffix_span` is `S` clamped to at least one so that every
  // per-pass buffer below is a legal reservation on a run with no suffix; nothing reads those
  // buffers unless `suffix_count > 0`.
  suffix_count := suffix_tokens.count
  suffix_span := if suffix_count > 0 { suffix_count } else { 1 }
  n_past := tokens.count + suffix_count
  stride := plane_stride(g, width)
  plane_bytes := plane_bytes_for(g, width)
  state.bytes = plane_bytes
  state.stride = stride
  decoded.n_past = n_past
  decoded.n_past_last = n_past
  decoded.steps_requested = steps
  slot_bytes := layer_qwen2.SLOT_HEADER_BYTES + layer_qwen2.SLOT_BYTES * layer_qwen2.MAX_NODE_SLOTS
  mut slots: buffer := buffer(slot_bytes + 8)
  model_forward.fill_zero(slots, 1)
  slot_pad := 8 - model_forward.base_mod(slots, 8)
  model_forward.fill_zero(slots, slot_pad - 1 + slot_bytes)
  mut mask_wide: buffer := buffer(width * tokens.count * 4)
  layer_qwen2.mf_write_mask(mask_wide, width, tokens.count)
  // Section 2.6's offset mask, one row per step. `0.0` for columns `0 ..= n_past` and `-inf` above,
  // which is the whole difference between "this token may attend to everything the prompt produced
  // plus itself" and "this token may attend to column zero".
  //
  // R6-STEP-N section 2.6 calls this per-step object "rewritten in place". Align's `buffer` is
  // append-only, so the honest form of that is **one buffer holding every step's row**, written once
  // in order and sliced per step. The bytes are the same and no reservation happens inside the loop.
  mut mask_decode: buffer := buffer(width * steps * 4)
  mut mask_step := 0
  loop {
    if mask_step >= steps { break }
    layer_qwen2.mf_write_mask_offset(mask_decode, width, 1, n_past + mask_step)
    mask_step = mask_step + 1
  }
  mut index_image: buffer := buffer(tokens.count * 4)
  mut image_at := 0
  loop {
    if image_at >= tokens.count { break }
    index_image.put_u32_le(image_at as u32)
    image_at = image_at + 1
  }
  mut out_ids_image: buffer := buffer(4)
  out_ids_image.put_u32_le((tokens.count - 1) as u32)
  // The decode step's three one-element inputs, and the reason section 2.6 exists: the row index is
  // **0** and the position is **`n_past`**, and until R6 they were one buffer.
  mut decode_ids_image: buffer := buffer(4)
  decode_ids_image.put_u32_le(0 as u32)
  mut decode_pos_image: buffer := buffer(steps * 4)
  mut pos_step := 0
  loop {
    if pos_step >= steps { break }
    decode_pos_image.put_u32_le((n_past + pos_step) as u32)
    pos_step = pos_step + 1
  }
  mut decode_out_ids_image: buffer := buffer(4)
  decode_out_ids_image.put_u32_le(0 as u32)
  // The suffix pass's four inputs, and the id/position split doing its job at `S` entries each
  // (section 2.6). The **positions** are absolute — `T_prefix + i` — because RoPE positions are
  // absolute and a suffix continues a prefix rather than restarting it. The **ids** are `0 .. S-1`,
  // the row indices into this pass's own `S`-row gathered window, and are the prefill's
  // `index_image` exactly. `out_ids` is `S - 1`: the last suffix token's row in the pass's own
  // coordinates, which is where a reader most naturally expects an absolute index and where the
  // correct value is relative.
  mut suffix_mask: buffer := buffer(width * suffix_span * 4)
  layer_qwen2.mf_write_mask_offset(suffix_mask, width, suffix_span, tokens.count)
  mut suffix_pos_image: buffer := buffer(suffix_span * 4)
  mut suffix_pos_at := 0
  loop {
    if suffix_pos_at >= suffix_span { break }
    suffix_pos_image.put_u32_le((tokens.count + suffix_pos_at) as u32)
    suffix_pos_at = suffix_pos_at + 1
  }
  mut suffix_ids_image: buffer := buffer(suffix_span * 4)
  mut suffix_ids_at := 0
  loop {
    if suffix_ids_at >= suffix_span { break }
    suffix_ids_image.put_u32_le(suffix_ids_at as u32)
    suffix_ids_at = suffix_ids_at + 1
  }
  mut suffix_out_ids_image: buffer := buffer(4)
  suffix_out_ids_image.put_u32_le((suffix_span - 1) as u32)
  mut residual: buffer := buffer(residual_bytes)
  model_forward.prime_window(residual, residual_bytes)
  // `S` rows and not one: the suffix pass's embedding gather and every layer but the last produce
  // `{n_embd, S}`, and a decode step's own single row is the `S = 1` case of the same reservation.
  mut decode_residual: buffer := buffer(g.n_embd * suffix_span * 4)
  model_forward.prime_window(decode_residual, g.n_embd * suffix_span * 4)
  mut logits: buffer := buffer(logits_bytes)
  model_forward.prime_window(logits, logits_bytes)
  mut decode_logits: buffer := buffer(logits_bytes)
  model_forward.prime_window(decode_logits, logits_bytes)
  mut node_window: buffer := buffer(readback_bytes)
  model_forward.prime_window(node_window, readback_bytes)
  // Section 2.2's "initial contents". Zero is not tidiness: columns `>= T` are masked `-inf` in
  // every graph, so a zeroed tail is the only value that can never change an answer, and a non-zero
  // tail that did change one would be a masking bug this choice makes visible.
  mut plane: buffer := buffer(plane_bytes)
  model_forward.prime_window(plane, plane_bytes)

  slots_all := slots.bytes()
  mask_wide_view := mask_wide.bytes()
  mask_decode_view := mask_decode.bytes()
  index_view := index_image.bytes()
  out_ids_view := out_ids_image.bytes()
  decode_ids_view := decode_ids_image.bytes()
  decode_pos_view := decode_pos_image.bytes()
  decode_out_ids_view := decode_out_ids_image.bytes()
  suffix_mask_view := suffix_mask.bytes()
  suffix_pos_view := suffix_pos_image.bytes()
  suffix_ids_view := suffix_ids_image.bytes()
  suffix_out_ids_view := suffix_out_ids_image.bytes()
  residual_view := residual.bytes()
  decode_residual_view := decode_residual.bytes()
  logits_view := logits.bytes()
  decode_logits_view := decode_logits.bytes()
  node_view := node_window.bytes()
  plane_view := plane.bytes()
  if plane_view.len() != plane_bytes {
    fail(o, CODE_PLANE_UNAVAILABLE, model_forward.labelled("plane", plane_bytes))
    return
  }
  if slots_all.len() < slot_pad + slot_bytes
    || mask_wide_view.len() != width * tokens.count * 4
    || mask_decode_view.len() != width * steps * 4
    || index_view.len() != tokens.count * 4 || out_ids_view.len() != 4
    || decode_ids_view.len() != 4 || decode_pos_view.len() != steps * 4
    || decode_out_ids_view.len() != 4
    || suffix_mask_view.len() != width * suffix_span * 4
    || suffix_pos_view.len() != suffix_span * 4 || suffix_ids_view.len() != suffix_span * 4
    || suffix_out_ids_view.len() != 4
    || residual_view.len() != residual_bytes
    || decode_residual_view.len() != g.n_embd * suffix_span * 4
    || logits_view.len() != logits_bytes || decode_logits_view.len() != logits_bytes
    || node_view.len() != readback_bytes {
    fail(o, "R4_WINDOW_UNAVAILABLE", "slots")
    return
  }
  slot_view := slots_all[slot_pad..slot_pad + slot_bytes]

  oracle := layer_qwen2.mf_decode_oracle_table(g.n_layer)
  embed_nodes := layer_qwen2.mf_embed_node_table()
  head_nodes := layer_qwen2.mf_head_node_table(g)
  prefill_nodes := layer_qwen2.mf_layer_node_table(g, tokens.count, width)
  // The prefill graphs are never compared — oracle A' is the **decode** graph's oracle and every
  // prefill spec carries `compare = false` — so they take the empty scan. Each decode step prepares
  // its own, at its own graph offset, inside the loop.
  scan := layer_forward.empty_transcript_scan()
  ranges := model_forward.empty_ranges()
  mut breach := false
  mut decoded_token := -1
  mut activation: array_builder<i64> := array_builder()
  mut backend := ggml_ffi.null_handle()
  if o.code.len() == 0 {
    backend = ggml_ffi.backend_open(device)
    if ggml_ffi.handle_absent(backend) {
      fail(o, "R5_GGML_INIT", "backend")
    } else {
      o.backends_created = o.backends_created + 1
      o.backend_name = ggml_ffi.backend_name(backend)
    }
  }
  // Section 3.2's hoist. The arena is filled once and wrapped once, at **run** scope, before the
  // first graph exists; every graph below places into this one wrap and frees none of it. The pair
  // of counters is separate from `ggml_buffers_*` on purpose (section 4.3): the per-graph balance
  // check keeps its exact meaning and this wrap's own balance is asserted at the scope that owns
  // it, after `backend_close` and before this frame's arena leaves scope.
  mut resident_buffer := ggml_ffi.null_handle()
  if o.code.len() == 0 && resident {
    fill_resident(pak, g, table, plan, ends, tokens, head_members, window, layout, o)
  }
  if o.code.len() == 0 && resident {
    wrap_started := time.instant()
    resident_buffer = ggml_ffi.buffer_from_host(device, window, window.len())
    o.wrap_ns = o.wrap_ns + (time.instant() - wrap_started)
    if ggml_ffi.handle_absent(resident_buffer) {
      fail(o, "R5_GGML_INIT", "resident_buffer")
    } else {
      o.resident_wraps_created = o.resident_wraps_created + 1
      o.wrap_count = o.wrap_count + 1
    }
  }
  loading := kv_load_path.len() > 0
  // R6-KV-PERSIST section 1.1. A load run **skips the prefill entirely**: it builds no prefill
  // graph, so it publishes no prefill graph count. `graph` and `schedule` therefore differ between
  // the two paths legitimately, which is why oracle Q excludes them and compares the results
  // instead.
  o.graph_count = if loading { 0 } else { g.n_layer + 2 }
  if o.code.len() == 0 && loading {
    load_plane(
      kv_load_path, g, tokens, plane_view, logits_view, pack_digest, geometry_digest, width, state,
      o)
  } else if o.code.len() == 0 {
    schedule = prefill_pass(
      pak, device, backend, resident_buffer, context_bytes, g, table, plan, tokens, embed_members,
      head_members,
      window, layout, resident, slot_view, index_view, mask_wide_view, out_ids_view, residual_view,
      logits_view,
      node_view, plane_view, oracle, embed_nodes, prefill_nodes, head_nodes, scan, ranges.start,
      ranges.length, width, stride, reference_path, breach, state, activation, o)
    if o.code.len() == 0 { o.plane_source = PLANE_SOURCE_PREFILL }
  }
  // R6-PREFIX-SUFFIX-PREFILL sections 2.8 and 2.9. `output` is digested **before** the suffix pass
  // so that a pass which fails publishes the **container's** persisted vector, which is what an
  // ordinary load run publishes and what a pass that produced no logits cannot replace. On a
  // completed pass the block below runs again over the pass's own logits and replaces it, which is
  // the field's documented behaviour change on a new operand combination.
  if o.code.len() == 0 && suffix_count > 0 {
    digest := model_forward.digest_region(logits_view)
    o.sha256 = digest.sha.clone()
    o.bit_sum = digest.bit_sum
    o.element_count = g.n_vocab
    o.nonfinite_count = digest.nonfinite
    o.argmax = digest.argmax
    mut top_index: array_builder<i64> := array_builder()
    mut top_bits: array_builder<i64> := array_builder()
    top_k(logits_view, top_index, top_bits)
    top = model_forward.TopColumns { index: top_index.build(), bits: top_bits.build() }
    decoded.token_id = digest.argmax
    decoded_token = digest.argmax
  }
  // R6-PREFIX-KEY section 2.5, and the one ordering this capability had to move rather than inherit.
  // **A keyed miss saves the prefill plane here — before the suffix pass — because that is what a
  // shared prefix is.** The `KV_SAVE` writer runs after the suffix pass below, which is correct for
  // it: `SUFFIX` is illegal beside `KV_SAVE` (step 2b/2c), so no `KV_SAVE` run has a suffix pass to
  // be after. A store miss is the first run that has both, and persisting after the pass would write
  // a container whose plane carries `T_prefix + S` columns under a header that declares
  // `columns_persisted = T_prefix` — a container the independent reader refuses as `ZEROTAIL`, that
  // is **not** byte-identical to the `KV_SAVE` container of the same prefix, and that keys a prefix
  // to a plane containing one particular suffix. `logits_view` and `plane_view` here are the
  // prefill's own, and `decoded_token` is the prefill's argmax, which the block above just computed.
  store_prefix_save := store_mode && suffix_count > 0
  if o.code.len() == 0 && store_prefix_save && kv_save_path.len() > 0 {
    pack_total := o.total_bytes
    save_plane(
      kv_save_path, g, tokens, plane_view, logits_view, pack_digest, geometry_digest, width,
      decoded_token, pack_total, store_mode, o)
    if o.code.len() == 0 && o.kv_verdict == kv_plane.VERDICT_SAVED {
      o.store_saved = true
    }
  }
  // X1 to X4 of section 2.7. One suffix pass — a decode-shaped graph set over `S` columns at
  // `n_past = T_prefix`, causally masked over prefix-plus-suffix — writing its K and V back into the
  // plane at columns `T_prefix .. T_prefix+S-1` and verifying the plane over all `T_prefix + S`
  // before any decode step runs. It is **one graph set, not `S` of them**: `2 + n_layer` graphs, the
  // same count as a prefill or a decode step.
  //
  // Its logits land in `logits_view` — the prefill's own buffer — so every consumer below is
  // unchanged: the digest block, `oracle_logits`, and the decode chain's root all read the run's own
  // last prefill-shaped result, which on a suffix run is prefix-plus-suffix.
  mut suffix_decoded := empty_decode()
  if o.code.len() == 0 && suffix_count > 0 {
    o.suffix_columns_written = tokens.count
    suffix_nodes := layer_qwen2.mf_decode_layer_node_table(g, tokens.count, suffix_count, width)
    decode_pass(
      pak, device, backend, resident_buffer, context_bytes, g, ends, table, plan, suffix_tokens,
      head_members, window, layout, resident,
      slot_view, suffix_ids_view, suffix_pos_view, suffix_mask_view, suffix_out_ids_view,
      decode_residual_view, logits_view, node_view, plane_view, oracle, embed_nodes, suffix_nodes,
      head_nodes, scan, ranges.start, ranges.length,
      model_forward.column_at(suffix_tokens.ids, 0), tokens.count, suffix_count, true, width,
      stride, breach, activation, state, suffix_decoded, o)
    if o.code.len() > 0 {
      // Section 2.8: **a partial suffix pass publishes no completion.** `columns_written` stays
      // `T_prefix`, every count stays 0, no step runs, and the plane is freed — so no reader ever
      // sees the rows some layer wrote. How far the pass got is named by `error_detail`.
      prefix_suffix(o)
    } else {
      // Section 2.4: the advance is made **after the last layer**, by the caller that knows the
      // pass completed, never per layer. `capture_plane`'s own `first_column == 0` guard does not
      // fire at `first_column = T_prefix`, and that is the feature.
      state.columns_written = tokens.count + suffix_count
      o.suffix_completed = true
      o.suffix_columns_written = state.columns_written
      o.suffix_graph_count = suffix_decoded.graph_count
      o.suffix_node_count = suffix_decoded.node_count
      o.suffix_compute_ns = suffix_decoded.compute_ns
    }
  }
  if o.code.len() == 0 {
    digest := model_forward.digest_region(logits_view)
    o.sha256 = digest.sha.clone()
    o.bit_sum = digest.bit_sum
    o.element_count = g.n_vocab
    o.nonfinite_count = digest.nonfinite
    o.argmax = digest.argmax
    mut top_index: array_builder<i64> := array_builder()
    mut top_bits: array_builder<i64> := array_builder()
    top_k(logits_view, top_index, top_bits)
    top = model_forward.TopColumns { index: top_index.build(), bits: top_bits.build() }
    decoded.token_id = digest.argmax
    decoded_token = digest.argmax
  }
  // W1 to W4 of section 2.6, immediately after step 10 and before step 11'. The container holds the
  // **prefill** plane at `T` columns, not the post-loop plane at `T + N`: what a shared prefix is,
  // is a prefill.
  if o.code.len() == 0 && kv_save_path.len() > 0 && !store_prefix_save {
    // `pack_total` is read out of the outcome **before** the call: at this pin a borrowed argument
    // that reads a field of the same record the call also borrows mutably aliases its owner.
    pack_total := o.total_bytes
    save_plane(
      kv_save_path, g, tokens, plane_view, logits_view, pack_digest, geometry_digest, width,
      decoded_token, pack_total, store_mode, o)
    // Section 2.7: `store.saved` is `1` only after a **complete** container write. A miss whose
    // write failed reports `0` and the run is already refused.
    if store_mode && o.code.len() == 0 && o.kv_verdict == kv_plane.VERDICT_SAVED {
      o.store_saved = true
    }
  }
  if o.code.len() == 0 && o.logits_present {
    compare_prefill_logits(logits_path, logits_view, g.n_vocab, top, o)
  }
  if o.code.len() == 0 {
    token_id := decoded_token
    stepped = decode_loop(
      pak, device, backend, resident_buffer, context_bytes, g, ends, table, plan, tokens,
      head_members, window, layout, resident,
      slot_view, decode_ids_view, decode_pos_view, mask_decode_view, decode_out_ids_view,
      decode_residual_view, decode_logits_view, node_view, plane_view, oracle, embed_nodes,
      head_nodes, transcript_path, token_id, n_past, steps, generation, eog_ids, generation_max,
      width, stride, origin, breach, activation, state, decoded, o)
  }
  // Section 4.3's ordering, on **every** exit path from here: the wrap is freed before the backend
  // and long before `execute`'s arena leaves scope. There is no path between the arena's
  // construction and this teardown that returns early, which is what makes one converged teardown
  // sufficient (section 5.1's early-exit cell).
  if !ggml_ffi.handle_absent(resident_buffer) {
    ggml_ffi.buffer_free(resident_buffer)
    o.resident_wraps_freed = o.resident_wraps_freed + 1
  }
  if !ggml_ffi.handle_absent(backend) {
    ggml_ffi.backend_close(backend)
    o.backends_freed = o.backends_freed + 1
  }
  // Oracle B at run scope. The hoist R5C section 5.4 refused is admitted here only because the
  // invariant it weakens is re-established at the scope the hoist moved it to: **every resident
  // wrap this run created was freed, and it created at most one.**
  //
  // Section 11.1 correction 12: the invariant is *balance*, not *presence*. A resident run that
  // fails before the wrap exists — the fill raising `R4_PACK_UNREADABLE`, or `buffer_from_host`
  // itself refusing (`ds-force-resident-wrap`) — created nothing and freed nothing, and asserting
  // `created == 1` there fabricated a leak on every one of those paths: `graph_balance_failures`
  // rose and `released_before_owner_scope_end` went false on a run whose teardown was in fact
  // perfect. `created != freed` still catches the wrap that is never freed (section 5.10's third
  // mutant) and `created > 1` still catches a wrap created twice, which is the other half of "one
  // lifetime for the whole run". A **successful** resident run keeps the original "exactly one"
  // reading, which is risk 9's guard against a run that silently streamed: it is stated as the
  // third clause rather than as the whole condition.
  if resident
    && (o.resident_wraps_created != o.resident_wraps_freed
      || o.resident_wraps_created > 1
      || (o.code.len() == 0 && o.resident_wraps_created != 1)) {
    o.graph_balance_failures = o.graph_balance_failures + 1
  }
  o.slot_capacity = ggml_ffi.slots_capacity(slot_view)
  o.slot_magic_ok = ggml_ffi.slots_ok(slot_view)
  // `graph.slot_high_water` is the **maximum over every graph this run built**, prefill and decode
  // alike, exactly as `--model-forward`'s is: `account` has raised it for each prefill graph, and
  // the decode pass's own maximum joins it here rather than replacing it. On a successful run the
  // decode pass is the higher of the two and the value is 66 (section 2.3); on a run that fails
  // inside the prefill it is the prefill's, which is the number the document should carry.
  if decoded.slot_high_water > o.slot_high_water { o.slot_high_water = decoded.slot_high_water }
  o.released_before_owner_scope_end =
  o.ggml_buffers_created == o.ggml_buffers_freed
    && o.contexts_created == o.contexts_freed
    && o.backends_created == o.backends_freed
    && o.gallocrs_created == o.gallocrs_freed
    && o.resident_wraps_created == o.resident_wraps_freed
    && o.graph_balance_failures == 0
  o.verdict = if o.code.len() > 0 {
    model_forward.VERDICT_UNAVAILABLE
  } else if o.member_placements > 0 && o.pointer_identity_failures == 0 {
    model_forward.VERDICT_EXTERNAL
  } else {
    model_forward.VERDICT_COPIED
  }
  // R6-KV-PERSIST section 2.6. The byte comparison against the source GGUF lives in the prefill
  // pass, so a **load** run never performs it — and a document that reported `IDENTICAL` after
  // comparing nothing would claim a pass this arm did not run. The prefill path is unchanged.
  if o.reference_present && o.code.len() == 0 && !loading {
    o.reference_verdict = model_forward.REFERENCE_IDENTICAL
  }
  // `elements_compared > 0` is asserted per step inside the loop's own verdict and again here over
  // the aggregate: section 6 risk 6's specific guard against a comparison that passes because it
  // compared nothing.
  if o.transcript_present && o.code.len() == 0 && o.oracle_elements <= 0 {
    fail(o, CODE_ORACLE_MISSING, "elements[0]")
    o.oracle_verdict = model_forward.ORACLE_FAIL
  }
  graphs = model_forward.GraphColumns { activation_bytes: activation.build() }
  publish(state, decoded, o)
}

// Section 2.9. The plane's and the step's measurements, copied into the one record the document is
// rendered from. They live in `model_forward.Outcome` rather than in a record of this module's own
// because at this pin a constructed record that wraps a local `Outcome` is
// "cannot return a view that borrows local storage", and a sixth `borrow mut` out-parameter is
// "cannot retain a shorter-lived view through this mutable borrow" at every call that also hands the
// callee a local. One outcome, one schedule.
fn publish(borrow p: Plane, borrow k: Decode, borrow mut o: model_forward.Outcome) {
  o.plane_bytes = p.bytes
  o.plane_stride = p.stride
  o.plane_layers = p.layers
  o.plane_columns_written = p.columns_written
  o.plane_readback_ns = p.readback_ns
  o.plane_upload_ns = p.upload_ns
  o.plane_roundtrip_verdict = p.roundtrip_verdict
  o.plane_roundtrip_bytes = p.roundtrip_bytes_compared
  o.plane_first_mismatch_layer = p.first_mismatch_layer
  o.plane_first_mismatch_tensor = p.first_mismatch_tensor
  o.plane_first_mismatch_column = p.first_mismatch_column
  o.plane_first_mismatch_step = p.first_mismatch_step
  o.decode_n_past = k.n_past
  o.decode_n_past_last = k.n_past_last
  o.decode_steps_requested = k.steps_requested
  o.decode_steps_completed = k.steps_completed
  o.decode_token_id = k.token_id
  o.decode_argmax = k.argmax
  sha_view: str := k.sha256
  o.decode_sha256 = sha_view.clone()
  o.decode_bit_sum = k.bit_sum
  o.decode_element_count = k.element_count
  o.decode_nonfinite_count = k.nonfinite_count
  o.decode_compute_ns = k.compute_ns
  o.decode_node_count = k.node_count
  o.decode_graph_count = k.graph_count
  o.decode_slot_high_water = k.slot_high_water
}

// ---------------------------------------------------------------------------------------------
// Steps 3 to 12 of section 2.8, in order
// ---------------------------------------------------------------------------------------------

// R5C section 6, correction C5's shape, for its reason. The plane's and the step's measurements are
// **returned by value** rather than reported through `borrow mut` out-parameters: at this pin the
// region checker merges the owners of a call's mutable borrows and invalidates all of them at the
// call, so a caller cannot read a sixth out-parameter afterwards. `Plane` and `Decode` hold only
// scalars and strings — no array, no view — so a record returned by value has nothing to invalidate.
// The four column sets stay out-parameters because they carry `array<i64>` built from callee locals,
// which is the case that cannot be returned at all.
fn execute_mode(
  pack_path: str,
  geometry_path: str,
  expected_geometry: str,
  borrow source_identity: alignpack.SourceIdentity,
  tokens_text: str,
  reference_path: str,
  transcript_path: str,
  width_text: str,
  logits_path: str,
  steps_text: str,
  kv_save_path: str,
  kv_load_path: str,
  resident_text: str,
  suffix_text: str,
  store_text: str,
  generation: bool,
  borrow eog_ids: array<i64>,
  generation_max: i64,
  borrow mut tokens: model_forward.TokenColumns,
  borrow mut schedule: model_forward.ScheduleColumns,
  borrow mut graphs: model_forward.GraphColumns,
  borrow mut top: model_forward.TopColumns,
  borrow mut stepped: model_forward.StepColumns,
) -> model_forward.Outcome {
  started := time.instant()
  mut o := model_forward.empty_outcome()
  o.device_kind = ggml_ffi.DEVICE_KIND_CPU
  o.logits_tolerance = model_forward.LOGIT_TOLERANCE_TEN_THOUSANDTHS
  o.logits_strict_reconciliation = true
  o.compare_transcript_elements = true
  o.fp_contract_off = ggml_ffi.fp_contract_off()
  o.reference_present = reference_path.len() > 0
  o.transcript_present = transcript_path.len() > 0
  o.logits_present = logits_path.len() > 0
  // Section 2.8: `decode.steps_requested` is published in **every** document, including one refused
  // before step 3b ever runs, so the count is never implicit in the output. The probe below only
  // publishes; the refusals stay exactly where the validation order puts them.
  probed := model_forward.parse_index(steps_text)
  if probed > 0 { o.decode_steps_requested = probed }
  // R6-KV-PERSIST section 2.8: the `kv` object is present in **every** document, including one
  // refused before the container exists, so the direction a run was asked for is never implicit in
  // the output.
  o.kv_save_requested = kv_save_path.len() > 0
  o.kv_load_requested = kv_load_path.len() > 0
  // R6-PREFIX-KEY section 2.7: `store.requested` is in **every** document too, so a caller who
  // expected reuse and mistyped the directory reads a document that says which run they got.
  o.store_requested = store_text != "-"
  kv_requested := o.kv_save_requested || o.kv_load_requested || o.store_requested
  // Step 2b. Not a copy, not save-then-load, not load-then-resave: a run that both restores a plane
  // and persists it is two capabilities sharing one invocation, and the second would persist a
  // plane it did not compute. It precedes every path-content check, so a run naming two paths is
  // refused before either is opened.
  if o.kv_save_requested && o.kv_load_requested {
    fail(o, kv_plane.CODE_ARGS, "kv[save+load]")
    o.elapsed_ns = time.instant() - started
    return o
  }
  // Step 2c (R6-PREFIX-SUFFIX-PREFILL section 2.7). **`SUFFIX` non-`-` requires `KV_LOAD`
  // non-`-`.** It is the arm's first conditional operand, and the rule precedes every path-content
  // check and every numeric parse, so a run whose operand combination is invalid is refused before
  // a file is opened and before `STEPS` or `SUFFIX` is parsed.
  //
  // `R6_KV_ARGS` is reused rather than a code minted: it already names "the operand combination
  // selecting the plane's provenance is invalid" and already carries one detail that distinguishes
  // its case. `SUFFIX` with `KV_SAVE` needs no separate rule — 2b has already established that
  // `KV_SAVE` and `KV_LOAD` are mutually exclusive, so a suffix beside a save implies no load and
  // is caught here with this detail.
  //
  // Allowing `SUFFIX` without `KV_LOAD` was considered and rejected: it is a second way to reach
  // `n_past > 0` with **no consumer** — a caller holding both lists in one process should
  // concatenate them and run one prefill — and it would double the closure matrix to save fixture
  // work.
  //
  // **R6-PREFIX-KEY section 2.5 widens this rule and records the reversal rather than performing it
  // quietly.** `SUFFIX` non-`-` now requires `KV_LOAD` **or `STORE`** non-`-`, because the consumer
  // the paragraph above says does not exist now does: a keyed **miss** must prefill `TOKENS`, save
  // that plane, and only then run the suffix — a miss that prefilled `TOKENS ++ SUFFIX` in one pass
  // would have no `T_prefix`-column plane to persist and the store would never fill. The reversal is
  // kept narrow: the caller still cannot express "prefill then suffix", because `STORE` decides the
  // provenance by lookup and not by operand, and `SUFFIX` with neither operand is refused unchanged.
  o.suffix_requested = suffix_text != "-"
  if o.suffix_requested && !o.kv_load_requested && !o.store_requested {
    fail(o, kv_plane.CODE_ARGS, "suffix[no_load]")
    o.elapsed_ns = time.instant() - started
    return o
  }
  // Step 2d (R6-PREFIX-KEY section 2.6). `STORE` is this arm's first **mutually exclusive** operand:
  // it is a third plane provenance and it must not compete with the two explicit ones. Like 2b and
  // 2c it precedes every path-content check, every numeric parse, and L0, so a run whose provenance
  // operands conflict is refused before a directory is touched and before a key is derived. The
  // order between the two details is the operands' own: `KV_SAVE` precedes `KV_LOAD`.
  //
  // **No new code is minted.** `R6_KV_ARGS` already names "the operand combination selecting the
  // plane's provenance is invalid" and already carries details that distinguish its cases.
  if o.store_requested && o.kv_save_requested {
    fail(o, kv_plane.CODE_ARGS, "store[with_save]")
    o.elapsed_ns = time.instant() - started
    return o
  }
  if o.store_requested && o.kv_load_requested {
    fail(o, kv_plane.CODE_ARGS, "store[with_load]")
    o.elapsed_ns = time.instant() - started
    return o
  }
  // R6-RESIDENT-WEIGHTS section 3.1. `-` is streaming and is what an absent operand means; the
  // empty string is **not** absence and is refused with everything else that is not `weights`. The
  // check precedes every path-content check, so a run naming an unknown residency mode is refused
  // before a file is opened, and `weights.mode` is published in that document too.
  resident := resident_text == "weights"
  o.resident_mode = resident
  if !resident && resident_text != "-" {
    fail(o, CODE_RESIDENT, resident_detail(resident_text))
    o.elapsed_ns = time.instant() - started
    return o
  }

  max_steps := if generation { 127 } else { layer_qwen2.MAX_DECODE_STEPS }
  g := stage_inputs(
    tokens_text, suffix_text, width_text, steps_text, geometry_path, expected_geometry, generation,
    kv_requested, max_steps,
    tokens, o)
  if o.code.len() > 0 {
    o.elapsed_ns = time.instant() - started
    return o
  }
  if generation {
    if generation_max < 1 || generation_max > 128
      || eog_ids.len() < 1 || eog_ids.len() > 256 {
      fail(o, CODE_TOKENS, "generation")
      o.elapsed_ns = time.instant() - started
      return o
    }
    if o.reconciliation_width > g.context_length {
      fail(o, CODE_KV_WIDTH, model_forward.labelled("kv_width", o.reconciliation_width))
      o.elapsed_ns = time.instant() - started
      return o
    }
    mut eog_at := 0
    loop {
      if eog_at >= eog_ids.len() { break }
      if eog_ids[eog_at] < 0 || eog_ids[eog_at] >= g.n_vocab {
        fail(o, CODE_TOKENS, model_forward.labelled("eog", eog_ids[eog_at]))
        o.elapsed_ns = time.instant() - started
        return o
      }
      eog_at = eog_at + 1
    }
  }
  // The suffix ids, re-parsed rather than carried out of `stage_inputs` through a third mutable
  // out-parameter: at this pin the region checker merges the owners of a call's mutable borrows and
  // invalidates all of them at the call, and `parse_tokens` is total, cheap, and already called
  // twice on this arm. Every bound it could fail is decided above, so this parse cannot fail here.
  mut suffix_ids: array_builder<i64> := array_builder()
  mut suffix_count := 0
  if o.suffix_requested {
    reparsed := layer_forward.parse_tokens(suffix_text, g.n_vocab)
    mut suffix_at := 0
    loop {
      if suffix_at >= reparsed.count { break }
      suffix_ids.push(reparsed.ids[suffix_at])
      suffix_at = suffix_at + 1
    }
    suffix_count = reparsed.count
  }
  suffix_tokens := model_forward.TokenColumns { count: suffix_count, ids: suffix_ids.build() }
  // Step 6b. `fs.create_rw` is `O_RDWR|O_CREAT|O_TRUNC` and `fs.create_exclusive` returns a
  // sequential `writer` with no `pwrite`, so there is **no exclusive positional constructor at this
  // pin** (Request 30, of which this is the second client). The check-then-create race between here
  // and W1 is named rather than hidden: hiding it behind a silent overwrite would be worse. A
  // destination that is a symlink is followed in both directions, exactly as alignpack's
  // `dest-symlink` case pins.
  if o.kv_save_requested && fs.exists(kv_save_path) {
    sanitized := model_forward.sanitize_summary_line(kv_save_path)
    sanitized_view: str := sanitized
    fail(o, kv_plane.CODE_EXISTS, sanitized_view)
    o.elapsed_ns = time.instant() - started
    return o
  }
  // Section 2.4's second identity input. The geometry's digest is over the **exact bytes**
  // `fs.read_file` returned, which is why the file is read again here rather than reconstructed
  // from the parsed record: a digest of a re-serialization would bind the container to this
  // repository's formatter and not to the document the caller supplied. It is one bounded read of a
  // file `stage_inputs` has already accepted.
  mut geometry_image: string := "".clone()
  if kv_requested {
    geometry_image = match fs.read_file(geometry_path) {
      Ok(value) => value,
      Err(failure) => {
        fail(o, CODE_GEOMETRY_UNREADABLE, model_forward.error_name(failure))
        o.elapsed_ns = time.instant() - started
        return o
      },
    }
  }
  geometry_image_view: str := geometry_image
  geometry_raw := crypto.sha256(geometry_image_view)
  geometry_digest := geometry_raw[0..geometry_raw.len()]
  width := o.reconciliation_width
  steps := o.decode_steps_requested
  table := layer_qwen2.mf_layer_member_table(g)
  pak := match fs.open_rw(pack_path) {
    Ok(handle) => handle,
    Err(failure) => {
      fail(o, "R4_PACK_UNREADABLE", model_forward.error_name(failure))
      o.elapsed_ns = time.instant() - started
      return o
    },
  }
  if generation {
    match alignpack.verify_source_identity_file(pak, source_identity) {
      Ok(_) => {},
      Err(_) => {
        fail(o, "R4_SOURCE_IDENTITY", "source_record")
        o.elapsed_ns = time.instant() - started
        return o
      },
    }
  }
  // Steps 7 and 8. The container, both ends, the coverage rule, every member record, and the window
  // sweep, taken as one **owned value**: section 2.8's order is `src/model_forward.align`'s and so
  // are its codes, and `stage_plan_owned` is that sequence in the shape a second arm can consume.
  staged := model_forward.stage_plan_owned(pak, g, table, tokens.count)
  o.format_version = staged.format_version
  o.block_align = staged.block_align
  o.member_align = staged.member_align
  o.block_count = staged.block_count
  o.member_count = staged.member_count
  o.total_bytes = staged.total_bytes
  o.payload_offset = staged.payload_offset
  o.reader_pread_count = staged.reader_pread_count
  o.reader_bytes_read = staged.reader_bytes_read
  o.embedding_block_index = staged.embed_block_index
  o.output_block_index = staged.output_block_index
  o.output_tied = staged.output_tied
  o.output_ggml_type = staged.output_ggml_type
  o.head_output_norm_bytes = staged.norm_nbytes
  o.head_output_bytes = staged.out_nbytes
  o.peak_block_index = staged.peak_block_index
  o.peak_block_kind = staged.peak_block_kind
  o.peak_block_layer = staged.peak_block_layer
  o.peak_block_bytes = staged.peak_block_bytes
  o.window_bytes = staged.window_bytes
  if staged.code.len() > 0 {
    staged_code: str := staged.code
    staged_detail: str := staged.detail
    fail(o, staged_code, staged_detail)
    o.elapsed_ns = time.instant() - started
    return o
  }
  // Step 7's addition. Model identity is the pack's own source-identity digest, read once, in one
  // bounded 32-byte `pread` at a header-declared offset. Recomputing a GGUF digest is not merely
  // expensive but **impossible at this pin**: `crypto.sha256` is one-shot over exactly one byte
  // view, so a 4.68 GB digest needs a 4.68 GB byte view (Request 29). What this does not claim is
  // stated in section 2.4: it certifies the pack's metadata region, not its payload, which is
  // `--pack-verify`'s question.
  mut pack_identity: buffer := buffer(kv_plane.DIGEST_BYTES)
  mut pack_counters := alignpack_read.new_counters()
  if kv_requested {
    if staged.source_record_offset < 0 {
      fail(o, "R4_PACK_HEADER", "source_record_offset")
      o.elapsed_ns = time.instant() - started
      return o
    }
    take_pack(o, alignpack_read.read_exact(
        pak, pack_identity, pack_counters, "R4_PACK_UNREADABLE",
        staged.source_record_offset + 48, kv_plane.DIGEST_BYTES))
    o.reader_pread_count = o.reader_pread_count + pack_counters.pread_count
    o.reader_bytes_read = o.reader_bytes_read + pack_counters.bytes_read
    if o.code.len() > 0 {
      o.elapsed_ns = time.instant() - started
      return o
    }
  } else {
    model_forward.fill_zero(pack_identity, kv_plane.DIGEST_BYTES)
  }
  pack_digest := pack_identity.bytes()
  if pack_digest.len() != kv_plane.DIGEST_BYTES {
    fail(o, "R4_WINDOW_UNAVAILABLE", "kv_identity")
    o.elapsed_ns = time.instant() - started
    return o
  }
  // Section 2.4. A pack whose source-identity digest is thirty-two zero bytes carries **no** model
  // identity, and an all-zero digest compares equal to the all-zero digest a container written
  // against such a pack would hold — so `R6_KV_IDENTITY("pack")` would pass over nothing. The
  // degenerate value is refused on both directions instead: a container is never written with an
  // identity that cannot distinguish one model from another, and one is never accepted on it.
  if kv_requested && kv_plane.all_zero(pack_digest) {
    fail(o, kv_plane.CODE_IDENTITY, "pack_absent")
    o.elapsed_ns = time.instant() - started
    return o
  }
  // ---------------------------------------------------------------------------------------------
  // Step L0 (R6-PREFIX-KEY sections 2.3 and 2.5). Derive the key, address one file, and branch.
  //
  // **It follows step 6a and every identity check above, and that ordering carries cases.**
  // `kv_width` and `token_count` are *in the preimage*, so deriving the key before step 6 validated
  // them would key on an unvalidated number; and the pack's own source digest is one of the three
  // digests, so it must be read and refused-if-degenerate first. A run refused anywhere above
  // publishes `store.requested` with `key: "-"` and `outcome: "absent"`, which says the refusal
  // preceded key derivation.
  //
  // **A miss is only a missing file.** If a file exists at the key path it is loaded through L1–L14
  // unchanged and **every** failure there is that check's refusal — never a silent re-prefill, which
  // would make a corrupt artifact indistinguishable from a bug in this arm's own writer.
  mut store_path_owned: string := "".clone()
  mut store_hit := false
  if o.store_requested {
    mut key_ids: buffer := buffer(tokens.count * 4)
    mut key_at := 0
    loop {
      if key_at >= tokens.count { break }
      key_ids.put_u32_le(model_forward.column_at(tokens.ids, key_at) as u32)
      key_at = key_at + 1
    }
    key_ids_view := key_ids.bytes()
    if key_ids_view.len() != tokens.count * 4 {
      fail(o, "R4_WINDOW_UNAVAILABLE", "store_tokens")
      o.elapsed_ns = time.instant() - started
      return o
    }
    // The three digests are the ones this run already computed: the key adds no new I/O and no new
    // digest of a large region, so Request 29 gains no client here.
    derived := kv_plane.derive_key(
      pack_digest, geometry_digest, key_ids_view, width, tokens.count, staged.total_bytes)
    if derived.len() != kv_plane.KEY_HEX_BYTES {
      fail(o, "R4_WINDOW_UNAVAILABLE", "store_key")
      o.elapsed_ns = time.instant() - started
      return o
    }
    derived_view: str := derived
    o.store_key = derived_view.clone()
    store_path_owned = kv_plane.store_path(store_text, derived_view)
    store_path_view: str := store_path_owned
    lookup_started := time.instant()
    store_hit = fs.exists(store_path_view)
    o.store_lookup_ns = time.instant() - lookup_started
    o.store_outcome = if store_hit { STORE_HIT } else { STORE_MISS }
    // From here the run **is** a load run or a save run of the existing paths, and every line below
    // is unchanged. `kv.load_requested`/`kv.save_requested` report the direction the lookup chose,
    // so a keyed hit is byte-comparable with an explicit `KV_LOAD` run and a keyed miss with an
    // explicit `KV_SAVE` one — which is what oracle K's exclusion list is written around.
    o.kv_load_requested = store_hit
    o.kv_save_requested = !store_hit
  }
  // Read out of the outcome **before** the call: at this pin a borrowed argument that reads a field
  // of the same record the call also borrows mutably aliases its owner (the `pack_total` idiom).
  store_miss := o.store_requested && !store_hit
  effective_save_path := if store_miss {
    store_path_view: str := store_path_owned
    store_path_view
  } else {
    kv_save_path
  }
  effective_load_path := if o.store_requested && store_hit {
    store_path_view: str := store_path_owned
    store_path_view
  } else {
    kv_load_path
  }
  window_bytes := staged.window_bytes
  residual_bytes := g.n_embd * tokens.count * 4
  logits_bytes := g.n_vocab * 4
  kv_span := width * g.n_head_kv * g.head_dim * 4
  mut readback_bytes := logits_bytes
  if g.n_ff * tokens.count * 4 > readback_bytes { readback_bytes = g.n_ff * tokens.count * 4 }
  if kv_span > readback_bytes { readback_bytes = kv_span }
  if residual_bytes > readback_bytes { readback_bytes = residual_bytes }
  o.residual_bytes = residual_bytes
  o.logits_bytes = logits_bytes
  // Step 8. The plane's size is a function of the geometry and the declared width, computed and
  // refused **before** a byte is reserved, so a malformed width cannot ask the process for a
  // terabyte.
  plane_bytes := plane_bytes_for(g, width)
  if plane_bytes <= 0 || plane_bytes > MAX_PLANE_BYTES {
    fail(o, CODE_PLANE_UNAVAILABLE, model_forward.labelled("plane", plane_bytes))
  }
  if o.code.len() == 0 && (residual_bytes <= 0 || residual_bytes > model_forward.MAX_WINDOW_BYTES) {
    fail(o, "R5_WINDOW_BUDGET", "residual")
  }
  if o.code.len() == 0 && (logits_bytes <= 0 || logits_bytes > model_forward.MAX_WINDOW_BYTES) {
    fail(o, "R5_WINDOW_BUDGET", "logits")
  }
  if o.code.len() > 0 {
    o.elapsed_ns = time.instant() - started
    return o
  }
  // R6-RESIDENT-WEIGHTS section 3.2. Streaming reserves the peak graph and refills it per graph;
  // residency reserves the **sum** and fills it once. Both are one `buffer`, one 32-byte-aligned
  // interior slice, and one length check on the observable consequence of a degraded reservation,
  // which is the only failure Request 35 leaves visible.
  layout := if resident {
    model_forward.plan_resident(staged.plan, staged.ends, staged.block_align)
  } else {
    model_forward.stream_layout(window_bytes, g.n_layer)
  }
  region_bytes := if resident { layout.bytes } else { window_bytes }
  o.resident_bytes = if resident { layout.bytes } else { 0 }
  // The budget, checked **before any allocation**, against the existing window ceiling and the
  // existing idiom. On the reference model 4,677,184,512 leaves 46 % headroom.
  if resident && (region_bytes <= 0 || region_bytes > model_forward.MAX_WINDOW_BYTES) {
    fail(o, CODE_RESIDENT_BUDGET, model_forward.labelled("bytes", region_bytes))
    o.elapsed_ns = time.instant() - started
    return o
  }
  mut weights: buffer := buffer(region_bytes + model_forward.MAX_TENSOR_ALIGNMENT)
  model_forward.fill_zero(weights, 1)
  pad := model_forward.MAX_TENSOR_ALIGNMENT
    - model_forward.base_mod(weights, model_forward.MAX_TENSOR_ALIGNMENT)
  model_forward.prime_window(weights, pad - 1 + region_bytes)
  weights_view := weights.bytes()
  if weights_view.len() != pad + region_bytes {
    fail(
      o, if resident { CODE_RESIDENT_UNAVAILABLE } else { "R4_WINDOW_UNAVAILABLE" }, "weights")
    o.elapsed_ns = time.instant() - started
    return o
  }
  window_view := weights_view[pad..pad + region_bytes]
  embed_members := model_forward.build_embed_members(g, staged.ends, tokens.count)
  head_members := model_forward.build_head_members(g, staged.ends)
  if !ggml_ffi.available() {
    fail(o, "R5_GGML_UNAVAILABLE", "stub")
    o.verdict = model_forward.VERDICT_UNAVAILABLE
    o.elapsed_ns = time.instant() - started
    return o
  }
  device := ggml_ffi.device_by_kind(ggml_ffi.DEVICE_KIND_CPU)
  if ggml_ffi.handle_absent(device) {
    fail(o, "R5_GGML_UNAVAILABLE", "device")
    o.verdict = model_forward.VERDICT_UNAVAILABLE
    o.elapsed_ns = time.instant() - started
    return o
  }
  o.device_name = ggml_ffi.device_text(device, ggml_ffi.DEVICE_TEXT_NAME)
  o.device_description = ggml_ffi.device_text(device, ggml_ffi.DEVICE_TEXT_DESCRIPTION)
  o.device_type_id = ggml_ffi.device_props(device, ggml_ffi.DEVICE_PROP_TYPE_ID)
  o.device_host_ptr = ggml_ffi.device_flag(device, ggml_ffi.DEVICE_PROP_HOST_PTR)
  o.device_host_buffer = ggml_ffi.device_flag(device, ggml_ffi.DEVICE_PROP_HOST_BUFFER)
  alignment := ggml_ffi.device_props(device, ggml_ffi.DEVICE_PROP_ALIGNMENT)
  o.device_buffer_alignment = if alignment > 0 { alignment } else { 0 }
  o.tensor_alignment = if alignment > 0 { alignment } else { 0 }
  o.table_drift = ggml_ffi.table_drift()
  if alignment <= 0 || alignment > model_forward.MAX_TENSOR_ALIGNMENT {
    fail(o, "R5_ABI", model_forward.labelled("alignment", alignment))
  }
  if o.code.len() == 0 && o.table_drift >= 0 {
    fail(o, "R5_ABI", model_forward.labelled("type", o.table_drift))
  }
  if o.code.len() == 0 {
    check_types(embed_members, -1, o)
    mut probe := 0
    loop {
      if probe >= g.n_layer || o.code.len() > 0 { break }
      probe_members := model_forward.build_layer_members(table, staged.plan, probe)
      check_types(probe_members, probe, o)
      probe = probe + 1
    }
  }
  if o.code.len() == 0 { check_types(head_members, g.n_layer, o) }
  if o.code.len() > 0 {
    o.elapsed_ns = time.instant() - started
    return o
  }
  context_bytes := ggml_ffi.graph_context_bytes(layer_qwen2.MAX_NODE_SLOTS)
  o.graph_context_bytes = context_bytes
  if context_bytes <= 0 {
    fail(o, "R5_ABI", model_forward.labelled("graph_context_bytes", context_bytes))
    o.elapsed_ns = time.instant() - started
    return o
  }
  schedule_decode(
    pak, g, table, staged.plan, staged.ends, tokens, suffix_tokens, embed_members, head_members,
    window_view,
    layout, resident, device,
    context_bytes, width, residual_bytes, logits_bytes, readback_bytes, reference_path,
    transcript_path, logits_path, effective_save_path, effective_load_path,
    store_miss, pack_digest, geometry_digest, steps,
    generation, eog_ids, generation_max,
    started, schedule, graphs, top, stepped, o)
  o.elapsed_ns = time.instant() - started
  return o
}

fn render_token_list(borrow ids: array<i64>) -> string {
  output := builder()
  mut at := 0
  loop {
    if at >= ids.len() { break }
    if at > 0 { output.write(",") }
    output.write_int(ids[at])
    at = at + 1
  }
  return output.to_string()
}

fn render_integer(value: i64) -> string {
  output := builder()
  output.write_int(value)
  return output.to_string()
}

pub GenerationParts {
  outcome: model_forward.Outcome,
  token_ids_json: string,
}

fn render_generation_ids(borrow o: model_forward.Outcome, borrow s: model_forward.StepColumns) -> string {
  output := builder()
  output.write("[")
  if o.code.len() == 0 {
    output.write_int(o.argmax)
    mut at := 0
    loop {
      if at >= s.count { break }
      output.write(",")
      output.write_int(s.argmax[at])
      at = at + 1
    }
  }
  output.write("]")
  return output.to_string()
}

fn generation_nonfinite_count(
  borrow o: model_forward.Outcome,
  borrow s: model_forward.StepColumns,
) -> i64 {
  if o.nonfinite_count > 0 { return o.nonfinite_count }
  mut at := 0
  loop {
    if at >= s.count { break }
    count := model_forward.column_at(s.nonfinite_count, at)
    if count > 0 { return count }
    at = at + 1
  }
  return 0
}

// R7-RUNTIME-PROVIDER's in-memory generation seam. It reuses the complete R6 schedule but carries
// a separate maximum into the loop, so `max_tokens == 1` can publish the prefill argmax without
// building a decode graph. Generation admits at most 127 internal steps while the legacy public
// step operand remains inside its shipped `1..=64` grammar.
pub fn generate_resident(
  pack_path: str,
  geometry_path: str,
  expected_geometry: str,
  source_identity: alignpack.SourceIdentity,
  borrow prompt_token_ids: array<i64>,
  borrow eog_token_ids: array<i64>,
  max_tokens: i64,
) -> GenerationParts {
  if prompt_token_ids.len() < 1 || prompt_token_ids.len() > layer_qwen2.MAX_PREFILL_TOKENS
    || eog_token_ids.len() < 1 || eog_token_ids.len() > 256
    || max_tokens < 1 || max_tokens > 128 {
    mut refused := model_forward.empty_outcome()
    fail(refused, CODE_TOKENS, "generation")
    return GenerationParts { outcome: refused, token_ids_json: "[]".clone() }
  }
  allocation_steps := if max_tokens > 1 { max_tokens - 1 } else { 1 }
  width := prompt_token_ids.len() + allocation_steps
  if width > layer_qwen2.MAX_ATTENTION_WIDTH {
    mut refused := model_forward.empty_outcome()
    fail(refused, CODE_KV_WIDTH, model_forward.labelled("kv_width", width))
    return GenerationParts { outcome: refused, token_ids_json: "[]".clone() }
  }
  token_text := render_token_list(prompt_token_ids)
  width_text := render_integer(width)
  steps_text := render_integer(allocation_steps)
  token_view: str := token_text
  width_view: str := width_text
  steps_view: str := steps_text
  mut tokens := model_forward.empty_tokens()
  mut schedule := model_forward.empty_schedule()
  mut graphs := model_forward.empty_graphs()
  mut top := model_forward.empty_top()
  mut stepped := model_forward.empty_steps()
  mut outcome := execute_mode(
    pack_path, geometry_path, expected_geometry, source_identity,
    token_view, "", "", width_view, "", steps_view, "", "",
    "weights", "-", "-", true, eog_token_ids, max_tokens,
    tokens, schedule, graphs, top, stepped)
  if outcome.code.len() == 0 {
    nonfinite := generation_nonfinite_count(outcome, stepped)
    if nonfinite > 0 {
      fail(outcome, "R5_LOGITS_NONFINITE", model_forward.labelled("elements", nonfinite))
    }
  }
  token_ids_json := render_generation_ids(outcome, stepped)
  return GenerationParts { outcome: outcome, token_ids_json: token_ids_json }
}

// The shipped diagnostic API and CLI keep their exact step semantics and pass an empty EOG set to
// the shared implementation. No generated-text rule is observable on this path.
pub fn execute(
  pack_path: str,
  geometry_path: str,
  tokens_text: str,
  reference_path: str,
  transcript_path: str,
  width_text: str,
  logits_path: str,
  steps_text: str,
  kv_save_path: str,
  kv_load_path: str,
  resident_text: str,
  suffix_text: str,
  store_text: str,
  borrow mut tokens: model_forward.TokenColumns,
  borrow mut schedule: model_forward.ScheduleColumns,
  borrow mut graphs: model_forward.GraphColumns,
  borrow mut top: model_forward.TopColumns,
  borrow mut stepped: model_forward.StepColumns,
) -> model_forward.Outcome {
  eog_ids := model_forward.empty_array()
  source_identity := alignpack.empty_source_identity()
  return execute_mode(
    pack_path, geometry_path, "", source_identity,
    tokens_text, reference_path, transcript_path, width_text, logits_path,
    steps_text, kv_save_path, kv_load_path, resident_text, suffix_text, store_text, false, eog_ids, 0,
    tokens, schedule, graphs, top, stepped)
}

// ---------------------------------------------------------------------------------------------
// The document (section 2.9)
//
// R5B's document with three additions — a `plane` object, a `decode` object, and `oracle_decode` —
// and every block that means the same thing is rendered by `src/model_forward.align` rather than
// restated here. No float is ever on the wire: `sha256` is over the exact little-endian f32 bytes,
// `bit_sum` over the same, and every tolerance is an integer count of ten-thousandths.
// ---------------------------------------------------------------------------------------------

pub fn render_plane(borrow p: model_forward.Outcome) -> string {
  d := builder()
  // R6-KV-PERSIST section 2.8. Where the plane came from, in every document: `"PREFILL"` when this
  // process computed it, `"LOADED"` when a container supplied it, `"-"` when it does not exist.
  d.write("{\"source\":")
  d.write(model_forward.json_string(plane_source_label(p.plane_source)))
  d.write(",\"bytes\":")
  d.write_int(p.plane_bytes)
  d.write(",\"stride\":")
  d.write_int(p.plane_stride)
  d.write(",\"layers\":")
  d.write_int(p.plane_layers)
  d.write(",\"columns_written\":")
  d.write_int(p.plane_columns_written)
  d.write(",\"readback_ns\":")
  d.write_int(p.plane_readback_ns)
  d.write(",\"upload_ns\":")
  d.write_int(p.plane_upload_ns)
  d.write(",\"roundtrip_verdict\":")
  d.write(model_forward.json_string(roundtrip_label(p.plane_roundtrip_verdict)))
  d.write(",\"roundtrip_bytes_compared\":")
  d.write_int(p.plane_roundtrip_bytes)
  d.write(",\"first_mismatch_layer\":")
  d.write_int(p.plane_first_mismatch_layer)
  d.write(",\"first_mismatch_tensor\":")
  d.write(model_forward.json_string(plane_tensor_label(p.plane_first_mismatch_tensor)))
  d.write(",\"first_mismatch_column\":")
  d.write_int(p.plane_first_mismatch_column)
  d.write(",\"first_mismatch_step\":")
  d.write_int(p.plane_first_mismatch_step)
  d.write("}")
  return d.to_string()
}

// R6-STEP-N section 2.9. `decode` at schema 2 is **loop-level only**: a count, two bounds, the id
// chain, and four aggregates. The scalars schema 1 published about *the* step are gone, because
// there is no longer exactly one, and they are in `steps[]` instead.
//
// `token_ids` duplicates `steps[i].token_id` on purpose, so the gate can read one array without
// walking objects; the smoke asserts the two agree on every case. It is the field gate G reads and
// it holds `d_1 .. d_M` — the tokens the completed steps **consumed** — so `token_ids[0]` is the
// prefill's own argmax and `steps[M].argmax` is the one id this arm computes and nothing gates.
pub fn render_decode(borrow k: model_forward.Outcome, borrow steps: model_forward.StepColumns) -> string {
  d := builder()
  d.write("{\"steps_requested\":")
  d.write_int(k.decode_steps_requested)
  d.write(",\"steps_completed\":")
  d.write_int(k.decode_steps_completed)
  d.write(",\"n_past_first\":")
  d.write_int(k.decode_n_past)
  d.write(",\"n_past_last\":")
  d.write_int(k.decode_n_past_last)
  d.write(",\"token_ids\":[")
  mut at := 0
  loop {
    if at >= steps.count { break }
    if at > 0 { d.write(",") }
    d.write_int(model_forward.column_at(steps.token_id, at))
    at = at + 1
  }
  d.write("],\"graph_count\":")
  d.write_int(k.decode_graph_count)
  d.write(",\"node_count\":")
  d.write_int(k.decode_node_count)
  d.write(",\"slot_high_water\":")
  d.write_int(k.decode_slot_high_water)
  d.write(",\"compute_ns\":")
  d.write_int(k.decode_compute_ns)
  d.write("}")
  return d.to_string()
}

// R6-STEP-N section 2.9's `steps[]`. One object per **completed** step, ordered by `index`,
// ascending, with no gaps. A partial step publishes no object.
pub fn render_steps(borrow s: model_forward.StepColumns) -> string {
  d := builder()
  mut at := 0
  loop {
    if at >= s.count { break }
    if at > 0 { d.write(",") }
    d.write("{\"index\":")
    d.write_int(at + 1)
    d.write(",\"n_past\":")
    d.write_int(model_forward.column_at(s.n_past, at))
    d.write(",\"token_id\":")
    d.write_int(model_forward.column_at(s.token_id, at))
    d.write(",\"argmax\":")
    d.write_int(model_forward.column_at(s.argmax, at))
    d.write(",\"sha256\":")
    d.write(model_forward.json_string(model_forward.step_digest_at(s, at)))
    d.write(",\"bit_sum\":")
    d.write_int(model_forward.column_at(s.bit_sum, at))
    d.write(",\"element_count\":")
    d.write_int(model_forward.column_at(s.element_count, at))
    d.write(",\"nonfinite_count\":")
    d.write_int(model_forward.column_at(s.nonfinite_count, at))
    d.write(",\"compute_ns\":")
    d.write_int(model_forward.column_at(s.compute_ns, at))
    d.write(",\"node_count\":")
    d.write_int(model_forward.column_at(s.node_count, at))
    d.write(",\"plane_column_written\":")
    d.write_int(model_forward.column_at(s.plane_column, at))
    d.write(",\"oracle\":{\"verdict\":")
    d.write(model_forward.json_string(
        model_forward.oracle_label(model_forward.column_at(s.oracle_verdict, at))))
    d.write(",\"max_abs_diff_ten_thousandths\":")
    d.write_int(model_forward.column_at(s.oracle_max_abs, at))
    d.write(",\"max_sum_diff_millionths\":")
    d.write_int(model_forward.column_at(s.oracle_max_sum, at))
    d.write(",\"elements_compared\":")
    d.write_int(model_forward.column_at(s.oracle_elements, at))
    d.write(",\"nodes_matched\":")
    d.write_int(model_forward.column_at(s.oracle_nodes_matched, at))
    d.write(",\"nodes_expected\":")
    d.write_int(model_forward.column_at(s.oracle_nodes_expected, at))
    d.write(",\"layers_matched\":")
    d.write_int(model_forward.column_at(s.oracle_layers, at))
    d.write(",\"worst_layer\":")
    d.write_int(model_forward.column_at(s.oracle_worst_layer, at))
    d.write(",\"worst_node\":")
    d.write(model_forward.json_string(model_forward.step_worst_node_at(s, at)))
    d.write(",\"instrument_graph\":")
    d.write_int(model_forward.column_at(s.oracle_graph, at))
    d.write("}}")
    at = at + 1
  }
  return d.to_string()
}

// Oracle A''s aggregate block. `instrument_graph_first` is `2` and `instrument_graph_last` is
// `N + 1`, and both say so on the wire: R6-STEP-N section 3.1's whole correctness argument is that
// step `k` is compared against llama.cpp's **decode** graph `k + 1`, and a reader should not have to
// know that to trust the verdict. The per-step `instrument_graph` in `steps[]` is the same claim,
// asserted step by step.
pub fn render_oracle_decode(borrow o: model_forward.Outcome) -> string {
  d := builder()
  d.write("{\"present\":")
  d.write(model_forward.bool_text(o.transcript_present))
  d.write(",\"verdict\":")
  d.write(model_forward.json_string(model_forward.oracle_label(o.oracle_verdict)))
  d.write(",\"instrument\":")
  d.write(model_forward.json_string("llama-eval-callback"))
  d.write(",\"steps_compared\":")
  d.write_int(o.decode_oracle_steps_compared)
  d.write(",\"worst_step\":")
  d.write_int(o.decode_oracle_worst_step)
  d.write(",\"instrument_graph_first\":2")
  d.write(",\"instrument_graph_last\":")
  d.write_int(o.decode_oracle_graph_last)
  d.write(",\"instrument_kv_width\":")
  d.write_int(o.reconciliation_width)
  d.write(",\"layers_expected\":")
  d.write_int(o.oracle_layers_expected)
  d.write(",\"layers_matched\":")
  d.write_int(o.oracle_layers_matched)
  d.write(",\"nodes_expected\":")
  d.write_int(o.oracle_expected)
  d.write(",\"nodes_matched\":")
  d.write_int(o.oracle_matched)
  d.write(",\"elements_compared\":")
  d.write_int(o.oracle_elements)
  d.write(",\"max_abs_diff_ten_thousandths\":")
  d.write_int(o.oracle_max_abs)
  d.write(",\"max_sum_diff_millionths\":")
  d.write_int(o.oracle_max_sum)
  d.write(",\"tolerance_ten_thousandths\":")
  d.write_int(model_forward.TOLERANCE_TEN_THOUSANDTHS)
  d.write(",\"sum_tolerance_millionths\":")
  d.write_int(model_forward.SUM_TOLERANCE_MILLIONTHS)
  d.write(",\"sum_tolerance_relative_ppm\":")
  d.write_int(model_forward.SUM_TOLERANCE_RELATIVE_PPM)
  d.write(",\"worst_layer\":")
  d.write_int(o.oracle_worst_layer)
  d.write(",\"worst_node\":")
  worst_view: str := o.oracle_worst_node
  d.write(model_forward.json_string(worst_view))
  d.write(",\"worst_element_index\":")
  d.write_int(o.oracle_worst_element)
  d.write(",\"transcript_lines\":")
  d.write_int(o.oracle_lines)
  d.write(",\"transcript_callback_lines\":")
  d.write_int(o.oracle_callback_lines)
  d.write("}")
  return d.to_string()
}

// R6-KV-PERSIST section 2.8's `kv` object, in declaration order. It is present in **every**
// document with **one shape at every arity**, so a reader never has to ask which operands were
// supplied before it knows which fields exist.
//
// **It publishes no path.** R6-STEP-N risk 5 names the temp-path golden class and schema 2 was
// verified free of it; schema 3 keeps that property. `kv.destination` publishes a verdict word,
// never a name.
pub fn render_kv(borrow o: model_forward.Outcome) -> string {
  d := builder()
  d.write("{\"save_requested\":")
  d.write_int(if o.kv_save_requested { 1 } else { 0 })
  d.write(",\"load_requested\":")
  d.write_int(if o.kv_load_requested { 1 } else { 0 })
  d.write(",\"verdict\":")
  d.write(model_forward.json_string(kv_plane.verdict_label(o.kv_verdict)))
  d.write(",\"destination\":")
  d.write(model_forward.json_string(kv_plane.destination_label(o.kv_destination)))
  d.write(",\"format_version\":")
  d.write_int(o.kv_format_version)
  d.write(",\"plane_layout_version\":")
  d.write_int(o.kv_plane_layout_version)
  d.write(",\"total_bytes\":")
  d.write_int(o.kv_total_bytes)
  d.write(",\"header_bytes\":")
  d.write_int(o.kv_header_bytes)
  d.write(",\"plane_offset\":")
  d.write_int(o.kv_plane_offset)
  d.write(",\"plane_bytes\":")
  d.write_int(o.kv_plane_bytes)
  d.write(",\"logits_bytes\":")
  d.write_int(o.kv_logits_bytes)
  d.write(",\"columns_persisted\":")
  d.write_int(o.kv_columns_persisted)
  d.write(",\"token_count\":")
  d.write_int(o.kv_token_count)
  d.write(",\"n_vocab\":")
  d.write_int(o.kv_n_vocab)
  d.write(",\"prefill_argmax\":")
  d.write_int(o.kv_prefill_argmax)
  d.write(",\"pack_total_bytes\":")
  d.write_int(o.kv_pack_total_bytes)
  d.write(",\"source_header_region_sha256\":")
  d.write(model_forward.json_string(hex_or_dash(o.kv_source_sha256)))
  d.write(",\"geometry_sha256\":")
  d.write(model_forward.json_string(hex_or_dash(o.kv_geometry_sha256)))
  d.write(",\"tokens_sha256\":")
  d.write(model_forward.json_string(hex_or_dash(o.kv_tokens_sha256)))
  d.write(",\"logits_sha256\":")
  d.write(model_forward.json_string(hex_or_dash(o.kv_logits_sha256)))
  d.write(",\"plane_sha256\":")
  d.write(model_forward.json_string(hex_or_dash(o.kv_plane_sha256)))
  d.write(",\"write_ns\":")
  d.write_int(o.kv_write_ns)
  d.write(",\"read_ns\":")
  d.write_int(o.kv_read_ns)
  d.write("}")
  return d.to_string()
}

// R6-PREFIX-SUFFIX-PREFILL section 2.9's `suffix` object, in declaration order. It is present in
// **every** document with **one shape at every arity**, so a reader never has to ask which operands
// were supplied before it knows which fields exist — and, in particular, never has to ask whether
// `output` describes the container's vector or this run's own suffix pass.
//
// **It publishes no path and no token list.** R6-STEP-N risk 5 names the temp-path golden class;
// schemas 3 and 4 were verified free of it and schema 5 keeps the property.
//
// Only `compute_ns` is normalized away by the smoke. The other ten are deterministic and they are
// the contract: `columns_written` is what a partial pass must not advance, `sequence_length` is what
// a reader compares against a single-shot run's `selection.token_count`, and `pack_bytes` is exactly
// zero on the resident leg.
pub fn render_suffix(borrow o: model_forward.Outcome) -> string {
  d := builder()
  d.write("{\"requested\":")
  d.write_int(if o.suffix_requested { 1 } else { 0 })
  d.write(",\"completed\":")
  d.write_int(if o.suffix_completed { 1 } else { 0 })
  d.write(",\"token_count\":")
  d.write_int(o.suffix_token_count)
  d.write(",\"n_past_base\":")
  d.write_int(o.suffix_n_past_base)
  d.write(",\"sequence_length\":")
  d.write_int(o.suffix_sequence_length)
  d.write(",\"columns_written\":")
  d.write_int(o.suffix_columns_written)
  d.write(",\"first_column\":")
  d.write_int(o.suffix_first_column)
  d.write(",\"graph_count\":")
  d.write_int(o.suffix_graph_count)
  d.write(",\"node_count\":")
  d.write_int(o.suffix_node_count)
  d.write(",\"pack_bytes\":")
  d.write_int(o.suffix_pack_bytes)
  d.write(",\"compute_ns\":")
  d.write_int(o.suffix_compute_ns)
  d.write("}")
  return d.to_string()
}

// R6-PREFIX-KEY section 2.7's `store` object, in declaration order, present in **every** document
// including error documents — so "this run missed" is never silent and a caller who mistyped the
// directory reads a document that says which run they got.
//
// **It publishes no path, and that is a decision** (section 2.7): `kv` publishes none today and the
// goldens depend on it, and a `mktemp -d` name could not be pinned. The **key** is a digest of the
// pack's identity record, the geometry's bytes, and the ids, so it is golden-stable on the hosted
// fixture and on the real model alike; a caller that wants the file forms
// `STORE + "/" + key + ".akvp"` itself.
//
// `container_bytes` is `kv.total_bytes` restated so the object is readable alone — read on a hit,
// written on a miss, `0` otherwise. Only `lookup_ns` is a clock, and section 2.9 records that no
// claim is derived from it.
pub fn render_store(borrow o: model_forward.Outcome) -> string {
  d := builder()
  d.write("{\"requested\":")
  d.write_int(if o.store_requested { 1 } else { 0 })
  d.write(",\"key\":")
  d.write(model_forward.json_string(hex_or_dash(o.store_key)))
  d.write(",\"outcome\":")
  d.write(model_forward.json_string(store_outcome_label(o.store_outcome)))
  d.write(",\"saved\":")
  d.write_int(if o.store_saved { 1 } else { 0 })
  d.write(",\"container_bytes\":")
  d.write_int(if o.store_requested { o.kv_total_bytes } else { 0 })
  d.write(",\"lookup_ns\":")
  d.write_int(o.store_lookup_ns)
  d.write("}")
  return d.to_string()
}

fn hex_or_dash(borrow value: string) -> str {
  view: str := value
  if view.len() == 0 { return "-" }
  return view
}

// `src/model_forward.align`'s `timings` block plus this capability's own diagnostic. It is written
// here rather than there for the reason section 5.3 predicts in bytes: `--model-forward`,
// `--model-forward-gpu`, `--layer-forward`, and `--moe-layer-forward` share that renderer, and
// adding a field to it would move four goldens this capability promises are byte-unchanged.
// R6-RESIDENT-WEIGHTS section 3.5. The `weights` object, present in **every** document including
// error documents, so the mode a run took is never implicit. `step_pack_bytes` is the capability's
// primary metric: it is a counter and not a clock, it is identical across runs, and it is exactly
// zero in resident mode.
pub fn render_weights(borrow o: model_forward.Outcome) -> string {
  d := builder()
  d.write("{\"mode\":")
  d.write(model_forward.json_string(if o.resident_mode { "resident" } else { "stream" }))
  d.write(",\"resident_bytes\":")
  d.write_int(o.resident_bytes)
  d.write(",\"fill_ns\":")
  d.write_int(o.resident_fill_ns)
  d.write(",\"fill_pread_count\":")
  d.write_int(o.resident_fill_pread_count)
  d.write(",\"fill_bytes\":")
  d.write_int(o.resident_fill_bytes)
  d.write(",\"step_pack_bytes\":")
  d.write_int(o.step_pack_bytes)
  d.write(",\"wrap_count\":")
  d.write_int(o.wrap_count)
  d.write(",\"resident_wraps_created\":")
  d.write_int(o.resident_wraps_created)
  d.write(",\"resident_wraps_freed\":")
  d.write_int(o.resident_wraps_freed)
  d.write("}")
  return d.to_string()
}

pub fn render_timings_step(borrow o: model_forward.Outcome) -> string {
  d := builder()
  d.write("{\"pread_ns\":")
  d.write_int(o.pread_ns)
  d.write(",\"build_ns\":")
  d.write_int(o.build_ns)
  d.write(",\"reserve_ns\":")
  d.write_int(o.reserve_ns)
  d.write(",\"compute_ns\":")
  d.write_int(o.compute_ns)
  d.write(",\"reconciliation_compute_ns\":")
  d.write_int(o.reconciliation_compute_ns)
  d.write(",\"reference_compute_ns\":")
  d.write_int(o.reference_compute_ns)
  d.write(",\"oracle_ns\":")
  d.write_int(o.oracle_ns)
  d.write(",\"first_token_ns\":")
  d.write_int(o.first_token_ns)
  d.write(",\"elapsed_ns\":")
  d.write_int(o.elapsed_ns)
  d.write("}")
  return d.to_string()
}

fn render_prologue(
  borrow o: model_forward.Outcome,
  pack_path: str,
  geometry_path: str,
  reference_path: str,
  transcript_path: str,
  logits_path: str,
) -> string {
  failed := o.code.len() > 0
  code_view: str := o.code
  detail_view: str := o.detail
  d := builder()
  d.write("{\"schema_version\":")
  d.write_int(SCHEMA_VERSION)
  d.write(",\"kind\":")
  d.write(model_forward.json_string(DOCUMENT_KIND))
  d.write(",\"pack_path\":")
  d.write(model_forward.json_string(pack_path))
  d.write(",\"geometry_path\":")
  d.write(model_forward.json_string(geometry_path))
  d.write(",\"reference_path\":")
  d.write(model_forward.json_string(reference_path))
  d.write(",\"transcript_path\":")
  d.write(model_forward.json_string(transcript_path))
  d.write(",\"logits_path\":")
  d.write(model_forward.json_string(logits_path))
  d.write(",\"status\":")
  d.write(model_forward.json_string(if failed { "error" } else { "ok" }))
  d.write(",\"error_code\":")
  d.write(model_forward.json_string(code_view))
  d.write(",\"error_detail\":")
  d.write(model_forward.json_string(detail_view))
  d.write(",\"verdict\":")
  d.write(model_forward.json_string(model_forward.verdict_label(o.verdict)))
  d.write(",\"pack\":{\"format_version\":")
  d.write_int(o.format_version)
  d.write(",\"block_align\":")
  d.write_int(o.block_align)
  d.write(",\"member_align\":")
  d.write_int(o.member_align)
  d.write(",\"block_count\":")
  d.write_int(o.block_count)
  d.write(",\"member_count\":")
  d.write_int(o.member_count)
  d.write(",\"total_bytes\":")
  d.write_int(o.total_bytes)
  d.write(",\"payload_offset\":")
  d.write_int(o.payload_offset)
  d.write(",\"reader_pread_count\":")
  d.write_int(o.reader_pread_count)
  d.write(",\"reader_bytes_read\":")
  d.write_int(o.reader_bytes_read)
  d.write("},")
  return d.to_string()
}

pub fn render(
  borrow o: model_forward.Outcome,
  borrow tokens: model_forward.TokenColumns,
  borrow schedule: model_forward.ScheduleColumns,
  borrow graphs: model_forward.GraphColumns,
  borrow top: model_forward.TopColumns,
  borrow stepped: model_forward.StepColumns,
  pack_path: str,
  geometry_path: str,
  reference_path: str,
  transcript_path: str,
  logits_path: str,
) -> string {
  prologue := render_prologue(o, pack_path, geometry_path, reference_path, transcript_path, logits_path)
  prologue_view: str := prologue
  header := model_forward.render_head(o, tokens)
  header_view: str := header
  rows := model_forward.render_schedule(schedule)
  rows_view: str := rows
  window := model_forward.render_window_object(o)
  window_view: str := window
  graph := model_forward.render_graph_object(o, graphs)
  graph_view: str := graph
  plane := render_plane(o)
  plane_view: str := plane
  step := render_decode(o, stepped)
  step_view: str := step
  rows_of_steps := render_steps(stepped)
  rows_of_steps_view: str := rows_of_steps
  head := model_forward.render_output(o, top)
  head_view: str := head
  reference := model_forward.render_reference(o)
  reference_view: str := reference
  oracle := render_oracle_decode(o)
  oracle_view: str := oracle
  logits := model_forward.render_logits_oracle(o)
  logits_view: str := logits
  kv := render_kv(o)
  kv_view: str := kv
  suffix := render_suffix(o)
  suffix_view: str := suffix
  store := render_store(o)
  store_view: str := store
  weights := render_weights(o)
  weights_view: str := weights
  timings := render_timings_step(o)
  timings_view: str := timings
  lifetime := model_forward.render_lifetime_abi(o)
  lifetime_view: str := lifetime
  d := builder()
  d.write(prologue_view)
  d.write(header_view)
  d.write(",\"schedule\":[")
  d.write(rows_view)
  d.write("],\"window\":")
  d.write(window_view)
  d.write(",\"graph\":")
  d.write(graph_view)
  d.write(",\"plane\":")
  d.write(plane_view)
  d.write(",\"decode\":")
  d.write(step_view)
  d.write(",\"steps\":[")
  d.write(rows_of_steps_view)
  d.write("],\"head\":")
  d.write(head_view)
  d.write(",\"reference\":")
  d.write(reference_view)
  d.write(",\"oracle_decode\":")
  d.write(oracle_view)
  d.write(",\"oracle_logits\":")
  d.write(logits_view)
  d.write(",\"kv\":")
  d.write(kv_view)
  d.write(",\"suffix\":")
  d.write(suffix_view)
  d.write(",\"store\":")
  d.write(store_view)
  d.write(",\"weights\":")
  d.write(weights_view)
  d.write(",\"timings\":")
  d.write(timings_view)
  d.write(",\"lifetime\":")
  d.write(lifetime_view)
  d.write("}")
  return d.to_string()
}

// ---------------------------------------------------------------------------------------------
// The summary block and the CLI adapter (section 2.1)
// ---------------------------------------------------------------------------------------------

fn print_summary(
  borrow o: model_forward.Outcome,
  borrow tokens: model_forward.TokenColumns,
  pack_path: str,
) {
  failed := o.code.len() > 0
  print("decode step:")
  print("status:")
  if failed { print("ERROR") } else { print("OK") }
  print("verdict:")
  print(model_forward.verdict_label(o.verdict))
  print("pack path:")
  sanitized_path := model_forward.sanitize_summary_line(pack_path)
  sanitized_path_view: str := sanitized_path
  print(sanitized_path_view)
  print("schema:")
  print(SCHEMA_VERSION)
  print("arch:")
  arch_view: str := o.arch
  sanitized_arch := model_forward.sanitize_summary_line(arch_view)
  sanitized_arch_view: str := sanitized_arch
  print(sanitized_arch_view)
  print("layers:")
  print(o.n_layer)
  print("tokens:")
  rendered_ids := model_forward.render_token_list(tokens)
  rendered_ids_view: str := rendered_ids
  print(rendered_ids_view)
  print("kv width:")
  print(o.reconciliation_width)
  print("n_past:")
  print(o.decode_n_past)
  print("steps requested:")
  print(o.decode_steps_requested)
  print("steps completed:")
  print(o.decode_steps_completed)
  print("last n_past:")
  print(o.decode_n_past_last)
  print("plane bytes:")
  print(o.plane_bytes)
  print("plane layers:")
  print(o.plane_layers)
  print("plane source:")
  print(plane_source_label(o.plane_source))
  print("kv verdict:")
  print(kv_plane.verdict_label(o.kv_verdict))
  print("kv destination:")
  print(kv_plane.destination_label(o.kv_destination))
  print("kv container bytes:")
  print(o.kv_total_bytes)
  print("store outcome:")
  print(store_outcome_label(o.store_outcome))
  print("store key:")
  print(hex_or_dash(o.store_key))
  print("suffix tokens:")
  print(o.suffix_token_count)
  print("suffix base:")
  print(o.suffix_n_past_base)
  print("suffix columns:")
  print(o.suffix_columns_written)
  print("first token ns:")
  print(o.first_token_ns)
  print("plane roundtrip:")
  print(roundtrip_label(o.plane_roundtrip_verdict))
  print("plane bytes compared:")
  print(o.plane_roundtrip_bytes)
  print("prefill logits sha256:")
  sha_view: str := o.sha256
  print(sha_view)
  print("last decode logits sha256:")
  decode_sha_view: str := o.decode_sha256
  print(decode_sha_view)
  print("last decode argmax:")
  print(o.decode_argmax)
  print("decode transcript:")
  print(model_forward.oracle_label(o.oracle_verdict))
  print("max abs diff:")
  print(o.oracle_max_abs)
  print("prefill logits oracle:")
  print(model_forward.logits_label(o.logits_verdict))
  print("graph nodes:")
  print(o.node_count_total + o.decode_node_count)
  print("slot high water:")
  print(o.slot_high_water)
  print("released:")
  print(o.ggml_buffers_freed + o.contexts_freed + o.backends_freed + o.gallocrs_freed)
  print("elapsed ns:")
  print(o.elapsed_ns)
  if failed {
    print("error:")
    code_view: str := o.code
    print(code_view)
    print("detail:")
    detail_view: str := o.detail
    sanitized_detail := model_forward.sanitize_summary_line(detail_view)
    sanitized_detail_view: str := sanitized_detail
    print(sanitized_detail_view)
  }
}

// R6-STEP-N section 2.2, R6-KV-PERSIST section 2.2, R6-RESIDENT-WEIGHTS section 3.1,
// R6-PREFIX-SUFFIX-PREFILL section 2.2, and R6-PREFIX-KEY section 2.2: exactly five, six, seven,
// nine, ten, eleven, twelve, thirteen, fourteen, fifteen, **or sixteen** operands. **Eight is still
// refused**, inherited verbatim from
// `--model-forward`'s rule and for R6's own reason: `KV_WIDTH` travels with the transcript, so a
// transcript without a width refuses itself.
//
// **A wrong arity produces no document and no error code**, and that is stated here because three
// prior documents in this family present `R6_ARITY` and `R6_PATH` in validation tables as though
// they were emitted. They are prose names in these comments: `run` returns `Err(Error.Invalid)`,
// the process exits non-zero, and stdout is empty. The smoke asserts these cases as `NO_DOCUMENT`
// rows carrying no golden bytes.
//
// `SUFFIX` is `args[14]`, the fifteenth operand, and is last for the reason `STEPS` and `RESIDENT`
// were: every earlier position is spoken for and moving one would change the meaning of an existing
// invocation silently. It is a comma-separated token id list in `TOKENS`' own grammar, or `-` for
// absent, and it is legal **only with `KV_LOAD`** (step 2c). Its hazard — a caller who wants a
// suffix and forgets the operand silently gets a plain load run — is closed by publishing
// `suffix.requested` in **every** document, including error documents.
//
// `RESIDENT` is `args[13]`, the fourteenth operand. R6-RESIDENT-WEIGHTS section 3.1 designed it at
// `args[11]` against a head where `STEPS` was last; `R6-KV-PERSIST` took `args[11]` and `args[12]`
// for `KV_SAVE` and `KV_LOAD` before this capability was implemented, and section 9.4 fixed the
// merge order that makes that so. Taking the next free position rather than displacing either is
// the same rule `STEPS` followed: every earlier position is spoken for and moving one would change
// the meaning of an existing invocation silently. Section 11 of that document records the change.
//
// `RESIDENT` is `-` (stream the weights, the shipped behaviour, and what an absent operand means)
// or `weights` (hold the whole weight set resident for the process's lifetime). Its hazard — a
// caller who wants residency and forgets the operand silently gets streaming — is closed by
// publishing `weights.mode` in **every** document, including error documents. It takes no path
// check because it is not a path.
//
// `KV_SAVE` (`args[11]`) and `KV_LOAD` (`args[12]`) each accept `-` for "absent", the convention
// `TRANSCRIPT` has used since R5B and `LOGITS` since R6-STEP-N, and **absence is the pre-existing
// behaviour character for character**: `args.len() == 12` with `KV_SAVE` of `-` is exactly
// `args.len() == 11`. This capability adds no default. `KV_SAVE` precedes `KV_LOAD` because saving
// is the direction an ordinary run adds, so twelve operands is the common extension and thirteen is
// the specialised one. Supplying both is `R6_KV_ARGS`, raised in `execute` because it is a refusal
// that owes the caller a document.
//
// `KV_WIDTH` has no default at any arity. Below nine operands it is simply not supplied, and step 6
// refuses the run with `R6_KV_WIDTH` and detail `kv_width[-1]` — which is what "fail-closed, no
// default" means for an arm whose lower bound is `T + N`: there is no width a caller did not write
// that is safe to assume, because the decode steps' own columns have to fit somewhere.
//
// `STEPS` is last rather than earlier because every earlier position is spoken for and moving one
// would change the meaning of an existing invocation silently. The cost of last position is the `-`
// form of `LOGITS`, so that `STEPS` is reachable without a blob — the convention `TRANSCRIPT` has
// used since R5B, inherited rather than invented.
//
// **`STEPS` absent means 1, and it is this arm's only default.** It exists so that every
// pre-schema-2 invocation keeps its exact meaning. Its hazard — a caller who forgets the operand
// silently gets one step — is closed by publishing `decode.steps_requested` in **every** document,
// including error documents, so the count is never implicit in the output.
pub fn run(args: array<str>) -> Result<(), Error> {
  count := args.len()
  if count < 5 || count == 8 || count > 16 {
    return Err(Error.Invalid)
  }
  if !layer_forward.valid_path(args[2]) || !layer_forward.valid_path(args[3]) {
    return Err(Error.Invalid)
  }
  if count >= 6 && args[5] != "-" && !layer_forward.valid_path(args[5]) {
    return Err(Error.Invalid)
  }
  if count >= 7 && !layer_forward.valid_path(args[6]) {
    return Err(Error.Invalid)
  }
  if count >= 9 && args[7] != "-" && !layer_forward.valid_path(args[7]) {
    return Err(Error.Invalid)
  }
  if count >= 10 && args[9] != "-" && !layer_forward.valid_path(args[9]) {
    return Err(Error.Invalid)
  }
  if count >= 12 && args[11] != "-" && !layer_forward.valid_path(args[11]) {
    return Err(Error.Invalid)
  }
  if count >= 13 && args[12] != "-" && !layer_forward.valid_path(args[12]) {
    return Err(Error.Invalid)
  }
  // R6-PREFIX-KEY section 2.2. `STORE` is `args[15]`, the sixteenth operand, and takes the **same**
  // path check `KV_SAVE` and `KV_LOAD` take — it is a path, and the fact that it names a directory
  // rather than a file is not something `valid_path` can see at this pin (Request 53). A path it
  // refuses is `Err(Error.Invalid)` with no document, identical to the two operands it sits beside.
  if count >= 16 && args[15] != "-" && !layer_forward.valid_path(args[15]) {
    return Err(Error.Invalid)
  }
  reference_path := if count >= 7 { args[6] } else { "" }
  transcript_path := if count >= 9 && args[7] != "-" { args[7] } else { "" }
  width_text := if count >= 9 { args[8] } else { "" }
  logits_path := if count >= 10 && args[9] != "-" { args[9] } else { "" }
  steps_text := if count >= 11 { args[10] } else { "1" }
  kv_save_path := if count >= 12 && args[11] != "-" { args[11] } else { "" }
  kv_load_path := if count >= 13 && args[12] != "-" { args[12] } else { "" }
  resident_text := if count >= 14 { args[13] } else { "-" }
  // `SUFFIX` is `args[14]`, the fifteenth operand, and takes **no path check**: it is a token id
  // list, not a path, which is `RESIDENT`'s precedent. `-` is absent and is the pre-existing
  // behaviour character for character: `args.len() == 15` with `SUFFIX` of `-` is exactly
  // `args.len() == 14`.
  suffix_text := if count >= 15 { args[14] } else { "-" }
  // `STORE` is `args[15]`, the sixteenth operand, and is last for the reason `STEPS`, `RESIDENT`,
  // and `SUFFIX` were: every earlier position is spoken for and moving one would change the meaning
  // of an existing invocation silently. `-` is absent and is the pre-existing behaviour character
  // for character: `args.len() == 16` with `STORE` of `-` is exactly `args.len() == 15`. It is
  // **mutually exclusive** with `KV_SAVE` and `KV_LOAD` — the arm's first such rule — and that is
  // step 2d in `execute`, because it is a refusal that owes the caller a document.
  store_text := if count >= 16 { args[15] } else { "-" }
  mut tokens := model_forward.empty_tokens()
  mut schedule := model_forward.empty_schedule()
  mut graphs := model_forward.empty_graphs()
  mut top := model_forward.empty_top()
  mut stepped := model_forward.empty_steps()
  outcome := execute(
    args[2], args[3], args[4], reference_path, transcript_path, width_text, logits_path, steps_text,
    kv_save_path, kv_load_path, resident_text, suffix_text, store_text, tokens, schedule, graphs,
    top, stepped)
  document := render(
    outcome, tokens, schedule, graphs, top, stepped, args[2], args[3], reference_path,
    transcript_path, logits_path)
  document_view: str := document
  if count == 5 || args[5] == "-" {
    print(document_view)
  } else {
    fs.write_file(args[5], document_view)?
    print_summary(outcome, tokens, args[2])
  }
  if outcome.code.len() > 0 {
    return Err(Error.Invalid)
  }
  return Ok(())
}
