module runtime_provider_api_smoke

import alignpack
import decode_step
import gguf
import model
import provider
import std.fs

fn config(
  kind: model.ProviderKind,
  model_path: str,
  pack_path: str,
  geometry_path: str,
  endpoint: str,
  api_key: str,
  timeout_ns: i64,
  tokenize_endpoint: str,
  max_response_bytes: i64,
  cache_budget_bytes: i64,
) -> model.ProviderConfig {
  return model.ProviderConfig {
    kind: kind,
    endpoint: endpoint,
    model: model_path,
    api_key: api_key,
    timeout_ns: timeout_ns,
    tokenize_endpoint: tokenize_endpoint,
    max_response_bytes: max_response_bytes,
    runtime_pack_path: pack_path,
    runtime_geometry_path: geometry_path,
    runtime_cache_budget_bytes: cache_budget_bytes,
  }
}

fn request(max_tokens: i64, temperature: f64, seed: Option<i64>) -> model.GenerationRequest {
  return model.GenerationRequest {
    system: "You are a coding assistant. Return a concise patch-oriented answer.",
    user: "x",
    max_tokens: max_tokens,
    temperature: temperature,
    seed: seed,
  }
}

fn expect_error(value: Result<string, Error>) -> Result<(), Error> = match value {
  Ok(_) => Err(Error.Invalid),
  Err(_) => Ok(()),
}

pub fn main(args: array<str>) -> Result<(), Error> {
  if args.len() != 15 { return Err(Error.Invalid) }
  model_path := args[1]
  pack_path := args[2]
  geometry_path := args[3]
  replacement_pack_path := args[4]
  oversize_geometry_path := args[5]
  olmoe_model_path := args[6]
  olmoe_pack_path := args[7]
  olmoe_geometry_path := args[8]
  olmoe_sampled_eog_model_path := args[9]
  olmoe_sampled_eog_pack_path := args[10]
  olmoe_sampled_eog_geometry_path := args[11]
  olmoe_sampled_after_model_path := args[12]
  olmoe_sampled_after_pack_path := args[13]
  olmoe_sampled_after_geometry_path := args[14]

  snapshot := gguf.open_snapshot(model_path)?
  source_identity := alignpack.verify_source_identity_snapshot(snapshot, pack_path)?
  replacement_pack := fs.open_rw(replacement_pack_path)?
  match alignpack.verify_source_identity_file(replacement_pack, source_identity) {
    Ok(_) => { return Err(Error.Invalid) },
    Err(_) => {},
  }
  expected_geometry := fs.read_file(geometry_path)?
  mut prompt_builder: array_builder<i64> := array_builder()
  prompt_builder.push(0)
  prompt_ids := prompt_builder.build()
  mut eog_builder: array_builder<i64> := array_builder()
  eog_builder.push(0)
  eog_ids := eog_builder.build()
  oversized := decode_step.generate_resident(
    pack_path, oversize_geometry_path, expected_geometry, source_identity,
    prompt_ids, eog_ids, 1)
  if oversized.outcome.code != "R6_GEOMETRY_UNREADABLE"
    || oversized.outcome.detail != "Invalid"
    || oversized.token_ids_json != "[]" {
    return Err(Error.Invalid)
  }

  base := config(
    model.ProviderKind.AlignRuntime, model_path, pack_path, geometry_path, "", "", 0, "", 1048576, 0)
  generated := provider.generate(base, request(1, 0.0, None))?
  if generated.len() != 1 { return Err(Error.Invalid) }
  counted := provider.count_tokens(base, generated)?
  prompt_count := provider.count_prompt(base, request(1, 0.0, None))
  info := provider.model_info(base)
  if counted.count != 1 || !counted.exact || prompt_count.count != 148 || !prompt_count.exact
    || info.provider != "align-runtime" || info.endpoint != "in-process"
    || info.supports_stream || info.supports_seed || !info.token_count_exact {
    return Err(Error.Invalid)
  }

  olmoe := config(
    model.ProviderKind.AlignRuntime, olmoe_model_path, olmoe_pack_path, olmoe_geometry_path,
    "", "", 0, "", 1048576, 65536)
  olmoe_info := provider.model_info(olmoe)
  if !olmoe_info.supports_seed || olmoe_info.supports_stream { return Err(Error.Invalid) }
  sampled := request(2, 0.3, Some(11))
  sampled_first := provider.generate(olmoe, sampled)?
  sampled_repeat := provider.generate(olmoe, sampled)?
  if sampled_first != "82" || sampled_repeat != sampled_first { return Err(Error.Invalid) }
  sampled_max_one := provider.generate(olmoe, request(1, 0.3, Some(11)))?
  if sampled_max_one != "8" { return Err(Error.Invalid) }
  olmoe_sampled_eog := config(
    model.ProviderKind.AlignRuntime, olmoe_sampled_eog_model_path, olmoe_sampled_eog_pack_path,
    olmoe_sampled_eog_geometry_path, "", "", 0, "", 1048576, 65536)
  sampled_eog := provider.generate(olmoe_sampled_eog, request(3, 0.3, Some(11)))?
  if sampled_eog.len() != 0 { return Err(Error.Invalid) }
  olmoe_sampled_after := config(
    model.ProviderKind.AlignRuntime, olmoe_sampled_after_model_path, olmoe_sampled_after_pack_path,
    olmoe_sampled_after_geometry_path, "", "", 0, "", 1048576, 65536)
  sampled_after := provider.generate(olmoe_sampled_after, request(3, 0.3, Some(11)))?
  if sampled_after != "8" { return Err(Error.Invalid) }

  expect_error(provider.generate(
      config(model.ProviderKind.LocalOpenAI, model_path, pack_path, geometry_path, "", "", 0, "", 1048576, 0),
      request(1, 0.0, None)))?
  expect_error(provider.generate(
      config(model.ProviderKind.AlignRuntime, model_path, pack_path, geometry_path, "socket", "", 0, "", 1048576, 0),
      request(1, 0.0, None)))?
  expect_error(provider.generate(
      config(model.ProviderKind.AlignRuntime, model_path, pack_path, geometry_path, "", "secret", 0, "", 1048576, 0),
      request(1, 0.0, None)))?
  expect_error(provider.generate(
      config(model.ProviderKind.AlignRuntime, model_path, pack_path, geometry_path, "", "", 1, "", 1048576, 0),
      request(1, 0.0, None)))?
  expect_error(provider.generate(
      config(model.ProviderKind.AlignRuntime, model_path, pack_path, geometry_path, "", "", 0, "tokenize", 1048576, 0),
      request(1, 0.0, None)))?
  expect_error(provider.generate(
      config(model.ProviderKind.AlignRuntime, model_path, pack_path, geometry_path, "", "", 0, "", 0, 0),
      request(1, 0.0, None)))?
  expect_error(provider.generate(
      config(model.ProviderKind.AlignRuntime, model_path, pack_path, geometry_path, "", "", 0, "", 1048577, 0),
      request(1, 0.0, None)))?
  expect_error(provider.generate(base, request(0, 0.0, None)))?
  expect_error(provider.generate(base, request(129, 0.0, None)))?
  expect_error(provider.generate(base, request(1, 0.1, None)))?
  expect_error(provider.generate(base, request(1, 0.0, Some(0))))?
  expect_error(provider.generate(base, request(1, 0.3, Some(0))))?
  expect_error(provider.generate(olmoe, request(1, 0.3, None)))?
  expect_error(provider.generate(olmoe, request(1, 0.0, Some(0))))?
  expect_error(provider.generate(olmoe, request(1, 0.2, Some(0))))?
  expect_error(provider.generate(
      config(model.ProviderKind.AlignRuntime, "missing-model", "missing-pack", "missing-geometry",
        "", "", 0, "", 1048576, 1),
      request(1, 0.0, Some(0))))?
  expect_error(provider.generate(
      config(model.ProviderKind.AlignRuntime, model_path, pack_path, geometry_path, "", "", 0, "", 1048576, 1),
      request(1, 0.0, None)))?
  expect_error(provider.generate(
      config(model.ProviderKind.AlignRuntime, "", pack_path, geometry_path, "", "", 0, "", 1048576, 0),
      request(1, 0.0, None)))?
  expect_error(provider.generate(
      config(model.ProviderKind.AlignRuntime, model_path, "", geometry_path, "", "", 0, "", 1048576, 0),
      request(1, 0.0, None)))?
  expect_error(provider.generate(
      config(model.ProviderKind.AlignRuntime, model_path, pack_path, "", "", "", 0, "", 1048576, 0),
      request(1, 0.0, None)))?
  expect_error(provider.stream(base, request(1, 0.0, None)))?
  expect_error(provider.generate(
      config(model.ProviderKind.AlignRuntime, model_path, pack_path, geometry_path, "", "", 0, "", 1, 0),
      request(3, 0.0, None)))?

  print("runtime provider API smoke: PASS")
  return Ok(())
}
