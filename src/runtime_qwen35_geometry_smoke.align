module runtime_qwen35_geometry_smoke

import std.fs
import gguf
import runtime_qwen35_geometry

fn expect_failure(text: str, borrow sections: array<i64>) -> Result<(), Error> {
  match runtime_qwen35_geometry.parse(text, sections) {
    Ok(_) => Err(Error.Invalid),
    Err(_) => Ok(()),
  }
}

pub fn main(args: array<str>) -> Result<(), Error> {
  if args.len() != 3 { return Err(Error.Invalid) }
  source := fs.read_file(args[1])?
  snapshot := gguf.open_snapshot(args[2])?
  sections := gguf.snapshot_i32_array(snapshot, "qwen35.rope.dimension_sections")?
  geometry := runtime_qwen35_geometry.parse_snapshot(source, snapshot)?
  if geometry.n_layer != 24 || geometry.attention_layers != 6
    || geometry.recurrent_layers != 18 || geometry.conv_elements_per_layer != 18432
    || geometry.state_elements_per_layer != 262144
    || sections[0] != 11 || sections[1] != 11 || sections[2] != 10 || sections[3] != 0 {
    return Err(Error.Invalid)
  }
  mut wrong: array_builder<i64> := array_builder()
  wrong.push(11)
  wrong.push(11)
  wrong.push(11)
  wrong.push(0)
  invalid_sections := wrong.build()
  expect_failure(source, invalid_sections)?
  mut positions := buffer.filled(3 * 16, 255 as u8)
  mut position_view := positions.bytes()
  runtime_qwen35_geometry.write_text_positions(7, 3, position_view)?
  mut plane := 0
  loop {
    if plane >= 4 { break }
    mut at := 0
    loop {
      if at >= 3 { break }
      expected := if plane == 3 { 0 } else { 7 + at }
      if position_view.u32_le((plane * 3 + at) * 4) != expected as u32 {
        return Err(Error.Invalid)
      }
      at = at + 1
    }
    plane = plane + 1
  }
  match runtime_qwen35_geometry.write_text_positions(7, 2, position_view) {
    Ok(_) => { return Err(Error.Invalid) },
    Err(_) => {},
  }
  mut last_position := buffer.filled(16, 0 as u8)
  mut last_view := last_position.bytes()
  runtime_qwen35_geometry.write_text_positions(2147483647, 1, last_view)?
  if last_view.u32_le(0) != 2147483647 as u32 || last_view.u32_le(12) != 0 as u32 {
    return Err(Error.Invalid)
  }
  mut crossing := buffer.filled(32, 0 as u8)
  mut crossing_view := crossing.bytes()
  match runtime_qwen35_geometry.write_text_positions(2147483647, 2, crossing_view) {
    Ok(_) => { return Err(Error.Invalid) },
    Err(_) => {},
  }
  print("qwen35 geometry: PASS")
  return Ok(())
}
