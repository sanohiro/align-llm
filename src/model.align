module model

// Provider-independent data types. Provider implementations consume these records and return
// only the values the current Align ownership model can represent safely at the boundary.

pub ProviderKind { CloudOpenAI, LocalOpenAI, LlamaCpp, AlignRuntime }

pub ProviderConfig {
  kind: ProviderKind,
  endpoint: str,
  model: str,
  api_key: str,
  timeout_ns: i64,
  tokenize_endpoint: str,
  // The caller's bounded-response allowance, carried to the transport. There is no implicit
  // default: every construction site states the cap it is willing to receive.
  max_response_bytes: i64,
  // Empty on every network provider. The in-process runtime keeps weight and exact derived
  // geometry artifacts explicit instead of overloading endpoint or tokenizer fields as paths.
  runtime_pack_path: str,
  runtime_geometry_path: str,
  // Zero on network providers and the dense Qwen runtime. OLMoE callers state the invocation-local
  // partial expert-cache budget explicitly; no machine-dependent default crosses this boundary.
  runtime_cache_budget_bytes: i64,
}

pub GenerationRequest {
  system: str,
  user: str,
  max_tokens: i64,
  temperature: f64,
  // None keeps the legacy unseeded wire record; Some selects each adapter's seeded twin record.
  seed: Option<i64>,
}

pub TokenCount { count: i64, exact: bool }

pub ModelInfo {
  provider: str,
  model: str,
  endpoint: str,
  supports_stream: bool,
  supports_seed: bool,
  token_count_exact: bool,
}
