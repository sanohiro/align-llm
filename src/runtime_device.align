module runtime_device

import ggml_ffi
import runtime_bundle
import runtime_options

pub fn open(options: runtime_options.RuntimeOptions) -> Result<ggml_ffi.GpuDevice, Error> {
  verified := runtime_bundle.verify(
    options.backend_bundle,
    options.backend,
    options.host_budget_bytes,
  )?
  owner := ggml_ffi.gpu_device_open(
    options.backend,
    options.device,
    verified.backend_path,
    verified.bundle_id,
    options.host_budget_bytes,
    options.device_budget_bytes,
  ) else {
    return Err(Error.Invalid)
  }
  return Ok(owner)
}

pub fn synchronize(borrow owner: ggml_ffi.GpuDevice) -> Result<(), Error> {
  ggml_ffi.gpu_device_synchronize(owner) else { return Err(Error.Invalid) }
  return Ok(())
}
