module runtime_session_reuse_smoke

import ggml_ffi
import runtime_generation
import runtime_options
import runtime_pack_identity
import std.fs
import std.io

BUNDLE_ID := "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
QWEN_GEOMETRY := "{\"schema_version\":2,\"kind\":\"R1_MODEL_IR\",\"model\":{\"arch\":\"qwen2\",\"n_layer\":2,\"n_embd\":8,\"n_head\":2,\"n_head_kv\":1,\"head_dim\":4,\"n_ff\":16,\"n_vocab\":32,\"n_expert\":0,\"context_length\":131072,\"rms_eps_bits\":\"3727c5ac\",\"rope\":{\"type\":2,\"dim_count\":4,\"freq_base_bits\":\"461c4000\",\"scaling_type\":null}}}"

fn open_session(pack: str, geometry: str, olmo: bool) -> Result<runtime_generation.Session, Error> {
  options := runtime_options.RuntimeOptions {
    schema_version: 1, backend: "metal".clone(), device: "stub-gpu".clone(),
    backend_bundle: "fixture".clone(), placement: "resident".clone(),
    host_budget_bytes: 67108864, device_budget_bytes: 67108864, prefetch: "off".clone(),
  }
  device := ggml_ffi.gpu_device_open(options.backend, options.device, "fixture-plugin", BUNDLE_ID,
    options.host_budget_bytes, options.device_budget_bytes) else { return Err(Error.Invalid) }
  identity := runtime_pack_identity.observe_path(pack)?
  return runtime_generation.create_session(device, options, pack, identity, geometry, olmo,
    if olmo { 1 } else { 0 }, 4194304)
}

fn prompt(length: i64, suffix: i64) -> array<i64> {
  mut values: array_builder<i64> := array_builder()
  mut at := 0
  loop {
    if at >= length { break }
    values.push(if at == length - 1 { suffix } else { at % 32 })
    at = at + 1
  }
  return values.build()
}

fn equal_ids(borrow left: array<i64>, borrow right: array<i64>) -> bool {
  if left.len() != right.len() { return false }
  mut at := 0
  loop {
    if at >= left.len() { break }
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

fn run(pack: str, geometry: str, olmo: bool) -> Result<(), Error> {
  io.stderr.write("session: construct\n")?
  mut session := open_session(pack, geometry, olmo)?
  io.stderr.write("session: constructed\n")?
  uploaded := ggml_ffi.gpu_weight_state(session.owner, ggml_ffi.GPU_WEIGHT_UPLOADED)
  if uploaded < 1 { return Err(Error.Invalid) }
  empty: array_builder<i64> := array_builder()
  eog := empty.build()
  short := prompt(2, 1)
  long := prompt(130, 2)
  io.stderr.write("session: first\n")?
  first := match runtime_generation.generate_session(session, short, eog, 3, None) {
    Ok(value) => value,
    Err(error) => {
      fault := ggml_ffi.gpu_last_failure()
      io.stderr.write(fault.code)?
      io.stderr.write(":")?
      io.stderr.write(fault.detail)?
      io.stderr.write("\n")?
      return Err(error)
    },
  }
  if first.len() != 3 || session.prefix_count != 4 { return Err(Error.Invalid) }
  io.stderr.write("session: same\n")?
  same := runtime_generation.generate_session(session, short, eog, 3, None)?
  if !equal_ids(first, same) { return Err(Error.Invalid) }
  io.stderr.write("session: long\n")?
  runtime_generation.generate_session(session, long, eog, 3, None)?
  io.stderr.write("session: short again\n")?
  again := runtime_generation.generate_session(session, short, eog, 3, None)?
  if !equal_ids(first, again) || session.prefix_count != 4 { return Err(Error.Invalid) }
  invalid := prompt(2, -1)
  match runtime_generation.generate_session(session, invalid, eog, 3, None) {
    Ok(_) => { return Err(Error.Invalid) }, Err(_) => {},
  }
  if !olmo {
    match runtime_generation.generate_session(session, short, eog, 3, Some(42)) {
      Ok(_) => { return Err(Error.Invalid) }, Err(_) => {},
    }
  }
  if !session.healthy || session.prefix_count != 4 { return Err(Error.Invalid) }
  after := runtime_generation.generate_session(session, short, eog, 3, None)?
  if !equal_ids(first, after)
    || ggml_ffi.gpu_weight_state(session.owner, ggml_ffi.GPU_WEIGHT_UPLOADED) != uploaded
    || ggml_ffi.gpu_graph_state(session.owner, ggml_ffi.GPU_GRAPH_DECODE,
    ggml_ffi.GPU_GRAPH_REUSES) < 1 { return Err(Error.Invalid) }
  if ggml_ffi.handle_absent(ggml_ffi.gpu_graph_lookup(session.owner,
      ggml_ffi.GPU_GRAPH_DECODE, session.decode_key))
    || !ggml_ffi.handle_absent(ggml_ffi.gpu_graph_lookup(session.owner, -1, session.decode_key))
    || !ggml_ffi.handle_absent(ggml_ffi.gpu_graph_lookup(session.owner,
      ggml_ffi.GPU_GRAPH_DECODE, BUNDLE_ID)) { return Err(Error.Invalid) }
  ggml_ffi.gpu_graph_invalidate(session.owner, ggml_ffi.GPU_GRAPH_DECODE) else { return Err(Error.Invalid) }
  if !ggml_ffi.handle_absent(ggml_ffi.gpu_graph_lookup(session.owner,
      ggml_ffi.GPU_GRAPH_DECODE, session.decode_key)) { return Err(Error.Invalid) }
  return Ok(())
}

fn reject_after_fault(pack: str, geometry: str, olmo: bool) -> Result<(), Error> {
  mut session := open_session(pack, geometry, olmo)?
  short := prompt(2, 1)
  empty: array_builder<i64> := array_builder()
  eog := empty.build()
  match runtime_generation.generate_session(session, short, eog, 3, None) {
    Ok(_) => { return Err(Error.Invalid) }, Err(_) => {},
  }
  if session.healthy { return Err(Error.Invalid) }
  executions := ggml_ffi.gpu_graph_state(session.owner, ggml_ffi.GPU_GRAPH_PREFILL,
    ggml_ffi.GPU_GRAPH_EXECUTIONS)
  match runtime_generation.generate_session(session, short, eog, 1, None) {
    Ok(_) => { return Err(Error.Invalid) }, Err(_) => {},
  }
  if ggml_ffi.gpu_graph_state(session.owner, ggml_ffi.GPU_GRAPH_PREFILL,
    ggml_ffi.GPU_GRAPH_EXECUTIONS) != executions { return Err(Error.Invalid) }
  return Ok(())
}

fn test_candidate_selection() -> Result<(), Error> {
  // Test prompt_lookup_candidate
  mut b: array_builder<i64> := array_builder()
  short_prompt := b.build()
  if runtime_generation.prompt_lookup_candidate(short_prompt, 10) != -1 {
    return Err(Error.Invalid)
  }
  mut b2: array_builder<i64> := array_builder()
  b2.push(10)
  single_prompt := b2.build()
  if runtime_generation.prompt_lookup_candidate(single_prompt, 10) != -1 {
    return Err(Error.Invalid)
  }
  mut b3: array_builder<i64> := array_builder()
  b3.push(10)
  b3.push(20)
  b3.push(30)
  b3.push(20)
  b3.push(40)
  pattern_prompt := b3.build()
  if runtime_generation.prompt_lookup_candidate(pattern_prompt, 20) != 40 {
    return Err(Error.Invalid)
  }
  if runtime_generation.prompt_lookup_candidate(pattern_prompt, 30) != 20 {
    return Err(Error.Invalid)
  }
  if runtime_generation.prompt_lookup_candidate(pattern_prompt, 40) != -1 {
    return Err(Error.Invalid)
  }
  if runtime_generation.prompt_lookup_candidate(pattern_prompt, 99) != -1 {
    return Err(Error.Invalid)
  }

  // Test greedy candidate seeding:
  // Case 1: token 0 (10.0) exceeds candidate 2 (8.0) -> token 0 must win
  mut buf1 := buffer(16)
  buf1.put_f32_le(10.0)
  buf1.put_f32_le(5.0)
  buf1.put_f32_le(8.0)
  buf1.put_f32_le(3.0)
  view1 := buf1.bytes()
  if runtime_generation.greedy(view1, 2)? != 0 {
    return Err(Error.Invalid)
  }

  // Case 2: token 0 (10.0) ties with candidate 2 (10.0) -> smallest token 0 must win
  mut buf2 := buffer(16)
  buf2.put_f32_le(10.0)
  buf2.put_f32_le(5.0)
  buf2.put_f32_le(10.0)
  buf2.put_f32_le(3.0)
  view2 := buf2.bytes()
  if runtime_generation.greedy(view2, 2)? != 0 {
    return Err(Error.Invalid)
  }

  // Case 3: candidate 2 (10.0) ties with token 1 (10.0) -> smallest token 1 must win
  mut buf3 := buffer(16)
  buf3.put_f32_le(2.0)
  buf3.put_f32_le(10.0)
  buf3.put_f32_le(10.0)
  buf3.put_f32_le(5.0)
  view3 := buf3.bytes()
  if runtime_generation.greedy(view3, 2)? != 1 {
    return Err(Error.Invalid)
  }

  // Case 4: candidate 2 (15.0) is true max -> candidate 2 wins
  mut buf4 := buffer(16)
  buf4.put_f32_le(2.0)
  buf4.put_f32_le(5.0)
  buf4.put_f32_le(15.0)
  buf4.put_f32_le(8.0)
  view4 := buf4.bytes()
  if runtime_generation.greedy(view4, 2)? != 2 {
    return Err(Error.Invalid)
  }

  // Case 5: candidate = -1 (unseeded) -> token 2 wins
  if runtime_generation.greedy(view4, -1)? != 2 {
    return Err(Error.Invalid)
  }

  // Case 6: all negative logits -> largest negative token 1 (-5.0) wins
  mut buf5 := buffer(16)
  buf5.put_f32_le(-10.0)
  buf5.put_f32_le(-5.0)
  buf5.put_f32_le(-8.0)
  buf5.put_f32_le(-20.0)
  view5 := buf5.bytes()
  if runtime_generation.greedy(view5, -1)? != 1 {
    return Err(Error.Invalid)
  }

  // Case 7: token 0 negative (-10.0), token 2 positive (4.0) -> token 2 wins via transition
  mut buf6 := buffer(16)
  buf6.put_f32_le(-10.0)
  buf6.put_f32_le(-5.0)
  buf6.put_f32_le(4.0)
  buf6.put_f32_le(2.0)
  view6 := buf6.bytes()
  if runtime_generation.greedy(view6, -1)? != 2 {
    return Err(Error.Invalid)
  }

  // Packed callers remain valid even when the first f32 starts at an unaligned byte offset.
  mut packed := buffer(17)
  packed.put_u8(255 as u8)
  packed.put_f32_le(2.0)
  packed.put_f32_le(5.0)
  packed.put_f32_le(15.0)
  packed.put_f32_le(8.0)
  packed_bytes := packed.bytes()
  packed_logits := packed_bytes[1..17]
  if runtime_generation.greedy(packed_logits, -1)? != 2 {
    return Err(Error.Invalid)
  }
  return Ok(())
}

fn test_write_u32_le() -> Result<(), Error> {
  mut buf := buffer(8)
  buf.put_u32_le(0)
  buf.put_u32_le(0)
  mut view := buf.bytes()

  // Test 1: Little-endian byte ordering of 0x12345678 at offset 0
  runtime_generation.write_u32_le(view, 0, 305419896 as u32)
  if view[0] != 120 as u8 || view[1] != 86 as u8 || view[2] != 52 as u8 || view[3] != 18 as u8 {
    return Err(Error.Invalid)
  }
  if view.u32_le(0) != 305419896 as u32 {
    return Err(Error.Invalid)
  }

  // Test 2: Maximum u32 value (0xFFFFFFFF) at offset 4
  runtime_generation.write_u32_le(view, 4, 4294967295 as u32)
  if view[4] != 255 as u8 || view[5] != 255 as u8 || view[6] != 255 as u8 || view[7] != 255 as u8 {
    return Err(Error.Invalid)
  }
  if view.u32_le(4) != 4294967295 as u32 {
    return Err(Error.Invalid)
  }

  // Test 3: Zero value overwrite
  runtime_generation.write_u32_le(view, 0, 0 as u32)
  if view[0] != 0 as u8 || view[1] != 0 as u8 || view[2] != 0 as u8 || view[3] != 0 as u8 {
    return Err(Error.Invalid)
  }
  return Ok(())
}

fn test_filled_buffer_u32() -> Result<(), Error> {
  // Test 1: Empty buffer (count = 0)
  mut b0 := runtime_generation.filled_buffer_u32(0, 42 as u32)?
  if b0.bytes().len() != 0 { return Err(Error.Invalid) }

  // Test 2: Small buffer under initial chunk threshold (count = 5)
  mut b5 := runtime_generation.filled_buffer_u32(5, 305419896 as u32)?
  v5 := b5.bytes()
  if v5.len() != 20 { return Err(Error.Invalid) }
  mut i := 0
  loop {
    if i >= 5 { break }
    if v5.u32_le(i * 4) != 305419896 as u32 { return Err(Error.Invalid) }
    i = i + 1
  }

  // Test 3: Doubled buffer crossing initial chunk (count = 150)
  mut b150 := runtime_generation.filled_buffer_u32(150, 4277075694 as u32)?
  v150 := b150.bytes()
  if v150.len() != 600 { return Err(Error.Invalid) }
  mut j := 0
  loop {
    if j >= 150 { break }
    if v150.u32_le(j * 4) != 4277075694 as u32 { return Err(Error.Invalid) }
    j = j + 1
  }

  // Test 4: Large buffer with multiple doublings (count = 5000)
  mut b5k := runtime_generation.filled_buffer_u32(5000, 0 as u32)?
  v5k := b5k.bytes()
  if v5k.len() != 20000 { return Err(Error.Invalid) }
  mut k := 0
  loop {
    if k >= 5000 { break }
    if v5k.u32_le(k * 4) != 0 as u32 { return Err(Error.Invalid) }
    k = k + 1
  }

  // Test 5: Negative count refusal
  match runtime_generation.filled_buffer_u32(-1, 0 as u32) {
    Ok(_) => { return Err(Error.Invalid) },
    Err(_) => {},
  }
  return Ok(())
}

pub fn main(args: array<str>) -> Result<(), Error> {
  test_candidate_selection()?
  test_write_u32_le()?
  test_filled_buffer_u32()?
  if args.len() != 5 { return Err(Error.Invalid) }
  geometry := fs.read_file(args[3])?
  if args[4] == "fault" {
    reject_after_fault(args[1], QWEN_GEOMETRY, false)?
    reject_after_fault(args[2], geometry, true)?
  } else {
    run(args[1], QWEN_GEOMETRY, false)?
    run(args[2], geometry, true)?
  }
  print("runtime session reuse smoke: PASS")
  return Ok(())
}
