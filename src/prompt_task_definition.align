module prompt_task_definition

import core.json

pub TaskDefinition {
  schema_version: i64,
  id: string,
  source_dir: string,
  source_revision: string,
  allowed_edits: array<string>,
  validation_argv: array<string>,
  validation_timeout_seconds: i64,
}

fn known_field(name: str) -> bool {
  return name == "schema_version" || name == "id" || name == "source_dir" ||
  name == "source_revision" || name == "allowed_edits" || name == "validation_argv" ||
  name == "validation_timeout_seconds"
}

// JSON decoding has already established UTF-8. Preserve Python's code-point length rule,
// including non-ASCII revision strings; hexadecimal/path admission belongs to later callers.
fn revision_length(value: str) -> i64 {
  mut count := 0
  mut index := 0
  loop {
    if index == value.len() { break }
    byte := value.bytes()[index]
    if byte < 128 || byte >= 192 { count = count + 1 }
    index = index + 1
  }
  return count
}

fn nonempty_strings(borrow values: array<string>) -> bool {
  if values.len() == 0 { return false }
  mut index := 0
  loop {
    if index == values.len() { break }
    if values[index].len() == 0 { return false }
    index = index + 1
  }
  return true
}

// Source bounds, retained-file/path admission and execution are caller responsibilities.
// This is argv data, never shell text. The shipped typed decoder rejects duplicate keys
// (Python's historical loader kept the last) and requires timeout to fit positive i64.
pub fn decode(source: str) -> Result<TaskDefinition, Error> {
  arena {
    document := json.doc(source)?
    match document.kind() { Object => {}, _ => { return Err(Error.Invalid) } }
    if document.len() != 7 { return Err(Error.Invalid) }
    mut index := 0
    loop {
      if index == document.len() { break }
      key := document.key(index) else { return Err(Error.Invalid) }
      if !known_field(key) { return Err(Error.Invalid) }
      index = index + 1
    }
  }
  task: TaskDefinition := json.decode(source)?
  if task.schema_version != 1 || task.id.len() == 0 || task.source_dir.len() == 0 ||
  revision_length(task.source_revision) != 40 || !nonempty_strings(task.allowed_edits) ||
  !nonempty_strings(task.validation_argv) || task.validation_timeout_seconds <= 0 {
    return Err(Error.Invalid)
  }
  return Ok(task)
}
