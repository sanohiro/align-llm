module frontend_gpt_oss

import gguf
import model_ir

// R1B-GPTOSS-MOE-IR (`docs/specs/r1b-gptoss-moe-ir.md` sections 2.5 and 2.6). The sole owner of
// gpt-oss architecture knowledge: its metadata keys, bounds and derivations, expert bounds and the
// block-explosion guard, the expert feed-forward layout question, the role/shape/name tables, the
// gpt-oss `model` object, and the gpt-oss `BlockPlan`.
//
// It imports `gguf` and `model_ir` and no other frontend. It owns no byte-size computation, no
// coverage sweep, no claim arithmetic, and no JSON brace outside its own `model` object: one
// exchanged format has exactly one renderer, and adding an architecture must not be able to change
// what that format means.
//
// **Every GGUF key name, tensor name, and shape below is an ASSUMPTION** drawn from the format
// strings in the named llama.cpp build's `libllama.dylib` plus public documentation of
// `gpt-oss-20b`; no gpt-oss model is present on this host and `make model-ir-parity` for this
// architecture is a recorded `N/A` (section 4.4). The *spelling* of every tensor name is
// evidence-backed; which of them a real file uses, and with what extents, is not. Section 4.5 makes
// one real-model inspection the prerequisite that settles them, and section 2.5.4's layout question
// is designed so that guessing wrong fails loudly rather than silently.

// Section 2.6 thresholds, shared with the dense frontend by value rather than by import: a bound is
// an architecture fact, and two architectures agreeing on one today must not couple them forever.
MAX_LAYERS := 512
MAX_EMBD := 1048576
MAX_HEADS := 4096
MAX_FF := 16777216
MAX_CONTEXT := 134217728
MAX_VOCAB := 4194304

// An order of magnitude above any shipping MoE expert count.
MAX_EXPERTS := 1024

// The block-explosion guard. `MAX_LAYERS * MAX_EXPERTS` alone admits half a million blocks and a
// document no consumer can hold; the assumed `gpt-oss-20b` shape needs 818.
MAX_BLOCKS := 65536

// ASSUMED: gpt-oss is assigned the NEOX rope layout by the architecture, exactly as qwen2 is, and
// the value is recorded together with its source so a consumer can tell a derived constant from a
// declared one. No local artifact settles this and the parity qualification that would is `N/A`.
ROPE_TYPE_NEOX := 2

TYPE_UINT32 := 4
TYPE_FLOAT32 := 6
TYPE_STRING := 8

// The derived hyperparameters, carried together so the shape table is one small parameter.
Hyper {
  n_embd: i64,
  n_head: i64,
  n_head_kv: i64,
  head_dim: i64,
  n_ff_exp: i64,
  n_vocab: i64,
  n_expert: i64,
}

// An expected tensor shape. Unused axes hold the multiplicative identity, exactly as
// `src/gguf.align` records an undeclared axis. `sliced` marks a stacked expert tensor whose last
// declared axis is the expert axis.
Shape { n_dims: i64, d0: i64, d1: i64, d2: i64, d3: i64, sliced: bool }

fn kv_text_decodable(borrow t: gguf.GgufTable, key: str) -> bool {
  return match gguf.kv_string(t, key) {
    Some(_) => true,
    None => false,
  }
}

// The stable, architecture-independent role names. `RouterBlock` and `ExpertBlock` roles are new;
// every attention and embedding role is spelled exactly as the qwen2 frontend spells it, because a
// consumer must not have to learn a second vocabulary for the same function.
fn role_label(role: i64) -> str {
  if role == 0 { return "token_embd" }
  if role == 1 { return "attn_norm" }
  if role == 2 { return "attn_q" }
  if role == 3 { return "attn_q_bias" }
  if role == 4 { return "attn_k" }
  if role == 5 { return "attn_k_bias" }
  if role == 6 { return "attn_v" }
  if role == 7 { return "attn_v_bias" }
  if role == 8 { return "attn_output" }
  if role == 9 { return "attn_output_bias" }
  if role == 10 { return "attn_sinks" }
  if role == 11 { return "ffn_norm" }
  if role == 12 { return "router" }
  if role == 13 { return "router_bias" }
  if role == 14 { return "ffn_gate_exps" }
  if role == 15 { return "ffn_gate_exps_bias" }
  if role == 16 { return "ffn_up_exps" }
  if role == 17 { return "ffn_up_exps_bias" }
  if role == 18 { return "ffn_down_exps" }
  if role == 19 { return "ffn_down_exps_bias" }
  if role == 20 { return "ffn_gate_up_exps" }
  if role == 21 { return "ffn_gate_up_exps_bias" }
  if role == 22 { return "output_norm" }
  if role == 23 { return "output" }
  return ""
}

fn role_suffix(role: i64) -> str {
  if role == 1 { return "attn_norm.weight" }
  if role == 2 { return "attn_q.weight" }
  if role == 3 { return "attn_q.bias" }
  if role == 4 { return "attn_k.weight" }
  if role == 5 { return "attn_k.bias" }
  if role == 6 { return "attn_v.weight" }
  if role == 7 { return "attn_v.bias" }
  if role == 8 { return "attn_output.weight" }
  if role == 9 { return "attn_output.bias" }
  if role == 10 { return "attn_sinks.weight" }
  if role == 11 { return "ffn_norm.weight" }
  if role == 12 { return "ffn_gate_inp.weight" }
  if role == 13 { return "ffn_gate_inp.bias" }
  if role == 14 { return "ffn_gate_exps.weight" }
  if role == 15 { return "ffn_gate_exps.bias" }
  if role == 16 { return "ffn_up_exps.weight" }
  if role == 17 { return "ffn_up_exps.bias" }
  if role == 18 { return "ffn_down_exps.weight" }
  if role == 19 { return "ffn_down_exps.bias" }
  if role == 20 { return "ffn_gate_up_exps.weight" }
  if role == 21 { return "ffn_gate_up_exps.bias" }
  return ""
}

fn role_tensor_name(role: i64, layer: i64) -> string {
  if role == 0 { return "token_embd.weight".clone() }
  if role == 22 { return "output_norm.weight".clone() }
  if role == 23 { return "output.weight".clone() }
  b := builder()
  b.write("blk.")
  b.write_int(layer)
  b.write(".")
  b.write(role_suffix(role))
  return b.to_string()
}

// Two members are optional, and both for the same reason: **no installed artifact settles whether a
// gpt-oss GGUF ships them**, so optional is the safe default — an absent optional member is dropped
// from its block rather than rejecting a real file that never had it.
//
//   - role 13, the router bias `blk.L.ffn_gate_inp.bias`. llama.cpp's quantization-exclusion regex
//     `ffn_gate(_exps)?.bias` matches the dense `ffn_gate.bias` and the stacked expert gate bias
//     `ffn_gate_exps.bias`; it does **not** match `ffn_gate_inp.bias`, so it says nothing about the
//     router bias either way.
//   - role 21, the fused expert gate-up bias `blk.L.ffn_gate_up_exps.bias`. The dylib attests only
//     `blk\.\d*\.ffn_gate_up(_exps)?.weight` — the fused **weight**. Requiring a fused bias no
//     artifact names would reject every fused file that ships without one, which is exactly the
//     failure mode section 2.5.4's variant mechanism exists to avoid. The split variant's expert
//     biases (roles 15, 17, 19) stay required, because `ffn_gate_exps.bias` is attested; section
//     2.5.4 records that asymmetry.
//
// Every other member is required, and an absent one is `R1_MISSING_TENSOR` rather than a silently
// smaller block.
fn role_required(role: i64) -> i64 {
  if role == 13 || role == 21 { return 0 }
  return 1
}

// ASSUMED shapes, asserted per member. The stacked-tensor rule is visible here: every sliced member
// declares its expert axis **last**, with extent exactly `n_expert`.
fn expected_shape(role: i64, h: Hyper) -> Shape {
  q := h.n_head * h.head_dim
  kv := h.n_head_kv * h.head_dim
  if role == 0 || role == 23 {
    return Shape { n_dims: 2, d0: h.n_embd, d1: h.n_vocab, d2: 1, d3: 1, sliced: false }
  }
  if role == 1 || role == 11 || role == 22 {
    return Shape { n_dims: 1, d0: h.n_embd, d1: 1, d2: 1, d3: 1, sliced: false }
  }
  if role == 2 { return Shape { n_dims: 2, d0: h.n_embd, d1: q, d2: 1, d3: 1, sliced: false } }
  if role == 3 { return Shape { n_dims: 1, d0: q, d1: 1, d2: 1, d3: 1, sliced: false } }
  if role == 4 || role == 6 {
    return Shape { n_dims: 2, d0: h.n_embd, d1: kv, d2: 1, d3: 1, sliced: false }
  }
  if role == 5 || role == 7 {
    return Shape { n_dims: 1, d0: kv, d1: 1, d2: 1, d3: 1, sliced: false }
  }
  if role == 8 { return Shape { n_dims: 2, d0: q, d1: h.n_embd, d2: 1, d3: 1, sliced: false } }
  if role == 9 { return Shape { n_dims: 1, d0: h.n_embd, d1: 1, d2: 1, d3: 1, sliced: false } }
  // `attn_sinks` is per-head attention state and rides with the attention weights.
  if role == 10 { return Shape { n_dims: 1, d0: h.n_head, d1: 1, d2: 1, d3: 1, sliced: false } }
  // A router whose second axis disagrees with `n_expert` is the clearest possible signal that the
  // metadata and the tensors describe different models.
  if role == 12 {
    return Shape { n_dims: 2, d0: h.n_embd, d1: h.n_expert, d2: 1, d3: 1, sliced: false }
  }
  if role == 13 {
    return Shape { n_dims: 1, d0: h.n_expert, d1: 1, d2: 1, d3: 1, sliced: false }
  }
  if role == 14 || role == 16 {
    return Shape { n_dims: 3, d0: h.n_ff_exp, d1: h.n_embd, d2: h.n_expert, d3: 1, sliced: true }
  }
  if role == 15 || role == 17 {
    return Shape { n_dims: 2, d0: h.n_ff_exp, d1: h.n_expert, d2: 1, d3: 1, sliced: true }
  }
  if role == 18 {
    return Shape { n_dims: 3, d0: h.n_embd, d1: h.n_ff_exp, d2: h.n_expert, d3: 1, sliced: true }
  }
  if role == 19 {
    return Shape { n_dims: 2, d0: h.n_embd, d1: h.n_expert, d2: 1, d3: 1, sliced: true }
  }
  if role == 20 {
    return Shape {
      n_dims: 3,
      d0: 2 * h.n_ff_exp,
      d1: h.n_embd,
      d2: h.n_expert,
      d3: 1,
      sliced: true,
    }
  }
  if role == 21 {
    return Shape { n_dims: 2, d0: 2 * h.n_ff_exp, d1: h.n_expert, d2: 1, d3: 1, sliced: true }
  }
  return Shape { n_dims: -1, d0: -1, d1: -1, d2: -1, d3: -1, sliced: false }
}

// The section 2.5.4 member sets. Variant 0 is split (`ffn_gate_exps` + `ffn_up_exps`) and variant 1
// is fused (`ffn_gate_up_exps`). The plan prefers split, so a file carrying neither is
// `R1_MISSING_TENSOR` naming variant 0's first missing required member rather than whichever
// variant happened to be tried last.
fn expert_member_count(fused: bool) -> i64 {
  if fused { return 4 }
  return 6
}

fn expert_member_role(fused: bool, slot: i64) -> i64 {
  if fused {
    if slot == 0 { return 20 }
    if slot == 1 { return 21 }
    if slot == 2 { return 18 }
    if slot == 3 { return 19 }
    return -1
  }
  if slot >= 0 && slot < 6 { return 14 + slot }
  return -1
}

// The one public entry point. The container table is read once per invocation by `src/main.align`,
// which dispatches on its `general.architecture` field, and is borrowed here.
// R4-ALIGNPACK-LAYER-MAJOR section 2.9 requires the packer to receive a `BlockPlan`, and only a
// frontend can build one. `prepare` is therefore this frontend's whole derivation as **data** —
// the ordered validation result, the step-8 geometry, and the settled block plan — and
// `build_model_ir` is the `R1_MODEL_IR` renderer over exactly that value. Nothing else moved, so
// every `R1_MODEL_IR` document is byte-identical to the one produced before the extraction.
pub fn build_model_ir(borrow table: gguf.GgufTable, path: str) -> model_ir.ModelIr {
  prepared := prepare(table)
  code_view: str := prepared.code
  detail_view: str := prepared.detail
  return model_ir.build(table, prepared.geometry, prepared.plan, path, code_view, detail_view)
}

pub fn prepare(borrow table: gguf.GgufTable) -> model_ir.Prepared {
  mut code := "".clone()
  mut detail := "".clone()
  mut n_layer := -1
  mut n_embd := -1
  mut n_head := -1
  mut n_head_kv := -1
  mut head_dim := -1
  mut head_dim_source := "".clone()
  mut n_ff := -1
  mut n_ff_exp := -1
  mut n_ff_exp_source := "".clone()
  mut n_vocab := -1
  mut n_expert := -1
  mut n_expert_used := -1
  mut expert_layout := "".clone()
  mut context_length := -1
  mut sliding_window := -1
  mut sliding_window_present := false
  mut sliding_window_pattern := -1
  mut sliding_window_pattern_present := false
  mut rms_eps_bits := -1
  mut rms_eps_text := "null".clone()
  mut freq_base_bits := -1
  mut freq_base_text := "null".clone()
  mut rope_type := -1
  mut rope_dim_count := -1
  mut rope_dim_source := "".clone()
  mut rope_scaling_json := "null".clone()
  mut file_type := -1
  mut file_type_present := false

  loop {
    // Step 3. A container failure is data with the container's own code as the detail.
    container_failed := match table.status {
      Ok => false,
      Error => true,
    }
    if container_failed {
      code = "R1_GGUF_ERROR".clone()
      container_code: str := table.error_code
      detail = model_ir.bounded_detail(container_code)
      break
    }

    // Step 4. The dispatch in `src/main.align` already chose this frontend; the re-check is what
    // keeps it unusable on the wrong file.
    architecture_view: str := table.architecture
    if !table.architecture_present || architecture_view != "gpt-oss" {
      code = "R1_UNSUPPORTED_ARCH".clone()
      detail = if table.architecture_present {
        model_ir.bounded_detail(architecture_view)
      } else {
        "".clone()
      }
      break
    }
    rope_type = ROPE_TYPE_NEOX

    // Step 5, first pass: presence of every required key, in the section 2.5.1 order.
    mut missing := ""
    if gguf.kv_type(table, "gpt-oss.block_count") < 0 {
      missing = "gpt-oss.block_count"
    } else if gguf.kv_type(table, "gpt-oss.embedding_length") < 0 {
      missing = "gpt-oss.embedding_length"
    } else if gguf.kv_type(table, "gpt-oss.attention.head_count") < 0 {
      missing = "gpt-oss.attention.head_count"
    } else if gguf.kv_type(table, "gpt-oss.attention.head_count_kv") < 0 {
      missing = "gpt-oss.attention.head_count_kv"
    } else if gguf.kv_type(table, "gpt-oss.feed_forward_length") < 0 {
      missing = "gpt-oss.feed_forward_length"
    } else if gguf.kv_type(table, "gpt-oss.expert_count") < 0 {
      missing = "gpt-oss.expert_count"
    } else if gguf.kv_type(table, "gpt-oss.expert_used_count") < 0 {
      missing = "gpt-oss.expert_used_count"
    } else if gguf.kv_type(table, "gpt-oss.context_length") < 0 {
      missing = "gpt-oss.context_length"
    } else if gguf.kv_type(table, "gpt-oss.attention.layer_norm_rms_epsilon") < 0 {
      missing = "gpt-oss.attention.layer_norm_rms_epsilon"
    } else if gguf.kv_type(table, "gpt-oss.rope.freq_base") < 0 {
      missing = "gpt-oss.rope.freq_base"
    }
    if missing.len() > 0 {
      code = "R1_MISSING_KEY".clone()
      detail = missing.clone()
      break
    }

    // Step 5, second pass: the declared value type of every required key, then of every optional key
    // that is present.
    mut mistyped := ""
    if gguf.kv_type(table, "gpt-oss.block_count") != TYPE_UINT32 {
      mistyped = "gpt-oss.block_count"
    } else if gguf.kv_type(table, "gpt-oss.embedding_length") != TYPE_UINT32 {
      mistyped = "gpt-oss.embedding_length"
    } else if gguf.kv_type(table, "gpt-oss.attention.head_count") != TYPE_UINT32 {
      mistyped = "gpt-oss.attention.head_count"
    } else if gguf.kv_type(table, "gpt-oss.attention.head_count_kv") != TYPE_UINT32 {
      mistyped = "gpt-oss.attention.head_count_kv"
    } else if gguf.kv_type(table, "gpt-oss.feed_forward_length") != TYPE_UINT32 {
      mistyped = "gpt-oss.feed_forward_length"
    } else if gguf.kv_type(table, "gpt-oss.expert_count") != TYPE_UINT32 {
      mistyped = "gpt-oss.expert_count"
    } else if gguf.kv_type(table, "gpt-oss.expert_used_count") != TYPE_UINT32 {
      mistyped = "gpt-oss.expert_used_count"
    } else if gguf.kv_type(table, "gpt-oss.context_length") != TYPE_UINT32 {
      mistyped = "gpt-oss.context_length"
    } else if gguf.kv_type(table, "gpt-oss.attention.layer_norm_rms_epsilon") != TYPE_FLOAT32 {
      mistyped = "gpt-oss.attention.layer_norm_rms_epsilon"
    } else if gguf.kv_type(table, "gpt-oss.rope.freq_base") != TYPE_FLOAT32 {
      mistyped = "gpt-oss.rope.freq_base"
    } else if gguf.kv_type(table, "gpt-oss.attention.key_length") >= 0
      && gguf.kv_type(table, "gpt-oss.attention.key_length") != TYPE_UINT32 {
      mistyped = "gpt-oss.attention.key_length"
    } else if gguf.kv_type(table, "gpt-oss.attention.value_length") >= 0
      && gguf.kv_type(table, "gpt-oss.attention.value_length") != TYPE_UINT32 {
      mistyped = "gpt-oss.attention.value_length"
    } else if gguf.kv_type(table, "gpt-oss.expert_feed_forward_length") >= 0
      && gguf.kv_type(table, "gpt-oss.expert_feed_forward_length") != TYPE_UINT32 {
      mistyped = "gpt-oss.expert_feed_forward_length"
    } else if gguf.kv_type(table, "gpt-oss.attention.sliding_window") >= 0
      && gguf.kv_type(table, "gpt-oss.attention.sliding_window") != TYPE_UINT32 {
      mistyped = "gpt-oss.attention.sliding_window"
    } else if gguf.kv_type(table, "gpt-oss.attention.sliding_window_pattern") >= 0
      && gguf.kv_type(table, "gpt-oss.attention.sliding_window_pattern") != TYPE_UINT32 {
      mistyped = "gpt-oss.attention.sliding_window_pattern"
    } else if gguf.kv_type(table, "gpt-oss.rope.dimension_count") >= 0
      && gguf.kv_type(table, "gpt-oss.rope.dimension_count") != TYPE_UINT32 {
      mistyped = "gpt-oss.rope.dimension_count"
    } else if gguf.kv_type(table, "gpt-oss.rope.scaling.type") >= 0
      && gguf.kv_type(table, "gpt-oss.rope.scaling.type") != TYPE_STRING {
      mistyped = "gpt-oss.rope.scaling.type"
    } else if gguf.kv_type(table, "gpt-oss.rope.scaling.type") == TYPE_STRING
      && !kv_text_decodable(table, "gpt-oss.rope.scaling.type") {
      mistyped = "gpt-oss.rope.scaling.type"
    }
    if mistyped.len() > 0 {
      code = "R1_KEY_TYPE_MISMATCH".clone()
      detail = mistyped.clone()
      break
    }

    n_layer = match gguf.kv_int(table, "gpt-oss.block_count") {
      Some(value) => value,
      None => -1,
    }
    n_embd = match gguf.kv_int(table, "gpt-oss.embedding_length") {
      Some(value) => value,
      None => -1,
    }
    n_head = match gguf.kv_int(table, "gpt-oss.attention.head_count") {
      Some(value) => value,
      None => -1,
    }
    n_head_kv = match gguf.kv_int(table, "gpt-oss.attention.head_count_kv") {
      Some(value) => value,
      None => -1,
    }
    n_ff = match gguf.kv_int(table, "gpt-oss.feed_forward_length") {
      Some(value) => value,
      None => -1,
    }
    n_expert = match gguf.kv_int(table, "gpt-oss.expert_count") {
      Some(value) => value,
      None => -1,
    }
    n_expert_used = match gguf.kv_int(table, "gpt-oss.expert_used_count") {
      Some(value) => value,
      None => -1,
    }
    context_length = match gguf.kv_int(table, "gpt-oss.context_length") {
      Some(value) => value,
      None => -1,
    }
    rms_eps_bits = match gguf.kv_float_bits(table, "gpt-oss.attention.layer_norm_rms_epsilon") {
      Some(value) => value,
      None => -1,
    }
    rms_eps_text = match gguf.kv_float_text(table, "gpt-oss.attention.layer_norm_rms_epsilon") {
      Some(value) => value,
      None => "null".clone(),
    }
    freq_base_bits = match gguf.kv_float_bits(table, "gpt-oss.rope.freq_base") {
      Some(value) => value,
      None => -1,
    }
    freq_base_text = match gguf.kv_float_text(table, "gpt-oss.rope.freq_base") {
      Some(value) => value,
      None => "null".clone(),
    }
    // Reported, never interpreted — exactly as R1 reports `rope.scaling_type`. Neither key changes a
    // block, a shape, or a byte, and reporting a value this repository cannot validate as if it had
    // been validated would be worse than reporting the value alone.
    match gguf.kv_int(table, "gpt-oss.attention.sliding_window") {
      Some(value) => {
        sliding_window = value
        sliding_window_present = true
      },
      None => {},
    }
    match gguf.kv_int(table, "gpt-oss.attention.sliding_window_pattern") {
      Some(value) => {
        sliding_window_pattern = value
        sliding_window_pattern_present = true
      },
      None => {},
    }
    if gguf.kv_type(table, "general.file_type") == TYPE_UINT32 {
      file_type = match gguf.kv_int(table, "general.file_type") {
        Some(value) => value,
        None => -1,
      }
      file_type_present = file_type >= 0
    }
    rope_scaling_json = match gguf.kv_string(table, "gpt-oss.rope.scaling.type") {
      Some(value) => {
        scaling_view: str := value
        gguf.json_string(scaling_view)
      },
      None => "null".clone(),
    }

    // Step 6. Plausibility and derivation, in the section 2.5.1 order.
    mut implausible := ""
    if n_layer < 1 || n_layer > MAX_LAYERS {
      implausible = "gpt-oss.block_count"
    } else if n_embd < 1 || n_embd > MAX_EMBD {
      implausible = "gpt-oss.embedding_length"
    } else if n_head < 1 || n_head > MAX_HEADS {
      implausible = "gpt-oss.attention.head_count"
    } else if n_head_kv < 1 || n_head_kv > n_head || n_head % n_head_kv != 0 {
      implausible = "gpt-oss.attention.head_count_kv"
    }
    if implausible.len() > 0 {
      code = "R1_KEY_VALUE_IMPLAUSIBLE".clone()
      detail = implausible.clone()
      break
    }

    // `head_dim` is **not** `n_embd / n_head` for this architecture, and that is the single most
    // important derivation difference: `2880 / 64 = 45` is not the head dimension, and the container
    // declares `attention.key_length` instead. The declared key wins; the division is the fallback
    // and must divide exactly; `head_dim_source` reports which rule was applied.
    key_length_present := gguf.kv_type(table, "gpt-oss.attention.key_length") >= 0
    if key_length_present {
      key_length := match gguf.kv_int(table, "gpt-oss.attention.key_length") {
        Some(value) => value,
        None => -1,
      }
      value_length := match gguf.kv_int(table, "gpt-oss.attention.value_length") {
        Some(value) => value,
        None => -1,
      }
      if gguf.kv_type(table, "gpt-oss.attention.value_length") < 0 || value_length != key_length {
        code = "R1_KEY_VALUE_IMPLAUSIBLE".clone()
        detail = "gpt-oss.attention.value_length".clone()
        break
      }
      if key_length < 1 || key_length > MAX_EMBD {
        code = "R1_KEY_VALUE_IMPLAUSIBLE".clone()
        detail = "gpt-oss.attention.key_length".clone()
        break
      }
      head_dim = key_length
      head_dim_source = "metadata".clone()
    } else {
      if n_embd % n_head != 0 {
        code = "R1_KEY_VALUE_IMPLAUSIBLE".clone()
        detail = "gpt-oss.embedding_length".clone()
        break
      }
      head_dim = n_embd / n_head
      head_dim_source = "derived".clone()
    }

    mut implausible2 := ""
    if n_ff < 1 || n_ff > MAX_FF {
      implausible2 = "gpt-oss.feed_forward_length"
    } else if context_length < 1 || context_length > MAX_CONTEXT {
      implausible2 = "gpt-oss.context_length"
    }
    if implausible2.len() > 0 {
      code = "R1_KEY_VALUE_IMPLAUSIBLE".clone()
      detail = implausible2.clone()
      break
    }

    // A pure-MoE layer has no dense feed-forward tensor, so `n_ff` is declared, required, and used
    // by no tensor shape — the position `n_vocab` occupies in R1. Its bound is what keeps an
    // implausible value a rejection rather than an unusable Model IR.
    ff_exp_present := gguf.kv_type(table, "gpt-oss.expert_feed_forward_length") >= 0
    n_ff_exp = if ff_exp_present {
      match gguf.kv_int(table, "gpt-oss.expert_feed_forward_length") {
        Some(value) => value,
        None => -1,
      }
    } else {
      n_ff
    }
    n_ff_exp_source = if ff_exp_present { "metadata".clone() } else { "derived".clone() }
    if n_ff_exp < 1 || n_ff_exp > MAX_FF {
      code = "R1_KEY_VALUE_IMPLAUSIBLE".clone()
      detail = if ff_exp_present {
        "gpt-oss.expert_feed_forward_length".clone()
      } else {
        "gpt-oss.feed_forward_length".clone()
      }
      break
    }

    rope_dim_count = match gguf.kv_int(table, "gpt-oss.rope.dimension_count") {
      Some(value) => value,
      None => head_dim,
    }
    rope_dim_source = if gguf.kv_type(table, "gpt-oss.rope.dimension_count") >= 0 {
      "metadata".clone()
    } else {
      "derived".clone()
    }
    if rope_dim_count < 1 || rope_dim_count > head_dim {
      code = "R1_KEY_VALUE_IMPLAUSIBLE".clone()
      detail = "gpt-oss.rope.dimension_count".clone()
      break
    }

    // Step 7. Expert bounds and the block-explosion guard, replacing R1's blanket MoE rejection for
    // this frontend. Every comparison is written in non-wrapping form and tested before the product
    // it protects.
    if n_expert < 1 || n_expert > MAX_EXPERTS {
      code = "R1_KEY_VALUE_IMPLAUSIBLE".clone()
      detail = "gpt-oss.expert_count".clone()
      break
    }
    if n_expert_used < 1 || n_expert_used > n_expert {
      code = "R1_KEY_VALUE_IMPLAUSIBLE".clone()
      detail = "gpt-oss.expert_used_count".clone()
      break
    }
    per_layer := 2 + n_expert
    if n_layer > (MAX_BLOCKS - 2) / per_layer {
      code = "R1_KEY_VALUE_IMPLAUSIBLE".clone()
      detail = "gpt-oss.expert_count".clone()
      break
    }
    break
  }

  // Step 8. The tensor geometry pass, owned by the neutral builder and run here so that step 9 —
  // which is the frontend's — keeps its place in the section 2.6 order.
  geometry := if code.len() == 0 {
    model_ir.size_tensors(table)
  } else {
    model_ir.empty_geometry()
  }

  mut member_roles: array_builder<string> := array_builder()
  mut member_names: array_builder<string> := array_builder()
  mut block_kind_column: array_builder<i64> := array_builder()
  mut block_layer_column: array_builder<i64> := array_builder()
  mut block_expert_column: array_builder<i64> := array_builder()
  mut block_member_start_column: array_builder<i64> := array_builder()
  mut block_member_end_column: array_builder<i64> := array_builder()
  mut member_required_column: array_builder<i64> := array_builder()
  mut member_n_dims_column: array_builder<i64> := array_builder()
  mut member_dim0_column: array_builder<i64> := array_builder()
  mut member_dim1_column: array_builder<i64> := array_builder()
  mut member_dim2_column: array_builder<i64> := array_builder()
  mut member_dim3_column: array_builder<i64> := array_builder()
  mut member_slice_index_column: array_builder<i64> := array_builder()
  mut member_slice_count_column: array_builder<i64> := array_builder()
  mut plan_blocks := 0
  mut plan_members := 0

  loop {
    if code.len() > 0 || geometry.failed { break }

    // Step 9. `n_vocab` is `dims[1]` of `token_embd.weight`, bounded, then cross-checked against the
    // declared length of `tokenizer.ggml.tokens`. Unchanged from R1.
    embd_index := gguf.find_tensor(table, "token_embd.weight")
    if embd_index < 0 {
      code = "R1_MISSING_TENSOR".clone()
      detail = "token_embd.weight".clone()
      break
    }
    n_vocab = gguf.tensor_dim(table, embd_index, 1)
    if n_vocab < 1 || n_vocab > MAX_VOCAB {
      code = "R1_TENSOR_SHAPE_UNEXPECTED".clone()
      detail = "token_embd.weight".clone()
      break
    }
    mut vocab_mismatch := false
    match gguf.kv_array_length(table, "tokenizer.ggml.tokens") {
      Some(declared) => {
        if declared != n_vocab {
          code = "R1_VOCAB_MISMATCH".clone()
          b := builder()
          b.write_int(declared)
          b.write("!=")
          b.write_int(n_vocab)
          detail = b.to_string()
          vocab_mismatch = true
        }
      },
      None => {},
    }
    if vocab_mismatch { break }

    // Section 2.5.4. `libllama.dylib` carries both the split `blk.%d.ffn_gate_exps` /
    // `blk.%d.ffn_up_exps` templates and the fused `blk\.\d*\.ffn_gate_up(_exps)?.weight` regex, and
    // which form a gpt-oss GGUF uses cannot be settled from the artifacts on this host. The plan
    // does not guess: it prefers split, falls back to fused when the split weight is absent and the
    // fused one is present, and reports the selection as `model.expert_ffn_layout` so a layout
    // planner is told a property of the file rather than left to rediscover it. The choice is made
    // here rather than in the neutral builder because `model` must be rendered before the document
    // is assembled.
    split_probe := model_ir.find_indexed(table, geometry, "blk.0.ffn_gate_exps.weight")
    fused_probe := model_ir.find_indexed(table, geometry, "blk.0.ffn_gate_up_exps.weight")
    fused := split_probe < 0 && fused_probe >= 0
    expert_layout = if fused { "fused".clone() } else { "split".clone() }

    hyper := Hyper {
      n_embd: n_embd,
      n_head: n_head,
      n_head_kv: n_head_kv,
      head_dim: head_dim,
      n_ff_exp: n_ff_exp,
      n_vocab: n_vocab,
      n_expert: n_expert,
    }

    // Pass 1: the block skeleton and one member request per (role, layer, expert) in the section
    // 2.5.2 emission order, which is fixed and is not file order:
    //   index 0                                       WeightBlock    layer -1
    //   base, base + 1, base + 2 + e                  AttentionBlock, RouterBlock, ExpertBlock
    //   index 1 + n_layer * (2 + n_expert)            WeightBlock    layer -1
    mut request_role: array_builder<i64> := array_builder()
    mut request_layer: array_builder<i64> := array_builder()
    mut request_slice: array_builder<i64> := array_builder()

    block_kind_column.push(0)
    block_layer_column.push(-1)
    block_expert_column.push(-1)
    block_member_start_column.push(plan_members)
    request_role.push(0)
    request_layer.push(-1)
    request_slice.push(-1)
    plan_members = plan_members + 1
    block_member_end_column.push(plan_members)
    plan_blocks = plan_blocks + 1

    expert_members := expert_member_count(fused)
    mut layer := 0
    loop {
      if layer >= n_layer { break }
      block_kind_column.push(1)
      block_layer_column.push(layer)
      block_expert_column.push(-1)
      block_member_start_column.push(plan_members)
      mut attention_role := 1
      loop {
        if attention_role > 10 { break }
        request_role.push(attention_role)
        request_layer.push(layer)
        request_slice.push(-1)
        plan_members = plan_members + 1
        attention_role = attention_role + 1
      }
      block_member_end_column.push(plan_members)
      plan_blocks = plan_blocks + 1

      // `ffn_norm` belongs to the `RouterBlock`, not to an `ExpertBlock`: it is applied once per
      // token before routing, so attaching it to a single expert would be a lie about when it is
      // needed and duplicating it into all of them would break claim tiling. The `RouterBlock` is
      // therefore "everything the layer needs before it knows which experts to fetch".
      block_kind_column.push(4)
      block_layer_column.push(layer)
      block_expert_column.push(-1)
      block_member_start_column.push(plan_members)
      mut router_role := 11
      loop {
        if router_role > 13 { break }
        request_role.push(router_role)
        request_layer.push(layer)
        request_slice.push(-1)
        plan_members = plan_members + 1
        router_role = router_role + 1
      }
      block_member_end_column.push(plan_members)
      plan_blocks = plan_blocks + 1

      mut expert := 0
      loop {
        if expert >= n_expert { break }
        block_kind_column.push(3)
        block_layer_column.push(layer)
        block_expert_column.push(expert)
        block_member_start_column.push(plan_members)
        mut expert_slot := 0
        loop {
          if expert_slot >= expert_members { break }
          request_role.push(expert_member_role(fused, expert_slot))
          request_layer.push(layer)
          request_slice.push(expert)
          plan_members = plan_members + 1
          expert_slot = expert_slot + 1
        }
        block_member_end_column.push(plan_members)
        plan_blocks = plan_blocks + 1
        expert = expert + 1
      }
      layer = layer + 1
    }

    block_kind_column.push(0)
    block_layer_column.push(-1)
    block_expert_column.push(-1)
    block_member_start_column.push(plan_members)
    request_role.push(22)
    request_layer.push(-1)
    request_slice.push(-1)
    plan_members = plan_members + 1
    request_role.push(23)
    request_layer.push(-1)
    request_slice.push(-1)
    plan_members = plan_members + 1
    block_member_end_column.push(plan_members)
    plan_blocks = plan_blocks + 1

    // Pass 2: the text stream and the shape columns. Splitting the plan into a request pass and a
    // rendering pass keeps one copy of the naming and shape logic, which is what a `builder`
    // parameter would otherwise buy (Align Request 24, `PROPOSED` and unconsumed).
    roles := request_role.build()
    layers := request_layer.build()
    slices := request_slice.build()
    mut request := 0
    loop {
      if request >= roles.len() { break }
      role := roles[request]
      member_layer := layers[request]
      slice_index := slices[request]

      label := role_label(role)
      member_roles.push(label.clone())

      wanted := role_tensor_name(role, member_layer)
      wanted_view: str := wanted
      // Tied embeddings: an absent `output.weight` puts `token_embd.weight` in two blocks, and the
      // coverage accounting counts its bytes once. R1's rule, unchanged.
      resolved := if role == 23 && gguf.find_tensor(table, wanted_view) < 0 {
        "token_embd.weight".clone()
      } else {
        wanted.clone()
      }
      member_names.push(resolved)

      want := expected_shape(role, hyper)
      member_required_column.push(role_required(role))
      member_n_dims_column.push(want.n_dims)
      member_dim0_column.push(want.d0)
      member_dim1_column.push(want.d1)
      member_dim2_column.push(want.d2)
      member_dim3_column.push(want.d3)
      if want.sliced {
        member_slice_index_column.push(slice_index)
        member_slice_count_column.push(n_expert)
      } else {
        member_slice_index_column.push(-1)
        member_slice_count_column.push(-1)
      }
      request = request + 1
    }
    break
  }

  architecture_view: str := table.architecture
  rms_eps_view: str := rms_eps_text
  freq_base_view: str := freq_base_text
  head_dim_source_view: str := head_dim_source
  n_ff_exp_source_view: str := n_ff_exp_source
  expert_layout_view: str := expert_layout
  rope_dim_source_view: str := rope_dim_source
  rope_scaling_view: str := rope_scaling_json

  model := builder()
  model.write("{\"arch\":")
  model.write(model_ir.json_text_or_null(architecture_view, table.architecture_present))
  model.write(",\"n_layer\":")
  model.write_int(n_layer)
  model.write(",\"n_embd\":")
  model.write_int(n_embd)
  model.write(",\"n_head\":")
  model.write_int(n_head)
  model.write(",\"n_head_kv\":")
  model.write_int(n_head_kv)
  model.write(",\"head_dim\":")
  model.write_int(head_dim)
  model.write(",\"head_dim_source\":")
  model.write(model_ir.json_text_or_null(head_dim_source_view, head_dim_source_view.len() > 0))
  model.write(",\"n_ff\":")
  model.write_int(n_ff)
  model.write(",\"n_ff_exp\":")
  model.write_int(n_ff_exp)
  model.write(",\"n_ff_exp_source\":")
  model.write(model_ir.json_text_or_null(n_ff_exp_source_view, n_ff_exp_source_view.len() > 0))
  model.write(",\"n_vocab\":")
  model.write_int(n_vocab)
  model.write(",\"n_expert\":")
  model.write_int(n_expert)
  model.write(",\"n_expert_used\":")
  model.write_int(n_expert_used)
  model.write(",\"expert_ffn_layout\":")
  model.write(model_ir.json_text_or_null(expert_layout_view, expert_layout_view.len() > 0))
  model.write(",\"context_length\":")
  model.write_int(context_length)
  model.write(",\"sliding_window\":")
  if sliding_window_present {
    model.write_int(sliding_window)
  } else {
    model.write("null")
  }
  model.write(",\"sliding_window_pattern\":")
  if sliding_window_pattern_present {
    model.write_int(sliding_window_pattern)
  } else {
    model.write("null")
  }
  model.write(",\"rms_eps\":")
  model.write(rms_eps_view)
  model.write(",\"rms_eps_bits\":")
  rms_eps_hex := model_ir.hex32(rms_eps_bits)
  rms_eps_hex_view: str := rms_eps_hex
  model.write(model_ir.json_text_or_null(rms_eps_hex_view, rms_eps_bits >= 0))
  model.write(",\"rope\":{\"type\":")
  model.write_int(rope_type)
  model.write(",\"type_name\":")
  model.write(model_ir.json_text_or_null("neox", rope_type >= 0))
  model.write(",\"type_source\":")
  model.write(model_ir.json_text_or_null("architecture", rope_type >= 0))
  model.write(",\"freq_base\":")
  model.write(freq_base_view)
  model.write(",\"freq_base_bits\":")
  freq_base_hex := model_ir.hex32(freq_base_bits)
  freq_base_hex_view: str := freq_base_hex
  model.write(model_ir.json_text_or_null(freq_base_hex_view, freq_base_bits >= 0))
  model.write(",\"dim_count\":")
  model.write_int(rope_dim_count)
  model.write(",\"dim_count_source\":")
  model.write(model_ir.json_text_or_null(rope_dim_source_view, rope_dim_source_view.len() > 0))
  model.write(",\"scaling_type\":")
  model.write(rope_scaling_view)
  model.write("}}")

  plan := model_ir.BlockPlan {
    arch: architecture_view.clone(),
    arch_present: table.architecture_present,
    model_json: model.to_string(),
    n_layer: n_layer,
    n_embd: n_embd,
    n_head: n_head,
    n_head_kv: n_head_kv,
    head_dim: head_dim,
    n_ff: n_ff,
    n_vocab: n_vocab,
    n_expert: n_expert,
    context_length: context_length,
    rope_freq_base_bits: freq_base_bits,
    rms_eps_bits: rms_eps_bits,
    file_type: file_type,
    file_type_present: file_type_present,
    block_count: plan_blocks,
    block_kind: block_kind_column.build(),
    block_layer: block_layer_column.build(),
    block_expert: block_expert_column.build(),
    block_member_start: block_member_start_column.build(),
    block_member_end: block_member_end_column.build(),
    member_count: plan_members,
    member_roles: member_roles.build(),
    member_names: member_names.build(),
    member_required: member_required_column.build(),
    member_n_dims: member_n_dims_column.build(),
    member_dim0: member_dim0_column.build(),
    member_dim1: member_dim1_column.build(),
    member_dim2: member_dim2_column.build(),
    member_dim3: member_dim3_column.build(),
    member_slice_index: member_slice_index_column.build(),
    member_slice_count: member_slice_count_column.build(),
  }

  return model_ir.Prepared {
    code: code.clone(),
    detail: detail.clone(),
    geometry: geometry,
    plan: plan,
  }
}
