module provider_runtime

import alignpack
import decode_step
import moe_decode_step
import frontend_qwen
import frontend_olmoe
import gguf
import model
import model_ir
import runtime_device
import runtime_numeric_stream
import runtime_observation
import runtime_generation
import runtime_options
import runtime_pack_identity
import tokenizer_qwen2
import core.json
import std.fs
import std.time
import ggml_ffi
import result
import runtime_session_io
import runtime_session_request

MAX_PATH_BYTES := 4096
MAX_GEOMETRY_BYTES := 16777216
MAX_RESPONSE_BYTES := 1048576

GeometryPath {
  path: string,
}

fn valid_path(value: str) -> bool {
  return value.len() > 0 && value.len() <= MAX_PATH_BYTES && !value.contains("\0")
}

fn tokenizer_ok(value: tokenizer_qwen2.TokenizerStatus) -> bool = match value {
  Ok => true,
  Error => false,
}

fn ir_ok(value: model_ir.IrStatus) -> bool = match value {
  Ok => true,
  Error => false,
}

fn validate_kind(kind: model.ProviderKind) -> Result<(), Error> = match kind {
  AlignRuntime => Ok(()),
  _ => Err(Error.Invalid),
}

fn validate_generate(config: model.ProviderConfig, request: model.GenerationRequest) -> Result<(), Error> {
  validate_kind(config.kind)?
  if config.endpoint.len() > 0 || config.api_key.len() > 0 || config.tokenize_endpoint.len() > 0
    || config.timeout_ns != 0 {
    return Err(Error.Invalid)
  }
  if !valid_path(config.model) || !valid_path(config.runtime_pack_path)
    || !valid_path(config.runtime_geometry_path) {
    return Err(Error.Invalid)
  }
  if config.max_response_bytes < 1 || config.max_response_bytes > MAX_RESPONSE_BYTES {
    return Err(Error.Invalid)
  }
  if config.runtime_cache_budget_bytes < 0 { return Err(Error.Invalid) }
  if config.runtime_options_path.len() > MAX_PATH_BYTES
    || config.runtime_options_path.contains("\0") {
    return Err(Error.Invalid)
  }
  if request.max_tokens < 1 || request.max_tokens > 128 {
    return Err(Error.Invalid)
  }
  valid_sampling := match request.seed {
    Some(_) => request.temperature == 0.3,
    None => request.temperature == 0.0,
  }
  if !valid_sampling { return Err(Error.Invalid) }
  return Ok(())
}

fn read_geometry(path: str) -> Result<string, Error> {
  source := fs.open(path)?
  mut accumulated := buffer(0)
  mut chunk := buffer(65536)
  mut total := 0
  loop {
    if total == MAX_GEOMETRY_BYTES {
      mut probe := buffer(1)
      if source.read(probe)? > 0 { return Err(Error.Invalid) }
      break
    }
    remaining := MAX_GEOMETRY_BYTES - total
    count := if remaining < 65536 {
      mut tail := buffer(remaining)
      read_count := source.read(tail)?
      accumulated.append(tail.bytes())
      read_count
    } else {
      read_count := source.read(chunk)?
      accumulated.append(chunk.bytes())
      read_count
    }
    if count == 0 { break }
    total = total + count
  }
  return Ok(accumulated.bytes().as_str()?.clone())
}

fn contains_id(borrow ids: array<i64>, value: i64) -> bool {
  mut at := 0
  loop {
    if at >= ids.len() { break }
    if ids[at] == value { return true }
    at = at + 1
  }
  return false
}

GenerationRun { ok: bool, token_ids_json: string }

fn generate_qwen(
  config: model.ProviderConfig,
  geometry: str,
  source_identity: alignpack.SourceIdentity,
  borrow prompt_ids: array<i64>,
  borrow eog_ids: array<i64>,
  max_tokens: i64,
) -> GenerationRun {
  parts := decode_step.generate_resident(
    config.runtime_pack_path, config.runtime_geometry_path, geometry, source_identity,
    prompt_ids, eog_ids, max_tokens)
  return GenerationRun {
    ok: parts.outcome.code.len() == 0,
    token_ids_json: parts.token_ids_json.clone(),
  }
}

fn generate_olmoe(
  config: model.ProviderConfig,
  geometry: str,
  source_identity: alignpack.SourceIdentity,
  borrow prompt_ids: array<i64>,
  borrow eog_ids: array<i64>,
  max_tokens: i64,
  seed: Option<i64>,
) -> GenerationRun {
  parts := match seed {
    Some(value) => moe_decode_step.generate_resident_sampled(
      config.runtime_pack_path, config.runtime_geometry_path, geometry, source_identity,
      prompt_ids, eog_ids, max_tokens, config.runtime_cache_budget_bytes, value),
    None => moe_decode_step.generate_resident(
      config.runtime_pack_path, config.runtime_geometry_path, geometry, source_identity,
      prompt_ids, eog_ids, max_tokens, config.runtime_cache_budget_bytes),
  }
  return GenerationRun {
    ok: parts.outcome.code.len() == 0,
    token_ids_json: parts.token_ids_json.clone(),
  }
}

pub TraceResult { text: string, token_ids: array<i64>, prompt_ids: array<i64>, observation: runtime_observation.Snapshot }

pub fn generate(config: model.ProviderConfig, request: model.GenerationRequest) -> Result<string, Error> {
  mut stream := runtime_numeric_stream.disabled()
  mut builder: array_builder<i64> := array_builder()
  forced := builder.build()
  result := generate_mode(config, request, 0, forced, stream)?
  return Ok(result.text.clone())
}

pub fn generate_trace(config: model.ProviderConfig, request: model.GenerationRequest,
  mode: i64, borrow forced_ids: array<i64>, borrow mut stream: runtime_numeric_stream.Stream,
) -> Result<TraceResult, Error> {
  if mode != 1 && mode != 2 { return Err(Error.Invalid) }
  return generate_mode(config, request, mode, forced_ids, stream)
}

fn generate_mode(config: model.ProviderConfig, request: model.GenerationRequest,
  mode: i64, borrow forced_ids: array<i64>, borrow mut stream: runtime_numeric_stream.Stream,
) -> Result<TraceResult, Error> {
  validate_generate(config, request)?
  if forced_ids.len() > 4096 || (mode != 2 && forced_ids.len() > 0) { return Err(Error.Invalid) }
  forced := forced_ids.len() > 0
  gpu_options: Option<runtime_options.RuntimeOptions> := if config.runtime_options_path.len() > 0 {
    loaded := runtime_options.load(config.runtime_options_path)?
    if config.runtime_cache_budget_bytes > loaded.host_budget_bytes {
      return Err(Error.Invalid)
    }
    Some(loaded)
  } else { None }

  snapshot := gguf.open_snapshot(config.model)?
  table_ok := match snapshot.table.status { Ok => true, Error => false }
  if !table_ok { return Err(Error.Invalid) }
  architecture: str := snapshot.table.architecture
  olmoe := snapshot.table.architecture_present && architecture == "olmoe"
  qwen := snapshot.table.architecture_present && architecture == "qwen2"
  if (!olmoe && !qwen) || (qwen && config.runtime_cache_budget_bytes != 0)
    || (qwen && request.temperature != 0.0)
    || (olmoe && config.runtime_cache_budget_bytes <= 0) {
    return Err(Error.Invalid)
  }
  geometry := read_geometry(config.runtime_geometry_path)?
  geometry_view: str := geometry
  recorded: GeometryPath := json.decode(geometry_view)?
  if !valid_path(recorded.path) { return Err(Error.Invalid) }
  ir := if olmoe {
    frontend_olmoe.build_model_ir(snapshot.table, recorded.path)
  } else {
    frontend_qwen.build_model_ir(snapshot.table, recorded.path)
  }
  if !ir_ok(ir.status) { return Err(Error.Invalid) }
  derived_view: str := ir.document
  if geometry_view != derived_view { return Err(Error.Invalid) }

  source_identity := alignpack.verify_source_identity_snapshot(snapshot, config.runtime_pack_path)?
  runtime_source_identity := runtime_pack_identity.SourceIdentity {
    file_size: source_identity.file_size,
    data_offset: source_identity.data_offset,
    tensor_count: source_identity.tensor_count,
    kv_count: source_identity.kv_count,
    version: source_identity.version,
    alignment: source_identity.alignment,
    total_tensor_bytes: source_identity.total_tensor_bytes,
    header_region_sha256: source_identity.header_region_sha256.clone(),
  }
  prepared := tokenizer_qwen2.prepare_generation_snapshot(snapshot, request.system, request.user)?
  if !tokenizer_ok(prepared.status) { return Err(Error.Invalid) }
  decode_steps := if forced { forced_ids.len() } else {
    if request.max_tokens > 1 { request.max_tokens - 1 } else { 0 }
  }
  if prepared.token_ids.len() < 1 || prepared.token_ids.len() > 2048
    || prepared.token_ids.len() + decode_steps > ir.context_length
    || prepared.token_ids.len() + decode_steps > 4096 {
    return Err(Error.Invalid)
  }

  mut observation := runtime_observation.unavailable()
  generated_ids: array<i64> := match gpu_options {
    Some(options) => {
      generation_options := runtime_options.RuntimeOptions {
        schema_version: options.schema_version,
        backend: options.backend.clone(),
        device: options.device.clone(),
        backend_bundle: options.backend_bundle.clone(),
        placement: options.placement.clone(),
        host_budget_bytes: options.host_budget_bytes,
        device_budget_bytes: options.device_budget_bytes,
        prefetch: options.prefetch.clone(),
      }
      device := runtime_device.open(options)?
      ids := if mode == 2 {
        if olmoe {
          runtime_generation.generate_olmoe_diagnostic(
            device, generation_options, config.runtime_pack_path, runtime_source_identity,
            geometry_view,
            prepared.token_ids, prepared.eog_token_ids, request.max_tokens,
            config.runtime_cache_budget_bytes, request.seed, stream, forced_ids)?
        } else {
          runtime_generation.generate_qwen_diagnostic(
            device, generation_options, config.runtime_pack_path, runtime_source_identity,
            geometry_view,
            prepared.token_ids, prepared.eog_token_ids, request.max_tokens, stream, forced_ids)?
        }
      } else if mode == 1 {
        if olmoe {
          runtime_generation.generate_olmoe_observed(
            device, generation_options, config.runtime_pack_path, runtime_source_identity,
            geometry_view,
            prepared.token_ids, prepared.eog_token_ids, request.max_tokens,
            config.runtime_cache_budget_bytes, request.seed, stream)?
        } else {
          runtime_generation.generate_qwen_observed(
            device, generation_options, config.runtime_pack_path, runtime_source_identity,
            geometry_view,
            prepared.token_ids, prepared.eog_token_ids, request.max_tokens, stream)?
        }
      } else {
        if olmoe {
          runtime_generation.generate_olmoe(
            device, generation_options, config.runtime_pack_path, runtime_source_identity,
            geometry_view,
            prepared.token_ids, prepared.eog_token_ids, request.max_tokens,
            config.runtime_cache_budget_bytes, request.seed)?
        } else {
          runtime_generation.generate_qwen(
            device, generation_options, config.runtime_pack_path, runtime_source_identity,
            geometry_view,
            prepared.token_ids, prepared.eog_token_ids, request.max_tokens)?
        }
      }
      if mode == 1 { observation = runtime_observation.capture(device)? }
      ids
    }
    None => {
      generated := if mode != 0 {
        if olmoe {
          sampled := match request.seed { Some(_) => true, None => false }
          seed := match request.seed { Some(value) => value, None => 0 }
          parts := moe_decode_step.generate_resident_trace(
            config.runtime_pack_path, config.runtime_geometry_path, geometry_view, source_identity,
            prepared.token_ids, prepared.eog_token_ids, request.max_tokens,
            config.runtime_cache_budget_bytes, sampled, seed, mode, forced_ids, stream)
          GenerationRun { ok: parts.outcome.code.len() == 0, token_ids_json: parts.token_ids_json.clone() }
        } else {
          parts := decode_step.generate_resident_trace(
            config.runtime_pack_path, config.runtime_geometry_path, geometry_view, source_identity,
            prepared.token_ids, prepared.eog_token_ids, request.max_tokens, mode, forced_ids, stream)
          GenerationRun { ok: parts.outcome.code.len() == 0, token_ids_json: parts.token_ids_json.clone() }
        }
      } else if olmoe {
        generate_olmoe(
          config, geometry_view, source_identity, prepared.token_ids, prepared.eog_token_ids,
          request.max_tokens, request.seed)
      } else {
        generate_qwen(
          config, geometry_view, source_identity, prepared.token_ids, prepared.eog_token_ids,
          request.max_tokens)
      }
      if !generated.ok { return Err(Error.Invalid) }
      // The scalar JSON route carries its input lifetime; materialize the exported IDs.
      parsed: array<i64> := json.decode(generated.token_ids_json)?
      mut exported: array_builder<i64> := array_builder()
      mut at := 0
      loop {
        if at >= parsed.len() { break }
        exported.push(parsed[at])
        at = at + 1
      }
      exported.build()
    }
  }
  mut prompt_builder: array_builder<i64> := array_builder()
  mut prompt_at := 0
  loop {
    if prompt_at >= prepared.token_ids.len() { break }
    prompt_builder.push(prepared.token_ids[prompt_at])
    prompt_at = prompt_at + 1
  }
  prompt_ids := prompt_builder.build()
  if forced {
    if generated_ids.len() != forced_ids.len() + 1 { return Err(Error.Invalid) }
    return Ok(TraceResult { text: "".clone(), token_ids: generated_ids, prompt_ids: prompt_ids, observation: observation })
  }
  if generated_ids.len() < 1 || generated_ids.len() > request.max_tokens {
    return Err(Error.Invalid)
  }
  last := generated_ids[generated_ids.len() - 1]
  stopped_eog := contains_id(prepared.eog_token_ids, last)
  if !stopped_eog && generated_ids.len() != request.max_tokens { return Err(Error.Invalid) }
  completion_count := if stopped_eog { generated_ids.len() - 1 } else { generated_ids.len() }
  mut completion: array_builder<i64> := array_builder()
  mut at := 0
  loop {
    if at >= completion_count { break }
    completion.push(generated_ids[at])
    at = at + 1
  }
  completion_ids := completion.build()
  decoded := tokenizer_qwen2.decode_model(
    config.model,
    completion_ids,
    tokenizer_qwen2.DecodeSpecials.SkipControl,
  )?
  if !tokenizer_ok(decoded.status) { return Err(Error.Invalid) }
  prepared_tokenizer_id: str := prepared.tokenizer_id
  decoded_tokenizer_id: str := decoded.tokenizer_id
  if decoded_tokenizer_id != prepared_tokenizer_id || decoded.text.len() > config.max_response_bytes {
    return Err(Error.Invalid)
  }
  return Ok(TraceResult { text: decoded.text.clone(), token_ids: generated_ids, prompt_ids: prompt_ids, observation: observation })
}

pub fn stream(config: model.ProviderConfig, request: model.GenerationRequest) -> Result<string, Error> {
  validate_kind(config.kind)?
  return Err(Error.Invalid)
}

pub fn count_tokens(config: model.ProviderConfig, text: str) -> Result<model.TokenCount, Error> {
  validate_kind(config.kind)?
  if !valid_path(config.model) { return Err(Error.Invalid) }
  encoded := tokenizer_qwen2.encode_model(
    config.model,
    text,
    tokenizer_qwen2.EncodeSpecials.LiteralControl,
  )?
  if !tokenizer_ok(encoded.status) { return Err(Error.Invalid) }
  return Ok(model.TokenCount { count: encoded.token_ids.len(), exact: true })
}

pub fn count_prompt(config: model.ProviderConfig, request: model.GenerationRequest) -> model.TokenCount {
  validate_kind(config.kind) else {
    return model.TokenCount { count: -1, exact: false }
  }
  if !valid_path(config.model) {
    return model.TokenCount { count: -1, exact: false }
  }
  prepared := tokenizer_qwen2.prepare_generation_model(
    config.model,
    request.system,
    request.user,
  ) else {
    return model.TokenCount { count: -1, exact: false }
  }
  if !tokenizer_ok(prepared.status) {
    return model.TokenCount { count: -1, exact: false }
  }
  return model.TokenCount { count: prepared.token_ids.len(), exact: true }
}

fn session_host_reservation(borrow snapshot: gguf.GgufSnapshot, limit: i64) -> Result<i64, Error> {
  tokens := gguf.kv_array_length(snapshot.table, "tokenizer.ggml.tokens") else { return Err(Error.Invalid) }
  merges := gguf.kv_array_length(snapshot.table, "tokenizer.ggml.merges") else { return Err(Error.Invalid) }
  if tokens < 1 || tokens > 1048576 || merges < 0 || merges > 1048576
    || snapshot.table.kv_count < 0 || snapshot.table.kv_count > 1048576
    || snapshot.table.tensor_count < 0 || snapshot.table.tensor_count > 1048576
    || snapshot.table.data_offset < 0 || limit <= 67108864 { return Err(Error.Invalid) }
  rows := tokens + merges + snapshot.table.kv_count + snapshot.table.tensor_count
  row_bytes := rows * 256
  if row_bytes >= limit - 67108864 { return Err(Error.Invalid) }
  remaining := limit - 67108864 - row_bytes
  if snapshot.table.data_offset >= remaining / 32 { return Err(Error.Invalid) }
  return Ok(67108864 + row_bytes + snapshot.table.data_offset * 32)
}

fn worker_generate(borrow mut generation: runtime_generation.Session,
  borrow tokenizer: tokenizer_qwen2.GenerationTokenizer,
  borrow prepared: tokenizer_qwen2.GenerationPromptResult,
  borrow request: runtime_session_request.Request, model_path: str,
  started: i64) -> Result<string, Error> {
  ids := runtime_generation.generate_session(generation, prepared.token_ids,
    prepared.eog_token_ids, request.max_tokens, request.seed)?
  if ids.len() < 1 || ids.len() > request.max_tokens { return Err(Error.Invalid) }
  stopped := contains_id(prepared.eog_token_ids, ids[ids.len() - 1])
  if !stopped && ids.len() != request.max_tokens { return Err(Error.Invalid) }
  count := ids.len() - if stopped { 1 } else { 0 }
  mut completion: array_builder<i64> := array_builder()
  mut at := 0
  loop {
    if at >= count { break }
    completion.push(ids[at])
    at = at + 1
  }
  completion_ids := completion.build()
  decoded := tokenizer_qwen2.decode_retained(tokenizer, completion_ids,
    tokenizer_qwen2.DecodeSpecials.SkipControl)?
  if !tokenizer_ok(decoded.status) || decoded.text.len() > 262144 { return Err(Error.Invalid) }
  text_view: str := decoded.text
  record := result.GenerationRecord {
    schema_version: 2, operation: "generate", provider: "align-runtime", model: model_path,
    endpoint: "", status: "ok", output: text_view, prompt_tokens: prepared.token_ids.len(),
    completion_tokens: count, total_tokens: prepared.token_ids.len() + count,
    token_count_exact: true, elapsed_ns: time.instant() - started, error: "", error_code: -1,
  }
  encoded := json.encode_bounded(record, 2097088)?
  response := builder()
  response.write("{\"schema_version\":1,\"status\":\"ok\",\"result\":")
  response.write(encoded)
  response.write("}")
  return Ok(response.to_string())
}

pub SessionObservation {
  reserved_host_bytes: i64,
  native_host_peak: i64,
  weight_uploads_before: i64,
  weight_uploads_after: i64,
}

pub fn empty_session_observation() -> SessionObservation = SessionObservation {
  reserved_host_bytes: 0, native_host_peak: 0, weight_uploads_before: 0, weight_uploads_after: 0,
}

pub fn run_session(config: model.ProviderConfig) -> Result<(), Error> {
  mut observation := empty_session_observation()
  return run_session_observed(config, observation)
}

pub fn run_session_observed(config: model.ProviderConfig,
  borrow mut observation: SessionObservation) -> Result<(), Error> {
  empty_request := model.GenerationRequest {
    system: "", user: "", max_tokens: 1, temperature: 0.0, seed: None,
  }
  validate_generate(config, empty_request)?
  if config.runtime_options_path.len() == 0 { return Err(Error.Invalid) }
  options := runtime_options.load(config.runtime_options_path)?
  if config.runtime_cache_budget_bytes > options.host_budget_bytes { return Err(Error.Invalid) }
  snapshot := gguf.open_snapshot(config.model)?
  table_ok := match snapshot.table.status { Ok => true, Error => false }
  if !table_ok { return Err(Error.Invalid) }
  olmo := snapshot.table.architecture == "olmoe"
  if (!olmo && snapshot.table.architecture != "qwen2")
    || (olmo && config.runtime_cache_budget_bytes <= 0)
    || (!olmo && config.runtime_cache_budget_bytes != 0) { return Err(Error.Invalid) }
  geometry := read_geometry(config.runtime_geometry_path)?
  recorded: GeometryPath := json.decode(geometry)?
  if !valid_path(recorded.path) { return Err(Error.Invalid) }
  ir := if olmo { frontend_olmoe.build_model_ir(snapshot.table, recorded.path) } else { frontend_qwen.build_model_ir(snapshot.table, recorded.path) }
  if !ir_ok(ir.status) || geometry != ir.document { return Err(Error.Invalid) }
  source_identity := alignpack.verify_source_identity_snapshot(snapshot, config.runtime_pack_path)?
  identity := runtime_pack_identity.SourceIdentity {
    file_size: source_identity.file_size, data_offset: source_identity.data_offset,
    tensor_count: source_identity.tensor_count, kv_count: source_identity.kv_count,
    version: source_identity.version, alignment: source_identity.alignment,
    total_tensor_bytes: source_identity.total_tensor_bytes,
    header_region_sha256: source_identity.header_region_sha256.clone(),
  }
  reserved := session_host_reservation(snapshot, options.host_budget_bytes)?
  tokenizer := tokenizer_qwen2.load_generation_snapshot(snapshot)?
  // Device construction consumes options; preserve explicit session configuration first.
  retained_options := runtime_options.RuntimeOptions {
    schema_version: options.schema_version, backend: options.backend.clone(),
    device: options.device.clone(), backend_bundle: options.backend_bundle.clone(),
    placement: options.placement.clone(), host_budget_bytes: options.host_budget_bytes,
    device_budget_bytes: options.device_budget_bytes, prefetch: options.prefetch.clone(),
  }
  device := runtime_device.open(options)?
  mut generation := runtime_generation.create_session(device, retained_options, config.runtime_pack_path,
    identity, geometry, olmo, config.runtime_cache_budget_bytes, reserved)?
  observation.weight_uploads_before = ggml_ffi.gpu_weight_state(generation.owner, ggml_ffi.GPU_WEIGHT_UPLOADED)
  runtime_session_io.write_frame("{\"schema_version\":1,\"status\":\"ready\"}")?
  loop {
    incoming := runtime_session_io.read_frame()?
    match incoming {
      None => { break },
      Some(body) => {
        document := body.bytes().as_str()?
        started := time.instant()
        decoded := runtime_session_request.decode(document)
        match decoded {
          Err(_) => { runtime_session_io.write_frame("{\"schema_version\":1,\"status\":\"invalid\"}")? },
          Ok(request) => {
            valid_model := generation.olmoe || request.temperature == 0.0
            prepared: Result<tokenizer_qwen2.GenerationPromptResult, Error> := if valid_model {
              tokenizer_qwen2.prepare_retained(tokenizer, request.system, request.user)
            } else { Err(Error.Invalid) }
            match prepared {
              Err(_) => { runtime_session_io.write_frame("{\"schema_version\":1,\"status\":\"invalid\"}")? },
              Ok(prompt) => {
                if prompt.token_ids.len() < 1 || prompt.token_ids.len() > 2048
                  || prompt.token_ids.len() + request.max_tokens - 1 > generation.kv_capacity {
                  runtime_session_io.write_frame("{\"schema_version\":1,\"status\":\"invalid\"}")?
                } else {
                  match worker_generate(generation, tokenizer, prompt, request, config.model, started) {
                    Ok(response) => { runtime_session_io.write_frame(response)? },
                    Err(error) => {
                      runtime_session_io.write_frame("{\"schema_version\":1,\"status\":\"failed\"}")?
                      return Err(error)
                    },
                  }
                }
              },
            }
          },
        }
      },
    }
  }
  runtime_device.synchronize(generation.owner)?
  observation.reserved_host_bytes = ggml_ffi.gpu_host_reserved(generation.owner)
  observation.native_host_peak = ggml_ffi.gpu_observation_state(generation.owner, ggml_ffi.GPU_OBSERVATION_HOST_PEAK)
  observation.weight_uploads_after = ggml_ffi.gpu_weight_state(generation.owner, ggml_ffi.GPU_WEIGHT_UPLOADED)
  return Ok(())
}
