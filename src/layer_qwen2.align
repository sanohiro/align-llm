module layer_qwen2

import core.json

// R5A-DENSE-LAYER-FORWARD (`docs/specs/r5a-dense-layer-forward.md` section 3.5). The Qwen2 dense
// layer as **data**: the node table, the member-role table, the shape rules, the oracle table, the
// scalar derivations, and the causal mask. It contains no `extern` declaration, no `unsafe` block,
// no handle, and no file, and `scripts/run-layer-forward-smoke` asserts the first two by scanning
// `src/` for the block openers and finding only `src/ggml_ffi.align`.
//
// **The node table is the design.** A single loop in `src/layer_forward.align` walks it and issues
// one shim call per row, so adding a node is a row and the topology is something a test can assert
// on rather than control flow a reader has to simulate. The columns are the
// `GgufTable` / `BlockPlan` / `PackPlan` / `PackIndex` shape this repository has used five times.
//
// Section 2.6 is why every reference is an `i64` slot index rather than a handle: at this pin `raw`
// is refused as a struct field **and** as an array element, so the graph's `ggml_tensor *` values
// live in an Align-owned byte window the shim writes into, and this module never sees one.

// ---------------------------------------------------------------------------------------------
// Slots, ops, and the bounds
// ---------------------------------------------------------------------------------------------

// 13 weights + 3 inputs + 32 nodes = 48 used. The capacity is larger so an implementation mistake
// is a bounds refusal from the shim rather than a silent overwrite, and so `R5_SLOT`'s forced
// narrow-capacity build has a value to be narrower than.
pub MAX_NODE_SLOTS := 128
pub SLOT_HEADER_BYTES := 16
pub SLOT_BYTES := 8

pub NODE_COUNT := 32
pub MEMBER_COUNT := 13
pub ORACLE_COUNT := 20

pub SLOT_TOKENS := 13
pub SLOT_POS := 14
pub SLOT_MASK := 15
pub SLOT_NODE_BASE := 16

// Section 3.3. The cap is the oracle's, not the arithmetic's: `llama-eval-callback` prints every
// row of a tensor only while `ne1 <= 6`, and an oracle that compares fewer elements as the input
// grows while still reporting `PASS` is worse than one that refuses.
//
// R6-DECODE-KV-STEP1 (`docs/specs/r6-decode-kv-step1.md` section 2.7) lifts it from **6 to 8**, and
// the reason for 6 is unchanged and still respected. A decode graph's per-token tensors have
// `ne1 = 1`, so the instrument prints them in full at any prefill length, and the cap now binds the
// prefill pass alone: at `T = 7` a prefill tensor still prints 3+3 of 7 rows, which is exactly why
// R6 section 3.2 refuses to use a seven-token prefill as an acceptance oracle. 8 rather than 7
// leaves one position of headroom so a second decode step does not immediately re-open a shared
// constant; it is not a claim that eight rows are fully printed, because they are not.
// `src/layer_olmoe.align`'s own cap stays at 6: OLMoE is a declared non-goal of R6 and a shared lift
// would widen an arm this capability does not test.
pub MAX_PREFILL_TOKENS := 8

pub OP_GET_ROWS := 1
pub OP_RMS_NORM := 2
pub OP_MUL := 3
pub OP_ADD := 4
pub OP_MUL_MAT := 5
pub OP_RESHAPE_3D := 6
pub OP_PERMUTE := 7
pub OP_CONT_3D := 8
pub OP_ROPE := 9
pub OP_SOFT_MAX := 10
pub OP_SWIGLU := 11
// R5B section 3.6: the one new op. `ggml_pad` widens K and V to the instrument's declared
// attention width so the f32 reduction length matches llama.cpp's padded KV cache.
pub OP_PAD := 12
// R6-DECODE-KV-STEP1 section 2.5: the one new op. `ggml_concat` joins the KV plane's past columns
// to the decode step's single new column. The value mirrors `ALIGN_STUB_OP_CONCAT` one for one, as
// every other op here does; `13`, `14`, and `15` are the routed arm's kernels and this table has no
// use for them.
pub OP_CONCAT := 16

// `r4-alignpack-layer-major.md` section 2.4.4's frozen role list, the thirteen entries this layer
// needs. Members are located by `role_id` and never by name string and never by position.
pub ROLE_ATTN_NORM := 0
pub ROLE_ATTN_Q := 1
pub ROLE_ATTN_Q_BIAS := 2
pub ROLE_ATTN_K := 3
pub ROLE_ATTN_K_BIAS := 4
pub ROLE_ATTN_V := 5
pub ROLE_ATTN_V_BIAS := 6
pub ROLE_ATTN_OUTPUT := 7
pub ROLE_FFN_NORM := 8
pub ROLE_FFN_GATE := 9
pub ROLE_FFN_UP := 10
pub ROLE_FFN_DOWN := 11
pub ROLE_TOKEN_EMBD := 12
// R5B: the head's two roles, from the same frozen list.
pub ROLE_OUTPUT_NORM := 13
pub ROLE_OUTPUT := 14

// `src/model_ir.align:212`'s block-kind encoding, unchanged. R5A invents no kind of its own.
pub KIND_WEIGHT := 0
pub KIND_ATTENTION := 1
pub KIND_MLP := 2

pub GGML_TYPE_F32 := 0

// The `-inf` an f32 causal mask is made of, as a bit pattern. Section 3.5: the mask is written from
// bit patterns rather than float arithmetic, so nothing here depends on Align's rendering — or
// parsing — of infinity.
pub MASK_NEG_INFINITY_BITS := 4286578688
pub MASK_ZERO_BITS := 0

// `ggml_rope_ext`'s NEOX mode, and the `max_bias` of a model with no ALiBi.
pub ROPE_TYPE_NEOX := 2
pub MAX_BIAS_BITS := 0

// The geometry document this module consumes. `r1-qwen-model-ir.md`'s shipped surface is
// `kind: "R1_MODEL_IR"` at `schema_version: 2` and it publishes `rms_eps_bits` and `freq_base_bits`
// as lowercase IEEE-754 hex strings, which is what `--model-ir` emits and therefore what the
// qualification feeds this arm (section 6, correction C1).
pub GEOMETRY_KIND := "R1_MODEL_IR"
pub GEOMETRY_SCHEMA_VERSION := 2

// ---------------------------------------------------------------------------------------------
// The geometry
// ---------------------------------------------------------------------------------------------

pub Geometry {
  code: string,
  detail: string,
  arch: string,
  n_layer: i64,
  n_embd: i64,
  n_head: i64,
  n_head_kv: i64,
  head_dim: i64,
  n_ff: i64,
  n_vocab: i64,
  n_expert: i64,
  context_length: i64,
  rms_eps_bits: i64,
  rope_type: i64,
  rope_dim_count: i64,
  rope_freq_base_bits: i64,
  attn_scale_bits: i64,
}

pub fn empty_geometry() -> Geometry = Geometry {
  code: "".clone(),
  detail: "".clone(),
  arch: "".clone(),
  n_layer: 0,
  n_embd: 0,
  n_head: 0,
  n_head_kv: 0,
  head_dim: 0,
  n_ff: 0,
  n_vocab: 0,
  n_expert: -1,
  context_length: 0,
  rms_eps_bits: -1,
  rope_type: -1,
  rope_dim_count: 0,
  rope_freq_base_bits: -1,
  attn_scale_bits: 0,
}

// The attention scale, derived in Align rather than in C. Section 2.6 established that
// `core.math`'s float functions are **methods on the scalar** — `x.sqrt()` compiles, `sqrt(x)` and
// `math.sqrt(x)` do not — and the result crosses the boundary as a bit pattern, never as a float.
pub fn attn_scale_bits(head_dim: i64) -> i64 {
  if head_dim <= 0 { return 0 }
  mut window: buffer := buffer(4)
  scale: f32 := (1.0 as f32) / ((head_dim as f32).sqrt())
  window.put_f32_le(scale)
  view := window.bytes()
  if view.len() < 4 { return 0 }
  return view.u32_le(0) as i64
}

// Eight lowercase hexadecimal digits to the `u32` they name, or `-1`. `rms_eps_bits` and
// `freq_base_bits` are published as hex precisely because a rendered float is not authoritative,
// and this is the only place R5A turns text into a scalar ggml will see.
fn parse_bits32(text: str) -> i64 {
  view := text.bytes()
  if view.len() != 8 { return -1 }
  mut value := 0
  mut at := 0
  loop {
    if at >= 8 { break }
    byte := view.u8(at) as i64
    mut digit := -1
    if byte >= 48 && byte <= 57 { digit = byte - 48 }
    if byte >= 97 && byte <= 102 { digit = byte - 87 }
    if digit < 0 { return -1 }
    value = value * 16 + digit
    at = at + 1
  }
  return value
}

// The float a bit pattern names, judged before ggml ever sees it (section 6, correction C17).
//
// `rms_eps_bits` reaches `ggml_rms_norm`, which asserts `eps >= 0.0f` inside ggml, and
// `GGML_ASSERT` is `abort()`: no unwinding, no `Drop`, no document, no error code. A geometry
// document carrying `7fc00000` (NaN), `ff800000` (-inf), `bf800000` (-1.0), or `ffffffff` is a
// legal eight-hex-digit string that would take the process down at step 24. Align never
// interprets the pattern it forwards, so nothing else in the validation order can see it.
//
// `true` only for a finite, non-negative float: the sign bit clear and the exponent field not
// `0xff`, which is what an infinity and a NaN share.
fn bits32_finite_nonnegative(bits: i64) -> bool {
  if bits < 0 { return false }
  if bits >= 2147483648 { return false }
  exponent := (bits / 8388608) % 256
  if exponent == 255 { return false }
  return true
}

fn geometry_fault(borrow mut g: Geometry, detail: str) {
  if g.code.len() == 0 {
    g.code = "R5_GEOMETRY".clone()
    g.detail = detail.clone()
  }
}

// Section 3.8 steps 6 to 9, in order, first applicable row wins. Every consumed field is required:
// there is no default and no fallback, because a geometry that silently assumes `n_head_kv` would
// compute a different attention and still report `PASS`.
pub fn parse_geometry(text: str) -> Geometry {
  mut g := empty_geometry()
  mut parsed := false
  arena {
    match json.doc(text) {
      Ok(d) => {
        parsed = true
        match d.get("kind").as_str() {
          Some(value) => {
            if value != GEOMETRY_KIND { geometry_fault(g, "kind") }
          },
          None => { geometry_fault(g, "kind") },
        }
        match d.get("schema_version").as_i64() {
          Some(value) => {
            if value != GEOMETRY_SCHEMA_VERSION { geometry_fault(g, "schema_version") }
          },
          None => { geometry_fault(g, "schema_version") },
        }
        model := d.get("model")
        match model.get("arch").as_str() {
          Some(value) => { g.arch = value.clone() },
          None => { geometry_fault(g, "arch") },
        }
        match model.get("n_layer").as_i64() {
          Some(value) => { g.n_layer = value },
          None => { geometry_fault(g, "n_layer") },
        }
        match model.get("n_embd").as_i64() {
          Some(value) => { g.n_embd = value },
          None => { geometry_fault(g, "n_embd") },
        }
        match model.get("n_head").as_i64() {
          Some(value) => { g.n_head = value },
          None => { geometry_fault(g, "n_head") },
        }
        match model.get("n_head_kv").as_i64() {
          Some(value) => { g.n_head_kv = value },
          None => { geometry_fault(g, "n_head_kv") },
        }
        match model.get("head_dim").as_i64() {
          Some(value) => { g.head_dim = value },
          None => { geometry_fault(g, "head_dim") },
        }
        match model.get("n_ff").as_i64() {
          Some(value) => { g.n_ff = value },
          None => { geometry_fault(g, "n_ff") },
        }
        match model.get("n_vocab").as_i64() {
          Some(value) => { g.n_vocab = value },
          None => { geometry_fault(g, "n_vocab") },
        }
        match model.get("n_expert").as_i64() {
          Some(value) => { g.n_expert = value },
          None => { geometry_fault(g, "n_expert") },
        }
        match model.get("context_length").as_i64() {
          Some(value) => { g.context_length = value },
          None => { geometry_fault(g, "context_length") },
        }
        match model.get("rms_eps_bits").as_str() {
          Some(value) => { g.rms_eps_bits = parse_bits32(value) },
          None => { geometry_fault(g, "rms_eps_bits") },
        }
        rope := model.get("rope")
        match rope.get("type").as_i64() {
          Some(value) => { g.rope_type = value },
          None => { geometry_fault(g, "rope.type") },
        }
        match rope.get("dim_count").as_i64() {
          Some(value) => { g.rope_dim_count = value },
          None => { geometry_fault(g, "rope.dim_count") },
        }
        match rope.get("freq_base_bits").as_str() {
          Some(value) => { g.rope_freq_base_bits = parse_bits32(value) },
          None => { geometry_fault(g, "rope.freq_base_bits") },
        }
        // Section 3.5's five fixed RoPE constants are only correct for a model that declares no
        // scaling, so the precondition is checked rather than assumed. `Null` is the value the
        // document publishes for "none"; anything else, including a missing key, is a refusal.
        match rope.get("scaling_type").kind() {
          Null => {},
          _ => { geometry_fault(g, "rope.scaling_type") },
        }
      },
      Err(_) => {},
    }
  }
  if !parsed {
    geometry_fault(g, "json")
    return g
  }
  if g.code.len() > 0 { return g }
  if g.rms_eps_bits < 0 { geometry_fault(g, "rms_eps_bits") }
  if g.rope_freq_base_bits < 0 { geometry_fault(g, "rope.freq_base_bits") }
  if g.code.len() > 0 { return g }
  // The two patterns that become floats ggml computes with, refused here rather than at a
  // `GGML_ASSERT`. `freq_base` must additionally be positive: `00000000` is `+0.0`, which is a
  // legal pattern and not a legal RoPE base.
  if !bits32_finite_nonnegative(g.rms_eps_bits) { geometry_fault(g, "rms_eps_bits") }
  if !bits32_finite_nonnegative(g.rope_freq_base_bits) {
    geometry_fault(g, "rope.freq_base_bits")
  }
  if g.rope_freq_base_bits == 0 { geometry_fault(g, "rope.freq_base_bits") }
  if g.code.len() > 0 { return g }

  // Step 7's ranges, then step 8's self-consistency, then step 9's architecture preconditions.
  if g.n_layer < 1 { geometry_fault(g, "n_layer") }
  if g.n_embd < 1 { geometry_fault(g, "n_embd") }
  if g.n_head < 1 { geometry_fault(g, "n_head") }
  if g.n_head_kv < 1 { geometry_fault(g, "n_head_kv") }
  if g.head_dim < 1 { geometry_fault(g, "head_dim") }
  if g.n_ff < 1 { geometry_fault(g, "n_ff") }
  if g.n_vocab < 1 { geometry_fault(g, "n_vocab") }
  if g.context_length < 1 { geometry_fault(g, "context_length") }
  if g.code.len() > 0 { return g }
  if g.n_embd != g.n_head * g.head_dim { geometry_fault(g, "n_embd==n_head*head_dim") }
  if g.n_head % g.n_head_kv != 0 { geometry_fault(g, "n_head%n_head_kv") }
  if g.n_expert != 0 { geometry_fault(g, "n_expert") }
  if g.code.len() > 0 { return g }
  arch_view: str := g.arch
  if arch_view != "qwen2" { geometry_fault(g, "arch") }
  if g.rope_type != ROPE_TYPE_NEOX { geometry_fault(g, "rope.type") }
  if g.rope_dim_count != g.head_dim { geometry_fault(g, "rope.dim_count") }
  if g.code.len() > 0 { return g }
  // The head dimension must be even for NEOX pairing, and a mask row must fit an f32 image.
  if g.head_dim % 2 != 0 { geometry_fault(g, "head_dim") }
  if g.code.len() > 0 { return g }
  g.attn_scale_bits = attn_scale_bits(g.head_dim)
  return g
}

// ---------------------------------------------------------------------------------------------
// The member-role table and the shape rules
// ---------------------------------------------------------------------------------------------

// Thirteen members in **slot order**: slot `i` of the node-slot store holds member `i`. The order
// is a contract between this table and the node table below, and nothing else depends on it.
pub MemberTable {
  count: i64,
  names: string,
  name_start: array<i64>,
  name_end: array<i64>,
  role: array<i64>,
  block: array<i64>,
  ne0: array<i64>,
  ne1: array<i64>,
  n_dims: array<i64>,
}

// One row per slot: the role's label, its `role_id`, the block kind it lives in, and the exact
// shape the geometry says it must have. A member whose dims disagree is `R5_SHAPE` naming the role,
// never a tensor ggml is asked to build from a number the container invented.
fn member_label_of(row: i64) -> str {
  if row == 0 { return "token_embd" }
  if row == 1 { return "attn_norm" }
  if row == 2 { return "attn_q" }
  if row == 3 { return "attn_q_bias" }
  if row == 4 { return "attn_k" }
  if row == 5 { return "attn_k_bias" }
  if row == 6 { return "attn_v" }
  if row == 7 { return "attn_v_bias" }
  if row == 8 { return "attn_output" }
  if row == 9 { return "ffn_norm" }
  if row == 10 { return "ffn_gate" }
  if row == 11 { return "ffn_up" }
  return "ffn_down"
}

fn member_role_of(row: i64) -> i64 {
  if row == 0 { return ROLE_TOKEN_EMBD }
  if row == 1 { return ROLE_ATTN_NORM }
  if row == 2 { return ROLE_ATTN_Q }
  if row == 3 { return ROLE_ATTN_Q_BIAS }
  if row == 4 { return ROLE_ATTN_K }
  if row == 5 { return ROLE_ATTN_K_BIAS }
  if row == 6 { return ROLE_ATTN_V }
  if row == 7 { return ROLE_ATTN_V_BIAS }
  if row == 8 { return ROLE_ATTN_OUTPUT }
  if row == 9 { return ROLE_FFN_NORM }
  if row == 10 { return ROLE_FFN_GATE }
  if row == 11 { return ROLE_FFN_UP }
  return ROLE_FFN_DOWN
}

fn member_block_of(row: i64) -> i64 {
  if row == 0 { return KIND_WEIGHT }
  if row <= 8 { return KIND_ATTENTION }
  return KIND_MLP
}

// A 1-D member is one of the four norms or the three biases; everything else is 2-D. `ne0` is the
// row width ggml builds the tensor with and `ne1` is the row count, which for `token_embd` is the
// container's `n_vocab` and **not** the token count the arm row-gathers (section 3.7).
fn member_is_1d(row: i64) -> bool {
  return row == 1 || row == 3 || row == 5 || row == 7 || row == 9
}

fn member_ne0_of(borrow g: Geometry, row: i64) -> i64 {
  if row == 3 { return g.n_head * g.head_dim }
  if row == 5 { return g.n_head_kv * g.head_dim }
  if row == 7 { return g.n_head_kv * g.head_dim }
  if row == 12 { return g.n_ff }
  return g.n_embd
}

fn member_ne1_of(borrow g: Geometry, row: i64) -> i64 {
  if member_is_1d(row) { return 1 }
  if row == 0 { return g.n_vocab }
  if row == 2 { return g.n_head * g.head_dim }
  if row == 4 { return g.n_head_kv * g.head_dim }
  if row == 6 { return g.n_head_kv * g.head_dim }
  if row == 8 { return g.n_embd }
  if row == 10 { return g.n_ff }
  if row == 11 { return g.n_ff }
  return g.n_embd
}

pub fn member_table(borrow g: Geometry) -> MemberTable {
  labels := builder()
  mut names: array_builder<i64> := array_builder()
  mut ends: array_builder<i64> := array_builder()
  mut roles: array_builder<i64> := array_builder()
  mut blocks: array_builder<i64> := array_builder()
  mut d0: array_builder<i64> := array_builder()
  mut d1: array_builder<i64> := array_builder()
  mut dims: array_builder<i64> := array_builder()
  mut cursor := 0
  mut row := 0
  loop {
    if row >= MEMBER_COUNT { break }
    label := member_label_of(row)
    labels.write(label)
    names.push(cursor)
    cursor = cursor + label.len()
    ends.push(cursor)
    roles.push(member_role_of(row))
    blocks.push(member_block_of(row))
    d0.push(member_ne0_of(g, row))
    d1.push(member_ne1_of(g, row))
    dims.push(if member_is_1d(row) { 1 } else { 2 })
    row = row + 1
  }
  return MemberTable {
    count: MEMBER_COUNT,
    names: labels.to_string(),
    name_start: names.build(),
    name_end: ends.build(),
    role: roles.build(),
    block: blocks.build(),
    ne0: d0.build(),
    ne1: d1.build(),
    n_dims: dims.build(),
  }
}

pub fn member_label(borrow m: MemberTable, index: i64) -> str {
  names_view: str := m.names
  if index < 0 || index >= m.count { return "" }
  return names_view[m.name_start[index]..m.name_end[index]]
}

// ---------------------------------------------------------------------------------------------
// The node table
// ---------------------------------------------------------------------------------------------

pub NodeTable {
  count: i64,
  op: array<i64>,
  a: array<i64>,
  b: array<i64>,
  out: array<i64>,
  p0: array<i64>,
  p1: array<i64>,
  p2: array<i64>,
  p3: array<i64>,
  oracle: array<i64>,
  // R5B (`docs/specs/r5b-model-prefill-forward.md` section 3.6). `when` is the condition column:
  // `WHEN_ALWAYS` rows are issued by every graph, `WHEN_LAST` only by the last layer, `WHEN_WIDE`
  // only when the declared attention width exceeds the token count. R5A's table is all
  // `WHEN_ALWAYS` and its walk ignores the column.
  //
  // `alt_when`, `alt_a`, and `alt_b` are section 6 correction C2: a condition that adds a row also
  // moves the *operand* of the row that consumes it, and `when` alone cannot say so. A row whose
  // `alt_when` holds reads `alt_a`/`alt_b` instead of `a`/`b`; `-1` leaves that operand alone.
  when: array<i64>,
  alt_when: array<i64>,
  alt_a: array<i64>,
  alt_b: array<i64>,
}

// The thirty-two rows section 2.2's probe recorded, in the order `ggml_build_forward_expand`
// visits them, with `oracle` naming the row of the oracle table each observable node answers.
//
// `p0` to `p3` are op-specific: reshape and cont extents, permutation axes, the RoPE quadruple
// (`n_dims`, `mode`, `n_ctx_orig`, `freq_base_bits`), the RMS epsilon, and the softmax pair.
// Every scalar in them is Align's, computed from the geometry, and crosses as an integer.
pub fn node_table(borrow g: Geometry, tokens: i64) -> NodeTable {
  mut op: array_builder<i64> := array_builder()
  mut a: array_builder<i64> := array_builder()
  mut b: array_builder<i64> := array_builder()
  mut out: array_builder<i64> := array_builder()
  mut p0: array_builder<i64> := array_builder()
  mut p1: array_builder<i64> := array_builder()
  mut p2: array_builder<i64> := array_builder()
  mut p3: array_builder<i64> := array_builder()
  mut oracle: array_builder<i64> := array_builder()
  mut when: array_builder<i64> := array_builder()
  mut alt_when: array_builder<i64> := array_builder()
  mut alt_a: array_builder<i64> := array_builder()
  mut alt_b: array_builder<i64> := array_builder()

  n := SLOT_NODE_BASE
  eps := g.rms_eps_bits
  head_dim := g.head_dim
  n_head := g.n_head
  n_head_kv := g.n_head_kv
  scale := g.attn_scale_bits
  rope_base := g.rope_freq_base_bits
  ctx_orig := g.context_length

  mut row := 0
  loop {
    if row >= NODE_COUNT { break }
    mut r_op := 0
    mut r_a := -1
    mut r_b := -1
    mut r_p0 := 0
    mut r_p1 := 0
    mut r_p2 := 0
    mut r_p3 := 0
    mut r_oracle := -1
    if row == 0 {
      r_op = OP_GET_ROWS
      r_a = 0
      r_b = SLOT_TOKENS
      r_oracle = 0
    }
    if row == 1 {
      r_op = OP_RMS_NORM
      r_a = n + 0
      r_p0 = eps
      r_oracle = 1
    }
    if row == 2 {
      r_op = OP_MUL
      r_a = n + 1
      r_b = 1
      r_oracle = 2
    }
    if row == 3 {
      r_op = OP_MUL_MAT
      r_a = 2
      r_b = n + 2
    }
    if row == 4 {
      r_op = OP_ADD
      r_a = n + 3
      r_b = 3
      r_oracle = 3
    }
    if row == 5 {
      r_op = OP_MUL_MAT
      r_a = 4
      r_b = n + 2
    }
    if row == 6 {
      r_op = OP_ADD
      r_a = n + 5
      r_b = 5
      r_oracle = 4
    }
    if row == 7 {
      r_op = OP_MUL_MAT
      r_a = 6
      r_b = n + 2
    }
    if row == 8 {
      r_op = OP_ADD
      r_a = n + 7
      r_b = 7
      r_oracle = 5
    }
    if row == 9 {
      r_op = OP_RESHAPE_3D
      r_a = n + 4
      r_p0 = head_dim
      r_p1 = n_head
      r_p2 = tokens
    }
    if row == 10 {
      r_op = OP_RESHAPE_3D
      r_a = n + 6
      r_p0 = head_dim
      r_p1 = n_head_kv
      r_p2 = tokens
    }
    if row == 11 {
      r_op = OP_RESHAPE_3D
      r_a = n + 8
      r_p0 = head_dim
      r_p1 = n_head_kv
      r_p2 = tokens
    }
    if row == 12 {
      r_op = OP_ROPE
      r_a = n + 9
      r_b = SLOT_POS
      r_p0 = head_dim
      r_p1 = ROPE_TYPE_NEOX
      r_p2 = ctx_orig
      r_p3 = rope_base
      r_oracle = 6
    }
    if row == 13 {
      r_op = OP_ROPE
      r_a = n + 10
      r_b = SLOT_POS
      r_p0 = head_dim
      r_p1 = ROPE_TYPE_NEOX
      r_p2 = ctx_orig
      r_p3 = rope_base
      r_oracle = 7
    }
    if row == 14 {
      r_op = OP_PERMUTE
      r_a = n + 12
      r_p0 = 0
      r_p1 = 2
      r_p2 = 1
      r_p3 = 3
    }
    if row == 15 {
      r_op = OP_PERMUTE
      r_a = n + 13
      r_p0 = 0
      r_p1 = 2
      r_p2 = 1
      r_p3 = 3
    }
    if row == 16 {
      r_op = OP_MUL_MAT
      r_a = n + 15
      r_b = n + 14
      r_oracle = 8
    }
    if row == 17 {
      r_op = OP_SOFT_MAX
      r_a = n + 16
      r_b = SLOT_MASK
      r_p0 = scale
      r_p1 = MAX_BIAS_BITS
      r_oracle = 9
    }
    if row == 18 {
      r_op = OP_PERMUTE
      r_a = n + 11
      r_p0 = 1
      r_p1 = 2
      r_p2 = 0
      r_p3 = 3
    }
    if row == 19 {
      r_op = OP_CONT_3D
      r_a = n + 18
      r_p0 = tokens
      r_p1 = head_dim
      r_p2 = n_head_kv
    }
    if row == 20 {
      r_op = OP_MUL_MAT
      r_a = n + 19
      r_b = n + 17
      r_oracle = 10
    }
    if row == 21 {
      r_op = OP_PERMUTE
      r_a = n + 20
      r_p0 = 0
      r_p1 = 2
      r_p2 = 1
      r_p3 = 3
    }
    if row == 22 {
      r_op = OP_CONT_3D
      r_a = n + 21
      r_p0 = g.n_embd
      r_p1 = tokens
      r_p2 = 1
      r_oracle = 11
    }
    if row == 23 {
      r_op = OP_MUL_MAT
      r_a = 8
      r_b = n + 22
      r_oracle = 12
    }
    if row == 24 {
      r_op = OP_ADD
      r_a = n + 23
      r_b = n + 0
      r_oracle = 13
    }
    if row == 25 {
      r_op = OP_RMS_NORM
      r_a = n + 24
      r_p0 = eps
    }
    if row == 26 {
      r_op = OP_MUL
      r_a = n + 25
      r_b = 9
      r_oracle = 14
    }
    if row == 27 {
      r_op = OP_MUL_MAT
      r_a = 10
      r_b = n + 26
      r_oracle = 15
    }
    if row == 28 {
      r_op = OP_MUL_MAT
      r_a = 11
      r_b = n + 26
      r_oracle = 16
    }
    if row == 29 {
      r_op = OP_SWIGLU
      r_a = n + 27
      r_b = n + 28
      r_oracle = 17
    }
    if row == 30 {
      r_op = OP_MUL_MAT
      r_a = 12
      r_b = n + 29
      r_oracle = 18
    }
    if row == 31 {
      r_op = OP_ADD
      r_a = n + 30
      r_b = n + 24
      r_oracle = 19
    }
    op.push(r_op)
    a.push(r_a)
    b.push(r_b)
    out.push(n + row)
    p0.push(r_p0)
    p1.push(r_p1)
    p2.push(r_p2)
    p3.push(r_p3)
    oracle.push(r_oracle)
    when.push(WHEN_ALWAYS)
    alt_when.push(WHEN_ALWAYS)
    alt_a.push(-1)
    alt_b.push(-1)
    row = row + 1
  }
  return NodeTable {
    count: NODE_COUNT,
    op: op.build(),
    a: a.build(),
    b: b.build(),
    out: out.build(),
    p0: p0.build(),
    p1: p1.build(),
    p2: p2.build(),
    p3: p3.build(),
    oracle: oracle.build(),
    when: when.build(),
    alt_when: alt_when.build(),
    alt_a: alt_a.build(),
    alt_b: alt_b.build(),
  }
}

// The last node. `l_out` is what the graph is expanded from and what `output.sha256` digests.
pub fn output_slot() -> i64 {
  return SLOT_NODE_BASE + NODE_COUNT - 1
}

// ---------------------------------------------------------------------------------------------
// The oracle table
// ---------------------------------------------------------------------------------------------

// Twenty rows: the eighteen nodes section 3.6 compares, plus `kq` and `kq_soft_max`, which are
// present, marked, and read back but **excluded by contract**. Their exclusion is structural and
// not numerical: llama.cpp's `n_kv` is a padded KV-cache width and R5A has no cache, so the tensors
// are different shapes and element comparison is undefined. Publishing them as
// `oracle: "shape_incomparable"` makes the exclusion a document field rather than a silent gap.
pub OracleTable {
  count: i64,
  text: string,
  id_start: array<i64>,
  id_end: array<i64>,
  name_start: array<i64>,
  name_end: array<i64>,
  op_start: array<i64>,
  op_end: array<i64>,
  node: array<i64>,
  compared: array<i64>,
  by_weight: array<i64>,
}

fn oracle_id_of(row: i64) -> str {
  if row == 0 { return "embd" }
  if row == 1 { return "norm" }
  if row == 2 { return "attn_norm" }
  if row == 3 { return "q_bias" }
  if row == 4 { return "k_bias" }
  if row == 5 { return "v_bias" }
  if row == 6 { return "q_rope" }
  if row == 7 { return "k_rope" }
  if row == 8 { return "kq" }
  if row == 9 { return "kq_soft_max" }
  if row == 10 { return "kqv" }
  if row == 11 { return "kqv_out" }
  if row == 12 { return "attn_out" }
  if row == 13 { return "ffn_inp" }
  if row == 14 { return "ffn_norm" }
  if row == 15 { return "ffn_gate" }
  if row == 16 { return "ffn_up" }
  if row == 17 { return "ffn_swiglu" }
  if row == 18 { return "ffn_out" }
  return "l_out"
}

// The transcript's own names, not the plan's. Section 2.2 fact 1: the first node is `embd`, not the
// `inp_embd` the plan invented, and it carries no layer suffix because it is the graph's input
// rather than the layer's. Every other stem is suffixed with `-L`.
fn oracle_stem_of(row: i64) -> str {
  if row == 0 { return "embd" }
  if row == 1 { return "norm" }
  if row == 2 { return "attn_norm" }
  if row == 3 { return "Qcur" }
  if row == 4 { return "Kcur" }
  if row == 5 { return "Vcur" }
  if row == 6 { return "Qcur" }
  if row == 7 { return "Kcur" }
  if row == 8 { return "kq" }
  if row == 9 { return "kq_soft_max" }
  if row == 10 { return "kqv" }
  if row == 11 { return "kqv_out" }
  if row == 13 { return "ffn_inp" }
  if row == 14 { return "ffn_norm" }
  if row == 15 { return "ffn_gate" }
  if row == 16 { return "ffn_up" }
  if row == 17 { return "ffn_swiglu" }
  if row == 18 { return "ffn_out" }
  return "l_out"
}

fn oracle_op_of(row: i64) -> str {
  if row == 0 { return "GET_ROWS" }
  if row == 1 { return "RMS_NORM" }
  if row == 2 { return "MUL" }
  if row == 3 { return "ADD" }
  if row == 4 { return "ADD" }
  if row == 5 { return "ADD" }
  if row == 6 { return "ROPE" }
  if row == 7 { return "ROPE" }
  if row == 8 { return "MUL_MAT" }
  if row == 9 { return "SOFT_MAX" }
  if row == 10 { return "MUL_MAT" }
  if row == 11 { return "CONT" }
  if row == 12 { return "MUL_MAT" }
  if row == 13 { return "ADD" }
  if row == 14 { return "MUL" }
  if row == 15 { return "MUL_MAT" }
  if row == 16 { return "MUL_MAT" }
  if row == 17 { return "SWIGLU" }
  if row == 18 { return "MUL_MAT" }
  return "ADD"
}

fn oracle_node_of(row: i64) -> i64 {
  if row == 0 { return 0 }
  if row == 1 { return 1 }
  if row == 2 { return 2 }
  if row == 3 { return 4 }
  if row == 4 { return 6 }
  if row == 5 { return 8 }
  if row == 6 { return 12 }
  if row == 7 { return 13 }
  if row == 8 { return 16 }
  if row == 9 { return 17 }
  if row == 10 { return 20 }
  if row == 11 { return 22 }
  if row == 12 { return 23 }
  if row == 13 { return 24 }
  if row == 14 { return 26 }
  if row == 15 { return 27 }
  if row == 16 { return 28 }
  if row == 17 { return 29 }
  if row == 18 { return 30 }
  return 31
}

// Row 12 is the attention output projection. Section 2.2 fact 3: it prints as `node_31` under
// `-fa off` and as `node_26` under flash attention, a positional name that moves when anything
// upstream changes, so it is matched by its **source weight name** and its op instead.
pub fn oracle_table(layer: i64) -> OracleTable {
  body := builder()
  mut ids: array_builder<i64> := array_builder()
  mut id_ends: array_builder<i64> := array_builder()
  mut names: array_builder<i64> := array_builder()
  mut name_ends: array_builder<i64> := array_builder()
  mut ops: array_builder<i64> := array_builder()
  mut op_ends: array_builder<i64> := array_builder()
  mut nodes: array_builder<i64> := array_builder()
  mut compared: array_builder<i64> := array_builder()
  mut weighted: array_builder<i64> := array_builder()
  suffix := builder()
  suffix.write("-")
  suffix.write_int(layer)
  suffix_text := suffix.to_string()
  suffix_view: str := suffix_text
  weight := builder()
  weight.write("blk.")
  weight.write_int(layer)
  weight.write(".attn_output.weight")
  weight_text := weight.to_string()
  weight_view: str := weight_text
  mut cursor := 0
  mut row := 0
  loop {
    if row >= ORACLE_COUNT { break }
    id := oracle_id_of(row)
    operation := oracle_op_of(row)
    body.write(id)
    ids.push(cursor)
    cursor = cursor + id.len()
    id_ends.push(cursor)
    names.push(cursor)
    if row == 12 {
      body.write(weight_view)
      cursor = cursor + weight_view.len()
    } else {
      stem := oracle_stem_of(row)
      body.write(stem)
      cursor = cursor + stem.len()
      if row != 0 {
        body.write(suffix_view)
        cursor = cursor + suffix_view.len()
      }
    }
    name_ends.push(cursor)
    ops.push(cursor)
    body.write(operation)
    cursor = cursor + operation.len()
    op_ends.push(cursor)
    nodes.push(oracle_node_of(row))
    compared.push(if row == 8 || row == 9 { 0 } else { 1 })
    weighted.push(if row == 12 { 1 } else { 0 })
    row = row + 1
  }
  return OracleTable {
    count: ORACLE_COUNT,
    text: body.to_string(),
    id_start: ids.build(),
    id_end: id_ends.build(),
    name_start: names.build(),
    name_end: name_ends.build(),
    op_start: ops.build(),
    op_end: op_ends.build(),
    node: nodes.build(),
    compared: compared.build(),
    by_weight: weighted.build(),
  }
}

pub fn oracle_id(borrow o: OracleTable, index: i64) -> str {
  view: str := o.text
  if index < 0 || index >= o.count { return "" }
  return view[o.id_start[index]..o.id_end[index]]
}

pub fn oracle_name(borrow o: OracleTable, index: i64) -> str {
  view: str := o.text
  if index < 0 || index >= o.count { return "" }
  return view[o.name_start[index]..o.name_end[index]]
}

pub fn oracle_op(borrow o: OracleTable, index: i64) -> str {
  view: str := o.text
  if index < 0 || index >= o.count { return "" }
  return view[o.op_start[index]..o.op_end[index]]
}

// ---------------------------------------------------------------------------------------------
// The causal mask
// ---------------------------------------------------------------------------------------------

// A `{T, T}` f32 image: `0.0` where a query at row `r` may attend to a key at column `c <= r`, and
// `-inf` elsewhere. It is written from bit patterns rather than float arithmetic, so no float is
// parsed, no float is formatted, and nothing depends on how Align renders infinity.
pub fn write_mask(borrow mut window: buffer, tokens: i64) {
  mut row := 0
  loop {
    if row >= tokens { break }
    mut col := 0
    loop {
      if col >= tokens { break }
      bits := if col <= row { MASK_ZERO_BITS } else { MASK_NEG_INFINITY_BITS }
      window.put_u32_le(bits as u32)
      col = col + 1
    }
    row = row + 1
  }
}

// ---------------------------------------------------------------------------------------------
// R5B-MODEL-PREFILL-FORWARD — three topologies as data
//
// `docs/specs/r5b-model-prefill-forward.md` section 3.6. The whole-model prefill is three node
// tables walked thirty times: a one-row embedding gather, a thirty-six-row layer table whose
// `when` column makes the narrowing and the reconciliation rows conditional data rather than
// control flow, and a three-row head. Section 2.4's probe measured the layer graph to be the
// **same** table for all twenty-eight layers once the residual is an input rather than a node,
// which is the property this section exists to make true.
// ---------------------------------------------------------------------------------------------

// Section 3.3. `KV_WIDTH` is an operand and this is its ceiling; R5B never contains the value the
// instrument happens to use (section 5.6).
pub MAX_ATTENTION_WIDTH := 4096

// The three conditions of the `when` column.
pub WHEN_ALWAYS := 0
pub WHEN_LAST := 1
pub WHEN_WIDE := 2
// R6-DECODE-KV-STEP1 section 2.4's fourth condition. A `WHEN_DECODE` row is issued only by the
// decode graph, and the two rows that carry it are the K and V `CONCAT`s — the only thing a decode
// layer does that a prefill layer does not. `3` is deliberately skipped: the value is the ledger's,
// and leaving a gap keeps a future condition from silently inheriting a meaning by adjacency.
pub WHEN_DECODE := 4

// The slot map, shared by all three graphs. Twelve weights, four inputs, thirty-six nodes: a
// high-water of 52 against `MAX_NODE_SLOTS` of 128. The embedding graph uses slot 0 for the
// row-gathered `token_embd` window and `MF_SLOT_TOKENS` for its index vector; the head uses slots
// 0 and 1 for `output_norm` and `output` and `MF_SLOT_CUR` for the narrowed residual.
pub MF_SLOT_CUR := 12
pub MF_SLOT_TOKENS := 12
pub MF_SLOT_POS := 13
pub MF_SLOT_MASK := 14
pub MF_SLOT_OUT_IDS := 15
pub MF_SLOT_NODE_BASE := 16

// R6-DECODE-KV-STEP1 section 2.3. The decode graph's two extra **inputs**: the KV plane's past K
// and its past V for this layer, uploaded with `slot_set` from Align-owned host bytes.
//
// 64 and 65 rather than 16 and 17 for one reason and it is a golden one. Node slots are
// `MF_SLOT_NODE_BASE + row` and a decode layer has 38 rows, so the decode arm's own node slots reach
// 53 and these two sit above them; renumbering the input block instead would move `MF_SLOT_CUR`
// through `MF_SLOT_OUT_IDS` and every R5A/R5B/R5C/R5D golden with them. Because the prefill arm
// allocates neither slot, its `slot_high_water` stays 52 and **no existing golden moves**. The
// decode arm's own high-water is 66, which is asserted in its own golden and in no other.
pub MF_SLOT_KPAST := 64
pub MF_SLOT_VPAST := 65

pub MF_LAYER_NODE_COUNT := 36
pub MF_EMBED_NODE_COUNT := 1
pub MF_HEAD_NODE_COUNT := 3

pub MF_LAYER_MEMBER_COUNT := 12
pub MF_EMBED_MEMBER_COUNT := 1
pub MF_HEAD_MEMBER_COUNT := 2

// Nineteen rows per layer: the seventeen section 3.7 compares plus `kq-L` and `kq_soft_max-L`,
// which are matched, shape-checked against `KV_WIDTH`, and excluded from element comparison.
pub MF_LAYER_ORACLE_COUNT := 19
pub MF_EMBED_ORACLE_COUNT := 1
pub MF_HEAD_ORACLE_COUNT := 2

// ---------------------------------------------------------------------------------------------
// The member tables
// ---------------------------------------------------------------------------------------------

// Twelve members in slot order. `token_embd` is gone: it is the embedding graph's own member, and
// removing it from the layer is what makes all twenty-eight layer graphs the same table.
fn mf_layer_label_of(row: i64) -> str {
  if row == 0 { return "attn_norm" }
  if row == 1 { return "attn_q" }
  if row == 2 { return "attn_q_bias" }
  if row == 3 { return "attn_k" }
  if row == 4 { return "attn_k_bias" }
  if row == 5 { return "attn_v" }
  if row == 6 { return "attn_v_bias" }
  if row == 7 { return "attn_output" }
  if row == 8 { return "ffn_norm" }
  if row == 9 { return "ffn_gate" }
  if row == 10 { return "ffn_up" }
  return "ffn_down"
}

fn mf_layer_role_of(row: i64) -> i64 {
  if row == 0 { return ROLE_ATTN_NORM }
  if row == 1 { return ROLE_ATTN_Q }
  if row == 2 { return ROLE_ATTN_Q_BIAS }
  if row == 3 { return ROLE_ATTN_K }
  if row == 4 { return ROLE_ATTN_K_BIAS }
  if row == 5 { return ROLE_ATTN_V }
  if row == 6 { return ROLE_ATTN_V_BIAS }
  if row == 7 { return ROLE_ATTN_OUTPUT }
  if row == 8 { return ROLE_FFN_NORM }
  if row == 9 { return ROLE_FFN_GATE }
  if row == 10 { return ROLE_FFN_UP }
  return ROLE_FFN_DOWN
}

fn mf_layer_is_1d(row: i64) -> bool {
  return row == 0 || row == 2 || row == 4 || row == 6 || row == 8
}

fn mf_layer_ne0_of(borrow g: Geometry, row: i64) -> i64 {
  if row == 2 { return g.n_head * g.head_dim }
  if row == 4 { return g.n_head_kv * g.head_dim }
  if row == 6 { return g.n_head_kv * g.head_dim }
  if row == 11 { return g.n_ff }
  return g.n_embd
}

fn mf_layer_ne1_of(borrow g: Geometry, row: i64) -> i64 {
  if mf_layer_is_1d(row) { return 1 }
  if row == 1 { return g.n_head * g.head_dim }
  if row == 3 { return g.n_head_kv * g.head_dim }
  if row == 5 { return g.n_head_kv * g.head_dim }
  if row == 7 { return g.n_embd }
  if row == 9 { return g.n_ff }
  if row == 10 { return g.n_ff }
  return g.n_embd
}

pub fn mf_layer_member_table(borrow g: Geometry) -> MemberTable {
  labels := builder()
  mut names: array_builder<i64> := array_builder()
  mut ends: array_builder<i64> := array_builder()
  mut roles: array_builder<i64> := array_builder()
  mut blocks: array_builder<i64> := array_builder()
  mut d0: array_builder<i64> := array_builder()
  mut d1: array_builder<i64> := array_builder()
  mut dims: array_builder<i64> := array_builder()
  mut cursor := 0
  mut row := 0
  loop {
    if row >= MF_LAYER_MEMBER_COUNT { break }
    label := mf_layer_label_of(row)
    labels.write(label)
    names.push(cursor)
    cursor = cursor + label.len()
    ends.push(cursor)
    roles.push(mf_layer_role_of(row))
    blocks.push(if row <= 7 { KIND_ATTENTION } else { KIND_MLP })
    d0.push(mf_layer_ne0_of(g, row))
    d1.push(mf_layer_ne1_of(g, row))
    dims.push(if mf_layer_is_1d(row) { 1 } else { 2 })
    row = row + 1
  }
  return MemberTable {
    count: MF_LAYER_MEMBER_COUNT,
    names: labels.to_string(),
    name_start: names.build(),
    name_end: ends.build(),
    role: roles.build(),
    block: blocks.build(),
    ne0: d0.build(),
    ne1: d1.build(),
    n_dims: dims.build(),
  }
}

// One member: the embedding rows this prefill gathers. `ne1` is the container's `n_vocab`, which is
// what the pack's member record must declare; the tensor the arm builds is `T` rows wide.
pub fn mf_embed_member_table(borrow g: Geometry) -> MemberTable {
  labels := builder()
  mut names: array_builder<i64> := array_builder()
  mut ends: array_builder<i64> := array_builder()
  mut roles: array_builder<i64> := array_builder()
  mut blocks: array_builder<i64> := array_builder()
  mut d0: array_builder<i64> := array_builder()
  mut d1: array_builder<i64> := array_builder()
  mut dims: array_builder<i64> := array_builder()
  labels.write("token_embd")
  names.push(0)
  ends.push(10)
  roles.push(ROLE_TOKEN_EMBD)
  blocks.push(KIND_WEIGHT)
  d0.push(g.n_embd)
  d1.push(g.n_vocab)
  dims.push(2)
  return MemberTable {
    count: MF_EMBED_MEMBER_COUNT,
    names: labels.to_string(),
    name_start: names.build(),
    name_end: ends.build(),
    role: roles.build(),
    block: blocks.build(),
    ne0: d0.build(),
    ne1: d1.build(),
    n_dims: dims.build(),
  }
}

// Two members: `output_norm` is 1-D at `n_embd` and `output` is `[n_embd, n_vocab]`. Section 2.1
// fact 1 measured this model as **untied**, and section 3.4 detects rather than assumes it.
pub fn mf_head_member_table(borrow g: Geometry) -> MemberTable {
  labels := builder()
  mut names: array_builder<i64> := array_builder()
  mut ends: array_builder<i64> := array_builder()
  mut roles: array_builder<i64> := array_builder()
  mut blocks: array_builder<i64> := array_builder()
  mut d0: array_builder<i64> := array_builder()
  mut d1: array_builder<i64> := array_builder()
  mut dims: array_builder<i64> := array_builder()
  labels.write("output_norm")
  names.push(0)
  ends.push(11)
  roles.push(ROLE_OUTPUT_NORM)
  blocks.push(KIND_WEIGHT)
  d0.push(g.n_embd)
  d1.push(1)
  dims.push(1)
  labels.write("output")
  names.push(11)
  ends.push(17)
  roles.push(ROLE_OUTPUT)
  blocks.push(KIND_WEIGHT)
  d0.push(g.n_embd)
  d1.push(g.n_vocab)
  dims.push(2)
  return MemberTable {
    count: MF_HEAD_MEMBER_COUNT,
    names: labels.to_string(),
    name_start: names.build(),
    name_end: ends.build(),
    role: roles.build(),
    block: blocks.build(),
    ne0: d0.build(),
    ne1: d1.build(),
    n_dims: dims.build(),
  }
}

// ---------------------------------------------------------------------------------------------
// The three node tables
// ---------------------------------------------------------------------------------------------

fn mf_zero_column(n: i64) -> array<i64> {
  mut b: array_builder<i64> := array_builder()
  mut at := 0
  loop {
    if at >= n { break }
    b.push(0)
    at = at + 1
  }
  return b.build()
}

// The one-node embedding graph: `GET_ROWS` over the gathered rows, addressed by position.
pub fn mf_embed_node_table() -> NodeTable {
  mut op: array_builder<i64> := array_builder()
  mut a: array_builder<i64> := array_builder()
  mut b: array_builder<i64> := array_builder()
  mut out: array_builder<i64> := array_builder()
  mut oracle: array_builder<i64> := array_builder()
  op.push(OP_GET_ROWS)
  a.push(0)
  b.push(MF_SLOT_TOKENS)
  out.push(MF_SLOT_NODE_BASE)
  oracle.push(0)
  return NodeTable {
    count: MF_EMBED_NODE_COUNT,
    op: op.build(),
    a: a.build(),
    b: b.build(),
    out: out.build(),
    p0: mf_zero_column(MF_EMBED_NODE_COUNT),
    p1: mf_zero_column(MF_EMBED_NODE_COUNT),
    p2: mf_zero_column(MF_EMBED_NODE_COUNT),
    p3: mf_zero_column(MF_EMBED_NODE_COUNT),
    oracle: oracle.build(),
    when: mf_zero_column(MF_EMBED_NODE_COUNT),
    alt_when: mf_zero_column(MF_EMBED_NODE_COUNT),
    alt_a: mf_minus_one_column(MF_EMBED_NODE_COUNT),
    alt_b: mf_minus_one_column(MF_EMBED_NODE_COUNT),
  }
}

fn mf_minus_one_column(n: i64) -> array<i64> {
  mut b: array_builder<i64> := array_builder()
  mut at := 0
  loop {
    if at >= n { break }
    b.push(-1)
    at = at + 1
  }
  return b.build()
}

// `RMS_NORM`, `MUL(output_norm)`, `MUL_MAT(output)` — the three nodes the transcript names `norm`,
// `result_norm`, and `result_output`, without a layer suffix (section 2.3).
pub fn mf_head_node_table(borrow g: Geometry) -> NodeTable {
  mut op: array_builder<i64> := array_builder()
  mut a: array_builder<i64> := array_builder()
  mut b: array_builder<i64> := array_builder()
  mut out: array_builder<i64> := array_builder()
  mut p0: array_builder<i64> := array_builder()
  mut oracle: array_builder<i64> := array_builder()
  n := MF_SLOT_NODE_BASE
  op.push(OP_RMS_NORM)
  a.push(MF_SLOT_CUR)
  b.push(-1)
  out.push(n + 0)
  p0.push(g.rms_eps_bits)
  oracle.push(-1)
  op.push(OP_MUL)
  a.push(n + 0)
  b.push(0)
  out.push(n + 1)
  p0.push(0)
  oracle.push(0)
  op.push(OP_MUL_MAT)
  a.push(1)
  b.push(n + 1)
  out.push(n + 2)
  p0.push(0)
  oracle.push(1)
  return NodeTable {
    count: MF_HEAD_NODE_COUNT,
    op: op.build(),
    a: a.build(),
    b: b.build(),
    out: out.build(),
    p0: p0.build(),
    p1: mf_zero_column(MF_HEAD_NODE_COUNT),
    p2: mf_zero_column(MF_HEAD_NODE_COUNT),
    p3: mf_zero_column(MF_HEAD_NODE_COUNT),
    oracle: oracle.build(),
    when: mf_zero_column(MF_HEAD_NODE_COUNT),
    alt_when: mf_zero_column(MF_HEAD_NODE_COUNT),
    alt_a: mf_minus_one_column(MF_HEAD_NODE_COUNT),
    alt_b: mf_minus_one_column(MF_HEAD_NODE_COUNT),
  }
}

// One row of the layer table. It is a record rather than nine `mut` locals because the builder loop
// below assigns it once per row and pushes it once, which is the shape correction C9 of
// `r5a-dense-layer-forward.md` forced on every column set in this repository.
MfRow {
  op: i64,
  a: i64,
  b: i64,
  p0: i64,
  p1: i64,
  p2: i64,
  p3: i64,
  oracle: i64,
  when: i64,
  alt_when: i64,
  alt_a: i64,
  alt_b: i64,
}

fn mf_row(op: i64, a: i64, b: i64, oracle: i64) -> MfRow = MfRow {
  op: op,
  a: a,
  b: b,
  p0: 0,
  p1: 0,
  p2: 0,
  p3: 0,
  oracle: oracle,
  when: WHEN_ALWAYS,
  alt_when: WHEN_ALWAYS,
  alt_a: -1,
  alt_b: -1,
}

// Rows 0 to 13 of the layer: the norm, the three projections and their biases, the three reshapes,
// and the two RoPEs. Every one of them is unconditional.
fn mf_layer_row_head(borrow g: Geometry, tokens: i64, row: i64) -> MfRow {
  n := MF_SLOT_NODE_BASE
  if row == 0 {
    mut r := mf_row(OP_RMS_NORM, MF_SLOT_CUR, -1, 0)
    r.p0 = g.rms_eps_bits
    return r
  }
  if row == 1 { return mf_row(OP_MUL, n + 0, 0, 1) }
  if row == 2 { return mf_row(OP_MUL_MAT, 1, n + 1, -1) }
  if row == 3 { return mf_row(OP_ADD, n + 2, 2, 2) }
  if row == 4 { return mf_row(OP_MUL_MAT, 3, n + 1, -1) }
  if row == 5 { return mf_row(OP_ADD, n + 4, 4, 3) }
  if row == 6 { return mf_row(OP_MUL_MAT, 5, n + 1, -1) }
  if row == 7 { return mf_row(OP_ADD, n + 6, 6, 4) }
  if row == 8 {
    mut r := mf_row(OP_RESHAPE_3D, n + 3, -1, -1)
    r.p0 = g.head_dim
    r.p1 = g.n_head
    r.p2 = tokens
    return r
  }
  if row == 9 {
    mut r := mf_row(OP_RESHAPE_3D, n + 5, -1, -1)
    r.p0 = g.head_dim
    r.p1 = g.n_head_kv
    r.p2 = tokens
    return r
  }
  if row == 10 {
    mut r := mf_row(OP_RESHAPE_3D, n + 7, -1, -1)
    r.p0 = g.head_dim
    r.p1 = g.n_head_kv
    r.p2 = tokens
    return r
  }
  mut r := mf_row(OP_ROPE, if row == 11 { n + 8 } else { n + 9 }, MF_SLOT_POS,
    if row == 11 { 5 } else { 6 })
  r.p0 = g.head_dim
  r.p1 = ROPE_TYPE_NEOX
  r.p2 = g.context_length
  r.p3 = g.rope_freq_base_bits
  return r
}

// Rows 14 to 24: the attention itself, including the three `WHEN_WIDE` rows that widen K and V to
// the instrument's declared reduction length (section 2.7). `ggml_pad` writes the source at the
// **start** of each padded axis and zeroes the rest, and the mask's extra columns are `-inf`, so
// the padded lanes contribute nothing but the f32 reduction length matches llama.cpp's.
fn mf_layer_row_attention(borrow g: Geometry, tokens: i64, width: i64, row: i64) -> MfRow {
  n := MF_SLOT_NODE_BASE
  if row == 13 {
    mut r := mf_row(OP_PERMUTE, n + 11, -1, -1)
    r.p1 = 2
    r.p2 = 1
    r.p3 = 3
    return r
  }
  if row == 14 {
    mut r := mf_row(OP_PERMUTE, n + 12, -1, -1)
    r.p1 = 2
    r.p2 = 1
    r.p3 = 3
    return r
  }
  if row == 15 {
    mut r := mf_row(OP_CONT_3D, n + 14, -1, -1)
    r.p0 = g.head_dim
    r.p1 = tokens
    r.p2 = g.n_head_kv
    r.when = WHEN_WIDE
    return r
  }
  if row == 16 {
    mut r := mf_row(OP_PAD, n + 15, -1, -1)
    r.p1 = width - tokens
    r.when = WHEN_WIDE
    return r
  }
  if row == 17 {
    mut r := mf_row(OP_MUL_MAT, n + 14, n + 13, 7)
    r.alt_when = WHEN_WIDE
    r.alt_a = n + 16
    return r
  }
  if row == 18 {
    mut r := mf_row(OP_SOFT_MAX, n + 17, MF_SLOT_MASK, 8)
    r.p0 = g.attn_scale_bits
    r.p1 = MAX_BIAS_BITS
    return r
  }
  if row == 19 {
    mut r := mf_row(OP_PERMUTE, n + 10, -1, -1)
    r.p0 = 1
    r.p1 = 2
    r.p2 = 0
    r.p3 = 3
    return r
  }
  if row == 20 {
    mut r := mf_row(OP_CONT_3D, n + 19, -1, -1)
    r.p0 = tokens
    r.p1 = g.head_dim
    r.p2 = g.n_head_kv
    return r
  }
  if row == 21 {
    mut r := mf_row(OP_PAD, n + 20, -1, -1)
    r.p0 = width - tokens
    r.when = WHEN_WIDE
    return r
  }
  if row == 22 {
    mut r := mf_row(OP_MUL_MAT, n + 20, n + 18, 9)
    r.alt_when = WHEN_WIDE
    r.alt_a = n + 21
    return r
  }
  if row == 23 {
    mut r := mf_row(OP_PERMUTE, n + 22, -1, -1)
    r.p1 = 2
    r.p2 = 1
    r.p3 = 3
    return r
  }
  mut r := mf_row(OP_CONT_3D, n + 23, -1, 10)
  r.p0 = g.n_embd
  r.p1 = tokens
  r.p2 = 1
  return r
}

// Rows 25 to 35: the attention output projection, the two `WHEN_LAST` narrowing rows, and the
// feed-forward block. Section 2.3: the prefill narrows **inside** the last layer, after the output
// projection, on **both** branches of the residual add — narrowing at the layer's input would be
// wrong rather than merely different, because the attention needs every position's keys.
fn mf_layer_row_tail(borrow g: Geometry, row: i64) -> MfRow {
  n := MF_SLOT_NODE_BASE
  if row == 25 { return mf_row(OP_MUL_MAT, 7, n + 24, 11) }
  if row == 26 {
    mut r := mf_row(OP_GET_ROWS, n + 25, MF_SLOT_OUT_IDS, -1)
    r.when = WHEN_LAST
    return r
  }
  if row == 27 {
    mut r := mf_row(OP_GET_ROWS, MF_SLOT_CUR, MF_SLOT_OUT_IDS, -1)
    r.when = WHEN_LAST
    return r
  }
  if row == 28 {
    mut r := mf_row(OP_ADD, n + 25, MF_SLOT_CUR, 12)
    r.alt_when = WHEN_LAST
    r.alt_a = n + 26
    r.alt_b = n + 27
    return r
  }
  if row == 29 {
    mut r := mf_row(OP_RMS_NORM, n + 28, -1, -1)
    r.p0 = g.rms_eps_bits
    return r
  }
  if row == 30 { return mf_row(OP_MUL, n + 29, 8, 13) }
  if row == 31 { return mf_row(OP_MUL_MAT, 9, n + 30, 14) }
  if row == 32 { return mf_row(OP_MUL_MAT, 10, n + 30, 15) }
  if row == 33 { return mf_row(OP_SWIGLU, n + 31, n + 32, 16) }
  if row == 34 { return mf_row(OP_MUL_MAT, 11, n + 33, 17) }
  return mf_row(OP_ADD, n + 34, n + 28, 18)
}

pub fn mf_layer_node_table(borrow g: Geometry, tokens: i64, width: i64) -> NodeTable {
  mut op: array_builder<i64> := array_builder()
  mut a: array_builder<i64> := array_builder()
  mut b: array_builder<i64> := array_builder()
  mut out: array_builder<i64> := array_builder()
  mut p0: array_builder<i64> := array_builder()
  mut p1: array_builder<i64> := array_builder()
  mut p2: array_builder<i64> := array_builder()
  mut p3: array_builder<i64> := array_builder()
  mut oracle: array_builder<i64> := array_builder()
  mut when: array_builder<i64> := array_builder()
  mut alt_when: array_builder<i64> := array_builder()
  mut alt_a: array_builder<i64> := array_builder()
  mut alt_b: array_builder<i64> := array_builder()
  mut row := 0
  loop {
    if row >= MF_LAYER_NODE_COUNT { break }
    r := if row <= 12 {
      mf_layer_row_head(g, tokens, row)
    } else {
      if row <= 24 { mf_layer_row_attention(g, tokens, width, row) } else { mf_layer_row_tail(g, row) }
    }
    op.push(r.op)
    a.push(r.a)
    b.push(r.b)
    out.push(MF_SLOT_NODE_BASE + row)
    p0.push(r.p0)
    p1.push(r.p1)
    p2.push(r.p2)
    p3.push(r.p3)
    oracle.push(r.oracle)
    when.push(r.when)
    alt_when.push(r.alt_when)
    alt_a.push(r.alt_a)
    alt_b.push(r.alt_b)
    row = row + 1
  }
  return NodeTable {
    count: MF_LAYER_NODE_COUNT,
    op: op.build(),
    a: a.build(),
    b: b.build(),
    out: out.build(),
    p0: p0.build(),
    p1: p1.build(),
    p2: p2.build(),
    p3: p3.build(),
    oracle: oracle.build(),
    when: when.build(),
    alt_when: alt_when.build(),
    alt_a: alt_a.build(),
    alt_b: alt_b.build(),
  }
}

// The last node of each graph, which is what `ggml_build_forward_expand` is called on.
pub fn mf_layer_output_slot() -> i64 = MF_SLOT_NODE_BASE + MF_LAYER_NODE_COUNT - 1

pub fn mf_embed_output_slot() -> i64 = MF_SLOT_NODE_BASE

pub fn mf_head_output_slot() -> i64 = MF_SLOT_NODE_BASE + MF_HEAD_NODE_COUNT - 1

// `true` when a row is issued for a graph with these two conditions. One loop in
// `src/model_forward.align` walks the table and skips a row whose condition does not hold.
//
// R6 keeps this signature and defines it as the `decode = false` case of the three-condition form
// below, so the prefill's issued row set is unchanged by construction.
pub fn mf_row_issued(condition: i64, last: bool, wide: bool) -> bool {
  return mf_row_issued_at(condition, last, wide, false)
}

// R6-DECODE-KV-STEP1 section 2.4. The same predicate with the decode condition, walked by
// `src/decode_step.align`. A `WHEN_DECODE` row is the K or V `CONCAT`, and the two rows that
// consume them redirect their `a` operand through `alt_when = WHEN_DECODE` — so dropping the
// condition does not merely lose two nodes, it feeds the attention the new column alone, which is
// what the `ds-mutant-no-concat` build asserts is caught.
pub fn mf_row_issued_at(condition: i64, last: bool, wide: bool, decode: bool) -> bool {
  if condition == WHEN_ALWAYS { return true }
  if condition == WHEN_LAST { return last }
  if condition == WHEN_DECODE { return decode }
  return wide
}

// ---------------------------------------------------------------------------------------------
// R6-DECODE-KV-STEP1 — the decode layer table
//
// `docs/specs/r6-decode-kv-step1.md` section 2.4. Thirty-eight rows: the prefill layer's
// thirty-six at `tokens = 1`, plus one `CONCAT` on K and one on V.
//
// The two concats are the whole capability. A prefill layer widens K and V from `T` columns to
// `KV_WIDTH` with zeros; a decode layer joins the plane's `n_past` real columns to the step's one
// new column and pads the remainder, so the new column lands at index `n_past` — exactly where the
// offset mask of section 2.6 unmasks it. Appending without the past, or padding without the concat,
// puts the new column at index 0 or at index `KV_WIDTH - 1` and answers a different question.
//
// K and V concatenate on **different** axes and the table says so per row. After row 15's `CONT_3D`
// K is `{head_dim, columns, n_head_kv}`, so its column axis is **1**; after row 21's `CONT_3D` V is
// `{columns, head_dim, n_head_kv}`, so its column axis is **0**. A single shared constant here would
// be a silent transpose that every downstream shape check accepts.
// ---------------------------------------------------------------------------------------------

pub MF_DECODE_LAYER_NODE_COUNT := 38

// Rows 0 to 14: the norm, the three projections and their biases, the three reshapes at `ne2 = 1`,
// the two RoPEs, and the two permutes. Every one is the prefill's row with `tokens = 1`; only
// `MF_SLOT_POS`'s **contents** differ, and they are `[n_past]` rather than `[0 .. T-1]`.
fn mf_decode_row_head(borrow g: Geometry, row: i64) -> MfRow {
  n := MF_SLOT_NODE_BASE
  if row <= 12 { return mf_layer_row_head(g, 1, row) }
  mut r := mf_row(OP_PERMUTE, if row == 13 { n + 11 } else { n + 12 }, -1, -1)
  r.p1 = 2
  r.p2 = 1
  r.p3 = 3
  return r
}

// Rows 15 to 23: the K path, the attention weights, and the V path — the nine rows the concats live
// in. `width - (n_past + 1)` is the pad each concatenated operand needs to reach `KV_WIDTH`; it is
// the decode value on purpose, so a walk that skipped the concats would pad the wrong operand to the
// wrong extent and be refused as `R5_SHAPE` rather than compute a plausible number.
fn mf_decode_row_attention(borrow g: Geometry, n_past: i64, width: i64, row: i64) -> MfRow {
  n := MF_SLOT_NODE_BASE
  if row == 15 {
    mut r := mf_row(OP_CONT_3D, n + 14, -1, -1)
    r.p0 = g.head_dim
    r.p1 = 1
    r.p2 = g.n_head_kv
    return r
  }
  if row == 16 {
    mut r := mf_row(OP_CONCAT, MF_SLOT_KPAST, n + 15, -1)
    r.p0 = 1
    r.when = WHEN_DECODE
    return r
  }
  if row == 17 {
    mut r := mf_row(OP_PAD, n + 15, -1, -1)
    r.p1 = width - (n_past + 1)
    r.alt_when = WHEN_DECODE
    r.alt_a = n + 16
    return r
  }
  if row == 18 { return mf_row(OP_MUL_MAT, n + 17, n + 13, 7) }
  if row == 19 {
    mut r := mf_row(OP_SOFT_MAX, n + 18, MF_SLOT_MASK, 8)
    r.p0 = g.attn_scale_bits
    r.p1 = MAX_BIAS_BITS
    return r
  }
  if row == 20 {
    mut r := mf_row(OP_PERMUTE, n + 10, -1, -1)
    r.p0 = 1
    r.p1 = 2
    r.p2 = 0
    r.p3 = 3
    return r
  }
  if row == 21 {
    mut r := mf_row(OP_CONT_3D, n + 20, -1, -1)
    r.p0 = 1
    r.p1 = g.head_dim
    r.p2 = g.n_head_kv
    return r
  }
  if row == 22 {
    mut r := mf_row(OP_CONCAT, MF_SLOT_VPAST, n + 21, -1)
    r.p0 = 0
    r.when = WHEN_DECODE
    return r
  }
  mut r := mf_row(OP_PAD, n + 21, -1, -1)
  r.p0 = width - (n_past + 1)
  r.alt_when = WHEN_DECODE
  r.alt_a = n + 22
  return r
}

// Rows 24 to 37: the attention reduction, the output projection, the two identity narrowing rows,
// and the feed-forward block. Section 2.4: the `WHEN_LAST` rows are **kept** at `t = 1`, where
// `get_rows(x, [0])` is the identity. They cost two redundant nodes and keep one shape rule for both
// passes; they have no counterpart in llama.cpp's decode graph, so section 3.3 excludes them from
// oracle A by name and counts them rather than dropping them quietly.
fn mf_decode_row_tail(borrow g: Geometry, row: i64) -> MfRow {
  n := MF_SLOT_NODE_BASE
  if row == 24 { return mf_row(OP_MUL_MAT, n + 23, n + 19, 9) }
  if row == 25 {
    mut r := mf_row(OP_PERMUTE, n + 24, -1, -1)
    r.p1 = 2
    r.p2 = 1
    r.p3 = 3
    return r
  }
  if row == 26 {
    mut r := mf_row(OP_CONT_3D, n + 25, -1, 10)
    r.p0 = g.n_embd
    r.p1 = 1
    r.p2 = 1
    return r
  }
  if row == 27 { return mf_row(OP_MUL_MAT, 7, n + 26, 11) }
  if row == 28 {
    mut r := mf_row(OP_GET_ROWS, n + 27, MF_SLOT_OUT_IDS, -1)
    r.when = WHEN_LAST
    return r
  }
  if row == 29 {
    mut r := mf_row(OP_GET_ROWS, MF_SLOT_CUR, MF_SLOT_OUT_IDS, -1)
    r.when = WHEN_LAST
    return r
  }
  if row == 30 {
    mut r := mf_row(OP_ADD, n + 27, MF_SLOT_CUR, 12)
    r.alt_when = WHEN_LAST
    r.alt_a = n + 28
    r.alt_b = n + 29
    return r
  }
  if row == 31 {
    mut r := mf_row(OP_RMS_NORM, n + 30, -1, -1)
    r.p0 = g.rms_eps_bits
    return r
  }
  if row == 32 { return mf_row(OP_MUL, n + 31, 8, 13) }
  if row == 33 { return mf_row(OP_MUL_MAT, 9, n + 32, 14) }
  if row == 34 { return mf_row(OP_MUL_MAT, 10, n + 32, 15) }
  if row == 35 { return mf_row(OP_SWIGLU, n + 33, n + 34, 16) }
  if row == 36 { return mf_row(OP_MUL_MAT, 11, n + 35, 17) }
  return mf_row(OP_ADD, n + 36, n + 30, 18)
}

pub fn mf_decode_layer_node_table(borrow g: Geometry, n_past: i64, width: i64) -> NodeTable {
  mut op: array_builder<i64> := array_builder()
  mut a: array_builder<i64> := array_builder()
  mut b: array_builder<i64> := array_builder()
  mut out: array_builder<i64> := array_builder()
  mut p0: array_builder<i64> := array_builder()
  mut p1: array_builder<i64> := array_builder()
  mut p2: array_builder<i64> := array_builder()
  mut p3: array_builder<i64> := array_builder()
  mut oracle: array_builder<i64> := array_builder()
  mut when: array_builder<i64> := array_builder()
  mut alt_when: array_builder<i64> := array_builder()
  mut alt_a: array_builder<i64> := array_builder()
  mut alt_b: array_builder<i64> := array_builder()
  mut row := 0
  loop {
    if row >= MF_DECODE_LAYER_NODE_COUNT { break }
    r := if row <= 14 {
      mf_decode_row_head(g, row)
    } else {
      if row <= 23 { mf_decode_row_attention(g, n_past, width, row) } else { mf_decode_row_tail(g, row) }
    }
    op.push(r.op)
    a.push(r.a)
    b.push(r.b)
    out.push(MF_SLOT_NODE_BASE + row)
    p0.push(r.p0)
    p1.push(r.p1)
    p2.push(r.p2)
    p3.push(r.p3)
    oracle.push(r.oracle)
    when.push(r.when)
    alt_when.push(r.alt_when)
    alt_a.push(r.alt_a)
    alt_b.push(r.alt_b)
    row = row + 1
  }
  return NodeTable {
    count: MF_DECODE_LAYER_NODE_COUNT,
    op: op.build(),
    a: a.build(),
    b: b.build(),
    out: out.build(),
    p0: p0.build(),
    p1: p1.build(),
    p2: p2.build(),
    p3: p3.build(),
    oracle: oracle.build(),
    when: when.build(),
    alt_when: alt_when.build(),
    alt_a: alt_a.build(),
    alt_b: alt_b.build(),
  }
}

pub fn mf_decode_layer_output_slot() -> i64 =
MF_SLOT_NODE_BASE + MF_DECODE_LAYER_NODE_COUNT - 1

// ---------------------------------------------------------------------------------------------
// The oracle table for the whole prefill
//
// One flat table of `1 + 19 * n_layer + 2` rows: the embedding graph's `embd`, nineteen rows per
// layer, and the head's `result_norm` and `result_output`. Row addressing is arithmetic —
// `mf_oracle_layer_base(L)` — so no column has to carry the graph a row belongs to.
// ---------------------------------------------------------------------------------------------

pub fn mf_oracle_layer_base(layer: i64) -> i64 = 1 + MF_LAYER_ORACLE_COUNT * layer

pub fn mf_oracle_head_base(n_layer: i64) -> i64 = 1 + MF_LAYER_ORACLE_COUNT * n_layer

fn mf_oracle_id_of(row: i64) -> str {
  if row == 0 { return "norm" }
  if row == 1 { return "attn_norm" }
  if row == 2 { return "q_bias" }
  if row == 3 { return "k_bias" }
  if row == 4 { return "v_bias" }
  if row == 5 { return "q_rope" }
  if row == 6 { return "k_rope" }
  if row == 7 { return "kq" }
  if row == 8 { return "kq_soft_max" }
  if row == 9 { return "kqv" }
  if row == 10 { return "kqv_out" }
  if row == 11 { return "attn_out" }
  if row == 12 { return "ffn_inp" }
  if row == 13 { return "ffn_norm" }
  if row == 14 { return "ffn_gate" }
  if row == 15 { return "ffn_up" }
  if row == 16 { return "ffn_swiglu" }
  if row == 17 { return "ffn_out" }
  return "l_out"
}

fn mf_oracle_stem_of(row: i64) -> str {
  if row == 0 { return "norm" }
  if row == 1 { return "attn_norm" }
  if row == 2 { return "Qcur" }
  if row == 3 { return "Kcur" }
  if row == 4 { return "Vcur" }
  if row == 5 { return "Qcur" }
  if row == 6 { return "Kcur" }
  if row == 7 { return "kq" }
  if row == 8 { return "kq_soft_max" }
  if row == 9 { return "kqv" }
  if row == 10 { return "kqv_out" }
  if row == 12 { return "ffn_inp" }
  if row == 13 { return "ffn_norm" }
  if row == 14 { return "ffn_gate" }
  if row == 15 { return "ffn_up" }
  if row == 16 { return "ffn_swiglu" }
  if row == 17 { return "ffn_out" }
  return "l_out"
}

fn mf_oracle_op_of(row: i64) -> str {
  if row == 0 { return "RMS_NORM" }
  if row == 1 { return "MUL" }
  if row == 2 { return "ADD" }
  if row == 3 { return "ADD" }
  if row == 4 { return "ADD" }
  if row == 5 { return "ROPE" }
  if row == 6 { return "ROPE" }
  if row == 7 { return "MUL_MAT" }
  if row == 8 { return "SOFT_MAX" }
  if row == 9 { return "MUL_MAT" }
  if row == 10 { return "CONT" }
  if row == 11 { return "MUL_MAT" }
  if row == 12 { return "ADD" }
  if row == 13 { return "MUL" }
  if row == 14 { return "MUL_MAT" }
  if row == 15 { return "MUL_MAT" }
  if row == 16 { return "SWIGLU" }
  if row == 17 { return "MUL_MAT" }
  return "ADD"
}

// The node row each oracle row observes, in `mf_layer_node_table`'s own indexing.
fn mf_oracle_node_of(row: i64) -> i64 {
  if row == 0 { return 0 }
  if row == 1 { return 1 }
  if row == 2 { return 3 }
  if row == 3 { return 5 }
  if row == 4 { return 7 }
  if row == 5 { return 11 }
  if row == 6 { return 12 }
  if row == 7 { return 17 }
  if row == 8 { return 18 }
  if row == 9 { return 22 }
  if row == 10 { return 24 }
  if row == 11 { return 25 }
  if row == 12 { return 28 }
  if row == 13 { return 30 }
  if row == 14 { return 31 }
  if row == 15 { return 32 }
  if row == 16 { return 33 }
  if row == 17 { return 34 }
  return 35
}

// One index space for the whole prefill: `0` is the embedding row, `1 + 19 * L + r` is layer `L`'s
// row `r`, and the last two rows are the head's. Six accessors answer one column each, so the
// builder below is one loop with no per-graph branch inside it.
fn mf_oracle_head_row(n_layer: i64, at: i64) -> i64 = at - mf_oracle_head_base(n_layer)

fn mf_oracle_layer_of(n_layer: i64, at: i64) -> i64 {
  if at <= 0 { return -1 }
  if at >= mf_oracle_head_base(n_layer) { return -1 }
  return (at - 1) / MF_LAYER_ORACLE_COUNT
}

fn mf_oracle_row_of(n_layer: i64, at: i64) -> i64 {
  if at <= 0 { return -1 }
  if at >= mf_oracle_head_base(n_layer) { return -1 }
  return (at - 1) % MF_LAYER_ORACLE_COUNT
}

fn mf_oracle_id_at(n_layer: i64, at: i64) -> str {
  if at == 0 { return "embd" }
  head := mf_oracle_head_row(n_layer, at)
  if head == 0 { return "result_norm" }
  if head == 1 { return "result_output" }
  return mf_oracle_id_of(mf_oracle_row_of(n_layer, at))
}

fn mf_oracle_op_at(n_layer: i64, at: i64) -> str {
  if at == 0 { return "GET_ROWS" }
  head := mf_oracle_head_row(n_layer, at)
  if head == 0 { return "MUL" }
  if head == 1 { return "MUL_MAT" }
  return mf_oracle_op_of(mf_oracle_row_of(n_layer, at))
}

// R6-DECODE-KV-STEP1 section 2.4. The same nineteen observable nodes in the **decode** layer
// table's own row numbering. The first seven rows are unmoved because the two concats are inserted
// after them; everything from `kq` onward shifts by one and then by two.
fn mf_decode_oracle_node_of(row: i64) -> i64 {
  if row == 0 { return 0 }
  if row == 1 { return 1 }
  if row == 2 { return 3 }
  if row == 3 { return 5 }
  if row == 4 { return 7 }
  if row == 5 { return 11 }
  if row == 6 { return 12 }
  if row == 7 { return 18 }
  if row == 8 { return 19 }
  if row == 9 { return 24 }
  if row == 10 { return 26 }
  if row == 11 { return 27 }
  if row == 12 { return 30 }
  if row == 13 { return 32 }
  if row == 14 { return 33 }
  if row == 15 { return 34 }
  if row == 16 { return 35 }
  if row == 17 { return 36 }
  return 37
}

// The node row inside the graph this oracle row belongs to: the embedding graph's only node, the
// layer table's row, or the head table's `result_norm` / `result_output`.
fn mf_oracle_node_at(n_layer: i64, at: i64, decode: bool) -> i64 {
  if at == 0 { return 0 }
  head := mf_oracle_head_row(n_layer, at)
  if head == 0 { return 1 }
  if head == 1 { return 2 }
  row := mf_oracle_row_of(n_layer, at)
  if decode { return mf_decode_oracle_node_of(row) }
  return mf_oracle_node_of(row)
}

// `kq-L` and `kq_soft_max-L` are matched and shape-checked and never element-compared: llama.cpp
// reduces them over its padded KV width and section 3.7 makes that an operand rather than a
// tolerance.
fn mf_oracle_compared_at(n_layer: i64, at: i64) -> i64 {
  row := mf_oracle_row_of(n_layer, at)
  if row == 7 || row == 8 { return 0 }
  return 1
}

// Section 2.3: the attention output projection prints as a positional `node_NNNN` that moves with
// the layer and with the flags, so it is matched by its **source weight name** in every layer.
fn mf_oracle_weight_at(n_layer: i64, at: i64) -> i64 {
  if mf_oracle_row_of(n_layer, at) == 11 { return 1 }
  return 0
}

fn mf_oracle_name_at(n_layer: i64, at: i64) -> string {
  if at == 0 { return "embd".clone() }
  head := mf_oracle_head_row(n_layer, at)
  if head == 0 { return "result_norm".clone() }
  if head == 1 { return "result_output".clone() }
  layer := mf_oracle_layer_of(n_layer, at)
  row := mf_oracle_row_of(n_layer, at)
  b := builder()
  if row == 11 {
    b.write("blk.")
    b.write_int(layer)
    b.write(".attn_output.weight")
    return b.to_string()
  }
  b.write(mf_oracle_stem_of(row))
  b.write("-")
  b.write_int(layer)
  return b.to_string()
}

pub fn mf_oracle_table(n_layer: i64) -> OracleTable {
  return mf_oracle_table_for(n_layer, false)
}

// R6 section 3.3's coverage set. The **same** rows, the same names, the same ops, and the same two
// declared exclusions — only the node row each one observes moves, because a decode layer table has
// two more rows than a prefill one. Sharing the builder is what makes "oracle A compares the decode
// graph against llama.cpp's decode graph node for node" a restatement of R5B's rule rather than a
// second one.
pub fn mf_decode_oracle_table(n_layer: i64) -> OracleTable {
  return mf_oracle_table_for(n_layer, true)
}

fn mf_oracle_table_for(n_layer: i64, decode: bool) -> OracleTable {
  body := builder()
  mut ids: array_builder<i64> := array_builder()
  mut id_ends: array_builder<i64> := array_builder()
  mut names: array_builder<i64> := array_builder()
  mut name_ends: array_builder<i64> := array_builder()
  mut ops: array_builder<i64> := array_builder()
  mut op_ends: array_builder<i64> := array_builder()
  mut nodes: array_builder<i64> := array_builder()
  mut compared: array_builder<i64> := array_builder()
  mut weighted: array_builder<i64> := array_builder()
  count := mf_oracle_head_base(n_layer) + MF_HEAD_ORACLE_COUNT
  mut cursor := 0
  mut at := 0
  loop {
    if at >= count { break }
    id := mf_oracle_id_at(n_layer, at)
    operation := mf_oracle_op_at(n_layer, at)
    name := mf_oracle_name_at(n_layer, at)
    name_view: str := name
    body.write(id)
    ids.push(cursor)
    cursor = cursor + id.len()
    id_ends.push(cursor)
    names.push(cursor)
    body.write(name_view)
    cursor = cursor + name_view.len()
    name_ends.push(cursor)
    ops.push(cursor)
    body.write(operation)
    cursor = cursor + operation.len()
    op_ends.push(cursor)
    nodes.push(mf_oracle_node_at(n_layer, at, decode))
    compared.push(mf_oracle_compared_at(n_layer, at))
    weighted.push(mf_oracle_weight_at(n_layer, at))
    at = at + 1
  }
  return OracleTable {
    count: count,
    text: body.to_string(),
    id_start: ids.build(),
    id_end: id_ends.build(),
    name_start: names.build(),
    name_end: name_ends.build(),
    op_start: ops.build(),
    op_end: op_ends.build(),
    node: nodes.build(),
    compared: compared.build(),
    by_weight: weighted.build(),
  }
}

// ---------------------------------------------------------------------------------------------
// The causal mask at a declared width
// ---------------------------------------------------------------------------------------------

// A `{width, height}` f32 image. Columns at or beyond `height` are `-inf` for every row, which is
// what makes the reconciliation pass's padded lanes contribute nothing: `ggml_pad` zeroes them and
// the mask masks them, and only the f32 reduction *length* changes (section 2.7).
pub fn mf_write_mask(borrow mut window: buffer, width: i64, height: i64) {
  mf_write_mask_offset(window, width, height, 0)
}

// R6-DECODE-KV-STEP1 section 2.6. The same image with the row index **shifted**: row `r` masks
// `col <= r + row_offset`.
//
// `mf_write_mask` above is correct only when row `r` means position `r`, which is true of every
// prefill graph and false of every decode graph: a decode row is position `n_past` while its `row`
// is 0. Writing the prefill's rule at a decode step would mask every past column and produce a
// confidently wrong answer that every shape check passes, which is why this is a separate writer
// rather than a wider bound.
//
// `mf_write_mask` is defined as the `row_offset = 0` case, so the prefill's bytes are unchanged by
// construction rather than by inspection. A negative offset is refused: it is not a narrower mask,
// it is a row that attends to nothing, and no caller has one.
pub fn mf_write_mask_offset(
  borrow mut window: buffer, width: i64, height: i64, row_offset: i64) {
  if row_offset < 0 { return }
  mut row := 0
  loop {
    if row >= height { break }
    mut col := 0
    loop {
      if col >= width { break }
      bits := if col <= row + row_offset { MASK_ZERO_BITS } else { MASK_NEG_INFINITY_BITS }
      window.put_u32_le(bits as u32)
      col = col + 1
    }
    row = row + 1
  }
}
