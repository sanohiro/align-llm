fn request_golden() -> Result<(), Error> {
  expected := "{\"schema_version\":1,\"artifact_kind\":\"PROMPT_EVALUATE_REQUEST\",\"evaluation_id\":\"evaluation\",\"project_root\":\"/project\",\"experiment_path\":\"experiment.json\",\"parent_activation_path\":\"parent.json\",\"corpus_path\":\"corpus.json\",\"sample_count\":2,\"acceptance_policy_path\":\"acceptance.json\",\"workspace_path\":\"/project/workspace\",\"workspace_preflight_path\":\"preflight.json\",\"verifier_align_llm_repository_path\":\"/align-llm\",\"verifier_align_llm_commit\":\"llm\",\"verifier_align_repository_path\":\"/align\",\"verifier_align_revision\":\"align\",\"verifier_corpus_source_path\":\"/corpus\",\"verifier_corpus_source_kind\":\"GIT_COMMIT\",\"verifier_corpus_source_repository_id\":\"repo\",\"verifier_corpus_source_sha256\":\"corpus\",\"verifier_source_policy_path\":\"source-policy.json\",\"verifier_source_policy_sha256\":\"policy\",\"verifier_python_executable_path\":\"/usr/bin/python3.12\",\"verifier_git_executable_path\":\"/usr/bin/git\",\"evaluation_evidence_path\":\"evidence.json\",\"generation_child_path\":\"/project/main\",\"generation_child_sha256\":\"child\"}"
  decoded := prompt_artifacts.decode_prompt_evaluate_request(expected)?
  if decoded.evaluation_id != "evaluation" || decoded.verifier_python_executable_path != "/usr/bin/python3.12" ||
  decoded.verifier_git_executable_path != "/usr/bin/git" ||
  match decoded.verifier_corpus_file_set_manifest_path { Some(_) => true, None => false } {
    return Err(Error.Invalid)
  }
  encoded_decoded := prompt_artifacts.decode_prompt_evaluate_request(expected)?
  if prompt_artifacts.encode_prompt_evaluate_request(encoded_decoded) != expected { return Err(Error.Invalid) }
  legacy := "{\"schema_version\":1,\"artifact_kind\":\"PROMPT_EVALUATE_REQUEST\",\"evaluation_id\":\"evaluation\"}"
  expect_request_invalid(legacy)?
  duplicate: string := duplicate_first_field(expected)
  duplicate_view: str := duplicate
  expect_request_invalid(duplicate_view)?
  normal_prefix := "{\"schema_version\":1,\"artifact_kind\":\"PROMPT_EVALUATE_REQUEST\","
  reordered: string := reorder_first_fields(expected, normal_prefix, "PROMPT_EVALUATE_REQUEST")
  reordered_view: str := reordered
  expect_request_invalid(reordered_view)?

  explicit_null: string := insert_null_field(
    expected,
    "\"verifier_corpus_source_repository_id\":",
    "verifier_corpus_file_set_manifest_path",
  )?
  explicit_null_view: str := explicit_null
  null_decoded := prompt_artifacts.decode_prompt_evaluate_request(explicit_null_view)?
  if match null_decoded.verifier_corpus_file_set_manifest_path { Some(_) => true, None => false } {
    return Err(Error.Invalid)
  }

  some_expected := "{\"schema_version\":1,\"artifact_kind\":\"PROMPT_EVALUATE_REQUEST\",\"evaluation_id\":\"evaluation\",\"project_root\":\"/project\",\"experiment_path\":\"experiment.json\",\"parent_activation_path\":\"parent.json\",\"corpus_path\":\"corpus.json\",\"sample_count\":2,\"acceptance_policy_path\":\"acceptance.json\",\"workspace_path\":\"/project/workspace\",\"workspace_preflight_path\":\"preflight.json\",\"verifier_align_llm_repository_path\":\"/align-llm\",\"verifier_align_llm_commit\":\"llm\",\"verifier_align_repository_path\":\"/align\",\"verifier_align_revision\":\"align\",\"verifier_corpus_source_path\":\"/corpus\",\"verifier_corpus_source_kind\":\"GIT_COMMIT\",\"verifier_corpus_file_set_manifest_path\":\"/manifest\",\"verifier_corpus_source_repository_id\":\"repo\",\"verifier_corpus_source_sha256\":\"corpus\",\"verifier_source_policy_path\":\"source-policy.json\",\"verifier_source_policy_sha256\":\"policy\",\"verifier_python_executable_path\":\"/usr/bin/python3.12\",\"verifier_git_executable_path\":\"/usr/bin/git\",\"evaluation_evidence_path\":\"evidence.json\",\"generation_child_path\":\"/project/main\",\"generation_child_sha256\":\"child\"}"
  if prompt_artifacts.encode_prompt_evaluate_request(request_value(Some("/manifest".clone()))) != some_expected {
    return Err(Error.Invalid)
  }
  some_decoded := prompt_artifacts.decode_prompt_evaluate_request(some_expected)?
  return match some_decoded.verifier_corpus_file_set_manifest_path {
    Some(value) => if value == "/manifest" { Ok(()) } else { Err(Error.Invalid) },
    None => Err(Error.Invalid),
  }
}

