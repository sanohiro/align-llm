module prompt_runtime_schema_smoke

import prompt_artifacts

fn duplicate_first_field(expected: str) -> string {
  output := builder()
  output.write("{\"schema_version\":1,")
  output.write(expected[1..expected.len()])
  return output.to_string()
}

fn reorder_first_fields(expected: str, normal_prefix: str, artifact_kind: str) -> string {
  output := builder()
  output.write("{\"artifact_kind\":\"")
  output.write(artifact_kind)
  output.write("\",\"schema_version\":1,")
  output.write(expected[normal_prefix.len()..expected.len()])
  return output.to_string()
}

fn insert_null_field(expected: str, anchor: str, field: str) -> Result<string, Error> {
  offset := expected.find(anchor) else { return Err(Error.Invalid) }
  output := builder()
  output.write(expected[0..offset])
  output.write("\"")
  output.write(field)
  output.write("\":null,")
  output.write(expected[offset..expected.len()])
  return Ok(output.to_string())
}

fn expect_policy_invalid(value: str) -> Result<(), Error> {
  return match prompt_artifacts.decode_prompt_source_verifier_policy(value) {
    Ok(_) => Err(Error.Invalid),
    Err(_) => Ok(()),
  }
}

fn expect_request_invalid(value: str) -> Result<(), Error> {
  return match prompt_artifacts.decode_prompt_evaluate_request(value) {
    Ok(_) => Err(Error.Invalid),
    Err(_) => Ok(()),
  }
}

fn expect_locator_invalid(value: str) -> Result<(), Error> {
  return match prompt_artifacts.decode_prompt_gate_source_locator(value) {
    Ok(_) => Err(Error.Invalid),
    Err(_) => Ok(()),
  }
}

fn expect_experiment_request_invalid(value: str) -> Result<(), Error> {
  return match prompt_artifacts.decode_prompt_experiment_request(value) {
    Ok(_) => Err(Error.Invalid),
    Err(_) => Ok(()),
  }
}

fn expect_experiment_request_bounded_rejected(
  value: prompt_artifacts.PromptExperimentRequest,
  max_bytes: i64,
) -> Result<(), Error> {
  return match prompt_artifacts.encode_prompt_experiment_request_bounded(value, max_bytes) {
    Ok(_) => Err(Error.Invalid),
    Err(_) => Ok(()),
  }
}

fn repeat_ascii(count: i64) -> string {
  output := builder()
  mut index := 0
  loop {
    if index >= count { break }
    output.write("a")
    index = index + 1
  }
  return output.to_string()
}

fn repeat_ascii_b(count: i64) -> string {
  output := builder()
  mut index := 0
  loop {
    if index >= count { break }
    output.write("b")
    index = index + 1
  }
  return output.to_string()
}

fn oversized_endpoint() -> string {
  output := builder()
  output.write("https://")
  filler: string := repeat_ascii(4089)
  filler_view: str := filler
  output.write(filler_view)
  return output.to_string()
}

fn policy_value(helper: str, runtime: str, interpreter: str, git: str) -> prompt_artifacts.PromptSourceVerifierPolicy {
  return prompt_artifacts.PromptSourceVerifierPolicy {
    schema_version: 1,
    artifact_kind: "PROMPT_SOURCE_VERIFIER_POLICY".clone(),
    policy_id: "policy".clone(),
    helper_path: "helper.py".clone(),
    helper_sha256: helper.clone(),
    helper_runtime: runtime.clone(),
    interpreter_sha256: interpreter.clone(),
    git_executable_sha256: git.clone(),
    content_sha256: "".clone(),
  }
}

fn policy_golden() -> Result<(), Error> {
  expected := "{\"schema_version\":1,\"artifact_kind\":\"PROMPT_SOURCE_VERIFIER_POLICY\",\"policy_id\":\"policy\",\"helper_path\":\"helper.py\",\"helper_sha256\":\"helper\",\"helper_runtime\":\"CPYTHON:python:helper\",\"interpreter_sha256\":\"python\",\"git_executable_sha256\":\"git\",\"content_sha256\":\"policy-digest\"}"
  decoded := prompt_artifacts.decode_prompt_source_verifier_policy(expected)?
  if decoded.schema_version != 1 || decoded.artifact_kind != "PROMPT_SOURCE_VERIFIER_POLICY" ||
  decoded.policy_id != "policy" || decoded.helper_path != "helper.py" ||
  decoded.helper_sha256 != "helper" || decoded.helper_runtime != "CPYTHON:python:helper" ||
  decoded.interpreter_sha256 != "python" || decoded.git_executable_sha256 != "git" ||
  decoded.content_sha256 != "policy-digest" ||
  prompt_artifacts.encode_prompt_source_verifier_policy(decoded) != expected {
    return Err(Error.Invalid)
  }
  legacy := "{\"schema_version\":1,\"artifact_kind\":\"PROMPT_SOURCE_VERIFIER_POLICY\",\"policy_id\":\"policy\",\"helper_path\":\"helper.py\",\"helper_sha256\":\"helper\",\"helper_runtime\":\"PYTHON:helper\",\"git_executable_sha256\":\"git\",\"content_sha256\":\"policy-digest\"}"
  expect_policy_invalid(legacy)?
  duplicate: string := duplicate_first_field(expected)
  duplicate_view: str := duplicate
  expect_policy_invalid(duplicate_view)?
  normal_prefix := "{\"schema_version\":1,\"artifact_kind\":\"PROMPT_SOURCE_VERIFIER_POLICY\","
  reordered: string := reorder_first_fields(expected, normal_prefix, "PROMPT_SOURCE_VERIFIER_POLICY")
  reordered_view: str := reordered
  expect_policy_invalid(reordered_view)?

  base := prompt_artifacts.encode_prompt_source_verifier_policy(
    policy_value("helper", "CPYTHON:python:helper", "python", "git"),
  )
  if base == prompt_artifacts.encode_prompt_source_verifier_policy(
    policy_value("helper-2", "CPYTHON:python:helper", "python", "git"),
  ) || base == prompt_artifacts.encode_prompt_source_verifier_policy(
    policy_value("helper", "CPYTHON:python-2:helper", "python", "git"),
  ) || base == prompt_artifacts.encode_prompt_source_verifier_policy(
    policy_value("helper", "CPYTHON:python:helper", "python-2", "git"),
  ) || base == prompt_artifacts.encode_prompt_source_verifier_policy(
    policy_value("helper", "CPYTHON:python:helper", "python", "git-2"),
  ) {
    return Err(Error.Invalid)
  }
  return Ok(())
}

