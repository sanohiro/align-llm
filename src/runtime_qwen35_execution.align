module runtime_qwen35_execution

import std.env
import runtime_attention

pub Config {
  synchronous_weights: bool,
  prefill_chunk: i64,
  final_prefill_logits: bool,
  last_ffn_row: bool,
  mapped_weights: bool,
  shared_logits: bool,
  neon_greedy: bool,
  graph_greedy: bool,
  native_state_copy: bool,
  native_q6_head: bool,
  native_conv_copy: bool,
  native_prefill_state_copy: bool,
  native_copy_greedy: bool,
}

pub fn read() -> Result<Config, Error> {
  mut synchronous := false
  mut chunk := 128
  mut final_logits := true
  mut last_ffn_row := false
  mut mapped_weights := false
  mut shared_logits := false
  mut neon_greedy := false
  mut graph_greedy := false
  mut native_state_copy := false
  mut native_q6_head := false
  mut native_conv_copy := false
  mut native_prefill_state_copy := false
  mut native_copy_greedy := false
  match env.get("ALIGN_LLM_SYNC_WEIGHT_UPLOAD") {
    Some(value) => {
      if value == "1" { synchronous = true
      } else if value != "0" { return Err(Error.Invalid) }
    },
    None => {},
  }
  match env.get("ALIGN_LLM_PREFILL_CHUNK") {
    Some(value) => {
      if value == "512" { chunk = runtime_attention.MAX_PREFILL
      } else if value == "256" { chunk = 256
      } else if value != "128" { return Err(Error.Invalid) }
    },
    None => {},
  }
  match env.get("ALIGN_LLM_PREFILL_FINAL_LOGITS") {
    Some(value) => {
      if value == "0" { final_logits = false
      } else if value != "1" { return Err(Error.Invalid) }
    },
    None => {},
  }
  match env.get("ALIGN_LLM_PREFILL_LAST_FFN_ROW") {
    Some(value) => {
      if value == "1" { last_ffn_row = true
      } else if value != "0" { return Err(Error.Invalid) }
    },
    None => {},
  }
  match env.get("ALIGN_LLM_MAPPED_WEIGHTS") {
    Some(value) => {
      if value == "1" { mapped_weights = true
      } else if value != "0" { return Err(Error.Invalid) }
    },
    None => {},
  }
  match env.get("ALIGN_LLM_SHARED_LOGITS") {
    Some(value) => {
      if value == "1" { shared_logits = true
      } else if value != "0" { return Err(Error.Invalid) }
    },
    None => {},
  }
  match env.get("ALIGN_LLM_NEON_GREEDY") {
    Some(value) => {
      if value == "1" { neon_greedy = true
      } else if value != "0" { return Err(Error.Invalid) }
    },
    None => {},
  }
  match env.get("ALIGN_LLM_GRAPH_GREEDY") {
    Some(value) => {
      if value == "1" { graph_greedy = true
      } else if value != "0" { return Err(Error.Invalid) }
    },
    None => {},
  }
  match env.get("ALIGN_LLM_NATIVE_STATE_COPY") {
    Some(value) => {
      if value == "1" { native_state_copy = true
      } else if value != "0" { return Err(Error.Invalid) }
    },
    None => {},
  }
  match env.get("ALIGN_LLM_NATIVE_Q6_HEAD") {
    Some(value) => {
      if value == "1" { native_q6_head = true
      } else if value != "0" { return Err(Error.Invalid) }
    },
    None => {},
  }
  match env.get("ALIGN_LLM_NATIVE_CONV_COPY") {
    Some(value) => {
      if value == "1" { native_conv_copy = true
      } else if value != "0" { return Err(Error.Invalid) }
    },
    None => {},
  }
  if native_conv_copy && !native_state_copy { return Err(Error.Invalid) }
  match env.get("ALIGN_LLM_NATIVE_PREFILL_STATE_COPY") {
    Some(value) => {
      if value == "1" { native_prefill_state_copy = true
      } else if value != "0" { return Err(Error.Invalid) }
    },
    None => {},
  }
  if native_prefill_state_copy && (!native_state_copy || !native_conv_copy) {
    return Err(Error.Invalid)
  }
  match env.get("ALIGN_LLM_NATIVE_COPY_GREEDY") {
    Some(value) => {
      if value == "1" { native_copy_greedy = true
      } else if value != "0" { return Err(Error.Invalid) }
    },
    None => {},
  }
  if native_copy_greedy && (!native_state_copy || !native_conv_copy
      || shared_logits || neon_greedy || graph_greedy) { return Err(Error.Invalid) }
  if (shared_logits && neon_greedy) || (shared_logits && graph_greedy)
    || (neon_greedy && graph_greedy) { return Err(Error.Invalid) }
  return Ok(Config { synchronous_weights: synchronous, prefill_chunk: chunk,
      final_prefill_logits: final_logits, last_ffn_row: last_ffn_row,
      mapped_weights: mapped_weights, shared_logits: shared_logits,
      neon_greedy: neon_greedy, graph_greedy: graph_greedy,
      native_state_copy: native_state_copy, native_conv_copy: native_conv_copy,
      native_q6_head: native_q6_head,
      native_prefill_state_copy: native_prefill_state_copy,
      native_copy_greedy: native_copy_greedy })
}
