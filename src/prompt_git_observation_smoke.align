module prompt_git_observation_smoke

import prompt_git_observation
import prompt_fixture_setup
import prompt_fixture_command
import prompt_scope_cleanup
import prompt_worktree
import prompt_worktree_changes
import std.fs
import std.process
import std.time
import std.encoding

fn image(root_path: str) -> Result<process.image, Error> {
  root := fs.open_directory(root_path)?
  input := root.open_read_single_link("git")?
  mut memory := fs.memory_file(fs.memory_kind.Executable, 16777216)?
  mut count := 0
  loop {
    mut chunk := buffer(65536)
    size := input.read(chunk)?
    if size == 0 { break }
    count = count + size
    if count > 16777216 { return Err(Error.Invalid) }
    memory.write(chunk.bytes())?
  }
  sealed := memory.seal()?
  return process.executable(sealed)
}

fn recover(attempt: prompt_fixture_setup.Attempt, cancel: bool) -> Result<(), Error> {
  mut scope := attempt.scope
  cleanup := prompt_scope_cleanup.run(scope, time.instant() + 10000000000, 32768, 8192)?
  if !cleanup.released { return Err(Error.Timeout) }
  if !cancel || attempt.operation != 0 { return Err(Error.Invalid) }
  match attempt.error { None => {}, Some(error) => { return Err(error) } }
  match attempt.report {
    Some(report) => { if !report.cleanup.released { return Err(Error.Invalid) }; match report.stop { Cancelled(_) => {}, _ => { return Err(Error.Invalid) } } },
    None => { return Err(Error.Invalid) },
  }
  return Ok(())
}

fn owned(image_path: str, path: str, revision: str, mode: str, owner_pid: str) -> Result<prompt_git_observation.Readout, Error> {
  git := image(image_path)?
  workspace := fs.open_directory(path)?
  procfs := fs.open_directory("/proc")?
  mut signals := process.signals(process.signal_set { hangup: false, interrupt: true, quit: false, terminate: true })?
  profile := prompt_fixture_command.Profile { fresh: false, library_path: "".clone(), ld_library_path: "".clone(), pkg_config_path: "".clone() }
  if mode == "cancel" {
    command := process.command("/bin/sh", ["/bin/sh", "-c", "[ \"$1\" = \"$PPID\" ] || exit 91; kill -TERM \"$1\"", "observation-signal", owner_pid])
    sent := command.run()
    match sent { Ok(output) => { status := output.status(); if !match status.termination { Exited(code) => code == 0, _ => false } { signals.close()?; return Err(Error.Invalid) } }, Err(error) => { signals.close()?; return Err(error) } }
  }
  result := prompt_git_observation.observe(git, signals, workspace, procfs, path, revision, profile, time.instant() + 60000000000)
  restored := signals.close()
  match restored {
    Ok(_) => {},
    Err(error) => {
      match result { Ok(readout) => { match readout { Stopped(attempt) => { recover(attempt, false)? }, Ready(_) => {} } }, Err(_) => {} }
      return Err(error)
    },
  }
  return result
}

fn index_hex(bytes: slice<u8>) -> string = encoding.hex_encode(bytes).clone()

fn inspect(value: prompt_git_observation.Observation, path: str, mode: str) -> Result<(), Error> {
  if value.tree.len() != 3 || value.staged.len() != 1 || value.staged[0] != "b" { return Err(Error.Invalid) }
  mut index := 0
  loop {
    if index == value.tree.len() { break }
    line := builder()
    line.write(value.tree[index].path)
    line.write(" ")
    line.write(value.tree[index].mode)
    line.write(" ")
    line.write(value.tree[index].blob)
    print(line.to_string())
    index = index + 1
  }
  print(index_hex(value.index))
  if value.untracked.len() != (if mode == "paths" { 1 } else { 0 }) || value.ignored.len() != (if mode == "changes" { 0 } else { 1 }) { return Err(Error.Invalid) }
  if mode == "paths" && value.untracked[0] != "u" { return Err(Error.Invalid) }
  if mode != "changes" && value.ignored[0] != "ignored.tmp" { return Err(Error.Invalid) }
  workspace := fs.open_directory(path)?
  snapshot := prompt_worktree.observe(workspace, 16, 1024, time.instant() + 10000000000)?
  actual := prompt_worktree_changes.changes(value.tree, snapshot.entries)
  admission := prompt_worktree_changes.admit(actual, value.staged, value.untracked, value.ignored, ["a", "b"])
  match admission.decision {
    Allowed => { if mode != "changes" || admission.changed.len() != 2 { return Err(Error.Invalid) } },
    Untracked => { if mode != "paths" || admission.changed.len() != 4 { return Err(Error.Invalid) } },
    Ignored => { if mode != "ignored" || admission.changed.len() != 3 { return Err(Error.Invalid) } },
    _ => { return Err(Error.Invalid) },
  }
  return Ok(())
}

fn scope_available() -> Result<(), Error> {
  command := process.command("/bin/sh", ["/bin/sh", "-c", "exec sleep 120"])
  mut scope := command.start_scope()?
  report := prompt_scope_cleanup.run(scope, time.instant() + 10000000000, 32768, 8192)?
  if !report.released { return Err(Error.Timeout) }
  mut signals := process.signals(process.signal_set { hangup: false, interrupt: true, quit: false, terminate: true })?
  return signals.close()
}

pub fn main(args: array<str>) -> Result<(), Error> {
  if args.len() != 7 { return Err(Error.Invalid) }
  if args[1] == "Darwin" {
    match fs.memory_file(fs.memory_kind.Executable, 1) { Err(error) => { match error { Code(code) => { if code != 45 { return Err(Error.Invalid) } }, _ => { return Err(error) } } }, Ok(_) => { return Err(Error.Invalid) } }
    print("git observation: Darwin sealed-image ENOTSUP 45 PASS")
    return Ok(())
  }
  outcome := owned(args[2], args[3], args[4], args[5], args[6])
  match outcome {
    Err(error) => { if args[5] != "head" && args[5] != "flags" { return Err(error) }; match error { Invalid => {}, _ => { return Err(error) } } },
    Ok(readout) => { match readout { Ready(value) => { inspect(value, args[3], args[5])? }, Stopped(attempt) => { recover(attempt, args[5] == "cancel")? } } },
  }
  scope_available()?
  print(args[5])
  return Ok(())
}
