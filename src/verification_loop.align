module verification_loop

import core.json
import failure_memory
import patch_eval
import repo_index
import std.fs
import std.time
import verify

// C4 turns the read-only C3 report into a bounded verification loop. The repair input is a
// checked-in patch for the fixed smoke task; a model-backed provider can replace that input later
// without changing the build, test, timeout, or result protocol.

SCHEMA_VERSION := 2

pub LoopStatus { Passed, Failed, GaveUp, Exhausted, RepairFailed, Invalid }

pub VerificationResult {
  document: string,
  status: LoopStatus,
  iteration_count: i64,
  repair_count: i64,
}

pub RunSummary {
  status: LoopStatus,
  iteration_count: i64,
  repair_count: i64,
}

CommandSpec {
  cmd: str,
  argv: array<str>,
  expected_code: i64,
}

VerificationTask {
  schema_version: i64,
  task_id: str,
  root: str,
  candidate_patch: str,
  repair_patch: str,
  memory_profile: Option<str>,
  build: CommandSpec,
  targeted_test: Option<CommandSpec>,
  full_test: CommandSpec,
  timeout_ns: i64,
  max_iterations: i64,
}

LoopMeta {
  schema_version: i64,
  task_id: str,
  status: str,
  error_code: i64,
  iteration_count: i64,
  max_iterations: i64,
  repair_count: i64,
  evaluation_status: str,
}

AttemptMeta {
  iteration: i64,
  status: str,
  repair_prompt: str,
}

StageRecord {
  stage: str,
  status: str,
  expected_code: i64,
  actual_code: i64,
  duration_ns: i64,
  summary: str,
  stdout: str,
  stderr: str,
}

StageStatus { StagePass, StageFail, StageTimeout, StageError }

FailureEvaluation {
  schema_version: i64,
  status: str,
  error_code: i64,
}

StageOutcome {
  status: StageStatus,
  expected_code: i64,
  actual_code: i64,
  duration_ns: i64,
  summary: string,
  stdout: string,
  stderr: string,
  document: string,
}

AttemptRun {
  status: string,
  final_status: LoopStatus,
  code: i64,
  candidate_applied: bool,
  repaired: bool,
  repair_count: i64,
  prompt: string,
  stages: string,
}

pub fn loop_status_label(status: LoopStatus) -> str = match status {
  Passed => "PASS",
  Failed => "FAIL",
  GaveUp => "GAVE_UP",
  Exhausted => "EXHAUSTED",
  RepairFailed => "REPAIR_FAILED",
  Invalid => "INVALID",
}

fn evaluation_status_label(status: repo_index.IndexStatus) -> str = match status {
  Ready => "ok",
  Partial => "partial",
  Failed => "error",
}

fn stage_status(status: verify.RunStatus, code: i64, expected_code: i64) -> StageStatus {
  return match status {
    Completed => if code == expected_code { StageStatus.StagePass } else { StageStatus.StageFail },
    TimedOut => StageStatus.StageTimeout,
    SpawnFailed => StageStatus.StageError,
  }
}

fn stage_status_label(status: StageStatus) -> str = match status {
  StagePass => "PASS",
  StageFail => "FAIL",
  StageTimeout => "TIMEOUT",
  StageError => "ERROR",
}

fn stage_passed(status: StageStatus) -> bool = match status {
  StagePass => true,
  _ => false,
}

fn first_line(value: str) -> string {
  end := value.find("\n") else value.len()
  return value[0..end].trim().clone()
}

fn diagnostic_summary(stdout: str, stderr: str) -> string {
  if stderr.len() > 0 {
    return first_line(stderr)
  }
  if stdout.len() > 0 {
    return first_line(stdout)
  }
  return "no diagnostic output".clone()
}

fn run_command(
  stage: str,
  cmd: str,
  argv: slice<str>,
  expected_code: i64,
  root: str,
  timeout_ns: i64,
) -> StageOutcome {
  started := time.instant()
  captured := verify.run(cmd, argv, root, timeout_ns)
  elapsed := time.instant() - started
  status := stage_status(captured.status, captured.code, expected_code)
  stdout := captured.stdout.clone()
  stderr := captured.stderr.clone()
  summary := diagnostic_summary(stdout, stderr)
  status_view: str := stage_status_label(status)
  summary_view: str := summary
  stdout_view: str := stdout
  stderr_view: str := stderr
  record := StageRecord {
    stage: stage,
    status: status_view,
    expected_code: expected_code,
    actual_code: captured.code,
    duration_ns: elapsed,
    summary: summary_view,
    stdout: stdout_view,
    stderr: stderr_view,
  }
  document := json.encode(record).clone()
  return StageOutcome {
    status: status,
    expected_code: expected_code,
    actual_code: captured.code,
    duration_ns: elapsed,
    summary: summary,
    stdout: stdout,
    stderr: stderr,
    document: document,
  }
}

fn run_spec(
  stage: str,
  cmd: str,
  argv: slice<str>,
  expected_code: i64,
  root: str,
  timeout_ns: i64,
) -> StageOutcome {
  return run_command(stage, cmd, argv, expected_code, root, timeout_ns)
}

fn apply_patch(stage: str, root: str, patch_path: str, timeout_ns: i64) -> StageOutcome {
  argv := ["git", "apply", "--check", "--apply", "--recount", patch_path].to_array()
  return run_command(stage, "git", argv, 0, root, timeout_ns)
}

fn repair_prompt(
  task_id: str,
  evaluation_document: str,
  memory_context: str,
  stage: str,
  expected_code: i64,
  actual_code: i64,
  summary: str,
  stdout: str,
  stderr: str,
) -> string {
  b := builder()
  b.write("Repair request\n")
  b.write("task: ")
  b.write(task_id)
  b.write("\nstage: ")
  b.write(stage)
  b.write("\nexpected exit code: ")
  b.write_int(expected_code)
  b.write("\nactual exit code: ")
  b.write_int(actual_code)
  b.write("\nsummary: ")
  b.write(summary)
  b.write("\nstdout:\n")
  b.write(stdout)
  b.write("\nstderr:\n")
  b.write(stderr)
  b.write("\npatch evaluation:\n")
  b.write(evaluation_document)
  b.write("\nmemory context:\n")
  if memory_context.len() == 0 {
    b.write("none")
  } else {
    b.write(memory_context)
  }
  return b.to_string()
}

fn render_attempt(iteration: i64, status: str, prompt: str, stages: str) -> string {
  meta := AttemptMeta { iteration: iteration, status: status, repair_prompt: prompt }
  meta_json := json.encode(meta)
  b := builder()
  b.write(meta_json[0..meta_json.len() - 1])
  b.write(",\"stages\":[")
  b.write(stages)
  b.write("]}")
  return b.to_string()
}

fn append_attempt(existing: str, attempt: str) -> string {
  b := builder()
  if existing.len() > 0 {
    b.write(existing)
    b.write(",")
  }
  b.write(attempt)
  return b.to_string()
}

fn render_document(
  task_id: str,
  status: LoopStatus,
  error_code: i64,
  iteration_count: i64,
  max_iterations: i64,
  repair_count: i64,
  evaluation_status: str,
  evaluation_document: str,
  attempts: str,
) -> string {
  meta := LoopMeta {
    schema_version: SCHEMA_VERSION,
    task_id: task_id,
    status: loop_status_label(status),
    error_code: error_code,
    iteration_count: iteration_count,
    max_iterations: max_iterations,
    repair_count: repair_count,
    evaluation_status: evaluation_status,
  }
  meta_json := json.encode(meta)
  b := builder()
  b.write(meta_json[0..meta_json.len() - 1])
  b.write(",\"evaluation\":")
  b.write(evaluation_document)
  b.write(",\"attempts\":[")
  b.write(attempts)
  b.write("]}")
  return b.to_string()
}

fn empty_evaluation(status: str, error_code: i64) -> string {
  record := FailureEvaluation { schema_version: 1, status: status, error_code: error_code }
  return json.encode(record).clone()
}

fn invalid_result(task_id: str, error_code: i64) -> VerificationResult {
  evaluation := empty_evaluation("error", error_code)
  invalid_document := render_document(
    task_id,
    LoopStatus.Invalid,
    error_code,
    0,
    0,
    0,
    "error",
    evaluation,
    "",
  )
  return VerificationResult {
    document: invalid_document,
    status: LoopStatus.Invalid,
    iteration_count: 0,
    repair_count: 0,
  }
}

fn run_attempt(
  borrow task: VerificationTask,
  iteration: i64,
  candidate_applied: bool,
  repair_count: i64,
  evaluation_document: str,
  memory_context: str,
) -> AttemptRun {
  mut stages := builder()
  mut stage_count := 0
  mut candidate_done := candidate_applied
  mut stage_document := "".clone()

  if !candidate_done {
    candidate_apply := apply_patch(
      "candidate-apply",
      task.root,
      task.candidate_patch,
      task.timeout_ns,
    )
    stages.write(candidate_apply.document)
    stage_count = stage_count + 1
    if !stage_passed(candidate_apply.status) {
      prompt := repair_prompt(
        task.task_id,
        evaluation_document,
        memory_context,
        "candidate-apply",
        candidate_apply.expected_code,
        candidate_apply.actual_code,
        candidate_apply.summary,
        candidate_apply.stdout,
        candidate_apply.stderr,
      )
      stage_document = stages.to_string()
      return AttemptRun {
        status: "FAIL".clone(),
        final_status: LoopStatus.Failed,
        code: candidate_apply.actual_code,
        candidate_applied: false,
        repaired: false,
        repair_count: repair_count,
        prompt: prompt,
        stages: stage_document,
      }
    }
    candidate_done = true
  }

  build_out := run_spec(
    "build",
    task.build.cmd,
    task.build.argv,
    task.build.expected_code,
    task.root,
    task.timeout_ns,
  )
  if stage_count > 0 { stages.write(",") }
  stages.write(build_out.document)
  stage_count = stage_count + 1
  if !stage_passed(build_out.status) {
    prompt := repair_prompt(
      task.task_id,
      evaluation_document,
      memory_context,
      "build",
      build_out.expected_code,
      build_out.actual_code,
      build_out.summary,
      build_out.stdout,
      build_out.stderr,
    )
    if repair_count > 0 || task.repair_patch.len() == 0 || iteration >= task.max_iterations {
      terminal := if iteration >= task.max_iterations {
        LoopStatus.Exhausted
      } else {
        LoopStatus.GaveUp
      }
      stage_document = stages.to_string()
      return AttemptRun {
        status: loop_status_label(terminal).clone(),
        final_status: terminal,
        code: build_out.actual_code,
        candidate_applied: candidate_done,
        repaired: false,
        repair_count: repair_count,
        prompt: prompt,
        stages: stage_document,
      }
    }
    repair_build := apply_patch(
      "repair-apply",
      task.root,
      task.repair_patch,
      task.timeout_ns,
    )
    stages.write(",")
    stages.write(repair_build.document)
    if !stage_passed(repair_build.status) {
      stage_document = stages.to_string()
      return AttemptRun {
        status: "REPAIR_FAILED".clone(),
        final_status: LoopStatus.RepairFailed,
        code: repair_build.actual_code,
        candidate_applied: candidate_done,
        repaired: false,
        repair_count: repair_count,
        prompt: prompt,
        stages: stage_document,
      }
    }
    stage_document = stages.to_string()
    return AttemptRun {
      status: "REPAIRING".clone(),
      final_status: LoopStatus.Failed,
      code: build_out.actual_code,
      candidate_applied: candidate_done,
      repaired: true,
      repair_count: repair_count + 1,
      prompt: prompt,
      stages: stage_document,
    }
  }

  match task.targeted_test {
    Some(targeted) => {
      targeted_out := run_spec(
        "targeted-test",
        targeted.cmd,
        targeted.argv,
        targeted.expected_code,
        task.root,
        task.timeout_ns,
      )
      stages.write(",")
      stages.write(targeted_out.document)
      stage_count = stage_count + 1
      if !stage_passed(targeted_out.status) {
        prompt := repair_prompt(
          task.task_id,
          evaluation_document,
          memory_context,
          "targeted-test",
          targeted_out.expected_code,
          targeted_out.actual_code,
          targeted_out.summary,
          targeted_out.stdout,
          targeted_out.stderr,
        )
        if repair_count > 0 || task.repair_patch.len() == 0 || iteration >= task.max_iterations {
          terminal := if iteration >= task.max_iterations {
            LoopStatus.Exhausted
          } else {
            LoopStatus.GaveUp
          }
          stage_document = stages.to_string()
          return AttemptRun {
            status: loop_status_label(terminal).clone(),
            final_status: terminal,
            code: targeted_out.actual_code,
            candidate_applied: candidate_done,
            repaired: false,
            repair_count: repair_count,
            prompt: prompt,
            stages: stage_document,
          }
        }
        repair_targeted := apply_patch(
          "repair-apply",
          task.root,
          task.repair_patch,
          task.timeout_ns,
        )
        stages.write(",")
        stages.write(repair_targeted.document)
        if !stage_passed(repair_targeted.status) {
          stage_document = stages.to_string()
          return AttemptRun {
            status: "REPAIR_FAILED".clone(),
            final_status: LoopStatus.RepairFailed,
            code: repair_targeted.actual_code,
            candidate_applied: candidate_done,
            repaired: false,
            repair_count: repair_count,
            prompt: prompt,
            stages: stage_document,
          }
        }
        stage_document = stages.to_string()
        return AttemptRun {
          status: "REPAIRING".clone(),
          final_status: LoopStatus.Failed,
          code: targeted_out.actual_code,
          candidate_applied: candidate_done,
          repaired: true,
          repair_count: repair_count + 1,
          prompt: prompt,
          stages: stage_document,
        }
      }
    },
    None => {},
  }

  full_out := run_spec(
    "full-test",
    task.full_test.cmd,
    task.full_test.argv,
    task.full_test.expected_code,
    task.root,
    task.timeout_ns,
  )
  stages.write(",")
  stages.write(full_out.document)
  if stage_passed(full_out.status) {
    stage_document = stages.to_string()
    return AttemptRun {
      status: "PASS".clone(),
      final_status: LoopStatus.Passed,
      code: -1,
      candidate_applied: candidate_done,
      repaired: false,
      repair_count: repair_count,
      prompt: "".clone(),
      stages: stage_document,
    }
  }

  prompt := repair_prompt(
    task.task_id,
    evaluation_document,
    memory_context,
    "full-test",
    full_out.expected_code,
    full_out.actual_code,
    full_out.summary,
    full_out.stdout,
    full_out.stderr,
  )
  if repair_count > 0 || task.repair_patch.len() == 0 || iteration >= task.max_iterations {
    terminal := if iteration >= task.max_iterations {
      LoopStatus.Exhausted
    } else {
      LoopStatus.GaveUp
    }
    stage_document = stages.to_string()
    return AttemptRun {
      status: loop_status_label(terminal).clone(),
      final_status: terminal,
      code: full_out.actual_code,
      candidate_applied: candidate_done,
      repaired: false,
      repair_count: repair_count,
      prompt: prompt,
      stages: stage_document,
    }
  }
  repair_full := apply_patch(
    "repair-apply",
    task.root,
    task.repair_patch,
    task.timeout_ns,
  )
  stages.write(",")
  stages.write(repair_full.document)
  if !stage_passed(repair_full.status) {
    stage_document = stages.to_string()
    return AttemptRun {
      status: "REPAIR_FAILED".clone(),
      final_status: LoopStatus.RepairFailed,
      code: repair_full.actual_code,
      candidate_applied: candidate_done,
      repaired: false,
      repair_count: repair_count,
      prompt: prompt,
      stages: stage_document,
    }
  }
  stage_document = stages.to_string()
  return AttemptRun {
    status: "REPAIRING".clone(),
    final_status: LoopStatus.Failed,
    code: full_out.actual_code,
    candidate_applied: candidate_done,
    repaired: true,
    repair_count: repair_count + 1,
    prompt: prompt,
    stages: stage_document,
  }
}
fn run_task(borrow task: VerificationTask, memory_context: str) -> VerificationResult {
  evaluated := patch_eval.evaluate(task.root, task.candidate_patch, task.timeout_ns)
  evaluation_status := evaluation_status_label(evaluated.status)
  evaluation_document: str := evaluated.document
  evaluation_failed := match evaluated.status {
    Failed => true,
    _ => false,
  }
  if evaluation_failed {
    evaluation_failure_document := render_document(
      task.task_id,
      LoopStatus.Invalid,
      2,
      0,
      task.max_iterations,
      0,
      evaluation_status,
      evaluation_document,
      "",
    )
    return VerificationResult {
      document: evaluation_failure_document,
      status: LoopStatus.Invalid,
      iteration_count: 0,
      repair_count: 0,
    }
  }

  mut attempts := "".clone()
  mut iteration := 0
  mut repair_count := 0
  mut candidate_applied := false
  mut final_status := LoopStatus.Failed
  mut final_code := -1
  loop {
    if iteration >= task.max_iterations { break }
    iteration = iteration + 1
    attempt := run_attempt(
      task,
      iteration,
      candidate_applied,
      repair_count,
      evaluation_document,
      memory_context,
    )
    attempt_document := render_attempt(iteration, attempt.status, attempt.prompt, attempt.stages)
    attempts = append_attempt(attempts, attempt_document)
    candidate_applied = attempt.candidate_applied
    repair_count = attempt.repair_count
    final_code = attempt.code
    if !attempt.repaired {
      final_status = attempt.final_status
      break
    }
  }
  final_document := render_document(
    task.task_id,
    final_status,
    final_code,
    iteration,
    task.max_iterations,
    repair_count,
    evaluation_status,
    evaluation_document,
    attempts,
  )
  return VerificationResult {
    document: final_document,
    status: final_status,
    iteration_count: iteration,
    repair_count: repair_count,
  }
}
fn valid_command(borrow command: CommandSpec) -> bool {
  if command.cmd.len() == 0 || command.cmd.contains("\0") || command.argv.len() == 0 {
    return false
  }
  mut index := 0
  loop {
    if index >= command.argv.len() { break }
    if command.argv[index].contains("\0") { return false }
    index = index + 1
  }
  return true
}

fn write_invalid_result(task_id: str, result_path: str) -> Result<RunSummary, Error> {
  result := invalid_result(task_id, 2)
  fs.write_file(result_path, result.document)?
  return Ok(RunSummary {
      status: LoopStatus.Invalid,
      iteration_count: 0,
      repair_count: 0,
    })
}

fn run_valid_file(
  borrow task: VerificationTask,
  profile_path: str,
  result_path: str,
) -> Result<RunSummary, Error> {
  memory_context := failure_memory.load_context(profile_path, task.task_id)
  result := run_task(task, memory_context)
  result_status := result.status
  result_iteration_count := result.iteration_count
  result_repair_count := result.repair_count
  fs.write_file(result_path, result.document)?
  if profile_path.len() > 0 {
    // Memory is an enhancement to repair prompts; a malformed or unwritable profile must not
    // hide the verification result that was already written above.
    memory_write := failure_memory.remember(result_path, profile_path)
    match memory_write {
      Ok(_) => {},
      Err(_) => {},
    }
  }
  return Ok(RunSummary {
      status: result_status,
      iteration_count: result_iteration_count,
      repair_count: result_repair_count,
    })
}
fn run_decoded_file(borrow task: VerificationTask, result_path: str) -> Result<RunSummary, Error> {
  if task.schema_version != SCHEMA_VERSION { return write_invalid_result(task.task_id, result_path) }
  if task.task_id.len() == 0 || task.task_id.contains("\0") {
    return write_invalid_result(task.task_id, result_path)
  }
  if task.root.len() == 0 || task.root.contains("\0") {
    return write_invalid_result(task.task_id, result_path)
  }
  if task.candidate_patch.len() == 0 || task.candidate_patch.contains("\0") {
    return write_invalid_result(task.task_id, result_path)
  }
  if task.repair_patch.contains("\0") { return write_invalid_result(task.task_id, result_path) }
  profile_path: str := task.memory_profile else ""
  if profile_path.contains("\0") { return write_invalid_result(task.task_id, result_path) }
  if task.timeout_ns <= 0 || task.max_iterations <= 0 {
    return write_invalid_result(task.task_id, result_path)
  }
  if !valid_command(task.build) { return write_invalid_result(task.task_id, result_path) }
  match task.targeted_test {
    Some(targeted) => {
      if !valid_command(targeted) { return write_invalid_result(task.task_id, result_path) }
    },
    None => {},
  }
  if !valid_command(task.full_test) { return write_invalid_result(task.task_id, result_path) }
  return run_valid_file(task, profile_path, result_path)
}
pub fn run_file(task_path: str, result_path: str) -> Result<RunSummary, Error> {
  data := fs.read_file(task_path)?
  arena {
    task: VerificationTask := json.decode(data)?
    return run_decoded_file(task, result_path)
  }
}
