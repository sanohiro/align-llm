module prompt_verifier_smoke

import prompt_artifacts
import prompt_score

fn digest_a() -> string = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa".clone()
fn digest_b() -> string = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb".clone()
fn digest_c() -> string = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc".clone()
fn adapter_expectation_digest() -> string = "feb45d362834c0986bf5116dada3f79901d2079d339d92b8d4064d355fed4a0c".clone()

fn empty_strings() -> array<string> {
  values: array_builder<string> := array_builder()
  return values.build()
}

fn expectations() -> array<prompt_artifacts.ArtifactExpectation> {
  mut values: array_builder<prompt_artifacts.ArtifactExpectation> := array_builder()
  values.push(prompt_artifacts.ArtifactExpectation {
      path: "adapter".clone(),
      kind: "FILE".clone(),
      expected_sha256: adapter_expectation_digest(),
    })
  values.push(prompt_artifacts.ArtifactExpectation {
      path: "snapshot".clone(),
      kind: "TREE".clone(),
      expected_sha256: digest_b(),
    })
  return values.build()
}

fn empty_digests() -> array<prompt_artifacts.ArtifactDigest> {
  values: array_builder<prompt_artifacts.ArtifactDigest> := array_builder()
  return values.build()
}

fn digests() -> array<prompt_artifacts.ArtifactDigest> {
  mut values: array_builder<prompt_artifacts.ArtifactDigest> := array_builder()
  values.push(prompt_artifacts.ArtifactDigest {
      path: "adapter".clone(),
      mode: "100755".clone(),
      byte_count: 1,
      sha256: digest_a(),
    })
  values.push(prompt_artifacts.ArtifactDigest {
      path: "snapshot".clone(),
      mode: "040755".clone(),
      byte_count: 0,
      sha256: digest_b(),
    })
  return values.build()
}

fn wrong_tree_digests() -> array<prompt_artifacts.ArtifactDigest> {
  mut values: array_builder<prompt_artifacts.ArtifactDigest> := array_builder()
  values.push(prompt_artifacts.ArtifactDigest {
      path: "adapter".clone(),
      mode: "100755".clone(),
      byte_count: 1,
      sha256: digest_a(),
    })
  values.push(prompt_artifacts.ArtifactDigest {
      path: "snapshot".clone(),
      mode: "040755".clone(),
      byte_count: 0,
      sha256: digest_c(),
    })
  return values.build()
}

fn one_string(text: str) -> array<string> {
  mut values: array_builder<string> := array_builder()
  values.push(text.clone())
  return values.build()
}

fn text_artifact(kind: str, id: str) -> prompt_artifacts.PromptTextArtifact {
  return prompt_artifacts.PromptTextArtifact {
    schema_version: 1,
    artifact_kind: kind.clone(),
    artifact_id: id.clone(),
    text: "text".clone(),
    content_sha256: digest_a(),
  }
}

fn context_policy() -> prompt_artifacts.ContextPolicy {
  return prompt_artifacts.ContextPolicy {
    include_patch_evaluation: false,
    include_failure_memory: false,
    include_diagnostics: false,
    max_patch_evaluation_bytes: 0,
    max_failure_events: 0,
    max_failure_context_bytes: 0,
    max_diagnostic_bytes_per_stream: 0,
  }
}

fn variant(parent: bool) -> prompt_artifacts.PromptVariant {
  return prompt_artifacts.PromptVariant {
    schema_version: 1,
    artifact_kind: "PROMPT_VARIANT".clone(),
    variant_id: if parent { "parent".clone() } else { "candidate".clone() },
    base_prompt: text_artifact("BASE_PROMPT", "base"),
    repo_prompt: text_artifact("REPO_PROMPT", "repo"),
    learned_prompt_append: "".clone(),
    context_policy: context_policy(),
    candidate_id: if parent { "baseline".clone() } else { "proposal".clone() },
    content_sha256: if parent { digest_b() } else { digest_c() },
  }
}

fn corpus_revision() -> prompt_artifacts.CorpusRevision {
  return prompt_artifacts.CorpusRevision {
    schema_version: 1,
    artifact_kind: "CORPUS_REVISION".clone(),
    source_kind: "GIT_COMMIT".clone(),
    source_repository_id: "corpus-repository".clone(),
    source_sha256: digest_a(),
    content_sha256: digest_a(),
  }
}

fn scope(provider_kind: str) -> prompt_artifacts.PromptScope {
  return prompt_artifacts.PromptScope {
    schema_version: 1,
    artifact_kind: "PROMPT_SCOPE".clone(),
    repo_id: "repo".clone(),
    repo_profile_revision: "profile-v1".clone(),
    align_revision: digest_a(),
    corpus_id: "corpus".clone(),
    corpus_revision: corpus_revision(),
    evaluation_provider_kind: provider_kind.clone(),
    evaluation_provider_model: "model".clone(),
    generation_policy_sha256: digest_a(),
    acceptance_policy_sha256: digest_a(),
    base_prompt_sha256: digest_a(),
    repo_prompt_sha256: digest_a(),
    content_sha256: digest_a(),
  }
}

fn reference(kind: str, id: str, digest: str) -> prompt_artifacts.ArtifactReference {
  return prompt_artifacts.ArtifactReference {
    artifact_kind: kind.clone(),
    path: "artifact.json".clone(),
    artifact_id: id.clone(),
    content_sha256: digest.clone(),
  }
}

fn experiment(provider_kind: str) -> prompt_artifacts.PromptExperimentResult {
  proposal_kind := if provider_kind == "FIXTURE" { "LOCAL_OPENAI".clone() } else { provider_kind.clone() }
  return prompt_artifacts.PromptExperimentResult {
    schema_version: 1,
    artifact_kind: "PROMPT_EXPERIMENT_RESULT".clone(),
    experiment_id: Some("experiment".clone()),
    status: "PROPOSED".clone(),
    error_code: "NONE".clone(),
    error: "".clone(),
    parent_activation: Some(reference("PROMPT_ACTIVATION_RESULT", "decision", digest_a())),
    scope: Some(scope(provider_kind)),
    opportunity: Some(reference("OPPORTUNITY", "opportunity", digest_a())),
    proposal_provider_kind: Some(proposal_kind),
    proposal_provider_endpoint_id: Some("endpoint".clone()),
    proposal_provider_model: Some("model".clone()),
    proposal_elapsed_ns: 0,
    proposal_status_code: None,
    proposal_summary: "proposal".clone(),
    candidate_variant: Some(variant(false)),
    bounded_provider_output: "".clone(),
    content_sha256: digest_a(),
  }
}

fn activation(provider_kind: str) -> prompt_artifacts.PromptActivation {
  return prompt_artifacts.PromptActivation {
    schema_version: 1,
    artifact_kind: "PROMPT_ACTIVATION".clone(),
    activation_id: "activation".clone(),
    operation: "BASELINE".clone(),
    scope: scope(provider_kind),
    parent_activation_id: "".clone(),
    parent_activation_sha256: "".clone(),
    effective_variant: variant(true),
    accepted_evaluation_id: "".clone(),
    accepted_evaluation_sha256: "".clone(),
    rollback_target_activation_id: "".clone(),
    rollback_target_activation_sha256: "".clone(),
    decision_reason: "".clone(),
    content_sha256: digest_a(),
  }
}

fn activation_result(provider_kind: str) -> prompt_artifacts.PromptActivationResult {
  return prompt_artifacts.PromptActivationResult {
    schema_version: 1,
    artifact_kind: "PROMPT_ACTIVATION_RESULT".clone(),
    decision_id: Some("decision".clone()),
    status: "BASELINED".clone(),
    error_code: "NONE".clone(),
    error: "".clone(),
    activation: Some(activation(provider_kind)),
    content_sha256: digest_a(),
  }
}

fn corpus() -> prompt_artifacts.PromptEvaluationCorpus {
  return prompt_artifacts.PromptEvaluationCorpus {
    schema_version: 1,
    artifact_kind: "PROMPT_EVALUATION_CORPUS".clone(),
    corpus_id: "corpus".clone(),
    corpus_revision: corpus_revision(),
    task_files: one_string("task.json"),
    content_sha256: digest_a(),
  }
}

fn task() -> prompt_artifacts.PromptEvaluationTask {
  return prompt_artifacts.PromptEvaluationTask {
    schema_version: 1,
    artifact_kind: "PROMPT_EVALUATION_TASK".clone(),
    task_id: "task".clone(),
    repo_id: "repo".clone(),
    repo_revision: digest_a(),
    repo_path: "repository".clone(),
    require_clean_repo: true,
    cmd: "adapter".clone(),
    argv: one_string("adapter"),
    snapshot_cmd: "snapshot".clone(),
    snapshot_argv: one_string("snapshot"),
    measurement_adapter_runtime: "runtime".clone(),
    snapshot_helper_runtime: "snapshot-runtime".clone(),
    cwd: "repository".clone(),
    timeout_ns: 1_000_000,
    task_prompt_path: "task-prompt.json".clone(),
    context_sources_path: "context.json".clone(),
    generation_policy_path: "generation.json".clone(),
    provider_control_path: "provider.json".clone(),
    environment_policy_path: "environment.json".clone(),
    validation_runner_path: "runner.py".clone(),
    validation_runner_sha256: digest_a(),
    task_definition_path: "task-definition.json".clone(),
    task_definition_sha256: digest_b(),
    validation_argv: one_string("--retained-inputs"),
    patch_path: None,
    patch_sha256: None,
    artifacts: expectations(),
    regression_limits: prompt_artifacts.RegressionLimits {
      maximum_unrelated_diff_count: 10,
      maximum_patch_size_bytes: 1_000,
      maximum_public_api_change_count: 10,
      maximum_repair_loops: 10,
      maximum_benchmark_regression_ppm: None,
    },
    content_sha256: digest_a(),
  }
}

