fn terminal_measurement() -> prompt_artifacts.TaskMeasurement {
  seed := 7
  return prompt_artifacts.TaskMeasurement {
    schema_version: 1,
    artifact_kind: "TASK_MEASUREMENT".clone(),
    status: "ERROR".clone(),
    failure_kind: "ADAPTER".clone(),
    build_status: "NOT_RUN".clone(),
    test_status: "NOT_RUN".clone(),
    repair_loop_count: 0,
    unrelated_diff_count: 0,
    patch_size_bytes: 0,
    public_api_change_count: 0,
    policy_violation_count: 0,
    cleanup_passed: true,
    containment_passed: true,
    benchmark_regression_ppm: None,
    generation_to_passing_patch_ns: None,
    rendered_prompt_sha256: digest_a(),
    generation_request: generation_request(seed),
    environment_probe: probe("MEASUREMENT_ADAPTER", "runtime"),
    seed_attestation: seed_attestation("LOCAL_OPENAI", seed),
    diagnostic_summary: "adapter error".clone(),
    diagnostic_stdout: "".clone(),
    diagnostic_stderr: "".clone(),
    edit_set: None,
    edit_set_total_bytes: None,
    patch_sha256: None,
    base_adapter_runtime_identity: None,
    edit_refusal: None,
    completion_bytes: None,
    completion_sha256: None,
    completion_text: None,
    content_sha256: digest_a(),
  }
}

fn retained_row(terminal: bool) -> prompt_artifacts.PromptTaskRow {
  if !terminal { return row(1, true, true, "LOCAL_OPENAI", false) }
  return prompt_artifacts.PromptTaskRow {
    schema_version: 1,
    artifact_kind: "PROMPT_TASK_ROW".clone(),
    evaluation_id: "evaluation".clone(),
    task_id: "task".clone(),
    sample_index: 1,
    variant: "PARENT".clone(),
    variant_id: "parent".clone(),
    variant_sha256: digest_b(),
    prompt_preparation_ns: 10,
    repair_loop_count: None,
    generation_to_passing_patch_ns: None,
    time_to_passing_patch_ns: None,
    attempts: None,
    evaluation_input: evaluation_input(1, 7),
    measurement: terminal_measurement(),
    content_sha256: digest_a(),
  }
}

fn retained_rows(terminal: bool) -> array<prompt_artifacts.PromptTaskRow> {
  mut values: array_builder<prompt_artifacts.PromptTaskRow> := array_builder()
  values.push(retained_row(terminal))
  return values.build()
}

fn retained_attestations() -> array<prompt_artifacts.RunSnapshotAttestation> {
  mut values: array_builder<prompt_artifacts.RunSnapshotAttestation> := array_builder()
  values.push(attestation(1, true))
  return values.build()
}

fn drift_input_snapshots() -> array<prompt_artifacts.TaskInputSnapshot> {
  mut values: array_builder<prompt_artifacts.TaskInputSnapshot> := array_builder()
  values.push(input_snapshot())
  values.push(drift_input_snapshot())
  return values.build()
}

fn drift_failed_attestation(postcheck: bool) -> prompt_artifacts.RunSnapshotAttestation {
  return prompt_artifacts.RunSnapshotAttestation {
    schema_version: 1,
    artifact_kind: "RUN_SNAPSHOT_ATTESTATION".clone(),
    task_id: "task".clone(),
    sample_index: 1,
    variant: "CANDIDATE".clone(),
    status: if postcheck { "POSTCHECK_DRIFT".clone() } else { "PRECHECK_DRIFT".clone() },
    error_code: "INPUT_DRIFT".clone(),
    error: "input drift".clone(),
    snapshot_request_sha256: digest_a(),
    before_snapshot_result_sha256: digest_a(),
    after_snapshot_result_sha256: if postcheck { Some(digest_a()) } else { None },
    before_input_snapshot_sha256: if postcheck { Some(digest_a()) } else { Some(digest_b()) },
    after_input_snapshot_sha256: if postcheck { Some(digest_b()) } else { None },
    content_sha256: digest_b(),
  }
}

fn drift_attestations(postcheck: bool) -> array<prompt_artifacts.RunSnapshotAttestation> {
  mut values: array_builder<prompt_artifacts.RunSnapshotAttestation> := array_builder()
  values.push(attestation(1, true))
  values.push(drift_failed_attestation(postcheck))
  return values.build()
}

fn retained_evidence(verified: bool) -> prompt_artifacts.PromptEvaluationEvidence {
  mut inputs: array_builder<prompt_artifacts.PromptExpectedInputDigest> := array_builder()
  inputs.push(expected_input(1, true, false))
  return prompt_artifacts.PromptEvaluationEvidence {
    schema_version: 1,
    artifact_kind: "PROMPT_EVALUATION_EVIDENCE".clone(),
    evaluation_id: "evaluation".clone(),
    evaluation_result_sha256: digest_a(),
    trust: trust(verified),
    expected_inputs: inputs.build(),
    content_sha256: digest_a(),
  }
}

fn retained_error_result(mode: i64) -> prompt_artifacts.PromptEvaluationResult {
  terminal := mode != 0
  error_code := if mode == 2 {
    "ARITHMETIC".clone()
  } else if terminal {
    "ADAPTER_RESULT".clone()
  } else {
    "CLEANUP_FAILED".clone()
  }
  error_text := if mode == 2 {
    "arithmetic".clone()
  } else if terminal {
    "adapter result".clone()
  } else {
    "cleanup failed".clone()
  }
  return prompt_artifacts.PromptEvaluationResult {
    schema_version: 1,
    artifact_kind: "PROMPT_EVALUATION_RESULT".clone(),
    evaluation_id: Some("evaluation".clone()),
    status: "ERROR".clone(),
    error_code: error_code,
    error: error_text,
    experiment: Some(reference("PROMPT_EXPERIMENT_RESULT", "experiment", digest_a())),
    experiment_artifact: Some(experiment("LOCAL_OPENAI")),
    parent_activation: Some(reference("PROMPT_ACTIVATION_RESULT", "decision", digest_a())),
    parent_activation_artifact: Some(activation_result("LOCAL_OPENAI")),
    scope: Some(scope("LOCAL_OPENAI")),
    parent_variant: Some(variant(true)),
    candidate_variant: Some(variant(false)),
    corpus_source: Some(reference("PROMPT_EVALUATION_CORPUS", "corpus", digest_a())),
    corpus: Some(corpus()),
    tasks: tasks_array(),
    acceptance_policy_source: Some(reference("PROMPT_ACCEPTANCE_POLICY", "policy", digest_a())),
    acceptance_policy: Some(acceptance_policy()),
    generation_policy_source: Some(reference("GENERATION_POLICY", "generation", digest_a())),
    generation_policy: Some(generation_policy("LOCAL_OPENAI")),
    provider_control_source: Some(reference("EVALUATION_PROVIDER_CONTROL", "provider", digest_a())),
    provider_control: Some(provider_control("LOCAL_OPENAI")),
    workspace_preflight_source: Some(reference("WORKSPACE_PREFLIGHT_RESULT", "evaluation", digest_a())),
    workspace_preflight_request: Some(workspace_request()),
    workspace_preflight: Some(workspace_result()),
    environment: Some(environment()),
    snapshot_requests: snapshot_requests_array(),
    snapshot_results: snapshot_results_array(),
    input_snapshots: input_snapshots_array(),
    snapshot_attestations: retained_attestations(),
    trace_failure: None,
    sample_count: 2,
    gate_eligible: false,
    rows: retained_rows(terminal),
    task_aggregates: empty_task_aggregates_array(),
    corpus_aggregate: None,
    serious_regression_reasons: empty_reasons(),
    content_sha256: digest_a(),
  }
}

fn drift_error_result(postcheck: bool) -> prompt_artifacts.PromptEvaluationResult {
  return prompt_artifacts.PromptEvaluationResult {
    schema_version: 1,
    artifact_kind: "PROMPT_EVALUATION_RESULT".clone(),
    evaluation_id: Some("evaluation".clone()),
    status: "ERROR".clone(),
    error_code: "INPUT_DRIFT".clone(),
    error: "input drift".clone(),
    experiment: Some(reference("PROMPT_EXPERIMENT_RESULT", "experiment", digest_a())),
    experiment_artifact: Some(experiment("LOCAL_OPENAI")),
    parent_activation: Some(reference("PROMPT_ACTIVATION_RESULT", "decision", digest_a())),
    parent_activation_artifact: Some(activation_result("LOCAL_OPENAI")),
    scope: Some(scope("LOCAL_OPENAI")),
    parent_variant: Some(variant(true)),
    candidate_variant: Some(variant(false)),
    corpus_source: Some(reference("PROMPT_EVALUATION_CORPUS", "corpus", digest_a())),
    corpus: Some(corpus()),
    tasks: tasks_array(),
    acceptance_policy_source: Some(reference("PROMPT_ACCEPTANCE_POLICY", "policy", digest_a())),
    acceptance_policy: Some(acceptance_policy()),
    generation_policy_source: Some(reference("GENERATION_POLICY", "generation", digest_a())),
    generation_policy: Some(generation_policy("LOCAL_OPENAI")),
    provider_control_source: Some(reference("EVALUATION_PROVIDER_CONTROL", "provider", digest_a())),
    provider_control: Some(provider_control("LOCAL_OPENAI")),
    workspace_preflight_source: Some(reference("WORKSPACE_PREFLIGHT_RESULT", "evaluation", digest_a())),
    workspace_preflight_request: Some(workspace_request()),
    workspace_preflight: Some(workspace_result()),
    environment: Some(environment()),
    snapshot_requests: snapshot_requests_array(),
    snapshot_results: snapshot_results_array(),
    input_snapshots: drift_input_snapshots(),
    snapshot_attestations: drift_attestations(postcheck),
    trace_failure: None,
    sample_count: 2,
    gate_eligible: false,
    rows: retained_rows(false),
    task_aggregates: empty_task_aggregates_array(),
    corpus_aggregate: None,
    serious_regression_reasons: empty_reasons(),
    content_sha256: digest_a(),
  }
}

fn verdict_code(value: prompt_score.PromptScoreStatus) -> i64 {
  return match value {
    ImprovedEligible => 1,
    CompleteIneligible => 2,
    NoncompleteError => 3,
  }
}

fn expect_ok(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  borrow evidence_value: prompt_artifacts.PromptEvaluationEvidence,
  expected: i64,
) -> Result<(), Error> {
  verdict := prompt_score.verify_result(result, evidence_value)?
  if verdict_code(verdict) != expected || result.rows.len() != 4 || evidence_value.expected_inputs.len() != 4 {
    return Err(Error.Invalid)
  }
  return Ok(())
}

fn expect_invalid(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  borrow evidence_value: prompt_artifacts.PromptEvaluationEvidence,
) -> Result<(), Error> {
  return match prompt_score.verify_result(result, evidence_value) {
    Ok(_) => Err(Error.Invalid),
    Err(_) => Ok(()),
  }
}

fn expect_noncomplete(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  borrow evidence_value: prompt_artifacts.PromptEvaluationEvidence,
) -> Result<(), Error> {
  verdict := prompt_score.verify_result(result, evidence_value)?
  if verdict_code(verdict) != 3 ||
  match result.evaluation_id { None => true, Some(value) => value != evidence_value.evaluation_id } {
    return Err(Error.Invalid)
  }
  return Ok(())
}

// --- C4-REPAIR-MEASURED: version-2 attempt rows -----------------------------------------------
// Every version-2 row here recovers: attempt one fails validation, the evaluator renders a repair
// prompt from that attempt's own diagnostics, and attempt two passes. Defect codes drive the
// rejection cases; defect 0 is the clean document.

fn attempt_measurement(passing: bool, window: i64, seed: i64) -> prompt_artifacts.TaskMeasurement {
  return prompt_artifacts.TaskMeasurement {
    schema_version: 1,
    artifact_kind: "TASK_MEASUREMENT".clone(),
    status: if passing { "PASS".clone() } else { "FAIL".clone() },
    failure_kind: if passing { "NONE".clone() } else { "TEST".clone() },
    build_status: if passing { "PASS".clone() } else { "PASS".clone() },
    test_status: if passing { "PASS".clone() } else { "FAIL".clone() },
    repair_loop_count: 0,
    unrelated_diff_count: 0,
    patch_size_bytes: 10,
    public_api_change_count: 0,
    policy_violation_count: 0,
    cleanup_passed: true,
    containment_passed: true,
    benchmark_regression_ppm: None,
    generation_to_passing_patch_ns: if passing { Some(window) } else { None },
    rendered_prompt_sha256: digest_a(),
    generation_request: generation_request(seed),
    environment_probe: probe("MEASUREMENT_ADAPTER", "runtime"),
    seed_attestation: seed_attestation("LOCAL_OPENAI", seed),
    diagnostic_summary: "provider-backed candidate patch failed validation".clone(),
    diagnostic_stdout: "post-repair validation exit code: 1".clone(),
    diagnostic_stderr: "AssertionError".clone(),
    edit_set: None,
    edit_set_total_bytes: None,
    patch_sha256: None,
    base_adapter_runtime_identity: None,
    edit_refusal: None,
    completion_bytes: None,
    completion_sha256: None,
    completion_text: None,
    content_sha256: if passing { digest_b() } else { digest_c() },
  }
}

fn adapter_repair_measurement(seed: i64) -> prompt_artifacts.TaskMeasurement {
  mut value := attempt_measurement(true, 30, seed)
  value.repair_loop_count = 1
  return value
}

fn drifted_measurement(seed: i64) -> prompt_artifacts.TaskMeasurement {
  mut value := attempt_measurement(true, 30, seed)
  value.diagnostic_summary = "a summary the final attempt never reported".clone()
  return value
}

fn repair_source() -> prompt_artifacts.RepairPromptSource {
  mut included: array_builder<string> := array_builder()
  included.push("STATUS".clone())
  included.push("SUMMARY".clone())
  included.push("STDOUT".clone())
  mut dropped: array_builder<string> := array_builder()
  dropped.push("STDERR".clone())
  return prompt_artifacts.RepairPromptSource {
    schema_version: 1,
    artifact_kind: "REPAIR_PROMPT_SOURCE".clone(),
    template_sha256: digest_a(),
    source_attempt_index: 1,
    source_measurement_sha256: digest_c(),
    included_sections: included.build(),
    dropped_sections: dropped.build(),
    assembled_bytes: 4_096,
    content_sha256: digest_a(),
  }
}

fn initial_attempt(index: i64, seed: i64) -> prompt_artifacts.TaskAttemptRecord {
  return prompt_artifacts.TaskAttemptRecord {
    schema_version: 1,
    artifact_kind: "TASK_ATTEMPT_RECORD".clone(),
    attempt_index: index,
    attempt_kind: "INITIAL".clone(),
    status: "FAIL".clone(),
    skip_reason: "NONE".clone(),
    rendered_prompt_sha256: Some(digest_a()),
    repair_prompt_source: None,
    adapter_request_sha256: Some(digest_a()),
    // The single persisted snapshot request, snapshot result, and input snapshot all carry
    // `digest_a()`, so every one of these resolves to exactly one record of this row's task —
    // which is what `verifier_attempt_trace_cross_valid` requires of a real run.
    snapshot_request_sha256: Some(digest_a()),
    before_snapshot_result_sha256: Some(digest_a()),
    after_snapshot_result_sha256: Some(digest_a()),
    input_snapshot_sha256: Some(digest_a()),
    generation_request: Some(generation_request(seed)),
    seed_attestation: Some(seed_attestation("LOCAL_OPENAI", seed)),
    paired_seed: seed,
    measurement: Some(attempt_measurement(false, 0, seed)),
    repair_preparation_ns: 0,
    adapter_elapsed_ns: 40,
    adapter_overhead_ns: None,
    measurement_sha256: Some(digest_c()),
    content_sha256: digest_a(),
  }
}

fn repair_attempt(index: i64, seed: i64) -> prompt_artifacts.TaskAttemptRecord {
  return prompt_artifacts.TaskAttemptRecord {
    schema_version: 1,
    artifact_kind: "TASK_ATTEMPT_RECORD".clone(),
    attempt_index: index,
    attempt_kind: "REPAIR".clone(),
    status: "PASS".clone(),
    skip_reason: "NONE".clone(),
    rendered_prompt_sha256: Some(digest_a()),
    repair_prompt_source: Some(repair_source()),
    adapter_request_sha256: Some(digest_a()),
    // The single persisted snapshot request, snapshot result, and input snapshot all carry
    // `digest_a()`, so every one of these resolves to exactly one record of this row's task —
    // which is what `verifier_attempt_trace_cross_valid` requires of a real run.
    snapshot_request_sha256: Some(digest_a()),
    before_snapshot_result_sha256: Some(digest_a()),
    after_snapshot_result_sha256: Some(digest_a()),
    input_snapshot_sha256: Some(digest_a()),
    generation_request: Some(generation_request(seed)),
    seed_attestation: Some(seed_attestation("LOCAL_OPENAI", seed)),
    paired_seed: seed,
    measurement: Some(attempt_measurement(true, 30, seed)),
    repair_preparation_ns: 10,
    adapter_elapsed_ns: 40,
    adapter_overhead_ns: Some(10),
    measurement_sha256: Some(digest_b()),
    content_sha256: digest_a(),
  }
}

fn passing_initial_attempt(seed: i64) -> prompt_artifacts.TaskAttemptRecord {
  return prompt_artifacts.TaskAttemptRecord {
    schema_version: 1,
    artifact_kind: "TASK_ATTEMPT_RECORD".clone(),
    attempt_index: 1,
    attempt_kind: "INITIAL".clone(),
    status: "PASS".clone(),
    skip_reason: "NONE".clone(),
    rendered_prompt_sha256: Some(digest_a()),
    repair_prompt_source: None,
    adapter_request_sha256: Some(digest_a()),
    // The single persisted snapshot request, snapshot result, and input snapshot all carry
    // `digest_a()`, so every one of these resolves to exactly one record of this row's task —
    // which is what `verifier_attempt_trace_cross_valid` requires of a real run.
    snapshot_request_sha256: Some(digest_a()),
    before_snapshot_result_sha256: Some(digest_a()),
    after_snapshot_result_sha256: Some(digest_a()),
    input_snapshot_sha256: Some(digest_a()),
    generation_request: Some(generation_request(seed)),
    seed_attestation: Some(seed_attestation("LOCAL_OPENAI", seed)),
    paired_seed: seed,
    measurement: Some(attempt_measurement(true, 30, seed)),
    repair_preparation_ns: 0,
    adapter_elapsed_ns: 90,
    adapter_overhead_ns: Some(60),
    measurement_sha256: Some(digest_b()),
    content_sha256: digest_a(),
  }
}

// Defect 8: an attempt that ran but attests none of the trace records its invocation produced.
// Once a row can run twice, `snapshot_attestations` no longer reaches a repair attempt's records,
// so the attempt record is what keeps them bound; an unbound record must be rejected.
fn untraced_initial_attempt(index: i64, seed: i64) -> prompt_artifacts.TaskAttemptRecord {
  mut attempt := initial_attempt(index, seed)
  attempt.snapshot_request_sha256 = None
  return attempt
}

// Defect 9: a third attempt that never ran. `repair_count` counts only repairs that ran, so it
// stays 1 and the row's declared count still matches it; the structural `1 + maximum_repair_loops`
// bound is then the only check that rejects the list, which is what gives that bound single-point
// coverage instead of leaving it shadowed by two other rules.
fn skipped_repair_attempt(index: i64, seed: i64) -> prompt_artifacts.TaskAttemptRecord {
  return prompt_artifacts.TaskAttemptRecord {
    schema_version: 1,
    artifact_kind: "TASK_ATTEMPT_RECORD".clone(),
    attempt_index: index,
    attempt_kind: "REPAIR".clone(),
    status: "SKIPPED".clone(),
    skip_reason: "REPAIR_PROMPT_BUDGET".clone(),
    rendered_prompt_sha256: None,
    repair_prompt_source: Some(repair_source()),
    adapter_request_sha256: None,
    snapshot_request_sha256: None,
    before_snapshot_result_sha256: None,
    after_snapshot_result_sha256: None,
    input_snapshot_sha256: None,
    generation_request: None,
    seed_attestation: None,
    paired_seed: seed,
    measurement: None,
    repair_preparation_ns: 10,
    adapter_elapsed_ns: 0,
    adapter_overhead_ns: None,
    measurement_sha256: None,
    content_sha256: digest_a(),
  }
}

// Defect 12: an attempt whose input-snapshot digest is well formed but names no persisted record.
// Presence alone admits it, and the record it should have named is still referenced by the row's
// attestation, so only resolution rejects it.
fn unresolved_trace_attempt(index: i64, seed: i64) -> prompt_artifacts.TaskAttemptRecord {
  mut attempt := repair_attempt(index, seed)
  attempt.input_snapshot_sha256 = Some(digest_b())
  return attempt
}

// Defect 13 is an ACCEPTANCE case, not a rejection. `scripts/prompt-fixed-adapter.py` is a
// byte-frozen corpus member that emits `repair_loop_count: 1` on its expected-failure path, and a
// task that offers no repair must still admit that document: the adapter's value is carried
// verbatim and is not the authority. Rejecting it turned every version-2 publish from the
// deterministic fixture corpus into `EVALUATION_FAILED`.
//
// Written as a whole record rather than as `attempt.measurement = Some(...)`: the pinned compiler
// supports owned field replacement only for `string` and `Option<string>` leaves.
fn adapter_repair_initial_attempt(seed: i64) -> prompt_artifacts.TaskAttemptRecord {
  return prompt_artifacts.TaskAttemptRecord {
    schema_version: 1,
    artifact_kind: "TASK_ATTEMPT_RECORD".clone(),
    attempt_index: 1,
    attempt_kind: "INITIAL".clone(),
    status: "PASS".clone(),
    skip_reason: "NONE".clone(),
    rendered_prompt_sha256: Some(digest_a()),
    repair_prompt_source: None,
    adapter_request_sha256: Some(digest_a()),
    snapshot_request_sha256: Some(digest_a()),
    before_snapshot_result_sha256: Some(digest_a()),
    after_snapshot_result_sha256: Some(digest_a()),
    input_snapshot_sha256: Some(digest_a()),
    generation_request: Some(generation_request(seed)),
    seed_attestation: Some(seed_attestation("LOCAL_OPENAI", seed)),
    paired_seed: seed,
    measurement: Some(adapter_repair_measurement(seed)),
    repair_preparation_ns: 0,
    adapter_elapsed_ns: 90,
    adapter_overhead_ns: Some(60),
    measurement_sha256: Some(digest_b()),
    content_sha256: digest_a(),
  }
}

// --- C4-REPAIR-EDITSET: version-2 measurements ------------------------------------------------
// Defect 14 is the ACCEPTANCE case: a corpus that names `scripts/prompt-repair-adapter.py` and
// whose every ran attempt therefore carries a version-2 measurement with a realized edit set, a
// patch digest, and the base adapter's identity, with `EDITSET` among the sections the repair
// prompt actually carried. Defects 15-20 are one rejection each, and each is written so that the
// rule it names is the only rule that can reject it.

fn repair_adapter_argv() -> array<string> {
  mut values: array_builder<string> := array_builder()
  values.push("/usr/bin/python3".clone())
  values.push("scripts/prompt-repair-adapter.py".clone())
  return values.build()
}

// The corpus selects the adapter, and the adapter selects the measurement version (ladder row 11).
fn task_repair_adapter() -> prompt_artifacts.PromptEvaluationTask {
  return task_named(1)
}

// --- C4-REPAIR-TEMPLATE: version-3 measurements -----------------------------------------------
// Defect 21 is the ACCEPTANCE case: a corpus naming `scripts/prompt-template-adapter.py` whose
// every ran attempt carries a version-3 measurement with a refusal code, the completion identity,
// and the widened `edit_set` rule, and whose two new aggregates are recomputed from the attempts.
// Defects 22-27 are one rejection each, and each is written so that the rule it names is the only
// rule that can reject it.

fn template_adapter_argv() -> array<string> {
  mut values: array_builder<string> := array_builder()
  values.push("/usr/bin/python3".clone())
  values.push("scripts/prompt-template-adapter.py".clone())
  return values.build()
}

fn task_template_adapter() -> prompt_artifacts.PromptEvaluationTask {
  return task_named(2)
}

fn uses_template_adapter(defect: i64) -> bool {
  // Defect 22 is deliberately a **repair-adapter** corpus: a version-2 measurement carrying a
  // version-3 member. On a template-adapter corpus the version rule would reject it as well, and
  // a case with two possible causes proves neither.
  return defect >= 21 && defect <= 27 && defect != 22
}

// Defect 23 is a template-adapter corpus emitting a version-2 measurement, so it is the one case
// where the adapter is the template adapter and the version is still 2.
fn measurement_is_version_three(defect: i64) -> bool {
  return uses_template_adapter(defect) && defect != 23
}

fn base_identity_value() -> string {
  return "PYTHON:2d3796dbf1159d4a9528a62bbb9af0f36ccc5878b76d83aa65fa0d39cca7b20c".clone()
}

fn completion_text_value() -> string {
  return "I would change src/duration.py to divide by sixty.\n".clone()
}

fn completion_digest_value() -> string {
  hashed := crypto.sha256("I would change src/duration.py to divide by sixty.\n")
  return encoding.hex_encode(hashed[0..hashed.len()])
}

fn completion_byte_count() -> i64 {
  return "I would change src/duration.py to divide by sixty.\n".bytes().len()
}

// Defect 25 is the invariant this capability exists to establish, inverted: a reproduced-unchanged
// refusal that discarded the blocks its producer built one line before the raise. Defect 26 puts a
// completion excerpt on a code whose `edit_set` already carries the model's own bodies.
fn measurement_v3(
  passing: bool, window: i64, seed: i64, defect: i64, runtime: str,
) -> prompt_artifacts.TaskMeasurement {
  return prompt_artifacts.TaskMeasurement {
    schema_version: 3,
    artifact_kind: "TASK_MEASUREMENT".clone(),
    status: if passing { "PASS".clone() } else { "FAIL".clone() },
    failure_kind: if passing {
      "NONE".clone()
    } else if defect == 25 {
      "PATCH".clone()
    } else {
      "TEST".clone()
    },
    build_status: if defect == 25 && !passing { "NOT_RUN".clone() } else { "PASS".clone() },
    test_status: if defect == 25 && !passing {
      "NOT_RUN".clone()
    } else if passing {
      "PASS".clone()
    } else {
      "FAIL".clone()
    },
    repair_loop_count: 0,
    unrelated_diff_count: 0,
    patch_size_bytes: if defect == 25 && !passing { 0 } else { 10 },
    public_api_change_count: 0,
    policy_violation_count: 0,
    cleanup_passed: true,
    containment_passed: true,
    benchmark_regression_ppm: None,
    generation_to_passing_patch_ns: if passing { Some(window) } else { None },
    rendered_prompt_sha256: digest_a(),
    generation_request: generation_request(seed),
    environment_probe: probe("MEASUREMENT_ADAPTER", runtime),
    seed_attestation: seed_attestation("LOCAL_OPENAI", seed),
    diagnostic_summary: if defect == 25 && !passing {
      "the response reproduced the pinned files unchanged".clone()
    } else {
      "provider-backed candidate patch failed validation".clone()
    },
    diagnostic_stdout: "post-repair validation exit code: 1".clone(),
    diagnostic_stderr: "AssertionError".clone(),
    // Defect 25 discards the blocks its own refusal was computed from, which the widened rule
    // rejects and which no version-2 rule could have seen.
    edit_set: if defect == 25 && !passing { None } else { Some(edit_set_blocks(true)) },
    edit_set_total_bytes: if defect == 25 && !passing { None } else { Some(body_byte_count()) },
    patch_sha256: if defect == 25 && !passing { None } else { Some(digest_b()) },
    base_adapter_runtime_identity: Some(base_identity_value()),
    // Defect 24 leaves the ten-code vocabulary; defect 25 records the mode this capability exists
    // to explain. Every other case records `NONE`, which is what an unrefused attempt carries.
    edit_refusal: if defect == 24 {
      Some("NO_SUCH_REFUSAL".clone())
    } else if defect == 25 && !passing {
      Some("UNCHANGED_FILES".clone())
    } else {
      Some("NONE".clone())
    },
    completion_bytes: Some(completion_byte_count()),
    completion_sha256: Some(completion_digest_value()),
    // Defect 26 persists the excerpt on a code whose edit set already carries the model's bodies.
    completion_text: if defect == 26 { Some(completion_text_value()) } else { None },
    content_sha256: if passing { digest_b() } else { digest_c() },
  }
}

// Defect 22: a version-2 measurement carrying a version-3 member. Absence below version 3 is
// required rather than defaulted, so this is rejected by the version-2 shape rule alone.
fn measurement_v2_with_v3_member(
  passing: bool, window: i64, seed: i64,
) -> prompt_artifacts.TaskMeasurement {
  mut value := measurement_v2(passing, window, seed, 0, "runtime")
  value.edit_refusal = Some("NONE".clone())
  return value
}

// Defect 27: the row-level view differs from its final attempt's measurement in a version-3
// member and in nothing else. Without those four comparisons `verifier_measurement_equal` would
// still pass while comparing 27 of 31 fields, so this is the single case that keeps ladder row 26
// honest at version 3.
fn template_drifted_measurement(seed: i64, defect: i64) -> prompt_artifacts.TaskMeasurement {
  mut value := measurement_v3(true, 30, seed, defect, "runtime")
  value.completion_sha256 = Some(digest_c())
  return value
}

fn uses_repair_adapter(defect: i64) -> bool {
  return defect == 14 || (defect >= 16 && defect <= 20) || defect == 22 ||
  uses_template_adapter(defect)
}

// Defect 16 is a repair-adapter corpus emitting a version-1 measurement, so it is the one case
// where the adapter is the repair adapter and the version is still 1.
fn measurement_is_version_two(defect: i64) -> bool {
  return defect == 14 || (defect >= 17 && defect <= 20) || defect == 22
}

fn editset_attempts(defect: i64) -> i64 {
  // A repair attempt counts only when it ran and its prompt actually carried `EDITSET`. Only the
  // version-2 and version-3 measurement defects render it, and every one of their rows still runs
  // its repair attempt.
  if measurement_is_version_three(defect) || defect == 23 { return 2 }
  if !measurement_is_version_two(defect) { return 0 }
  return 2
}

// A ran attempt contributes when its measurement records a code other than `NONE`. Only defect 25
// records one, and it does so on the initial attempt of each of the two rows per variant.
fn edit_refusals(defect: i64) -> i64 {
  if defect == 25 { return 2 }
  return 0
}

fn body_text_value() -> string {
  return "def round_to_minutes(seconds):\n    return seconds // 60\n".clone()
}

fn body_digest_value() -> string {
  hashed := crypto.sha256("def round_to_minutes(seconds):\n    return seconds // 60\n")
  return encoding.hex_encode(hashed[0..hashed.len()])
}

fn body_byte_count() -> i64 {
  return "def round_to_minutes(seconds):\n    return seconds // 60\n".bytes().len()
}

fn edit_set_blocks(carried: bool) -> array<prompt_artifacts.EditSetBlock> {
  mut values: array_builder<prompt_artifacts.EditSetBlock> := array_builder()
  values.push(prompt_artifacts.EditSetBlock {
      schema_version: 1,
      artifact_kind: "EDIT_SET_BLOCK".clone(),
      path: "src/duration.py".clone(),
      body_bytes: body_byte_count(),
      body_sha256: body_digest_value(),
      // An omitted block keeps its path, length, and digest and loses only its text.
      body_text: if carried { Some(body_text_value()) } else { None },
      content_sha256: digest_a(),
    })
  return values.build()
}

fn measurement_v2(
  passing: bool, window: i64, seed: i64, defect: i64, runtime: str,
) -> prompt_artifacts.TaskMeasurement {
  return prompt_artifacts.TaskMeasurement {
    schema_version: 2,
    artifact_kind: "TASK_MEASUREMENT".clone(),
    status: if passing { "PASS".clone() } else { "FAIL".clone() },
    failure_kind: if passing { "NONE".clone() } else { "TEST".clone() },
    build_status: "PASS".clone(),
    test_status: if passing { "PASS".clone() } else { "FAIL".clone() },
    repair_loop_count: 0,
    unrelated_diff_count: 0,
    patch_size_bytes: 10,
    public_api_change_count: 0,
    policy_violation_count: 0,
    cleanup_passed: true,
    containment_passed: true,
    benchmark_regression_ppm: None,
    generation_to_passing_patch_ns: if passing { Some(window) } else { None },
    rendered_prompt_sha256: digest_a(),
    generation_request: generation_request(seed),
    environment_probe: probe("MEASUREMENT_ADAPTER", runtime),
    seed_attestation: seed_attestation("LOCAL_OPENAI", seed),
    diagnostic_summary: "provider-backed candidate patch failed validation".clone(),
    diagnostic_stdout: "post-repair validation exit code: 1".clone(),
    diagnostic_stderr: "AssertionError".clone(),
    edit_set: Some(edit_set_blocks(true)),
    // Defect 20 breaks only the pre-omission sum, which no other rule reads.
    edit_set_total_bytes: Some(if defect == 20 { body_byte_count() + 1 } else { body_byte_count() }),
    patch_sha256: Some(digest_b()),
    // Defect 17 omits the one version-2 member that is unconditionally present.
    base_adapter_runtime_identity: if defect == 17 {
      None
    } else {
      Some("PYTHON:2d3796dbf1159d4a9528a62bbb9af0f36ccc5878b76d83aa65fa0d39cca7b20c".clone())
    },
    edit_refusal: None,
    completion_bytes: None,
    completion_sha256: None,
    completion_text: None,
    content_sha256: if passing { digest_b() } else { digest_c() },
  }
}

// Defect 15: a version-1 measurement carrying a version-2 member. Absence at version 1 is
// required rather than defaulted, so this is rejected by the version-1 shape rule alone.
fn measurement_v1_with_v2_member(passing: bool, window: i64, seed: i64) -> prompt_artifacts.TaskMeasurement {
  mut value := attempt_measurement(passing, window, seed)
  value.patch_sha256 = Some(digest_b())
  return value
}

// Defect 18: an attempt-level probe naming another runtime. The row-level check binds only the
// final attempt once a row can run twice, so breaking attempt one is exactly the section 2.3 gap
// that ladder row 12 closes.
fn measurement_v2_wrong_identity(seed: i64, defect: i64) -> prompt_artifacts.TaskMeasurement {
  return measurement_v2(false, 0, seed, defect, "another-runtime")
}

fn attempt_measurement_for(passing: bool, window: i64, seed: i64, defect: i64) -> prompt_artifacts.TaskMeasurement {
  if defect == 15 { return measurement_v1_with_v2_member(passing, window, seed) }
  if defect == 22 { return measurement_v2_with_v3_member(passing, window, seed) }
  if measurement_is_version_three(defect) {
    return measurement_v3(passing, window, seed, defect, "runtime")
  }
  if defect == 23 { return measurement_v2(passing, window, seed, defect, "runtime") }
  if measurement_is_version_two(defect) { return measurement_v2(passing, window, seed, defect, "runtime") }
  return attempt_measurement(passing, window, seed)
}

fn repair_source_v2() -> prompt_artifacts.RepairPromptSource {
  mut included: array_builder<string> := array_builder()
  included.push("STATUS".clone())
  included.push("EDITSET".clone())
  included.push("SUMMARY".clone())
  included.push("STDOUT".clone())
  mut dropped: array_builder<string> := array_builder()
  dropped.push("STDERR".clone())
  return prompt_artifacts.RepairPromptSource {
    schema_version: 1,
    artifact_kind: "REPAIR_PROMPT_SOURCE".clone(),
    template_sha256: digest_a(),
    source_attempt_index: 1,
    source_measurement_sha256: digest_c(),
    included_sections: included.build(),
    dropped_sections: dropped.build(),
    assembled_bytes: 4_096,
    content_sha256: digest_a(),
  }
}

// `POLICY` sits between `STATUS` and `EDITSET` and is never dropped, so a version-3 source keeps
// it at every rung the four-step ladder can reach.
fn repair_source_v3() -> prompt_artifacts.RepairPromptSource {
  mut included: array_builder<string> := array_builder()
  included.push("STATUS".clone())
  included.push("POLICY".clone())
  included.push("EDITSET".clone())
  included.push("SUMMARY".clone())
  included.push("STDOUT".clone())
  mut dropped: array_builder<string> := array_builder()
  dropped.push("STDERR".clone())
  return prompt_artifacts.RepairPromptSource {
    schema_version: 1,
    artifact_kind: "REPAIR_PROMPT_SOURCE".clone(),
    template_sha256: digest_a(),
    source_attempt_index: 1,
    source_measurement_sha256: digest_c(),
    included_sections: included.build(),
    dropped_sections: dropped.build(),
    assembled_bytes: 4_096,
    content_sha256: digest_a(),
  }
}

fn editset_initial_attempt(seed: i64, defect: i64) -> prompt_artifacts.TaskAttemptRecord {
  return prompt_artifacts.TaskAttemptRecord {
    schema_version: 1,
    artifact_kind: "TASK_ATTEMPT_RECORD".clone(),
    attempt_index: 1,
    attempt_kind: "INITIAL".clone(),
    status: "FAIL".clone(),
    skip_reason: "NONE".clone(),
    rendered_prompt_sha256: Some(digest_a()),
    repair_prompt_source: None,
    adapter_request_sha256: Some(digest_a()),
    snapshot_request_sha256: Some(digest_a()),
    before_snapshot_result_sha256: Some(digest_a()),
    after_snapshot_result_sha256: Some(digest_a()),
    input_snapshot_sha256: Some(digest_a()),
    generation_request: Some(generation_request(seed)),
    seed_attestation: Some(seed_attestation("LOCAL_OPENAI", seed)),
    paired_seed: seed,
    measurement: if defect == 18 {
      Some(measurement_v2_wrong_identity(seed, defect))
    } else {
      Some(attempt_measurement_for(false, 0, seed, defect))
    },
    repair_preparation_ns: 0,
    adapter_elapsed_ns: 40,
    adapter_overhead_ns: None,
    measurement_sha256: Some(digest_c()),
    content_sha256: digest_a(),
  }
}

fn editset_repair_attempt(seed: i64, defect: i64) -> prompt_artifacts.TaskAttemptRecord {
  return prompt_artifacts.TaskAttemptRecord {
    schema_version: 1,
    artifact_kind: "TASK_ATTEMPT_RECORD".clone(),
    attempt_index: 2,
    attempt_kind: "REPAIR".clone(),
    status: "PASS".clone(),
    skip_reason: "NONE".clone(),
    rendered_prompt_sha256: Some(digest_a()),
    repair_prompt_source: if measurement_is_version_three(defect) {
      Some(repair_source_v3())
    } else if measurement_is_version_two(defect) || defect == 23 {
      Some(repair_source_v2())
    } else {
      Some(repair_source())
    },
    adapter_request_sha256: Some(digest_a()),
    snapshot_request_sha256: Some(digest_a()),
    before_snapshot_result_sha256: Some(digest_a()),
    after_snapshot_result_sha256: Some(digest_a()),
    input_snapshot_sha256: Some(digest_a()),
    generation_request: Some(generation_request(seed)),
    seed_attestation: Some(seed_attestation("LOCAL_OPENAI", seed)),
    paired_seed: seed,
    measurement: Some(attempt_measurement_for(true, 30, seed, defect)),
    repair_preparation_ns: 10,
    adapter_elapsed_ns: 40,
    adapter_overhead_ns: Some(10),
    measurement_sha256: Some(digest_b()),
    content_sha256: digest_a(),
  }
}

// Defect 19: the row-level view differs from its final attempt's measurement in a version-2
// member and in nothing else. Without those four comparisons `verifier_measurement_equal` would
// still pass while comparing 23 of 27 fields, so this is the single case that keeps ladder row 18
// honest at version 2.
fn editset_drifted_measurement(seed: i64, defect: i64) -> prompt_artifacts.TaskMeasurement {
  mut value := measurement_v2(true, 30, seed, defect, "runtime")
  value.patch_sha256 = Some(digest_c())
  return value
}

fn is_editset_defect(defect: i64) -> bool {
  return (defect >= 14 && defect <= 20) || uses_template_adapter(defect)
}

fn attempts_for(defect: i64, seed: i64) -> array<prompt_artifacts.TaskAttemptRecord> {
  mut values: array_builder<prompt_artifacts.TaskAttemptRecord> := array_builder()
  if defect == 2 {
    // Two initial attempts: no attempt list may claim more than one.
    values.push(initial_attempt(1, seed))
    values.push(initial_attempt(2, seed))
    return values.build()
  }
  if defect == 4 {
    // Longer than `1 + maximum_repair_loops`: the task declares a cap of one repair.
    values.push(initial_attempt(1, seed))
    values.push(repair_attempt(2, seed))
    values.push(repair_attempt(3, seed))
    return values.build()
  }
  if defect == 8 {
    values.push(untraced_initial_attempt(1, seed))
    values.push(repair_attempt(2, seed))
    return values.build()
  }
  if defect == 7 {
    // The ordinary no-repair shape: one initial attempt that passes.
    values.push(passing_initial_attempt(seed))
    return values.build()
  }
  if defect == 13 {
    values.push(adapter_repair_initial_attempt(seed))
    return values.build()
  }
  if defect == 9 {
    values.push(initial_attempt(1, seed))
    values.push(repair_attempt(2, seed))
    values.push(skipped_repair_attempt(3, seed))
    return values.build()
  }
  if defect == 10 {
    // Two repairs that both ran, against a task whose cap is two: the length bound admits the
    // list and the declared count matches it, so `repair_count > 1` is the only rejection.
    values.push(initial_attempt(1, seed))
    values.push(repair_attempt(2, seed))
    values.push(repair_attempt(3, seed))
    return values.build()
  }
  if defect == 12 {
    values.push(initial_attempt(1, seed))
    values.push(unresolved_trace_attempt(2, seed))
    return values.build()
  }
  if is_editset_defect(defect) {
    values.push(editset_initial_attempt(seed, defect))
    values.push(editset_repair_attempt(seed, defect))
    return values.build()
  }
  values.push(initial_attempt(1, seed))
  // Defect 1 breaks the dense ascending attempt index.
  values.push(repair_attempt(if defect == 1 { 3 } else { 2 }, seed))
  return values.build()
}

fn row_v2(sample: i64, parent: bool, defect: i64) -> prompt_artifacts.PromptTaskRow {
  seed := 6 + sample
  return prompt_artifacts.PromptTaskRow {
    schema_version: if defect == 5 { 1 } else { 2 },
    artifact_kind: "PROMPT_TASK_ROW".clone(),
    evaluation_id: "evaluation".clone(),
    task_id: "task".clone(),
    sample_index: sample,
    variant: if parent { "PARENT".clone() } else { "CANDIDATE".clone() },
    variant_id: if parent { "parent".clone() } else { "candidate".clone() },
    variant_sha256: if parent { digest_b() } else { digest_c() },
    prompt_preparation_ns: 10,
    // Defect 6 makes the row's own count disagree with its attempt list.
    repair_loop_count: Some(if defect == 6 || defect == 7 || defect == 13 {
        0
      } else if defect == 10 {
        2
      } else {
        1
      }),
    generation_to_passing_patch_ns: Some(90),
    time_to_passing_patch_ns: Some(100),
    attempts: Some(attempts_for(defect, seed)),
    evaluation_input: evaluation_input(sample, seed),
    // Defect 3 makes the row-level view disagree with the final attempt's measurement in a field
    // no aggregate reads, so ladder row 18 is the only check that can reject it.
    measurement: if defect == 3 {
      drifted_measurement(seed)
    } else if defect == 13 {
      adapter_repair_measurement(seed)
    } else if defect == 19 {
      editset_drifted_measurement(seed, defect)
    } else if defect == 27 {
      template_drifted_measurement(seed, defect)
    } else if is_editset_defect(defect) {
      attempt_measurement_for(true, 30, seed, defect)
    } else {
      attempt_measurement(true, 30, seed)
    },
    content_sha256: digest_a(),
  }
}

// Defect 10 needs a task whose cap admits three attempts, so that the two-repair rule is reached
// on its own rather than shadowed by the structural bound.
fn task_with_repair_cap(cap: i64) -> prompt_artifacts.PromptEvaluationTask {
  mut value := task()
  value.regression_limits = prompt_artifacts.RegressionLimits {
    maximum_unrelated_diff_count: 10,
    maximum_patch_size_bytes: 1_000,
    maximum_public_api_change_count: 10,
    maximum_repair_loops: cap,
    maximum_benchmark_regression_ppm: None,
  }
  return value
}

// Defect 13 needs a task that offers no repair at all: at version 2 a task must declare a repair
// template exactly when its cap is at least one, so the cap and the template move together.
fn task_without_repair() -> prompt_artifacts.PromptEvaluationTask {
  mut value := task_with_repair_cap(0)
  value.repair_template_path = None
  value.repair_template_sha256 = None
  return value
}

fn tasks_array_v2(defect: i64) -> array<prompt_artifacts.PromptEvaluationTask> {
  mut values: array_builder<prompt_artifacts.PromptEvaluationTask> := array_builder()
  if defect == 10 {
    values.push(task_with_repair_cap(2))
  } else if defect == 13 {
    values.push(task_without_repair())
  } else if uses_template_adapter(defect) {
    values.push(task_template_adapter())
  } else if uses_repair_adapter(defect) {
    values.push(task_repair_adapter())
  } else {
    values.push(task())
  }
  return values.build()
}

// Defect 11: a second persisted input snapshot that no attestation and no attempt names. It is a
// valid record of a declared task with a distinct digest, so every structural check admits it and
// only the universal "no unreferenced trace record" rule rejects the document.
fn unreferenced_input_snapshot() -> prompt_artifacts.TaskInputSnapshot {
  mut value := input_snapshot()
  value.content_sha256 = digest_b()
  return value
}

fn input_snapshots_array_v2(defect: i64) -> array<prompt_artifacts.TaskInputSnapshot> {
  mut values: array_builder<prompt_artifacts.TaskInputSnapshot> := array_builder()
  values.push(input_snapshot())
  if defect == 11 {
    values.push(unreferenced_input_snapshot())
  }
  return values.build()
}

fn rows_v2(defect: i64) -> array<prompt_artifacts.PromptTaskRow> {
  mut values: array_builder<prompt_artifacts.PromptTaskRow> := array_builder()
  values.push(row_v2(1, true, defect))
  values.push(row_v2(1, false, defect))
  values.push(row_v2(2, false, defect))
  values.push(row_v2(2, true, defect))
  return values.build()
}

// Defects 9 and 10 both produce a three-attempt row, and the section 1.4 recovery predicate is
// exactly two attempts, so neither recovers. The aggregates are recomputed by the verifier from
// the attempts, so they have to agree here or the document would be rejected by an aggregate
// mismatch instead of by the one rule each defect is written to reach.
fn attempt_recovers(defect: i64) -> bool {
  return defect != 7 && defect != 9 && defect != 10 && defect != 13
}

fn task_aggregate_v2(defect: i64) -> prompt_artifacts.TaskAggregate {
  repairs := if defect == 6 || defect == 7 || defect == 13 { 0 } else if defect == 10 { 4 } else { 2 }
  recoveries := if attempt_recovers(defect) { 2 } else { 0 }
  return prompt_artifacts.TaskAggregate {
    task_id: "task".clone(),
    parent_pass_count: 2,
    candidate_pass_count: 2,
    parent_repair_loop_count: repairs,
    candidate_repair_loop_count: repairs,
    paired_pass_count: 2,
    parent_paired_median_time_ns: Some(100),
    candidate_paired_median_time_ns: Some(100),
    time_improvement_ppm: Some(0),
    time_regression_ppm: Some(0),
    parent_repair_attempt_count: Some(if defect == 7 || defect == 13 { 0 } else { 2 }),
    candidate_repair_attempt_count: Some(if defect == 7 || defect == 13 { 0 } else { 2 }),
    parent_repair_recovery_count: Some(recoveries),
    candidate_repair_recovery_count: Some(recoveries),
    repair_recovery_paired: Some(attempt_recovers(defect)),
    // Present only for a corpus whose adapter can render the section. Defects 0-13 name the
    // frozen adapter, whose template declares no `EDITSET` kind, so the quantity is undefined for
    // them rather than zero.
    parent_repair_editset_attempt_count: if uses_repair_adapter(defect) {
      Some(editset_attempts(defect))
    } else {
      None
    },
    candidate_repair_editset_attempt_count: if uses_repair_adapter(defect) {
      Some(editset_attempts(defect))
    } else {
      None
    },
    // Present only for a corpus whose adapter persists `edit_refusal`. Defects 0-20 name an
    // earlier adapter, so the quantity is undefined for them rather than zero.
    parent_edit_refusal_count: if uses_template_adapter(defect) {
      Some(edit_refusals(defect))
    } else {
      None
    },
    candidate_edit_refusal_count: if uses_template_adapter(defect) {
      Some(edit_refusals(defect))
    } else {
      None
    },
  }
}

fn task_aggregates_v2(defect: i64) -> array<prompt_artifacts.TaskAggregate> {
  mut values: array_builder<prompt_artifacts.TaskAggregate> := array_builder()
  values.push(task_aggregate_v2(defect))
  return values.build()
}

fn corpus_aggregate_v2(defect: i64) -> prompt_artifacts.CorpusAggregate {
  repairs := if defect == 6 || defect == 7 || defect == 13 { 0 } else if defect == 10 { 4 } else { 2 }
  return prompt_artifacts.CorpusAggregate {
    task_count: 1,
    sample_count: 2,
    parent_pass_count: 2,
    candidate_pass_count: 2,
    parent_repair_loop_count: repairs,
    candidate_repair_loop_count: repairs,
    paired_pass_count: 2,
    parent_paired_median_time_ns: Some(100),
    candidate_paired_median_time_ns: Some(100),
    completion_gain_count: 0,
    time_improvement_ppm: Some(0),
    time_regression_ppm: Some(0),
    repair_loop_regression_count: 0,
    repair_attempt_count: Some(if defect == 7 || defect == 13 { 0 } else { 4 }),
    repair_recovery_count: Some(if attempt_recovers(defect) { 4 } else { 0 }),
    repair_recovery_paired_count: Some(if attempt_recovers(defect) { 2 } else { 0 }),
    repair_editset_attempt_count: if uses_repair_adapter(defect) {
      Some(2 * editset_attempts(defect))
    } else {
      None
    },
    edit_refusal_count: if uses_template_adapter(defect) {
      Some(2 * edit_refusals(defect))
    } else {
      None
    },
  }
}

fn expected_input_v2(sample: i64, parent: bool, attempt: i64) -> prompt_artifacts.PromptExpectedInputDigest {
  return prompt_artifacts.PromptExpectedInputDigest {
    schema_version: 2,
    artifact_kind: "PROMPT_EXPECTED_INPUT_DIGEST".clone(),
    task_id: "task".clone(),
    sample_index: sample,
    variant: if parent { "PARENT".clone() } else { "CANDIDATE".clone() },
    attempt_index: Some(attempt),
    rendered_prompt_sha256: digest_a(),
    context_sources_sha256: digest_a(),
    generation_request_sha256: digest_a(),
    adapter_request_sha256: digest_a(),
    provider_request_sha256: digest_a(),
    content_sha256: digest_a(),
  }
}

fn expected_inputs_v2(defect: i64) -> array<prompt_artifacts.PromptExpectedInputDigest> {
  // The identities follow the defect's actual attempt shape, so the per-attempt binding stays
  // satisfied and each defect is rejected by its own invariant rather than by a count mismatch.
  second := if defect == 1 { 3 } else { 2 }
  mut values: array_builder<prompt_artifacts.PromptExpectedInputDigest> := array_builder()
  mut index := 0
  loop {
    if index >= 4 { break }
    sample := if index < 2 { 1 } else { 2 }
    parent := index == 0 || index == 3
    values.push(expected_input_v2(sample, parent, 1))
    if defect != 7 && defect != 13 {
      values.push(expected_input_v2(sample, parent, second))
    }
    if defect == 4 || defect == 10 {
      values.push(expected_input_v2(sample, parent, 3))
    }
    index = index + 1
  }
  return values.build()
}

fn evidence_v2(defect: i64) -> prompt_artifacts.PromptEvaluationEvidence {
  return prompt_artifacts.PromptEvaluationEvidence {
    schema_version: 2,
    artifact_kind: "PROMPT_EVALUATION_EVIDENCE".clone(),
    evaluation_id: "evaluation".clone(),
    evaluation_result_sha256: digest_a(),
    trust: trust(true),
    expected_inputs: expected_inputs_v2(defect),
    content_sha256: digest_a(),
  }
}

fn complete_result_v2(defect: i64) -> prompt_artifacts.PromptEvaluationResult {
  return prompt_artifacts.PromptEvaluationResult {
    schema_version: 2,
    artifact_kind: "PROMPT_EVALUATION_RESULT".clone(),
    evaluation_id: Some("evaluation".clone()),
    status: "NO_IMPROVEMENT".clone(),
    error_code: "NONE".clone(),
    error: "".clone(),
    experiment: Some(reference("PROMPT_EXPERIMENT_RESULT", "experiment", digest_a())),
    experiment_artifact: Some(experiment("LOCAL_OPENAI")),
    parent_activation: Some(reference("PROMPT_ACTIVATION_RESULT", "decision", digest_a())),
    parent_activation_artifact: Some(activation_result("LOCAL_OPENAI")),
    scope: Some(scope("LOCAL_OPENAI")),
    parent_variant: Some(variant(true)),
    candidate_variant: Some(variant(false)),
    corpus_source: Some(reference("PROMPT_EVALUATION_CORPUS", "corpus", digest_a())),
    corpus: Some(corpus()),
    tasks: tasks_array_v2(defect),
    acceptance_policy_source: Some(reference("PROMPT_ACCEPTANCE_POLICY", "policy", digest_a())),
    acceptance_policy: Some(acceptance_policy()),
    generation_policy_source: Some(reference("GENERATION_POLICY", "generation", digest_a())),
    generation_policy: Some(generation_policy("LOCAL_OPENAI")),
    provider_control_source: Some(reference("EVALUATION_PROVIDER_CONTROL", "provider", digest_a())),
    provider_control: Some(provider_control("LOCAL_OPENAI")),
    workspace_preflight_source: Some(reference("WORKSPACE_PREFLIGHT_RESULT", "evaluation", digest_a())),
    workspace_preflight_request: Some(workspace_request()),
    workspace_preflight: Some(workspace_result()),
    environment: Some(environment()),
    snapshot_requests: snapshot_requests_array(),
    snapshot_results: snapshot_results_array(),
    input_snapshots: input_snapshots_array_v2(defect),
    snapshot_attestations: attestations(false),
    trace_failure: None,
    sample_count: 2,
    gate_eligible: false,
    rows: rows_v2(defect),
    task_aggregates: task_aggregates_v2(defect),
    corpus_aggregate: Some(corpus_aggregate_v2(defect)),
    serious_regression_reasons: empty_reasons(),
    content_sha256: digest_a(),
  }
}

fn sealed_v2(defect: i64) -> Result<prompt_artifacts.PromptEvaluationResult, Error> {
  seal := sealed_digest(complete_result_v2(defect))?
  mut value := complete_result_v2(defect)
  value.content_sha256 = seal
  return Ok(value)
}

fn sealed_v1() -> Result<prompt_artifacts.PromptEvaluationResult, Error> {
  seal := sealed_digest(complete_result(1, "LOCAL_OPENAI", "NO_IMPROVEMENT", false, false, false, false, false, false, false))?
  mut value := complete_result(1, "LOCAL_OPENAI", "NO_IMPROVEMENT", false, false, false, false, false, false, false)
  value.content_sha256 = seal
  return Ok(value)
}

fn expect_ok_v2(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  borrow evidence_value: prompt_artifacts.PromptEvaluationEvidence,
) -> Result<(), Error> {
  verdict := prompt_score.verify_result(result, evidence_value)?
  if verdict_code(verdict) != 2 || result.rows.len() != 4 ||
  evidence_value.expected_inputs.len() != 8 {
    return Err(Error.Invalid)
  }
  return Ok(())
}

// --- Round-trip regression -------------------------------------------------------------------
// The whole `Option`-instead-of-a-version-2-twin decision rests on one invariant: a document
// decodes and re-encodes byte-identically, so the persisted `content_sha256` still verifies.
// Request 52 (a `match` on an OWNED value silently moves a Move payload out, after which `encode`
// omits the field, with no compile error and no fault) makes that invariant easy to break in a
// way no other smoke observes. This exercises it directly, at both versions.

fn round_trip_equal(first: prompt_artifacts.PromptEvaluationResult, second: prompt_artifacts.PromptEvaluationResult) -> Result<(), Error> {
  encoded_once := prompt_artifacts.encode_prompt_evaluation_result_bounded(first, 268435456)?
  once_view: str := encoded_once
  decoded := prompt_artifacts.decode_prompt_evaluation_result(once_view)?
  encoded_twice := prompt_artifacts.encode_prompt_evaluation_result_bounded(decoded, 268435456)?
  twice_view: str := encoded_twice
  if once_view != twice_view { return Err(Error.Invalid) }
  // The second document is an independent build of the same value; encoding it must agree too,
  // so a move that corrupted the first build cannot hide behind a shared buffer.
  encoded_again := prompt_artifacts.encode_prompt_evaluation_result_bounded(second, 268435456)?
  again_view: str := encoded_again
  if once_view != again_view { return Err(Error.Invalid) }
  return Ok(())
}

fn smoke_digest(value: str) -> string {
  computed := crypto.sha256(value)
  return encoding.hex_encode(computed[0..computed.len()]).clone()
}

// Seal a document the way the producer does: blank the digest, encode canonically, hash, and
// write the hash back. The result must then satisfy the publish path's own admission check.
fn sealed_digest(value: prompt_artifacts.PromptEvaluationResult) -> Result<string, Error> {
  mut normalized := value
  normalized.content_sha256 = "".clone()
  canonical := prompt_artifacts.encode_prompt_evaluation_result_bounded(normalized, 268435456)?
  canonical_view: str := canonical
  return Ok(smoke_digest(canonical_view))
}

fn source_admits(value: prompt_artifacts.PromptEvaluationResult) -> Result<i64, Error> {
  encoded := prompt_artifacts.encode_prompt_evaluation_result_bounded(value, 268435456)?
  view: str := encoded
  // The publish path's own admission check: decode, re-encode with the digest blanked, and
  // require the recomputed digest to equal the declared one.
  admitted := prompt_artifact_io.decode_prompt_evaluation_result_source(view)?
  return Ok(admitted.rows.len())
}

pub fn main(args: array<str>) -> Result<(), Error> {
  if args.len() != 1 { return Err(Error.Invalid) }

  eligible_result := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, false, false, false)
  eligible_evidence := evidence(true)
  expect_ok(eligible_result, eligible_evidence, 1)?

  fixture_result := complete_result(0, "FIXTURE", "IMPROVED", false, false, false, false, false, false, false)
  fixture_evidence := evidence(true)
  expect_ok(fixture_result, fixture_evidence, 2)?

  unchanged_result := complete_result(1, "LOCAL_OPENAI", "NO_IMPROVEMENT", false, false, false, false, false, false, false)
  unchanged_evidence := evidence(true)
  expect_ok(unchanged_result, unchanged_evidence, 2)?

  regression_result := complete_result(2, "LOCAL_OPENAI", "SERIOUS_REGRESSION", false, false, false, false, false, false, false)
  regression_evidence := evidence(true)
  expect_ok(regression_result, regression_evidence, 2)?

  unverified_result := complete_result(0, "LOCAL_OPENAI", "IMPROVED", false, false, false, false, false, false, false)
  unverified_evidence := evidence(false)
  expect_ok(unverified_result, unverified_evidence, 2)?

  invalid_value := invalid_result()
  invalid_evidence := noncomplete_evidence(false)
  expect_noncomplete(invalid_value, invalid_evidence)?

  error_value := error_result(0)
  error_evidence := noncomplete_evidence(false)
  expect_noncomplete(error_value, error_evidence)?

  adapter_error_value := error_result(1)
  adapter_error_evidence := noncomplete_evidence(false)
  expect_noncomplete(adapter_error_value, adapter_error_evidence)?

  postcheck_error_value := error_result(2)
  postcheck_error_evidence := noncomplete_evidence(false)
  expect_noncomplete(postcheck_error_value, postcheck_error_evidence)?

  workspace_unsafe_value := error_result(3)
  workspace_unsafe_evidence := noncomplete_evidence(false)
  expect_noncomplete(workspace_unsafe_value, workspace_unsafe_evidence)?

  workspace_error_value := error_result(4)
  workspace_error_evidence := noncomplete_evidence(false)
  expect_noncomplete(workspace_error_value, workspace_error_evidence)?

  malformed_preflight_environment := error_result(5)
  malformed_preflight_environment_evidence := noncomplete_evidence(false)
  expect_invalid(malformed_preflight_environment, malformed_preflight_environment_evidence)?

  precheck_drift_value := drift_error_result(false)
  precheck_drift_evidence := retained_evidence(false)
  expect_noncomplete(precheck_drift_value, precheck_drift_evidence)?

  postcheck_drift_value := drift_error_result(true)
  postcheck_drift_evidence := retained_evidence(false)
  expect_noncomplete(postcheck_drift_value, postcheck_drift_evidence)?

  terminal_error_value := retained_error_result(1)
  terminal_error_evidence := retained_evidence(false)
  expect_noncomplete(terminal_error_value, terminal_error_evidence)?

  terminal_error_mismatch := retained_error_result(2)
  terminal_error_mismatch_evidence := retained_evidence(false)
  expect_invalid(terminal_error_mismatch, terminal_error_mismatch_evidence)?

  cleanup_error_value := retained_error_result(0)
  cleanup_error_evidence := retained_evidence(false)
  expect_noncomplete(cleanup_error_value, cleanup_error_evidence)?

  compact_value := compact_result(false)
  compact_evidence := noncomplete_evidence(false)
  expect_noncomplete(compact_value, compact_evidence)?

  status_tamper := complete_result(0, "LOCAL_OPENAI", "NO_IMPROVEMENT", false, false, false, false, false, false, false)
  status_evidence := evidence(true)
  expect_invalid(status_tamper, status_evidence)?

  aggregate_tamper := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, true, false, false, false, false, false)
  aggregate_evidence := evidence(true)
  expect_invalid(aggregate_tamper, aggregate_evidence)?

  reason_tamper := complete_result(2, "LOCAL_OPENAI", "SERIOUS_REGRESSION", false, false, true, false, false, false, false)
  reason_evidence := evidence(true)
  expect_invalid(reason_tamper, reason_evidence)?

  reference_tamper := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, true, false, false, false)
  reference_evidence := evidence(true)
  expect_invalid(reference_tamper, reference_evidence)?

  trace_tamper := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, true, false, false)
  trace_evidence := evidence(true)
  expect_invalid(trace_tamper, trace_evidence)?

  row_tamper := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, false, true, false)
  row_evidence := evidence(true)
  expect_invalid(row_tamper, row_evidence)?

  gate_tamper := complete_result(0, "FIXTURE", "IMPROVED", true, false, false, false, false, false, false)

  tree_digest_tamper := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, false, false, true)
  tree_digest_evidence := evidence(true)
  expect_invalid(tree_digest_tamper, tree_digest_evidence)?
  gate_evidence := evidence(true)
  expect_invalid(gate_tamper, gate_evidence)?

  missing_evidence_result := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, false, false, false)
  missing_evidence := noncomplete_evidence(true)
  expect_invalid(missing_evidence_result, missing_evidence)?

  evidence_order_result := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, false, false, false)
  evidence_order := tampered_evidence(0)
  expect_invalid(evidence_order_result, evidence_order)?

  evidence_duplicate_result := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, false, false, false)
  evidence_duplicate := tampered_evidence(1)
  expect_invalid(evidence_duplicate_result, evidence_duplicate)?

  evidence_digest_result := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, false, false, false)
  evidence_digest := tampered_evidence(2)
  expect_invalid(evidence_digest_result, evidence_digest)?

  result_digest_result := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, false, false, false)
  result_digest_evidence := tampered_evidence(3)
  expect_invalid(result_digest_result, result_digest_evidence)?

  malformed_trust_result := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, false, false, false)
  malformed_trust_evidence := malformed_evidence()
  expect_invalid(malformed_trust_result, malformed_trust_evidence)?

  compact_tamper := compact_result(true)
  compact_tamper_evidence := noncomplete_evidence(false)
  expect_invalid(compact_tamper, compact_tamper_evidence)?

  // --- The two no-row publish paths, at version 2 ---
  // The evaluator emits version 2 for `INVALID_INPUT` and `RESULT_TOO_LARGE` too. These currently
  // pass at version 1 only because their `rows` are empty, which proves nothing about version 2,
  // so both are exercised at the version the producer actually writes, round trip included.
  invalid_v2 := invalid_result_versioned(2)
  invalid_v2_evidence := noncomplete_evidence_versioned(false, 2)
  expect_noncomplete(invalid_v2, invalid_v2_evidence)?
  round_trip_equal(invalid_result_versioned(2), invalid_result_versioned(2))?

  compact_v2 := compact_result_versioned(false, 2)
  compact_v2_evidence := noncomplete_evidence_versioned(false, 2)
  expect_noncomplete(compact_v2, compact_v2_evidence)?
  round_trip_equal(compact_result_versioned(false, 2), compact_result_versioned(false, 2))?

  // A version-1 result may not be paired with version-2 evidence, in either direction.
  split_low := invalid_result_versioned(1)
  split_high_evidence := noncomplete_evidence_versioned(false, 2)
  expect_invalid(split_low, split_high_evidence)?

  // --- Round-trip: the invariant the `Option` row design rests on ---
  // A version-2 document with two-attempt rows must encode, decode, and re-encode byte-identically,
  // and its recomputed `content_sha256` must equal the declared one, or the publish path silently
  // drops a field (Request 52) and every persisted document becomes unverifiable.
  round_trip_equal(complete_result_v2(0), complete_result_v2(0))?
  sealed_repair := sealed_v2(0)?
  if source_admits(sealed_repair)? != 4 { return Err(Error.Invalid) }

  round_trip_equal(
    complete_result(1, "LOCAL_OPENAI", "NO_IMPROVEMENT", false, false, false, false, false, false, false),
    complete_result(1, "LOCAL_OPENAI", "NO_IMPROVEMENT", false, false, false, false, false, false, false),
  )?
  sealed_legacy := sealed_v1()?
  if source_admits(sealed_legacy)? != 4 { return Err(Error.Invalid) }

  // The no-repair shape a task with `maximum_repair_loops: 0` produces, and the shape most rows
  // of the fixed-adapter path take: a version-2 row with a single passing initial attempt.
  no_repair := complete_result_v2(7)
  no_repair_evidence := evidence_v2(7)
  if verdict_code(prompt_score.verify_result(no_repair, no_repair_evidence)?) != 2 {
    return Err(Error.Invalid)
  }
  round_trip_equal(complete_result_v2(7), complete_result_v2(7))?
  sealed_no_repair := sealed_v2(7)?
  if source_admits(sealed_no_repair)? != 4 { return Err(Error.Invalid) }

  // --- C4-REPAIR-MEASURED version-2 cases ---
  // A clean version-2 document: four rows that each fail at attempt one and pass at attempt two,
  // with every repair aggregate recomputed from the attempts rather than read from the document.
  repair_result := complete_result_v2(0)
  repair_evidence := evidence_v2(0)
  expect_ok_v2(repair_result, repair_evidence)?

  // Attempt indices must be dense and ascending from one.
  sparse_attempts := complete_result_v2(1)
  sparse_attempts_evidence := evidence_v2(1)
  expect_invalid(sparse_attempts, sparse_attempts_evidence)?

  // Exactly one initial attempt.
  two_initial := complete_result_v2(2)
  two_initial_evidence := evidence_v2(2)
  expect_invalid(two_initial, two_initial_evidence)?

  // `row.measurement` is byte-equal to the final attempt that ran.
  measurement_drift := complete_result_v2(3)
  measurement_drift_evidence := evidence_v2(3)
  expect_invalid(measurement_drift, measurement_drift_evidence)?

  // The attempt list is bounded by `1 + maximum_repair_loops` before it is walked.
  overlong_attempts := complete_result_v2(4)
  overlong_attempts_evidence := evidence_v2(4)
  expect_invalid(overlong_attempts, overlong_attempts_evidence)?

  // A version-1 row inside a version-2 container is rejected before any field decode.
  mixed_version := complete_result_v2(5)
  mixed_version_evidence := evidence_v2(5)
  expect_invalid(mixed_version, mixed_version_evidence)?

  // The row's own repair count must equal the count of non-skipped repair attempts.
  count_drift := complete_result_v2(6)
  count_drift_evidence := evidence_v2(6)
  expect_invalid(count_drift, count_drift_evidence)?

  // An attempt that ran must attest the trace records its own invocation produced, so that no
  // snapshot request, result, or input snapshot is left unreferenced once a row runs twice.
  untraced := complete_result_v2(8)
  untraced_evidence := evidence_v2(8)
  expect_invalid(untraced, untraced_evidence)?

  // A three-attempt list whose third attempt was skipped: `repair_count` is still 1 and the row's
  // declared count still matches it, so `1 + maximum_repair_loops` is the only bound that rejects
  // it. Without this case, weakening that bound alone leaves every owner test green.
  overlong_with_skip := complete_result_v2(9)
  overlong_with_skip_evidence := evidence_v2(9)
  expect_invalid(overlong_with_skip, overlong_with_skip_evidence)?

  // Two repairs that both ran, against a task whose cap admits three attempts: the structural
  // bound and the declared count both pass, so "at most one repair attempt" is the only rejection.
  two_repairs := complete_result_v2(10)
  two_repairs_evidence := evidence_v2(10)
  expect_invalid(two_repairs, two_repairs_evidence)?

  // A persisted input snapshot that no attestation and no attempt names. Only the universal
  // "no unreferenced trace record" rule rejects it, so this is what keeps that rule honest now
  // that a row's attempts are a second way to reference one.
  unreferenced_trace := complete_result_v2(11)
  unreferenced_trace_evidence := evidence_v2(11)
  expect_invalid(unreferenced_trace, unreferenced_trace_evidence)?

  // An attempt whose trace digest is well formed but resolves to no persisted record of its task.
  // Presence admits it and the real record is still referenced by the attestation, so resolution
  // is the only rule that can reject it.
  unresolved_trace := complete_result_v2(12)
  unresolved_trace_evidence := evidence_v2(12)
  expect_invalid(unresolved_trace, unresolved_trace_evidence)?

  // A task that offers no repair must still admit an adapter document whose own
  // `repair_loop_count` is non-zero: the byte-frozen `scripts/prompt-fixed-adapter.py` emits `1`
  // on its expected-failure path, and at version 2 the row's own count is the authority. This is
  // an acceptance case, and requiring zero unconditionally broke every version-2 publish from the
  // deterministic fixture corpus.
  adapter_repair := complete_result_v2(13)
  adapter_repair_evidence := evidence_v2(13)
  if verdict_code(prompt_score.verify_result(adapter_repair, adapter_repair_evidence)?) != 2 {
    return Err(Error.Invalid)
  }

  // --- C4-REPAIR-EDITSET ------------------------------------------------------------------------

  // Acceptance: a corpus naming the repair adapter, every ran attempt carrying a version-2
  // measurement with a realized edit set, and `EDITSET` among the sections its repair prompt
  // actually carried. `repair_editset_attempt_count` is recomputed here from the attempts and
  // must equal the persisted 4.
  editset_clean := complete_result_v2(14)
  editset_clean_evidence := evidence_v2(14)
  if verdict_code(prompt_score.verify_result(editset_clean, editset_clean_evidence)?) != 2 {
    return Err(Error.Invalid)
  }

  // A version-2 member present at version 1. Absence is required, never defaulted.
  v2_member_at_v1 := complete_result_v2(15)
  v2_member_at_v1_evidence := evidence_v2(15)
  expect_invalid(v2_member_at_v1, v2_member_at_v1_evidence)?

  // Ladder row 11: a corpus naming the repair adapter whose measurements are version 1. The
  // measurement version is a checked function of the corpus, not a producer's choice.
  version_disagrees := complete_result_v2(16)
  version_disagrees_evidence := evidence_v2(16)
  expect_invalid(version_disagrees, version_disagrees_evidence)?

  // A version-2 member absent at version 2: `base_adapter_runtime_identity` is unconditional.
  v2_member_missing := complete_result_v2(17)
  v2_member_missing_evidence := evidence_v2(17)
  expect_invalid(v2_member_missing, v2_member_missing_evidence)?

  // Ladder row 12: an attempt-level probe naming another runtime. The row-level check binds only
  // the final attempt, so without the attempt-level rule this document is admitted.
  attempt_identity := complete_result_v2(18)
  attempt_identity_evidence := evidence_v2(18)
  expect_invalid(attempt_identity, attempt_identity_evidence)?

  // `verifier_measurement_equal` over all 27 fields: the row differs from its final attempt in a
  // version-2 member and in nothing else.
  v2_measurement_drift := complete_result_v2(19)
  v2_measurement_drift_evidence := evidence_v2(19)
  expect_invalid(v2_measurement_drift, v2_measurement_drift_evidence)?

  // Ladder row 14: `edit_set_total_bytes` is the pre-omission sum of `body_bytes`, recomputed.
  editset_total_drift := complete_result_v2(20)
  editset_total_drift_evidence := evidence_v2(20)
  expect_invalid(editset_total_drift, editset_total_drift_evidence)?

  // --- C4-REPAIR-TEMPLATE -----------------------------------------------------------------------

  // Acceptance: a corpus naming the template adapter, every ran attempt carrying a version-3
  // measurement with a refusal code, the completion identity, and the widened `edit_set` rule,
  // with `POLICY` among the sections its repair prompt actually carried. Both new aggregates are
  // recomputed here from the attempts and must equal the persisted values.
  template_clean := complete_result_v2(21)
  template_clean_evidence := evidence_v2(21)
  if verdict_code(prompt_score.verify_result(template_clean, template_clean_evidence)?) != 2 {
    return Err(Error.Invalid)
  }

  // A version-3 member present at version 2. Absence below version 3 is required, never
  // defaulted — the rule that keeps all three merged chains decodable.
  v3_member_at_v2 := complete_result_v2(22)
  v3_member_at_v2_evidence := evidence_v2(22)
  expect_invalid(v3_member_at_v2, v3_member_at_v2_evidence)?

  // Ladder row 16: a corpus naming the template adapter whose measurements are version 2. The
  // measurement version is a checked function of the corpus, three ways.
  v3_version_disagrees := complete_result_v2(23)
  v3_version_disagrees_evidence := evidence_v2(23)
  expect_invalid(v3_version_disagrees, v3_version_disagrees_evidence)?

  // Ladder row 17: `edit_refusal` outside the ten-code vocabulary. The producer's mapping is
  // total, so an unrecognized value means the record and the producer disagree.
  v3_unknown_refusal := complete_result_v2(24)
  v3_unknown_refusal_evidence := evidence_v2(24)
  expect_invalid(v3_unknown_refusal, v3_unknown_refusal_evidence)?

  // The invariant this capability exists to establish: a reproduced-unchanged refusal that
  // discarded the blocks its producer built one line before the raise.
  v3_unchanged_no_blocks := complete_result_v2(25)
  v3_unchanged_no_blocks_evidence := evidence_v2(25)
  expect_invalid(v3_unchanged_no_blocks, v3_unchanged_no_blocks_evidence)?

  // Ladder row 20: a completion excerpt persisted on a code outside the eight for which no
  // structured substitute exists.
  v3_text_unrefused := complete_result_v2(26)
  v3_text_unrefused_evidence := evidence_v2(26)
  expect_invalid(v3_text_unrefused, v3_text_unrefused_evidence)?

  // `verifier_measurement_equal` over all 31 fields: the row differs from its final attempt in a
  // version-3 member and in nothing else.
  v3_measurement_drift := complete_result_v2(27)
  v3_measurement_drift_evidence := evidence_v2(27)
  expect_invalid(v3_measurement_drift, v3_measurement_drift_evidence)?

  // A version-2 document may not be paired with version-1 evidence.
  version_split := complete_result_v2(0)
  version_split_evidence := evidence(true)
  expect_invalid(version_split, version_split_evidence)?

  print("prompt verifier smoke: complete, incomplete, compact, tamper, and repair-attempt cases PASS")
  return Ok(())
}
