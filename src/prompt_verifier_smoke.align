  return prompt_artifacts.PromptEvaluationResult {
    schema_version: version,
    artifact_kind: "PROMPT_EVALUATION_RESULT".clone(),
    evaluation_id: Some("evaluation".clone()),
    status: "INVALID_INPUT".clone(),
    error_code: "INVALID_SCHEMA".clone(),
    error: "invalid request".clone(),
    experiment: Some(reference("PROMPT_EXPERIMENT_RESULT", "experiment", digest_a())),
    experiment_artifact: Some(experiment("LOCAL_OPENAI")),
    parent_activation: Some(reference("PROMPT_ACTIVATION_RESULT", "decision", digest_a())),
    parent_activation_artifact: Some(activation_result("LOCAL_OPENAI")),
    scope: Some(scope("LOCAL_OPENAI")),
    parent_variant: Some(variant(true)),
    candidate_variant: Some(variant(false)),
    corpus_source: Some(reference("PROMPT_EVALUATION_CORPUS", "corpus", digest_a())),
    corpus: Some(corpus()),
    tasks: tasks_array(),
    acceptance_policy_source: Some(reference("PROMPT_ACCEPTANCE_POLICY", "policy", digest_a())),
    acceptance_policy: Some(acceptance_policy()),
    generation_policy_source: Some(reference("GENERATION_POLICY", "generation", digest_a())),
    generation_policy: Some(generation_policy("LOCAL_OPENAI")),
    provider_control_source: Some(reference("EVALUATION_PROVIDER_CONTROL", "provider", digest_a())),
    provider_control: Some(provider_control("LOCAL_OPENAI")),
    workspace_preflight_source: None,
    workspace_preflight_request: None,
    workspace_preflight: None,
    environment: None,
    snapshot_requests: empty_snapshot_requests_array(),
    snapshot_results: empty_snapshot_results_array(),
    input_snapshots: empty_input_snapshots_array(),
    snapshot_attestations: empty_attestations_array(),
    trace_failure: None,
    sample_count: 2,
    gate_eligible: false,
    rows: empty_rows_array(),
    task_aggregates: empty_task_aggregates_array(),
    corpus_aggregate: None,
    serious_regression_reasons: empty_reasons(),
    content_sha256: digest_a(),
  }
}

fn error_result(state: i64) -> prompt_artifacts.PromptEvaluationResult {
  error_code := if state == 1 {
    "ADAPTER_RESULT".clone()
  } else if state == 3 || state == 5 {
    "WORKSPACE_UNSAFE".clone()
  } else if state == 4 {
    "SNAPSHOT_ERROR".clone()
  } else {
    "SNAPSHOT_MISMATCH".clone()
  }
  error_text := if state == 1 {
    "adapter result".clone()
  } else if state == 3 || state == 5 {
    "workspace unsafe".clone()
  } else if state == 4 {
    "snapshot helper error".clone()
  } else {
    "snapshot mismatch".clone()
  }
  return prompt_artifacts.PromptEvaluationResult {
    schema_version: 1,
    artifact_kind: "PROMPT_EVALUATION_RESULT".clone(),
    evaluation_id: Some("evaluation".clone()),
    status: "ERROR".clone(),
    error_code: error_code,
    error: error_text,
    experiment: Some(reference("PROMPT_EXPERIMENT_RESULT", "experiment", digest_a())),
    experiment_artifact: Some(experiment("LOCAL_OPENAI")),
    parent_activation: Some(reference("PROMPT_ACTIVATION_RESULT", "decision", digest_a())),
    parent_activation_artifact: Some(activation_result("LOCAL_OPENAI")),
    scope: Some(scope("LOCAL_OPENAI")),
    parent_variant: Some(variant(true)),
    candidate_variant: Some(variant(false)),
    corpus_source: Some(reference("PROMPT_EVALUATION_CORPUS", "corpus", digest_a())),
    corpus: Some(corpus()),
    tasks: tasks_array(),
    acceptance_policy_source: Some(reference("PROMPT_ACCEPTANCE_POLICY", "policy", digest_a())),
    acceptance_policy: Some(acceptance_policy()),
    generation_policy_source: Some(reference("GENERATION_POLICY", "generation", digest_a())),
    generation_policy: Some(generation_policy("LOCAL_OPENAI")),
    provider_control_source: Some(reference("EVALUATION_PROVIDER_CONTROL", "provider", digest_a())),
    provider_control: Some(provider_control("LOCAL_OPENAI")),
    workspace_preflight_source: Some(reference("WORKSPACE_PREFLIGHT_RESULT", "evaluation", digest_a())),
    workspace_preflight_request: Some(workspace_request()),
    workspace_preflight: if state == 3 || state == 5 {
      Some(workspace_failure_result(true))
    } else if state == 4 {
      Some(workspace_failure_result(false))
    } else {
      Some(workspace_result())
    },
    environment: if state == 2 {
      Some(environment())
    } else if state == 5 {
      Some(malformed_environment())
    } else {
      None
    },
    snapshot_requests: if state >= 3 { empty_snapshot_requests_array() } else { snapshot_requests_array() },
    snapshot_results: error_snapshot_results(state),
    input_snapshots: error_input_snapshots(state),
    snapshot_attestations: failed_attestations_array(state),
    trace_failure: None,
    sample_count: 2,
    gate_eligible: false,
    rows: empty_rows_array(),
    task_aggregates: empty_task_aggregates_array(),
    corpus_aggregate: None,
    serious_regression_reasons: empty_reasons(),
    content_sha256: digest_a(),
  }
}

fn invalid_result() -> prompt_artifacts.PromptEvaluationResult {
  return invalid_result_versioned(1)
}

