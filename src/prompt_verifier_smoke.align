    error: if unsafe_workspace { "workspace unsafe".clone() } else { "snapshot helper error".clone() },
    physical_project_root: "/project".clone(),
    physical_workspace_path: "".clone(),
    environment_probe: None,
    content_sha256: digest_a(),
  }
}

