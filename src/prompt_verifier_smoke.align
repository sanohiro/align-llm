fn mismatch_snapshot_result(content_sha256: str) -> prompt_artifacts.SnapshotResult {
  return prompt_artifacts.SnapshotResult {
    schema_version: 1,
    artifact_kind: "SNAPSHOT_RESULT".clone(),
    task_id: "task".clone(),
    status: "MISMATCH".clone(),
    error_code: "CONTENT".clone(),
    error: "snapshot mismatch".clone(),
    environment_probe: Some(probe("SNAPSHOT_HELPER", "snapshot-runtime")),
    artifact_digests: empty_digests(),
    content_sha256: content_sha256.clone(),
  }
}

fn error_snapshot_results(state: i64) -> array<prompt_artifacts.SnapshotResult> {
  mut values: array_builder<prompt_artifacts.SnapshotResult> := array_builder()
  if state >= 3 {
    return values.build()
  }
  if state == 0 {
    values.push(mismatch_snapshot_result(digest_a()))
  } else {
    values.push(snapshot_result())
    if state == 2 { values.push(mismatch_snapshot_result(digest_b())) }
  }
  return values.build()
}

fn error_input_snapshots(state: i64) -> array<prompt_artifacts.TaskInputSnapshot> {
  mut values: array_builder<prompt_artifacts.TaskInputSnapshot> := array_builder()
  if state != 0 && state < 3 { values.push(input_snapshot()) }
  return values.build()
}

fn failed_attestation(state: i64) -> prompt_artifacts.RunSnapshotAttestation {
  status := if state == 0 {
    "PRECHECK_FAILED".clone()
  } else if state == 1 {
    "ADAPTER_FAILED".clone()
  } else {
    "POSTCHECK_FAILED".clone()
  }
  error_code := if state == 1 { "ADAPTER_RESULT".clone() } else { "SNAPSHOT_MISMATCH".clone() }
  error_text := if state == 1 { "adapter result".clone() } else { "snapshot mismatch".clone() }
  return prompt_artifacts.RunSnapshotAttestation {
    schema_version: 1,
    artifact_kind: "RUN_SNAPSHOT_ATTESTATION".clone(),
    task_id: "task".clone(),
    sample_index: 1,
    variant: "PARENT".clone(),
    status: status,
    error_code: error_code,
    error: error_text,
    snapshot_request_sha256: digest_a(),
    before_snapshot_result_sha256: digest_a(),
    after_snapshot_result_sha256: if state == 2 { Some(digest_b()) } else { None },
    before_input_snapshot_sha256: if state == 0 { None } else { Some(digest_a()) },
    after_input_snapshot_sha256: None,
    content_sha256: digest_a(),
  }
}

fn failed_attestations_array(state: i64) -> array<prompt_artifacts.RunSnapshotAttestation> {
  mut values: array_builder<prompt_artifacts.RunSnapshotAttestation> := array_builder()
  if state < 3 { values.push(failed_attestation(state)) }
  return values.build()
}

fn trace_overflow(oversized: bool) -> prompt_artifacts.PromptTraceOverflow {
  return prompt_artifacts.PromptTraceOverflow {
    schema_version: 1,
    artifact_kind: "PROMPT_TRACE_OVERFLOW".clone(),
    attempted_invocation_count: if oversized { 2_049 } else { 2_048 },
    trace_record_count: 16_384,
    trace_digest_sha256: digest_a(),
    content_sha256: digest_a(),
  }
}

fn complete_result(
  mode: i64,
  provider_kind: str,
  status: str,
  gate_eligible: bool,
  tamper_aggregate: bool,
  tamper_reason: bool,
  tamper_reference: bool,
  tamper_trace: bool,
  tamper_row_identity: bool,
  tamper_tree_digest: bool,
) -> prompt_artifacts.PromptEvaluationResult {
  return prompt_artifacts.PromptEvaluationResult {
    schema_version: 1,
    artifact_kind: "PROMPT_EVALUATION_RESULT".clone(),
    evaluation_id: Some("evaluation".clone()),
    status: status.clone(),
    error_code: "NONE".clone(),
    error: "".clone(),
    experiment: Some(reference(
        "PROMPT_EXPERIMENT_RESULT",
        "experiment",
        if tamper_reference { digest_b() } else { digest_a() },
      )),
    experiment_artifact: Some(experiment(provider_kind)),
    parent_activation: Some(reference("PROMPT_ACTIVATION_RESULT", "decision", digest_a())),
    parent_activation_artifact: Some(activation_result(provider_kind)),
    scope: Some(scope(provider_kind)),
    parent_variant: Some(variant(true)),
    candidate_variant: Some(variant(false)),
    corpus_source: Some(reference("PROMPT_EVALUATION_CORPUS", "corpus", digest_a())),
    corpus: Some(corpus()),
    tasks: tasks_array(),
    acceptance_policy_source: Some(reference("PROMPT_ACCEPTANCE_POLICY", "policy", digest_a())),
    acceptance_policy: Some(acceptance_policy()),
    generation_policy_source: Some(reference("GENERATION_POLICY", "generation", digest_a())),
    generation_policy: Some(generation_policy(provider_kind)),
    provider_control_source: Some(reference("EVALUATION_PROVIDER_CONTROL", "provider", digest_a())),
    provider_control: Some(provider_control(provider_kind)),
    workspace_preflight_source: Some(reference("WORKSPACE_PREFLIGHT_RESULT", "evaluation", digest_a())),
    workspace_preflight_request: Some(workspace_request()),
    workspace_preflight: Some(workspace_result()),
    environment: Some(environment()),
    snapshot_requests: snapshot_requests_array(),
    snapshot_results: if tamper_tree_digest {
      snapshot_results_with_wrong_tree_digest()
    } else {
      snapshot_results_array()
    },
    input_snapshots: input_snapshots_array(),
    snapshot_attestations: attestations(tamper_trace),
    trace_failure: None,
    sample_count: 2,
    gate_eligible: gate_eligible,
    rows: rows(mode, provider_kind, tamper_row_identity),
    task_aggregates: task_aggregates_array(mode, tamper_aggregate),
    corpus_aggregate: Some(corpus_aggregate(mode, tamper_aggregate)),
    serious_regression_reasons: reasons(mode, tamper_reason),
    content_sha256: digest_a(),
  }
}

