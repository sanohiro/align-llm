  seed := 7
  return prompt_artifacts.TaskMeasurement {
    schema_version: 1,
    artifact_kind: "TASK_MEASUREMENT".clone(),
    status: "ERROR".clone(),
    failure_kind: "ADAPTER".clone(),
    build_status: "NOT_RUN".clone(),
    test_status: "NOT_RUN".clone(),
    repair_loop_count: 0,
    unrelated_diff_count: 0,
    patch_size_bytes: 0,
    public_api_change_count: 0,
    policy_violation_count: 0,
    cleanup_passed: true,
    containment_passed: true,
    benchmark_regression_ppm: None,
    generation_to_passing_patch_ns: None,
    rendered_prompt_sha256: digest_a(),
    generation_request: generation_request(seed),
    environment_probe: probe("MEASUREMENT_ADAPTER", "runtime"),
    seed_attestation: seed_attestation("LOCAL_OPENAI", seed),
    diagnostic_summary: "adapter error".clone(),
    diagnostic_stdout: "".clone(),
    diagnostic_stderr: "".clone(),
    content_sha256: digest_a(),
  }
}

fn retained_row(terminal: bool) -> prompt_artifacts.PromptTaskRow {
  if !terminal { return row(1, true, true, "LOCAL_OPENAI", false) }
  return prompt_artifacts.PromptTaskRow {
    schema_version: 1,
    artifact_kind: "PROMPT_TASK_ROW".clone(),
    evaluation_id: "evaluation".clone(),
    task_id: "task".clone(),
    sample_index: 1,
    variant: "PARENT".clone(),
    variant_id: "parent".clone(),
    variant_sha256: digest_b(),
    prompt_preparation_ns: 10,
    time_to_passing_patch_ns: None,
    evaluation_input: evaluation_input(1, 7),
    measurement: terminal_measurement(),
    content_sha256: digest_a(),
  }
}

fn retained_rows(terminal: bool) -> array<prompt_artifacts.PromptTaskRow> {
  mut values: array_builder<prompt_artifacts.PromptTaskRow> := array_builder()
  values.push(retained_row(terminal))
  return values.build()
}

