fn drift_failed_attestation(postcheck: bool) -> prompt_artifacts.RunSnapshotAttestation {
  return prompt_artifacts.RunSnapshotAttestation {
    schema_version: 1,
    artifact_kind: "RUN_SNAPSHOT_ATTESTATION".clone(),
    task_id: "task".clone(),
    sample_index: 1,
    variant: "CANDIDATE".clone(),
    status: if postcheck { "POSTCHECK_DRIFT".clone() } else { "PRECHECK_DRIFT".clone() },
    error_code: "INPUT_DRIFT".clone(),
    error: "input drift".clone(),
    snapshot_request_sha256: digest_a(),
    before_snapshot_result_sha256: digest_a(),
    after_snapshot_result_sha256: if postcheck { Some(digest_a()) } else { None },
    before_input_snapshot_sha256: if postcheck { Some(digest_a()) } else { Some(digest_b()) },
    after_input_snapshot_sha256: if postcheck { Some(digest_b()) } else { None },
    content_sha256: digest_b(),
  }
}

fn drift_attestations(postcheck: bool) -> array<prompt_artifacts.RunSnapshotAttestation> {
  mut values: array_builder<prompt_artifacts.RunSnapshotAttestation> := array_builder()
  values.push(attestation(1, true))
  values.push(drift_failed_attestation(postcheck))
  return values.build()
}

fn retained_evidence(verified: bool) -> prompt_artifacts.PromptEvaluationEvidence {
  mut inputs: array_builder<prompt_artifacts.PromptExpectedInputDigest> := array_builder()
  inputs.push(expected_input(1, true, false))
  return prompt_artifacts.PromptEvaluationEvidence {
    schema_version: 1,
    artifact_kind: "PROMPT_EVALUATION_EVIDENCE".clone(),
    evaluation_id: "evaluation".clone(),
    evaluation_result_sha256: digest_a(),
    trust: trust(verified),
    expected_inputs: inputs.build(),
    content_sha256: digest_a(),
  }
}

fn retained_error_result(mode: i64) -> prompt_artifacts.PromptEvaluationResult {
  terminal := mode != 0
  error_code := if mode == 2 {
    "ARITHMETIC".clone()
  } else if terminal {
    "ADAPTER_RESULT".clone()
  } else {
    "CLEANUP_FAILED".clone()
  }
  error_text := if mode == 2 {
    "arithmetic".clone()
  } else if terminal {
    "adapter result".clone()
  } else {
    "cleanup failed".clone()
  }
  return prompt_artifacts.PromptEvaluationResult {
    schema_version: 1,
    artifact_kind: "PROMPT_EVALUATION_RESULT".clone(),
    evaluation_id: Some("evaluation".clone()),
    status: "ERROR".clone(),
    error_code: error_code,
    error: error_text,
    experiment: Some(reference("PROMPT_EXPERIMENT_RESULT", "experiment", digest_a())),
    experiment_artifact: Some(experiment("LOCAL_OPENAI")),
    parent_activation: Some(reference("PROMPT_ACTIVATION_RESULT", "decision", digest_a())),
    parent_activation_artifact: Some(activation_result("LOCAL_OPENAI")),
    scope: Some(scope("LOCAL_OPENAI")),
    parent_variant: Some(variant(true)),
    candidate_variant: Some(variant(false)),
    corpus_source: Some(reference("PROMPT_EVALUATION_CORPUS", "corpus", digest_a())),
    corpus: Some(corpus()),
    tasks: tasks_array(),
    acceptance_policy_source: Some(reference("PROMPT_ACCEPTANCE_POLICY", "policy", digest_a())),
    acceptance_policy: Some(acceptance_policy()),
    generation_policy_source: Some(reference("GENERATION_POLICY", "generation", digest_a())),
    generation_policy: Some(generation_policy("LOCAL_OPENAI")),
    provider_control_source: Some(reference("EVALUATION_PROVIDER_CONTROL", "provider", digest_a())),
    provider_control: Some(provider_control("LOCAL_OPENAI")),
    workspace_preflight_source: Some(reference("WORKSPACE_PREFLIGHT_RESULT", "evaluation", digest_a())),
    workspace_preflight_request: Some(workspace_request()),
    workspace_preflight: Some(workspace_result()),
    environment: Some(environment()),
    snapshot_requests: snapshot_requests_array(),
    snapshot_results: snapshot_results_array(),
    input_snapshots: input_snapshots_array(),
    snapshot_attestations: retained_attestations(),
    trace_failure: None,
    sample_count: 2,
    gate_eligible: false,
    rows: retained_rows(terminal),
    task_aggregates: empty_task_aggregates_array(),
    corpus_aggregate: None,
    serious_regression_reasons: empty_reasons(),
    content_sha256: digest_a(),
  }
}

fn drift_error_result(postcheck: bool) -> prompt_artifacts.PromptEvaluationResult {
  return prompt_artifacts.PromptEvaluationResult {
    schema_version: 1,
    artifact_kind: "PROMPT_EVALUATION_RESULT".clone(),
    evaluation_id: Some("evaluation".clone()),
    status: "ERROR".clone(),
    error_code: "INPUT_DRIFT".clone(),
    error: "input drift".clone(),
    experiment: Some(reference("PROMPT_EXPERIMENT_RESULT", "experiment", digest_a())),
    experiment_artifact: Some(experiment("LOCAL_OPENAI")),
    parent_activation: Some(reference("PROMPT_ACTIVATION_RESULT", "decision", digest_a())),
    parent_activation_artifact: Some(activation_result("LOCAL_OPENAI")),
    scope: Some(scope("LOCAL_OPENAI")),
    parent_variant: Some(variant(true)),
    candidate_variant: Some(variant(false)),
    corpus_source: Some(reference("PROMPT_EVALUATION_CORPUS", "corpus", digest_a())),
    corpus: Some(corpus()),
    tasks: tasks_array(),
    acceptance_policy_source: Some(reference("PROMPT_ACCEPTANCE_POLICY", "policy", digest_a())),
    acceptance_policy: Some(acceptance_policy()),
    generation_policy_source: Some(reference("GENERATION_POLICY", "generation", digest_a())),
    generation_policy: Some(generation_policy("LOCAL_OPENAI")),
    provider_control_source: Some(reference("EVALUATION_PROVIDER_CONTROL", "provider", digest_a())),
    provider_control: Some(provider_control("LOCAL_OPENAI")),
    workspace_preflight_source: Some(reference("WORKSPACE_PREFLIGHT_RESULT", "evaluation", digest_a())),
    workspace_preflight_request: Some(workspace_request()),
    workspace_preflight: Some(workspace_result()),
    environment: Some(environment()),
    snapshot_requests: snapshot_requests_array(),
    snapshot_results: snapshot_results_array(),
    input_snapshots: drift_input_snapshots(),
    snapshot_attestations: drift_attestations(postcheck),
    trace_failure: None,
    sample_count: 2,
    gate_eligible: false,
    rows: retained_rows(false),
    task_aggregates: empty_task_aggregates_array(),
    corpus_aggregate: None,
    serious_regression_reasons: empty_reasons(),
    content_sha256: digest_a(),
  }
}

fn verdict_code(value: prompt_score.PromptScoreStatus) -> i64 {
  return match value {
    ImprovedEligible => 1,
    CompleteIneligible => 2,
    NoncompleteError => 3,
  }
}

fn expect_ok(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  borrow evidence_value: prompt_artifacts.PromptEvaluationEvidence,
  expected: i64,
) -> Result<(), Error> {
  verdict := prompt_score.verify_result(result, evidence_value)?
  if verdict_code(verdict) != expected || result.rows.len() != 4 || evidence_value.expected_inputs.len() != 4 {
    return Err(Error.Invalid)
  }
  return Ok(())
}

fn expect_invalid(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  borrow evidence_value: prompt_artifacts.PromptEvaluationEvidence,
) -> Result<(), Error> {
  return match prompt_score.verify_result(result, evidence_value) {
    Ok(_) => Err(Error.Invalid),
    Err(_) => Ok(()),
  }
}

fn expect_noncomplete(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  borrow evidence_value: prompt_artifacts.PromptEvaluationEvidence,
) -> Result<(), Error> {
  verdict := prompt_score.verify_result(result, evidence_value)?
  if verdict_code(verdict) != 3 ||
  match result.evaluation_id { None => true, Some(value) => value != evidence_value.evaluation_id } {
    return Err(Error.Invalid)
  }
  return Ok(())
}

pub fn main(args: array<str>) -> Result<(), Error> {
  if args.len() != 1 { return Err(Error.Invalid) }

  eligible_result := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, false, false, false)
  eligible_evidence := evidence(true)
  expect_ok(eligible_result, eligible_evidence, 1)?

  fixture_result := complete_result(0, "FIXTURE", "IMPROVED", false, false, false, false, false, false, false)
  fixture_evidence := evidence(true)
  expect_ok(fixture_result, fixture_evidence, 2)?

  unchanged_result := complete_result(1, "LOCAL_OPENAI", "NO_IMPROVEMENT", false, false, false, false, false, false, false)
  unchanged_evidence := evidence(true)
  expect_ok(unchanged_result, unchanged_evidence, 2)?

  regression_result := complete_result(2, "LOCAL_OPENAI", "SERIOUS_REGRESSION", false, false, false, false, false, false, false)
  regression_evidence := evidence(true)
  expect_ok(regression_result, regression_evidence, 2)?

  unverified_result := complete_result(0, "LOCAL_OPENAI", "IMPROVED", false, false, false, false, false, false, false)
  unverified_evidence := evidence(false)
  expect_ok(unverified_result, unverified_evidence, 2)?

  invalid_value := invalid_result()
  invalid_evidence := noncomplete_evidence(false)
  expect_noncomplete(invalid_value, invalid_evidence)?

  error_value := error_result(0)
  error_evidence := noncomplete_evidence(false)
  expect_noncomplete(error_value, error_evidence)?

  adapter_error_value := error_result(1)
  adapter_error_evidence := noncomplete_evidence(false)
  expect_noncomplete(adapter_error_value, adapter_error_evidence)?

  postcheck_error_value := error_result(2)
  postcheck_error_evidence := noncomplete_evidence(false)
  expect_noncomplete(postcheck_error_value, postcheck_error_evidence)?

  workspace_unsafe_value := error_result(3)
  workspace_unsafe_evidence := noncomplete_evidence(false)
  expect_noncomplete(workspace_unsafe_value, workspace_unsafe_evidence)?

  workspace_error_value := error_result(4)
  workspace_error_evidence := noncomplete_evidence(false)
  expect_noncomplete(workspace_error_value, workspace_error_evidence)?

  malformed_preflight_environment := error_result(5)
  malformed_preflight_environment_evidence := noncomplete_evidence(false)
  expect_invalid(malformed_preflight_environment, malformed_preflight_environment_evidence)?

  precheck_drift_value := drift_error_result(false)
  precheck_drift_evidence := retained_evidence(false)
  expect_noncomplete(precheck_drift_value, precheck_drift_evidence)?

  postcheck_drift_value := drift_error_result(true)
  postcheck_drift_evidence := retained_evidence(false)
  expect_noncomplete(postcheck_drift_value, postcheck_drift_evidence)?

  terminal_error_value := retained_error_result(1)
  terminal_error_evidence := retained_evidence(false)
  expect_noncomplete(terminal_error_value, terminal_error_evidence)?

  terminal_error_mismatch := retained_error_result(2)
  terminal_error_mismatch_evidence := retained_evidence(false)
  expect_invalid(terminal_error_mismatch, terminal_error_mismatch_evidence)?

  cleanup_error_value := retained_error_result(0)
  cleanup_error_evidence := retained_evidence(false)
  expect_noncomplete(cleanup_error_value, cleanup_error_evidence)?

  compact_value := compact_result(false)
  compact_evidence := noncomplete_evidence(false)
  expect_noncomplete(compact_value, compact_evidence)?

  status_tamper := complete_result(0, "LOCAL_OPENAI", "NO_IMPROVEMENT", false, false, false, false, false, false, false)
  status_evidence := evidence(true)
  expect_invalid(status_tamper, status_evidence)?

  aggregate_tamper := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, true, false, false, false, false, false)
  aggregate_evidence := evidence(true)
  expect_invalid(aggregate_tamper, aggregate_evidence)?

  reason_tamper := complete_result(2, "LOCAL_OPENAI", "SERIOUS_REGRESSION", false, false, true, false, false, false, false)
  reason_evidence := evidence(true)
  expect_invalid(reason_tamper, reason_evidence)?

  reference_tamper := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, true, false, false, false)
  reference_evidence := evidence(true)
  expect_invalid(reference_tamper, reference_evidence)?

  trace_tamper := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, true, false, false)
  trace_evidence := evidence(true)
  expect_invalid(trace_tamper, trace_evidence)?

  row_tamper := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, false, true, false)
  row_evidence := evidence(true)
  expect_invalid(row_tamper, row_evidence)?

  gate_tamper := complete_result(0, "FIXTURE", "IMPROVED", true, false, false, false, false, false, false)

  tree_digest_tamper := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, false, false, true)
  tree_digest_evidence := evidence(true)
  expect_invalid(tree_digest_tamper, tree_digest_evidence)?
  gate_evidence := evidence(true)
  expect_invalid(gate_tamper, gate_evidence)?

  missing_evidence_result := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, false, false, false)
  missing_evidence := noncomplete_evidence(true)
  expect_invalid(missing_evidence_result, missing_evidence)?

  evidence_order_result := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, false, false, false)
  evidence_order := tampered_evidence(0)
  expect_invalid(evidence_order_result, evidence_order)?

  evidence_duplicate_result := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, false, false, false)
  evidence_duplicate := tampered_evidence(1)
  expect_invalid(evidence_duplicate_result, evidence_duplicate)?

  evidence_digest_result := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, false, false, false)
  evidence_digest := tampered_evidence(2)
  expect_invalid(evidence_digest_result, evidence_digest)?

  result_digest_result := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, false, false, false)
  result_digest_evidence := tampered_evidence(3)
  expect_invalid(result_digest_result, result_digest_evidence)?

  malformed_trust_result := complete_result(0, "LOCAL_OPENAI", "IMPROVED", true, false, false, false, false, false, false)
  malformed_trust_evidence := malformed_evidence()
  expect_invalid(malformed_trust_result, malformed_trust_evidence)?

  compact_tamper := compact_result(true)
  compact_tamper_evidence := noncomplete_evidence(false)
  expect_invalid(compact_tamper, compact_tamper_evidence)?

  print("prompt verifier smoke: complete, incomplete, compact, and tamper cases PASS")
  return Ok(())
}
