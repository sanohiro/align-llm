    minimum_samples_per_variant: 2,
    minimum_completion_gain_count: 1,
    minimum_time_improvement_ppm: 50_000,
    maximum_time_regression_ppm: 100_000,
    maximum_repair_loop_regression_count: 0,
    content_sha256: digest_a(),
  }
}

