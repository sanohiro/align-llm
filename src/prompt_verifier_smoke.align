    system_text_sha256: digest_a(),
    user_text_sha256: digest_a(),
    generation_policy_sha256: digest_a(),
    provider_control_sha256: digest_a(),
    environment_policy_sha256: digest_a(),
    max_tokens: 1_024,
    temperature_micros: 0,
    paired_seed: seed,
    provider_request_sha256: digest_a(),
    seed_attestation_sha256: digest_a(),
    content_sha256: digest_a(),
  }
}

fn seed_attestation(provider_kind: str, seed: i64) -> prompt_artifacts.SeedCapabilityAttestation {
  return prompt_artifacts.SeedCapabilityAttestation {
    schema_version: 1,
    artifact_kind: "SEED_CAPABILITY_ATTESTATION".clone(),
    provider_kind: provider_kind.clone(),
    provider_model: "model".clone(),
    requested_seed: seed,
    result: "APPLIED".clone(),
    applied_seed: Some(seed),
    provider_request_sha256: digest_a(),
    content_sha256: digest_a(),
  }
}

fn evaluation_input(sample: i64, seed: i64) -> prompt_artifacts.EvaluationInputIdentity {
  return prompt_artifacts.EvaluationInputIdentity {
    schema_version: 1,
    artifact_kind: "EVALUATION_INPUT_IDENTITY".clone(),
    task_id: "task".clone(),
    task_input_snapshot_sha256: digest_a(),
    parent_variant_sha256: digest_b(),
    candidate_variant_sha256: digest_c(),
    task_prompt_sha256: digest_a(),
    context_sources_sha256: digest_a(),
    generation_policy_sha256: digest_a(),
    generation_request_sha256: digest_a(),
    adapter_request_sha256: digest_a(),
    environment_policy_sha256: digest_a(),
    environment_sha256: digest_a(),
    sample_index: sample,
    paired_seed: seed,
    content_sha256: digest_a(),
  }
}

fn measurement(passing: bool, provider_kind: str, seed: i64) -> prompt_artifacts.TaskMeasurement {
  return prompt_artifacts.TaskMeasurement {
    schema_version: 1,
    artifact_kind: "TASK_MEASUREMENT".clone(),
    status: if passing { "PASS".clone() } else { "FAIL".clone() },
    failure_kind: if passing { "NONE".clone() } else { "PATCH".clone() },
    build_status: if passing { "PASS".clone() } else { "NOT_RUN".clone() },
    test_status: if passing { "PASS".clone() } else { "NOT_RUN".clone() },
    repair_loop_count: 0,
    unrelated_diff_count: 0,
    patch_size_bytes: 10,
    public_api_change_count: 0,
    policy_violation_count: 0,
    cleanup_passed: true,
    containment_passed: true,
    benchmark_regression_ppm: None,
    generation_to_passing_patch_ns: if passing { Some(90) } else { None },
    rendered_prompt_sha256: digest_a(),
    generation_request: generation_request(seed),
    environment_probe: probe("MEASUREMENT_ADAPTER", "runtime"),
    seed_attestation: seed_attestation(provider_kind, seed),
    diagnostic_summary: "".clone(),
    diagnostic_stdout: "".clone(),
    diagnostic_stderr: "".clone(),
    edit_set: None,
    edit_set_total_bytes: None,
    patch_sha256: None,
    base_adapter_runtime_identity: None,
    edit_refusal: None,
    completion_bytes: None,
    completion_sha256: None,
    completion_text: None,
    content_sha256: digest_a(),
  }
}

fn row(
  sample: i64,
  parent: bool,
  passing: bool,
  provider_kind: str,
  stale_variant: bool,
) -> prompt_artifacts.PromptTaskRow {
  seed := 6 + sample
  return prompt_artifacts.PromptTaskRow {
    schema_version: 1,
    artifact_kind: "PROMPT_TASK_ROW".clone(),
    evaluation_id: "evaluation".clone(),
    task_id: "task".clone(),
    sample_index: sample,
    variant: if parent { "PARENT".clone() } else { "CANDIDATE".clone() },
    variant_id: if stale_variant { "stale".clone() } else if parent { "parent".clone() } else { "candidate".clone() },
    variant_sha256: if parent { digest_b() } else { digest_c() },
    prompt_preparation_ns: 10,
    repair_loop_count: None,
    generation_to_passing_patch_ns: None,
    time_to_passing_patch_ns: if passing { Some(100) } else { None },
    attempts: None,
    evaluation_input: evaluation_input(sample, seed),
    measurement: measurement(passing, provider_kind, seed),
    content_sha256: digest_a(),
  }
}

fn attestation(sample: i64, parent: bool) -> prompt_artifacts.RunSnapshotAttestation {
  return prompt_artifacts.RunSnapshotAttestation {
    schema_version: 1,
    artifact_kind: "RUN_SNAPSHOT_ATTESTATION".clone(),
    task_id: "task".clone(),
    sample_index: sample,
    variant: if parent { "PARENT".clone() } else { "CANDIDATE".clone() },
    status: "COMPLETE".clone(),
    error_code: "NONE".clone(),
    error: "".clone(),
    snapshot_request_sha256: digest_a(),
    before_snapshot_result_sha256: digest_a(),
    after_snapshot_result_sha256: Some(digest_a()),
    before_input_snapshot_sha256: Some(digest_a()),
    after_input_snapshot_sha256: Some(digest_a()),
    content_sha256: digest_a(),
  }
}

fn rows(mode: i64, provider_kind: str, stale_variant: bool) -> array<prompt_artifacts.PromptTaskRow> {
  parent_one := mode != 0
  candidate_one := mode != 2
  mut values: array_builder<prompt_artifacts.PromptTaskRow> := array_builder()
  values.push(row(1, true, parent_one, provider_kind, stale_variant))
  values.push(row(1, false, candidate_one, provider_kind, false))
  values.push(row(2, false, true, provider_kind, false))
  values.push(row(2, true, true, provider_kind, false))
  return values.build()
}

fn attestations(stale_schedule: bool) -> array<prompt_artifacts.RunSnapshotAttestation> {
  mut values: array_builder<prompt_artifacts.RunSnapshotAttestation> := array_builder()
  values.push(attestation(if stale_schedule { 2 } else { 1 }, true))
  values.push(attestation(1, false))
  values.push(attestation(2, false))
  values.push(attestation(2, true))
  return values.build()
}

fn task_aggregate(mode: i64, tamper: bool) -> prompt_artifacts.TaskAggregate {
  parent_pass := if mode == 0 { 1 } else { 2 }
  candidate_base := if mode == 2 { 1 } else { 2 }
  candidate_pass := if tamper { candidate_base + 1 } else { candidate_base }
  paired := if mode == 1 { 2 } else { 1 }
  return prompt_artifacts.TaskAggregate {
    task_id: "task".clone(),
    parent_pass_count: parent_pass,
    candidate_pass_count: candidate_pass,
    parent_repair_loop_count: 0,
    candidate_repair_loop_count: 0,
    paired_pass_count: paired,
    parent_paired_median_time_ns: Some(100),
    candidate_paired_median_time_ns: Some(100),
    time_improvement_ppm: Some(0),
    time_regression_ppm: Some(0),
    parent_repair_attempt_count: None,
    candidate_repair_attempt_count: None,
    parent_repair_recovery_count: None,
    candidate_repair_recovery_count: None,
    repair_recovery_paired: None,
    parent_repair_editset_attempt_count: None,
    candidate_repair_editset_attempt_count: None,
    parent_edit_refusal_count: None,
    candidate_edit_refusal_count: None,
  }
}

fn corpus_aggregate(mode: i64, tamper: bool) -> prompt_artifacts.CorpusAggregate {
  aggregate_value := task_aggregate(mode, tamper)
  return prompt_artifacts.CorpusAggregate {
    task_count: 1,
    sample_count: 2,
    parent_pass_count: aggregate_value.parent_pass_count,
    candidate_pass_count: aggregate_value.candidate_pass_count,
    parent_repair_loop_count: 0,
    candidate_repair_loop_count: 0,
    paired_pass_count: aggregate_value.paired_pass_count,
    parent_paired_median_time_ns: Some(100),
    candidate_paired_median_time_ns: Some(100),
    completion_gain_count: aggregate_value.candidate_pass_count - aggregate_value.parent_pass_count,
    time_improvement_ppm: Some(0),
    time_regression_ppm: Some(0),
    repair_loop_regression_count: 0,
    repair_attempt_count: None,
    repair_recovery_count: None,
    repair_recovery_paired_count: None,
    repair_editset_attempt_count: None,
    edit_refusal_count: None,
  }
}

fn empty_reasons() -> array<prompt_artifacts.RegressionReason> {
  values: array_builder<prompt_artifacts.RegressionReason> := array_builder()
  return values.build()
}

fn reasons(mode: i64, tamper: bool) -> array<prompt_artifacts.RegressionReason> {
  if mode != 2 { return empty_reasons() }
  mut values: array_builder<prompt_artifacts.RegressionReason> := array_builder()
  values.push(prompt_artifacts.RegressionReason {
      task_id: "task".clone(),
      sample_index: 1,
      code: if tamper { "TIME".clone() } else { "PASS_TO_FAIL".clone() },
      parent_value: "PASS".clone(),
      candidate_value: "FAIL".clone(),
      limit: "NONE".clone(),
    })
  values.push(prompt_artifacts.RegressionReason {
      task_id: "task".clone(),
      sample_index: 1,
      code: "BUILD".clone(),
      parent_value: "PASS".clone(),
      candidate_value: "FAIL".clone(),
      limit: "NONE".clone(),
    })
  values.push(prompt_artifacts.RegressionReason {
      task_id: "task".clone(),
      sample_index: 1,
      code: "TEST".clone(),
      parent_value: "PASS".clone(),
      candidate_value: "FAIL".clone(),
      limit: "NONE".clone(),
    })
  return values.build()
}

fn expected_input(sample: i64, parent: bool, tamper: bool) -> prompt_artifacts.PromptExpectedInputDigest {
  return prompt_artifacts.PromptExpectedInputDigest {
    schema_version: 1,
    artifact_kind: "PROMPT_EXPECTED_INPUT_DIGEST".clone(),
    task_id: "task".clone(),
    sample_index: sample,
    variant: if parent { "PARENT".clone() } else { "CANDIDATE".clone() },
    attempt_index: None,
    rendered_prompt_sha256: if tamper { digest_b() } else { digest_a() },
    context_sources_sha256: digest_a(),
    generation_request_sha256: digest_a(),
    adapter_request_sha256: digest_a(),
    provider_request_sha256: digest_a(),
    content_sha256: digest_a(),
  }
}

fn expected_inputs() -> array<prompt_artifacts.PromptExpectedInputDigest> {
  mut values: array_builder<prompt_artifacts.PromptExpectedInputDigest> := array_builder()
  values.push(expected_input(1, true, false))
  values.push(expected_input(1, false, false))
  values.push(expected_input(2, false, false))
  values.push(expected_input(2, true, false))
  return values.build()
}

fn tampered_expected_inputs(mode: i64) -> array<prompt_artifacts.PromptExpectedInputDigest> {
  mut values: array_builder<prompt_artifacts.PromptExpectedInputDigest> := array_builder()
  if mode == 0 {
    values.push(expected_input(1, false, false))
    values.push(expected_input(1, true, false))
  } else if mode == 1 {
    values.push(expected_input(1, true, false))
    values.push(expected_input(1, true, false))
  } else {
    values.push(expected_input(1, true, true))
    values.push(expected_input(1, false, false))
  }
  values.push(expected_input(2, false, false))
  values.push(expected_input(2, true, false))
  return values.build()
}

fn trust(verified: bool) -> prompt_artifacts.PromptVerifierTrust {
  reachability := if verified { "VERIFIED".clone() } else { "UNVERIFIED".clone() }
  return prompt_artifacts.PromptVerifierTrust {
    schema_version: 1,
    artifact_kind: "PROMPT_VERIFIER_TRUST".clone(),
    expected_align_llm_commit: digest_a(),
    expected_align_revision: digest_a(),
    expected_corpus_source_kind: "GIT_COMMIT".clone(),
    expected_corpus_source_repository_id: "corpus-repository".clone(),
    expected_corpus_source_sha256: digest_a(),
    align_llm_reachability: reachability.clone(),
    align_llm_observed_head: if verified { Some(digest_a()) } else { None },
    align_reachability: reachability.clone(),
    align_observed_revision: if verified { Some(digest_a()) } else { None },
    corpus_reachability: reachability,
    corpus_observed_source_sha256: if verified { Some(digest_a()) } else { None },
    content_sha256: digest_a(),
  }
}

fn evidence(verified: bool) -> prompt_artifacts.PromptEvaluationEvidence {
  return prompt_artifacts.PromptEvaluationEvidence {
    schema_version: 1,
    artifact_kind: "PROMPT_EVALUATION_EVIDENCE".clone(),
    evaluation_id: "evaluation".clone(),
    evaluation_result_sha256: digest_a(),
    trust: trust(verified),
    expected_inputs: expected_inputs(),
    content_sha256: digest_a(),
  }
}

fn tampered_evidence(mode: i64) -> prompt_artifacts.PromptEvaluationEvidence {
  return prompt_artifacts.PromptEvaluationEvidence {
    schema_version: 1,
    artifact_kind: "PROMPT_EVALUATION_EVIDENCE".clone(),
    evaluation_id: "evaluation".clone(),
    evaluation_result_sha256: if mode == 3 { digest_b() } else { digest_a() },
    trust: trust(true),
    expected_inputs: if mode == 3 { expected_inputs() } else { tampered_expected_inputs(mode) },
    content_sha256: digest_a(),
  }
}

fn malformed_trust() -> prompt_artifacts.PromptVerifierTrust {
  return prompt_artifacts.PromptVerifierTrust {
    schema_version: 1,
    artifact_kind: "PROMPT_VERIFIER_TRUST".clone(),
    expected_align_llm_commit: digest_a(),
    expected_align_revision: digest_a(),
    expected_corpus_source_kind: "GIT_COMMIT".clone(),
    expected_corpus_source_repository_id: "corpus-repository".clone(),
    expected_corpus_source_sha256: digest_a(),
    align_llm_reachability: "VERIFIED".clone(),
    align_llm_observed_head: None,
    align_reachability: "VERIFIED".clone(),
    align_observed_revision: Some(digest_a()),
    corpus_reachability: "VERIFIED".clone(),
    corpus_observed_source_sha256: Some(digest_a()),
    content_sha256: digest_a(),
  }
}

fn malformed_evidence() -> prompt_artifacts.PromptEvaluationEvidence {
  return prompt_artifacts.PromptEvaluationEvidence {
    schema_version: 1,
    artifact_kind: "PROMPT_EVALUATION_EVIDENCE".clone(),
    evaluation_id: "evaluation".clone(),
    evaluation_result_sha256: digest_a(),
    trust: malformed_trust(),
    expected_inputs: expected_inputs(),
    content_sha256: digest_a(),
  }
}

