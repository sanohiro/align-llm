  }
}

fn activation_result(provider_kind: str) -> prompt_artifacts.PromptActivationResult {
  return prompt_artifacts.PromptActivationResult {
    schema_version: 1,
    artifact_kind: "PROMPT_ACTIVATION_RESULT".clone(),
    decision_id: Some("decision".clone()),
    status: "BASELINED".clone(),
