module prompt_score

import prompt_artifacts
import std.crypto
import std.encoding

// C6c1 is a provider-independent, allocation-free scoring kernel. The public input rows are
// borrowed Copy records. Output records are exposed as caller-owned scalar columns because the
// pinned Align compiler does not yet support stores through out slice<Struct>.

pub ScoreVariant { Parent, Candidate }
pub ScoreStatus { Pass, Fail, PolicyViolation, Error }
pub ScoreFailureKind { None, Provider, Patch, Build, Test, Policy, Cleanup, Containment, Adapter }
pub ScoreStage { Pass, Fail, NotRun, StageError }

pub ScoreRow {
  task_ordinal: i64,
  sample_index: i64,
  variant: ScoreVariant,
  status: ScoreStatus,
  failure_kind: ScoreFailureKind,
  build_status: ScoreStage,
  test_status: ScoreStage,
  repair_loop_count: i64,
  unrelated_diff_count: i64,
  patch_size_bytes: i64,
  public_api_change_count: i64,
  policy_violation_count: i64,
  cleanup_passed: bool,
  containment_passed: bool,
  adapter_error: bool,
  prompt_preparation_ns: i64,
  generation_to_passing_patch_ns: Option<i64>,
  time_to_passing_patch_ns: Option<i64>,
  benchmark_regression_ppm: Option<i64>,
}

pub ScoreTaskLimit {
  maximum_unrelated_diff_count: i64,
  maximum_patch_size_bytes: i64,
  maximum_public_api_change_count: i64,
  maximum_repair_loops: i64,
  maximum_benchmark_regression_ppm: Option<i64>,
}

pub ScorePolicyLimit {
  maximum_time_regression_ppm: i64,
  maximum_repair_loop_regression_count: i64,
}

pub ScoreTaskAggregate {
  task_ordinal: i64,
  parent_pass_count: i64,
  candidate_pass_count: i64,
  parent_repair_loop_count: i64,
  candidate_repair_loop_count: i64,
  paired_pass_count: i64,
  parent_paired_median_time_ns: Option<i64>,
  candidate_paired_median_time_ns: Option<i64>,
  time_improvement_ppm: Option<i64>,
  time_regression_ppm: Option<i64>,
}

pub ScoreCorpusAggregate {
  task_count: i64,
  sample_count: i64,
  parent_pass_count: i64,
  candidate_pass_count: i64,
  parent_repair_loop_count: i64,
  candidate_repair_loop_count: i64,
  paired_pass_count: i64,
  parent_paired_median_time_ns: Option<i64>,
  candidate_paired_median_time_ns: Option<i64>,
  completion_gain_count: i64,
  time_improvement_ppm: Option<i64>,
  time_regression_ppm: Option<i64>,
  repair_loop_regression_count: i64,
}

pub ScoreValue { None, Pass, Fail, PolicyViolation, Error, Number(i64) }
pub ScoreReasonCode { PassToFail, Build, Test, Policy, UnrelatedDiff, PublicApi, PatchSize, RepairLoops, Benchmark, Time }

pub ScoreReason {
  task_ordinal: i64,
  sample_index: i64,
  code: ScoreReasonCode,
  parent_value: ScoreValue,
  candidate_value: ScoreValue,
  limit: ScoreValue,
}

pub ScoreOutputKind { None, TaskAggregates, Reasons }
pub ScoreResultStatus { Complete, EvaluationError, InvalidInput, OutputTooSmall }

pub ScoreResult {
  status: ScoreResultStatus,
  error_code: i64,
  error_index: i64,
  reason_count: i64,
  output_kind: ScoreOutputKind,
  required_output_count: i64,
  corpus: ScoreCorpusAggregate,
}

pub ScorePrefixStatus { ValidPrefix, TerminalError, InvalidInput }

pub PromptScoreStatus { ImprovedEligible, CompleteIneligible, NoncompleteError }

pub ScorePrefixResult {
  status: ScorePrefixStatus,
  error_code: i64,
  error_index: i64,
  row_count: i64,
  expected_row_count: i64,
}

RowValidation { Valid, Invalid, EvaluationError }

TimeMetrics {
  improvement_ppm: Option<i64>,
  regression_ppm: Option<i64>,
}

fn row_is_invalid(value: RowValidation) -> bool {
  return match value {
    Invalid => true,
    Valid => false,
    EvaluationError => false,
  }
}

fn row_is_evaluation_error(value: RowValidation) -> bool {
  return match value {
    EvaluationError => true,
    Valid => false,
    Invalid => false,
  }
}

fn result_with(
  status: ScoreResultStatus,
  error_code: i64,
  error_index: i64,
  reason_count: i64,
  output_kind: ScoreOutputKind,
  required_output_count: i64,
) -> ScoreResult {
  empty := ScoreCorpusAggregate {
    task_count: 0,
    sample_count: 0,
    parent_pass_count: 0,
    candidate_pass_count: 0,
    parent_repair_loop_count: 0,
    candidate_repair_loop_count: 0,
    paired_pass_count: 0,
    parent_paired_median_time_ns: None,
    candidate_paired_median_time_ns: None,
    completion_gain_count: 0,
    time_improvement_ppm: None,
    time_regression_ppm: None,
    repair_loop_regression_count: 0,
  }
  return ScoreResult {
    status: status,
    error_code: error_code,
    error_index: error_index,
    reason_count: reason_count,
    output_kind: output_kind,
    required_output_count: required_output_count,
    corpus: empty,
  }
}

fn prefix_result_with(
  status: ScorePrefixStatus,
  error_code: i64,
  error_index: i64,
  row_count: i64,
  expected_row_count: i64,
) -> ScorePrefixResult {
  return ScorePrefixResult {
    status: status,
    error_code: error_code,
    error_index: error_index,
    row_count: row_count,
    expected_row_count: expected_row_count,
  }
}

fn bounded_nonnegative(value: i64, maximum: i64) -> bool {
  return value >= 0 && value <= maximum
}

fn optional_bounded(value: Option<i64>, maximum: i64) -> bool {
  return match value {
    None => true,
    Some(number) => bounded_nonnegative(number, maximum),
  }
}

fn option_is_none(value: Option<i64>) -> bool {
  return match value {
    None => true,
    Some(_) => false,
  }
}

fn same_stage(a: ScoreStage, b: ScoreStage) -> bool {
  return match a {
    Pass => match b { Pass => true, _ => false },
    Fail => match b { Fail => true, _ => false },
    NotRun => match b { NotRun => true, _ => false },
    StageError => match b { StageError => true, _ => false },
  }
}

fn same_failure(a: ScoreFailureKind, b: ScoreFailureKind) -> bool {
  return match a {
    None => match b { None => true, _ => false },
    Provider => match b { Provider => true, _ => false },
    Patch => match b { Patch => true, _ => false },
    Build => match b { Build => true, _ => false },
    Test => match b { Test => true, _ => false },
    Policy => match b { Policy => true, _ => false },
    Cleanup => match b { Cleanup => true, _ => false },
    Containment => match b { Containment => true, _ => false },
    Adapter => match b { Adapter => true, _ => false },
  }
}

fn same_status(a: ScoreStatus, b: ScoreStatus) -> bool {
  return match a {
    Pass => match b { Pass => true, _ => false },
    Fail => match b { Fail => true, _ => false },
    PolicyViolation => match b { PolicyViolation => true, _ => false },
    Error => match b { Error => true, _ => false },
  }
}

fn same_variant(a: ScoreVariant, b: ScoreVariant) -> bool {
  return match a {
    Parent => match b { Parent => true, _ => false },
    Candidate => match b { Candidate => true, _ => false },
  }
}

fn is_pass(status: ScoreStatus) -> bool {
  return same_status(status, ScoreStatus.Pass)
}

fn stage_is_error(stage: ScoreStage) -> bool {
  return same_stage(stage, ScoreStage.StageError)
}

fn status_value(status: ScoreStatus) -> ScoreValue {
  return match status {
    Pass => ScoreValue.Pass,
    Fail => ScoreValue.Fail,
    PolicyViolation => ScoreValue.PolicyViolation,
    Error => ScoreValue.Error,
  }
}

fn valid_task_limit(limit: ScoreTaskLimit) -> bool {
  if !bounded_nonnegative(limit.maximum_unrelated_diff_count, 1_048_576) {
    return false
  }
  if !bounded_nonnegative(limit.maximum_patch_size_bytes, 67_108_864) {
    return false
  }
  if !bounded_nonnegative(limit.maximum_public_api_change_count, 1_048_576) {
    return false
  }
  if !bounded_nonnegative(limit.maximum_repair_loops, 64) {
    return false
  }
  return match limit.maximum_benchmark_regression_ppm {
    None => true,
    Some(number) => bounded_nonnegative(number, 1_000_000),
  }
}

fn valid_policy_limit(limit: ScorePolicyLimit) -> bool {
  if !bounded_nonnegative(limit.maximum_time_regression_ppm, 1_000_000) {
    return false
  }
  return bounded_nonnegative(limit.maximum_repair_loop_regression_count, 65_536)
}

fn benchmark_is_valid(value: Option<i64>, maximum: Option<i64>, passing: bool) -> bool {
  if !passing {
    return match value {
      None => true,
      Some(_) => false,
    }
  }
  return match maximum {
    None => match value {
      None => true,
      Some(_) => false,
    },
    Some(_) => match value {
      None => false,
      Some(number) => bounded_nonnegative(number, 1_000_000),
    },
  }
}

fn passing_time(value: Option<i64>) -> i64 {
  return match value {
    Some(number) => number,
    None => 0,
  }
}

fn validate_row(rows: slice<ScoreRow>, row_index: i64, limit: ScoreTaskLimit) -> RowValidation {
  row := rows[row_index]
  if !bounded_nonnegative(row.repair_loop_count, 64) {
    return RowValidation.Invalid
  }
  if !bounded_nonnegative(row.unrelated_diff_count, 1_048_576) {
    return RowValidation.Invalid
  }
  if !bounded_nonnegative(row.patch_size_bytes, 67_108_864) {
    return RowValidation.Invalid
  }
  if !bounded_nonnegative(row.public_api_change_count, 1_048_576) {
    return RowValidation.Invalid
  }
  if !bounded_nonnegative(row.policy_violation_count, 1_048_576) {
    return RowValidation.Invalid
  }
  if !bounded_nonnegative(row.prompt_preparation_ns, 7_200_000_000_000) {
    return RowValidation.Invalid
  }
  if !optional_bounded(row.generation_to_passing_patch_ns, 7_200_000_000_000) {
    return RowValidation.Invalid
  }
  if !optional_bounded(row.time_to_passing_patch_ns, 7_200_000_000_000) {
    return RowValidation.Invalid
  }

  if same_status(row.status, ScoreStatus.Error) {
    if !option_is_none(row.generation_to_passing_patch_ns) || !option_is_none(row.time_to_passing_patch_ns) {
      return RowValidation.Invalid
    }
    if !benchmark_is_valid(row.benchmark_regression_ppm, None, false) {
      return RowValidation.Invalid
    }
    mut expected := ScoreFailureKind.Adapter
    if !row.containment_passed {
      expected = ScoreFailureKind.Containment
    } else if !row.cleanup_passed {
      expected = ScoreFailureKind.Cleanup
    } else if !(row.adapter_error || stage_is_error(row.build_status) || stage_is_error(row.test_status)) {
      return RowValidation.Invalid
    }
    if !same_failure(row.failure_kind, expected) {
      return RowValidation.Invalid
    }
    if (!row.containment_passed || !row.cleanup_passed) && row.adapter_error {
      return RowValidation.Invalid
    }
    return RowValidation.EvaluationError
  }

  if !row.cleanup_passed || !row.containment_passed || row.adapter_error {
    return RowValidation.Invalid
  }
  if stage_is_error(row.build_status) || stage_is_error(row.test_status) {
    return RowValidation.Invalid
  }

  if same_status(row.status, ScoreStatus.Pass) {
    if !same_failure(row.failure_kind, ScoreFailureKind.None) {
      return RowValidation.Invalid
    }
    if !same_stage(row.build_status, ScoreStage.Pass) || !same_stage(row.test_status, ScoreStage.Pass) {
      return RowValidation.Invalid
    }
    if row.policy_violation_count != 0 {
      return RowValidation.Invalid
    }
    if option_is_none(row.generation_to_passing_patch_ns) {
      return RowValidation.Invalid
    }
    generation := match row.generation_to_passing_patch_ns {
      None => 0,
      Some(value) => value,
    }
    if option_is_none(row.time_to_passing_patch_ns) {
      return RowValidation.Invalid
    }
    total := match row.time_to_passing_patch_ns {
      None => 0,
      Some(value) => value,
    }
    if generation <= 0 || total <= 0 || total != row.prompt_preparation_ns + generation {
      return RowValidation.Invalid
    }
    if !benchmark_is_valid(row.benchmark_regression_ppm, limit.maximum_benchmark_regression_ppm, true) {
      return RowValidation.Invalid
    }
    return RowValidation.Valid
  }

  if same_status(row.status, ScoreStatus.Fail) {
    if row.policy_violation_count != 0 || !benchmark_is_valid(row.benchmark_regression_ppm, limit.maximum_benchmark_regression_ppm, false) {
      return RowValidation.Invalid
    }
    if !option_is_none(row.generation_to_passing_patch_ns) || !option_is_none(row.time_to_passing_patch_ns) {
      return RowValidation.Invalid
    }
    if same_failure(row.failure_kind, ScoreFailureKind.Provider) || same_failure(row.failure_kind, ScoreFailureKind.Patch) {
      if !same_stage(row.build_status, ScoreStage.NotRun) || !same_stage(row.test_status, ScoreStage.NotRun) {
        return RowValidation.Invalid
      }
      return RowValidation.Valid
    }
    if same_failure(row.failure_kind, ScoreFailureKind.Build) {
      if !same_stage(row.build_status, ScoreStage.Fail) || !same_stage(row.test_status, ScoreStage.NotRun) {
        return RowValidation.Invalid
      }
      return RowValidation.Valid
    }
    if same_failure(row.failure_kind, ScoreFailureKind.Test) {
      if !same_stage(row.build_status, ScoreStage.Pass) || !same_stage(row.test_status, ScoreStage.Fail) {
        return RowValidation.Invalid
      }
      return RowValidation.Valid
    }
    return RowValidation.Invalid
  }

  if same_status(row.status, ScoreStatus.PolicyViolation) {
    if !same_failure(row.failure_kind, ScoreFailureKind.Policy) || row.policy_violation_count <= 0 {
      return RowValidation.Invalid
    }
    if !benchmark_is_valid(row.benchmark_regression_ppm, limit.maximum_benchmark_regression_ppm, false) {
      return RowValidation.Invalid
    }
    if !option_is_none(row.generation_to_passing_patch_ns) || !option_is_none(row.time_to_passing_patch_ns) {
      return RowValidation.Invalid
    }
    valid_stage_pair :=
    (same_stage(row.build_status, ScoreStage.NotRun) && same_stage(row.test_status, ScoreStage.NotRun)) ||
    (same_stage(row.build_status, ScoreStage.Pass) && same_stage(row.test_status, ScoreStage.NotRun)) ||
    (same_stage(row.build_status, ScoreStage.Pass) && same_stage(row.test_status, ScoreStage.Pass))
    if !valid_stage_pair {
      return RowValidation.Invalid
    }
    return RowValidation.Valid
  }

  return RowValidation.Invalid
}

fn pair_start(task: i64, sample: i64, sample_count: i64) -> i64 {
  return task * sample_count * 2 + (sample - 1) * 2
}

fn parent_index(base: i64, sample: i64) -> i64 {
  return if sample % 2 == 1 { base } else { base + 1 }
}

fn candidate_index(base: i64, sample: i64) -> i64 {
  return if sample % 2 == 1 { base + 1 } else { base }
}

fn in_scope(task: i64, target_task: i64) -> bool {
  return target_task < 0 || task == target_task
}

fn paired_pass_count(rows: slice<ScoreRow>, task_count: i64, sample_count: i64, target_task: i64) -> i64 {
  mut count := 0
  mut task := 0
  loop {
    if task >= task_count { break }
    if in_scope(task, target_task) {
      mut sample := 1
      loop {
        if sample > sample_count { break }
        base := pair_start(task, sample, sample_count)
        parent := rows[parent_index(base, sample)]
        candidate := rows[candidate_index(base, sample)]
        if is_pass(parent.status) && is_pass(candidate.status) {
          count = count + 1
        }
        sample = sample + 1
      }
    }
    task = task + 1
  }
  return count
}

fn variant_pass_count(rows: slice<ScoreRow>, task_count: i64, sample_count: i64, target_task: i64, variant: ScoreVariant) -> i64 {
  mut count := 0
  mut task := 0
  loop {
    if task >= task_count { break }
    if in_scope(task, target_task) {
      mut sample := 1
      loop {
        if sample > sample_count { break }
        base := pair_start(task, sample, sample_count)
        row := if same_variant(variant, ScoreVariant.Parent) {
          rows[parent_index(base, sample)]
        } else {
          rows[candidate_index(base, sample)]
        }
        if is_pass(row.status) {
          count = count + 1
        }
        sample = sample + 1
      }
    }
    task = task + 1
  }
  return count
}

fn variant_repair_sum(rows: slice<ScoreRow>, task_count: i64, sample_count: i64, target_task: i64, variant: ScoreVariant) -> i64 {
  mut total := 0
  mut task := 0
  loop {
    if task >= task_count { break }
    if in_scope(task, target_task) {
      mut sample := 1
      loop {
        if sample > sample_count { break }
        base := pair_start(task, sample, sample_count)
        row := if same_variant(variant, ScoreVariant.Parent) {
          rows[parent_index(base, sample)]
        } else {
          rows[candidate_index(base, sample)]
        }
        total = total + row.repair_loop_count
        sample = sample + 1
      }
    }
    task = task + 1
  }
  return total
}

fn count_time_le(
  rows: slice<ScoreRow>,
  task_count: i64,
  sample_count: i64,
  target_task: i64,
  variant: ScoreVariant,
  value: i64,
) -> i64 {
  mut count := 0
  mut task := 0
  loop {
    if task >= task_count { break }
    if in_scope(task, target_task) {
      mut sample := 1
      loop {
        if sample > sample_count { break }
        base := pair_start(task, sample, sample_count)
        parent := rows[parent_index(base, sample)]
        candidate := rows[candidate_index(base, sample)]
        if is_pass(parent.status) && is_pass(candidate.status) {
          row := if same_variant(variant, ScoreVariant.Parent) { parent } else { candidate }
          if passing_time(row.time_to_passing_patch_ns) <= value {
            count = count + 1
          }
        }
        sample = sample + 1
      }
    }
    task = task + 1
  }
  return count
}

fn median_time(
  rows: slice<ScoreRow>,
  task_count: i64,
  sample_count: i64,
  target_task: i64,
  variant: ScoreVariant,
  rank: i64,
) -> Option<i64> {
  count := paired_pass_count(rows, task_count, sample_count, target_task)
  if rank < 0 || rank >= count {
    return None
  }
  mut found := false
  mut best := 0
  mut task := 0
  loop {
    if task >= task_count { break }
    if in_scope(task, target_task) {
      mut sample := 1
      loop {
        if sample > sample_count { break }
        base := pair_start(task, sample, sample_count)
        parent := rows[parent_index(base, sample)]
        candidate := rows[candidate_index(base, sample)]
        if is_pass(parent.status) && is_pass(candidate.status) {
          value := if same_variant(variant, ScoreVariant.Parent) {
            passing_time(parent.time_to_passing_patch_ns)
          } else {
            passing_time(candidate.time_to_passing_patch_ns)
          }
          rank_count := count_time_le(rows, task_count, sample_count, target_task, variant, value)
          if rank_count > rank && (!found || value < best) {
            found = true
            best = value
          }
        }
        sample = sample + 1
      }
    }
    task = task + 1
  }
  return if found { Some(best) } else { None }
}

fn aggregate_median(
  rows: slice<ScoreRow>,
  task_count: i64,
  sample_count: i64,
  target_task: i64,
  variant: ScoreVariant,
) -> Option<i64> {
  count := paired_pass_count(rows, task_count, sample_count, target_task)
  if count == 0 {
    return None
  }
  lower := median_time(rows, task_count, sample_count, target_task, variant, (count - 1) / 2)
  upper := median_time(rows, task_count, sample_count, target_task, variant, count / 2)
  return match lower {
    None => None,
    Some(lower_value) => match upper {
      None => None,
      Some(upper_value) => Some(lower_value + (upper_value - lower_value) / 2),
    },
  }
}

fn calculate_time_metrics(parent: Option<i64>, candidate: Option<i64>) -> TimeMetrics {
  mut metrics := TimeMetrics { improvement_ppm: None, regression_ppm: None }
  match parent {
    None => {},
    Some(parent_value) => match candidate {
      None => {},
      Some(candidate_value) => {
        if candidate_value <= parent_value {
          metrics.improvement_ppm = Some((parent_value - candidate_value) * 1_000_000 / parent_value)
          metrics.regression_ppm = Some(0)
        } else {
          metrics.improvement_ppm = Some(0)
          metrics.regression_ppm = Some((candidate_value - parent_value) * 1_000_000 / parent_value)
        }
      },
    },
  }
  return metrics
}

fn candidate_benchmark_exceeds(status: ScoreStatus, value: Option<i64>, maximum: Option<i64>) -> bool {
  return match maximum {
    None => false,
    Some(limit_value) => match value {
      None => false,
      Some(measurement) => is_pass(status) && measurement > limit_value,
    },
  }
}

fn reason_count_pair(
  rows: slice<ScoreRow>,
  parent_row_index: i64,
  candidate_row_index: i64,
  limit: ScoreTaskLimit,
) -> i64 {
  parent := rows[parent_row_index]
  candidate := rows[candidate_row_index]
  mut count := 0
  // Variant-symmetric from version 2 on. While repair was unreachable the cap was checked on the
  // candidate arm only, so a parent row exceeding its task's declared cap was checked nowhere.
  // Every version-1 row carries `repair_loop_count: 0` against a limit of `0`, so this is vacuous
  // on the frozen chain and no version-1 verdict changes.
  if parent.repair_loop_count > limit.maximum_repair_loops {
    count = count + 1
  }
  if is_pass(parent.status) && !is_pass(candidate.status) {
    count = count + 1
  }
  if same_stage(parent.build_status, ScoreStage.Pass) && !same_stage(candidate.build_status, ScoreStage.Pass) {
    count = count + 1
  }
  if same_stage(parent.test_status, ScoreStage.Pass) && !same_stage(candidate.test_status, ScoreStage.Pass) {
    count = count + 1
  }
  if same_status(candidate.status, ScoreStatus.PolicyViolation) {
    count = count + 1
  }
  if candidate.unrelated_diff_count > limit.maximum_unrelated_diff_count {
    count = count + 1
  }
  if candidate.public_api_change_count > limit.maximum_public_api_change_count {
    count = count + 1
  }
  if candidate.patch_size_bytes > limit.maximum_patch_size_bytes {
    count = count + 1
  }
  if candidate.repair_loop_count > limit.maximum_repair_loops {
    count = count + 1
  }
  if candidate_benchmark_exceeds(
    candidate.status,
    candidate.benchmark_regression_ppm,
    limit.maximum_benchmark_regression_ppm,
  ) {
    count = count + 1
  }
  return count
}

fn reason_count_task(
  rows: slice<ScoreRow>,
  task_count: i64,
  sample_count: i64,
  task: i64,
  limit: ScoreTaskLimit,
  policy: ScorePolicyLimit,
) -> i64 {
  mut count := 0
  parent_median := aggregate_median(rows, task_count, sample_count, task, ScoreVariant.Parent)
  candidate_median := aggregate_median(rows, task_count, sample_count, task, ScoreVariant.Candidate)
  metrics := calculate_time_metrics(parent_median, candidate_median)
  match metrics.regression_ppm {
    Some(value) => if value > policy.maximum_time_regression_ppm { count = count + 1 },
    None => {},
  }
  mut sample := 1
  loop {
    if sample > sample_count { break }
    base := pair_start(task, sample, sample_count)
    count = count + reason_count_pair(
      rows,
      parent_index(base, sample),
      candidate_index(base, sample),
      limit,
    )
    sample = sample + 1
  }
  return count
}

fn reason_code_ordinal(code: ScoreReasonCode) -> i64 {
  return match code {
    PassToFail => 0,
    Build => 1,
    Test => 2,
    Policy => 3,
    UnrelatedDiff => 4,
    PublicApi => 5,
    PatchSize => 6,
    RepairLoops => 7,
    Benchmark => 8,
    Time => 9,
  }
}

fn score_value_kind(value: ScoreValue) -> i64 {
  return match value {
    None => 0,
    Pass => 1,
    Fail => 2,
    PolicyViolation => 3,
    Error => 4,
    Number(_) => 5,
  }
}

fn score_value_number(value: ScoreValue) -> i64 {
  return match value {
    Number(number) => number,
    None => 0,
    Pass => 0,
    Fail => 0,
    PolicyViolation => 0,
    Error => 0,
  }
}

fn option_number(value: Option<i64>) -> i64 {
  return match value {
    None => 0,
    Some(number) => number,
  }
}

fn write_optional(out present: slice<bool>, out number: slice<i64>, index: i64, value: Option<i64>) {
  match value {
    None => {
      present[index] = false
      number[index] = 0
    },
    Some(number_value) => {
      present[index] = true
      number[index] = number_value
    },
  }
}

fn emit_reason(
  index: i64,
  task_ordinal: i64,
  sample_index: i64,
  code: ScoreReasonCode,
  parent_value: ScoreValue,
  candidate_value: ScoreValue,
  limit: ScoreValue,
  out reason_task_ordinal: slice<i64>,
  out reason_sample_index: slice<i64>,
  out reason_code: slice<i64>,
  out reason_parent_value_kind: slice<i64>,
  out reason_parent_value_number: slice<i64>,
  out reason_candidate_value_kind: slice<i64>,
  out reason_candidate_value_number: slice<i64>,
  out reason_limit_kind: slice<i64>,
  out reason_limit_number: slice<i64>,
) -> i64 {
  reason_task_ordinal[index] = task_ordinal
  reason_sample_index[index] = sample_index
  reason_code[index] = reason_code_ordinal(code)
  reason_parent_value_kind[index] = score_value_kind(parent_value)
  reason_parent_value_number[index] = score_value_number(parent_value)
  reason_candidate_value_kind[index] = score_value_kind(candidate_value)
  reason_candidate_value_number[index] = score_value_number(candidate_value)
  reason_limit_kind[index] = score_value_kind(limit)
  reason_limit_number[index] = score_value_number(limit)
  return index + 1
}

fn emit_pair_reasons(
  index: i64,
  task: i64,
  sample: i64,
  rows: slice<ScoreRow>,
  parent_row_index: i64,
  candidate_row_index: i64,
  limit: ScoreTaskLimit,
  out reason_task_ordinal: slice<i64>,
  out reason_sample_index: slice<i64>,
  out reason_code: slice<i64>,
  out reason_parent_value_kind: slice<i64>,
  out reason_parent_value_number: slice<i64>,
  out reason_candidate_value_kind: slice<i64>,
  out reason_candidate_value_number: slice<i64>,
  out reason_limit_kind: slice<i64>,
  out reason_limit_number: slice<i64>,
) -> i64 {
  parent := rows[parent_row_index]
  candidate := rows[candidate_row_index]
  mut next := index
  // The candidate record keeps its exact existing shape (`parent_value` NONE); the parent arm
  // gets a distinguishable one (`candidate_value` NONE) so the two are never confused.
  if parent.repair_loop_count > limit.maximum_repair_loops {
    next = emit_reason(
      next,
      task,
      sample,
      ScoreReasonCode.RepairLoops,
      ScoreValue.Number(parent.repair_loop_count),
      ScoreValue.None,
      ScoreValue.Number(limit.maximum_repair_loops),
      reason_task_ordinal,
      reason_sample_index,
      reason_code,
      reason_parent_value_kind,
      reason_parent_value_number,
      reason_candidate_value_kind,
      reason_candidate_value_number,
      reason_limit_kind,
      reason_limit_number,
    )
  }
  if is_pass(parent.status) && !is_pass(candidate.status) {
    next = emit_reason(
      next,
      task,
      sample,
      ScoreReasonCode.PassToFail,
      ScoreValue.Pass,
      status_value(candidate.status),
      ScoreValue.None,
      reason_task_ordinal,
      reason_sample_index,
      reason_code,
      reason_parent_value_kind,
      reason_parent_value_number,
      reason_candidate_value_kind,
      reason_candidate_value_number,
      reason_limit_kind,
      reason_limit_number,
    )
  }
  if same_stage(parent.build_status, ScoreStage.Pass) && !same_stage(candidate.build_status, ScoreStage.Pass) {
    next = emit_reason(
      next,
      task,
      sample,
      ScoreReasonCode.Build,
      ScoreValue.Pass,
      status_value(candidate.status),
      ScoreValue.None,
      reason_task_ordinal,
      reason_sample_index,
      reason_code,
      reason_parent_value_kind,
      reason_parent_value_number,
      reason_candidate_value_kind,
      reason_candidate_value_number,
      reason_limit_kind,
      reason_limit_number,
    )
  }
  if same_stage(parent.test_status, ScoreStage.Pass) && !same_stage(candidate.test_status, ScoreStage.Pass) {
    next = emit_reason(
      next,
      task,
      sample,
      ScoreReasonCode.Test,
      ScoreValue.Pass,
      status_value(candidate.status),
      ScoreValue.None,
      reason_task_ordinal,
      reason_sample_index,
      reason_code,
      reason_parent_value_kind,
      reason_parent_value_number,
      reason_candidate_value_kind,
      reason_candidate_value_number,
      reason_limit_kind,
      reason_limit_number,
    )
  }
  if same_status(candidate.status, ScoreStatus.PolicyViolation) {
    next = emit_reason(
      next,
      task,
      sample,
      ScoreReasonCode.Policy,
      ScoreValue.None,
      ScoreValue.PolicyViolation,
      ScoreValue.None,
      reason_task_ordinal,
      reason_sample_index,
      reason_code,
      reason_parent_value_kind,
      reason_parent_value_number,
      reason_candidate_value_kind,
      reason_candidate_value_number,
      reason_limit_kind,
      reason_limit_number,
    )
  }
  if candidate.unrelated_diff_count > limit.maximum_unrelated_diff_count {
    next = emit_reason(
      next,
      task,
      sample,
      ScoreReasonCode.UnrelatedDiff,
      ScoreValue.None,
      ScoreValue.Number(candidate.unrelated_diff_count),
      ScoreValue.Number(limit.maximum_unrelated_diff_count),
      reason_task_ordinal,
      reason_sample_index,
      reason_code,
      reason_parent_value_kind,
      reason_parent_value_number,
      reason_candidate_value_kind,
      reason_candidate_value_number,
      reason_limit_kind,
      reason_limit_number,
    )
  }
  if candidate.public_api_change_count > limit.maximum_public_api_change_count {
    next = emit_reason(
      next,
      task,
      sample,
      ScoreReasonCode.PublicApi,
      ScoreValue.None,
      ScoreValue.Number(candidate.public_api_change_count),
      ScoreValue.Number(limit.maximum_public_api_change_count),
      reason_task_ordinal,
      reason_sample_index,
      reason_code,
      reason_parent_value_kind,
      reason_parent_value_number,
      reason_candidate_value_kind,
      reason_candidate_value_number,
      reason_limit_kind,
      reason_limit_number,
    )
  }
  if candidate.patch_size_bytes > limit.maximum_patch_size_bytes {
    next = emit_reason(
      next,
      task,
      sample,
      ScoreReasonCode.PatchSize,
      ScoreValue.None,
      ScoreValue.Number(candidate.patch_size_bytes),
      ScoreValue.Number(limit.maximum_patch_size_bytes),
      reason_task_ordinal,
      reason_sample_index,
      reason_code,
      reason_parent_value_kind,
      reason_parent_value_number,
      reason_candidate_value_kind,
      reason_candidate_value_number,
      reason_limit_kind,
      reason_limit_number,
    )
  }
  if candidate.repair_loop_count > limit.maximum_repair_loops {
    next = emit_reason(
      next,
      task,
      sample,
      ScoreReasonCode.RepairLoops,
      ScoreValue.None,
      ScoreValue.Number(candidate.repair_loop_count),
      ScoreValue.Number(limit.maximum_repair_loops),
      reason_task_ordinal,
      reason_sample_index,
      reason_code,
      reason_parent_value_kind,
      reason_parent_value_number,
      reason_candidate_value_kind,
      reason_candidate_value_number,
      reason_limit_kind,
      reason_limit_number,
    )
  }
  if candidate_benchmark_exceeds(
    candidate.status,
    candidate.benchmark_regression_ppm,
    limit.maximum_benchmark_regression_ppm,
  ) {
    next = emit_reason(
      next,
      task,
      sample,
      ScoreReasonCode.Benchmark,
      ScoreValue.None,
      ScoreValue.Number(option_number(candidate.benchmark_regression_ppm)),
      ScoreValue.Number(option_number(limit.maximum_benchmark_regression_ppm)),
      reason_task_ordinal,
      reason_sample_index,
      reason_code,
      reason_parent_value_kind,
      reason_parent_value_number,
      reason_candidate_value_kind,
      reason_candidate_value_number,
      reason_limit_kind,
      reason_limit_number,
    )
  }
  return next
}

fn emit_time_reason(
  index: i64,
  task: i64,
  metrics: TimeMetrics,
  parent_median: Option<i64>,
  candidate_median: Option<i64>,
  maximum_regression_ppm: i64,
  out reason_task_ordinal: slice<i64>,
  out reason_sample_index: slice<i64>,
  out reason_code: slice<i64>,
  out reason_parent_value_kind: slice<i64>,
  out reason_parent_value_number: slice<i64>,
  out reason_candidate_value_kind: slice<i64>,
  out reason_candidate_value_number: slice<i64>,
  out reason_limit_kind: slice<i64>,
  out reason_limit_number: slice<i64>,
) -> i64 {
  mut next := index
  match metrics.regression_ppm {
    None => {},
    Some(regression) => if regression > maximum_regression_ppm {
      next = emit_reason(
        next,
        task,
        0,
        ScoreReasonCode.Time,
        ScoreValue.Number(option_number(parent_median)),
        ScoreValue.Number(option_number(candidate_median)),
        ScoreValue.Number(maximum_regression_ppm),
        reason_task_ordinal,
        reason_sample_index,
        reason_code,
        reason_parent_value_kind,
        reason_parent_value_number,
        reason_candidate_value_kind,
        reason_candidate_value_number,
        reason_limit_kind,
        reason_limit_number,
      )
    },
  }
  return next
}

fn emit_repair_reason(
  index: i64,
  parent_total: i64,
  candidate_total: i64,
  maximum_regression: i64,
  out reason_task_ordinal: slice<i64>,
  out reason_sample_index: slice<i64>,
  out reason_code: slice<i64>,
  out reason_parent_value_kind: slice<i64>,
  out reason_parent_value_number: slice<i64>,
  out reason_candidate_value_kind: slice<i64>,
  out reason_candidate_value_number: slice<i64>,
  out reason_limit_kind: slice<i64>,
  out reason_limit_number: slice<i64>,
) -> i64 {
  regression := if candidate_total > parent_total { candidate_total - parent_total } else { 0 }
  if regression <= maximum_regression {
    return index
  }
  return emit_reason(
    index,
    -1,
    0,
    ScoreReasonCode.RepairLoops,
    ScoreValue.Number(parent_total),
    ScoreValue.Number(candidate_total),
    ScoreValue.Number(maximum_regression),
    reason_task_ordinal,
    reason_sample_index,
    reason_code,
    reason_parent_value_kind,
    reason_parent_value_number,
    reason_candidate_value_kind,
    reason_candidate_value_number,
    reason_limit_kind,
    reason_limit_number,
  )
}

pub fn aggregate(
  rows: slice<ScoreRow>,
  task_limits: slice<ScoreTaskLimit>,
  policy_limits: ScorePolicyLimit,
  sample_count: i64,
  out task_ordinal: slice<i64>,
  out task_parent_pass_count: slice<i64>,
  out task_candidate_pass_count: slice<i64>,
  out task_parent_repair_loop_count: slice<i64>,
  out task_candidate_repair_loop_count: slice<i64>,
  out task_paired_pass_count: slice<i64>,
  out task_parent_median_present: slice<bool>,
  out task_parent_median_ns: slice<i64>,
  out task_candidate_median_present: slice<bool>,
  out task_candidate_median_ns: slice<i64>,
  out task_time_improvement_present: slice<bool>,
  out task_time_improvement_ppm: slice<i64>,
  out task_time_regression_present: slice<bool>,
  out task_time_regression_ppm: slice<i64>,
  out reason_task_ordinal: slice<i64>,
  out reason_sample_index: slice<i64>,
  out reason_code: slice<i64>,
  out reason_parent_value_kind: slice<i64>,
  out reason_parent_value_number: slice<i64>,
  out reason_candidate_value_kind: slice<i64>,
  out reason_candidate_value_number: slice<i64>,
  out reason_limit_kind: slice<i64>,
  out reason_limit_number: slice<i64>,
) -> ScoreResult {
  task_count := task_limits.len()
  if task_count < 1 || task_count > 64 || sample_count < 2 || sample_count > 16 {
    return result_with(
      ScoreResultStatus.InvalidInput,
      1,
      -1,
      0,
      ScoreOutputKind.None,
      0,
    )
  }
  expected_row_count := task_count * sample_count * 2
  if rows.len() != expected_row_count {
    return result_with(
      ScoreResultStatus.InvalidInput,
      1,
      -1,
      0,
      ScoreOutputKind.None,
      0,
    )
  }

  if task_ordinal.len() < task_count ||
  task_parent_pass_count.len() < task_count ||
  task_candidate_pass_count.len() < task_count ||
  task_parent_repair_loop_count.len() < task_count ||
  task_candidate_repair_loop_count.len() < task_count ||
  task_paired_pass_count.len() < task_count ||
  task_parent_median_present.len() < task_count ||
  task_parent_median_ns.len() < task_count ||
  task_candidate_median_present.len() < task_count ||
  task_candidate_median_ns.len() < task_count ||
  task_time_improvement_present.len() < task_count ||
  task_time_improvement_ppm.len() < task_count ||
  task_time_regression_present.len() < task_count ||
  task_time_regression_ppm.len() < task_count {
    return result_with(
      ScoreResultStatus.OutputTooSmall,
      4,
      -1,
      0,
      ScoreOutputKind.TaskAggregates,
      task_count,
    )
  }

  if !valid_policy_limit(policy_limits) {
    return result_with(
      ScoreResultStatus.InvalidInput,
      1,
      -1,
      0,
      ScoreOutputKind.None,
      0,
    )
  }

  mut task := 0
  loop {
    if task >= task_count {
      break
    }
    limit := task_limits[task]
    if !valid_task_limit(limit) {
      return result_with(
        ScoreResultStatus.InvalidInput,
        1,
        -1,
        0,
        ScoreOutputKind.None,
        0,
      )
    }
    task = task + 1
  }

  mut row_index := 0
  task = 0
  loop {
    if task >= task_count {
      break
    }
    limit := task_limits[task]
    mut sample := 1
    loop {
      if sample > sample_count {
        break
      }
      base := pair_start(task, sample, sample_count)
      first_variant := if sample % 2 == 1 { ScoreVariant.Parent } else { ScoreVariant.Candidate }
      second_variant := if sample % 2 == 1 { ScoreVariant.Candidate } else { ScoreVariant.Parent }

      first := rows[row_index]
      if first.task_ordinal != task || first.sample_index != sample || !same_variant(first.variant, first_variant) {
        return result_with(
          ScoreResultStatus.InvalidInput,
          2,
          row_index,
          0,
          ScoreOutputKind.None,
          0,
        )
      }
      first_validation := validate_row(rows, row_index, limit)
      if row_is_invalid(first_validation) {
        return result_with(
          ScoreResultStatus.InvalidInput,
          2,
          row_index,
          0,
          ScoreOutputKind.None,
          0,
        )
      }
      if row_is_evaluation_error(first_validation) {
        return result_with(
          ScoreResultStatus.EvaluationError,
          3,
          row_index,
          0,
          ScoreOutputKind.None,
          0,
        )
      }
      row_index = row_index + 1

      second := rows[row_index]
      if second.task_ordinal != task || second.sample_index != sample || !same_variant(second.variant, second_variant) {
        return result_with(
          ScoreResultStatus.InvalidInput,
          2,
          row_index,
          0,
          ScoreOutputKind.None,
          0,
        )
      }
      second_validation := validate_row(rows, row_index, limit)
      if row_is_invalid(second_validation) {
        return result_with(
          ScoreResultStatus.InvalidInput,
          2,
          row_index,
          0,
          ScoreOutputKind.None,
          0,
        )
      }
      if row_is_evaluation_error(second_validation) {
        return result_with(
          ScoreResultStatus.EvaluationError,
          3,
          row_index,
          0,
          ScoreOutputKind.None,
          0,
        )
      }
      row_index = row_index + 1
      sample = sample + 1
    }
    task = task + 1
  }

  corpus_parent_median := aggregate_median(rows, task_count, sample_count, -1, ScoreVariant.Parent)
  corpus_candidate_median := aggregate_median(rows, task_count, sample_count, -1, ScoreVariant.Candidate)
  corpus_metrics := calculate_time_metrics(corpus_parent_median, corpus_candidate_median)
  corpus_parent_repairs := variant_repair_sum(rows, task_count, sample_count, -1, ScoreVariant.Parent)
  corpus_candidate_repairs := variant_repair_sum(rows, task_count, sample_count, -1, ScoreVariant.Candidate)
  corpus_repair_regression := if corpus_candidate_repairs > corpus_parent_repairs {
    corpus_candidate_repairs - corpus_parent_repairs
  } else {
    0
  }

  mut reason_count := 0
  if corpus_repair_regression > policy_limits.maximum_repair_loop_regression_count {
    reason_count = reason_count + 1
  }
  match corpus_metrics.regression_ppm {
    Some(value) => if value > policy_limits.maximum_time_regression_ppm {
      reason_count = reason_count + 1
    },
    None => {},
  }
  task = 0
  loop {
    if task >= task_count {
      break
    }
    reason_count = reason_count + reason_count_task(
      rows,
      task_count,
      sample_count,
      task,
      task_limits[task],
      policy_limits,
    )
    task = task + 1
  }

  if reason_task_ordinal.len() < reason_count ||
  reason_sample_index.len() < reason_count ||
  reason_code.len() < reason_count ||
  reason_parent_value_kind.len() < reason_count ||
  reason_parent_value_number.len() < reason_count ||
  reason_candidate_value_kind.len() < reason_count ||
  reason_candidate_value_number.len() < reason_count ||
  reason_limit_kind.len() < reason_count ||
  reason_limit_number.len() < reason_count {
    return result_with(
      ScoreResultStatus.OutputTooSmall,
      5,
      -1,
      reason_count,
      ScoreOutputKind.Reasons,
      reason_count,
    )
  }

  task = 0
  loop {
    if task >= task_count {
      break
    }
    limit := task_limits[task]
    parent_passes := variant_pass_count(rows, task_count, sample_count, task, ScoreVariant.Parent)
    candidate_passes := variant_pass_count(rows, task_count, sample_count, task, ScoreVariant.Candidate)
    parent_repairs := variant_repair_sum(rows, task_count, sample_count, task, ScoreVariant.Parent)
    candidate_repairs := variant_repair_sum(rows, task_count, sample_count, task, ScoreVariant.Candidate)
    paired_passes := paired_pass_count(rows, task_count, sample_count, task)
    parent_median := aggregate_median(rows, task_count, sample_count, task, ScoreVariant.Parent)
    candidate_median := aggregate_median(rows, task_count, sample_count, task, ScoreVariant.Candidate)
    metrics := calculate_time_metrics(parent_median, candidate_median)

    task_ordinal[task] = task
    task_parent_pass_count[task] = parent_passes
    task_candidate_pass_count[task] = candidate_passes
    task_parent_repair_loop_count[task] = parent_repairs
    task_candidate_repair_loop_count[task] = candidate_repairs
    task_paired_pass_count[task] = paired_passes
    write_optional(task_parent_median_present, task_parent_median_ns, task, parent_median)
    write_optional(task_candidate_median_present, task_candidate_median_ns, task, candidate_median)
    write_optional(task_time_improvement_present, task_time_improvement_ppm, task, metrics.improvement_ppm)
    write_optional(task_time_regression_present, task_time_regression_ppm, task, metrics.regression_ppm)
    task = task + 1
  }

  mut reason_index := 0
  reason_index = emit_repair_reason(
    reason_index,
    corpus_parent_repairs,
    corpus_candidate_repairs,
    policy_limits.maximum_repair_loop_regression_count,
    reason_task_ordinal,
    reason_sample_index,
    reason_code,
    reason_parent_value_kind,
    reason_parent_value_number,
    reason_candidate_value_kind,
    reason_candidate_value_number,
    reason_limit_kind,
    reason_limit_number,
  )
  reason_index = emit_time_reason(
    reason_index,
    -1,
    corpus_metrics,
    corpus_parent_median,
    corpus_candidate_median,
    policy_limits.maximum_time_regression_ppm,
    reason_task_ordinal,
    reason_sample_index,
    reason_code,
    reason_parent_value_kind,
    reason_parent_value_number,
    reason_candidate_value_kind,
    reason_candidate_value_number,
    reason_limit_kind,
    reason_limit_number,
  )

  task = 0
  loop {
    if task >= task_count {
      break
    }
    limit := task_limits[task]
    parent_median := aggregate_median(rows, task_count, sample_count, task, ScoreVariant.Parent)
    candidate_median := aggregate_median(rows, task_count, sample_count, task, ScoreVariant.Candidate)
    metrics := calculate_time_metrics(parent_median, candidate_median)
    reason_index = emit_time_reason(
      reason_index,
      task,
      metrics,
      parent_median,
      candidate_median,
      policy_limits.maximum_time_regression_ppm,
      reason_task_ordinal,
      reason_sample_index,
      reason_code,
      reason_parent_value_kind,
      reason_parent_value_number,
      reason_candidate_value_kind,
      reason_candidate_value_number,
      reason_limit_kind,
      reason_limit_number,
    )
    mut sample := 1
    loop {
      if sample > sample_count {
        break
      }
      base := pair_start(task, sample, sample_count)
      reason_index = emit_pair_reasons(
        reason_index,
        task,
        sample,
        rows,
        parent_index(base, sample),
        candidate_index(base, sample),
        limit,
        reason_task_ordinal,
        reason_sample_index,
        reason_code,
        reason_parent_value_kind,
        reason_parent_value_number,
        reason_candidate_value_kind,
        reason_candidate_value_number,
        reason_limit_kind,
        reason_limit_number,
      )
      sample = sample + 1
    }
    task = task + 1
  }

  parent_passes := variant_pass_count(rows, task_count, sample_count, -1, ScoreVariant.Parent)
  candidate_passes := variant_pass_count(rows, task_count, sample_count, -1, ScoreVariant.Candidate)
  paired_passes := paired_pass_count(rows, task_count, sample_count, -1)
  corpus := ScoreCorpusAggregate {
    task_count: task_count,
    sample_count: sample_count,
    parent_pass_count: parent_passes,
    candidate_pass_count: candidate_passes,
    parent_repair_loop_count: corpus_parent_repairs,
    candidate_repair_loop_count: corpus_candidate_repairs,
    paired_pass_count: paired_passes,
    parent_paired_median_time_ns: corpus_parent_median,
    candidate_paired_median_time_ns: corpus_candidate_median,
    completion_gain_count: candidate_passes - parent_passes,
    time_improvement_ppm: corpus_metrics.improvement_ppm,
    time_regression_ppm: corpus_metrics.regression_ppm,
    repair_loop_regression_count: corpus_repair_regression,
  }
  return ScoreResult {
    status: ScoreResultStatus.Complete,
    error_code: 0,
    error_index: -1,
    reason_count: reason_count,
    output_kind: ScoreOutputKind.None,
    required_output_count: 0,
    corpus: corpus,
  }
}

pub fn validate_prefix(
  rows: slice<ScoreRow>,
  task_limits: slice<ScoreTaskLimit>,
  sample_count: i64,
) -> ScorePrefixResult {
  row_count := rows.len()
  task_count := task_limits.len()
  if task_count < 1 || task_count > 64 || sample_count < 2 || sample_count > 16 {
    return prefix_result_with(
      ScorePrefixStatus.InvalidInput,
      1,
      -1,
      row_count,
      -1,
    )
  }

  mut task := 0
  loop {
    if task >= task_count {
      break
    }
    if !valid_task_limit(task_limits[task]) {
      return prefix_result_with(
        ScorePrefixStatus.InvalidInput,
        1,
        -1,
        row_count,
        -1,
      )
    }
    task = task + 1
  }

  pair_width := sample_count * 2
  if task_count > 2_048 / pair_width {
    return prefix_result_with(
      ScorePrefixStatus.InvalidInput,
      1,
      -1,
      row_count,
      -1,
    )
  }
  expected_row_count := task_count * pair_width
  if row_count > expected_row_count {
    return prefix_result_with(
      ScorePrefixStatus.InvalidInput,
      2,
      expected_row_count,
      row_count,
      expected_row_count,
    )
  }

  mut row_index := 0
  loop {
    if row_index >= row_count {
      break
    }
    task = row_index / pair_width
    pair_offset := row_index % pair_width
    sample := pair_offset / 2 + 1
    variant_offset := pair_offset % 2
    expected_variant := if sample % 2 == 1 {
      if variant_offset == 0 { ScoreVariant.Parent } else { ScoreVariant.Candidate }
    } else {
      if variant_offset == 0 { ScoreVariant.Candidate } else { ScoreVariant.Parent }
    }
    row := rows[row_index]
    if row.task_ordinal != task || row.sample_index != sample || !same_variant(row.variant, expected_variant) {
      return prefix_result_with(
        ScorePrefixStatus.InvalidInput,
        2,
        row_index,
        row_count,
        expected_row_count,
      )
    }
    validation := validate_row(rows, row_index, task_limits[task])
    if row_is_invalid(validation) {
      return prefix_result_with(
        ScorePrefixStatus.InvalidInput,
        2,
        row_index,
        row_count,
        expected_row_count,
      )
    }
    if row_is_evaluation_error(validation) {
      if row_index + 1 < row_count {
        return prefix_result_with(
          ScorePrefixStatus.InvalidInput,
          2,
          row_index + 1,
          row_count,
          expected_row_count,
        )
      }
      return prefix_result_with(
        ScorePrefixStatus.TerminalError,
        0,
        -1,
        row_count,
        expected_row_count,
      )
    }
    row_index = row_index + 1
  }

  return prefix_result_with(
    ScorePrefixStatus.ValidPrefix,
    0,
    -1,
    row_count,
    expected_row_count,
  )
}

fn verifier_valid_digest(value: str) -> bool {
  if value.len() != 64 {
    return false
  }
  bytes := value.bytes()
  mut index := 0
  loop {
    if index >= bytes.len() {
      break
    }
    byte := bytes[index]
    if !((byte >= 0x30 && byte <= 0x39) || (byte >= 0x61 && byte <= 0x66)) {
      return false
    }
    index = index + 1
  }
  return true
}

// Git repositories in the supported source boundary may use SHA-1 or SHA-256 object
// formats. Artifact content digests remain exactly SHA-256.
fn verifier_valid_source_revision(value: str) -> bool {
  if value.len() != 40 && value.len() != 64 {
    return false
  }
  bytes := value.bytes()
  mut index := 0
  loop {
    if index >= bytes.len() { break }
    byte := bytes[index]
    if !((byte >= 0x30 && byte <= 0x39) || (byte >= 0x61 && byte <= 0x66)) {
      return false
    }
    index = index + 1
  }
  return true
}

fn verifier_valid_text(value: str, maximum: i64) -> bool {
  if value.len() <= 0 || value.len() > maximum {
    return false
  }
  bytes := value.bytes()
  mut index := 0
  loop {
    if index >= bytes.len() {
      break
    }
    if bytes[index] == 0 {
      return false
    }
    index = index + 1
  }
  return true
}

fn verifier_valid_bounded_text(value: str, maximum: i64) -> bool {
  if value.len() > maximum {
    return false
  }
  bytes := value.bytes()
  mut index := 0
  loop {
    if index >= bytes.len() {
      break
    }
    if bytes[index] == 0 {
      return false
    }
    index = index + 1
  }
  return true
}

fn verifier_valid_ascii_identifier(value: str, maximum: i64) -> bool {
  if !verifier_valid_text(value, maximum) { return false }
  bytes := value.bytes()
  mut index := 0
  loop {
    if index >= bytes.len() { break }
    if bytes[index] > 0x7f { return false }
    index = index + 1
  }
  return true
}

fn verifier_valid_environment_name(value: str) -> bool {
  if !verifier_valid_ascii_identifier(value, 256) { return false }
  bytes := value.bytes()
  mut index := 0
  loop {
    if index >= bytes.len() { break }
    byte := bytes[index]
    letter := (byte >= 0x41 && byte <= 0x5a) || (byte >= 0x61 && byte <= 0x7a)
    if index == 0 {
      if !letter && byte != 0x5f { return false }
    } else {
      digit := byte >= 0x30 && byte <= 0x39
      if !letter && !digit && byte != 0x5f { return false }
    }
    index = index + 1
  }
  return true
}

fn verifier_section_limit_valid(enabled: bool, limit: i64, maximum: i64) -> bool {
  if limit < 0 || limit > maximum { return false }
  return if enabled { limit > 0 } else { limit == 0 }
}

fn verifier_valid_invalid_code(value: str) -> bool {
  return value == "INPUT_NOT_FOUND" ||
  value == "INPUT_TYPE" ||
  value == "INPUT_READ" ||
  value == "INVALID_ID" ||
  value == "INVALID_PATH" ||
  value == "INVALID_SCHEMA" ||
  value == "INVALID_KIND" ||
  value == "INVALID_LABEL" ||
  value == "INVALID_BOUNDS" ||
  value == "INVALID_DIGEST" ||
  value == "INVALID_REFERENCE" ||
  value == "SCOPE_MISMATCH" ||
  value == "MISSING_CREDENTIAL" ||
  value == "WORKSPACE_NOT_EMPTY"
}

fn verifier_valid_error_code(value: str) -> bool {
  return value == "WORKSPACE_UNSAFE" ||
  value == "SNAPSHOT_MISMATCH" ||
  value == "SNAPSHOT_ERROR" ||
  value == "ADAPTER_TIMEOUT" ||
  value == "ADAPTER_PROCESS_OUTPUT" ||
  value == "ADAPTER_RESULT" ||
  value == "INPUT_DRIFT" ||
  value == "ENVIRONMENT_DRIFT" ||
  value == "ARITHMETIC" ||
  value == "RESULT_TOO_LARGE" ||
  value == "CLEANUP_FAILED"
}

fn verifier_valid_reachability(value: str) -> bool {
  return value == "VERIFIED" || value == "UNVERIFIED"
}

fn verifier_trust_observations_valid(borrow trust: prompt_artifacts.PromptVerifierTrust) -> bool {
  if !verifier_valid_reachability(trust.align_llm_reachability) ||
  !verifier_valid_reachability(trust.align_reachability) ||
  !verifier_valid_reachability(trust.corpus_reachability) {
    return false
  }

  align_llm_valid := match trust.align_llm_observed_head {
    None => trust.align_llm_reachability == "UNVERIFIED",
    Some(observed) => {
      if !verifier_valid_source_revision(observed) {
        false
      } else if trust.align_llm_reachability == "VERIFIED" {
        observed == trust.expected_align_llm_commit
      } else {
        true
      }
    },
  }
  if !align_llm_valid {
    return false
  }

  align_valid := match trust.align_observed_revision {
    None => trust.align_reachability == "UNVERIFIED",
    Some(observed) => {
      if !verifier_valid_source_revision(observed) {
        false
      } else if trust.align_reachability == "VERIFIED" {
        observed == trust.expected_align_revision
      } else {
        true
      }
    },
  }
  if !align_valid {
    return false
  }

  corpus_valid := match trust.corpus_observed_source_sha256 {
    None => trust.corpus_reachability == "UNVERIFIED",
    Some(observed) => {
      observed_valid := if trust.expected_corpus_source_kind == "GIT_COMMIT" {
        verifier_valid_source_revision(observed)
      } else {
        verifier_valid_digest(observed)
      }
      if !observed_valid {
        false
      } else if trust.corpus_reachability == "VERIFIED" {
        observed == trust.expected_corpus_source_sha256
      } else {
        true
      }
    },
  }
  return corpus_valid
}

fn verifier_trust_valid(borrow trust: prompt_artifacts.PromptVerifierTrust) -> bool {
  corpus_repository_valid := if trust.expected_corpus_source_kind == "GIT_COMMIT" {
    verifier_valid_ascii_identifier(trust.expected_corpus_source_repository_id, 128)
  } else {
    trust.expected_corpus_source_kind == "FILE_SET" && trust.expected_corpus_source_repository_id.len() == 0
  }
  corpus_source_valid := if trust.expected_corpus_source_kind == "GIT_COMMIT" {
    verifier_valid_source_revision(trust.expected_corpus_source_sha256)
  } else {
    verifier_valid_digest(trust.expected_corpus_source_sha256)
  }
  if trust.schema_version != 1 ||
  trust.artifact_kind != "PROMPT_VERIFIER_TRUST" ||
  !verifier_valid_source_revision(trust.expected_align_llm_commit) ||
  !verifier_valid_source_revision(trust.expected_align_revision) ||
  !(trust.expected_corpus_source_kind == "GIT_COMMIT" || trust.expected_corpus_source_kind == "FILE_SET") ||
  !corpus_repository_valid ||
  !corpus_source_valid ||
  !verifier_valid_digest(trust.content_sha256) {
    return false
  }
  return verifier_trust_observations_valid(trust)
}

fn verifier_pair_identity_valid(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  borrow evidence: prompt_artifacts.PromptEvaluationEvidence,
) -> bool {
  if evidence.schema_version != result.schema_version ||
  evidence.schema_version < 1 || evidence.schema_version > 2 ||
  evidence.artifact_kind != "PROMPT_EVALUATION_EVIDENCE" ||
  !verifier_valid_ascii_identifier(evidence.evaluation_id, 128) ||
  !verifier_valid_digest(evidence.evaluation_result_sha256) ||
  !verifier_valid_digest(evidence.content_sha256) ||
  evidence.expected_inputs.len() > 2_048 ||
  evidence.evaluation_result_sha256 != result.content_sha256 ||
  !verifier_trust_valid(evidence.trust) {
    return false
  }
  return match result.evaluation_id {
    None => false,
    Some(evaluation_id) => evaluation_id == evidence.evaluation_id,
  }
}

fn verifier_scope_trust_valid(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  borrow evidence: prompt_artifacts.PromptEvaluationEvidence,
) -> bool {
  return match result.scope {
    None => false,
    Some(scope) => {
      if scope.align_revision != evidence.trust.expected_align_revision ||
      scope.corpus_revision.source_kind != evidence.trust.expected_corpus_source_kind ||
      scope.corpus_revision.source_repository_id != evidence.trust.expected_corpus_source_repository_id ||
      scope.corpus_revision.source_sha256 != evidence.trust.expected_corpus_source_sha256 {
        false
      } else {
        match result.environment {
          None => true,
          Some(environment) => {
            environment.core.align_llm_commit == evidence.trust.expected_align_llm_commit &&
            environment.core.align_revision == evidence.trust.expected_align_revision
          },
        }
      }
    },
  }
}

fn verifier_compact_result_valid(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  borrow evidence: prompt_artifacts.PromptEvaluationEvidence,
) -> bool {
  if result.status != "ERROR" ||
  result.error_code != "RESULT_TOO_LARGE" ||
  !verifier_valid_text(result.error, 4_096) ||
  result.gate_eligible ||
  result.sample_count < 2 || result.sample_count > 16 ||
  result.tasks.len() != 0 ||
  result.snapshot_requests.len() != 0 ||
  result.snapshot_results.len() != 0 ||
  result.input_snapshots.len() != 0 ||
  result.snapshot_attestations.len() != 0 ||
  result.rows.len() != 0 ||
  result.task_aggregates.len() != 0 ||
  result.serious_regression_reasons.len() != 0 ||
  evidence.expected_inputs.len() != 0 {
    return false
  }

  if match result.experiment { None => false, Some(_) => true } ||
  match result.experiment_artifact { None => false, Some(_) => true } ||
  match result.parent_activation { None => false, Some(_) => true } ||
  match result.parent_activation_artifact { None => false, Some(_) => true } ||
  match result.parent_variant { None => false, Some(_) => true } ||
  match result.candidate_variant { None => false, Some(_) => true } ||
  match result.corpus_source { None => false, Some(_) => true } ||
  match result.corpus { None => false, Some(_) => true } ||
  match result.acceptance_policy_source { None => false, Some(_) => true } ||
  match result.acceptance_policy { None => false, Some(_) => true } ||
  match result.generation_policy_source { None => false, Some(_) => true } ||
  match result.generation_policy { None => false, Some(_) => true } ||
  match result.provider_control_source { None => false, Some(_) => true } ||
  match result.provider_control { None => false, Some(_) => true } ||
  match result.workspace_preflight_source { None => false, Some(_) => true } ||
  match result.workspace_preflight_request { None => false, Some(_) => true } ||
  match result.workspace_preflight { None => false, Some(_) => true } ||
  match result.environment { None => false, Some(_) => true } ||
  match result.corpus_aggregate { None => false, Some(_) => true } {
    return false
  }

  trace_valid := match result.trace_failure {
    None => false,
    Some(trace) => {
      trace.schema_version == 1 &&
      trace.artifact_kind == "PROMPT_TRACE_OVERFLOW" &&
      trace.attempted_invocation_count >= 0 &&
      trace.attempted_invocation_count <= 2_048 &&
      trace.trace_record_count >= 0 &&
      trace.trace_record_count <= 16_384 &&
      verifier_valid_digest(trace.trace_digest_sha256) &&
      verifier_valid_digest(trace.content_sha256)
    },
  }
  return trace_valid && verifier_scope_trust_valid(result, evidence)
}

// Every row carries the container's version. A version-2 document holding a version-1 row, or the
// reverse, is rejected here — before any field of a row is decoded into the scoring kernel.
fn verifier_rows_share_container_version(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  mut index := 0
  loop {
    if index >= result.rows.len() { break }
    if verifier_row_schema_version(result.rows[index]) != result.schema_version { return false }
    index = index + 1
  }
  return true
}

fn verifier_row_schema_version(borrow row: prompt_artifacts.PromptTaskRow) -> i64 {
  return row.schema_version
}

fn verifier_base_result_valid(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  if result.schema_version < 1 || result.schema_version > 2 ||
  result.artifact_kind != "PROMPT_EVALUATION_RESULT" ||
  !verifier_rows_share_container_version(result) ||
  !verifier_valid_digest(result.content_sha256) {
    return false
  }
  if !(result.status == "IMPROVED" ||
    result.status == "NO_IMPROVEMENT" ||
    result.status == "SERIOUS_REGRESSION" ||
    result.status == "INVALID_INPUT" ||
    result.status == "ERROR") {
    return false
  }
  if result.status == "IMPROVED" || result.status == "NO_IMPROVEMENT" || result.status == "SERIOUS_REGRESSION" {
    return result.error_code == "NONE" && result.error.len() == 0
  }
  if result.status == "INVALID_INPUT" {
    return verifier_valid_invalid_code(result.error_code) && verifier_valid_text(result.error, 4_096)
  }
  return verifier_valid_error_code(result.error_code) && verifier_valid_text(result.error, 4_096)
}

fn verifier_optional_i64_equal(a: Option<i64>, b: Option<i64>) -> bool {
  return match a {
    None => match b { None => true, Some(_) => false },
    Some(left) => match b { None => false, Some(right) => left == right },
  }
}

fn verifier_output_optional_equal(present: bool, number: i64, expected: Option<i64>) -> bool {
  return match expected {
    None => !present && number == 0,
    Some(value) => present && number == value,
  }
}

fn verifier_corpus_revision_valid(borrow revision: prompt_artifacts.CorpusRevision) -> bool {
  repository_valid := if revision.source_kind == "GIT_COMMIT" {
    verifier_valid_ascii_identifier(revision.source_repository_id, 128)
  } else {
    revision.source_kind == "FILE_SET" && revision.source_repository_id.len() == 0
  }
  source_valid := if revision.source_kind == "GIT_COMMIT" {
    verifier_valid_source_revision(revision.source_sha256)
  } else {
    verifier_valid_digest(revision.source_sha256)
  }
  return revision.schema_version == 1 &&
  revision.artifact_kind == "CORPUS_REVISION" &&
  repository_valid &&
  source_valid &&
  verifier_valid_digest(revision.content_sha256)
}

fn verifier_scope_valid(borrow scope: prompt_artifacts.PromptScope) -> bool {
  provider_kind_valid := scope.evaluation_provider_kind == "CLOUD_OPENAI" ||
  scope.evaluation_provider_kind == "LOCAL_OPENAI" ||
  scope.evaluation_provider_kind == "LLAMA_CPP" ||
  scope.evaluation_provider_kind == "FIXTURE"
  return scope.schema_version == 1 &&
  scope.artifact_kind == "PROMPT_SCOPE" &&
  verifier_valid_ascii_identifier(scope.repo_id, 128) &&
  verifier_valid_text(scope.repo_profile_revision, 256) &&
  verifier_valid_source_revision(scope.align_revision) &&
  verifier_valid_ascii_identifier(scope.corpus_id, 128) &&
  verifier_corpus_revision_valid(scope.corpus_revision) &&
  provider_kind_valid &&
  verifier_valid_text(scope.evaluation_provider_model, 256) &&
  verifier_valid_digest(scope.generation_policy_sha256) &&
  verifier_valid_digest(scope.acceptance_policy_sha256) &&
  verifier_valid_digest(scope.base_prompt_sha256) &&
  verifier_valid_digest(scope.repo_prompt_sha256) &&
  verifier_valid_digest(scope.content_sha256)
}

fn verifier_variant_valid(borrow variant: prompt_artifacts.PromptVariant) -> bool {
  return variant.schema_version == 1 &&
  variant.artifact_kind == "PROMPT_VARIANT" &&
  verifier_valid_ascii_identifier(variant.variant_id, 128) &&
  verifier_prompt_text_artifact_valid(variant.base_prompt, "BASE_PROMPT") &&
  verifier_prompt_text_artifact_valid(variant.repo_prompt, "REPO_PROMPT") &&
  verifier_valid_bounded_text(variant.learned_prompt_append, 8_192) &&
  verifier_context_policy_valid(variant.context_policy) &&
  verifier_valid_ascii_identifier(variant.candidate_id, 128) &&
  verifier_valid_digest(variant.content_sha256)
}

fn verifier_prompt_text_artifact_valid(
  borrow artifact: prompt_artifacts.PromptTextArtifact,
  expected_kind: str,
) -> bool {
  return artifact.schema_version == 1 &&
  artifact.artifact_kind == expected_kind &&
  verifier_valid_ascii_identifier(artifact.artifact_id, 128) &&
  verifier_valid_bounded_text(artifact.text, 65_536) &&
  verifier_valid_digest(artifact.content_sha256)
}

fn verifier_context_policy_valid(policy: prompt_artifacts.ContextPolicy) -> bool {
  return verifier_section_limit_valid(
    policy.include_patch_evaluation,
    policy.max_patch_evaluation_bytes,
    65_536,
  ) &&
  verifier_section_limit_valid(
    policy.include_failure_memory,
    policy.max_failure_context_bytes,
    65_536,
  ) &&
  policy.max_failure_events >= 0 && policy.max_failure_events <= 64 &&
  if policy.include_failure_memory { policy.max_failure_events > 0 } else { policy.max_failure_events == 0 } &&
  verifier_section_limit_valid(
    policy.include_diagnostics,
    policy.max_diagnostic_bytes_per_stream,
    65_536,
  )
}

fn verifier_variant_scope_valid(
  borrow variant: prompt_artifacts.PromptVariant,
  borrow scope: prompt_artifacts.PromptScope,
) -> bool {
  return verifier_variant_valid(variant) &&
  variant.base_prompt.content_sha256 == scope.base_prompt_sha256 &&
  variant.repo_prompt.content_sha256 == scope.repo_prompt_sha256
}

fn verifier_variant_matches(
  borrow left: prompt_artifacts.PromptVariant,
  borrow right: prompt_artifacts.PromptVariant,
) -> bool {
  return verifier_variant_valid(left) &&
  verifier_variant_valid(right) &&
  left.variant_id == right.variant_id &&
  left.content_sha256 == right.content_sha256
}

fn verifier_reference_valid(
  borrow reference: prompt_artifacts.ArtifactReference,
  expected_kind: str,
  expected_id: str,
  expected_digest: str,
) -> bool {
  return reference.artifact_kind == expected_kind &&
  verifier_valid_text(reference.path, 4_096) &&
  reference.artifact_id == expected_id &&
  reference.content_sha256 == expected_digest &&
  verifier_valid_digest(reference.content_sha256)
}

fn verifier_result_scope_matches(
  borrow scope: prompt_artifacts.PromptScope,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  return match result.scope {
    None => false,
    Some(result_scope) => verifier_scope_valid(scope) &&
    verifier_scope_valid(result_scope) &&
    scope.content_sha256 == result_scope.content_sha256,
  }
}

fn verifier_result_candidate_matches(
  borrow candidate: prompt_artifacts.PromptVariant,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  return match result.candidate_variant {
    None => false,
    Some(result_candidate) => verifier_variant_matches(candidate, result_candidate),
  }
}

fn verifier_result_parent_matches(
  borrow parent: prompt_artifacts.PromptVariant,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  return match result.parent_variant {
    None => false,
    Some(result_parent) => verifier_variant_matches(parent, result_parent),
  }
}

fn verifier_experiment_artifact_valid(
  borrow artifact: prompt_artifacts.PromptExperimentResult,
  borrow reference: prompt_artifacts.ArtifactReference,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  if artifact.schema_version != 1 ||
  artifact.artifact_kind != "PROMPT_EXPERIMENT_RESULT" ||
  artifact.status != "PROPOSED" ||
  artifact.error_code != "NONE" || artifact.error.len() != 0 ||
  artifact.proposal_elapsed_ns < 0 || artifact.proposal_elapsed_ns > 7_200_000_000_000 ||
  !verifier_valid_text(artifact.proposal_summary, 4_096) ||
  artifact.bounded_provider_output.len() != 0 ||
  !verifier_valid_digest(artifact.content_sha256) {
    return false
  }
  id_valid := match artifact.experiment_id {
    None => false,
    Some(id) => verifier_valid_ascii_identifier(id, 96) &&
    verifier_reference_valid(reference, "PROMPT_EXPERIMENT_RESULT", id, artifact.content_sha256),
  }
  if !id_valid {
    return false
  }
  scope_valid := match artifact.scope {
    None => false,
    Some(scope) => verifier_result_scope_matches(scope, result),
  }
  if !scope_valid {
    return false
  }
  parent_valid := match artifact.parent_activation {
    None => false,
    Some(parent_reference) => match result.parent_activation {
      None => false,
      Some(result_reference) => verifier_reference_identity_equal(parent_reference, result_reference),
    },
  }
  if !parent_valid { return false }
  opportunity_valid := match artifact.opportunity {
    None => false,
    Some(opportunity) => opportunity.artifact_kind == "OPPORTUNITY" &&
    verifier_valid_text(opportunity.path, 4_096) &&
    verifier_valid_text(opportunity.artifact_id, 256) &&
    verifier_valid_digest(opportunity.content_sha256),
  }
  provider_valid := match artifact.proposal_provider_kind {
    None => false,
    Some(kind) => (kind == "CLOUD_OPENAI" || kind == "LOCAL_OPENAI" || kind == "LLAMA_CPP") &&
    match artifact.proposal_provider_endpoint_id {
      None => false,
      Some(endpoint_id) => verifier_valid_text(endpoint_id, 256),
    } &&
    match artifact.proposal_provider_model {
      None => false,
      Some(model) => verifier_valid_text(model, 256),
    },
  }
  status_code_absent := match artifact.proposal_status_code { None => true, Some(_) => false }
  if !opportunity_valid || !provider_valid || !status_code_absent { return false }
  return match artifact.candidate_variant {
    None => false,
    Some(candidate) => verifier_result_candidate_matches(candidate, result) &&
    match result.parent_variant {
      None => false,
      Some(parent) => candidate.content_sha256 != parent.content_sha256,
    },
  }
}

fn verifier_reference_identity_equal(
  borrow left: prompt_artifacts.ArtifactReference,
  borrow right: prompt_artifacts.ArtifactReference,
) -> bool {
  return left.artifact_kind == right.artifact_kind &&
  left.artifact_id == right.artifact_id &&
  left.content_sha256 == right.content_sha256
}

fn verifier_experiment_pair_valid(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return match result.experiment {
    None => match result.experiment_artifact { None => true, Some(_) => false },
    Some(reference) => match result.experiment_artifact {
      None => false,
      Some(artifact) => verifier_experiment_artifact_valid(artifact, reference, result),
    },
  }
}

fn verifier_activation_valid(
  borrow activation: prompt_artifacts.PromptActivation,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  if activation.schema_version != 1 || activation.artifact_kind != "PROMPT_ACTIVATION" {
    return false
  }
  if !verifier_valid_ascii_identifier(activation.activation_id, 128) ||
  !verifier_valid_digest(activation.content_sha256) ||
  !verifier_result_scope_matches(activation.scope, result) ||
  !verifier_result_parent_matches(activation.effective_variant, result) {
    return false
  }
  parent_empty := activation.parent_activation_id.len() == 0 && activation.parent_activation_sha256.len() == 0
  parent_present := verifier_valid_ascii_identifier(activation.parent_activation_id, 128) &&
  verifier_valid_digest(activation.parent_activation_sha256)
  accepted_empty := activation.accepted_evaluation_id.len() == 0 && activation.accepted_evaluation_sha256.len() == 0
  accepted_present := verifier_valid_ascii_identifier(activation.accepted_evaluation_id, 128) &&
  verifier_valid_digest(activation.accepted_evaluation_sha256)
  rollback_empty := activation.rollback_target_activation_id.len() == 0 &&
  activation.rollback_target_activation_sha256.len() == 0
  rollback_present := verifier_valid_ascii_identifier(activation.rollback_target_activation_id, 128) &&
  verifier_valid_digest(activation.rollback_target_activation_sha256)
  if activation.operation == "BASELINE" {
    return parent_empty && accepted_empty && rollback_empty && activation.decision_reason.len() == 0
  }
  if activation.operation == "ACCEPT" {
    return parent_present && accepted_present && rollback_empty && activation.decision_reason.len() == 0
  }
  if activation.operation == "ROLLBACK" {
    return parent_present && (accepted_empty || accepted_present) && rollback_present &&
    verifier_valid_text(activation.decision_reason, 4_096)
  }
  return false
}

fn verifier_activation_artifact_valid(
  borrow artifact: prompt_artifacts.PromptActivationResult,
  borrow reference: prompt_artifacts.ArtifactReference,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  if artifact.schema_version != 1 ||
  artifact.artifact_kind != "PROMPT_ACTIVATION_RESULT" ||
  !verifier_valid_digest(artifact.content_sha256) ||
  !(artifact.status == "BASELINED" || artifact.status == "ACCEPTED" || artifact.status == "ROLLED_BACK") ||
  artifact.error_code != "NONE" ||
  artifact.error.len() != 0 {
    return false
  }
  id_valid := match artifact.decision_id {
    None => false,
    Some(id) => verifier_valid_ascii_identifier(id, 96) &&
    verifier_reference_valid(reference, "PROMPT_ACTIVATION_RESULT", id, artifact.content_sha256),
  }
  if !id_valid {
    return false
  }
  return match artifact.activation {
    None => false,
    Some(activation) => {
      operation_valid := if artifact.status == "BASELINED" {
        activation.operation == "BASELINE"
      } else if artifact.status == "ACCEPTED" {
        activation.operation == "ACCEPT"
      } else {
        activation.operation == "ROLLBACK"
      }
      operation_valid && verifier_activation_valid(activation, result)
    },
  }
}

fn verifier_parent_pair_valid(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return match result.parent_activation {
    None => match result.parent_activation_artifact { None => true, Some(_) => false },
    Some(reference) => match result.parent_activation_artifact {
      None => false,
      Some(artifact) => verifier_activation_artifact_valid(artifact, reference, result),
    },
  }
}

fn verifier_corpus_embedded_valid(
  borrow corpus: prompt_artifacts.PromptEvaluationCorpus,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  if corpus.schema_version != 1 ||
  corpus.artifact_kind != "PROMPT_EVALUATION_CORPUS" ||
  !verifier_valid_ascii_identifier(corpus.corpus_id, 128) ||
  !verifier_corpus_revision_valid(corpus.corpus_revision) ||
  corpus.task_files.len() < 1 || corpus.task_files.len() > 64 ||
  !verifier_valid_digest(corpus.content_sha256) {
    return false
  }
  mut task_file := 0
  loop {
    if task_file >= corpus.task_files.len() { break }
    if !verifier_owned_string_valid(corpus.task_files[task_file], 4_096, false) { return false }
    mut prior_file := 0
    loop {
      if prior_file >= task_file { break }
      if verifier_owned_strings_equal(corpus.task_files[prior_file], corpus.task_files[task_file]) { return false }
      prior_file = prior_file + 1
    }
    task_file = task_file + 1
  }
  return match result.corpus_source {
    None => false,
    Some(reference) => verifier_reference_valid(
      reference,
      "PROMPT_EVALUATION_CORPUS",
      corpus.corpus_id,
      corpus.content_sha256,
    ),
  }
}

fn verifier_corpus_pair_valid(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return match result.corpus {
    None => match result.corpus_source { None => true, Some(_) => false },
    Some(corpus) => verifier_corpus_embedded_valid(corpus, result),
  }
}

fn verifier_acceptance_policy_embedded_valid(
  borrow policy: prompt_artifacts.PromptAcceptancePolicy,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  if policy.schema_version != 1 ||
  policy.artifact_kind != "PROMPT_ACCEPTANCE_POLICY" ||
  !verifier_valid_ascii_identifier(policy.policy_id, 128) ||
  policy.minimum_task_count < 1 || policy.minimum_task_count > 64 ||
  policy.minimum_samples_per_variant < 2 || policy.minimum_samples_per_variant > 16 ||
  policy.minimum_completion_gain_count < 1 ||
  policy.minimum_completion_gain_count > 1_024 ||
  policy.minimum_time_improvement_ppm < 1 || policy.minimum_time_improvement_ppm > 1_000_000 ||
  policy.maximum_time_regression_ppm < 0 || policy.maximum_time_regression_ppm > 1_000_000 ||
  policy.maximum_repair_loop_regression_count < 0 || policy.maximum_repair_loop_regression_count > 65_536 ||
  !verifier_valid_digest(policy.content_sha256) {
    return false
  }
  return match result.acceptance_policy_source {
    None => false,
    Some(reference) => verifier_reference_valid(
      reference,
      "PROMPT_ACCEPTANCE_POLICY",
      policy.policy_id,
      policy.content_sha256,
    ),
  }
}

fn verifier_acceptance_policy_pair_valid(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return match result.acceptance_policy {
    None => match result.acceptance_policy_source { None => true, Some(_) => false },
    Some(policy) => verifier_acceptance_policy_embedded_valid(policy, result),
  }
}

fn verifier_generation_policy_embedded_valid(
  borrow policy: prompt_artifacts.GenerationPolicy,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  seed_end_valid := match policy.seed_base.checked_add(result.sample_count - 1) {
    None => false,
    Some(_) => true,
  }
  if policy.schema_version != 1 ||
  policy.artifact_kind != "GENERATION_POLICY" ||
  !verifier_valid_ascii_identifier(policy.generation_policy_id, 128) ||
  !verifier_valid_text(policy.evaluation_provider_kind, 256) ||
  !verifier_valid_text(policy.evaluation_provider_endpoint_id, 256) ||
  !verifier_valid_text(policy.evaluation_provider_model, 256) ||
  !verifier_valid_digest(policy.provider_control_sha256) ||
  !verifier_valid_text(policy.provider_service_revision, 256) ||
  policy.max_prompt_bytes <= 0 || policy.max_prompt_bytes > 1_048_576 ||
  policy.max_tokens <= 0 || policy.max_tokens > 1_048_576 ||
  policy.temperature_micros < 0 || policy.temperature_micros > 1_000_000 ||
  policy.seed_mode != "PAIRED_FIXED" ||
  !seed_end_valid ||
  !verifier_valid_digest(policy.content_sha256) {
    return false
  }
  return match result.generation_policy_source {
    None => false,
    Some(reference) => verifier_reference_valid(
      reference,
      "GENERATION_POLICY",
      policy.generation_policy_id,
      policy.content_sha256,
    ),
  }
}

fn verifier_generation_policy_pair_valid(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return match result.generation_policy {
    None => match result.generation_policy_source { None => true, Some(_) => false },
    Some(policy) => verifier_generation_policy_embedded_valid(policy, result),
  }
}

fn verifier_provider_control_embedded_valid(
  borrow control: prompt_artifacts.EvaluationProviderControl,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  provider_kind_valid := control.provider_kind == "CLOUD_OPENAI" ||
  control.provider_kind == "LOCAL_OPENAI" ||
  control.provider_kind == "LLAMA_CPP" ||
  control.provider_kind == "FIXTURE"
  if control.schema_version != 1 ||
  control.artifact_kind != "EVALUATION_PROVIDER_CONTROL" ||
  !verifier_valid_ascii_identifier(control.provider_control_id, 128) ||
  !provider_kind_valid ||
  !verifier_valid_text(control.endpoint, 4_096) ||
  !verifier_valid_text(control.endpoint_id, 256) ||
  !verifier_valid_text(control.model, 256) ||
  control.timeout_ns <= 0 || control.timeout_ns > 7_200_000_000_000 ||
  control.max_response_bytes <= 0 || control.max_response_bytes > 1_048_576 ||
  !verifier_valid_digest(control.content_sha256) {
    return false
  }
  api_key_valid := match control.api_key_env {
    None => control.provider_kind != "CLOUD_OPENAI",
    Some(name) => (control.provider_kind == "CLOUD_OPENAI" || control.provider_kind == "LOCAL_OPENAI") &&
    verifier_valid_environment_name(name),
  }
  tokenize_valid := match control.tokenize_endpoint {
    None => true,
    Some(endpoint) => verifier_valid_text(endpoint, 4_096),
  }
  if !api_key_valid || !tokenize_valid { return false }
  return match result.provider_control_source {
    None => false,
    Some(reference) => verifier_reference_valid(
      reference,
      "EVALUATION_PROVIDER_CONTROL",
      control.provider_control_id,
      control.content_sha256,
    ),
  }
}

fn verifier_provider_control_pair_valid(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return match result.provider_control {
    None => match result.provider_control_source { None => true, Some(_) => false },
    Some(control) => verifier_provider_control_embedded_valid(control, result),
  }
}

fn verifier_workspace_preflight_embedded_valid(
  borrow preflight: prompt_artifacts.WorkspacePreflightResult,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  if preflight.schema_version != 1 ||
  preflight.artifact_kind != "WORKSPACE_PREFLIGHT_RESULT" ||
  !verifier_valid_text(preflight.evaluation_id, 128) ||
  !verifier_valid_digest(preflight.content_sha256) {
    return false
  }
  return match result.workspace_preflight_source {
    None => false,
    Some(reference) => verifier_reference_valid(
      reference,
      "WORKSPACE_PREFLIGHT_RESULT",
      preflight.evaluation_id,
      preflight.content_sha256,
    ),
  }
}

fn verifier_workspace_preflight_pair_valid(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return match result.workspace_preflight {
    None => match result.workspace_preflight_source { None => true, Some(_) => false },
    Some(preflight) => verifier_workspace_preflight_embedded_valid(preflight, result),
  }
}

// The pair is always well-formed when present, and is *required* only in a version-2 document.
// A version-1 corpus predates the repair attempt entirely: it can declare a nonzero
// `maximum_repair_loops` that nothing could ever have consumed, and retroactively demanding a
// template it never had would reject already-frozen evidence.
fn verifier_repair_template_pairing_valid(
  borrow task: prompt_artifacts.PromptEvaluationTask,
  require_template: bool,
) -> bool {
  path_present := match task.repair_template_path { None => false, Some(_) => true }
  digest_present := match task.repair_template_sha256 {
    None => false,
    Some(value) => verifier_valid_digest(value),
  }
  if path_present != digest_present { return false }
  if !require_template { return true }
  offers_repair := task.regression_limits.maximum_repair_loops >= 1
  return path_present == offers_repair
}

fn verifier_task_valid(
  borrow task: prompt_artifacts.PromptEvaluationTask,
  require_template: bool,
) -> bool {
  limits := task.regression_limits
  return task.schema_version == 1 &&
  task.artifact_kind == "PROMPT_EVALUATION_TASK" &&
  verifier_valid_ascii_identifier(task.task_id, 128) &&
  verifier_valid_ascii_identifier(task.repo_id, 128) &&
  verifier_valid_source_revision(task.repo_revision) &&
  verifier_valid_text(task.repo_path, 4_096) &&
  verifier_valid_text(task.cmd, 4_096) &&
  verifier_valid_text(task.snapshot_cmd, 4_096) &&
  verifier_valid_text(task.measurement_adapter_runtime, 256) &&
  verifier_valid_text(task.snapshot_helper_runtime, 256) &&
  verifier_valid_text(task.cwd, 4_096) &&
  task.timeout_ns > 0 && task.timeout_ns <= 7_200_000_000_000 &&
  verifier_valid_text(task.task_prompt_path, 4_096) &&
  verifier_valid_text(task.context_sources_path, 4_096) &&
  verifier_valid_text(task.generation_policy_path, 4_096) &&
  verifier_valid_text(task.provider_control_path, 4_096) &&
  verifier_valid_text(task.environment_policy_path, 4_096) &&
  task.artifacts.len() >= 1 && task.artifacts.len() <= 4_096 &&
  limits.maximum_unrelated_diff_count >= 0 && limits.maximum_unrelated_diff_count <= 1_048_576 &&
  limits.maximum_patch_size_bytes >= 0 && limits.maximum_patch_size_bytes <= 67_108_864 &&
  limits.maximum_public_api_change_count >= 0 && limits.maximum_public_api_change_count <= 1_048_576 &&
  limits.maximum_repair_loops >= 0 && limits.maximum_repair_loops <= 64 &&
  // The sealed repair template is declared exactly when the task offers a repair attempt.
  verifier_repair_template_pairing_valid(task, require_template) &&
  match limits.maximum_benchmark_regression_ppm {
    None => true,
    Some(value) => value >= 0 && value <= 1_000_000,
  } &&
  verifier_valid_digest(task.content_sha256) &&
  verifier_command_array_valid(task.cmd, task.argv) &&
  verifier_command_array_valid(task.snapshot_cmd, task.snapshot_argv) &&
  verifier_expectation_array_valid(task.artifacts, 4_096)
}

fn verifier_command_array_valid(command: str, borrow values: array<string>) -> bool {
  if values.len() < 1 || values.len() > 64 || !verifier_owned_string_matches(values[0], command) {
    return false
  }
  mut total := 0
  mut index := 0
  loop {
    if index >= values.len() { break }
    if !verifier_owned_string_valid(values[index], 4_096, true) { return false }
    with_text := total.checked_add(verifier_owned_string_length(values[index])) else { return false }
    total = with_text.checked_add(1) else { return false }
    if total > 262_144 { return false }
    index = index + 1
  }
  return true
}

fn verifier_string_array_valid(
  borrow values: array<string>,
  maximum_count: i64,
  maximum_length: i64,
) -> bool {
  if values.len() > maximum_count { return false }
  mut index := 0
  loop {
    if index >= values.len() { break }
    if !verifier_owned_string_valid(values[index], maximum_length, true) { return false }
    index = index + 1
  }
  return true
}

fn verifier_owned_string_valid(borrow value: string, maximum: i64, allow_empty: bool) -> bool {
  if allow_empty {
    return verifier_valid_bounded_text(value, maximum)
  }
  return verifier_valid_text(value, maximum)
}

fn verifier_owned_strings_equal(borrow left: string, borrow right: string) -> bool {
  return left == right
}

fn verifier_owned_string_matches(borrow value: string, expected: str) -> bool {
  return value == expected
}

fn verifier_owned_string_length(borrow value: string) -> i64 {
  return value.len()
}

fn verifier_expectation_valid(borrow value: prompt_artifacts.ArtifactExpectation) -> bool {
  return verifier_valid_text(value.path, 4_096) &&
  (value.kind == "FILE" || value.kind == "TREE") &&
  verifier_valid_digest(value.expected_sha256)
}

fn verifier_expectation_array_valid(
  borrow values: array<prompt_artifacts.ArtifactExpectation>,
  maximum_count: i64,
) -> bool {
  if values.len() > maximum_count { return false }
  mut index := 0
  loop {
    if index >= values.len() { break }
    if !verifier_expectation_valid(values[index]) { return false }
    mut prior := 0
    loop {
      if prior >= index { break }
      if verifier_expectation_same_path(values[prior], values[index]) { return false }
      prior = prior + 1
    }
    index = index + 1
  }
  return true
}

fn verifier_expectation_same_path(
  borrow left: prompt_artifacts.ArtifactExpectation,
  borrow right: prompt_artifacts.ArtifactExpectation,
) -> bool {
  return left.path == right.path
}

fn verifier_task_limit(borrow task: prompt_artifacts.PromptEvaluationTask) -> ScoreTaskLimit {
  return ScoreTaskLimit {
    maximum_unrelated_diff_count: task.regression_limits.maximum_unrelated_diff_count,
    maximum_patch_size_bytes: task.regression_limits.maximum_patch_size_bytes,
    maximum_public_api_change_count: task.regression_limits.maximum_public_api_change_count,
    maximum_repair_loops: task.regression_limits.maximum_repair_loops,
    maximum_benchmark_regression_ppm: task.regression_limits.maximum_benchmark_regression_ppm,
  }
}

fn verifier_score_variant(value: str) -> Result<ScoreVariant, Error> {
  if value == "PARENT" {
    return Ok(ScoreVariant.Parent)
  }
  if value == "CANDIDATE" {
    return Ok(ScoreVariant.Candidate)
  }
  return Err(Error.Invalid)
}

fn verifier_score_status(value: str) -> Result<ScoreStatus, Error> {
  if value == "PASS" { return Ok(ScoreStatus.Pass) }
  if value == "FAIL" { return Ok(ScoreStatus.Fail) }
  if value == "POLICY_VIOLATION" { return Ok(ScoreStatus.PolicyViolation) }
  if value == "ERROR" { return Ok(ScoreStatus.Error) }
  return Err(Error.Invalid)
}

fn verifier_score_failure(value: str) -> Result<ScoreFailureKind, Error> {
  if value == "NONE" { return Ok(ScoreFailureKind.None) }
  if value == "PROVIDER" { return Ok(ScoreFailureKind.Provider) }
  if value == "PATCH" { return Ok(ScoreFailureKind.Patch) }
  if value == "BUILD" { return Ok(ScoreFailureKind.Build) }
  if value == "TEST" { return Ok(ScoreFailureKind.Test) }
  if value == "POLICY" { return Ok(ScoreFailureKind.Policy) }
  if value == "CLEANUP" { return Ok(ScoreFailureKind.Cleanup) }
  if value == "CONTAINMENT" { return Ok(ScoreFailureKind.Containment) }
  if value == "ADAPTER" { return Ok(ScoreFailureKind.Adapter) }
  return Err(Error.Invalid)
}

fn verifier_score_stage(value: str) -> Result<ScoreStage, Error> {
  if value == "PASS" { return Ok(ScoreStage.Pass) }
  if value == "FAIL" { return Ok(ScoreStage.Fail) }
  if value == "NOT_RUN" { return Ok(ScoreStage.NotRun) }
  if value == "ERROR" { return Ok(ScoreStage.StageError) }
  return Err(Error.Invalid)
}

fn verifier_environment_probe_valid(borrow probe: prompt_artifacts.EnvironmentProbe) -> bool {
  cpu_valid := match probe.logical_cpu_count {
    None => true,
    Some(value) => value > 0 && value <= 1_048_576,
  }
  return probe.schema_version == 1 &&
  probe.artifact_kind == "ENVIRONMENT_PROBE" &&
  verifier_valid_text(probe.producer, 256) &&
  verifier_valid_text(probe.os, 256) &&
  verifier_valid_text(probe.os_release, 256) &&
  verifier_valid_text(probe.architecture, 256) &&
  verifier_valid_text(probe.cpu, 256) &&
  cpu_valid &&
  verifier_valid_text(probe.gpu, 256) &&
  verifier_valid_text(probe.runtime_identity, 256) &&
  verifier_valid_digest(probe.content_sha256)
}

fn verifier_generation_request_valid(borrow request: prompt_artifacts.GenerationRequestIdentity) -> bool {
  return request.schema_version == 1 &&
  request.artifact_kind == "GENERATION_REQUEST_IDENTITY" &&
  verifier_valid_digest(request.rendered_prompt_sha256) &&
  verifier_valid_digest(request.system_text_sha256) &&
  verifier_valid_digest(request.user_text_sha256) &&
  verifier_valid_digest(request.generation_policy_sha256) &&
  verifier_valid_digest(request.provider_control_sha256) &&
  verifier_valid_digest(request.environment_policy_sha256) &&
  request.max_tokens > 0 &&
  request.temperature_micros >= 0 &&
  verifier_valid_digest(request.provider_request_sha256) &&
  verifier_valid_digest(request.seed_attestation_sha256) &&
  verifier_valid_digest(request.content_sha256)
}

fn verifier_seed_attestation_valid(borrow seed: prompt_artifacts.SeedCapabilityAttestation) -> bool {
  applied_valid := if seed.result == "APPLIED" {
    match seed.applied_seed { None => false, Some(value) => value == seed.requested_seed }
  } else if seed.result == "UNSUPPORTED" || seed.result == "REJECTED" {
    match seed.applied_seed { None => true, Some(_) => false }
  } else {
    false
  }
  return seed.schema_version == 1 &&
  seed.artifact_kind == "SEED_CAPABILITY_ATTESTATION" &&
  verifier_valid_text(seed.provider_kind, 256) &&
  verifier_valid_text(seed.provider_model, 256) &&
  applied_valid &&
  verifier_valid_digest(seed.provider_request_sha256) &&
  verifier_valid_digest(seed.content_sha256)
}

fn verifier_evaluation_input_valid(
  borrow input: prompt_artifacts.EvaluationInputIdentity,
  task_id: str,
  sample_index: i64,
) -> bool {
  return input.schema_version == 1 &&
  input.artifact_kind == "EVALUATION_INPUT_IDENTITY" &&
  input.task_id == task_id &&
  input.sample_index == sample_index &&
  verifier_valid_digest(input.task_input_snapshot_sha256) &&
  verifier_valid_digest(input.parent_variant_sha256) &&
  verifier_valid_digest(input.candidate_variant_sha256) &&
  verifier_valid_digest(input.task_prompt_sha256) &&
  verifier_valid_digest(input.context_sources_sha256) &&
  verifier_valid_digest(input.generation_policy_sha256) &&
  verifier_valid_digest(input.generation_request_sha256) &&
  verifier_valid_digest(input.adapter_request_sha256) &&
  verifier_valid_digest(input.environment_policy_sha256) &&
  verifier_valid_digest(input.environment_sha256) &&
  verifier_valid_digest(input.content_sha256)
}

fn verifier_measurement_valid(
  borrow measurement: prompt_artifacts.TaskMeasurement,
  borrow task: prompt_artifacts.PromptEvaluationTask,
) -> bool {
  generation_time_valid := match measurement.generation_to_passing_patch_ns {
    None => true,
    Some(value) => value > 0 && value <= 7_200_000_000_000,
  }
  benchmark_valid := match task.regression_limits.maximum_benchmark_regression_ppm {
    None => match measurement.benchmark_regression_ppm { None => true, Some(_) => false },
    Some(_) => if measurement.status == "PASS" {
      match measurement.benchmark_regression_ppm {
        None => false,
        Some(value) => value >= 0 && value <= 1_000_000,
      }
    } else {
      match measurement.benchmark_regression_ppm { None => true, Some(_) => false }
    },
  }
  return measurement.schema_version == 1 &&
  measurement.artifact_kind == "TASK_MEASUREMENT" &&
  measurement.repair_loop_count >= 0 && measurement.repair_loop_count <= 64 &&
  measurement.unrelated_diff_count >= 0 && measurement.unrelated_diff_count <= 1_048_576 &&
  measurement.patch_size_bytes >= 0 && measurement.patch_size_bytes <= 67_108_864 &&
  measurement.public_api_change_count >= 0 && measurement.public_api_change_count <= 1_048_576 &&
  measurement.policy_violation_count >= 0 && measurement.policy_violation_count <= 1_048_576 &&
  benchmark_valid &&
  generation_time_valid &&
  verifier_valid_digest(measurement.rendered_prompt_sha256) &&
  verifier_generation_request_valid(measurement.generation_request) &&
  verifier_environment_probe_valid(measurement.environment_probe) &&
  verifier_seed_attestation_valid(measurement.seed_attestation) &&
  measurement.generation_request.provider_request_sha256 == measurement.seed_attestation.provider_request_sha256 &&
  verifier_valid_bounded_text(measurement.diagnostic_summary, 4_096) &&
  verifier_valid_bounded_text(measurement.diagnostic_stdout, 16_384) &&
  verifier_valid_bounded_text(measurement.diagnostic_stderr, 16_384) &&
  verifier_valid_digest(measurement.content_sha256)
}

// --- C4-REPAIR-MEASURED: version-2 attempt records ---------------------------------------------
// Every access to an array element goes straight into a `borrow` parameter. The pinned compiler
// rejects binding a Move-typed element to a local and rejects reading a Move-typed field out of an
// element expression, so an element is never named, only passed.

fn verifier_repair_section_ordinal(borrow value: string) -> i64 {
  if value == "STATUS" { return 0 }
  if value == "SUMMARY" { return 1 }
  if value == "STDOUT" { return 2 }
  if value == "STDERR" { return 3 }
  return -1
}

// A section list is a subset of the four kinds in their one fixed order, with no repeats.
fn verifier_repair_section_list_valid(borrow values: array<string>) -> bool {
  if values.len() > 4 { return false }
  mut previous := -1
  mut index := 0
  loop {
    if index >= values.len() { break }
    ordinal := verifier_repair_section_ordinal(values[index])
    if ordinal < 0 || ordinal <= previous { return false }
    previous = ordinal
    index = index + 1
  }
  return true
}

fn verifier_repair_sections_disjoint(
  borrow included: array<string>,
  borrow dropped: array<string>,
) -> bool {
  mut outer := 0
  loop {
    if outer >= included.len() { break }
    left := verifier_repair_section_ordinal(included[outer])
    mut inner := 0
    loop {
      if inner >= dropped.len() { break }
      right := verifier_repair_section_ordinal(dropped[inner])
      if left == right { return false }
      inner = inner + 1
    }
    outer = outer + 1
  }
  return true
}

// `STATUS` is never dropped: it is at most 128 bytes and the single most load-bearing fact.
fn verifier_repair_sections_exclude_status(borrow dropped: array<string>) -> bool {
  mut index := 0
  loop {
    if index >= dropped.len() { break }
    if verifier_repair_section_ordinal(dropped[index]) == 0 { return false }
    index = index + 1
  }
  return true
}

fn verifier_repair_prompt_source_valid(
  borrow source: prompt_artifacts.RepairPromptSource,
  max_prompt_bytes: i64,
) -> bool {
  return source.schema_version == 1 &&
  source.artifact_kind == "REPAIR_PROMPT_SOURCE" &&
  verifier_valid_digest(source.template_sha256) &&
  source.source_attempt_index == 1 &&
  verifier_valid_digest(source.source_measurement_sha256) &&
  verifier_repair_section_list_valid(source.included_sections) &&
  verifier_repair_section_list_valid(source.dropped_sections) &&
  verifier_repair_sections_disjoint(source.included_sections, source.dropped_sections) &&
  verifier_repair_sections_exclude_status(source.dropped_sections) &&
  source.assembled_bytes > 0 && source.assembled_bytes <= max_prompt_bytes &&
  verifier_valid_digest(source.content_sha256)
}

fn verifier_attempt_kind_valid(borrow value: string) -> bool {
  return value == "INITIAL" || value == "REPAIR"
}

fn verifier_attempt_status_valid(borrow value: string) -> bool {
  return value == "PASS" || value == "FAIL" || value == "POLICY_VIOLATION" ||
  value == "ERROR" || value == "SKIPPED"
}

fn verifier_skip_reason_valid(borrow value: string) -> bool {
  return value == "NONE" || value == "REPAIR_PROMPT_BUDGET" ||
  value == "REPAIR_NOT_ELIGIBLE" || value == "REPAIR_INPUT_UNAVAILABLE"
}

fn verifier_optional_digest_absent(borrow value: Option<string>) -> bool {
  return match value { None => true, Some(_) => false }
}

fn verifier_optional_i64_absent(value: Option<i64>) -> bool {
  return match value { None => true, Some(_) => false }
}

// Field-wise equality of two persisted measurements. An owned encode cannot be taken from a
// borrowed record, so ladder row 18's "byte-equal" is discharged field by field, including every
// nested record's own content digest.
fn verifier_measurement_equal(
  borrow left: prompt_artifacts.TaskMeasurement,
  borrow right: prompt_artifacts.TaskMeasurement,
) -> bool {
  return left.schema_version == right.schema_version &&
  left.artifact_kind == right.artifact_kind &&
  left.status == right.status &&
  left.failure_kind == right.failure_kind &&
  left.build_status == right.build_status &&
  left.test_status == right.test_status &&
  left.repair_loop_count == right.repair_loop_count &&
  left.unrelated_diff_count == right.unrelated_diff_count &&
  left.patch_size_bytes == right.patch_size_bytes &&
  left.public_api_change_count == right.public_api_change_count &&
  left.policy_violation_count == right.policy_violation_count &&
  left.cleanup_passed == right.cleanup_passed &&
  left.containment_passed == right.containment_passed &&
  verifier_optional_i64_equal(left.benchmark_regression_ppm, right.benchmark_regression_ppm) &&
  verifier_optional_i64_equal(left.generation_to_passing_patch_ns, right.generation_to_passing_patch_ns) &&
  left.rendered_prompt_sha256 == right.rendered_prompt_sha256 &&
  left.generation_request.content_sha256 == right.generation_request.content_sha256 &&
  left.environment_probe.content_sha256 == right.environment_probe.content_sha256 &&
  left.seed_attestation.content_sha256 == right.seed_attestation.content_sha256 &&
  left.diagnostic_summary == right.diagnostic_summary &&
  left.diagnostic_stdout == right.diagnostic_stdout &&
  left.diagnostic_stderr == right.diagnostic_stderr &&
  left.content_sha256 == right.content_sha256
}

fn verifier_valid_optional_digest_present(borrow value: Option<string>) -> bool {
  return match value { None => false, Some(digest_value) => verifier_valid_digest(digest_value) }
}

fn verifier_skipped_attempt_valid(borrow attempt: prompt_artifacts.TaskAttemptRecord) -> bool {
  return attempt.adapter_elapsed_ns == 0 &&
  verifier_optional_digest_absent(attempt.rendered_prompt_sha256) &&
  verifier_optional_digest_absent(attempt.adapter_request_sha256) &&
  // A skipped repair made no contained invocation, so it attests no trace record.
  verifier_optional_digest_absent(attempt.snapshot_request_sha256) &&
  verifier_optional_digest_absent(attempt.before_snapshot_result_sha256) &&
  verifier_optional_digest_absent(attempt.after_snapshot_result_sha256) &&
  verifier_optional_digest_absent(attempt.input_snapshot_sha256) &&
  verifier_optional_digest_absent(attempt.measurement_sha256) &&
  verifier_optional_i64_absent(attempt.adapter_overhead_ns) &&
  match attempt.generation_request { None => true, Some(_) => false } &&
  match attempt.seed_attestation { None => true, Some(_) => false } &&
  match attempt.measurement { None => true, Some(_) => false }
}

fn verifier_ran_attempt_valid(
  borrow attempt: prompt_artifacts.TaskAttemptRecord,
  borrow task: prompt_artifacts.PromptEvaluationTask,
) -> bool {
  return match attempt.measurement {
    None => false,
    Some(measurement) => verifier_measurement_valid(measurement, task) &&
    // Each adapter invocation is single-attempt by construction, so a non-zero count here means
    // the adapter reported a loop it cannot have run.
    measurement.repair_loop_count == 0 &&
    measurement.status == attempt.status &&
    match attempt.measurement_sha256 {
      None => false,
      Some(digest_value) => digest_value == measurement.content_sha256,
    } &&
    match attempt.rendered_prompt_sha256 {
      None => false,
      Some(rendered) => rendered == measurement.rendered_prompt_sha256,
    } &&
    match attempt.generation_request {
      None => false,
      Some(request) => request.content_sha256 == measurement.generation_request.content_sha256,
    } &&
    match attempt.seed_attestation {
      None => false,
      Some(attestation) => attestation.content_sha256 == measurement.seed_attestation.content_sha256,
    } &&
    match attempt.adapter_request_sha256 { None => false, Some(_) => true } &&
    // An attempt that ran attests the four trace records its invocation produced.
    verifier_valid_optional_digest_present(attempt.snapshot_request_sha256) &&
    verifier_valid_optional_digest_present(attempt.before_snapshot_result_sha256) &&
    verifier_valid_optional_digest_present(attempt.after_snapshot_result_sha256) &&
    verifier_valid_optional_digest_present(attempt.input_snapshot_sha256) &&
    // Present exactly on a passing attempt, and never clamped: it is the evaluator-observed span
    // minus the adapter's own reported window.
    match attempt.adapter_overhead_ns {
      None => measurement.status != "PASS",
      Some(overhead) => measurement.status == "PASS" && overhead >= 0 &&
      match measurement.generation_to_passing_patch_ns {
        None => false,
        Some(window) => overhead == attempt.adapter_elapsed_ns - window,
      },
    },
  }
}

fn verifier_attempt_valid(
  borrow attempt: prompt_artifacts.TaskAttemptRecord,
  borrow task: prompt_artifacts.PromptEvaluationTask,
  expected_index: i64,
  paired_seed: i64,
  max_prompt_bytes: i64,
) -> bool {
  structural := attempt.schema_version == 1 &&
  attempt.artifact_kind == "TASK_ATTEMPT_RECORD" &&
  attempt.attempt_index == expected_index &&
  verifier_attempt_kind_valid(attempt.attempt_kind) &&
  verifier_attempt_status_valid(attempt.status) &&
  verifier_skip_reason_valid(attempt.skip_reason) &&
  // A skip reason is recorded exactly when the attempt was skipped.
  (attempt.skip_reason == "NONE") != (attempt.status == "SKIPPED") &&
  // Attempt one is the initial attempt; every later attempt is a repair.
  (expected_index == 1) == (attempt.attempt_kind == "INITIAL") &&
  attempt.paired_seed == paired_seed &&
  attempt.repair_preparation_ns >= 0 &&
  attempt.repair_preparation_ns <= 7_200_000_000_000 &&
  attempt.adapter_elapsed_ns >= 0 &&
  attempt.adapter_elapsed_ns <= 7_200_000_000_000 &&
  (expected_index != 1 || attempt.repair_preparation_ns == 0) &&
  verifier_valid_digest(attempt.content_sha256)
  if !structural { return false }
  source_valid := match attempt.repair_prompt_source {
    None => true,
    // Only a repair attempt carries a repair-prompt source.
    Some(source) => attempt.attempt_kind == "REPAIR" &&
    verifier_repair_prompt_source_valid(source, max_prompt_bytes),
  }
  if !source_valid { return false }
  if attempt.status == "SKIPPED" { return verifier_skipped_attempt_valid(attempt) }
  return verifier_ran_attempt_valid(attempt, task)
}

fn verifier_attempt_is_kind(borrow attempt: prompt_artifacts.TaskAttemptRecord, expected: str) -> bool {
  return attempt.attempt_kind == expected
}

fn verifier_attempt_is_status(borrow attempt: prompt_artifacts.TaskAttemptRecord, expected: str) -> bool {
  return attempt.status == expected
}

fn verifier_attempt_elapsed_ns(borrow attempt: prompt_artifacts.TaskAttemptRecord) -> i64 {
  return attempt.adapter_elapsed_ns
}

fn verifier_attempt_preparation_ns(borrow attempt: prompt_artifacts.TaskAttemptRecord) -> i64 {
  return attempt.repair_preparation_ns
}

fn verifier_attempt_measurement_equals(
  borrow attempt: prompt_artifacts.TaskAttemptRecord,
  borrow expected: prompt_artifacts.TaskMeasurement,
) -> bool {
  return match attempt.measurement {
    None => false,
    Some(measurement) => verifier_measurement_equal(measurement, expected),
  }
}

RowRepairFacts {
  repair_loop_count: i64,
  generation_to_passing_patch_ns: Option<i64>,
}

fn verifier_attempts_walk(
  borrow attempts: array<prompt_artifacts.TaskAttemptRecord>,
  borrow task: prompt_artifacts.PromptEvaluationTask,
  borrow row_measurement: prompt_artifacts.TaskMeasurement,
  paired_seed: i64,
  max_prompt_bytes: i64,
) -> Result<RowRepairFacts, Error> {
  // Bounded before the list is walked: one initial attempt plus the task's own declared cap.
  if attempts.len() < 1 { return Err(Error.Invalid) }
  if attempts.len() > 1 + task.regression_limits.maximum_repair_loops { return Err(Error.Invalid) }
  mut initial_count := 0
  mut repair_count := 0
  mut total := 0
  mut passed := false
  mut generation_ns: Option<i64> := None
  mut last_ran := -1
  mut index := 0
  loop {
    if index >= attempts.len() { break }
    if !verifier_attempt_valid(attempts[index], task, index + 1, paired_seed, max_prompt_bytes) {
      return Err(Error.Invalid)
    }
    if verifier_attempt_is_kind(attempts[index], "INITIAL") {
      initial_count = initial_count + 1
    }
    if !verifier_attempt_is_status(attempts[index], "SKIPPED") {
      if verifier_attempt_is_kind(attempts[index], "REPAIR") {
        repair_count = repair_count + 1
      }
      last_ran = index
      if !passed {
        total = total.checked_add(verifier_attempt_elapsed_ns(attempts[index])) else {
          return Err(Error.Invalid)
        }
        total = total.checked_add(verifier_attempt_preparation_ns(attempts[index])) else {
          return Err(Error.Invalid)
        }
        if verifier_attempt_is_status(attempts[index], "PASS") {
          if total <= 0 || total > 7_200_000_000_000 { return Err(Error.Invalid) }
          passed = true
          generation_ns = Some(total)
        }
      }
    }
    index = index + 1
  }
  if initial_count != 1 || repair_count > 1 || last_ran < 0 { return Err(Error.Invalid) }
  // Ladder row 18: the row-level view is the final attempt that actually ran, so every existing
  // consumer of `row.measurement.*` keeps reading the same document it always did.
  if !verifier_attempt_measurement_equals(attempts[last_ran], row_measurement) {
    return Err(Error.Invalid)
  }
  return Ok(RowRepairFacts {
      repair_loop_count: repair_count,
      generation_to_passing_patch_ns: generation_ns,
    })
}

// A version-1 row has no row-level repair count, no row-level generation total, and no attempt
// list, and is never given a compatibility default for one. The scorer selects by version; this
// rejection is what keeps presence from ever standing in for a version.
fn verifier_row_v2_members_absent(borrow row: prompt_artifacts.PromptTaskRow) -> bool {
  return verifier_optional_i64_absent(row.repair_loop_count) &&
  verifier_optional_i64_absent(row.generation_to_passing_patch_ns) &&
  match row.attempts { None => true, Some(_) => false }
}

fn verifier_row_attempts_facts(
  borrow row: prompt_artifacts.PromptTaskRow,
  borrow task: prompt_artifacts.PromptEvaluationTask,
  max_prompt_bytes: i64,
) -> Result<RowRepairFacts, Error> {
  return match row.attempts {
    None => Err(Error.Invalid),
    Some(attempts) => verifier_attempts_walk(
      attempts,
      task,
      row.measurement,
      row.evaluation_input.paired_seed,
      max_prompt_bytes,
    ),
  }
}

fn verifier_row_repair_facts(
  borrow row: prompt_artifacts.PromptTaskRow,
  borrow task: prompt_artifacts.PromptEvaluationTask,
  max_prompt_bytes: i64,
) -> Result<RowRepairFacts, Error> {
  if row.schema_version == 1 {
    if !verifier_row_v2_members_absent(row) { return Err(Error.Invalid) }
    return Ok(RowRepairFacts {
        repair_loop_count: row.measurement.repair_loop_count,
        generation_to_passing_patch_ns: row.measurement.generation_to_passing_patch_ns,
      })
  }
  facts := verifier_row_attempts_facts(row, task, max_prompt_bytes)?
  declared_loops := match row.repair_loop_count {
    None => -1,
    Some(value) => value,
  }
  if declared_loops != facts.repair_loop_count ||
  declared_loops > task.regression_limits.maximum_repair_loops {
    return Err(Error.Invalid)
  }
  if !verifier_optional_i64_equal(row.generation_to_passing_patch_ns, facts.generation_to_passing_patch_ns) {
    return Err(Error.Invalid)
  }
  return Ok(facts)
}

fn verifier_score_row(
  borrow row: prompt_artifacts.PromptTaskRow,
  borrow task: prompt_artifacts.PromptEvaluationTask,
  evaluation_id: str,
  task_ordinal: i64,
  max_prompt_bytes: i64,
) -> Result<ScoreRow, Error> {
  if row.schema_version < 1 || row.schema_version > 2 ||
  row.artifact_kind != "PROMPT_TASK_ROW" ||
  row.evaluation_id != evaluation_id ||
  row.task_id != task.task_id ||
  row.sample_index < 1 ||
  !verifier_valid_text(row.variant_id, 256) ||
  !verifier_valid_digest(row.variant_sha256) ||
  row.prompt_preparation_ns < 0 || row.prompt_preparation_ns > 7_200_000_000_000 ||
  !verifier_evaluation_input_valid(row.evaluation_input, task.task_id, row.sample_index) ||
  !verifier_measurement_valid(row.measurement, task) ||
  row.measurement.rendered_prompt_sha256 != row.measurement.generation_request.rendered_prompt_sha256 ||
  !verifier_valid_digest(row.content_sha256) {
    return Err(Error.Invalid)
  }

  // Version-selected sourcing. At version 1 the authority is the measurement; at version 2 it is
  // the row, recomputed from the attempt list and never trusted as persisted.
  facts := verifier_row_repair_facts(row, task, max_prompt_bytes)?
  total_time_valid := match facts.generation_to_passing_patch_ns {
    None => match row.time_to_passing_patch_ns { None => true, Some(_) => false },
    Some(generation_time) => match row.time_to_passing_patch_ns {
      None => false,
      Some(total) => {
        computed := row.prompt_preparation_ns.checked_add(generation_time) else { return Err(Error.Invalid) }
        total == computed && total > 0 && total <= 7_200_000_000_000
      },
    },
  }
  if !total_time_valid {
    return Err(Error.Invalid)
  }

  variant := verifier_score_variant(row.variant)?
  status := verifier_score_status(row.measurement.status)?
  failure := verifier_score_failure(row.measurement.failure_kind)?
  build := verifier_score_stage(row.measurement.build_status)?
  test := verifier_score_stage(row.measurement.test_status)?
  return Ok(ScoreRow {
      task_ordinal: task_ordinal,
      sample_index: row.sample_index,
      variant: variant,
      status: status,
      failure_kind: failure,
      build_status: build,
      test_status: test,
      repair_loop_count: facts.repair_loop_count,
      unrelated_diff_count: row.measurement.unrelated_diff_count,
      patch_size_bytes: row.measurement.patch_size_bytes,
      public_api_change_count: row.measurement.public_api_change_count,
      policy_violation_count: row.measurement.policy_violation_count,
      cleanup_passed: row.measurement.cleanup_passed,
      containment_passed: row.measurement.containment_passed,
      adapter_error: row.measurement.failure_kind == "ADAPTER",
      prompt_preparation_ns: row.prompt_preparation_ns,
      generation_to_passing_patch_ns: facts.generation_to_passing_patch_ns,
      time_to_passing_patch_ns: row.time_to_passing_patch_ns,
      benchmark_regression_ppm: row.measurement.benchmark_regression_ppm,
    })
}

fn verifier_expected_input_matches(
  borrow expected: prompt_artifacts.PromptExpectedInputDigest,
  borrow row: prompt_artifacts.PromptTaskRow,
) -> bool {
  return expected.schema_version == 1 &&
  expected.artifact_kind == "PROMPT_EXPECTED_INPUT_DIGEST" &&
  verifier_optional_i64_absent(expected.attempt_index) &&
  expected.task_id == row.task_id &&
  expected.sample_index == row.sample_index &&
  expected.variant == row.variant &&
  verifier_valid_digest(expected.rendered_prompt_sha256) &&
  verifier_valid_digest(expected.context_sources_sha256) &&
  verifier_valid_digest(expected.generation_request_sha256) &&
  verifier_valid_digest(expected.adapter_request_sha256) &&
  verifier_valid_digest(expected.provider_request_sha256) &&
  verifier_valid_digest(expected.content_sha256) &&
  expected.rendered_prompt_sha256 == row.measurement.rendered_prompt_sha256 &&
  expected.context_sources_sha256 == row.evaluation_input.context_sources_sha256 &&
  expected.generation_request_sha256 == row.evaluation_input.generation_request_sha256 &&
  expected.adapter_request_sha256 == row.evaluation_input.adapter_request_sha256 &&
  expected.provider_request_sha256 == row.measurement.generation_request.provider_request_sha256
}

fn verifier_environment_core_valid(borrow core: prompt_artifacts.EnvironmentIdentityCore) -> bool {
  cpu_valid := match core.logical_cpu_count {
    None => true,
    Some(value) => value > 0 && value <= 1_048_576,
  }
  return core.schema_version == 1 &&
  core.artifact_kind == "ENVIRONMENT_IDENTITY_CORE" &&
  verifier_valid_text(core.os, 256) &&
  verifier_valid_text(core.os_release, 256) &&
  verifier_valid_text(core.architecture, 256) &&
  verifier_valid_text(core.cpu, 256) &&
  cpu_valid &&
  verifier_valid_text(core.gpu, 256) &&
  verifier_valid_source_revision(core.align_llm_commit) &&
  verifier_valid_source_revision(core.align_revision) &&
  verifier_valid_text(core.measurement_adapter_runtime, 256) &&
  verifier_valid_text(core.snapshot_helper_runtime, 256) &&
  verifier_valid_text(core.source_verifier_runtime, 256) &&
  verifier_valid_digest(core.source_verifier_policy_sha256) &&
  verifier_valid_digest(core.environment_policy_sha256)
}

fn verifier_environment_valid(borrow environment: prompt_artifacts.EnvironmentIdentity) -> bool {
  return environment.schema_version == 1 &&
  environment.artifact_kind == "ENVIRONMENT_IDENTITY" &&
  verifier_environment_core_valid(environment.core) &&
  verifier_valid_digest(environment.environment_id) &&
  verifier_valid_digest(environment.content_sha256)
}

fn verifier_probe_matches_environment(
  borrow probe: prompt_artifacts.EnvironmentProbe,
  borrow environment: prompt_artifacts.EnvironmentIdentity,
) -> bool {
  return verifier_environment_probe_valid(probe) &&
  verifier_environment_valid(environment) &&
  probe.os == environment.core.os &&
  probe.os_release == environment.core.os_release &&
  probe.architecture == environment.core.architecture &&
  probe.cpu == environment.core.cpu &&
  verifier_optional_i64_equal(probe.logical_cpu_count, environment.core.logical_cpu_count) &&
  probe.gpu == environment.core.gpu
}

fn verifier_result_environment_matches_probe(
  borrow probe: prompt_artifacts.EnvironmentProbe,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  return match result.environment {
    None => false,
    Some(environment) => verifier_probe_matches_environment(probe, environment),
  }
}

fn verifier_task_id_matches(borrow task: prompt_artifacts.PromptEvaluationTask, task_id: str) -> bool {
  return task.task_id == task_id
}

fn verifier_find_task_ordinal(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  task_id: str,
) -> i64 {
  mut index := 0
  loop {
    if index >= result.tasks.len() { break }
    if verifier_task_id_matches(result.tasks[index], task_id) {
      return index
    }
    index = index + 1
  }
  return -1
}

fn verifier_tasks_valid(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  if result.tasks.len() < 1 || result.tasks.len() > 64 {
    return false
  }
  mut index := 0
  loop {
    if index >= result.tasks.len() { break }
    if !verifier_task_valid(result.tasks[index], result.schema_version >= 2) {
      return false
    }
    if !verifier_task_context_valid(result.tasks[index], result) { return false }
    if index > 0 && !verifier_snapshot_helper_equal(result.tasks[0], result.tasks[index]) {
      return false
    }
    mut prior := 0
    loop {
      if prior >= index { break }
      if verifier_task_id_matches(result.tasks[prior], result.tasks[index].task_id) {
        return false
      }
      prior = prior + 1
    }
    index = index + 1
  }
  return match result.corpus {
    None => false,
    Some(corpus) => corpus.task_files.len() == result.tasks.len(),
  }
}

fn verifier_task_context_valid(
  borrow task: prompt_artifacts.PromptEvaluationTask,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  scope_valid := match result.scope {
    None => false,
    Some(scope) => task.repo_id == scope.repo_id,
  }
  environment_valid := match result.environment {
    None => true,
    Some(environment) => task.measurement_adapter_runtime == environment.core.measurement_adapter_runtime &&
    task.snapshot_helper_runtime == environment.core.snapshot_helper_runtime,
  }
  return scope_valid && environment_valid
}

fn verifier_snapshot_helper_equal(
  borrow first: prompt_artifacts.PromptEvaluationTask,
  borrow current: prompt_artifacts.PromptEvaluationTask,
) -> bool {
  return first.snapshot_cmd == current.snapshot_cmd &&
  first.cwd == current.cwd &&
  first.snapshot_helper_runtime == current.snapshot_helper_runtime &&
  verifier_string_arrays_equal(first.snapshot_argv, current.snapshot_argv)
}

fn verifier_string_arrays_equal(borrow left: array<string>, borrow right: array<string>) -> bool {
  if left.len() != right.len() { return false }
  mut index := 0
  loop {
    if index >= left.len() { break }
    if !verifier_owned_strings_equal(left[index], right[index]) { return false }
    index = index + 1
  }
  return true
}

fn verifier_artifact_digest_valid(borrow digest: prompt_artifacts.ArtifactDigest) -> bool {
  return verifier_valid_text(digest.path, 4_096) &&
  verifier_valid_text(digest.mode, 16) &&
  digest.byte_count >= 0 &&
  verifier_valid_digest(digest.sha256)
}

fn verifier_artifact_digest_equal(
  borrow left: prompt_artifacts.ArtifactDigest,
  borrow right: prompt_artifacts.ArtifactDigest,
) -> bool {
  return verifier_artifact_digest_valid(left) &&
  verifier_artifact_digest_valid(right) &&
  left.path == right.path &&
  left.mode == right.mode &&
  left.byte_count == right.byte_count &&
  left.sha256 == right.sha256
}

fn verifier_file_expectation_matches(
  borrow expectation: prompt_artifacts.ArtifactExpectation,
  borrow digest: prompt_artifacts.ArtifactDigest,
) -> bool {
  mut canonical := buffer(0)
  canonical.append(digest.mode.bytes())
  canonical.append(" ".bytes())
  canonical.append(digest.path.bytes())
  canonical.append("\0F ".bytes())
  canonical.append(digest.sha256.bytes())
  canonical.append("\n".bytes())
  text := canonical.bytes().as_str() else { return false }
  hashed := crypto.sha256(text)
  observed := encoding.hex_encode(hashed[0..hashed.len()])
  return observed == expectation.expected_sha256
}

fn verifier_path_is_tree_descendant(path: str, root: str) -> bool {
  path_bytes := path.bytes()
  root_bytes := root.bytes()
  if path_bytes.len() <= root_bytes.len() + 1 { return false }
  mut index := 0
  loop {
    if index >= root_bytes.len() { break }
    if path_bytes[index] != root_bytes[index] { return false }
    index = index + 1
  }
  return path_bytes[root_bytes.len()] == 0x2f
}

fn verifier_snapshot_artifact_closure(
  borrow request: prompt_artifacts.SnapshotRequest,
  borrow snapshot: prompt_artifacts.SnapshotResult,
) -> bool {
  mut digest_index := 0
  mut expectation_index := 0
  loop {
    if expectation_index >= request.static_expectations.len() { break }
    if digest_index >= snapshot.artifact_digests.len() ||
    snapshot.artifact_digests[digest_index].path != request.static_expectations[expectation_index].path {
      return false
    }
    digest_matches := if request.static_expectations[expectation_index].kind == "FILE" {
      verifier_file_expectation_matches(
        request.static_expectations[expectation_index],
        snapshot.artifact_digests[digest_index],
      )
    } else {
      snapshot.artifact_digests[digest_index].sha256 ==
      request.static_expectations[expectation_index].expected_sha256
    }
    if !digest_matches {
      return false
    }
    if request.static_expectations[expectation_index].kind == "FILE" {
      digest_index = digest_index + 1
    } else {
      root := request.static_expectations[expectation_index].path
      digest_index = digest_index + 1
      loop {
        if digest_index >= snapshot.artifact_digests.len() ||
        !verifier_path_is_tree_descendant(snapshot.artifact_digests[digest_index].path, root) {
          break
        }
        digest_index = digest_index + 1
      }
    }
    expectation_index = expectation_index + 1
  }
  mut additional_index := 0
  loop {
    if additional_index >= request.additional_files.len() { break }
    if digest_index >= snapshot.artifact_digests.len() ||
    !verifier_owned_string_matches(
      request.additional_files[additional_index],
      snapshot.artifact_digests[digest_index].path,
    ) {
      return false
    }
    digest_index = digest_index + 1
    additional_index = additional_index + 1
  }
  return digest_index == snapshot.artifact_digests.len()
}

fn verifier_snapshot_request_valid(borrow request: prompt_artifacts.SnapshotRequest) -> bool {
  return request.schema_version == 1 &&
  request.artifact_kind == "SNAPSHOT_REQUEST" &&
  verifier_valid_text(request.task_id, 256) &&
  verifier_valid_text(request.project_root, 4_096) &&
  verifier_valid_text(request.repo_path, 4_096) &&
  verifier_valid_text(request.repo_revision, 256) &&
  verifier_valid_text(request.workspace_path, 4_096) &&
  verifier_expectation_array_valid(request.static_expectations, 4_096) &&
  verifier_string_array_valid(request.additional_files, 4_096, 4_096) &&
  verifier_string_array_valid(request.allowed_workspace_entries, 4_096, 4_096) &&
  verifier_valid_digest(request.content_sha256)
}

fn verifier_snapshot_request_matches(
  borrow request: prompt_artifacts.SnapshotRequest,
  digest: str,
  task_id: str,
) -> bool {
  return verifier_snapshot_request_valid(request) &&
  request.content_sha256 == digest &&
  request.task_id == task_id
}

fn verifier_snapshot_result_valid(borrow snapshot: prompt_artifacts.SnapshotResult) -> bool {
  status_valid := if snapshot.status == "MATCH" {
    snapshot.error_code == "NONE" && snapshot.error.len() == 0 &&
    match snapshot.environment_probe { None => false, Some(probe) => verifier_environment_probe_valid(probe) }
  } else if snapshot.status == "MISMATCH" {
    (snapshot.error_code == "PATH" ||
      snapshot.error_code == "TYPE" ||
      snapshot.error_code == "MODE" ||
      snapshot.error_code == "CONTENT" ||
      snapshot.error_code == "TREE" ||
      snapshot.error_code == "REPO_REVISION" ||
      snapshot.error_code == "DIRTY_REPO") &&
    verifier_valid_text(snapshot.error, 4_096) &&
    match snapshot.environment_probe { None => false, Some(probe) => verifier_environment_probe_valid(probe) }
  } else if snapshot.status == "ERROR" {
    verifier_valid_text(snapshot.error, 4_096) &&
    if snapshot.error_code == "ENVIRONMENT" {
      match snapshot.environment_probe { None => true, Some(_) => false }
    } else if snapshot.error_code == "INTERNAL" || snapshot.error_code == "CLEANUP" {
      match snapshot.environment_probe {
        None => false,
        Some(probe) => verifier_environment_probe_valid(probe),
      }
    } else {
      false
    }
  } else {
    false
  }
  if snapshot.schema_version != 1 ||
  snapshot.artifact_kind != "SNAPSHOT_RESULT" ||
  !verifier_valid_text(snapshot.task_id, 256) ||
  !status_valid ||
  snapshot.artifact_digests.len() > 4_096 ||
  !verifier_valid_digest(snapshot.content_sha256) {
    return false
  }
  mut index := 0
  loop {
    if index >= snapshot.artifact_digests.len() { break }
    if !verifier_artifact_digest_valid(snapshot.artifact_digests[index]) {
      return false
    }
    mut prior := 0
    loop {
      if prior >= index { break }
      if verifier_artifact_digest_same_path(snapshot.artifact_digests[prior], snapshot.artifact_digests[index]) {
        return false
      }
      prior = prior + 1
    }
    index = index + 1
  }
  return true
}

fn verifier_snapshot_result_matches(
  borrow snapshot: prompt_artifacts.SnapshotResult,
  digest: str,
  task_id: str,
) -> bool {
  return verifier_snapshot_result_valid(snapshot) &&
  snapshot.content_sha256 == digest &&
  snapshot.task_id == task_id
}

fn verifier_attestation_reports_environment_drift(
  borrow attestation: prompt_artifacts.RunSnapshotAttestation,
  snapshot_sha256: str,
) -> bool {
  if attestation.error_code != "ENVIRONMENT_DRIFT" {
    return false
  }
  if attestation.before_snapshot_result_sha256 == snapshot_sha256 {
    return true
  }
  return match attestation.after_snapshot_result_sha256 {
    None => false,
    Some(value) => value == snapshot_sha256,
  }
}

fn verifier_snapshot_result_environment_valid(
  borrow snapshot: prompt_artifacts.SnapshotResult,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  task_ordinal := verifier_find_task_ordinal(result, snapshot.task_id)
  if task_ordinal < 0 { return false }
  return match snapshot.environment_probe {
    None => snapshot.status == "ERROR",
    Some(probe) => {
      if probe.producer != "SNAPSHOT_HELPER" ||
      probe.runtime_identity != result.tasks[task_ordinal].snapshot_helper_runtime {
        false
      } else {
        match result.environment {
          None => verifier_environment_probe_valid(probe),
          Some(environment) => {
            if verifier_probe_matches_environment(probe, environment) {
              true
            } else {
              mut index := 0
              mut attested := false
              loop {
                if index >= result.snapshot_attestations.len() { break }
                if verifier_attestation_reports_environment_drift(
                  result.snapshot_attestations[index],
                  snapshot.content_sha256,
                ) {
                  attested = true
                  break
                }
                index = index + 1
              }
              attested
            }
          },
        }
      }
    },
  }
}

fn verifier_snapshot_results_equal(
  borrow before: prompt_artifacts.SnapshotResult,
  borrow after: prompt_artifacts.SnapshotResult,
) -> bool {
  if before.status != "MATCH" || after.status != "MATCH" ||
  before.task_id != after.task_id ||
  before.artifact_digests.len() != after.artifact_digests.len() {
    return false
  }
  probes_equal := match before.environment_probe {
    None => false,
    Some(before_probe) => match after.environment_probe {
      None => false,
      Some(after_probe) => before_probe.content_sha256 == after_probe.content_sha256,
    },
  }
  if !probes_equal { return false }
  mut index := 0
  loop {
    if index >= before.artifact_digests.len() { break }
    if !verifier_artifact_digest_equal(before.artifact_digests[index], after.artifact_digests[index]) {
      return false
    }
    index = index + 1
  }
  return true
}

fn verifier_input_snapshot_valid(borrow snapshot: prompt_artifacts.TaskInputSnapshot) -> bool {
  if snapshot.schema_version != 1 ||
  snapshot.artifact_kind != "TASK_INPUT_SNAPSHOT" ||
  !verifier_valid_text(snapshot.task_id, 256) ||
  !verifier_valid_digest(snapshot.task_manifest_sha256) ||
  !verifier_valid_digest(snapshot.environment_sha256) ||
  !verifier_valid_digest(snapshot.content_sha256) ||
  snapshot.artifact_digests.len() > 4_096 {
    return false
  }
  mut index := 0
  loop {
    if index >= snapshot.artifact_digests.len() { break }
    if !verifier_artifact_digest_valid(snapshot.artifact_digests[index]) { return false }
    mut prior := 0
    loop {
      if prior >= index { break }
      if verifier_artifact_digest_same_path(snapshot.artifact_digests[prior], snapshot.artifact_digests[index]) {
        return false
      }
      prior = prior + 1
    }
    index = index + 1
  }
  return true
}

fn verifier_artifact_digest_same_path(
  borrow left: prompt_artifacts.ArtifactDigest,
  borrow right: prompt_artifacts.ArtifactDigest,
) -> bool {
  return left.path == right.path
}

fn verifier_input_snapshot_matches(
  borrow snapshot: prompt_artifacts.TaskInputSnapshot,
  digest: str,
  task_id: str,
) -> bool {
  return verifier_input_snapshot_valid(snapshot) &&
  snapshot.content_sha256 == digest &&
  snapshot.task_id == task_id
}

fn verifier_count_snapshot_requests(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  digest: str,
  task_id: str,
) -> i64 {
  mut count := 0
  mut index := 0
  loop {
    if index >= result.snapshot_requests.len() { break }
    if verifier_snapshot_request_matches(result.snapshot_requests[index], digest, task_id) {
      count = count + 1
    }
    index = index + 1
  }
  return count
}

fn verifier_count_snapshot_results(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  digest: str,
  task_id: str,
) -> i64 {
  mut count := 0
  mut index := 0
  loop {
    if index >= result.snapshot_results.len() { break }
    if verifier_snapshot_result_matches(result.snapshot_results[index], digest, task_id) {
      count = count + 1
    }
    index = index + 1
  }
  return count
}

fn verifier_find_snapshot_request(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  digest: str,
  task_id: str,
) -> i64 {
  mut index := 0
  loop {
    if index >= result.snapshot_requests.len() { break }
    if verifier_snapshot_request_matches(result.snapshot_requests[index], digest, task_id) {
      return index
    }
    index = index + 1
  }
  return -1
}

fn verifier_count_input_snapshots(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  digest: str,
  task_id: str,
) -> i64 {
  mut count := 0
  mut index := 0
  loop {
    if index >= result.input_snapshots.len() { break }
    if verifier_input_snapshot_matches(result.input_snapshots[index], digest, task_id) {
      count = count + 1
    }
    index = index + 1
  }
  return count
}

fn verifier_find_snapshot_result(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  digest: str,
  task_id: str,
) -> i64 {
  mut index := 0
  loop {
    if index >= result.snapshot_results.len() { break }
    if verifier_snapshot_result_matches(result.snapshot_results[index], digest, task_id) {
      return index
    }
    index = index + 1
  }
  return -1
}

fn verifier_find_input_snapshot(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  digest: str,
  task_id: str,
) -> i64 {
  mut index := 0
  loop {
    if index >= result.input_snapshots.len() { break }
    if verifier_input_snapshot_matches(result.input_snapshots[index], digest, task_id) {
      return index
    }
    index = index + 1
  }
  return -1
}

fn verifier_attestation_base_valid(
  borrow attestation: prompt_artifacts.RunSnapshotAttestation,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  return attestation.schema_version == 1 &&
  attestation.artifact_kind == "RUN_SNAPSHOT_ATTESTATION" &&
  verifier_valid_text(attestation.task_id, 256) &&
  attestation.sample_index >= 1 && attestation.sample_index <= result.sample_count &&
  (attestation.variant == "PARENT" || attestation.variant == "CANDIDATE") &&
  verifier_valid_digest(attestation.snapshot_request_sha256) &&
  verifier_valid_digest(attestation.before_snapshot_result_sha256) &&
  verifier_valid_digest(attestation.content_sha256) &&
  verifier_count_snapshot_requests(
    result,
    attestation.snapshot_request_sha256,
    attestation.task_id,
  ) == 1 &&
  verifier_count_snapshot_results(
    result,
    attestation.before_snapshot_result_sha256,
    attestation.task_id,
  ) == 1
}

fn verifier_complete_attestation_valid(
  borrow attestation: prompt_artifacts.RunSnapshotAttestation,
  borrow row: prompt_artifacts.PromptTaskRow,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  if !verifier_attestation_base_valid(attestation, result) ||
  attestation.status != "COMPLETE" ||
  attestation.error_code != "NONE" || attestation.error.len() != 0 ||
  attestation.task_id != row.task_id ||
  attestation.sample_index != row.sample_index ||
  attestation.variant != row.variant {
    return false
  }
  before_index := verifier_find_snapshot_result(
    result,
    attestation.before_snapshot_result_sha256,
    attestation.task_id,
  )
  if before_index < 0 { return false }
  return match attestation.after_snapshot_result_sha256 {
    None => false,
    Some(after_digest) => {
      after_index := verifier_find_snapshot_result(result, after_digest, attestation.task_id)
      if after_index < 0 ||
      !verifier_snapshot_results_equal(
        result.snapshot_results[before_index],
        result.snapshot_results[after_index],
      ) {
        false
      } else {
        match attestation.before_input_snapshot_sha256 {
          None => false,
          Some(before_input) => match attestation.after_input_snapshot_sha256 {
            None => false,
            Some(after_input) => before_input == after_input &&
            before_input == row.evaluation_input.task_input_snapshot_sha256 &&
            verifier_count_input_snapshots(result, before_input, attestation.task_id) == 1,
          },
        }
      }
    },
  }
}

fn verifier_failed_attestation_valid(
  borrow attestation: prompt_artifacts.RunSnapshotAttestation,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  if !verifier_attestation_base_valid(attestation, result) ||
  attestation.status == "COMPLETE" ||
  attestation.error_code != result.error_code ||
  attestation.error != result.error ||
  !verifier_valid_text(attestation.error, 4_096) {
    return false
  }
  before_index := verifier_find_snapshot_result(
    result,
    attestation.before_snapshot_result_sha256,
    attestation.task_id,
  )
  request_index := verifier_find_snapshot_request(
    result,
    attestation.snapshot_request_sha256,
    attestation.task_id,
  )
  if before_index < 0 || request_index < 0 { return false }
  before_match := result.snapshot_results[before_index].status == "MATCH"
  before_closure := before_match && verifier_snapshot_artifact_closure(
    result.snapshot_requests[request_index],
    result.snapshot_results[before_index],
  )
  after_none := match attestation.after_snapshot_result_sha256 { None => true, Some(_) => false }
  before_input_none := match attestation.before_input_snapshot_sha256 { None => true, Some(_) => false }
  after_input_none := match attestation.after_input_snapshot_sha256 { None => true, Some(_) => false }
  before_input_valid := match attestation.before_input_snapshot_sha256 {
    None => false,
    Some(digest) => verifier_count_input_snapshots(result, digest, attestation.task_id) == 1,
  }
  after_input_valid := match attestation.after_input_snapshot_sha256 {
    None => false,
    Some(digest) => verifier_count_input_snapshots(result, digest, attestation.task_id) == 1,
  }
  before_input_baseline := match attestation.before_input_snapshot_sha256 {
    None => false,
    Some(digest) => verifier_input_digest_is_baseline(digest, attestation.task_id, result),
  }
  after_input_baseline := match attestation.after_input_snapshot_sha256 {
    None => false,
    Some(digest) => verifier_input_digest_is_baseline(digest, attestation.task_id, result),
  }
  before_input_observation_matches := match attestation.before_input_snapshot_sha256 {
    None => false,
    Some(digest) => {
      input_index := verifier_find_input_snapshot(result, digest, attestation.task_id)
      input_index >= 0 && verifier_snapshot_input_artifacts_equal(
        result.snapshot_results[before_index],
        result.input_snapshots[input_index],
      )
    },
  }
  environment_present := match result.environment { None => false, Some(_) => true }

  if attestation.status == "PRECHECK_FAILED" {
    return !before_match && after_none && before_input_none && after_input_none &&
    (attestation.error_code == "WORKSPACE_UNSAFE" ||
      attestation.error_code == "SNAPSHOT_MISMATCH" ||
      attestation.error_code == "SNAPSHOT_ERROR")
  }
  if attestation.status == "PRECHECK_DRIFT" {
    return before_closure && after_none && before_input_valid && before_input_observation_matches &&
    !before_input_baseline && after_input_none &&
    (attestation.error_code == "INPUT_DRIFT" || attestation.error_code == "ENVIRONMENT_DRIFT")
  }
  if attestation.status == "ADAPTER_FAILED" {
    return before_closure && after_none && before_input_valid && before_input_observation_matches &&
    before_input_baseline && after_input_none &&
    (attestation.error_code == "ADAPTER_TIMEOUT" ||
      attestation.error_code == "ADAPTER_PROCESS_OUTPUT" ||
      attestation.error_code == "ADAPTER_RESULT")
  }
  return match attestation.after_snapshot_result_sha256 {
    None => false,
    Some(after_digest) => {
      after_index := verifier_find_snapshot_result(result, after_digest, attestation.task_id)
      if after_index < 0 || !before_closure || !before_input_valid ||
      !before_input_observation_matches || !before_input_baseline {
        false
      } else if attestation.status == "POSTCHECK_FAILED" {
        environment_present && result.snapshot_results[after_index].status != "MATCH" && after_input_none &&
        (attestation.error_code == "SNAPSHOT_MISMATCH" || attestation.error_code == "SNAPSHOT_ERROR")
      } else if attestation.status == "POSTCHECK_DRIFT" {
        after_input_index := match attestation.after_input_snapshot_sha256 {
          None => -1,
          Some(digest) => verifier_find_input_snapshot(result, digest, attestation.task_id),
        }
        environment_present && result.snapshot_results[after_index].status == "MATCH" &&
        verifier_snapshot_artifact_closure(
          result.snapshot_requests[request_index],
          result.snapshot_results[after_index],
        ) &&
        after_input_valid && after_input_index >= 0 &&
        verifier_snapshot_input_artifacts_equal(
          result.snapshot_results[after_index],
          result.input_snapshots[after_input_index],
        ) &&
        !after_input_baseline &&
        (attestation.error_code == "INPUT_DRIFT" || attestation.error_code == "ENVIRONMENT_DRIFT")
      } else {
        false
      }
    },
  }
}

fn verifier_input_digest_is_baseline(
  digest: str,
  task_id: str,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  mut index := 0
  loop {
    if index >= result.input_snapshots.len() { break }
    if result.input_snapshots[index].task_id == task_id {
      return result.input_snapshots[index].content_sha256 == digest
    }
    index = index + 1
  }
  return false
}

fn verifier_complete_status(value: str) -> bool {
  return value == "IMPROVED" || value == "NO_IMPROVEMENT" || value == "SERIOUS_REGRESSION"
}

fn verifier_evaluation_id_valid(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return match result.evaluation_id {
    None => false,
    Some(value) => verifier_valid_ascii_identifier(value, 128),
  }
}

fn verifier_trace_failure_absent(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return match result.trace_failure { None => true, Some(_) => false }
}

fn verifier_complete_inputs_present(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return match result.experiment { None => false, Some(_) => true } &&
  match result.experiment_artifact { None => false, Some(_) => true } &&
  match result.parent_activation { None => false, Some(_) => true } &&
  match result.parent_activation_artifact { None => false, Some(_) => true } &&
  match result.scope { None => false, Some(_) => true } &&
  match result.parent_variant { None => false, Some(_) => true } &&
  match result.candidate_variant { None => false, Some(_) => true } &&
  match result.corpus_source { None => false, Some(_) => true } &&
  match result.corpus { None => false, Some(_) => true } &&
  match result.acceptance_policy_source { None => false, Some(_) => true } &&
  match result.acceptance_policy { None => false, Some(_) => true } &&
  match result.generation_policy_source { None => false, Some(_) => true } &&
  match result.generation_policy { None => false, Some(_) => true } &&
  match result.provider_control_source { None => false, Some(_) => true } &&
  match result.provider_control { None => false, Some(_) => true } &&
  match result.workspace_preflight_source { None => false, Some(_) => true } &&
  match result.workspace_preflight_request { None => false, Some(_) => true } &&
  match result.workspace_preflight { None => false, Some(_) => true }
}

fn verifier_embedded_pairs_valid(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return verifier_experiment_pair_valid(result) &&
  verifier_parent_pair_valid(result) &&
  verifier_corpus_pair_valid(result) &&
  verifier_acceptance_policy_pair_valid(result) &&
  verifier_generation_policy_pair_valid(result) &&
  verifier_provider_control_pair_valid(result) &&
  verifier_workspace_preflight_pair_valid(result)
}

fn verifier_common_identity_valid(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  if !verifier_evaluation_id_valid(result) ||
  !verifier_trace_failure_absent(result) ||
  result.sample_count < 2 || result.sample_count > 16 ||
  !verifier_embedded_pairs_valid(result) {
    return false
  }
  return match result.scope {
    None => false,
    Some(scope) => {
      if !verifier_scope_valid(scope) {
        false
      } else {
        corpus_valid := match result.corpus {
          None => true,
          Some(corpus) => corpus.corpus_id == scope.corpus_id &&
          corpus.corpus_revision.content_sha256 == scope.corpus_revision.content_sha256
        }
        acceptance_valid := match result.acceptance_policy {
          None => true,
          Some(policy) => policy.content_sha256 == scope.acceptance_policy_sha256
        }
        generation_valid := match result.generation_policy {
          None => true,
          Some(policy) => policy.content_sha256 == scope.generation_policy_sha256 &&
          policy.evaluation_provider_kind == scope.evaluation_provider_kind &&
          policy.evaluation_provider_model == scope.evaluation_provider_model
        }
        provider_valid := match result.provider_control {
          None => true,
          Some(control) => control.provider_kind == scope.evaluation_provider_kind &&
          control.model == scope.evaluation_provider_model
        }
        policy_control_valid := match result.generation_policy {
          None => true,
          Some(policy) => match result.provider_control {
            None => true,
            Some(control) => policy.provider_control_sha256 == control.content_sha256 &&
            policy.evaluation_provider_endpoint_id == control.endpoint_id &&
            policy.evaluation_provider_kind == control.provider_kind &&
            policy.evaluation_provider_model == control.model,
          },
        }
        parent_valid := match result.parent_variant {
          None => true,
          Some(parent) => verifier_variant_scope_valid(parent, scope),
        }
        candidate_valid := match result.candidate_variant {
          None => true,
          Some(candidate) => verifier_variant_scope_valid(candidate, scope),
        }
        variants_distinct := match result.parent_variant {
          None => true,
          Some(parent) => match result.candidate_variant {
            None => true,
            Some(candidate) => parent.content_sha256 != candidate.content_sha256,
          },
        }
        corpus_valid && acceptance_valid && generation_valid && provider_valid && policy_control_valid &&
        parent_valid && candidate_valid && variants_distinct
      }
    },
  }
}

fn verifier_policy_fits_result(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return match result.acceptance_policy {
    None => false,
    Some(policy) => {
      maximum_rows := result.tasks.len().checked_mul(result.sample_count) else { return false }
      policy.minimum_task_count <= result.tasks.len() &&
      policy.minimum_samples_per_variant <= result.sample_count &&
      policy.minimum_completion_gain_count <= maximum_rows
    },
  }
}

fn verifier_workspace_request_valid(
  borrow request: prompt_artifacts.WorkspacePreflightRequest,
  evaluation_id: str,
) -> bool {
  return request.schema_version == 1 &&
  request.artifact_kind == "WORKSPACE_PREFLIGHT_REQUEST" &&
  request.evaluation_id == evaluation_id &&
  verifier_valid_text(request.project_root, 4_096) &&
  verifier_valid_text(request.workspace_path, 4_096) &&
  verifier_valid_digest(request.content_sha256)
}

fn verifier_workspace_result_trace_valid(
  borrow preflight: prompt_artifacts.WorkspacePreflightResult,
  evaluation_id: str,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  if preflight.evaluation_id != evaluation_id {
    return false
  }
  if preflight.status == "SAFE" {
    return preflight.error_code == "NONE" && preflight.error.len() == 0 &&
    verifier_valid_text(preflight.physical_project_root, 4_096) &&
    verifier_valid_text(preflight.physical_workspace_path, 4_096) &&
    match preflight.environment_probe {
      None => false,
      Some(probe) => verifier_preflight_probe_valid(probe, result),
    }
  }
  if preflight.status == "UNSAFE" || preflight.status == "ERROR" {
    helper_code_valid := if preflight.status == "UNSAFE" {
      preflight.error_code == "TYPE" ||
      preflight.error_code == "SYMLINK" ||
      preflight.error_code == "ESCAPE" ||
      preflight.error_code == "NOT_EMPTY"
    } else {
      preflight.error_code == "ENVIRONMENT" || preflight.error_code == "INTERNAL" ||
      preflight.error_code == "CLEANUP"
    }
    result_code := if preflight.status == "UNSAFE" {
      "WORKSPACE_UNSAFE"
    } else if preflight.error_code == "CLEANUP" {
      "CLEANUP_FAILED"
    } else {
      "SNAPSHOT_ERROR"
    }
    paths_valid := verifier_valid_bounded_text(preflight.physical_project_root, 4_096) &&
    verifier_valid_bounded_text(preflight.physical_workspace_path, 4_096) &&
    (preflight.physical_project_root.len() == 0 || preflight.physical_workspace_path.len() == 0)
    return result.status == "ERROR" &&
    result.error_code == result_code &&
    helper_code_valid && paths_valid &&
    preflight.error == result.error &&
    verifier_valid_text(preflight.error, 4_096) &&
    match preflight.environment_probe { None => true, Some(_) => false } &&
    match result.environment { None => true, Some(_) => false }
  }
  return false
}

fn verifier_preflight_probe_valid(
  borrow probe: prompt_artifacts.EnvironmentProbe,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  if result.tasks.len() == 0 ||
  probe.producer != "SNAPSHOT_HELPER" ||
  probe.runtime_identity != result.tasks[0].snapshot_helper_runtime {
    return false
  }
  return match result.environment {
    None => verifier_environment_probe_valid(probe),
    Some(environment) => verifier_probe_matches_environment(probe, environment),
  }
}

fn verifier_workspace_trace_valid(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return match result.evaluation_id {
    None => false,
    Some(evaluation_id) => match result.workspace_preflight_request {
      None => false,
      Some(request) => {
        if !verifier_workspace_request_valid(request, evaluation_id) {
          false
        } else {
          match result.workspace_preflight {
            None => false,
            Some(preflight) => verifier_workspace_result_trace_valid(preflight, evaluation_id, result),
          }
        }
      },
    },
  }
}

fn verifier_snapshot_request_trace_valid(
  borrow request: prompt_artifacts.SnapshotRequest,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  task_ordinal := verifier_find_task_ordinal(result, request.task_id)
  if !verifier_snapshot_request_valid(request) || task_ordinal < 0 ||
  !verifier_snapshot_request_task_matches(request, result.tasks[task_ordinal]) {
    return false
  }
  return match result.workspace_preflight_request {
    None => false,
    Some(preflight) => request.project_root == preflight.project_root &&
    request.workspace_path == preflight.workspace_path,
  }
}

fn verifier_snapshot_request_task_matches(
  borrow request: prompt_artifacts.SnapshotRequest,
  borrow task: prompt_artifacts.PromptEvaluationTask,
) -> bool {
  return request.task_id == task.task_id &&
  request.repo_path == task.repo_path &&
  request.repo_revision == task.repo_revision &&
  request.require_clean_repo == task.require_clean_repo &&
  verifier_expectation_arrays_equal(request.static_expectations, task.artifacts)
}

fn verifier_expectation_arrays_equal(
  borrow left: array<prompt_artifacts.ArtifactExpectation>,
  borrow right: array<prompt_artifacts.ArtifactExpectation>,
) -> bool {
  if left.len() != right.len() { return false }
  mut index := 0
  loop {
    if index >= left.len() { break }
    if !verifier_expectations_equal(left[index], right[index]) { return false }
    index = index + 1
  }
  return true
}

fn verifier_expectations_equal(
  borrow left: prompt_artifacts.ArtifactExpectation,
  borrow right: prompt_artifacts.ArtifactExpectation,
) -> bool {
  return left.path == right.path &&
  left.kind == right.kind &&
  left.expected_sha256 == right.expected_sha256
}

fn verifier_snapshot_request_task_ordinal(
  borrow request: prompt_artifacts.SnapshotRequest,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> i64 {
  return verifier_find_task_ordinal(result, request.task_id)
}

fn verifier_snapshot_request_same_digest(
  borrow left: prompt_artifacts.SnapshotRequest,
  borrow right: prompt_artifacts.SnapshotRequest,
) -> bool {
  return left.content_sha256 == right.content_sha256
}

fn verifier_snapshot_result_task_ordinal(
  borrow snapshot: prompt_artifacts.SnapshotResult,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> i64 {
  return verifier_find_task_ordinal(result, snapshot.task_id)
}

fn verifier_snapshot_result_same_digest(
  borrow left: prompt_artifacts.SnapshotResult,
  borrow right: prompt_artifacts.SnapshotResult,
) -> bool {
  return left.content_sha256 == right.content_sha256
}

fn verifier_input_snapshot_task_ordinal(
  borrow snapshot: prompt_artifacts.TaskInputSnapshot,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> i64 {
  return verifier_find_task_ordinal(result, snapshot.task_id)
}

fn verifier_input_snapshot_same_digest(
  borrow left: prompt_artifacts.TaskInputSnapshot,
  borrow right: prompt_artifacts.TaskInputSnapshot,
) -> bool {
  return left.content_sha256 == right.content_sha256
}

fn verifier_artifact_digest_arrays_equal(
  borrow left: array<prompt_artifacts.ArtifactDigest>,
  borrow right: array<prompt_artifacts.ArtifactDigest>,
) -> bool {
  if left.len() != right.len() { return false }
  mut index := 0
  loop {
    if index >= left.len() { break }
    if !verifier_artifact_digest_equal(left[index], right[index]) { return false }
    index = index + 1
  }
  return true
}

fn verifier_snapshot_input_artifacts_equal(
  borrow snapshot: prompt_artifacts.SnapshotResult,
  borrow input: prompt_artifacts.TaskInputSnapshot,
) -> bool {
  return verifier_artifact_digest_arrays_equal(snapshot.artifact_digests, input.artifact_digests)
}

fn verifier_input_snapshot_matches_task(
  borrow snapshot: prompt_artifacts.TaskInputSnapshot,
  borrow task: prompt_artifacts.PromptEvaluationTask,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  environment_valid := match result.environment {
    None => true,
    Some(environment) => snapshot.environment_sha256 == environment.environment_id,
  }
  return verifier_input_snapshot_valid(snapshot) &&
  snapshot.task_id == task.task_id &&
  snapshot.task_manifest_sha256 == task.content_sha256 &&
  environment_valid
}

fn verifier_trace_arrays_valid(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  if result.snapshot_requests.len() > 4_096 ||
  result.snapshot_results.len() > 4_096 ||
  result.input_snapshots.len() > 4_096 ||
  result.snapshot_attestations.len() > 2_048 {
    return false
  }

  mut prior_task := -1
  mut index := 0
  loop {
    if index >= result.snapshot_requests.len() { break }
    task := verifier_snapshot_request_task_ordinal(result.snapshot_requests[index], result)
    if !verifier_snapshot_request_trace_valid(result.snapshot_requests[index], result) || task < prior_task { return false }
    mut prior := 0
    loop {
      if prior >= index { break }
      if verifier_snapshot_request_same_digest(result.snapshot_requests[prior], result.snapshot_requests[index]) { return false }
      prior = prior + 1
    }
    prior_task = task
    index = index + 1
  }

  prior_task = -1
  index = 0
  loop {
    if index >= result.snapshot_results.len() { break }
    task := verifier_snapshot_result_task_ordinal(result.snapshot_results[index], result)
    if !verifier_snapshot_result_valid(result.snapshot_results[index]) ||
    !verifier_snapshot_result_environment_valid(result.snapshot_results[index], result) ||
    task < 0 || task < prior_task { return false }
    mut prior := 0
    loop {
      if prior >= index { break }
      if verifier_snapshot_result_same_digest(result.snapshot_results[prior], result.snapshot_results[index]) { return false }
      prior = prior + 1
    }
    prior_task = task
    index = index + 1
  }

  prior_task = -1
  index = 0
  loop {
    if index >= result.input_snapshots.len() { break }
    task := verifier_input_snapshot_task_ordinal(result.input_snapshots[index], result)
    if !verifier_input_snapshot_valid(result.input_snapshots[index]) ||
    task < 0 || task < prior_task ||
    !verifier_input_snapshot_task_manifest_valid(result.input_snapshots[index], result.tasks[task]) {
      return false
    }
    mut prior := 0
    loop {
      if prior >= index { break }
      if verifier_input_snapshot_same_digest(result.input_snapshots[prior], result.input_snapshots[index]) { return false }
      prior = prior + 1
    }
    prior_task = task
    index = index + 1
  }
  return verifier_all_trace_records_referenced(result)
}

fn verifier_input_snapshot_task_manifest_valid(
  borrow snapshot: prompt_artifacts.TaskInputSnapshot,
  borrow task: prompt_artifacts.PromptEvaluationTask,
) -> bool {
  return snapshot.task_id == task.task_id &&
  snapshot.task_manifest_sha256 == task.content_sha256
}

fn verifier_attestation_references_request(
  borrow attestation: prompt_artifacts.RunSnapshotAttestation,
  digest: str,
) -> bool {
  return attestation.snapshot_request_sha256 == digest
}

fn verifier_attestation_references_result(
  borrow attestation: prompt_artifacts.RunSnapshotAttestation,
  digest: str,
) -> bool {
  if attestation.before_snapshot_result_sha256 == digest { return true }
  return match attestation.after_snapshot_result_sha256 {
    None => false,
    Some(after_digest) => after_digest == digest,
  }
}

fn verifier_attestation_references_input(
  borrow attestation: prompt_artifacts.RunSnapshotAttestation,
  digest: str,
) -> bool {
  before_valid := match attestation.before_input_snapshot_sha256 {
    None => false,
    Some(before_digest) => before_digest == digest,
  }
  if before_valid { return true }
  return match attestation.after_input_snapshot_sha256 {
    None => false,
    Some(after_digest) => after_digest == digest,
  }
}

// A row may now run more than one contained invocation, and each one produces its own snapshot
// request, before/after results, and input snapshot. `snapshot_attestations` still carries exactly
// one record per row, so a repair attempt's trace records are attested by the attempt record
// instead. Every trace record therefore remains bound to the invocation that produced it: the
// universal "no unreferenced trace record" guarantee is preserved, not weakened.
fn verifier_attempt_references(
  borrow attempt: prompt_artifacts.TaskAttemptRecord,
  digest: str,
  kind: i64,
) -> bool {
  if kind == 0 {
    return match attempt.snapshot_request_sha256 { None => false, Some(value) => value == digest }
  }
  if kind == 1 {
    before := match attempt.before_snapshot_result_sha256 { None => false, Some(value) => value == digest }
    if before { return true }
    return match attempt.after_snapshot_result_sha256 { None => false, Some(value) => value == digest }
  }
  return match attempt.input_snapshot_sha256 { None => false, Some(value) => value == digest }
}

fn verifier_attempt_list_references(
  borrow attempts: array<prompt_artifacts.TaskAttemptRecord>,
  digest: str,
  kind: i64,
) -> bool {
  mut index := 0
  loop {
    if index >= attempts.len() { break }
    if verifier_attempt_references(attempts[index], digest, kind) { return true }
    index = index + 1
  }
  return false
}

// The row is taken as a `borrow` parameter rather than matched in place: reading a `Move`-type
// field out of an array element is not expressible at the pinned compiler (the Request 22 class),
// and a borrowed binding is the idiom the rest of this verifier already uses for the same reason.
fn verifier_row_references_trace(
  borrow row: prompt_artifacts.PromptTaskRow,
  digest: str,
  kind: i64,
) -> bool {
  return match row.attempts {
    None => false,
    Some(attempts) => verifier_attempt_list_references(attempts, digest, kind),
  }
}

fn verifier_rows_reference_trace(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  digest: str,
  kind: i64,
) -> bool {
  mut index := 0
  loop {
    if index >= result.rows.len() { break }
    if verifier_row_references_trace(result.rows[index], digest, kind) { return true }
    index = index + 1
  }
  return false
}

fn verifier_request_record_referenced(
  borrow request: prompt_artifacts.SnapshotRequest,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  mut index := 0
  loop {
    if index >= result.snapshot_attestations.len() { break }
    if verifier_attestation_references_request(result.snapshot_attestations[index], request.content_sha256) {
      return true
    }
    index = index + 1
  }
  return verifier_rows_reference_trace(result, request.content_sha256, 0)
}

fn verifier_result_record_referenced(
  borrow snapshot: prompt_artifacts.SnapshotResult,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  mut index := 0
  loop {
    if index >= result.snapshot_attestations.len() { break }
    if verifier_attestation_references_result(result.snapshot_attestations[index], snapshot.content_sha256) {
      return true
    }
    index = index + 1
  }
  return verifier_rows_reference_trace(result, snapshot.content_sha256, 1)
}

fn verifier_input_record_referenced(
  borrow snapshot: prompt_artifacts.TaskInputSnapshot,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  mut index := 0
  loop {
    if index >= result.snapshot_attestations.len() { break }
    if verifier_attestation_references_input(result.snapshot_attestations[index], snapshot.content_sha256) {
      return true
    }
    index = index + 1
  }
  return verifier_rows_reference_trace(result, snapshot.content_sha256, 2)
}

fn verifier_all_trace_records_referenced(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  mut index := 0
  loop {
    if index >= result.snapshot_requests.len() { break }
    if !verifier_request_record_referenced(result.snapshot_requests[index], result) { return false }
    index = index + 1
  }
  index = 0
  loop {
    if index >= result.snapshot_results.len() { break }
    if !verifier_result_record_referenced(result.snapshot_results[index], result) { return false }
    index = index + 1
  }
  index = 0
  loop {
    if index >= result.input_snapshots.len() { break }
    if !verifier_input_record_referenced(result.input_snapshots[index], result) { return false }
    index = index + 1
  }
  return true
}

fn verifier_expected_schedule(
  invocation_index: i64,
  sample_count: i64,
) -> (i64, i64, bool) {
  task_width := sample_count * 2
  task := invocation_index / task_width
  task_offset := invocation_index % task_width
  sample := task_offset / 2 + 1
  variant_offset := task_offset % 2
  parent := if sample % 2 == 1 { variant_offset == 0 } else { variant_offset == 1 }
  return (task, sample, parent)
}

fn verifier_attestation_schedule_valid(
  borrow attestation: prompt_artifacts.RunSnapshotAttestation,
  invocation_index: i64,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  (task, sample, parent) := verifier_expected_schedule(invocation_index, result.sample_count)
  if task < 0 || task >= result.tasks.len() { return false }
  expected_variant := if parent { "PARENT" } else { "CANDIDATE" }
  return attestation.task_id == result.tasks[task].task_id &&
  attestation.sample_index == sample &&
  attestation.variant == expected_variant
}

fn verifier_row_cross_identity_valid(
  borrow row: prompt_artifacts.PromptTaskRow,
  borrow task: prompt_artifacts.PromptEvaluationTask,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  variant_valid := if row.variant == "PARENT" {
    match result.parent_variant {
      None => false,
      Some(variant) => row.variant_id == variant.variant_id && row.variant_sha256 == variant.content_sha256,
    }
  } else if row.variant == "CANDIDATE" {
    match result.candidate_variant {
      None => false,
      Some(variant) => row.variant_id == variant.variant_id && row.variant_sha256 == variant.content_sha256,
    }
  } else {
    false
  }
  variants_bound := match result.parent_variant {
    None => false,
    Some(parent) => match result.candidate_variant {
      None => false,
      Some(candidate) => row.evaluation_input.parent_variant_sha256 == parent.content_sha256 &&
      row.evaluation_input.candidate_variant_sha256 == candidate.content_sha256,
    },
  }
  policy_bound := match result.generation_policy {
    None => false,
    Some(policy) => row.evaluation_input.generation_policy_sha256 == policy.content_sha256 &&
    row.measurement.generation_request.generation_policy_sha256 == policy.content_sha256 &&
    row.measurement.generation_request.max_tokens == policy.max_tokens &&
    row.measurement.generation_request.temperature_micros == policy.temperature_micros,
  }
  seed_schedule_bound := match result.generation_policy {
    None => false,
    Some(policy) => {
      offset := row.sample_index - 1
      expected_seed := policy.seed_base.checked_add(offset) else { return false }
      row.evaluation_input.paired_seed == expected_seed
    },
  }
  control_bound := match result.provider_control {
    None => false,
    Some(control) => row.measurement.generation_request.provider_control_sha256 == control.content_sha256 &&
    row.measurement.seed_attestation.provider_kind == control.provider_kind &&
    row.measurement.seed_attestation.provider_model == control.model,
  }
  environment_bound := match result.environment {
    None => false,
    Some(environment) => row.evaluation_input.environment_sha256 == environment.environment_id &&
    row.evaluation_input.environment_policy_sha256 == environment.core.environment_policy_sha256 &&
    row.measurement.generation_request.environment_policy_sha256 == environment.core.environment_policy_sha256 &&
    verifier_probe_matches_environment(row.measurement.environment_probe, environment),
  }
  seed_bound := row.evaluation_input.paired_seed == row.measurement.generation_request.paired_seed &&
  row.evaluation_input.paired_seed == row.measurement.seed_attestation.requested_seed &&
  row.evaluation_input.generation_request_sha256 == row.measurement.generation_request.content_sha256 &&
  row.measurement.generation_request.seed_attestation_sha256 == row.measurement.seed_attestation.content_sha256
  return variant_valid && variants_bound && policy_bound && seed_schedule_bound && control_bound && environment_bound && seed_bound &&
  row.measurement.environment_probe.producer == "MEASUREMENT_ADAPTER" &&
  row.measurement.environment_probe.runtime_identity == task.measurement_adapter_runtime
}

fn verifier_complete_attestation_cross_valid(
  borrow attestation: prompt_artifacts.RunSnapshotAttestation,
  borrow row: prompt_artifacts.PromptTaskRow,
  borrow task: prompt_artifacts.PromptEvaluationTask,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  if !verifier_complete_attestation_valid(attestation, row, result) { return false }
  request_index := verifier_find_snapshot_request(
    result,
    attestation.snapshot_request_sha256,
    attestation.task_id,
  )
  before_index := verifier_find_snapshot_result(result, attestation.before_snapshot_result_sha256, attestation.task_id)
  input_index := verifier_find_input_snapshot(result, row.evaluation_input.task_input_snapshot_sha256, row.task_id)
  after_index := match attestation.after_snapshot_result_sha256 {
    None => -1,
    Some(digest) => verifier_find_snapshot_result(result, digest, attestation.task_id),
  }
  if request_index < 0 || before_index < 0 || after_index < 0 || input_index < 0 ||
  !verifier_snapshot_artifact_closure(
    result.snapshot_requests[request_index],
    result.snapshot_results[before_index],
  ) ||
  !verifier_snapshot_artifact_closure(
    result.snapshot_requests[request_index],
    result.snapshot_results[after_index],
  ) ||
  !verifier_input_snapshot_matches_task(result.input_snapshots[input_index], task, result) ||
  !verifier_snapshot_input_cross_valid(
    result.snapshot_results[before_index],
    result.input_snapshots[input_index],
    result,
  ) {
    return false
  }
  return verifier_row_cross_identity_valid(row, task, result)
}

fn verifier_snapshot_input_cross_valid(
  borrow snapshot: prompt_artifacts.SnapshotResult,
  borrow input: prompt_artifacts.TaskInputSnapshot,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  if !verifier_artifact_digest_arrays_equal(snapshot.artifact_digests, input.artifact_digests) {
    return false
  }
  return match snapshot.environment_probe {
    None => false,
    Some(probe) => verifier_result_environment_matches_probe(probe, result),
  }
}

fn verifier_preflight_is_safe(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return match result.workspace_preflight {
    None => false,
    Some(preflight) => preflight.status == "SAFE",
  }
}

fn verifier_last_row_is_error(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  if result.rows.len() == 0 { return false }
  return verifier_row_measurement_is_error(result.rows[result.rows.len() - 1])
}

fn verifier_terminal_row_matches_error(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return result.error_code == "ADAPTER_RESULT" && verifier_last_row_is_error(result)
}

fn verifier_row_measurement_is_error(borrow row: prompt_artifacts.PromptTaskRow) -> bool {
  return row.measurement.status == "ERROR"
}

// Total contained invocations across the document: at version 1 one per row, at version 2 the
// number of attempts that actually ran. A skipped repair made no invocation and counts for none.
fn verifier_ran_attempt_total(borrow result: prompt_artifacts.PromptEvaluationResult) -> i64 {
  mut total := 0
  mut index := 0
  loop {
    if index >= result.rows.len() { break }
    row_attempts := verifier_row_ran_attempt_count(result.rows[index])
    if row_attempts == 0 { total = total + 1 } else { total = total + row_attempts }
    index = index + 1
  }
  return total
}

fn verifier_rows_and_attestations_valid(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  is_complete_result := verifier_complete_status(result.status)
  if is_complete_result {
    task_samples := result.tasks.len().checked_mul(result.sample_count) else { return false }
    expected := task_samples.checked_mul(2) else { return false }
    // One attestation per row, still, because the schedule check binds them positionally. The
    // *invocation* count is what grew: a row may now run up to `1 + maximum_repair_loops` contained
    // invocations, each sealing its own prompt and so producing its own input snapshot. At version
    // 1 every row runs exactly once, so `invocations` equals `expected` and this bound is the
    // one it has always been.
    invocations := verifier_ran_attempt_total(result)
    if result.rows.len() != expected ||
    result.snapshot_attestations.len() != expected ||
    result.input_snapshots.len() < result.tasks.len() ||
    result.input_snapshots.len() > invocations ||
    !verifier_preflight_is_safe(result) {
      return false
    }
  } else if result.status == "ERROR" {
    if result.snapshot_attestations.len() < result.rows.len() ||
    result.snapshot_attestations.len() > result.rows.len() + 1 {
      return false
    }
    if !verifier_preflight_is_safe(result) {
      return result.rows.len() == 0 &&
      result.snapshot_attestations.len() == 0 &&
      result.snapshot_requests.len() == 0 &&
      result.snapshot_results.len() == 0 &&
      result.input_snapshots.len() == 0
    }
  } else {
    return false
  }

  mut index := 0
  loop {
    if index >= result.rows.len() { break }
    (task_ordinal, _, _) := verifier_expected_schedule(index, result.sample_count)
    if task_ordinal < 0 || task_ordinal >= result.tasks.len() ||
    !verifier_attestation_schedule_valid(result.snapshot_attestations[index], index, result) ||
    !verifier_complete_attestation_cross_valid(
      result.snapshot_attestations[index],
      result.rows[index],
      result.tasks[task_ordinal],
      result,
    ) {
      return false
    }
    index = index + 1
  }

  if result.status == "ERROR" {
    if result.snapshot_attestations.len() == result.rows.len() + 1 {
      if result.error_code == "CLEANUP_FAILED" ||
      !verifier_attestation_schedule_valid(result.snapshot_attestations[result.rows.len()], result.rows.len(), result) ||
      !verifier_failed_attestation_valid(result.snapshot_attestations[result.rows.len()], result) {
        return false
      }
    } else {
      cleanup_after_prefix := result.error_code == "CLEANUP_FAILED" &&
      !verifier_last_row_is_error(result)
      if !cleanup_after_prefix && !verifier_terminal_row_matches_error(result) { return false }
    }
  }
  return true
}

// Version 1 binds one expected-input identity per row. Version 2 binds one per attempt that
// actually ran, in row order then attempt order, so a skipped repair contributes no identity and
// no duplicate, missing, or extra identity is admitted.
fn verifier_row_ran_attempt_count(borrow row: prompt_artifacts.PromptTaskRow) -> i64 {
  return match row.attempts {
    None => 0,
    Some(attempts) => verifier_ran_attempt_count(attempts),
  }
}

fn verifier_ran_attempt_count(borrow attempts: array<prompt_artifacts.TaskAttemptRecord>) -> i64 {
  mut count := 0
  mut index := 0
  loop {
    if index >= attempts.len() { break }
    if !verifier_attempt_is_status(attempts[index], "SKIPPED") { count = count + 1 }
    index = index + 1
  }
  return count
}

fn verifier_expected_attempt_matches_row(
  borrow expected: prompt_artifacts.PromptExpectedInputDigest,
  borrow row: prompt_artifacts.PromptTaskRow,
  ordinal: i64,
) -> bool {
  return match row.attempts {
    None => false,
    Some(attempts) => verifier_expected_attempt_matches_list(expected, row, attempts, ordinal),
  }
}

fn verifier_expected_attempt_matches_list(
  borrow expected: prompt_artifacts.PromptExpectedInputDigest,
  borrow row: prompt_artifacts.PromptTaskRow,
  borrow attempts: array<prompt_artifacts.TaskAttemptRecord>,
  ordinal: i64,
) -> bool {
  mut seen := 0
  mut index := 0
  loop {
    if index >= attempts.len() { break }
    if !verifier_attempt_is_status(attempts[index], "SKIPPED") {
      if seen == ordinal {
        return verifier_expected_input_matches_attempt(expected, row, attempts[index])
      }
      seen = seen + 1
    }
    index = index + 1
  }
  return false
}

fn verifier_expected_input_matches_attempt(
  borrow expected: prompt_artifacts.PromptExpectedInputDigest,
  borrow row: prompt_artifacts.PromptTaskRow,
  borrow attempt: prompt_artifacts.TaskAttemptRecord,
) -> bool {
  identity := expected.schema_version == 2 &&
  expected.artifact_kind == "PROMPT_EXPECTED_INPUT_DIGEST" &&
  expected.task_id == row.task_id &&
  expected.sample_index == row.sample_index &&
  expected.variant == row.variant &&
  match expected.attempt_index {
    None => false,
    Some(value) => value == attempt.attempt_index,
  } &&
  verifier_valid_digest(expected.rendered_prompt_sha256) &&
  verifier_valid_digest(expected.context_sources_sha256) &&
  verifier_valid_digest(expected.generation_request_sha256) &&
  verifier_valid_digest(expected.adapter_request_sha256) &&
  verifier_valid_digest(expected.provider_request_sha256) &&
  verifier_valid_digest(expected.content_sha256) &&
  expected.context_sources_sha256 == row.evaluation_input.context_sources_sha256
  if !identity { return false }
  return match attempt.rendered_prompt_sha256 {
    None => false,
    Some(rendered) => expected.rendered_prompt_sha256 == rendered,
  } && match attempt.adapter_request_sha256 {
    None => false,
    Some(request) => expected.adapter_request_sha256 == request,
  } && match attempt.generation_request {
    None => false,
    Some(generation) => expected.generation_request_sha256 == generation.content_sha256 &&
    expected.provider_request_sha256 == generation.provider_request_sha256,
  }
}

fn verifier_expected_inputs_valid(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  borrow evidence: prompt_artifacts.PromptEvaluationEvidence,
) -> bool {
  if result.schema_version == 1 {
    if evidence.expected_inputs.len() != result.rows.len() { return false }
    mut index := 0
    loop {
      if index >= result.rows.len() { break }
      if !verifier_expected_input_matches(evidence.expected_inputs[index], result.rows[index]) {
        return false
      }
      mut prior := 0
      loop {
        if prior >= index { break }
        if verifier_expected_input_same_identity(evidence.expected_inputs[prior], evidence.expected_inputs[index]) {
          return false
        }
        prior = prior + 1
      }
      index = index + 1
    }
    return true
  }
  mut expected_total := 0
  mut row_index := 0
  loop {
    if row_index >= result.rows.len() { break }
    expected_total = expected_total + verifier_row_ran_attempt_count(result.rows[row_index])
    row_index = row_index + 1
  }
  if evidence.expected_inputs.len() != expected_total { return false }
  mut cursor := 0
  mut row_cursor := 0
  loop {
    if row_cursor >= result.rows.len() { break }
    ran := verifier_row_ran_attempt_count(result.rows[row_cursor])
    mut ordinal := 0
    loop {
      if ordinal >= ran { break }
      if !verifier_expected_attempt_matches_row(
        evidence.expected_inputs[cursor],
        result.rows[row_cursor],
        ordinal,
      ) {
        return false
      }
      mut prior := 0
      loop {
        if prior >= cursor { break }
        if verifier_expected_attempt_same_identity(
          evidence.expected_inputs[prior],
          evidence.expected_inputs[cursor],
        ) {
          return false
        }
        prior = prior + 1
      }
      cursor = cursor + 1
      ordinal = ordinal + 1
    }
    row_cursor = row_cursor + 1
  }
  return true
}

fn verifier_expected_attempt_same_identity(
  borrow left: prompt_artifacts.PromptExpectedInputDigest,
  borrow right: prompt_artifacts.PromptExpectedInputDigest,
) -> bool {
  return left.task_id == right.task_id &&
  left.sample_index == right.sample_index &&
  left.variant == right.variant &&
  verifier_optional_i64_equal(left.attempt_index, right.attempt_index)
}

fn verifier_expected_input_same_identity(
  borrow left: prompt_artifacts.PromptExpectedInputDigest,
  borrow right: prompt_artifacts.PromptExpectedInputDigest,
) -> bool {
  return left.task_id == right.task_id &&
  left.sample_index == right.sample_index &&
  left.variant == right.variant
}

fn verifier_build_rows(
  out: region,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> Result<array<ScoreRow>, Error> {
  mut values: array_builder<ScoreRow> := array_builder(out)
  mut index := 0
  loop {
    if index >= result.rows.len() { break }
    (task_ordinal, _, _) := verifier_expected_schedule(index, result.sample_count)
    if task_ordinal < 0 || task_ordinal >= result.tasks.len() { return Err(Error.Invalid) }
    score_row := verifier_score_row_for_result(
      result.rows[index],
      result.tasks[task_ordinal],
      result,
      task_ordinal,
    )?
    values.push(score_row)
    index = index + 1
  }
  return Ok(values.build())
}

fn verifier_result_max_prompt_bytes(borrow result: prompt_artifacts.PromptEvaluationResult) -> i64 {
  return match result.generation_policy { None => 0, Some(policy) => policy.max_prompt_bytes }
}

fn verifier_score_row_for_result(
  borrow row: prompt_artifacts.PromptTaskRow,
  borrow task: prompt_artifacts.PromptEvaluationTask,
  borrow result: prompt_artifacts.PromptEvaluationResult,
  task_ordinal: i64,
) -> Result<ScoreRow, Error> {
  return match result.evaluation_id {
    None => Err(Error.Invalid),
    Some(evaluation_id) => verifier_score_row(
      row,
      task,
      evaluation_id,
      task_ordinal,
      verifier_result_max_prompt_bytes(result),
    ),
  }
}

fn verifier_build_task_limits(
  out: region,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> array<ScoreTaskLimit> {
  mut values: array_builder<ScoreTaskLimit> := array_builder(out)
  mut index := 0
  loop {
    if index >= result.tasks.len() { break }
    values.push(verifier_task_limit(result.tasks[index]))
    index = index + 1
  }
  return values.build()
}

fn verifier_prefix_valid(
  rows: slice<ScoreRow>,
  task_limits: slice<ScoreTaskLimit>,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  prefix := validate_prefix(rows, task_limits, result.sample_count)
  if prefix.error_code != 0 || prefix.error_index != -1 ||
  prefix.row_count != result.rows.len() {
    return false
  }
  if verifier_complete_status(result.status) {
    return match prefix.status {
      ValidPrefix => prefix.row_count == prefix.expected_row_count,
      TerminalError => false,
      InvalidInput => false,
    }
  }
  if result.status != "ERROR" { return false }
  if verifier_last_row_is_error(result) {
    return match prefix.status { TerminalError => true, _ => false }
  }
  return match prefix.status { ValidPrefix => true, _ => false }
}

fn verifier_i64_array(count: i64) -> array<i64> {
  mut values: array_builder<i64> := array_builder()
  mut index := 0
  loop {
    if index >= count { break }
    values.push(0)
    index = index + 1
  }
  return values.build()
}

fn verifier_bool_array(count: i64) -> array<bool> {
  mut values: array_builder<bool> := array_builder()
  mut index := 0
  loop {
    if index >= count { break }
    values.push(false)
    index = index + 1
  }
  return values.build()
}

fn verifier_reason_capacity(task_count: i64, sample_count: i64) -> Result<i64, Error> {
  pairs := task_count.checked_mul(sample_count) else { return Err(Error.Invalid) }
  // Ten per-pair reasons since C4-REPAIR-MEASURED made the `REPAIR_LOOPS` cap variant-symmetric.
  // The ceiling is the worst case at the declared bounds: 64 tasks * 16 samples * 10, plus one
  // per-task `TIME` reason, plus the two corpus-level reasons.
  pair_reasons := pairs.checked_mul(10) else { return Err(Error.Invalid) }
  with_tasks := pair_reasons.checked_add(task_count) else { return Err(Error.Invalid) }
  capacity := with_tasks.checked_add(2) else { return Err(Error.Invalid) }
  if capacity < 0 || capacity > 10_306 { return Err(Error.Invalid) }
  return Ok(capacity)
}

// --- C4 repair aggregates, recomputed and never trusted from the persisted document ----------

fn verifier_row_repair_attempted(borrow row: prompt_artifacts.PromptTaskRow) -> bool {
  return match row.repair_loop_count { None => false, Some(value) => value >= 1 }
}

// The section 1.4 gate predicate on one row.
fn verifier_row_repair_recovered(borrow row: prompt_artifacts.PromptTaskRow) -> bool {
  return match row.attempts {
    None => false,
    Some(attempts) => attempts.len() == 2 &&
    verifier_attempt_is_kind(attempts[0], "INITIAL") &&
    verifier_attempt_is_status(attempts[0], "FAIL") &&
    verifier_attempt_is_kind(attempts[1], "REPAIR") &&
    verifier_attempt_is_status(attempts[1], "PASS"),
  }
}

RepairAggregate {
  attempted: i64,
  recovered: i64,
  paired: bool,
}

fn verifier_variant_repair_aggregate(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  task: i64,
  parent: bool,
) -> RepairAggregate {
  sample_count := result.sample_count
  mut attempted := 0
  mut recovered := 0
  mut every := true
  mut sample := 1
  loop {
    if sample > sample_count { break }
    base := pair_start(task, sample, sample_count)
    index := if parent { parent_index(base, sample) } else { candidate_index(base, sample) }
    if verifier_row_repair_attempted(result.rows[index]) { attempted = attempted + 1 }
    if verifier_row_repair_recovered(result.rows[index]) {
      recovered = recovered + 1
    } else {
      every = false
    }
    sample = sample + 1
  }
  return RepairAggregate {
    attempted: attempted,
    recovered: recovered,
    // A (task, variant) pair counts only when every paired sample recovered, so one lucky sample
    // is not a reproducible recovery.
    paired: every && sample_count > 0,
  }
}

fn verifier_optional_i64_is(value: Option<i64>, expected: i64) -> bool {
  return match value { None => false, Some(actual) => actual == expected }
}

fn verifier_optional_bool_is(value: Option<bool>, expected: bool) -> bool {
  return match value { None => false, Some(actual) => actual == expected }
}

fn verifier_task_repair_aggregate_matches(
  borrow persisted: prompt_artifacts.TaskAggregate,
  borrow result: prompt_artifacts.PromptEvaluationResult,
  ordinal: i64,
) -> bool {
  if result.schema_version == 1 {
    // A version-1 document carries no repair aggregates and is never given defaults for them.
    return verifier_optional_i64_absent(persisted.parent_repair_attempt_count) &&
    verifier_optional_i64_absent(persisted.candidate_repair_attempt_count) &&
    verifier_optional_i64_absent(persisted.parent_repair_recovery_count) &&
    verifier_optional_i64_absent(persisted.candidate_repair_recovery_count) &&
    match persisted.repair_recovery_paired { None => true, Some(_) => false }
  }
  parent := verifier_variant_repair_aggregate(result, ordinal, true)
  candidate := verifier_variant_repair_aggregate(result, ordinal, false)
  return verifier_optional_i64_is(persisted.parent_repair_attempt_count, parent.attempted) &&
  verifier_optional_i64_is(persisted.candidate_repair_attempt_count, candidate.attempted) &&
  verifier_optional_i64_is(persisted.parent_repair_recovery_count, parent.recovered) &&
  verifier_optional_i64_is(persisted.candidate_repair_recovery_count, candidate.recovered) &&
  verifier_optional_bool_is(persisted.repair_recovery_paired, parent.paired || candidate.paired)
}

fn verifier_corpus_repair_aggregate_matches(
  borrow persisted: prompt_artifacts.CorpusAggregate,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  if result.schema_version == 1 {
    return verifier_optional_i64_absent(persisted.repair_attempt_count) &&
    verifier_optional_i64_absent(persisted.repair_recovery_count) &&
    verifier_optional_i64_absent(persisted.repair_recovery_paired_count)
  }
  mut attempted := 0
  mut recovered := 0
  mut paired := 0
  mut task := 0
  loop {
    if task >= result.tasks.len() { break }
    parent := verifier_variant_repair_aggregate(result, task, true)
    candidate := verifier_variant_repair_aggregate(result, task, false)
    attempted = attempted + parent.attempted + candidate.attempted
    recovered = recovered + parent.recovered + candidate.recovered
    if parent.paired { paired = paired + 1 }
    if candidate.paired { paired = paired + 1 }
    task = task + 1
  }
  return verifier_optional_i64_is(persisted.repair_attempt_count, attempted) &&
  verifier_optional_i64_is(persisted.repair_recovery_count, recovered) &&
  verifier_optional_i64_is(persisted.repair_recovery_paired_count, paired)
}

fn verifier_task_aggregate_matches(
  borrow persisted: prompt_artifacts.TaskAggregate,
  borrow result: prompt_artifacts.PromptEvaluationResult,
  ordinal: i64,
  task_id: str,
  task_ordinal: slice<i64>,
  parent_pass: slice<i64>,
  candidate_pass: slice<i64>,
  parent_repairs: slice<i64>,
  candidate_repairs: slice<i64>,
  paired_pass: slice<i64>,
  parent_median_present: slice<bool>,
  parent_median: slice<i64>,
  candidate_median_present: slice<bool>,
  candidate_median: slice<i64>,
  improvement_present: slice<bool>,
  improvement: slice<i64>,
  regression_present: slice<bool>,
  regression: slice<i64>,
) -> bool {
  return persisted.task_id == task_id &&
  task_ordinal[ordinal] == ordinal &&
  verifier_task_repair_aggregate_matches(persisted, result, ordinal) &&
  persisted.parent_pass_count == parent_pass[ordinal] &&
  persisted.candidate_pass_count == candidate_pass[ordinal] &&
  persisted.parent_repair_loop_count == parent_repairs[ordinal] &&
  persisted.candidate_repair_loop_count == candidate_repairs[ordinal] &&
  persisted.paired_pass_count == paired_pass[ordinal] &&
  verifier_output_optional_equal(
    parent_median_present[ordinal],
    parent_median[ordinal],
    persisted.parent_paired_median_time_ns,
  ) &&
  verifier_output_optional_equal(
    candidate_median_present[ordinal],
    candidate_median[ordinal],
    persisted.candidate_paired_median_time_ns,
  ) &&
  verifier_output_optional_equal(
    improvement_present[ordinal],
    improvement[ordinal],
    persisted.time_improvement_ppm,
  ) &&
  verifier_output_optional_equal(
    regression_present[ordinal],
    regression[ordinal],
    persisted.time_regression_ppm,
  )
}

fn verifier_corpus_aggregate_matches(
  borrow persisted: prompt_artifacts.CorpusAggregate,
  computed: ScoreCorpusAggregate,
) -> bool {
  return persisted.task_count == computed.task_count &&
  persisted.sample_count == computed.sample_count &&
  persisted.parent_pass_count == computed.parent_pass_count &&
  persisted.candidate_pass_count == computed.candidate_pass_count &&
  persisted.parent_repair_loop_count == computed.parent_repair_loop_count &&
  persisted.candidate_repair_loop_count == computed.candidate_repair_loop_count &&
  persisted.paired_pass_count == computed.paired_pass_count &&
  verifier_optional_i64_equal(persisted.parent_paired_median_time_ns, computed.parent_paired_median_time_ns) &&
  verifier_optional_i64_equal(persisted.candidate_paired_median_time_ns, computed.candidate_paired_median_time_ns) &&
  persisted.completion_gain_count == computed.completion_gain_count &&
  verifier_optional_i64_equal(persisted.time_improvement_ppm, computed.time_improvement_ppm) &&
  verifier_optional_i64_equal(persisted.time_regression_ppm, computed.time_regression_ppm) &&
  persisted.repair_loop_regression_count == computed.repair_loop_regression_count
}

fn verifier_reason_code_matches(text: str, ordinal: i64) -> bool {
  if ordinal == 0 { return text == "PASS_TO_FAIL" }
  if ordinal == 1 { return text == "BUILD" }
  if ordinal == 2 { return text == "TEST" }
  if ordinal == 3 { return text == "POLICY" }
  if ordinal == 4 { return text == "UNRELATED_DIFF" }
  if ordinal == 5 { return text == "PUBLIC_API" }
  if ordinal == 6 { return text == "PATCH_SIZE" }
  if ordinal == 7 { return text == "REPAIR_LOOPS" }
  if ordinal == 8 { return text == "BENCHMARK" }
  if ordinal == 9 { return text == "TIME" }
  return false
}

fn verifier_canonical_nonnegative(text: str, expected: i64) -> bool {
  if text.len() == 0 || expected < 0 { return false }
  bytes := text.bytes()
  if bytes.len() > 1 && bytes[0] == 0x30 { return false }
  mut number := 0
  mut index := 0
  loop {
    if index >= bytes.len() { break }
    byte := bytes[index]
    if byte < 0x30 || byte > 0x39 { return false }
    number = number.checked_mul(10) else { return false }
    number = number.checked_add((byte - 0x30) as i64) else { return false }
    index = index + 1
  }
  return number == expected
}

fn verifier_reason_value_matches(text: str, kind: i64, number: i64) -> bool {
  if kind == 0 { return text == "NONE" && number == 0 }
  if kind == 1 { return text == "PASS" && number == 0 }
  if kind == 2 { return text == "FAIL" && number == 0 }
  if kind == 3 { return text == "POLICY_VIOLATION" && number == 0 }
  if kind == 4 { return text == "ERROR" && number == 0 }
  if kind == 5 { return verifier_canonical_nonnegative(text, number) }
  return false
}

fn verifier_reason_task_matches(
  borrow persisted: prompt_artifacts.RegressionReason,
  ordinal: i64,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> bool {
  if ordinal == -1 { return persisted.task_id == "CORPUS" }
  if ordinal < 0 || ordinal >= result.tasks.len() { return false }
  return verifier_reason_task_id_matches(persisted, result.tasks[ordinal])
}

fn verifier_reason_task_id_matches(
  borrow persisted: prompt_artifacts.RegressionReason,
  borrow task: prompt_artifacts.PromptEvaluationTask,
) -> bool {
  return persisted.task_id == task.task_id
}

fn verifier_reason_matches(
  borrow persisted: prompt_artifacts.RegressionReason,
  index: i64,
  borrow result: prompt_artifacts.PromptEvaluationResult,
  reason_task: slice<i64>,
  reason_sample: slice<i64>,
  reason_code: slice<i64>,
  parent_kind: slice<i64>,
  parent_number: slice<i64>,
  candidate_kind: slice<i64>,
  candidate_number: slice<i64>,
  limit_kind: slice<i64>,
  limit_number: slice<i64>,
) -> bool {
  return verifier_reason_task_matches(persisted, reason_task[index], result) &&
  persisted.sample_index == reason_sample[index] &&
  verifier_reason_code_matches(persisted.code, reason_code[index]) &&
  verifier_reason_value_matches(persisted.parent_value, parent_kind[index], parent_number[index]) &&
  verifier_reason_value_matches(persisted.candidate_value, candidate_kind[index], candidate_number[index]) &&
  verifier_reason_value_matches(persisted.limit, limit_kind[index], limit_number[index])
}

fn verifier_policy_limit_from_result(
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> Result<ScorePolicyLimit, Error> {
  return match result.acceptance_policy {
    None => Err(Error.Invalid),
    Some(policy) => Ok(ScorePolicyLimit {
        maximum_time_regression_ppm: policy.maximum_time_regression_ppm,
        maximum_repair_loop_regression_count: policy.maximum_repair_loop_regression_count,
      }),
  }
}

fn verifier_aggregate_valid(
  rows: slice<ScoreRow>,
  task_limits: slice<ScoreTaskLimit>,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> Result<ScoreCorpusAggregate, Error> {
  task_count := result.tasks.len()
  reason_capacity := verifier_reason_capacity(task_count, result.sample_count)?
  mut task_ordinal := verifier_i64_array(task_count)
  mut parent_pass := verifier_i64_array(task_count)
  mut candidate_pass := verifier_i64_array(task_count)
  mut parent_repairs := verifier_i64_array(task_count)
  mut candidate_repairs := verifier_i64_array(task_count)
  mut paired_pass := verifier_i64_array(task_count)
  mut parent_median_present := verifier_bool_array(task_count)
  mut parent_median := verifier_i64_array(task_count)
  mut candidate_median_present := verifier_bool_array(task_count)
  mut candidate_median := verifier_i64_array(task_count)
  mut improvement_present := verifier_bool_array(task_count)
  mut improvement := verifier_i64_array(task_count)
  mut regression_present := verifier_bool_array(task_count)
  mut regression := verifier_i64_array(task_count)

  mut reason_task := verifier_i64_array(reason_capacity)
  mut reason_sample := verifier_i64_array(reason_capacity)
  mut reason_code := verifier_i64_array(reason_capacity)
  mut parent_kind := verifier_i64_array(reason_capacity)
  mut parent_number := verifier_i64_array(reason_capacity)
  mut candidate_kind := verifier_i64_array(reason_capacity)
  mut candidate_number := verifier_i64_array(reason_capacity)
  mut limit_kind := verifier_i64_array(reason_capacity)
  mut limit_number := verifier_i64_array(reason_capacity)

  policy_limit := verifier_policy_limit_from_result(result)?
  scored := aggregate(
    rows,
    task_limits,
    policy_limit,
    result.sample_count,
    task_ordinal,
    parent_pass,
    candidate_pass,
    parent_repairs,
    candidate_repairs,
    paired_pass,
    parent_median_present,
    parent_median,
    candidate_median_present,
    candidate_median,
    improvement_present,
    improvement,
    regression_present,
    regression,
    reason_task,
    reason_sample,
    reason_code,
    parent_kind,
    parent_number,
    candidate_kind,
    candidate_number,
    limit_kind,
    limit_number,
  )
  aggregate_complete := match scored.status { Complete => true, _ => false }
  if !aggregate_complete || scored.error_code != 0 || scored.error_index != -1 ||
  scored.reason_count < 0 || scored.reason_count > reason_capacity ||
  scored.reason_count != result.serious_regression_reasons.len() ||
  result.task_aggregates.len() != task_count {
    return Err(Error.Invalid)
  }

  mut index := 0
  loop {
    if index >= task_count { break }
    if !verifier_task_aggregate_matches(
      result.task_aggregates[index],
      result,
      index,
      result.tasks[index].task_id,
      task_ordinal,
      parent_pass,
      candidate_pass,
      parent_repairs,
      candidate_repairs,
      paired_pass,
      parent_median_present,
      parent_median,
      candidate_median_present,
      candidate_median,
      improvement_present,
      improvement,
      regression_present,
      regression,
    ) {
      return Err(Error.Invalid)
    }
    index = index + 1
  }

  index = 0
  loop {
    if index >= scored.reason_count { break }
    if !verifier_reason_matches(
      result.serious_regression_reasons[index],
      index,
      result,
      reason_task,
      reason_sample,
      reason_code,
      parent_kind,
      parent_number,
      candidate_kind,
      candidate_number,
      limit_kind,
      limit_number,
    ) {
      return Err(Error.Invalid)
    }
    index = index + 1
  }

  corpus_valid := match result.corpus_aggregate {
    None => false,
    Some(corpus) => verifier_corpus_aggregate_matches(corpus, scored.corpus) &&
    verifier_corpus_repair_aggregate_matches(corpus, result),
  }
  if !corpus_valid { return Err(Error.Invalid) }
  return Ok(scored.corpus)
}

fn verifier_all_task_completion_not_lower(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  mut index := 0
  loop {
    if index >= result.task_aggregates.len() { break }
    if !verifier_task_completion_not_lower(result.task_aggregates[index]) { return false }
    index = index + 1
  }
  return true
}

fn verifier_task_completion_not_lower(borrow aggregate_value: prompt_artifacts.TaskAggregate) -> bool {
  return aggregate_value.candidate_pass_count >= aggregate_value.parent_pass_count
}

fn verifier_status_matches_policy(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  corpus: ScoreCorpusAggregate,
  borrow policy: prompt_artifacts.PromptAcceptancePolicy,
) -> bool {
  if result.serious_regression_reasons.len() > 0 {
    return result.status == "SERIOUS_REGRESSION"
  }
  completion_improved := corpus.completion_gain_count >= policy.minimum_completion_gain_count
  time_improved := if corpus.candidate_pass_count == corpus.parent_pass_count &&
  verifier_all_task_completion_not_lower(result) &&
  corpus.candidate_repair_loop_count <= corpus.parent_repair_loop_count {
    match corpus.time_improvement_ppm {
      None => false,
      Some(value) => value >= policy.minimum_time_improvement_ppm,
    }
  } else {
    false
  }
  expected_improved := completion_improved || time_improved
  return if expected_improved {
    result.status == "IMPROVED"
  } else {
    result.status == "NO_IMPROVEMENT"
  }
}

fn verifier_status_matches(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  corpus: ScoreCorpusAggregate,
) -> bool {
  return match result.acceptance_policy {
    None => false,
    Some(policy) => verifier_status_matches_policy(result, corpus, policy),
  }
}

fn verifier_all_seeds_applied(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  mut index := 0
  loop {
    if index >= result.rows.len() { break }
    if !verifier_row_seed_applied(result.rows[index]) { return false }
    index = index + 1
  }
  return true
}

fn verifier_row_seed_applied(borrow row: prompt_artifacts.PromptTaskRow) -> bool {
  return row.measurement.seed_attestation.result == "APPLIED"
}

fn verifier_gate_environment_eligible(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return match result.environment {
    None => false,
    Some(environment) => match environment.core.logical_cpu_count {
      None => false,
      Some(value) => value > 0,
    },
  }
}

fn verifier_gate_provider_eligible(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return match result.provider_control {
    None => false,
    Some(control) => control.provider_kind != "FIXTURE",
  }
}

fn verifier_gate_policy_minima(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return match result.acceptance_policy {
    None => false,
    Some(policy) => result.tasks.len() >= policy.minimum_task_count &&
    result.sample_count >= policy.minimum_samples_per_variant,
  }
}

fn verifier_gate_computed(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  borrow evidence: prompt_artifacts.PromptEvaluationEvidence,
) -> bool {
  return result.status == "IMPROVED" &&
  result.serious_regression_reasons.len() == 0 &&
  evidence.trust.align_llm_reachability == "VERIFIED" &&
  evidence.trust.align_reachability == "VERIFIED" &&
  evidence.trust.corpus_reachability == "VERIFIED" &&
  verifier_gate_environment_eligible(result) &&
  verifier_gate_provider_eligible(result) &&
  verifier_gate_policy_minima(result) &&
  verifier_all_seeds_applied(result)
}

fn verifier_complete_environment_valid(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return match result.environment {
    None => false,
    Some(environment) => verifier_environment_valid(environment),
  }
}

fn verifier_corpus_aggregate_absent(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return match result.corpus_aggregate { None => true, Some(_) => false }
}

fn verifier_invalid_result_shape(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return result.status == "INVALID_INPUT" &&
  !result.gate_eligible &&
  result.rows.len() == 0 &&
  result.task_aggregates.len() == 0 &&
  result.serious_regression_reasons.len() == 0 &&
  result.snapshot_requests.len() == 0 &&
  result.snapshot_results.len() == 0 &&
  result.input_snapshots.len() == 0 &&
  result.snapshot_attestations.len() == 0 &&
  verifier_corpus_aggregate_absent(result) &&
  match result.workspace_preflight_source { None => true, Some(_) => false } &&
  match result.workspace_preflight { None => true, Some(_) => false } &&
  match result.environment { None => true, Some(_) => false }
}

fn verifier_invalid_embedded_state_valid(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  tasks_valid := if result.tasks.len() == 0 { true } else { verifier_tasks_valid(result) }
  policy_valid := match result.acceptance_policy {
    None => true,
    Some(_) => if result.tasks.len() == 0 { false } else { verifier_policy_fits_result(result) },
  }
  workspace_valid := match result.workspace_preflight_request {
    None => true,
    Some(request) => match result.evaluation_id {
      None => false,
      Some(evaluation_id) => verifier_workspace_request_valid(request, evaluation_id),
    },
  }
  return tasks_valid && policy_valid && workspace_valid
}

fn verifier_error_result_shape(borrow result: prompt_artifacts.PromptEvaluationResult) -> bool {
  return result.status == "ERROR" &&
  !result.gate_eligible &&
  result.task_aggregates.len() == 0 &&
  result.serious_regression_reasons.len() == 0 &&
  verifier_corpus_aggregate_absent(result)
}

fn verifier_noncomplete_prefix(
  out: region,
  borrow result: prompt_artifacts.PromptEvaluationResult,
) -> Result<PromptScoreStatus, Error> {
  rows := verifier_build_rows(out, result)?
  limits := verifier_build_task_limits(out, result)
  if !verifier_prefix_valid(rows, limits, result) { return Err(Error.Invalid) }
  return Ok(PromptScoreStatus.NoncompleteError)
}

fn verifier_complete_score(
  out: region,
  borrow result: prompt_artifacts.PromptEvaluationResult,
  borrow evidence: prompt_artifacts.PromptEvaluationEvidence,
) -> Result<PromptScoreStatus, Error> {
  rows := verifier_build_rows(out, result)?
  limits := verifier_build_task_limits(out, result)
  if !verifier_prefix_valid(rows, limits, result) { return Err(Error.Invalid) }
  corpus := verifier_aggregate_valid(rows, limits, result)?
  if !verifier_status_matches(result, corpus) { return Err(Error.Invalid) }
  computed_gate := verifier_gate_computed(result, evidence)
  if result.gate_eligible != computed_gate { return Err(Error.Invalid) }
  if computed_gate {
    return Ok(PromptScoreStatus.ImprovedEligible)
  }
  return Ok(PromptScoreStatus.CompleteIneligible)
}

pub fn verify_result(
  borrow result: prompt_artifacts.PromptEvaluationResult,
  borrow evidence: prompt_artifacts.PromptEvaluationEvidence,
) -> Result<PromptScoreStatus, Error> {
  if !verifier_base_result_valid(result) { return Err(Error.Invalid) }
  if !verifier_pair_identity_valid(result, evidence) { return Err(Error.Invalid) }
  if result.error_code == "RESULT_TOO_LARGE" {
    if !verifier_compact_result_valid(result, evidence) {
      return Err(Error.Invalid)
    }
    return Ok(PromptScoreStatus.NoncompleteError)
  }
  if !verifier_common_identity_valid(result) { return Err(Error.Invalid) }
  if !verifier_scope_trust_valid(result, evidence) { return Err(Error.Invalid) }
  if result.status == "INVALID_INPUT" {
    if !verifier_invalid_result_shape(result) ||
    !verifier_invalid_embedded_state_valid(result) ||
    evidence.expected_inputs.len() != 0 {
      return Err(Error.Invalid)
    }
    return Ok(PromptScoreStatus.NoncompleteError)
  }
  if !verifier_complete_inputs_present(result) { return Err(Error.Invalid) }
  if !verifier_tasks_valid(result) { return Err(Error.Invalid) }
  if !verifier_policy_fits_result(result) { return Err(Error.Invalid) }
  if !verifier_workspace_trace_valid(result) { return Err(Error.Invalid) }
  if !verifier_trace_arrays_valid(result) { return Err(Error.Invalid) }
  if !verifier_rows_and_attestations_valid(result) { return Err(Error.Invalid) }
  if !verifier_expected_inputs_valid(result, evidence) { return Err(Error.Invalid) }
  if result.status == "ERROR" {
    if !verifier_error_result_shape(result) { return Err(Error.Invalid) }
    return arena out {
      verifier_noncomplete_prefix(out, result)
    }
  }
  if !verifier_complete_status(result.status) { return Err(Error.Invalid) }
  if !verifier_complete_environment_valid(result) { return Err(Error.Invalid) }
  return arena out {
    verifier_complete_score(out, result, evidence)
  }
}
