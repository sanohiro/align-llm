module runtime_numeric_stream_smoke
import runtime_numeric_stream

fn frame(kind: i64, layer: i64) -> runtime_numeric_stream.Frame =
runtime_numeric_stream.Frame { kind: kind, layer: layer, step: 0, width: 2, height: 1 }

fn golden(root: str) -> Result<(), Error> {
  mut owner := runtime_numeric_stream.create(root, "golden", 1, 160, 65576)?
  if runtime_numeric_stream.reservation(owner) != 65576 { return Err(Error.Invalid) }
  mut payload := buffer(8)
  payload.put_u32_le(1065353216)
  payload.put_u32_le(1073741824)
  payload_view := payload.bytes()
  runtime_numeric_stream.record(owner, frame(1, 4294967295), payload_view)?
  mut second := buffer(8)
  second.put_u32_le(1048576000)
  second.put_u32_le(3204448256)
  second_view := second.bytes()
  runtime_numeric_stream.record(owner, frame(2, 0), second_view)?
  runtime_numeric_stream.finish(owner)?
  if owner.records != 2 || owner.written_bytes != 160 { return Err(Error.Invalid) }
  match runtime_numeric_stream.finish(owner) { Ok(_) => { return Err(Error.Invalid) }, Err(_) => {} }
  match runtime_numeric_stream.record(owner, frame(2, 0), second_view) {
    Ok(_) => { return Err(Error.Invalid) }, Err(_) => {}
  }
  return Ok(())
}

fn refusal(root: str, name: str, mode: i64) -> Result<(), Error> {
  maximum := if mode == 1 { 108 } else { 160 }
  mut owner := runtime_numeric_stream.create(root, name, 1, maximum, 65576)?
  mut payload := buffer(8)
  payload.put_u32_le(if mode == 2 { 2139095040 } else { 1065353216 })
  payload.put_u32_le(if mode == 2 { 2143289344 } else { 1073741824 })
  payload_view := payload.bytes()
  selected := if mode == 0 { frame(1, 0) } else { frame(1, 4294967295) }
  match runtime_numeric_stream.record(owner, selected, payload_view) {
    Ok(_) => { return Err(Error.Invalid) }, Err(_) => {}
  }
  if !owner.failed || owner.records != 0 { return Err(Error.Invalid) }
  if mode == 2 && owner.nonfinite_count != 2 { return Err(Error.Invalid) }
  match runtime_numeric_stream.record(owner, frame(2, 0), payload_view) {
    Ok(_) => { return Err(Error.Invalid) }, Err(_) => {}
  }
  match runtime_numeric_stream.finish(owner) { Ok(_) => { return Err(Error.Invalid) }, Err(_) => {} }
  return Ok(())
}

pub fn main(args: array<str>) -> Result<(), Error> {
  if args.len() != 2 { return Err(Error.Invalid) }
  mut inactive := runtime_numeric_stream.disabled()
  empty := buffer(0)
  empty_view := empty.bytes()
  runtime_numeric_stream.record(inactive, frame(-1, -1), empty_view)?
  runtime_numeric_stream.finish(inactive)?
  if runtime_numeric_stream.reservation(inactive) != 0 { return Err(Error.Invalid) }
  golden(args[1])?
  match runtime_numeric_stream.create(args[1], "golden", 1, 160, 65576) {
    Ok(_) => { return Err(Error.Invalid) }, Err(_) => {}
  }
  match runtime_numeric_stream.create(args[1], "budget", 1, 160, 65575) {
    Ok(_) => { return Err(Error.Invalid) }, Err(_) => {}
  }
  match runtime_numeric_stream.create(args[1], "model", 3, 160, 65576) {
    Ok(_) => { return Err(Error.Invalid) }, Err(_) => {}
  }
  refusal(args[1], "shape", 0)?
  refusal(args[1], "bound", 1)?
  refusal(args[1], "nonfinite", 2)?
  mut no_records := runtime_numeric_stream.create(args[1], "empty", 2, 160, 65576)?
  match runtime_numeric_stream.finish(no_records) { Ok(_) => { return Err(Error.Invalid) }, Err(_) => {} }
  print("runtime numeric stream smoke: PASS")
  return Ok(())
}
