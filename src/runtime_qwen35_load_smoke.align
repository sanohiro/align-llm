module runtime_qwen35_load_smoke

import ggml_ffi
import gguf
import runtime_attention
import runtime_qwen35_geometry
import runtime_qwen35_attention
import runtime_qwen35_ffn
import runtime_qwen35_load
import runtime_qwen35_recurrent
import runtime_qwen35_state
import runtime_qwen35_state_io
import runtime_qwen_load
import runtime_execution
import runtime_memory
import runtime_inputs
import runtime_kv
import runtime_weights
import std.fs

pub fn main(args: array<str>) -> Result<(), Error> {
  if args.len() != 6 { return Err(Error.Invalid) }
  source := fs.read_file(args[1])?
  snapshot := gguf.open_snapshot(args[2])?
  g := runtime_qwen35_geometry.parse_snapshot(source, snapshot)?
  pack := fs.open_rw(args[3])?
  owner := ggml_ffi.gpu_device_open(
    "metal", "MTL0", args[4], args[5], 2147483648, 2147483648,
  ) else { return Err(Error.Invalid) }
  plan := runtime_qwen35_load.build_plan_file_capacity_bounded(owner, pack, g, 512)?
  if plan.count != 320 || plan.ggml_type.len() != 320
    || plan.nbytes.len() != 320 || plan.pack_offset.len() != 320
    || plan.ne0[0] != g.n_embd || plan.ne1[0] != g.n_vocab
    || plan.ne0[319] != g.n_embd || plan.ne1[319] != 1
    || plan.weights_bytes < 0 || plan.kv_bytes < 0 {
    return Err(Error.Invalid)
  }
  mut payload_bytes := 0
  mut at := 0
  loop {
    if at >= plan.count { break }
    payload_bytes = payload_bytes + plan.nbytes[at]
    at = at + 1
  }
  runtime_attention.select(owner, 1, 1, 1, g.context_length,
    g.head_dim, g.n_head, g.n_head_kv)?
  runtime_memory.admit(owner, runtime_memory.MemoryPlan {
      weights_bytes: plan.weights_bytes, kv_bytes: plan.kv_bytes,
      workspace_bytes: 268435456, metadata_bytes: 4194304,
      staging_bytes: 1048576, legacy_cache_bytes: 0,
    })?
  runtime_memory.allocate(owner)?
  runtime_qwen_load.load_file(owner, pack, plan, 1048576)?
  runtime_qwen35_load.define_resident(owner, g, 512)?
  if runtime_weights.state(owner, ggml_ffi.GPU_WEIGHT_CREATED) != 320
    || runtime_weights.state(owner, ggml_ffi.GPU_WEIGHT_UPLOADED) != 320
    || runtime_weights.state(owner, ggml_ffi.GPU_WEIGHT_UPLOADED_BYTES) != payload_bytes
    || runtime_kv.state(owner, ggml_ffi.GPU_KV_CREATED) != 84
    || runtime_kv.state(owner, ggml_ffi.GPU_KV_FINISHED) != 1 {
    return Err(Error.Invalid)
  }
  mut slot_storage := buffer.filled(1040, 0 as u8)
  slots := slot_storage.bytes()
  ggml_ffi.slots_init(slots, slots.len(), "qwen35_state_slots") else { return Err(Error.Invalid) }
  mut state := runtime_qwen35_state.new()
  runtime_qwen35_state_io.bind_read(owner, g, state, 0, runtime_qwen35_state.CONV, slots, 0)?
  runtime_qwen35_state_io.bind_read(owner, g, state, 22, runtime_qwen35_state.DELTA, slots, 1)?
  if ggml_ffi.slot_ne(slots, 0, 0) != 3 || ggml_ffi.slot_ne(slots, 0, 1) != 6144
    || ggml_ffi.slot_ne(slots, 1, 0) != 128 || ggml_ffi.slot_ne(slots, 1, 2) != 16 {
    return Err(Error.Invalid)
  }
  runtime_qwen35_state.finish(state, true)
  runtime_qwen35_state_io.bind_read(owner, g, state, 0, runtime_qwen35_state.CONV, slots, 0)?
  if ggml_ffi.slot_ne(slots, 0, 0) != 3 || ggml_ffi.slot_ne(slots, 0, 1) != 6144 {
    return Err(Error.Invalid)
  }
  runtime_inputs.begin(owner, 3)?
  hidden := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 0, n_dims: 2, ne0: g.n_embd, ne1: 1, ne2: 1, ne3: 1,
    })?
  if hidden != 0 { return Err(Error.Invalid) }
  positions := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 4, ne1: 1, ne2: 1, ne3: 1,
    })?
  width := runtime_inputs.attention_width(1, g.context_length)?
  mask := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 0, n_dims: 2, ne0: width, ne1: 1, ne2: 1, ne3: 1,
    })?
  if positions != 1 || mask != 2 { return Err(Error.Invalid) }
  runtime_inputs.finish(owner)?
  ctx := ggml_ffi.gpu_graph_context_open(owner, ggml_ffi.GPU_GRAPH_PREFILL, 1048576)
  if ggml_ffi.handle_absent(ctx) { return Err(Error.Invalid) }
  graph := ggml_ffi.graph_new(ctx)
  if ggml_ffi.handle_absent(graph) { return Err(Error.Invalid) }
  ggml_ffi.slots_init(slots, slots.len(), "qwen35_recurrent_slots") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_input_slot(owner, 0, slots, runtime_qwen35_recurrent.INPUT) else {
    return Err(Error.Invalid)
  }
  runtime_qwen35_recurrent.build_one(owner, g, state, 0, ggml_ffi.GPU_GRAPH_PREFILL,
    ctx, graph, slots)?
  if ggml_ffi.slot_ne(slots, runtime_qwen35_recurrent.OUTPUT, 0) != g.n_embd
    || ggml_ffi.slot_ne(slots, runtime_qwen35_recurrent.OUTPUT, 1) != 1
    || ggml_ffi.graph_node_count(graph) < 3 {
    return Err(Error.Invalid)
  }
  ggml_ffi.slot_copy(slots, runtime_qwen35_ffn.INPUT, slots,
    runtime_qwen35_recurrent.INPUT, "qwen35_ffn_input") else { return Err(Error.Invalid) }
  ggml_ffi.slot_copy(slots, runtime_qwen35_ffn.ATTENTION, slots,
    runtime_qwen35_recurrent.OUTPUT, "qwen35_ffn_attention") else { return Err(Error.Invalid) }
  runtime_qwen35_ffn.build_one(owner, g, 0, ctx, slots)?
  if ggml_ffi.slot_ne(slots, runtime_qwen35_ffn.OUTPUT, 0) != g.n_embd
    || ggml_ffi.slot_ne(slots, runtime_qwen35_ffn.OUTPUT, 1) != 1 {
    return Err(Error.Invalid)
  }
  ggml_ffi.slot_mark_output(slots, runtime_qwen35_ffn.OUTPUT,
    "qwen35_block_output") else { return Err(Error.Invalid) }
  ggml_ffi.graph_expand(graph, slots, runtime_qwen35_ffn.OUTPUT,
    "qwen35_block_output") else { return Err(Error.Invalid) }
  key := "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  runtime_execution.prepare(owner, ggml_ffi.GPU_GRAPH_PREFILL, key, graph)?
  mut hidden_image := buffer.filled(g.n_embd * 4, 0 as u8)
  mut hidden_view := hidden_image.bytes()
  hidden_view.set_u32_le(0, 1065353216 as u32)
  runtime_inputs.update(owner, 0, 0, hidden_view)?
  runtime_execution.compute(owner, ggml_ffi.GPU_GRAPH_PREFILL, key, graph)?
  mut result_image := buffer.filled(g.n_embd * 4, 0 as u8)
  result := result_image.bytes()
  ggml_ffi.gpu_slot_get(owner, slots, runtime_qwen35_ffn.OUTPUT,
    result, 0, result.len(), "qwen35_block_output") else { return Err(Error.Invalid) }
  mut byte_index := 0
  mut nonzero := false
  loop {
    if byte_index >= result.len() { break }
    if result[byte_index] != 0 { nonzero = true }
    byte_index = byte_index + 1
  }
  if !nonzero { return Err(Error.Invalid) }
  attention_ctx := ggml_ffi.gpu_graph_context_open(owner, ggml_ffi.GPU_GRAPH_DECODE, 1048576)
  if ggml_ffi.handle_absent(attention_ctx) { return Err(Error.Invalid) }
  attention_graph := ggml_ffi.graph_new(attention_ctx)
  if ggml_ffi.handle_absent(attention_graph) { return Err(Error.Invalid) }
  mut attention_slot_storage := buffer.filled(1040, 0 as u8)
  attention_slots := attention_slot_storage.bytes()
  ggml_ffi.slots_init(attention_slots, attention_slots.len(), "qwen35_attention_slots") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_input_slot(owner, 0, attention_slots, runtime_qwen35_attention.INPUT) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_input_slot(owner, 1, attention_slots, runtime_qwen35_attention.POSITION) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_input_slot(owner, 2, attention_slots, runtime_qwen35_attention.MASK) else {
    return Err(Error.Invalid)
  }
  runtime_qwen35_attention.build_one(owner, g, 3, 0, ggml_ffi.GPU_GRAPH_DECODE,
    attention_ctx, attention_graph, attention_slots)?
  if ggml_ffi.slot_ne(attention_slots, runtime_qwen35_attention.OUTPUT, 0) != g.n_embd
    || ggml_ffi.slot_ne(attention_slots, runtime_qwen35_attention.OUTPUT, 1) != 1 {
    return Err(Error.Invalid)
  }
  ggml_ffi.slot_copy(attention_slots, runtime_qwen35_ffn.INPUT, attention_slots,
    runtime_qwen35_attention.INPUT, "qwen35_attention_ffn_input") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.slot_copy(attention_slots, runtime_qwen35_ffn.ATTENTION, attention_slots,
    runtime_qwen35_attention.OUTPUT, "qwen35_attention_ffn_attention") else {
    return Err(Error.Invalid)
  }
  runtime_qwen35_ffn.build_one(owner, g, 3, attention_ctx, attention_slots)?
  ggml_ffi.slot_mark_output(attention_slots, runtime_qwen35_ffn.OUTPUT,
    "qwen35_attention_block_output") else { return Err(Error.Invalid) }
  ggml_ffi.graph_expand(attention_graph, attention_slots, runtime_qwen35_ffn.OUTPUT,
    "qwen35_attention_block_output") else { return Err(Error.Invalid) }
  attention_key := "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
  runtime_execution.prepare(owner, ggml_ffi.GPU_GRAPH_DECODE, attention_key, attention_graph)?
  mut position_image := buffer.filled(16, 0 as u8)
  mut position_view := position_image.bytes()
  runtime_qwen35_geometry.write_text_positions(0, 1, position_view)?
  runtime_inputs.update(owner, 1, 0, position_view)?
  mut mask_image := buffer.filled(width * 4, 0 as u8)
  mut mask_view := mask_image.bytes()
  mut mask_at := 1
  loop {
    if mask_at >= width { break }
    mask_view.set_u32_le(mask_at * 4, 4286578688 as u32)
    mask_at = mask_at + 1
  }
  runtime_inputs.update(owner, 2, 0, mask_view)?
  runtime_execution.compute(owner, ggml_ffi.GPU_GRAPH_DECODE, attention_key, attention_graph)?
  mut attention_result_image := buffer.filled(g.n_embd * 4, 0 as u8)
  attention_result := attention_result_image.bytes()
  ggml_ffi.gpu_slot_get(owner, attention_slots, runtime_qwen35_ffn.OUTPUT,
    attention_result, 0, attention_result.len(), "qwen35_attention_block_output") else {
    return Err(Error.Invalid)
  }
  nonzero = false
  byte_index = 0
  loop {
    if byte_index >= attention_result.len() { break }
    if attention_result[byte_index] != 0 { nonzero = true }
    byte_index = byte_index + 1
  }
  if !nonzero { return Err(Error.Invalid) }
  print("qwen35 load: PASS")
  return Ok(())
}
