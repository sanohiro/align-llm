module prompt_evaluate

import core.json
import prompt_artifacts
import prompt_artifact_io
import prompt_evaluation_inputs
import prompt_evaluation_invocation
import prompt_evaluation_native
import prompt_evaluation_request
import prompt_evaluation_result
import prompt_evaluation_runtime
import prompt_score
import prompt_scope_cleanup
import prompt_task_environment
import prompt_workspace
import std.env
import std.fs
import std.process
import std.time

pub PromptEvaluateStatus { Published, InvalidInput, EvaluationFailed, OutputWrite, CleanupFailed }

fn print_owned_text(borrow value: string) {
  view: str := value
  print(view)
}

fn publish_evaluator_output(
  result_source: str,
  evidence_source: Option<str>,
  project_root: str,
  result_relative: str,
  evidence_relative: str,
  evaluation_id: str,
) -> Result<PromptEvaluateStatus, Error> {
  result := prompt_artifact_io.decode_prompt_evaluation_result_source(result_source)?
  return match evidence_source {
    None => {
      if result.status != "INVALID_INPUT" {
        return Err(Error.Invalid)
      }
      published := prompt_artifact_io.write_prompt_evaluation_result_only_detailed(
        project_root,
        result_relative,
        result,
      )
      match published.status {
        CleanupFailed => {
          print("recovery paths:")
          mut index := 0
          loop {
            if index >= published.surviving_owned_paths.len() { break }
            print_owned_text(published.surviving_owned_paths[index])
            index = index + 1
          }
        },
        _ => {},
      }
      return Ok(match published.status {
          Published => PromptEvaluateStatus.InvalidInput,
          OutputWrite => PromptEvaluateStatus.OutputWrite,
          CleanupFailed => PromptEvaluateStatus.CleanupFailed,
        })
    },
    Some(serialized_evidence) => {
      evidence := prompt_artifact_io.decode_prompt_evaluation_evidence_source(serialized_evidence)?
      prompt_score.verify_result(result, evidence)?
      complete := result.status == "IMPROVED" ||
      result.status == "NO_IMPROVEMENT" ||
      result.status == "SERIOUS_REGRESSION"
      published := prompt_artifact_io.write_prompt_evaluation_pair_detailed(
        project_root,
        result_relative,
        evidence_relative,
        evaluation_id,
        result,
        evidence,
      )
      match published.status {
        CleanupFailed => {
          print("recovery paths:")
          mut index := 0
          loop {
            if index >= published.surviving_owned_paths.len() { break }
            print_owned_text(published.surviving_owned_paths[index])
            index = index + 1
          }
        },
        _ => {},
      }
      return Ok(match published.status {
          Published => if complete { PromptEvaluateStatus.Published } else { PromptEvaluateStatus.EvaluationFailed },
          OutputWrite => PromptEvaluateStatus.OutputWrite,
          CleanupFailed => PromptEvaluateStatus.CleanupFailed,
        })
    },
  }
}

fn invalid(borrow request: prompt_artifacts.PromptEvaluateRequest, result_relative: str, code: str, detail: str) -> PromptEvaluateStatus {
  result := prompt_evaluation_result.invalid(request.evaluation_id, request.sample_count, code, detail) else { return PromptEvaluateStatus.EvaluationFailed }
  source := json.encode_bounded(result, 268435456) else { return PromptEvaluateStatus.EvaluationFailed }
  return publish_evaluator_output(source, None, request.project_root, result_relative, request.evaluation_evidence_path,
    request.evaluation_id) else { return PromptEvaluateStatus.EvaluationFailed }
}

fn credential(borrow control: prompt_artifacts.EvaluationProviderControl) -> Result<string, Error> {
  return match control.api_key_env {
    None => Ok("".clone()),
    Some(name) => match env.get(name) { None => Err(Error.Denied), Some(value) => Ok(value) },
  }
}

pub fn evaluate_file(request_path: str, result_relative: str) -> PromptEvaluateStatus {
  request := prompt_artifact_io.load_prompt_evaluate_request(request_path) else { return PromptEvaluateStatus.InvalidInput }
  if !prompt_evaluation_request.relative(result_relative) || !prompt_artifact_io.output_available(request.project_root, result_relative) {
    return PromptEvaluateStatus.InvalidInput
  }
  if !prompt_evaluation_request.relative(request.evaluation_evidence_path) || result_relative == request.evaluation_evidence_path ||
  !prompt_artifact_io.output_available(request.project_root, request.evaluation_evidence_path) {
    return invalid(request, result_relative, "INVALID_PATH", "evaluation evidence path is invalid or occupied")
  }
  prompt_evaluation_request.validate(request) else { return invalid(request, result_relative, "INVALID_INPUT", "evaluation request is invalid") }
  roots := prompt_workspace.admit(request.project_root, request.workspace_path, true, time.instant() + 10000000000) else {
    return invalid(request, result_relative, "INVALID_PATH", "evaluation project or workspace is unavailable")
  }
  admitted := prompt_evaluation_inputs.load(roots.project.directory, request, time.instant() + 60000000000) else {
    return invalid(request, result_relative, "INVALID_INPUT", "evaluation input is invalid")
  }
  secret := credential(admitted.tasks[0].control) else { return invalid(request, result_relative, "INVALID_INPUT", "evaluation credential is unavailable") }
  declared_environment := prompt_task_environment.worker(admitted.tasks[0].environment, admitted.tasks[0].control, secret) else {
    return invalid(request, result_relative, "INVALID_INPUT", "evaluation environment is invalid")
  }
  runtime := prompt_evaluation_runtime.admit(request, admitted.source_policy, admitted.tasks[0].environment, time.instant() + 10000000000) else {
    return invalid(request, result_relative, "INVALID_INPUT", "evaluation execution authority is unavailable")
  }
  procfs := fs.open_directory("/proc") else { return PromptEvaluateStatus.EvaluationFailed }
  mut signals := process.signals(process.signal_set { hangup: false, interrupt: true, quit: false, terminate: true }) else {
    return PromptEvaluateStatus.EvaluationFailed
  }
  executed := prompt_evaluation_native.run(request, admitted, roots, runtime, procfs, signals, secret)
  outcome := match executed {
    Err(_) => { restored := signals.close(); return PromptEvaluateStatus.EvaluationFailed },
    Ok(value) => value,
  }
  return match outcome {
    Finished(output) => {
      signals.close() else { return PromptEvaluateStatus.EvaluationFailed }
      if output.survivors.len() != 0 {
        print("recovery paths:")
        mut index := 0
        loop { if index == output.survivors.len() { break }; print_owned_text(output.survivors[index]); index = index + 1 }
      }
      evidence: str := output.evidence_source
      publish_evaluator_output(output.result_source, Some(evidence), request.project_root, result_relative,
        request.evaluation_evidence_path, request.evaluation_id) else { return PromptEvaluateStatus.EvaluationFailed }
    },
    SourceStopped(attempt) => {
      mut scope := attempt.scope
      cleanup := prompt_scope_cleanup.run(scope, time.instant() + 10000000000, 32768, 8192)
      restored := signals.close()
      released := match cleanup { Ok(report) => report.released, Err(_) => false }
      if !released { return PromptEvaluateStatus.CleanupFailed }
      PromptEvaluateStatus.EvaluationFailed
    },
    TaskStopped(owner) => {
      storage_path := owner.storage.path.clone()
      variant_path := owner.names.variant.clone()
      rendered_path := owner.names.rendered.clone()
      request_path_owned := owner.names.request.clone()
      measurement_path := owner.names.measurement.clone()
      mut scope := owner.scope
      cleaned := prompt_scope_cleanup.run(scope, time.instant() + 10000000000, 32768, 8192)
      restored := signals.close()
      released := match cleaned { Ok(report) => report.released, Err(_) => false }
      if !released {
        print("recovery paths:"); print_owned_text(storage_path)
        if (owner.owned & 1) != 0 { print_owned_text(variant_path) }
        if (owner.owned & 2) != 0 { print_owned_text(rendered_path) }
        if (owner.owned & 4) != 0 { print_owned_text(request_path_owned) }
        if (owner.owned & 8) != 0 { print_owned_text(measurement_path) }
        return PromptEvaluateStatus.CleanupFailed
      }
      removed := prompt_evaluation_runtime.remove(owner.storage, true, time.instant() + 10000000000)
      mut owned := owner.owned
      retired := prompt_evaluation_invocation.retire(roots.workspace.directory, owner.names, owned)
      if match removed { Ok(_) => false, Err(_) => true } {
        print("recovery paths:"); print_owned_text(storage_path)
        return PromptEvaluateStatus.CleanupFailed
      }
      if match retired { Ok(_) => false, Err(_) => true } {
        print("recovery paths:")
        if (owned & 1) != 0 { print_owned_text(variant_path) }
        if (owned & 2) != 0 { print_owned_text(rendered_path) }
        if (owned & 4) != 0 { print_owned_text(request_path_owned) }
        if (owned & 8) != 0 { print_owned_text(measurement_path) }
        return PromptEvaluateStatus.CleanupFailed
      }
      PromptEvaluateStatus.EvaluationFailed
    },
  }
}

pub fn status_label(status: PromptEvaluateStatus) -> str = match status {
  Published => "PUBLISHED",
  InvalidInput => "INVALID_INPUT",
  EvaluationFailed => "EVALUATION_FAILED",
  OutputWrite => "OUTPUT_WRITE",
  CleanupFailed => "OUTPUT_PAIR_CLEANUP_FAILED",
}

pub fn status_success(status: PromptEvaluateStatus) -> bool = match status {
  Published => true,
  _ => false,
}
