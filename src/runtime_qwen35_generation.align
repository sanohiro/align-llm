module runtime_qwen35_generation

import ggml_ffi
import runtime_attention
import runtime_device
import runtime_execution
import runtime_generation
import runtime_inputs
import runtime_memory
import runtime_options
import runtime_pack_identity
import runtime_weights
import runtime_qwen35_execution
import runtime_qwen35_geometry
import runtime_qwen35_load
import runtime_qwen35_model
import runtime_qwen35_state
import runtime_qwen_load
import std.crypto
import std.encoding
import std.fs
import std.time

MAX_PROMPT := 2048
MAX_GENERATED := 4096
MAX_LOOKUP_DRAFTS := 3
NATIVE_Q6_HEAD_DEVICE_BYTES := 995584
SLOT_BYTES := 1040
MASKED := 4286578688

pub LookupTrialStats {
  lookup_attempts: i64,
  draft_hits: i64,
  verify_groups: i64,
  complete_groups: i64,
  discarded_groups: i64,
  generated_drafts: i64,
  prefill_ns: i64,
  serial_decode_ns: i64,
  lookup_ns: i64,
  graph_build_ns: i64,
  target_compute_ns: i64,
  target_readback_ns: i64,
  target_native_greedy_ns: i64,
}

pub LookupTrialResult { token_ids: array<i64>, stats: LookupTrialStats }

fn empty_lookup_stats() -> LookupTrialStats {
  return LookupTrialStats {
    lookup_attempts: 0, draft_hits: 0, verify_groups: 0,
    complete_groups: 0, discarded_groups: 0, generated_drafts: 0,
    prefill_ns: 0, serial_decode_ns: 0,
    lookup_ns: 0, graph_build_ns: 0, target_compute_ns: 0,
    target_readback_ns: 0, target_native_greedy_ns: 0,
  }
}

fn key(borrow owner: ggml_ffi.GpuDevice, borrow options: runtime_options.RuntimeOptions,
  geometry: str, kind: i64, position: i64, count: i64, width: i64,
  parity: i64, emit_logits: bool, last_ffn_row: bool,
  graph_greedy: bool) -> string {
  b := builder()
  b.write("qwen35:")
  b.write(options.backend)
  b.write(":")
  b.write(runtime_device.bundle_id(owner))
  b.write(":")
  b.write(geometry)
  b.write(":")
  b.write_int(kind)
  b.write(":")
  b.write_int(position)
  b.write(":")
  b.write_int(count)
  b.write(":")
  b.write_int(width)
  b.write(":")
  b.write_int(parity)
  b.write(":")
  b.write_int(if emit_logits { 1 } else { 0 })
  if last_ffn_row { b.write(":final-ffn-row") }
  if graph_greedy { b.write(":graph-greedy") }
  if ggml_ffi.gpu_native_state_copy_enabled(owner) { b.write(":native-state-copy") }
  if ggml_ffi.gpu_native_q6_head_enabled(owner) { b.write(":native-q6-head") }
  if ggml_ffi.gpu_native_conv_copy_enabled(owner) { b.write(":native-conv-copy") }
  if ggml_ffi.gpu_native_prefill_state_copy_enabled(owner) {
    b.write(":native-prefill-state-copy")
  }
  if ggml_ffi.gpu_native_copy_greedy_enabled(owner) { b.write(":native-copy-greedy") }
  digest := crypto.sha256(b.to_string())
  return encoding.hex_encode(digest[0..digest.len()]).clone()
}

fn lookup_target_key(borrow session: Session,
  position: i64, count: i64, width: i64, parity: i64) -> string {
  base := key(session.owner, session.options, session.geometry_text,
    ggml_ffi.GPU_GRAPH_PREFILL, position, count, width, parity, true, false, false)
  mut value := builder()
  value.write(base)
  value.write(":all-logits-rows")
  digest := crypto.sha256(value.to_string())
  return encoding.hex_encode(digest[0..digest.len()]).clone()
}

fn read_logits(borrow owner: ggml_ffi.GpuDevice, borrow slots: slice<u8>,
  borrow output: slice<u8>, label: str,
) -> Result<(), Error> {
  if ggml_ffi.gpu_native_q6_head_enabled(owner) {
    ggml_ffi.gpu_native_q6_head_read(owner, output, label) else {
      return Err(Error.Invalid)
    }
  } else {
    ggml_ffi.gpu_slot_get(owner, slots, runtime_qwen35_model.OUTPUT,
      output, 0, output.len(), label) else { return Err(Error.Invalid) }
  }
  return Ok(())
}

fn read_choice(borrow owner: ggml_ffi.GpuDevice, borrow slots: slice<u8>,
  shared_logits: bool, neon_greedy: bool, graph_greedy: bool,
  native_copy_greedy: bool, n_vocab: i64,
  borrow output: slice<u8>, label: str,
) -> Result<i64, Error> {
  if native_copy_greedy {
    ggml_ffi.gpu_native_state_copy_finish(owner) else { return Err(Error.Invalid) }
    token := ggml_ffi.gpu_native_copy_greedy_result(owner) else { return Err(Error.Invalid) }
    if token >= n_vocab { return Err(Error.Invalid) }
    return Ok(token)
  }
  if graph_greedy {
    if output.len() < 4 { return Err(Error.Invalid) }
    ggml_ffi.gpu_slot_get(owner, slots, runtime_qwen35_model.GREEDY_OUTPUT,
      output, 0, 4, label) else { return Err(Error.Invalid) }
    token := output.u32_le(0) as i64
    if token < 0 || token >= n_vocab { return Err(Error.Invalid) }
    return Ok(token)
  }
  if neon_greedy {
    token := ggml_ffi.gpu_slot_neon_greedy(owner, slots, runtime_qwen35_model.OUTPUT,
      n_vocab * 4, label) else { return Err(Error.Invalid) }
    return Ok(token)
  }
  if shared_logits {
    token := ggml_ffi.gpu_slot_shared_greedy(owner, slots, runtime_qwen35_model.OUTPUT,
      n_vocab * 4, label) else { return Err(Error.Invalid) }
    return Ok(token)
  }
  if output.len() != n_vocab * 4 { return Err(Error.Invalid) }
  read_logits(owner, slots, output, label)?
  return runtime_generation.greedy(output, -1)
}

fn contains(borrow ids: array<i64>, value: i64) -> bool {
  mut at := 0
  loop {
    if at >= ids.len() { break }
    if ids[at] == value { return true }
    at = at + 1
  }
  return false
}

fn bind_prefill(borrow owner: ggml_ffi.GpuDevice, ctx: raw, count: i64,
  width: i64, borrow slots: slice<u8>) -> Result<(), Error> {
  ggml_ffi.slots_init(slots, slots.len(), "q35_provider_prefill") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_input_slot(owner, 0, slots, runtime_qwen35_model.TOKEN) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.op_view_2d(ctx, slots, runtime_qwen35_model.TOKEN,
    runtime_qwen35_model.TOKEN, count, 1, 1, 0, 0,
    "q35_provider_token_prefix") else { return Err(Error.Invalid) }
  ggml_ffi.gpu_input_slot(owner, 1, slots, runtime_qwen35_model.POSITION) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.op_view_2d(ctx, slots, runtime_qwen35_model.POSITION,
    runtime_qwen35_model.POSITION, 4 * count, 1, 1, 0, 0,
    "q35_provider_position_prefix") else { return Err(Error.Invalid) }
  runtime_inputs.mask_prefix_slot(owner, 2, ggml_ffi.GPU_GRAPH_PREFILL,
    width, count, slots, runtime_qwen35_model.MASK)?
  return Ok(())
}

fn bind_decode(borrow owner: ggml_ffi.GpuDevice, kind: i64,
  width: i64, borrow slots: slice<u8>) -> Result<(), Error> {
  ggml_ffi.slots_init(slots, slots.len(), "q35_provider_decode") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_input_slot(owner, 3, slots, runtime_qwen35_model.TOKEN) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_input_slot(owner, 4, slots, runtime_qwen35_model.POSITION) else {
    return Err(Error.Invalid)
  }
  runtime_inputs.mask_prefix_slot(owner, 5, kind, width, 1,
    slots, runtime_qwen35_model.MASK)?
  return Ok(())
}

fn update_prefill(borrow owner: ggml_ffi.GpuDevice,
  borrow prompt: array<i64>, borrow g: runtime_qwen35_geometry.Geometry,
  position: i64, count: i64, width: i64,
  borrow mut tokens: slice<u8>, borrow mut positions: slice<u8>,
  borrow mut mask: slice<u8>) -> Result<(), Error> {
  if count < 1 || count > runtime_attention.MAX_PREFILL || position < 0 || position + count > prompt.len()
    || tokens.len() < count * 4 || positions.len() < count * 16
    || mask.len() < width * count * 4 { return Err(Error.Invalid) }
  mut at := 0
  loop {
    if at >= count { break }
    token := prompt[position + at]
    if token < 0 || token >= g.n_vocab { return Err(Error.Invalid) }
    tokens.set_u32_le(at * 4, token as u32)
    at = at + 1
  }
  token_view := tokens[0..count * 4]
  runtime_inputs.update(owner, 0, 0, token_view)?
  mut position_view := positions[0..count * 16]
  runtime_qwen35_geometry.write_text_positions(position, count, position_view)?
  runtime_inputs.update(owner, 1, 0, position_view)?
  if ggml_ffi.gpu_kv_prefill_indexed(owner) {
    mut index_storage := buffer.filled(count * 4, 0 as u8)
    mut index_bytes := index_storage.bytes()
    mut index_at := 0
    loop {
      if index_at >= count { break }
      index_bytes.set_u32_le(index_at * 4, (position + index_at) as u32)
      index_at = index_at + 1
    }
    runtime_inputs.update(owner, 7, 0, index_bytes)?
  }
  mut row := 0
  loop {
    if row >= count { break }
    mut column := 0
    loop {
      if column >= width { break }
      value := if column <= position + row { 0 } else { MASKED }
      mask.set_u32_le((row * width + column) * 4, value as u32)
      column = column + 1
    }
    row = row + 1
  }
  mask_view := mask[0..width * count * 4]
  runtime_inputs.update(owner, 2, 0, mask_view)?
  return Ok(())
}

fn update_decode(borrow owner: ggml_ffi.GpuDevice, token: i64,
  position: i64, width: i64,
  borrow mut scalar: slice<u8>, borrow mut positions: slice<u8>,
  borrow mut mask: slice<u8>) -> Result<(), Error> {
  if scalar.len() != 4 || positions.len() != 16 || mask.len() < width * 4
    || token < 0 || token > 2147483647 || position < 0 || position >= width {
    return Err(Error.Invalid)
  }
  scalar.set_u32_le(0, token as u32)
  runtime_inputs.update(owner, 3, 0, scalar)?
  runtime_qwen35_geometry.write_text_positions(position, 1, positions)?
  runtime_inputs.update(owner, 4, 0, positions)?
  mut at := 0
  loop {
    if at >= width { break }
    mask.set_u32_le(at * 4, if at <= position { 0 as u32 } else { MASKED as u32 })
    at = at + 1
  }
  mask_view := mask[0..width * 4]
  runtime_inputs.update(owner, 5, 0, mask_view)?
  scalar.set_u32_le(0, position as u32)
  runtime_inputs.update(owner, 6, 0, scalar)?
  return Ok(())
}

fn update_lookup_target(borrow owner: ggml_ffi.GpuDevice,
  borrow candidates: array<i64>, borrow g: runtime_qwen35_geometry.Geometry,
  position: i64, width: i64,
  borrow mut tokens: slice<u8>, borrow mut positions: slice<u8>,
  borrow mut mask: slice<u8>,
) -> Result<(), Error> {
  count := candidates.len()
  if (count != 2 && count != 4) || position < 0 || position + count > g.context_length
    || tokens.len() < count * 4 || positions.len() < count * 16
    || mask.len() < width * count * 4 {
    return Err(Error.Invalid)
  }
  mut row := 0
  loop {
    if row >= count { break }
    if candidates[row] < 0 || candidates[row] >= g.n_vocab { return Err(Error.Invalid) }
    tokens.set_u32_le(row * 4, candidates[row] as u32)
    mut column := 0
    loop {
      if column >= width { break }
      mask.set_u32_le((row * width + column) * 4,
        if column <= position + row { 0 as u32 } else { MASKED as u32 })
      column = column + 1
    }
    row = row + 1
  }
  token_view := tokens[0..count * 4]
  runtime_inputs.update(owner, 0, 0, token_view)?
  mut position_view := positions[0..count * 16]
  runtime_qwen35_geometry.write_text_positions(position, count, position_view)?
  runtime_inputs.update(owner, 1, 0, position_view)?
  mask_view := mask[0..width * count * 4]
  runtime_inputs.update(owner, 2, 0, mask_view)?
  return Ok(())
}

pub Session {
  owner: ggml_ffi.GpuDevice,
  options: runtime_options.RuntimeOptions,
  geometry_text: string,
  geometry: runtime_qwen35_geometry.Geometry,
  capacity: i64,
  mask_capacity: i64,
  prefill_chunk: i64,
  final_prefill_logits: bool,
  last_ffn_row: bool,
  shared_logits: bool,
  neon_greedy: bool,
  graph_greedy: bool,
  native_state_copy: bool,
  native_prefill_state_copy: bool,
  native_copy_greedy: bool,
  decode_a_slots: buffer,
  decode_b_slots: buffer,
  decode_a_key: string,
  decode_b_key: string,
  decode_a_width: i64,
  decode_b_width: i64,
  stream_scalar: buffer,
  stream_positions: buffer,
  stream_mask: buffer,
  stream_logits: buffer,
  first_request: bool,
  healthy: bool,
  stream_active: bool,
  stream_state: runtime_qwen35_state.State,
  stream_token: i64,
  stream_step: i64,
  stream_prompt_len: i64,
  stream_max_tokens: i64,
}

fn validate_request(borrow g: runtime_qwen35_geometry.Geometry,
  borrow prompt: array<i64>, borrow eog: array<i64>,
  max_tokens: i64, borrow forced: array<i64>, capacity: i64,
) -> Result<(), Error> {
  if !runtime_qwen35_geometry.valid_layer_pattern(g)
    || prompt.len() < 1 || prompt.len() > MAX_PROMPT
    || max_tokens < 1 || max_tokens > MAX_GENERATED
    || forced.len() > max_tokens - 1
    || prompt.len() + max_tokens - 1 > g.context_length
    || prompt.len() + max_tokens - 1 > 2175
    || prompt.len() + max_tokens - 1 > capacity {
    return Err(Error.Invalid)
  }
  mut at := 0
  loop {
    if at >= prompt.len() { break }
    if prompt[at] < 0 || prompt[at] >= g.n_vocab { return Err(Error.Invalid) }
    at = at + 1
  }
  at = 0
  loop {
    if at >= eog.len() { break }
    if eog[at] < 0 || eog[at] >= g.n_vocab { return Err(Error.Invalid) }
    at = at + 1
  }
  at = 0
  loop {
    if at >= forced.len() { break }
    if forced[at] < 0 || forced[at] >= g.n_vocab { return Err(Error.Invalid) }
    at = at + 1
  }
  return Ok(())
}

fn prepare(borrow owner: ggml_ffi.GpuDevice,
  borrow options: runtime_options.RuntimeOptions, pack_path: str,
  borrow identity: runtime_pack_identity.SourceIdentity,
  geometry_text: str, borrow g: runtime_qwen35_geometry.Geometry,
  probe_prompt: i64, capacity: i64, config: runtime_qwen35_execution.Config,
) -> Result<i64, Error> {
  if (options.backend != "metal" && options.backend != "cuda")
    || (config.native_q6_head && (options.backend != "cuda"
        || g.n_embd != 2048 || g.n_vocab != 248320))
    || (options.backend == "cuda" && (config.mapped_weights || config.shared_logits
        || config.neon_greedy || config.graph_greedy
        || config.native_conv_copy || config.native_prefill_state_copy
        || config.native_copy_greedy))
    || !runtime_qwen35_geometry.valid_layer_pattern(g)
    || (config.graph_greedy && (g.n_vocab < 8192
        || !ggml_ffi.gpu_ingraph_argmax_supported(owner)))
    || probe_prompt < 1 || probe_prompt > MAX_PROMPT
    || capacity < probe_prompt || capacity > g.context_length { return Err(Error.Invalid) }
  ggml_ffi.gpu_native_state_copy_select(owner, config.native_state_copy) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_native_q6_head_select(owner, config.native_q6_head) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_native_conv_copy_select(owner, config.native_conv_copy) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_native_prefill_state_copy_select(owner, config.native_prefill_state_copy) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_native_copy_greedy_select(owner, config.native_copy_greedy) else {
    return Err(Error.Invalid)
  }
  // The retained planes must cover the fixed-width decode graph's padded view.
  runtime_attention.select(owner, probe_prompt, config.prefill_chunk, capacity,
    g.context_length, g.head_dim, g.n_head, g.n_head_kv)?
  if !runtime_attention.fused(owner) { return Err(Error.Invalid) }
  ggml_ffi.gpu_attention_select(owner, 2) else { return Err(Error.Invalid) }
  pack := fs.open_rw(pack_path)?
  runtime_pack_identity.verify_file_bounded(pack, identity, 2 * g.n_layer + 2)?
  plan := runtime_qwen35_load.build_plan_file_capacity_bounded(owner, pack, g, capacity)?
  if config.mapped_weights && config.synchronous_weights { return Err(Error.Invalid) }
  storage_bytes := if config.mapped_weights { pack.len()? } else { plan.weights_bytes }
  if plan.count < 1 || plan.weights_bytes < 1 || plan.kv_bytes < 1
    || storage_bytes < plan.weights_bytes || storage_bytes > options.device_budget_bytes
    || plan.kv_bytes > options.device_budget_bytes - storage_bytes {
    return Err(Error.Invalid)
  }
  native_head_bytes := if config.native_q6_head { NATIVE_Q6_HEAD_DEVICE_BYTES } else { 0 }
  if native_head_bytes > options.device_budget_bytes - storage_bytes - plan.kv_bytes {
    return Err(Error.Invalid)
  }
  workspace := options.device_budget_bytes - storage_bytes - plan.kv_bytes
    - native_head_bytes
  if workspace < 536870912 || options.host_budget_bytes < 134217728 {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_host_reserve(owner, 33554432) else { return Err(Error.Invalid) }
  runtime_memory.admit(owner, runtime_memory.MemoryPlan {
      weights_bytes: storage_bytes, kv_bytes: plan.kv_bytes,
      workspace_bytes: workspace, metadata_bytes: 100663296,
      staging_bytes: 1048576, legacy_cache_bytes: 0,
    })?
  if config.mapped_weights {
    ggml_ffi.gpu_mapped_weights_open(owner, pack_path, storage_bytes) else {
      return Err(Error.Invalid)
    }
  }
  runtime_memory.allocate(owner)?
  if config.synchronous_weights { runtime_weights.upload_mode(owner, true)? }
  if config.mapped_weights {
    runtime_qwen_load.load_mapped(owner, plan)?
  } else {
    runtime_qwen_load.load_file(owner, pack, plan, 1048576)?
  }
  runtime_qwen35_load.define_resident(owner, g, capacity)?
  mask_capacity := runtime_inputs.attention_width(capacity, g.context_length)?
  runtime_inputs.begin(owner, 8)?
  input_token := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: config.prefill_chunk, ne1: 1, ne2: 1, ne3: 1,
    })?
  input_position := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 4 * config.prefill_chunk, ne1: 1, ne2: 1, ne3: 1,
    })?
  input_mask := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 0, n_dims: 2, ne0: mask_capacity, ne1: config.prefill_chunk, ne2: 1, ne3: 1,
    })?
  decode_token := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 1, ne1: 1, ne2: 1, ne3: 1,
    })?
  decode_position := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 4, ne1: 1, ne2: 1, ne3: 1,
    })?
  decode_mask := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 0, n_dims: 2, ne0: mask_capacity, ne1: 1, ne2: 1, ne3: 1,
    })?
  decode_index := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 1, ne1: 1, ne2: 1, ne3: 1,
    })?
  prefill_index := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: config.prefill_chunk, ne1: 1, ne2: 1, ne3: 1,
    })?
  if input_token != 0 || input_position != 1 || input_mask != 2
    || decode_token != 3 || decode_position != 4 || decode_mask != 5
    || decode_index != 6 || prefill_index != 7 { return Err(Error.Invalid) }
  runtime_inputs.finish(owner)?
  prefill_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_PREFILL, 25165824)
  decode_a_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_DECODE, 25165824)
  decode_b_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_DECODE_ALT, 25165824)
  if ggml_ffi.handle_absent(prefill_ctx) || ggml_ffi.handle_absent(decode_a_ctx)
    || ggml_ffi.handle_absent(decode_b_ctx) { return Err(Error.Invalid) }
  return Ok(mask_capacity)
}

pub fn create_session(owner: ggml_ffi.GpuDevice,
  options: runtime_options.RuntimeOptions, pack_path: str,
  borrow identity: runtime_pack_identity.SourceIdentity,
  geometry_text: string, g: runtime_qwen35_geometry.Geometry,
) -> Result<Session, Error> {
  config := runtime_qwen35_execution.read()?
  max_valid := if g.context_length < 2175 { g.context_length } else { 2175 }
  probe_prompt := if max_valid < MAX_PROMPT { max_valid } else { MAX_PROMPT }
  capacity := runtime_inputs.attention_width(max_valid, g.context_length)?
  mask_capacity := prepare(owner, options, pack_path, identity, geometry_text,
    g, probe_prompt, capacity, config)?
  return Ok(Session { owner: owner, options: options,
      geometry_text: geometry_text, geometry: g, capacity: capacity,
      mask_capacity: mask_capacity, prefill_chunk: config.prefill_chunk,
      final_prefill_logits: config.final_prefill_logits,
      last_ffn_row: config.last_ffn_row,
      shared_logits: config.shared_logits,
      neon_greedy: config.neon_greedy,
      graph_greedy: config.graph_greedy,
      native_state_copy: config.native_state_copy,
      native_prefill_state_copy: config.native_prefill_state_copy,
      native_copy_greedy: config.native_copy_greedy,
      decode_a_slots: buffer.filled(SLOT_BYTES, 0 as u8),
      decode_b_slots: buffer.filled(SLOT_BYTES, 0 as u8),
      decode_a_key: "".clone(), decode_b_key: "".clone(),
      decode_a_width: 0, decode_b_width: 0,
      stream_scalar: buffer.filled(4, 0 as u8),
      stream_positions: buffer.filled(16, 0 as u8),
      stream_mask: buffer.filled(mask_capacity * 4, 0 as u8),
      stream_logits: buffer.filled(
        if config.shared_logits || config.neon_greedy || config.graph_greedy { 4 } else { g.n_vocab * 4 }, 0 as u8),
      first_request: true, healthy: true,
      stream_active: false, stream_state: runtime_qwen35_state.new(),
      stream_token: -1, stream_step: 0, stream_prompt_len: 0, stream_max_tokens: 0,
    })
}

pub fn generate_session(borrow mut session: Session,
  borrow prompt: array<i64>, borrow eog: array<i64>, max_tokens: i64,
) -> Result<array<i64>, Error> {
  if !session.healthy { return Err(Error.Invalid) }
  mut forced: array_builder<i64> := array_builder()
  empty := forced.build()
  validate_request(session.geometry, prompt, eog, max_tokens, empty, session.capacity)?
  session.healthy = false
  if !session.first_request {
    runtime_qwen35_load.zero_resident(session.owner, session.geometry, session.capacity)?
  }
  session.first_request = false
  mut unused := empty_lookup_stats()
  ids := execute(session, prompt, eog, max_tokens, empty, 0, false, unused)?
  session.healthy = true
  return Ok(ids)
}

pub fn generate_session_lookup_trial(borrow mut session: Session,
  borrow prompt: array<i64>, borrow eog: array<i64>, max_tokens: i64,
) -> Result<LookupTrialResult, Error> {
  return generate_lookup_with_drafts(session, prompt, eog, max_tokens, MAX_LOOKUP_DRAFTS, false)
}

pub fn generate_session_lookup_trial_one(borrow mut session: Session,
  borrow prompt: array<i64>, borrow eog: array<i64>, max_tokens: i64,
) -> Result<LookupTrialResult, Error> {
  return generate_lookup_with_drafts(session, prompt, eog, max_tokens, 1, false)
}

pub fn generate_session_lookup_trial_native_greedy(borrow mut session: Session,
  borrow prompt: array<i64>, borrow eog: array<i64>, max_tokens: i64,
) -> Result<LookupTrialResult, Error> {
  return generate_lookup_with_drafts(session, prompt, eog, max_tokens, MAX_LOOKUP_DRAFTS, true)
}

fn generate_lookup_with_drafts(borrow mut session: Session,
  borrow prompt: array<i64>, borrow eog: array<i64>, max_tokens: i64,
  draft_count: i64, native_target_greedy: bool,
) -> Result<LookupTrialResult, Error> {
  if !session.healthy || session.options.backend != "metal" { return Err(Error.Invalid) }
  if draft_count != 1 && draft_count != MAX_LOOKUP_DRAFTS { return Err(Error.Invalid) }
  if native_target_greedy && (!session.native_state_copy
      || draft_count != MAX_LOOKUP_DRAFTS) { return Err(Error.Invalid) }
  mut forced: array_builder<i64> := array_builder()
  empty := forced.build()
  validate_request(session.geometry, prompt, eog, max_tokens, empty, session.capacity)?
  session.healthy = false
  if !session.first_request {
    runtime_qwen35_load.zero_resident(session.owner, session.geometry, session.capacity)?
  }
  session.first_request = false
  mut stats := empty_lookup_stats()
  ids := execute(session, prompt, eog, max_tokens, empty, draft_count,
    native_target_greedy, stats)?
  session.healthy = true
  return Ok(LookupTrialResult { token_ids: ids, stats: stats })
}

fn execute(borrow mut session: Session,
  borrow prompt: array<i64>, borrow eog: array<i64>,
  max_tokens: i64, borrow forced: array<i64>, lookup_drafts: i64,
  native_target_greedy: bool,
  borrow mut stats: LookupTrialStats,
) -> Result<array<i64>, Error> {
  mut prefill_storage := buffer.filled(SLOT_BYTES, 0 as u8)
  mut prefill_slots := prefill_storage.bytes()
  mut decode_a_slots := session.decode_a_slots.bytes()
  mut decode_b_slots := session.decode_b_slots.bytes()
  mut token_storage := buffer.filled(session.prefill_chunk * 4, 0 as u8)
  mut position_storage := buffer.filled(session.prefill_chunk * 16, 0 as u8)
  mut mask_storage := buffer.filled(session.mask_capacity * session.prefill_chunk * 4, 0 as u8)
  mut token_bytes := token_storage.bytes()
  mut position_bytes := position_storage.bytes()
  mut mask_bytes := mask_storage.bytes()
  mut logits_storage := buffer.filled(
    if session.shared_logits || session.neon_greedy || session.graph_greedy { 4 } else { session.geometry.n_vocab * 4 }, 0 as u8)
  mut logits := logits_storage.bytes()
  mut state := runtime_qwen35_state.new()
  mut prefill_key := "".clone()
  mut offset := 0
  mut token := -1
  prefill_started := time.instant()
  loop {
    if offset >= prompt.len() { break }
    count := if prompt.len() - offset < session.prefill_chunk { prompt.len() - offset } else { session.prefill_chunk }
    width := runtime_inputs.attention_width(offset + count, session.geometry.context_length)?
    if prefill_key.len() > 0 {
      runtime_execution.invalidate(session.owner, ggml_ffi.GPU_GRAPH_PREFILL)?
    }
    ctx := ggml_ffi.gpu_graph_context_lookup(session.owner, ggml_ffi.GPU_GRAPH_PREFILL)
    if ggml_ffi.handle_absent(ctx) { return Err(Error.Invalid) }
    graph := ggml_ffi.graph_new(ctx)
    if ggml_ffi.handle_absent(graph) { return Err(Error.Invalid) }
    bind_prefill(session.owner, ctx, count, width, prefill_slots)?
    emit_logits := !session.final_prefill_logits || offset + count == prompt.len()
    final_row := session.last_ffn_row && emit_logits && count > 1
      && offset + count == prompt.len()
    runtime_qwen35_model.build_tokens_final_row_greedy(session.owner, session.geometry, state,
      offset, count, ggml_ffi.GPU_GRAPH_PREFILL, 7, ctx, graph, prefill_slots,
      emit_logits, final_row, session.graph_greedy && emit_logits)?
    prefill_key = key(session.owner, session.options, session.geometry_text,
      ggml_ffi.GPU_GRAPH_PREFILL, offset, count, width, state.active, emit_logits, final_row,
      session.graph_greedy && emit_logits)
    runtime_execution.prepare(session.owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_key, graph)?
    update_prefill(session.owner, prompt, session.geometry, offset, count, width,
      token_bytes, position_bytes, mask_bytes)?
    runtime_execution.compute(session.owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_key, graph)?
    if emit_logits {
      if offset + count == prompt.len() {
        token = read_choice(session.owner, prefill_slots, session.shared_logits,
          session.neon_greedy, session.graph_greedy, false,
          session.geometry.n_vocab, logits, "q35_provider_prefill_logits")?
      } else if !session.shared_logits && !session.neon_greedy && !session.graph_greedy {
        // Preserve the copied path's intermediate readback without sampling it.
        read_logits(session.owner, prefill_slots, logits, "q35_provider_prefill_logits")?
      }
    }
    if session.native_prefill_state_copy {
      ggml_ffi.gpu_native_state_copy_finish(session.owner) else { return Err(Error.Invalid) }
    }
    runtime_qwen35_state.finish(state, true)
    offset = offset + count
  }
  if token < 0 { return Err(Error.Invalid) }
  if lookup_drafts > 0 {
    stats.prefill_ns = time.instant() - prefill_started
    return execute_lookup_tail(session, prompt, eog, max_tokens,
      token, state, stats, lookup_drafts, native_target_greedy)
  }
  mut generated: array_builder<i64> := array_builder()
  generated.push(token)
  mut scalar_storage := buffer.filled(4, 0 as u8)
  mut decode_position_storage := buffer.filled(16, 0 as u8)
  mut decode_mask_storage := buffer.filled(session.mask_capacity * 4, 0 as u8)
  mut scalar := scalar_storage.bytes()
  mut decode_positions := decode_position_storage.bytes()
  mut decode_mask_bytes := decode_mask_storage.bytes()
  mut step := 1
  loop {
    if step >= max_tokens || (forced.len() == 0 && contains(eog, token)) { break }
    position := prompt.len() + step - 1
    width := runtime_inputs.attention_width(position + 1, session.geometry.context_length)?
    kind := if state.active == 1 {
      ggml_ffi.GPU_GRAPH_DECODE
    } else { ggml_ffi.GPU_GRAPH_DECODE_ALT }
    if kind == ggml_ffi.GPU_GRAPH_DECODE {
      if session.decode_a_key.len() == 0 || session.decode_a_width != width {
        current_key := key(session.owner, session.options, session.geometry_text,
          kind, width - 1, 1, width, state.active, true, false, session.graph_greedy)
        if session.decode_a_key.len() > 0 { runtime_execution.invalidate(session.owner, kind)? }
        ctx := ggml_ffi.gpu_graph_context_lookup(session.owner, kind)
        if ggml_ffi.handle_absent(ctx) { return Err(Error.Invalid) }
        created := ggml_ffi.graph_new(ctx)
        if ggml_ffi.handle_absent(created) { return Err(Error.Invalid) }
        bind_decode(session.owner, kind, width, decode_a_slots)?
        runtime_qwen35_model.build_one_token_greedy(session.owner, session.geometry, state,
          width - 1, kind, 6, ctx, created, decode_a_slots, session.graph_greedy)?
        runtime_execution.prepare(session.owner, kind, current_key, created)?
        session.decode_a_key = current_key.clone()
        session.decode_a_width = width
      }
    } else {
      if session.decode_b_key.len() == 0 || session.decode_b_width != width {
        current_key := key(session.owner, session.options, session.geometry_text,
          kind, width - 1, 1, width, state.active, true, false, session.graph_greedy)
        if session.decode_b_key.len() > 0 { runtime_execution.invalidate(session.owner, kind)? }
        ctx := ggml_ffi.gpu_graph_context_lookup(session.owner, kind)
        if ggml_ffi.handle_absent(ctx) { return Err(Error.Invalid) }
        created := ggml_ffi.graph_new(ctx)
        if ggml_ffi.handle_absent(created) { return Err(Error.Invalid) }
        bind_decode(session.owner, kind, width, decode_b_slots)?
        runtime_qwen35_model.build_one_token_greedy(session.owner, session.geometry, state,
          width - 1, kind, 6, ctx, created, decode_b_slots, session.graph_greedy)?
        runtime_execution.prepare(session.owner, kind, current_key, created)?
        session.decode_b_key = current_key.clone()
        session.decode_b_width = width
      }
    }
    current_key: str := if kind == ggml_ffi.GPU_GRAPH_DECODE {
      session.decode_a_key
    } else { session.decode_b_key }
    decode_input_token := if forced.len() > 0 { forced[step - 1] } else { token }
    update_decode(session.owner, decode_input_token, position, width,
      scalar, decode_positions, decode_mask_bytes)?
    active_graph := ggml_ffi.gpu_graph_lookup(session.owner, kind, current_key)
    if ggml_ffi.handle_absent(active_graph) { return Err(Error.Invalid) }
    runtime_execution.compute(session.owner, kind, current_key, active_graph)?
    token = if kind == ggml_ffi.GPU_GRAPH_DECODE {
      read_choice(session.owner, decode_a_slots, session.shared_logits,
        session.neon_greedy, session.graph_greedy, session.native_copy_greedy,
        session.geometry.n_vocab, logits, "q35_provider_decode_logits")?
    } else {
      read_choice(session.owner, decode_b_slots, session.shared_logits,
        session.neon_greedy, session.graph_greedy, session.native_copy_greedy,
        session.geometry.n_vocab, logits, "q35_provider_decode_logits")?
    }
    if session.native_state_copy && !session.native_copy_greedy {
      ggml_ffi.gpu_native_state_copy_finish(session.owner) else { return Err(Error.Invalid) }
    }
    runtime_qwen35_state.finish(state, true)
    generated.push(token)
    step = step + 1
  }
  runtime_device.synchronize(session.owner)?
  runtime_execution.invalidate(session.owner, ggml_ffi.GPU_GRAPH_PREFILL)?
  return Ok(generated.build())
}

fn append_history(borrow history: array<i64>, borrow additions: array<i64>) -> array<i64> {
  mut next: array_builder<i64> := array_builder(history.len() + additions.len())
  mut at := 0
  loop {
    if at >= history.len() { break }
    next.push(history[at])
    at = at + 1
  }
  at = 0
  loop {
    if at >= additions.len() { break }
    next.push(additions[at])
    at = at + 1
  }
  return next.build()
}

fn execute_lookup_tail(borrow mut session: Session,
  borrow prompt: array<i64>, borrow eog: array<i64>, max_tokens: i64,
  token_start: i64, borrow mut state: runtime_qwen35_state.State,
  borrow mut stats: LookupTrialStats, draft_count: i64, native_target_greedy: bool,
) -> Result<array<i64>, Error> {
  target_count := draft_count + 1
  mut token := token_start
  mut generated: array_builder<i64> := array_builder()
  generated.push(token)
  mut first: array_builder<i64> := array_builder()
  first.push(token)
  first_ids := first.build()
  mut history := append_history(prompt, first_ids)
  mut scalar_storage := buffer.filled(4, 0 as u8)
  mut decode_position_storage := buffer.filled(16, 0 as u8)
  mut decode_mask_storage := buffer.filled(session.mask_capacity * 4, 0 as u8)
  mut scalar := scalar_storage.bytes()
  mut decode_positions := decode_position_storage.bytes()
  mut decode_mask_bytes := decode_mask_storage.bytes()
  mut decode_a_slots := session.decode_a_slots.bytes()
  mut decode_b_slots := session.decode_b_slots.bytes()
  mut logits_storage := buffer.filled(
    if session.shared_logits || session.neon_greedy || session.graph_greedy {
      4
    } else { session.geometry.n_vocab * 4 }, 0 as u8)
  mut logits := logits_storage.bytes()
  mut target_slot_storage := buffer.filled(SLOT_BYTES, 0 as u8)
  mut target_slots := target_slot_storage.bytes()
  mut target_token_storage := buffer.filled(target_count * 4, 0 as u8)
  mut target_tokens := target_token_storage.bytes()
  mut target_position_storage := buffer.filled(target_count * 16, 0 as u8)
  mut target_positions := target_position_storage.bytes()
  mut target_mask_storage := buffer.filled(session.mask_capacity * target_count * 4, 0 as u8)
  mut target_mask := target_mask_storage.bytes()
  target_result_bytes := if native_target_greedy { target_count * 4 } else {
    target_count * session.geometry.n_vocab * 4
  }
  mut target_logits_storage := buffer.filled(target_result_bytes, 0 as u8)
  mut target_logits := target_logits_storage.bytes()
  mut step := 1
  mut stopped := false
  loop {
    if step >= max_tokens || contains(eog, token) { break }
    position := prompt.len() + step - 1
    mut complete := false
    if !stopped && max_tokens - step >= target_count
      && position + target_count <= session.capacity {
      stats.lookup_attempts = stats.lookup_attempts + 1
      lookup_started := time.instant()
      mut draft_builder: array_builder<i64> := array_builder(draft_count)
      mut found := runtime_generation.prompt_lookup_draft(
        history, 3, draft_count, draft_builder)
      if found == 0 {
        found = runtime_generation.prompt_lookup_draft(
          history, 2, draft_count, draft_builder)
      }
      stats.lookup_ns = stats.lookup_ns + time.instant() - lookup_started
      draft := draft_builder.build()
      if found == draft_count {
        stats.draft_hits = stats.draft_hits + 1
        mut has_eog := false
        mut at := 0
        loop {
          if at >= draft_count { break }
          if contains(eog, draft[at]) { has_eog = true }
          at = at + 1
        }
        if !has_eog {
          stats.verify_groups = stats.verify_groups + 1
          mut candidate_builder: array_builder<i64> := array_builder(target_count)
          candidate_builder.push(token)
          at = 0
          loop {
            if at >= draft_count { break }
            candidate_builder.push(draft[at])
            at = at + 1
          }
          candidates := candidate_builder.build()
          width := runtime_inputs.attention_width(position + target_count,
            session.geometry.context_length)?
          update_lookup_target(session.owner, candidates, session.geometry,
            position, width, target_tokens, target_positions, target_mask)?
          build_started := time.instant()
          runtime_execution.invalidate(session.owner, ggml_ffi.GPU_GRAPH_PREFILL)?
          ctx := ggml_ffi.gpu_graph_context_lookup(session.owner,
            ggml_ffi.GPU_GRAPH_PREFILL)
          if ggml_ffi.handle_absent(ctx) { return Err(Error.Invalid) }
          target_graph := ggml_ffi.graph_new(ctx)
          if ggml_ffi.handle_absent(target_graph) { return Err(Error.Invalid) }
          bind_prefill(session.owner, ctx, target_count, width, target_slots)?
          runtime_qwen35_model.build_tokens_all_logits(session.owner,
            session.geometry, state, position, target_count, 6, ctx, target_graph, target_slots)?
          target_key := lookup_target_key(session, position, target_count, width, state.active)
          runtime_execution.prepare(session.owner, ggml_ffi.GPU_GRAPH_PREFILL,
            target_key, target_graph)?
          stats.graph_build_ns = stats.graph_build_ns + time.instant() - build_started
          before := state.active
          compute_started := time.instant()
          runtime_execution.compute(session.owner, ggml_ffi.GPU_GRAPH_PREFILL,
            target_key, target_graph)?
          stats.target_compute_ns = stats.target_compute_ns + time.instant() - compute_started
          read_started := time.instant()
          if native_target_greedy {
            if session.native_prefill_state_copy {
              ggml_ffi.gpu_native_state_copy_finish(session.owner) else {
                return Err(Error.Invalid)
              }
            }
            ggml_ffi.gpu_slot_native_target_greedy(session.owner, target_slots,
              runtime_qwen35_model.OUTPUT, target_count, session.geometry.n_vocab,
              target_logits, "q35_lookup_target_native_greedy") else {
              return Err(Error.Invalid)
            }
            stats.target_native_greedy_ns = stats.target_native_greedy_ns
              + time.instant() - read_started
          } else {
            read_logits(session.owner, target_slots, target_logits,
              "q35_lookup_target_logits")?
            if session.native_prefill_state_copy {
              ggml_ffi.gpu_native_state_copy_finish(session.owner) else {
                return Err(Error.Invalid)
              }
            }
            stats.target_readback_ns = stats.target_readback_ns + time.instant() - read_started
          }
          runtime_qwen35_state.finish(state, true)
          row_bytes := session.geometry.n_vocab * 4
          mut accepted := 0
          loop {
            if accepted >= draft_count { break }
            choice: i64 := if native_target_greedy {
              target_logits.u32_le(accepted * 4) as i64
            } else {
              row := target_logits[accepted * row_bytes..(accepted + 1) * row_bytes]
              runtime_generation.greedy(row, -1)?
            }
            if choice != draft[accepted] { break }
            accepted = accepted + 1
          }
          if accepted == draft_count {
            bonus: i64 := if native_target_greedy {
              target_logits.u32_le(draft_count * 4) as i64
            } else {
              bonus_row := target_logits[draft_count * row_bytes..target_count * row_bytes]
              runtime_generation.greedy(bonus_row, -1)?
            }
            if bonus < 0 || bonus >= session.geometry.n_vocab { return Err(Error.Invalid) }
            mut additions: array_builder<i64> := array_builder(target_count)
            at = 0
            loop {
              if at >= draft_count { break }
              generated.push(draft[at])
              additions.push(draft[at])
              at = at + 1
            }
            generated.push(bonus)
            additions.push(bonus)
            added_ids := additions.build()
            history = append_history(history, added_ids)
            token = bonus
            step = step + target_count
            stats.complete_groups = stats.complete_groups + 1
            stats.generated_drafts = stats.generated_drafts + draft_count
            complete = true
          } else {
            state.active = before
            stopped = true
            stats.discarded_groups = stats.discarded_groups + 1
          }
        }
      }
    }
    if !complete {
      decode_started := time.instant()
      width := runtime_inputs.attention_width(position + 1, session.geometry.context_length)?
      kind := if state.active == 1 {
        ggml_ffi.GPU_GRAPH_DECODE
      } else { ggml_ffi.GPU_GRAPH_DECODE_ALT }
      if kind == ggml_ffi.GPU_GRAPH_DECODE {
        if session.decode_a_key.len() == 0 || session.decode_a_width != width {
          current_key := key(session.owner, session.options, session.geometry_text,
            kind, width - 1, 1, width, state.active, true, false, session.graph_greedy)
          if session.decode_a_key.len() > 0 { runtime_execution.invalidate(session.owner, kind)? }
          ctx := ggml_ffi.gpu_graph_context_lookup(session.owner, kind)
          if ggml_ffi.handle_absent(ctx) { return Err(Error.Invalid) }
          created := ggml_ffi.graph_new(ctx)
          if ggml_ffi.handle_absent(created) { return Err(Error.Invalid) }
          bind_decode(session.owner, kind, width, decode_a_slots)?
          runtime_qwen35_model.build_one_token_greedy(session.owner, session.geometry, state,
            width - 1, kind, 6, ctx, created, decode_a_slots, session.graph_greedy)?
          runtime_execution.prepare(session.owner, kind, current_key, created)?
          session.decode_a_key = current_key.clone()
          session.decode_a_width = width
        }
      } else {
        if session.decode_b_key.len() == 0 || session.decode_b_width != width {
          current_key := key(session.owner, session.options, session.geometry_text,
            kind, width - 1, 1, width, state.active, true, false, session.graph_greedy)
          if session.decode_b_key.len() > 0 { runtime_execution.invalidate(session.owner, kind)? }
          ctx := ggml_ffi.gpu_graph_context_lookup(session.owner, kind)
          if ggml_ffi.handle_absent(ctx) { return Err(Error.Invalid) }
          created := ggml_ffi.graph_new(ctx)
          if ggml_ffi.handle_absent(created) { return Err(Error.Invalid) }
          bind_decode(session.owner, kind, width, decode_b_slots)?
          runtime_qwen35_model.build_one_token_greedy(session.owner, session.geometry, state,
            width - 1, kind, 6, ctx, created, decode_b_slots, session.graph_greedy)?
          runtime_execution.prepare(session.owner, kind, current_key, created)?
          session.decode_b_key = current_key.clone()
          session.decode_b_width = width
        }
      }
      current_key: str := if kind == ggml_ffi.GPU_GRAPH_DECODE {
        session.decode_a_key
      } else { session.decode_b_key }
      update_decode(session.owner, token, position, width,
        scalar, decode_positions, decode_mask_bytes)?
      active_graph := ggml_ffi.gpu_graph_lookup(session.owner, kind, current_key)
      if ggml_ffi.handle_absent(active_graph) { return Err(Error.Invalid) }
      runtime_execution.compute(session.owner, kind, current_key, active_graph)?
      token = if kind == ggml_ffi.GPU_GRAPH_DECODE {
        read_choice(session.owner, decode_a_slots, session.shared_logits,
          session.neon_greedy, session.graph_greedy, session.native_copy_greedy,
          session.geometry.n_vocab, logits, "q35_lookup_decode_logits")?
      } else {
        read_choice(session.owner, decode_b_slots, session.shared_logits,
          session.neon_greedy, session.graph_greedy, session.native_copy_greedy,
          session.geometry.n_vocab, logits, "q35_lookup_decode_logits")?
      }
      if session.native_state_copy && !session.native_copy_greedy {
        ggml_ffi.gpu_native_state_copy_finish(session.owner) else { return Err(Error.Invalid) }
      }
      runtime_qwen35_state.finish(state, true)
      generated.push(token)
      mut one: array_builder<i64> := array_builder(1)
      one.push(token)
      added_id := one.build()
      history = append_history(history, added_id)
      step = step + 1
      stats.serial_decode_ns = stats.serial_decode_ns + time.instant() - decode_started
    }
  }
  runtime_device.synchronize(session.owner)?
  runtime_execution.invalidate(session.owner, ggml_ffi.GPU_GRAPH_PREFILL)?
  return Ok(generated.build())
}

pub fn begin_stream(borrow mut session: Session,
  borrow prompt: array<i64>, borrow eog: array<i64>, max_tokens: i64,
) -> Result<i64, Error> {
  if !session.healthy { return Err(Error.Invalid) }
  mut forced: array_builder<i64> := array_builder()
  empty := forced.build()
  validate_request(session.geometry, prompt, eog, max_tokens, empty, session.capacity)?
  session.healthy = false
  if !session.first_request {
    runtime_qwen35_load.zero_resident(session.owner, session.geometry, session.capacity)?
  }
  session.first_request = false
  mut prefill_storage := buffer.filled(SLOT_BYTES, 0 as u8)
  mut prefill_slots := prefill_storage.bytes()
  mut token_storage := buffer.filled(session.prefill_chunk * 4, 0 as u8)
  mut position_storage := buffer.filled(session.prefill_chunk * 16, 0 as u8)
  mut mask_storage := buffer.filled(session.mask_capacity * session.prefill_chunk * 4, 0 as u8)
  mut token_bytes := token_storage.bytes()
  mut position_bytes := position_storage.bytes()
  mut mask_bytes := mask_storage.bytes()
  mut logits_storage := buffer.filled(
    if session.shared_logits || session.neon_greedy || session.graph_greedy { 4 } else { session.geometry.n_vocab * 4 }, 0 as u8)
  mut logits := logits_storage.bytes()
  mut state := runtime_qwen35_state.new()
  mut prefill_key := "".clone()
  mut offset := 0
  mut token := -1
  loop {
    if offset >= prompt.len() { break }
    count := if prompt.len() - offset < session.prefill_chunk { prompt.len() - offset } else { session.prefill_chunk }
    width := runtime_inputs.attention_width(offset + count, session.geometry.context_length)?
    if prefill_key.len() > 0 {
      runtime_execution.invalidate(session.owner, ggml_ffi.GPU_GRAPH_PREFILL)?
    }
    ctx := ggml_ffi.gpu_graph_context_lookup(session.owner, ggml_ffi.GPU_GRAPH_PREFILL)
    if ggml_ffi.handle_absent(ctx) { return Err(Error.Invalid) }
    graph := ggml_ffi.graph_new(ctx)
    if ggml_ffi.handle_absent(graph) { return Err(Error.Invalid) }
    bind_prefill(session.owner, ctx, count, width, prefill_slots)?
    emit_logits := !session.final_prefill_logits || offset + count == prompt.len()
    final_row := session.last_ffn_row && emit_logits && count > 1
      && offset + count == prompt.len()
    runtime_qwen35_model.build_tokens_final_row_greedy(session.owner, session.geometry, state,
      offset, count, ggml_ffi.GPU_GRAPH_PREFILL, 7, ctx, graph, prefill_slots,
      emit_logits, final_row, session.graph_greedy && emit_logits)?
    prefill_key = key(session.owner, session.options, session.geometry_text,
      ggml_ffi.GPU_GRAPH_PREFILL, offset, count, width, state.active, emit_logits, final_row,
      session.graph_greedy && emit_logits)
    runtime_execution.prepare(session.owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_key, graph)?
    update_prefill(session.owner, prompt, session.geometry, offset, count, width,
      token_bytes, position_bytes, mask_bytes)?
    runtime_execution.compute(session.owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_key, graph)?
    if emit_logits {
      if offset + count == prompt.len() {
        token = read_choice(session.owner, prefill_slots, session.shared_logits,
          session.neon_greedy, session.graph_greedy, false,
          session.geometry.n_vocab, logits, "q35_provider_prefill_logits")?
      } else if !session.shared_logits && !session.neon_greedy && !session.graph_greedy {
        // Preserve the copied path's intermediate readback without sampling it.
        read_logits(session.owner, prefill_slots, logits, "q35_provider_prefill_logits")?
      }
    }
    if session.native_prefill_state_copy {
      ggml_ffi.gpu_native_state_copy_finish(session.owner) else { return Err(Error.Invalid) }
    }
    runtime_qwen35_state.finish(state, true)
    offset = offset + count
  }
  session.stream_state = state
  if token < 0 { return Err(Error.Invalid) }
  session.stream_token = token
  session.stream_step = 1
  session.stream_prompt_len = prompt.len()
  session.stream_max_tokens = max_tokens
  session.stream_active = true
  return Ok(session.stream_token)
}

pub fn stream_next(borrow mut session: Session) -> Result<Option<i64>, Error> {
  if !session.stream_active || session.healthy { return Err(Error.Invalid) }
  if session.stream_step >= session.stream_max_tokens { return Ok(None) }
  position := session.stream_prompt_len + session.stream_step - 1
  width := runtime_inputs.attention_width(position + 1, session.geometry.context_length)?
  kind := if session.stream_state.active == 1 {
    ggml_ffi.GPU_GRAPH_DECODE
  } else { ggml_ffi.GPU_GRAPH_DECODE_ALT }
  mut decode_a_slots := session.decode_a_slots.bytes()
  mut decode_b_slots := session.decode_b_slots.bytes()
  if kind == ggml_ffi.GPU_GRAPH_DECODE {
    if session.decode_a_key.len() == 0 || session.decode_a_width != width {
      current_key := key(session.owner, session.options, session.geometry_text,
        kind, width - 1, 1, width, session.stream_state.active, true, false,
        session.graph_greedy)
      if session.decode_a_key.len() > 0 { runtime_execution.invalidate(session.owner, kind)? }
      ctx := ggml_ffi.gpu_graph_context_lookup(session.owner, kind)
      if ggml_ffi.handle_absent(ctx) { return Err(Error.Invalid) }
      created := ggml_ffi.graph_new(ctx)
      if ggml_ffi.handle_absent(created) { return Err(Error.Invalid) }
      bind_decode(session.owner, kind, width, decode_a_slots)?
      runtime_qwen35_model.build_one_token_greedy(session.owner, session.geometry,
        session.stream_state, width - 1, kind, 6, ctx, created, decode_a_slots,
        session.graph_greedy)?
      runtime_execution.prepare(session.owner, kind, current_key, created)?
      session.decode_a_key = current_key.clone()
      session.decode_a_width = width
    }
  } else {
    if session.decode_b_key.len() == 0 || session.decode_b_width != width {
      current_key := key(session.owner, session.options, session.geometry_text,
        kind, width - 1, 1, width, session.stream_state.active, true, false,
        session.graph_greedy)
      if session.decode_b_key.len() > 0 { runtime_execution.invalidate(session.owner, kind)? }
      ctx := ggml_ffi.gpu_graph_context_lookup(session.owner, kind)
      if ggml_ffi.handle_absent(ctx) { return Err(Error.Invalid) }
      created := ggml_ffi.graph_new(ctx)
      if ggml_ffi.handle_absent(created) { return Err(Error.Invalid) }
      bind_decode(session.owner, kind, width, decode_b_slots)?
      runtime_qwen35_model.build_one_token_greedy(session.owner, session.geometry,
        session.stream_state, width - 1, kind, 6, ctx, created, decode_b_slots,
        session.graph_greedy)?
      runtime_execution.prepare(session.owner, kind, current_key, created)?
      session.decode_b_key = current_key.clone()
      session.decode_b_width = width
    }
  }
  // Write positions before borrowing other session fields: a mutable view call
  // conservatively invalidates sibling views at the pinned compiler.
  mut positions := session.stream_positions.bytes()
  runtime_qwen35_geometry.write_text_positions(position, 1, positions)?
  mut scalar := session.stream_scalar.bytes()
  mut mask := session.stream_mask.bytes()
  if session.stream_token < 0 || session.stream_token > 2147483647
    || position < 0 || position >= width || mask.len() < width * 4 {
    return Err(Error.Invalid)
  }
  scalar.set_u32_le(0, session.stream_token as u32)
  runtime_inputs.update(session.owner, 3, 0, scalar)?
  positions_view := session.stream_positions.bytes()
  runtime_inputs.update(session.owner, 4, 0, positions_view)?
  mut at := 0
  loop {
    if at >= width { break }
    mask.set_u32_le(at * 4, if at <= position { 0 as u32 } else { MASKED as u32 })
    at = at + 1
  }
  mask_view := mask[0..width * 4]
  runtime_inputs.update(session.owner, 5, 0, mask_view)?
  scalar.set_u32_le(0, position as u32)
  runtime_inputs.update(session.owner, 6, 0, scalar)?
  current_key: str := if kind == ggml_ffi.GPU_GRAPH_DECODE {
    session.decode_a_key
  } else { session.decode_b_key }
  active_graph := ggml_ffi.gpu_graph_lookup(session.owner, kind, current_key)
  if ggml_ffi.handle_absent(active_graph) { return Err(Error.Invalid) }
  runtime_execution.compute(session.owner, kind, current_key, active_graph)?
  mut logits := session.stream_logits.bytes()
  current_a_slots := session.decode_a_slots.bytes()
  current_b_slots := session.decode_b_slots.bytes()
  session.stream_token = if kind == ggml_ffi.GPU_GRAPH_DECODE {
    read_choice(session.owner, current_a_slots, session.shared_logits,
      session.neon_greedy, session.graph_greedy, session.native_copy_greedy,
      session.geometry.n_vocab, logits, "q35_provider_decode_logits")?
  } else {
    read_choice(session.owner, current_b_slots, session.shared_logits,
      session.neon_greedy, session.graph_greedy, session.native_copy_greedy,
      session.geometry.n_vocab, logits, "q35_provider_decode_logits")?
  }
  if session.native_state_copy && !session.native_copy_greedy {
    ggml_ffi.gpu_native_state_copy_finish(session.owner) else { return Err(Error.Invalid) }
  }
  runtime_qwen35_state.finish(session.stream_state, true)
  session.stream_step = session.stream_step + 1
  return Ok(Some(session.stream_token))
}

pub fn stream_finish(borrow mut session: Session) -> Result<(), Error> {
  if !session.stream_active || session.healthy { return Err(Error.Invalid) }
  session.stream_active = false
  runtime_device.synchronize(session.owner)?
  runtime_execution.invalidate(session.owner, ggml_ffi.GPU_GRAPH_PREFILL)?
  session.healthy = true
  return Ok(())
}

pub fn recover_failed_request(borrow mut session: Session) -> Result<(), Error> {
  // A failed graph may still own queued work. Clear it before admitting a new request.
  runtime_device.synchronize(session.owner)?
  runtime_execution.invalidate(session.owner, ggml_ffi.GPU_GRAPH_PREFILL)?
  if session.decode_a_key.len() > 0 {
    runtime_execution.invalidate(session.owner, ggml_ffi.GPU_GRAPH_DECODE)?
    session.decode_a_key = "".clone()
  }
  if session.decode_b_key.len() > 0 {
    runtime_execution.invalidate(session.owner, ggml_ffi.GPU_GRAPH_DECODE_ALT)?
    session.decode_b_key = "".clone()
  }
  runtime_qwen35_load.zero_resident(session.owner, session.geometry, session.capacity)?
  session.stream_active = false
  session.healthy = true
  session.first_request = false
  return Ok(())
}
