module prompt_artifact_io_smoke

import prompt_artifact_io

pub fn main(args: array<str>) -> Result<(), Error> {
  if args.len() == 4 && args[1] == "activation-valid" {
    source := prompt_artifact_io.read_prompt_activation_result_source(args[2], args[3])
    match source.status {
      Loaded => {},
      _ => { return Err(Error.Invalid) },
    }
    activation_value := prompt_artifact_io.decode_prompt_activation_result_source(source.source)?
    if activation_value.schema_version != 1 {
      return Err(Error.Invalid)
    }
    return Ok(())
  }
  if args.len() != 2 {
    return Err(Error.Invalid)
  }
  variant_value := prompt_artifact_io.load_prompt_variant(args[1])?
  encoded := prompt_artifact_io.encode_prompt_variant(variant_value)?
  print(encoded)
  return Ok(())
}
