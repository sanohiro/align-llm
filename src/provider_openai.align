module provider_openai

import core.json
import model
import provider_http

OpenAIMessage {
  role: str,
  content: str,
}

OpenAIRequest {
  model: str,
  messages: array<OpenAIMessage>,
  max_tokens: i64,
  temperature: f64,
  stream: bool,
}

// The seeded twin of OpenAIRequest: exactly one additional field. Declaring the seed as its own
// record keeps unseeded request bytes byte-identical to the pre-seed encoding, and its existence
// is what makes `supports_seed` true for the OpenAI-compatible adapter kinds.
OpenAISeededRequest {
  model: str,
  messages: array<OpenAIMessage>,
  max_tokens: i64,
  temperature: f64,
  stream: bool,
  seed: i64,
}

OpenAIChoice { message: OpenAIMessage }
OpenAIResponse { choices: array<OpenAIChoice> }

StreamParsed { ok: bool, text: string }

pub fn generate(config: model.ProviderConfig, request: model.GenerationRequest) -> Result<string, Error> {
  validate_request_config(config)?
  body := request_bytes(config.model, request, false)
  response := provider_http.post_json(
    config.endpoint,
    config.api_key,
    body,
    config.timeout_ns,
    config.max_response_bytes,
  )?
  response_view: str := response
  return decode_content(response_view)
}

pub fn stream(config: model.ProviderConfig, request: model.GenerationRequest) -> Result<string, Error> {
  validate_request_config(config)?
  body := request_bytes(config.model, request, true)
  response := provider_http.post_json(
    config.endpoint,
    config.api_key,
    body,
    config.timeout_ns,
    config.max_response_bytes,
  )?
  response_view: str := response
  parsed := parse_stream(response_view)
  if !parsed.ok {
    return Err(Error.Invalid)
  }
  text := parsed.text.clone()
  return Ok(text)
}

pub fn count_tokens(config: model.ProviderConfig, text: str) -> Result<model.TokenCount, Error> {
  validate_kind(config.kind)?
  // OpenAI-compatible APIs do not expose a portable tokenizer endpoint. Keep the estimate explicit
  // in the persisted result instead of presenting a byte heuristic as an exact token count.
  return Ok(model.TokenCount { count: estimate_tokens(text), exact: false })
}

pub fn count_prompt(config: model.ProviderConfig, request: model.GenerationRequest) -> model.TokenCount {
  validate_kind(config.kind) else {
    return model.TokenCount { count: -1, exact: false }
  }
  prompt := prompt_text(request)
  count := if prompt.len() == 0 { 0 } else { (prompt.len() + 3) / 4 }
  return model.TokenCount { count: count, exact: false }
}

pub fn prompt_text(request: model.GenerationRequest) -> string {
  b := builder()
  if request.system.len() > 0 {
    b.write(request.system)
    b.write("\n\n")
  }
  b.write(request.user)
  return b.to_string()
}

fn validate_kind(kind: model.ProviderKind) -> Result<(), Error> = match kind {
  CloudOpenAI => Ok(()),
  LocalOpenAI => Ok(()),
  LlamaCpp => Err(Error.Invalid),
}

fn validate_request_config(config: model.ProviderConfig) -> Result<(), Error> {
  validate_kind(config.kind)?
  cloud := match config.kind {
    CloudOpenAI => true,
    LocalOpenAI => false,
    LlamaCpp => false,
  }
  if cloud {
    if config.api_key.len() == 0 {
      return Err(Error.Denied)
    }
    if !config.endpoint.starts_with("https://") {
      return Err(Error.Invalid)
    }
  }
  return Ok(())
}

// The single source of OpenAI-compatible request bytes: the same bytes go on the wire and are the
// SHA-256 preimage of the recorded provider request digest.
pub fn request_bytes(model_name: str, request: model.GenerationRequest, streaming: bool) -> string {
  match request.seed {
    Some(seed) => {
      seeded_messages := [
        OpenAIMessage { role: "system", content: request.system },
        OpenAIMessage { role: "user", content: request.user },
      ].to_array()
      seeded_payload := OpenAISeededRequest {
        model: model_name,
        messages: seeded_messages,
        max_tokens: request.max_tokens,
        temperature: request.temperature,
        stream: streaming,
        seed: seed,
      }
      return json.encode(seeded_payload).clone()
    },
    None => {},
  }
  messages := [
    OpenAIMessage { role: "system", content: request.system },
    OpenAIMessage { role: "user", content: request.user },
  ].to_array()
  payload := OpenAIRequest {
    model: model_name,
    messages: messages,
    max_tokens: request.max_tokens,
    temperature: request.temperature,
    stream: streaming,
  }
  return json.encode(payload).clone()
}

// The envelope decoder shared by the generate path and every other consumer of a 2xx body.
pub fn decode_content(response: str) -> Result<string, Error> {
  decoded: OpenAIResponse := json.decode(response)?
  if decoded.choices.len() == 0 {
    return Err(Error.Invalid)
  }
  return Ok(decoded.choices[0].message.content.clone())
}

fn estimate_tokens(text: str) -> i64 {
  if text.len() == 0 {
    return 0
  }
  return (text.len() + 3) / 4
}

fn parse_stream(body: str) -> StreamParsed {
  mut output := builder()
  mut cursor := 0
  mut saw_content := false
  mut finished := false
  loop {
    if cursor >= body.len() || finished {
      break
    }
    line_end := match body[cursor..body.len()].find("\n") {
      Some(offset) => cursor + offset,
      None => body.len(),
    }
    line := body[cursor..line_end].trim_end()
    cursor = if line_end < body.len() { line_end + 1 } else { body.len() }
    if line.starts_with("data:") {
      data := line[5..line.len()].trim()
      if data == "[DONE]" {
        finished = true
      } else {
        arena {
          event := json.doc(data) else {
            return StreamParsed { ok: false, text: "".clone() }
          }
          match event.get("error").kind() {
            Missing => {},
            Null => {},
            _ => { return StreamParsed { ok: false, text: "".clone() } },
          }
          match event.get("choices").at(0).get("delta").get("content").as_str() {
            Some(content) => {
              output.write(content)
              saw_content = true
            },
            None => {},
          }
        }
      }
    }
  }
  if !saw_content || !finished {
    return StreamParsed { ok: false, text: "".clone() }
  }
  return StreamParsed { ok: true, text: output.to_string() }
}
