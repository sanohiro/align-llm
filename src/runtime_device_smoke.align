    owner, ggml_ffi.GPU_GRAPH_DECODE, ggml_ffi.GPU_GRAPH_INVALIDATIONS) != 0 {
    return Err(Error.Invalid)
  }
  return Ok(())
}

fn exercise_v_layout(
  backend: str,
  device: str,
  bundle_root: str,
  bundle_id: str,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  runtime_memory.admit(
    owner,
    runtime_memory.MemoryPlan {
      weights_bytes: 32,
      kv_bytes: 32,
      workspace_bytes: 65536,
      metadata_bytes: 65536,
      staging_bytes: 4,
      legacy_cache_bytes: 0,
    },
  )?
  runtime_memory.allocate(owner)?

  runtime_weights.begin(owner, 1)?
  weight := runtime_weights.add(
    owner,
    runtime_weights.Shape {
      ggml_type: 0,
      n_dims: 1,
      ne0: 1,
      ne1: 1,
      ne2: 1,
      ne3: 1,
    },
  )?
  mut weight_bytes := buffer(4)
  weight_bytes.put_u32_le(1065353216)
  weight_view := weight_bytes.bytes()
  runtime_weights.upload(owner, weight, 0, weight_view)?
  runtime_weights.finish(owner)?

  runtime_kv.begin(owner, 1)?
  plane := runtime_kv.add(
    owner,
    runtime_kv.Shape {
      ggml_type: 0,
      n_dims: 3,
      ne0: 4,
      ne1: 2,
      ne2: 1,
      ne3: 1,
    },
  )?
  runtime_kv.finish(owner)?
  mut zero_plane := buffer(32)
  mut zero_at := 0
  loop {
    if zero_at >= 8 { break }
    zero_plane.put_u32_le(0)
    zero_at = zero_at + 1
  }
  zero_view := zero_plane.bytes()
  runtime_kv.update(owner, plane, 0, zero_view)?

  runtime_inputs.begin(owner, 1)?
  source := runtime_inputs.add(
    owner,
    runtime_inputs.Shape {
      ggml_type: 0,
      n_dims: 3,
      ne0: 2,
      ne1: 2,
      ne2: 1,
      ne3: 1,
    },
  )?
  runtime_inputs.finish(owner)?

  ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_PREFILL, 16384)
  if ggml_ffi.handle_absent(ctx) { return Err(Error.Invalid) }
  mut slot_storage := buffer(256)
  mut slot_word := 0
  loop {
    if slot_word >= 64 { break }
    slot_storage.put_u32_le(0)
    slot_word = slot_word + 1
  }
  slots := slot_storage.bytes()
  ggml_ffi.slots_init(slots, slots.len(), "gpu_v_layout_slots") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_input_slot(owner, source, slots, 0) else { return Err(Error.Invalid) }
  match runtime_kv.prefix_slot(
    owner, plane, ggml_ffi.GPU_GRAPH_PREFILL, 2, 3, slots, 2,
  ) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  match runtime_kv.write_slot(
    owner, plane, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_KV_LAYOUT_K, 1, slots, 1, 0,
  ) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  runtime_kv.write_slot(
    owner, plane, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_KV_LAYOUT_V, 1, slots, 1, 0,
  )?
  runtime_kv.prefix_slot(
    owner, plane, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_KV_LAYOUT_V, 3, slots, 2,
  )?
  ggml_ffi.gpu_kv_slot(owner, plane, slots, 3) else { return Err(Error.Invalid) }
  if ggml_ffi.slot_ne(slots, 2, 0) != 3 || ggml_ffi.slot_ne(slots, 2, 1) != 2 {
    return Err(Error.Invalid)
  }
  graph := ggml_ffi.graph_new(ctx)
  if graph.is_null() { return Err(Error.Invalid) }
  ggml_ffi.graph_expand(graph, slots, 1, "gpu_v_layout_write") else {
    return Err(Error.Invalid)
  }
  key := topology_key(
    backend, bundle_id, ggml_ffi.GPU_GRAPH_PREFILL, PREFILL_TENSOR_DIGEST, 3,
    1, PREFILL_OUTPUT_DIGEST,
  )?
  runtime_execution.prepare(owner, ggml_ffi.GPU_GRAPH_PREFILL, key, graph)?
  mut values := buffer(16)
  values.put_u32_le(1065353216)
  values.put_u32_le(1073741824)
  values.put_u32_le(1077936128)
  values.put_u32_le(1082130432)
  value_view := values.bytes()
  runtime_inputs.update(owner, source, 0, value_view)?
  runtime_execution.compute(owner, ggml_ffi.GPU_GRAPH_PREFILL, key, graph)?
  runtime_device.synchronize(owner)?

  mut full := buffer(32)
  mut full_at := 0
  loop {
    if full_at >= 8 { break }
    full.put_u32_le(4294967295)
    full_at = full_at + 1
  }
  full_view := full.bytes()
  ggml_ffi.slot_get(slots, 3, full_view, 0, full_view.len(), "gpu_v_plane") else {
    return Err(Error.Invalid)
  }
  if full_view.u32_le(0) != 0
    || full_view.u32_le(4) != 1065353216
    || full_view.u32_le(8) != 1073741824
    || full_view.u32_le(12) != 0
    || full_view.u32_le(16) != 0
    || full_view.u32_le(20) != 1077936128
    || full_view.u32_le(24) != 1082130432
    || full_view.u32_le(28) != 0 {
    return Err(Error.Invalid)
  }
  return Ok(())
}

fn add_qwen_weight(
  borrow owner: ggml_ffi.GpuDevice,
  n_dims: i64,
  ne0: i64,
  ne1: i64,
  borrow ones: slice<u8>,
) -> Result<i64, Error> {
  index := runtime_weights.add(
    owner,
    runtime_weights.Shape {
      ggml_type: 0,
      n_dims: n_dims,
      ne0: ne0,
      ne1: ne1,
      ne2: 1,
      ne3: 1,
    },
  )?
  bytes := ne0 * ne1 * 4
  image := ones[0..bytes]
  runtime_weights.upload(owner, index, 0, image)?
  return Ok(index)
}

fn add_olmoe_weight(
  borrow owner: ggml_ffi.GpuDevice,
  n_dims: i64,
  ne0: i64,
  ne1: i64,
  ne2: i64,
  borrow ones: slice<u8>,
) -> Result<i64, Error> {
  index := runtime_weights.add(
    owner,
    runtime_weights.Shape {
      ggml_type: 0,
      n_dims: n_dims,
      ne0: ne0,
      ne1: ne1,
      ne2: ne2,
      ne3: 1,
    },
  )?
  bytes := ne0 * ne1 * ne2 * 4
  image := ones[0..bytes]
  runtime_weights.upload(owner, index, 0, image)?
  return Ok(index)
}

fn nonzero_word(borrow values: slice<u8>) -> bool {
  mut at := 0
  loop {
    if at >= values.len() { break }
    if values.u32_le(at) != 0 { return true }
    at = at + 4
  }
  return false
}

fn exercise_qwen_graph(
  backend: str,
  device: str,
  bundle_root: str,
  bundle_id: str,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  g := layer_qwen2.Geometry {
    code: "".clone(),
    detail: "".clone(),
    arch: "qwen2".clone(),
    n_layer: 1,
    n_embd: 2,
    n_head: 1,
    n_head_kv: 1,
    head_dim: 2,
    n_ff: 2,
    n_vocab: 4,
    n_expert: 0,
    context_length: 4,
    rms_eps_bits: 897988541,
    rope_type: 2,
    rope_dim_count: 2,
    rope_freq_base_bits: 1176256512,
    attn_scale_bits: layer_qwen2.attn_scale_bits(2),
  }
  if runtime_qwen.weight_count(g.n_layer) != 15 || runtime_qwen.kv_count(g.n_layer) != 2
    || runtime_qwen.output_slot() != 18 {
    return Err(Error.Invalid)
  }
  runtime_memory.admit(
    owner,
    runtime_memory.MemoryPlan {
      weights_bytes: 480,
      kv_bytes: 64,
      workspace_bytes: 262144,
      metadata_bytes: 262144,
      staging_bytes: 4096,
      legacy_cache_bytes: 0,
    },
  )?
  runtime_memory.allocate(owner)?

  mut one_storage := buffer(1024)
  mut one_at := 0
  loop {
    if one_at >= 256 { break }
    one_storage.put_u32_le(1065353216)
    one_at = one_at + 1
  }
  ones := one_storage.bytes()
  runtime_weights.begin(owner, runtime_qwen.weight_count(g.n_layer))?
  if add_qwen_weight(owner, 2, g.n_embd, g.n_vocab, ones)? != 0 {
    return Err(Error.Invalid)
  }
  layer_members := layer_qwen2.mf_layer_member_table(g)
  mut member := 0
  loop {
    if member >= layer_members.count { break }
    if add_qwen_weight(
      owner, layer_members.n_dims[member], layer_members.ne0[member],
      layer_members.ne1[member], ones,
    )? != 1 + member {
      return Err(Error.Invalid)
    }
    member = member + 1
  }
  head_members := layer_qwen2.mf_head_member_table(g)
  member = 0
  loop {
    if member >= head_members.count { break }
    if add_qwen_weight(
      owner, head_members.n_dims[member], head_members.ne0[member],
      head_members.ne1[member], ones,
    )? != 13 + member {
      return Err(Error.Invalid)
    }
    member = member + 1
  }
  runtime_weights.finish(owner)?

  runtime_kv.begin(owner, runtime_qwen.kv_count(g.n_layer))?
  k_index := runtime_kv.add(
    owner,
    runtime_kv.Shape {
      ggml_type: 0,
      n_dims: 3,
      ne0: g.head_dim,
      ne1: g.context_length,
      ne2: g.n_head_kv,
      ne3: 1,
    },
  )?
  v_index := runtime_kv.add(
    owner,
    runtime_kv.Shape {
      ggml_type: 0,
      n_dims: 3,
      ne0: g.context_length,
      ne1: g.head_dim,
      ne2: g.n_head_kv,
      ne3: 1,
    },
  )?
  if k_index != 0 || v_index != 1 { return Err(Error.Invalid) }
  runtime_kv.finish(owner)?

  runtime_inputs.begin(owner, runtime_qwen.INPUT_COUNT)?
  prefill_tokens := runtime_inputs.add(
    owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 2, ne1: 1, ne2: 1, ne3: 1,
    },
  )?
  prefill_positions := runtime_inputs.add(
    owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 2, ne1: 1, ne2: 1, ne3: 1,
    },
  )?
  prefill_mask := runtime_inputs.add(
    owner, runtime_inputs.Shape {
      ggml_type: 0, n_dims: 2, ne0: 4, ne1: 2, ne2: 1, ne3: 1,
    },
  )?
  decode_token := runtime_inputs.add(
    owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 1, ne1: 1, ne2: 1, ne3: 1,
    },
  )?
  decode_position := runtime_inputs.add(
    owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 1, ne1: 1, ne2: 1, ne3: 1,
    },
  )?
  decode_mask := runtime_inputs.add(
    owner, runtime_inputs.Shape {
      ggml_type: 0, n_dims: 2, ne0: 4, ne1: 1, ne2: 1, ne3: 1,
    },
  )?
  output_id := runtime_inputs.add(
    owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 1, ne1: 1, ne2: 1, ne3: 1,
    },
  )?
  v_indices := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 2, ne1: 1, ne2: 1, ne3: 1,
    })?
  if prefill_tokens != runtime_qwen.INPUT_PREFILL_TOKENS
    || prefill_positions != runtime_qwen.INPUT_PREFILL_POSITIONS
    || prefill_mask != runtime_qwen.INPUT_PREFILL_MASK
    || decode_token != runtime_qwen.INPUT_DECODE_TOKEN
    || decode_position != runtime_qwen.INPUT_DECODE_POSITION
    || decode_mask != runtime_qwen.INPUT_DECODE_MASK
    || output_id != runtime_qwen.INPUT_OUTPUT_ID {
    return Err(Error.Invalid)
  }
  runtime_inputs.finish(owner)?

  mut prefill_token_values := buffer(8)
  prefill_token_values.put_u32_le(0)
  prefill_token_values.put_u32_le(1)
  mut prefill_position_values := buffer(8)
  prefill_position_values.put_u32_le(0)
  prefill_position_values.put_u32_le(1)
  mut prefill_mask_values := buffer(32)
  prefill_mask_values.put_u32_le(0)
  prefill_mask_values.put_u32_le(layer_qwen2.MASK_NEG_INFINITY_BITS as u32)
  prefill_mask_values.put_u32_le(layer_qwen2.MASK_NEG_INFINITY_BITS as u32)
  prefill_mask_values.put_u32_le(layer_qwen2.MASK_NEG_INFINITY_BITS as u32)
  prefill_mask_values.put_u32_le(0)
  prefill_mask_values.put_u32_le(0)
  prefill_mask_values.put_u32_le(layer_qwen2.MASK_NEG_INFINITY_BITS as u32)
  prefill_mask_values.put_u32_le(layer_qwen2.MASK_NEG_INFINITY_BITS as u32)
  mut output_value := buffer(4)
  output_value.put_u32_le(1)
  prefill_token_view := prefill_token_values.bytes()
  prefill_position_view := prefill_position_values.bytes()
  prefill_mask_view := prefill_mask_values.bytes()
  output_view := output_value.bytes()
  mut slot_storage := buffer(1040)
  mut slot_word := 0
  loop {
    if slot_word >= 260 { break }
    slot_storage.put_u32_le(0)
    slot_word = slot_word + 1
  }
  slots := slot_storage.bytes()
  prefill_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_PREFILL, 98304)
  if ggml_ffi.handle_absent(prefill_ctx) { return Err(Error.Invalid) }
  prefill_graph := ggml_ffi.graph_new(prefill_ctx)
  if ggml_ffi.handle_absent(prefill_graph) { return Err(Error.Invalid) }
  runtime_qwen.build_prefill(owner, g, 2, prefill_ctx, prefill_graph, slots)?
  if ggml_ffi.graph_node_count(prefill_graph) < 40 { return Err(Error.Invalid) }
  prefill_key := topology_key(
    backend, bundle_id, ggml_ffi.GPU_GRAPH_PREFILL, PREFILL_TENSOR_DIGEST, 2,
    2, PREFILL_OUTPUT_DIGEST,
  )?
  runtime_execution.prepare(owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_key, prefill_graph)?
  runtime_inputs.update(owner, prefill_tokens, 0, prefill_token_view)?
  runtime_inputs.update(owner, prefill_positions, 0, prefill_position_view)?
  runtime_inputs.update(owner, prefill_mask, 0, prefill_mask_view)?
  runtime_inputs.update(owner, output_id, 0, output_view)?
  runtime_execution.compute(owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_key, prefill_graph)?
  mut logits := buffer(16)
  mut logits_at := 0
  loop {
    if logits_at >= 4 { break }
    logits.put_u32_le(0)
    logits_at = logits_at + 1
  }
  logits_view := logits.bytes()
  ggml_ffi.slot_get(
    slots, runtime_qwen.output_slot(), logits_view, 0, logits_view.len(), "qwen_prefill_logits",
  ) else {
    return Err(Error.Invalid)
  }
  if !nonzero_word(logits_view) { return Err(Error.Invalid) }

  mut decode_token_value := buffer(4)
  decode_token_value.put_u32_le(2)
  mut decode_position_value := buffer(4)
  decode_position_value.put_u32_le(2)
  mut decode_mask_values := buffer(16)
  decode_mask_values.put_u32_le(0)
  decode_mask_values.put_u32_le(0)
  decode_mask_values.put_u32_le(0)
  decode_mask_values.put_u32_le(layer_qwen2.MASK_NEG_INFINITY_BITS as u32)
  mut decode_output_value := buffer(4)
  decode_output_value.put_u32_le(0)
  decode_token_view := decode_token_value.bytes()
  decode_position_view := decode_position_value.bytes()
  decode_mask_view := decode_mask_values.bytes()
  decode_output_view := decode_output_value.bytes()
  decode_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_DECODE, 98304)
  if ggml_ffi.handle_absent(decode_ctx) { return Err(Error.Invalid) }
  decode_graph := ggml_ffi.graph_new(decode_ctx)
  if ggml_ffi.handle_absent(decode_graph) { return Err(Error.Invalid) }
  runtime_qwen.build_decode(owner, g, 2, 4, decode_ctx, decode_graph, slots)?
  if ggml_ffi.graph_node_count(decode_graph) < 42 { return Err(Error.Invalid) }
  decode_key := topology_key(
    backend, bundle_id, ggml_ffi.GPU_GRAPH_DECODE, DECODE_TENSOR_DIGEST, 3,
    1, DECODE_OUTPUT_DIGEST,
  )?
  runtime_execution.prepare(owner, ggml_ffi.GPU_GRAPH_DECODE, decode_key, decode_graph)?
  runtime_inputs.update(owner, decode_token, 0, decode_token_view)?
  runtime_inputs.update(owner, decode_position, 0, decode_position_view)?
  mut v_rows := buffer(8)
  v_rows.put_u32_le(2)
  v_rows.put_u32_le(6)
  v_rows_view := v_rows.bytes()
  runtime_inputs.update(owner, v_indices, 0, v_rows_view)?
  runtime_inputs.update(owner, decode_mask, 0, decode_mask_view)?
  runtime_inputs.update(owner, output_id, 0, decode_output_view)?
  runtime_execution.compute(owner, ggml_ffi.GPU_GRAPH_DECODE, decode_key, decode_graph)?
  ggml_ffi.slot_get(
    slots, runtime_qwen.output_slot(), logits_view, 0, logits_view.len(), "qwen_decode_logits",
  ) else {
    return Err(Error.Invalid)
  }
  if !nonzero_word(logits_view) { return Err(Error.Invalid) }
  ggml_ffi.gpu_kv_slot(owner, k_index, slots, 100) else { return Err(Error.Invalid) }
  ggml_ffi.gpu_kv_slot(owner, v_index, slots, 101) else { return Err(Error.Invalid) }
  mut k_values := buffer(32)
  mut v_values := buffer(32)
  mut kv_at := 0
  loop {
    if kv_at >= 8 { break }
    k_values.put_u32_le(0)
    v_values.put_u32_le(0)
    kv_at = kv_at + 1
  }
  k_view := k_values.bytes()
  v_view := v_values.bytes()
  ggml_ffi.slot_get(slots, 100, k_view, 0, k_view.len(), "qwen_k_plane") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.slot_get(slots, 101, v_view, 0, v_view.len(), "qwen_v_plane") else {
    return Err(Error.Invalid)
  }
  if !nonzero_word(k_view) || !nonzero_word(v_view) { return Err(Error.Invalid) }
  runtime_device.synchronize(owner)?
  return Ok(())
}

fn exercise_olmoe_graph(
  backend: str,
  device: str,
  bundle_root: str,
  bundle_id: str,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  g := layer_olmoe.Geometry {
    code: "".clone(),
    detail: "".clone(),
    arch: "olmoe".clone(),
    n_layer: 1,
    n_embd: 2,
    n_head: 1,
    n_head_kv: 1,
    head_dim: 2,
    n_ff_exp: 2,
    n_vocab: 4,
    n_expert: 3,
    n_expert_used: 2,
    context_length: 4,
    rms_eps_bits: 897988541,
    rope_type: layer_olmoe.ROPE_TYPE_NEOX,
    rope_dim_count: 2,
    rope_freq_base_bits: 1176256512,
    attn_scale_bits: layer_olmoe.attn_scale_bits(2),
  }
  if runtime_olmoe.weight_count(g.n_layer) != 15 || runtime_olmoe.kv_count(g.n_layer) != 2
    || runtime_olmoe.output_slot() != 23 {
    return Err(Error.Invalid)
  }
  runtime_memory.admit(
    owner,
    runtime_memory.MemoryPlan {
      weights_bytes: 576,
      kv_bytes: 64,
      workspace_bytes: 262144,
      metadata_bytes: 262144,
      staging_bytes: 4096,
      legacy_cache_bytes: 0,
    },
  )?
  runtime_memory.allocate(owner)?

  mut one_storage := buffer(1024)
  mut one_at := 0
  loop {
    if one_at >= 256 { break }
    one_storage.put_u32_le(1065353216)
    one_at = one_at + 1
  }
  ones := one_storage.bytes()
  runtime_weights.begin(owner, runtime_olmoe.weight_count(g.n_layer))?
  if add_olmoe_weight(owner, 2, g.n_embd, g.n_vocab, 1, ones)? != 0 {
    return Err(Error.Invalid)
  }
  layer_members := layer_olmoe.mm_layer_member_table(g)
  mut member := 0
  loop {
    if member >= layer_members.count { break }
    if add_olmoe_weight(
      owner, layer_members.n_dims[member], layer_members.ne0[member],
      layer_members.ne1[member], 1, ones,
    )? != 1 + member {
      return Err(Error.Invalid)
    }
    member = member + 1
  }
  mut expert := 0
  loop {
    if expert >= 3 { break }
    if add_olmoe_weight(
      owner, 3, layer_olmoe.claim_ne0(g, expert), layer_olmoe.claim_ne1(g, expert),
      g.n_expert, ones,
    )? != 10 + expert {
      return Err(Error.Invalid)
    }
    expert = expert + 1
  }
  head_members := layer_olmoe.mm_head_member_table(g)
  member = 0
  loop {
    if member >= head_members.count { break }
    if add_olmoe_weight(
      owner, head_members.n_dims[member], head_members.ne0[member],
      head_members.ne1[member], 1, ones,
    )? != 13 + member {
      return Err(Error.Invalid)
    }
    member = member + 1
  }
  runtime_weights.finish(owner)?

  runtime_kv.begin(owner, runtime_olmoe.kv_count(g.n_layer))?
  k_index := runtime_kv.add(
    owner,
    runtime_kv.Shape {
      ggml_type: 0,
      n_dims: 3,
      ne0: g.head_dim,
      ne1: g.context_length,
      ne2: g.n_head_kv,
      ne3: 1,
    },
  )?
  v_index := runtime_kv.add(
    owner,
    runtime_kv.Shape {
      ggml_type: 0,
      n_dims: 3,
      ne0: g.context_length,
      ne1: g.head_dim,
      ne2: g.n_head_kv,
      ne3: 1,
    },
  )?
  if k_index != 0 || v_index != 1 { return Err(Error.Invalid) }
  runtime_kv.finish(owner)?

  runtime_inputs.begin(owner, runtime_olmoe.INPUT_COUNT)?
  prefill_tokens := runtime_inputs.add(
    owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 2, ne1: 1, ne2: 1, ne3: 1,
    },
  )?
  prefill_positions := runtime_inputs.add(
    owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 2, ne1: 1, ne2: 1, ne3: 1,
    },
  )?
  prefill_mask := runtime_inputs.add(
    owner, runtime_inputs.Shape {
      ggml_type: 0, n_dims: 2, ne0: 4, ne1: 2, ne2: 1, ne3: 1,
    },
  )?
  decode_token := runtime_inputs.add(
    owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 1, ne1: 1, ne2: 1, ne3: 1,
    },
  )?
  decode_position := runtime_inputs.add(
    owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 1, ne1: 1, ne2: 1, ne3: 1,
    },
  )?
  decode_mask := runtime_inputs.add(
    owner, runtime_inputs.Shape {
      ggml_type: 0, n_dims: 2, ne0: 4, ne1: 1, ne2: 1, ne3: 1,
    },
  )?
  output_id := runtime_inputs.add(
    owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 1, ne1: 1, ne2: 1, ne3: 1,
    },
  )?
  v_indices := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 2, ne1: 1, ne2: 1, ne3: 1,
    })?
  if prefill_tokens != runtime_olmoe.INPUT_PREFILL_TOKENS
    || prefill_positions != runtime_olmoe.INPUT_PREFILL_POSITIONS
    || prefill_mask != runtime_olmoe.INPUT_PREFILL_MASK
    || decode_token != runtime_olmoe.INPUT_DECODE_TOKEN
    || decode_position != runtime_olmoe.INPUT_DECODE_POSITION
    || decode_mask != runtime_olmoe.INPUT_DECODE_MASK
    || output_id != runtime_olmoe.INPUT_OUTPUT_ID {
    return Err(Error.Invalid)
  }
  runtime_inputs.finish(owner)?

  mut prefill_token_values := buffer(8)
  prefill_token_values.put_u32_le(0)
  prefill_token_values.put_u32_le(1)
  mut prefill_position_values := buffer(8)
  prefill_position_values.put_u32_le(0)
  prefill_position_values.put_u32_le(1)
  mut prefill_mask_values := buffer(32)
  prefill_mask_values.put_u32_le(0)
  prefill_mask_values.put_u32_le(layer_olmoe.MASK_NEG_INFINITY_BITS as u32)
  prefill_mask_values.put_u32_le(layer_olmoe.MASK_NEG_INFINITY_BITS as u32)
  prefill_mask_values.put_u32_le(layer_olmoe.MASK_NEG_INFINITY_BITS as u32)
  prefill_mask_values.put_u32_le(0)
  prefill_mask_values.put_u32_le(0)
  prefill_mask_values.put_u32_le(layer_olmoe.MASK_NEG_INFINITY_BITS as u32)
  prefill_mask_values.put_u32_le(layer_olmoe.MASK_NEG_INFINITY_BITS as u32)
  mut output_value := buffer(4)
  output_value.put_u32_le(1)
  prefill_token_view := prefill_token_values.bytes()
  prefill_position_view := prefill_position_values.bytes()
  prefill_mask_view := prefill_mask_values.bytes()
  output_view := output_value.bytes()
  mut slot_storage := buffer(1040)
  mut slot_word := 0
  loop {
    if slot_word >= 260 { break }
    slot_storage.put_u32_le(0)
    slot_word = slot_word + 1
  }
  slots := slot_storage.bytes()
  prefill_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_PREFILL, 98304)
  if ggml_ffi.handle_absent(prefill_ctx) { return Err(Error.Invalid) }
  prefill_graph := ggml_ffi.graph_new(prefill_ctx)
  if ggml_ffi.handle_absent(prefill_graph) { return Err(Error.Invalid) }
  runtime_olmoe.build_prefill(owner, g, 2, prefill_ctx, prefill_graph, slots)?
  if ggml_ffi.slot_ne(slots, layer_olmoe.MM_SLOT_TOPK, 0) != g.n_expert_used
    || ggml_ffi.slot_ne(slots, layer_olmoe.MM_SLOT_TOPK, 1) != 1
    || ggml_ffi.slot_ne(slots, layer_olmoe.MM_SLOT_COMPACT, 0) != g.n_expert_used
    || ggml_ffi.slot_ne(slots, layer_olmoe.MM_SLOT_COMPACT, 1) != 1 {
    return Err(Error.Invalid)
  }
  if ggml_ffi.graph_node_count(prefill_graph) < 50 { return Err(Error.Invalid) }
  prefill_key := topology_key(
    backend, bundle_id, ggml_ffi.GPU_GRAPH_PREFILL, PREFILL_TENSOR_DIGEST, 2,
    2, PREFILL_OUTPUT_DIGEST,
  )?
  runtime_execution.prepare(owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_key, prefill_graph)?
  runtime_inputs.update(owner, prefill_tokens, 0, prefill_token_view)?
  runtime_inputs.update(owner, prefill_positions, 0, prefill_position_view)?
  runtime_inputs.update(owner, prefill_mask, 0, prefill_mask_view)?
  runtime_inputs.update(owner, output_id, 0, output_view)?
  runtime_execution.compute(owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_key, prefill_graph)?
  mut logits := buffer(16)
  mut logits_at := 0
  loop {
    if logits_at >= 4 { break }
    logits.put_u32_le(0)
    logits_at = logits_at + 1
  }
  logits_view := logits.bytes()
  ggml_ffi.slot_get(
    slots, runtime_olmoe.output_slot(), logits_view, 0, logits_view.len(), "olmoe_prefill_logits",
  ) else {
    return Err(Error.Invalid)
  }
  if !nonzero_word(logits_view) { return Err(Error.Invalid) }

  mut decode_token_value := buffer(4)
  decode_token_value.put_u32_le(2)
  mut decode_position_value := buffer(4)
  decode_position_value.put_u32_le(2)
  mut decode_mask_values := buffer(16)
  decode_mask_values.put_u32_le(0)
  decode_mask_values.put_u32_le(0)
  decode_mask_values.put_u32_le(0)
  decode_mask_values.put_u32_le(layer_olmoe.MASK_NEG_INFINITY_BITS as u32)
  mut decode_output_value := buffer(4)
  decode_output_value.put_u32_le(0)
  decode_token_view := decode_token_value.bytes()
  decode_position_view := decode_position_value.bytes()
  decode_mask_view := decode_mask_values.bytes()
  decode_output_view := decode_output_value.bytes()
  decode_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_DECODE, 98304)
  if ggml_ffi.handle_absent(decode_ctx) { return Err(Error.Invalid) }
  decode_graph := ggml_ffi.graph_new(decode_ctx)
  if ggml_ffi.handle_absent(decode_graph) { return Err(Error.Invalid) }
  runtime_olmoe.build_decode(owner, g, 2, 4, decode_ctx, decode_graph, slots)?
  if ggml_ffi.slot_ne(slots, layer_olmoe.MM_SLOT_TOPK, 0) != g.n_expert_used
    || ggml_ffi.slot_ne(slots, layer_olmoe.MM_SLOT_TOPK, 1) != 1
    || ggml_ffi.slot_ne(slots, layer_olmoe.MM_SLOT_COMPACT, 0) != g.n_expert_used
    || ggml_ffi.slot_ne(slots, layer_olmoe.MM_SLOT_COMPACT, 1) != 1 {
    return Err(Error.Invalid)
  }
  if ggml_ffi.graph_node_count(decode_graph) < 52 { return Err(Error.Invalid) }
  decode_key := topology_key(
    backend, bundle_id, ggml_ffi.GPU_GRAPH_DECODE, DECODE_TENSOR_DIGEST, 3,
    1, DECODE_OUTPUT_DIGEST,
  )?
  runtime_execution.prepare(owner, ggml_ffi.GPU_GRAPH_DECODE, decode_key, decode_graph)?
  runtime_inputs.update(owner, decode_token, 0, decode_token_view)?
  runtime_inputs.update(owner, decode_position, 0, decode_position_view)?
  mut v_rows := buffer(8)
  v_rows.put_u32_le(2)
  v_rows.put_u32_le(6)
  v_rows_view := v_rows.bytes()
  runtime_inputs.update(owner, v_indices, 0, v_rows_view)?
  runtime_inputs.update(owner, decode_mask, 0, decode_mask_view)?
  runtime_inputs.update(owner, output_id, 0, decode_output_view)?
  runtime_execution.compute(owner, ggml_ffi.GPU_GRAPH_DECODE, decode_key, decode_graph)?
  ggml_ffi.slot_get(
    slots, runtime_olmoe.output_slot(), logits_view, 0, logits_view.len(), "olmoe_decode_logits",
  ) else {
    return Err(Error.Invalid)
  }
  if !nonzero_word(logits_view) { return Err(Error.Invalid) }
  ggml_ffi.gpu_kv_slot(owner, k_index, slots, 100) else { return Err(Error.Invalid) }
  ggml_ffi.gpu_kv_slot(owner, v_index, slots, 101) else { return Err(Error.Invalid) }
  mut k_values := buffer(32)
  mut v_values := buffer(32)
  mut kv_at := 0
  loop {
    if kv_at >= 8 { break }
    k_values.put_u32_le(0)
    v_values.put_u32_le(0)
    kv_at = kv_at + 1
  }
  k_view := k_values.bytes()
  v_view := v_values.bytes()
  ggml_ffi.slot_get(slots, 100, k_view, 0, k_view.len(), "olmoe_k_plane") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.slot_get(slots, 101, v_view, 0, v_view.len(), "olmoe_v_plane") else {
    return Err(Error.Invalid)
  }
  if !nonzero_word(k_view) || !nonzero_word(v_view) { return Err(Error.Invalid) }
  runtime_device.synchronize(owner)?
  return Ok(())
}

fn expect_allocation_failure(
  backend: str,
  device: str,
  bundle_root: str,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  admitted(owner)?
  return match ggml_ffi.gpu_memory_allocate(owner) {
    Ok(_) => Err(Error.Invalid),
    Err(fault) => if fault.code == "ALLOCATION" { Ok(()) } else { Err(Error.Invalid) },
  }
}

fn expect_reopen_after_failure(
  backend: str,
  device: str,
  bundle_root: str,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  return match ggml_ffi.gpu_device_synchronize(owner) {
    Ok(_) => Ok(()),
    Err(_) => Err(Error.Invalid),
  }
}

fn expect_weight_allocation_failure(
  backend: str,
  device: str,
  bundle_root: str,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  runtime_memory.admit(
    owner,
    runtime_memory.MemoryPlan {
      weights_bytes: 1,
      kv_bytes: 1,
      workspace_bytes: 1,
      metadata_bytes: 4096,
      staging_bytes: 1,
      legacy_cache_bytes: 0,
    },
  )?
  runtime_memory.allocate(owner)?
  runtime_weights.begin(owner, 1)?
  return match ggml_ffi.gpu_weight_add(owner, 0, 1, 1, 1, 1, 1) {
    Ok(_) => Err(Error.Invalid),
    Err(fault) => if fault.code == "ALLOCATION" { Ok(()) } else { Err(Error.Invalid) },
  }
}

fn expect_memory_budget_refusal(
  backend: str,
  device: str,
  bundle_root: str,
  weights_bytes: i64,
  kv_bytes: i64,
  workspace_bytes: i64,
  metadata_bytes: i64,
  staging_bytes: i64,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  return match ggml_ffi.gpu_memory_admit(
    owner, weights_bytes, kv_bytes, workspace_bytes, metadata_bytes, staging_bytes, 0,
  ) {
    Ok(_) => Err(Error.Invalid),
    Err(fault) => if fault.code == "MEMORY_BUDGET" { Ok(()) } else { Err(Error.Invalid) },
  }
}

fn expect_input_allocation_failure(
  backend: str,
  device: str,
  bundle_root: str,
  workspace_failure: bool,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  runtime_memory.admit(
    owner,
    runtime_memory.MemoryPlan {
      weights_bytes: 32,
      kv_bytes: 32,
      workspace_bytes: 65536,
      metadata_bytes: 65536,
      staging_bytes: 4,
      legacy_cache_bytes: 0,
    },
  )?
  runtime_memory.allocate(owner)?
  runtime_weights.begin(owner, 1)?
  weight := runtime_weights.add(
    owner,
    runtime_weights.Shape {
      ggml_type: 0,
      n_dims: 1,
      ne0: 1,
      ne1: 1,
      ne2: 1,
      ne3: 1,
    },
  )?
  mut scalar := buffer(4)
  scalar.put_u32_le(1065353216)
  scalar_view := scalar.bytes()
  runtime_weights.upload(owner, weight, 0, scalar_view)?
  runtime_weights.finish(owner)?
  runtime_kv.begin(owner, 1)?
  runtime_kv.add(
    owner,
    runtime_kv.Shape {
      ggml_type: 0,
      n_dims: 1,
      ne0: 1,
      ne1: 1,
      ne2: 1,
      ne3: 1,
    },
  )?
  runtime_kv.finish(owner)?
  runtime_inputs.begin(owner, 1)?
  runtime_inputs.add(
    owner,
    runtime_inputs.Shape {
      ggml_type: 0,
      n_dims: 1,
      ne0: 1,
      ne1: 1,
      ne2: 1,
      ne3: 1,
    },
  )?
  if workspace_failure {
    runtime_inputs.finish(owner)?
    ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_PREFILL, 32768)
    if ggml_ffi.handle_absent(ctx) { return Err(Error.Invalid) }
    mut storage := buffer(1040)
    mut at := 0
    loop {
      if at >= 1040 { break }
      storage.put_u8(0)
      at = at + 1
    }
    slots := storage.bytes()
    ggml_ffi.slots_init(slots, slots.len(), "workspace_fault_slots") else { return Err(Error.Invalid) }
    ggml_ffi.gpu_input_slot(owner, 0, slots, 0) else { return Err(Error.Invalid) }
    ggml_ffi.op_add(ctx, slots, 1, 0, 0, "workspace_fault_add") else { return Err(Error.Invalid) }
    graph := ggml_ffi.graph_new(ctx)
    if ggml_ffi.handle_absent(graph) { return Err(Error.Invalid) }
    ggml_ffi.graph_expand(graph, slots, 1, "workspace_fault_expand") else { return Err(Error.Invalid) }
    return match ggml_ffi.gpu_graph_prepare(owner, ggml_ffi.GPU_GRAPH_PREFILL, MODEL_LAYOUT_DIGEST, graph) {
      Ok(_) => Err(Error.Invalid),
      Err(fault) => if fault.code == "ALLOCATION" { Ok(()) } else { Err(Error.Invalid) },
    }
  }
  return match ggml_ffi.gpu_inputs_finish(owner) {
    Ok(_) => Err(Error.Invalid),
    Err(fault) => if fault.code == "ALLOCATION" { Ok(()) } else { Err(Error.Invalid) },
  }
}

fn expect_unavailable(
  backend: str,
  device: str,
  bundle_root: str,
) -> Result<(), Error> = match runtime_device.open(
  options(backend, device, bundle_root),
) {
  Ok(_) => Err(Error.Invalid),
  Err(_) => Ok(()),
}

fn expect_verification_refusal(
  backend: str,
  device: str,
  bundle_root: str,
) -> Result<(), Error> = match runtime_device.open(options(backend, device, bundle_root)) {
  Ok(_) => Err(Error.Invalid),
  Err(_) => Ok(()),
}

fn expect_bundle_switch(
  backend: str,
  device: str,
  backend_path: str,
  bundle_id: str,
) -> Result<(), Error> = match ggml_ffi.gpu_device_open(
  backend, device, backend_path, bundle_id, 1048576, 1048576,
) {
  Ok(_) => Err(Error.Invalid),
  Err(fault) => if fault.code == "BUNDLE_IDENTITY" { Ok(()) } else { Err(Error.Invalid) },
}

fn expect_attention_width() -> Result<(), Error> {
  if runtime_inputs.attention_width(1, 4096)? != 256
    || runtime_inputs.attention_width(256, 4096)? != 256
    || runtime_inputs.attention_width(257, 4096)? != 512
    || runtime_inputs.attention_width(257, 300)? != 300
    || runtime_inputs.attention_width(300, 300)? != 300
    || runtime_inputs.attention_width(2, 4)? != 4 {
    return Err(Error.Invalid)
  }
  match runtime_inputs.attention_width(0, 256) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  match runtime_inputs.attention_width(257, 256) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  match runtime_inputs.attention_width(9223372036854775807, 9223372036854775807) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  return Ok(())
}

fn expect_first_fault() -> Result<(), Error> {
  ggml_ffi.gpu_failure_reset()
  ggml_ffi.gpu_failure_activity(ggml_ffi.GPU_STAGE_PLAN)
  active := ggml_ffi.gpu_last_failure()
  if active.code.len() != 0 || active.detail != "plan" { return Err(Error.Invalid) }
  ggml_ffi.gpu_note_failure(ggml_ffi.GPU_STATUS_MEMORY_BUDGET, 0)
  ggml_ffi.gpu_failure_activity(ggml_ffi.GPU_STAGE_RELEASE)
  ggml_ffi.gpu_note_failure(ggml_ffi.GPU_STATUS_POISONED, ggml_ffi.GPU_STAGE_RELEASE)
  first := ggml_ffi.gpu_last_failure()
  if first.code != "MEMORY_BUDGET" || first.detail != "plan" { return Err(Error.Invalid) }
  ggml_ffi.gpu_failure_reset()
  clear := ggml_ffi.gpu_last_failure()
  if clear.code.len() != 0 || clear.detail.len() != 0 { return Err(Error.Invalid) }
  return Ok(())
}

pub fn main(args: array<str>) -> Result<(), Error> {
  expect_first_fault()?
  if args.len() != 9 { return Err(Error.Invalid) }
  expect_attention_width()?
  expect_topology_key()?
  mode := args[1]
  backend := args[2]
  device := args[3]
  bundle_root := args[4]
  invalid_bundle_root := args[5]
  other_bundle_root := args[6]
  backend_path := args[7]
  bundle_id := args[8]

  if mode == "unavailable" {
    expect_unavailable(backend, device, bundle_root)?
    expect_unavailable(backend, device, bundle_root)?
    print("runtime device smoke: UNAVAILABLE PASS")
    return Ok(())
  }
  if mode == "allocation-failure" {
    expect_allocation_failure(backend, device, bundle_root)?
    expect_reopen_after_failure(backend, device, bundle_root)?
    print("runtime device smoke: ALLOCATION FAILURE PASS")
    return Ok(())
  }
  if mode == "input-allocation-failure" || mode == "workspace-allocation-failure" {
    expect_input_allocation_failure(backend, device, bundle_root, mode == "workspace-allocation-failure")?
    expect_reopen_after_failure(backend, device, bundle_root)?
    print("runtime device smoke: INPUT ALLOCATION FAILURE PASS")
    return Ok(())
  }
  if mode != "available" { return Err(Error.Invalid) }

  // Returning from the helper drops the first owner. Reopening the same pinned bundle proves the
  // guard was released on that ordinary return path; returning again covers a second lifetime.
  expect_verification_refusal(backend, device, invalid_bundle_root)?
  expect_memory_budget_refusal(backend, device, bundle_root, 524289, 262144, 262144, 1, 1)?
  expect_memory_budget_refusal(backend, device, bundle_root, 1, 1, 1, 1, 1048576)?
  expect_memory_budget_refusal(backend, device, bundle_root, 1, 1, 1, 9223372036854775807, 1)?
  expect_memory_budget_refusal(backend, device, bundle_root, 9223372036854775807, 1, 1, 1, 1)?
  expect_weight_allocation_failure(backend, device, bundle_root)?
  exercise_live_owner(backend, device, bundle_root, backend_path, bundle_id)?
  exercise_live_owner(backend, device, bundle_root, backend_path, bundle_id)?
  exercise_v_layout(backend, device, bundle_root, bundle_id)?
  exercise_qwen_graph(backend, device, bundle_root, bundle_id)?
  exercise_olmoe_graph(backend, device, bundle_root, bundle_id)?

  expect_verification_refusal(backend, device, other_bundle_root)?
  expect_bundle_switch(
    backend,
    device,
    backend_path,
    "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
  )?
  print("runtime device smoke: AVAILABLE PASS")
  return Ok(())
}
