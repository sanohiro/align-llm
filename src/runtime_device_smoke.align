    return Err(Error.Invalid)
  }
  mut second_kv_attention := buffer(32)
  mut second_kv_attention_at := 0
  loop {
    if second_kv_attention_at >= 8 { break }
    second_kv_attention.put_u32_le(4294967295)
    second_kv_attention_at = second_kv_attention_at + 1
