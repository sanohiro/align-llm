module runtime_device_smoke

import ggml_ffi
import layer_olmoe
import layer_qwen2
import runtime_device
import runtime_execution
import runtime_inputs
import runtime_kv
import runtime_memory
import runtime_olmoe
import runtime_options
import runtime_qwen
import runtime_weights

MODEL_LAYOUT_DIGEST := "1111111111111111111111111111111111111111111111111111111111111111"
PREFILL_TENSOR_DIGEST := "2222222222222222222222222222222222222222222222222222222222222222"
DECODE_TENSOR_DIGEST := "3333333333333333333333333333333333333333333333333333333333333333"
REBUILT_TENSOR_DIGEST := "4444444444444444444444444444444444444444444444444444444444444444"
MASK_LAYOUT_DIGEST := "5555555555555555555555555555555555555555555555555555555555555555"
POSITION_LAYOUT_DIGEST := "6666666666666666666666666666666666666666666666666666666666666666"
PREFILL_OUTPUT_DIGEST := "7777777777777777777777777777777777777777777777777777777777777777"
DECODE_OUTPUT_DIGEST := "8888888888888888888888888888888888888888888888888888888888888888"
REBUILT_OUTPUT_DIGEST := "9999999999999999999999999999999999999999999999999999999999999999"
TOPOLOGY_GOLDEN_BUNDLE := "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
TOPOLOGY_GOLDEN_KEY := "32f8b86e8ec64fe172029ef8f7cffae65f13bb68daf9b064b843e0c391d5fbd7"

fn topology_key(
  backend: str,
  bundle_id: str,
  graph_kind: i64,
  tensor_shape_stride_sha256: str,
  kv_view_width: i64,
  query_width: i64,
  output_selection_sha256: str,
) -> Result<string, Error> {
  identity := runtime_execution.TopologyIdentity {
    backend: backend.clone(),
    bundle_id: bundle_id.clone(),
    model_id: "qwen2".clone(),
    model_layout_sha256: MODEL_LAYOUT_DIGEST.clone(),
    tensor_shape_stride_sha256: tensor_shape_stride_sha256.clone(),
    attention_policy: "decomposed-f32".clone(),
  }
  invocation := runtime_execution.TopologyInvocation {
    graph_kind: graph_kind,
    buffer_generation: 1,
    kv_view_width: kv_view_width,
    query_width: query_width,
    mask_layout_sha256: MASK_LAYOUT_DIGEST.clone(),
    position_layout_sha256: POSITION_LAYOUT_DIGEST.clone(),
    output_selection_sha256: output_selection_sha256.clone(),
  }
  return runtime_execution.topology_key(identity, invocation)
}

fn fixed_identity(bundle_id: str) -> runtime_execution.TopologyIdentity =
runtime_execution.TopologyIdentity {
  backend: "metal".clone(),
  bundle_id: bundle_id.clone(),
  model_id: "qwen2".clone(),
  model_layout_sha256: MODEL_LAYOUT_DIGEST.clone(),
  tensor_shape_stride_sha256: PREFILL_TENSOR_DIGEST.clone(),
  attention_policy: "decomposed-f32".clone(),
}

fn fixed_invocation(buffer_generation: i64) -> runtime_execution.TopologyInvocation =
runtime_execution.TopologyInvocation {
  graph_kind: ggml_ffi.GPU_GRAPH_PREFILL,
  buffer_generation: buffer_generation,
  kv_view_width: 2,
  query_width: 1,
  mask_layout_sha256: MASK_LAYOUT_DIGEST.clone(),
  position_layout_sha256: POSITION_LAYOUT_DIGEST.clone(),
  output_selection_sha256: PREFILL_OUTPUT_DIGEST.clone(),
}

fn expect_topology_key() -> Result<(), Error> {
  fixed := topology_key(
    "metal", TOPOLOGY_GOLDEN_BUNDLE, ggml_ffi.GPU_GRAPH_PREFILL, PREFILL_TENSOR_DIGEST, 2,
    1, PREFILL_OUTPUT_DIGEST,
  )?
  if fixed != TOPOLOGY_GOLDEN_KEY {
    return Err(Error.Invalid)
  }
  mut invalid_digest := fixed_identity(TOPOLOGY_GOLDEN_BUNDLE)
  invalid_digest.bundle_id =
  "Aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa".clone()
  invocation := fixed_invocation(1)
  match runtime_execution.topology_key(invalid_digest, invocation) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  identity := fixed_identity(TOPOLOGY_GOLDEN_BUNDLE)
  invalid_generation := fixed_invocation(0)
  return match runtime_execution.topology_key(identity, invalid_generation) {
    Ok(_) => Err(Error.Invalid),
    Err(_) => Ok(()),
  }
}

fn options(backend: str, device: str, bundle_root: str) -> runtime_options.RuntimeOptions =
runtime_options.RuntimeOptions {
  schema_version: 1,
  backend: backend.clone(),
  device: device.clone(),
  backend_bundle: bundle_root.clone(),
  placement: "resident".clone(),
  host_budget_bytes: 1048576,
  device_budget_bytes: 1048576,
  prefetch: "off".clone(),
}

fn opened(
  backend: str,
  device: str,
  bundle_root: str,
) -> Result<ggml_ffi.GpuDevice, Error> = match runtime_device.open(
  options(backend, device, bundle_root),
) {
  Ok(owner) => Ok(owner),
  Err(_) => Err(Error.Invalid),
}

fn admitted(borrow owner: ggml_ffi.GpuDevice) -> Result<(), Error> =
runtime_memory.admit(
  owner,
  runtime_memory.MemoryPlan {
    weights_bytes: 262144,
    kv_bytes: 262144,
    workspace_bytes: 524288,
    metadata_bytes: 262144,
    staging_bytes: 65536,
    legacy_cache_bytes: 720896,
  },
)

fn exercise_live_owner(
  backend: str,
  device: str,
  bundle_root: str,
  backend_path: str,
  bundle_id: str,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  if ggml_ffi.gpu_observation_state(owner, ggml_ffi.GPU_OBSERVATION_NODES) != 0
    || ggml_ffi.gpu_observation_state(owner, ggml_ffi.GPU_OBSERVATION_READ_BYTES) != 0
    || ggml_ffi.gpu_observation_state(owner, ggml_ffi.GPU_OBSERVATION_HOST_PEAK) != 0
    || ggml_ffi.gpu_observation_state(owner, ggml_ffi.GPU_OBSERVATION_DEVICE_PEAK) != 0
    || ggml_ffi.gpu_observation_state(owner, ggml_ffi.GPU_OBSERVATION_WEIGHT_PAYLOAD) != 0
    || ggml_ffi.gpu_observation_state(owner, ggml_ffi.GPU_OBSERVATION_KV_PAYLOAD) != 0 {
    return Err(Error.Invalid)
  }
  if ggml_ffi.gpu_device_handle(owner).is_null()
    || ggml_ffi.gpu_backend_handle(owner).is_null()
    || runtime_device.bundle_id(owner) != bundle_id
    || !ggml_ffi.gpu_device_staging_path_valid(owner) {
    return Err(Error.Invalid)
  }
  match ggml_ffi.gpu_device_synchronize(owner) {
    Ok(_) => {}
    Err(_) => { return Err(Error.Invalid) }
  }

  // The owner holds the process guard until Drop. A second open in this lexical lifetime must
  // refuse before it can inspect or mutate registry state.
  match ggml_ffi.gpu_device_open(
    backend, device, backend_path, bundle_id, 1048576, 1048576,
  ) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(fault) => {
      if fault.code != "BUSY" { return Err(Error.Invalid) }
    }
  }
  planned_weight := runtime_weights.Shape {
    ggml_type: 0,
    n_dims: 2,
    ne0: 256,
    ne1: 256,
    ne2: 1,
    ne3: 1,
  }
  if runtime_weights.allocation_bytes(owner, planned_weight)? != 262144 {
    return Err(Error.Invalid)
  }
  match runtime_weights.allocation_bytes(
    owner,
    runtime_weights.Shape {
      ggml_type: 0,
      n_dims: 1,
      ne0: 0,
      ne1: 1,
      ne2: 1,
      ne3: 1,
    },
  ) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  admitted(owner)?
  match runtime_weights.allocation_bytes(owner, planned_weight) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  if runtime_memory.bytes(owner, ggml_ffi.GPU_MEMORY_HOST_TOTAL) != 1048576
    || runtime_memory.bytes(owner, ggml_ffi.GPU_MEMORY_DEVICE_TOTAL) != 1048576
    || runtime_memory.bytes(owner, ggml_ffi.GPU_MEMORY_WEIGHTS) != 262144
    || runtime_memory.bytes(owner, ggml_ffi.GPU_MEMORY_KV) != 262144
    || runtime_memory.bytes(owner, ggml_ffi.GPU_MEMORY_WORKSPACE) != 524288
    || runtime_memory.bytes(owner, ggml_ffi.GPU_MEMORY_METADATA) != 262144
    || runtime_memory.bytes(owner, ggml_ffi.GPU_MEMORY_STAGING) != 65536
    || runtime_memory.bytes(owner, ggml_ffi.GPU_MEMORY_LEGACY_CACHE) != 720896 {
    return Err(Error.Invalid)
  }
  match ggml_ffi.gpu_memory_admit(owner, 1, 1, 1, 1, 1, 0) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(fault) => {
      if fault.code != "CONFIG" { return Err(Error.Invalid) }
    }
  }
  runtime_memory.allocate(owner)?
  if runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_HOST_TOTAL) != 327680
    || runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_DEVICE_TOTAL) != 524288
    || runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_WEIGHTS) != 262144
    || runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_KV) != 262144
    || runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_WORKSPACE) != 0
    || runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_METADATA) != 262144
    || runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_STAGING) != 65536
    || runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_LEGACY_CACHE) != 0
    || ggml_ffi.gpu_observation_state(owner, ggml_ffi.GPU_OBSERVATION_HOST_PEAK) != 327680
    || ggml_ffi.gpu_observation_state(owner, ggml_ffi.GPU_OBSERVATION_DEVICE_PEAK) != 524288 {
    return Err(Error.Invalid)
  }
  match ggml_ffi.gpu_memory_allocate(owner) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(fault) => {
      if fault.code != "CONFIG" { return Err(Error.Invalid) }
    }
  }
  if runtime_weights.metadata_bytes(1) <= 0
    || runtime_weights.metadata_bytes(1) > 262144 {
    return Err(Error.Invalid)
  }
  runtime_weights.begin(owner, 1)?
  match runtime_weights.add(
    owner,
    runtime_weights.Shape {
      ggml_type: 0,
      n_dims: 1,
      ne0: 0,
      ne1: 1,
      ne2: 1,
      ne3: 1,
    },
  ) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  index := runtime_weights.add(
    owner,
    runtime_weights.Shape {
      ggml_type: 0,
      n_dims: 2,
      ne0: 256,
      ne1: 256,
      ne2: 1,
      ne3: 1,
    },
  )?
  if index != 0 { return Err(Error.Invalid) }
  match runtime_weights.add(
    owner,
    runtime_weights.Shape {
      ggml_type: 0,
      n_dims: 1,
      ne0: 1,
      ne1: 1,
      ne2: 1,
      ne3: 1,
    },
  ) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  empty := buffer(0)
  empty_view := empty.bytes()
  match runtime_weights.upload(owner, index, 0, empty_view) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  mut weight_data := buffer(262144)
  mut weight_row := 0
  loop {
    if weight_row >= 256 { break }
    mut weight_column := 0
    loop {
      if weight_column >= 256 { break }
      weight_data.put_u32_le(if weight_row == weight_column { 1065353216 } else { 0 })
      weight_column = weight_column + 1
    }
    weight_row = weight_row + 1
  }
  weight_view := weight_data.bytes()
  first_byte := weight_view[0..1]
  match runtime_weights.upload(owner, index, 1, first_byte) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  match runtime_weights.upload(owner, index, 0, weight_view) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  mut weight_offset := 0
  loop {
    if weight_offset >= weight_view.len() { break }
    next := weight_offset + 65536
    chunk := weight_view[weight_offset..next]
    runtime_weights.upload(owner, index, weight_offset, chunk)?
    if weight_offset == 0 {
      match runtime_weights.add(owner, planned_weight) {
        Ok(_) => { return Err(Error.Invalid) }
        Err(_) => {}
      }
      match runtime_weights.finish(owner) {
        Ok(_) => { return Err(Error.Invalid) }
        Err(_) => {}
      }
    }
    weight_offset = next
  }
  if runtime_weights.state(owner, ggml_ffi.GPU_WEIGHT_EXPECTED) != 1
    || runtime_weights.state(owner, ggml_ffi.GPU_WEIGHT_CREATED) != 1
    || runtime_weights.state(owner, ggml_ffi.GPU_WEIGHT_UPLOADED) != 1
    || runtime_weights.state(owner, ggml_ffi.GPU_WEIGHT_UPLOADED_BYTES) != 262144
    || runtime_weights.state(owner, ggml_ffi.GPU_WEIGHT_FINISHED) != 0 {
    return Err(Error.Invalid)
  }
  runtime_weights.finish(owner)?
  if runtime_weights.state(owner, ggml_ffi.GPU_WEIGHT_FINISHED) != 1
    || ggml_ffi.gpu_observation_state(owner, ggml_ffi.GPU_OBSERVATION_WEIGHT_PAYLOAD) != 262144
    || ggml_ffi.gpu_observation_state(owner, ggml_ffi.GPU_OBSERVATION_KV_PAYLOAD) != 0 {
    return Err(Error.Invalid)
  }
  match runtime_weights.finish(owner) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  runtime_kv.begin(owner, 1)?
  match runtime_kv.add(
    owner,
    runtime_kv.Shape {
      ggml_type: 0,
      n_dims: 2,
      ne0: 0,
      ne1: 256,
      ne2: 1,
      ne3: 1,
    },
  ) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  kv_index := runtime_kv.add(
    owner,
    runtime_kv.Shape {
      ggml_type: 0,
      n_dims: 3,
      ne0: 256,
      ne1: 128,
      ne2: 2,
      ne3: 1,
    },
  )?
  if kv_index != 0 { return Err(Error.Invalid) }
  runtime_kv.finish(owner)?
  if ggml_ffi.gpu_observation_state(owner, ggml_ffi.GPU_OBSERVATION_KV_PAYLOAD) != 262144 {
    return Err(Error.Invalid)
  }
  mut kv_data := buffer(1024)
  mut kv_at := 0
  loop {
    if kv_at >= 256 { break }
    kv_data.put_u32_le(1065353216)
    kv_at = kv_at + 1
  }
  kv_view := kv_data.bytes()
  runtime_kv.update(owner, kv_index, 0, kv_view)?
  mut kv_prefix_twos := buffer(1024)
  mut kv_prefix_two_at := 0
  loop {
    if kv_prefix_two_at >= 256 { break }
    kv_prefix_twos.put_u32_le(1073741824)
    kv_prefix_two_at = kv_prefix_two_at + 1
  }
  kv_prefix_twos_view := kv_prefix_twos.bytes()
  runtime_kv.update(owner, kv_index, 1024, kv_prefix_twos_view)?
  mut kv_second_head_threes := buffer(1024)
  mut kv_second_head_three_at := 0
  loop {
    if kv_second_head_three_at >= 256 { break }
    kv_second_head_threes.put_u32_le(1077936128)
    kv_second_head_three_at = kv_second_head_three_at + 1
  }
  kv_second_head_threes_view := kv_second_head_threes.bytes()
  runtime_kv.update(owner, kv_index, 131072, kv_second_head_threes_view)?
  mut kv_second_head_fours := buffer(1024)
  mut kv_second_head_four_at := 0
  loop {
    if kv_second_head_four_at >= 256 { break }
    kv_second_head_fours.put_u32_le(1082130432)
    kv_second_head_four_at = kv_second_head_four_at + 1
  }
  kv_second_head_fours_view := kv_second_head_fours.bytes()
  runtime_kv.update(owner, kv_index, 132096, kv_second_head_fours_view)?
  runtime_kv.update(owner, kv_index, 261120, kv_view)?
  match runtime_kv.update(owner, kv_index, 261121, kv_view) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  if runtime_kv.state(owner, ggml_ffi.GPU_KV_EXPECTED) != 1
    || runtime_kv.state(owner, ggml_ffi.GPU_KV_CREATED) != 1
    || runtime_kv.state(owner, ggml_ffi.GPU_KV_UPDATED_BYTES) != 5120
    || runtime_kv.state(owner, ggml_ffi.GPU_KV_FINISHED) != 1 {
    return Err(Error.Invalid)
  }
  match runtime_kv.finish(owner) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  runtime_inputs.begin(owner, 4)?
  input_index := runtime_inputs.add(
    owner,
    runtime_inputs.Shape {
      ggml_type: 26,
      n_dims: 1,
      ne0: 1,
      ne1: 1,
      ne2: 1,
      ne3: 1,
    },
  )?
  if input_index != 0 { return Err(Error.Invalid) }
  query_index := runtime_inputs.add(
    owner,
    runtime_inputs.Shape {
      ggml_type: 0,
      n_dims: 3,
      ne0: 256,
      ne1: 1,
      ne2: 2,
      ne3: 1,
    },
  )?
  mask_index := runtime_inputs.add(
    owner,
    runtime_inputs.Shape {
      ggml_type: 0,
      n_dims: 2,
      ne0: 256,
      ne1: 1,
      ne2: 1,
      ne3: 1,
    },
  )?
  kv_write_index := runtime_inputs.add(
    owner,
    runtime_inputs.Shape {
      ggml_type: 0,
      n_dims: 3,
      ne0: 256,
      ne1: 2,
      ne2: 2,
      ne3: 1,
    },
  )?
  if query_index != 1 || mask_index != 2 || kv_write_index != 3 {
    return Err(Error.Invalid)
  }
  runtime_inputs.finish(owner)?
  mut early_input := buffer(4)
  early_input.put_u32_le(7)
  early_input_view := early_input.bytes()
  match runtime_inputs.update(owner, input_index, 0, early_input_view) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_PREFILL, 98304)
  if ggml_ffi.handle_absent(ctx) { return Err(Error.Invalid) }
  if !ggml_ffi.handle_absent(
    ggml_ffi.gpu_graph_context_open(owner, ggml_ffi.GPU_GRAPH_PREFILL, 98304)) {
    return Err(Error.Invalid)
  }
  if !ggml_ffi.handle_absent(
    ggml_ffi.gpu_graph_context_open(owner, ggml_ffi.GPU_GRAPH_DECODE, 262144)) {
    return Err(Error.Invalid)
  }
  decode_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_DECODE, 98304)
  if ggml_ffi.handle_absent(decode_ctx) { return Err(Error.Invalid) }
  prefill_topology_key := topology_key(
    backend, bundle_id, ggml_ffi.GPU_GRAPH_PREFILL, PREFILL_TENSOR_DIGEST, 2,
    1, PREFILL_OUTPUT_DIGEST,
  )?
  repeated_prefill_topology_key := topology_key(
    backend, bundle_id, ggml_ffi.GPU_GRAPH_PREFILL, PREFILL_TENSOR_DIGEST, 2,
    1, PREFILL_OUTPUT_DIGEST,
  )?
  decode_topology_key := topology_key(
    backend, bundle_id, ggml_ffi.GPU_GRAPH_DECODE, DECODE_TENSOR_DIGEST, 1,
    1, DECODE_OUTPUT_DIGEST,
  )?
  rebuilt_topology_key := topology_key(
    backend, bundle_id, ggml_ffi.GPU_GRAPH_PREFILL, REBUILT_TENSOR_DIGEST, 1,
    1, REBUILT_OUTPUT_DIGEST,
  )?
  if prefill_topology_key.len() != 64 || prefill_topology_key != repeated_prefill_topology_key
    || decode_topology_key.len() != 64
    || rebuilt_topology_key.len() != 64 || prefill_topology_key == decode_topology_key
    || prefill_topology_key == rebuilt_topology_key
    || decode_topology_key == rebuilt_topology_key {
    return Err(Error.Invalid)
  }
  mut slot_storage := buffer(256)
  mut slot_word := 0
  loop {
    if slot_word >= 64 { break }
    slot_storage.put_u32_le(0)
    slot_word = slot_word + 1
  }
  slots := slot_storage.bytes()
  ggml_ffi.slots_init(slots, slots.len(), "gpu_graph_slots") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_weight_slot(owner, 0, slots, 0) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_kv_slot(owner, 0, slots, 1) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_input_slot(owner, 0, slots, 2) else {
    return Err(Error.Invalid)
  }
  match runtime_kv.prefix_slot(
    owner, 0, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_KV_LAYOUT_K, 0, slots, 4,
  ) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  match runtime_kv.prefix_slot(
    owner, 0, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_KV_LAYOUT_K, 129, slots, 4,
  ) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  runtime_kv.prefix_slot(
    owner, 0, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_KV_LAYOUT_K, 2, slots, 4,
  )?
  ggml_ffi.gpu_input_slot(owner, query_index, slots, 5) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_input_slot(owner, kv_write_index, slots, 14) else {
    return Err(Error.Invalid)
  }
  match runtime_kv.write_slot(
    owner, 0, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_KV_LAYOUT_K, -1, slots, 15, 14,
  ) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  match runtime_kv.write_slot(
    owner, 0, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_KV_LAYOUT_K, 127, slots, 15, 14,
  ) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  match runtime_kv.write_slot(
    owner, 0, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_KV_LAYOUT_K, 2, slots, 15, 2,
  ) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  runtime_kv.write_slot(
    owner, 0, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_KV_LAYOUT_K, 2, slots, 15, 14,
  )?
  runtime_kv.prefix_slot(
    owner, 0, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_KV_LAYOUT_K, 4, slots, 16,
  )?
  match runtime_inputs.mask_prefix_slot(
    owner, mask_index, ggml_ffi.GPU_GRAPH_PREFILL, 0, 1, slots, 7,
  ) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
