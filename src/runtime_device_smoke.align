  input_readback.put_u32_le(0)
  input_readback_view := input_readback.bytes()
  ggml_ffi.slot_get(slots, 2, input_readback_view, 0, 4, "gpu_graph_input") else {
    return Err(Error.Invalid)
  }
  if output_view.u32_le(0) != 1065353216
    || output_view.u32_le(261120) != 1073741824
    || second_attention_view.u32_le(0) != 1073741824
    || second_attention_view.u32_le(1020) != 1073741824
    || second_attention_view.u32_le(1024) != 1082130432
    || second_attention_view.u32_le(2044) != 1082130432
    || second_kv_attention_view.u32_le(0) != 1132462080
    || second_kv_attention_view.u32_le(4) != 1140850688
    || second_kv_attention_view.u32_le(8) != 1158676480
    || second_kv_attention_view.u32_le(12) != 1159725056
    || second_kv_attention_view.u32_le(16) != 1145044992
    || second_kv_attention_view.u32_le(20) != 1149239296
    || second_kv_attention_view.u32_le(24) != 1160773632
    || second_kv_attention_view.u32_le(28) != 1161822208
    || input_readback_view.u32_le(0) != 8
    || runtime_kv.state(owner, ggml_ffi.GPU_KV_UPDATED_BYTES) != 6144
    || runtime_inputs.state(owner, ggml_ffi.GPU_INPUT_UPDATED_BYTES) != 10264
    || runtime_execution.state(
    owner, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_GRAPH_PREPARED) != 1
    || runtime_execution.state(
    owner, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_GRAPH_EXECUTIONS) != 2
    || runtime_execution.state(
    owner, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_GRAPH_REUSES) != 1
    || runtime_execution.state(
    owner, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_GRAPH_INVALIDATIONS) != 0
    || runtime_execution.state(
    owner, ggml_ffi.GPU_GRAPH_DECODE, ggml_ffi.GPU_GRAPH_PREPARED) != 1
    || runtime_execution.state(
    owner, ggml_ffi.GPU_GRAPH_DECODE, ggml_ffi.GPU_GRAPH_EXECUTIONS) != 0 {
    return Err(Error.Invalid)
  }
  runtime_execution.compute(
    owner, ggml_ffi.GPU_GRAPH_DECODE, decode_topology_key, decode_graph,
  )?
  match ggml_ffi.gpu_device_synchronize(owner) {
    Ok(_) => {}
    Err(_) => { return Err(Error.Invalid) }
  }
  mut decode_output := buffer(2048)
  mut decode_output_at := 0
  loop {
    if decode_output_at >= 512 { break }
    decode_output.put_u32_le(4294967295)
    decode_output_at = decode_output_at + 1
  }
  decode_output_view := decode_output.bytes()
  ggml_ffi.slot_get(
    slots, 13, decode_output_view, 0, decode_output_view.len(), "gpu_decode_first",
  ) else {
    return Err(Error.Invalid)
  }
  if decode_output_view.u32_le(0) != 1065353216
    || decode_output_view.u32_le(2044) != 1065353216 {
    return Err(Error.Invalid)
  }
  workspace_before_rebuild := runtime_memory.allocated_bytes(
    owner, ggml_ffi.GPU_MEMORY_WORKSPACE,
  )
  runtime_execution.invalidate(owner, ggml_ffi.GPU_GRAPH_PREFILL)?
  if runtime_execution.state(
    owner, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_GRAPH_INVALIDATIONS) != 1
    || runtime_execution.state(
    owner, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_GRAPH_PREPARED) != 1 {
    return Err(Error.Invalid)
  }
  ggml_ffi.slots_init(slots, slots.len(), "gpu_rebuilt_graph_slots") else {
    return Err(Error.Invalid)
  }
  runtime_kv.prefix_slot(owner, 0, ggml_ffi.GPU_GRAPH_PREFILL, 1, slots, 0)?
  ggml_ffi.gpu_input_slot(owner, query_index, slots, 1) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.op_mul_mat(ctx, slots, 2, 0, 1, "gpu_rebuilt_attention_scores") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.slot_mark_output(slots, 2, "gpu_rebuilt_attention_scores") else {
    return Err(Error.Invalid)
  }
  rebuilt_graph := ggml_ffi.graph_new(ctx)
  if rebuilt_graph.is_null() { return Err(Error.Invalid) }
  ggml_ffi.graph_expand(rebuilt_graph, slots, 2, "gpu_rebuilt_attention_expand") else {
    return Err(Error.Invalid)
  }
  match runtime_execution.prepare(
    owner, ggml_ffi.GPU_GRAPH_PREFILL, "short", rebuilt_graph,
  ) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  runtime_execution.prepare(
    owner, ggml_ffi.GPU_GRAPH_PREFILL, rebuilt_topology_key, rebuilt_graph,
  )?
  workspace_after_rebuild := runtime_memory.allocated_bytes(
    owner, ggml_ffi.GPU_MEMORY_WORKSPACE,
  )
  if workspace_after_rebuild <= 3104 || workspace_after_rebuild > workspace_before_rebuild {
    return Err(Error.Invalid)
  }
  match ggml_ffi.gpu_graph_compute(
    owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_topology_key, rebuilt_graph,
  ) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(fault) => {
      if fault.code != "CONFIG" { return Err(Error.Invalid) }
    }
  }
  runtime_execution.compute(
    owner, ggml_ffi.GPU_GRAPH_PREFILL, rebuilt_topology_key, rebuilt_graph,
  )?
  match ggml_ffi.gpu_device_synchronize(owner) {
    Ok(_) => {}
    Err(_) => { return Err(Error.Invalid) }
  }
  mut rebuilt_output := buffer(8)
  rebuilt_output.put_u32_le(4294967295)
  rebuilt_output.put_u32_le(4294967295)
  rebuilt_output_view := rebuilt_output.bytes()
  ggml_ffi.slot_get(
    slots, 2, rebuilt_output_view, 0, rebuilt_output_view.len(), "gpu_rebuilt_output",
  ) else {
    return Err(Error.Invalid)
  }
  if rebuilt_output_view.u32_le(0) != 1132462080
    || rebuilt_output_view.u32_le(4) != 1145044992 {
    return Err(Error.Invalid)
  }
  runtime_execution.compute(
    owner, ggml_ffi.GPU_GRAPH_DECODE, decode_topology_key, decode_graph,
  )?
  if runtime_execution.state(
    owner, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_GRAPH_PREPARED) != 2
    || runtime_execution.state(
    owner, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_GRAPH_EXECUTIONS) != 3
    || runtime_execution.state(
    owner, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_GRAPH_REUSES) != 1
    || runtime_execution.state(
    owner, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_GRAPH_INVALIDATIONS) != 1
    || runtime_execution.state(
    owner, ggml_ffi.GPU_GRAPH_DECODE, ggml_ffi.GPU_GRAPH_PREPARED) != 1
    || runtime_execution.state(
    owner, ggml_ffi.GPU_GRAPH_DECODE, ggml_ffi.GPU_GRAPH_EXECUTIONS) != 2
    || runtime_execution.state(
    owner, ggml_ffi.GPU_GRAPH_DECODE, ggml_ffi.GPU_GRAPH_REUSES) != 1
    || runtime_execution.state(
    owner, ggml_ffi.GPU_GRAPH_DECODE, ggml_ffi.GPU_GRAPH_INVALIDATIONS) != 0 {
    return Err(Error.Invalid)
  }
  return Ok(())
}

fn expect_allocation_failure(
  backend: str,
  device: str,
  bundle_root: str,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  admitted(owner)?
  return match ggml_ffi.gpu_memory_allocate(owner) {
    Ok(_) => Err(Error.Invalid),
    Err(fault) => if fault.code == "ALLOCATION" { Ok(()) } else { Err(Error.Invalid) },
  }
}

fn expect_reopen_after_failure(
  backend: str,
  device: str,
  bundle_root: str,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  return match ggml_ffi.gpu_device_synchronize(owner) {
    Ok(_) => Ok(()),
    Err(_) => Err(Error.Invalid),
  }
}

fn expect_weight_allocation_failure(
  backend: str,
  device: str,
  bundle_root: str,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  runtime_memory.admit(
    owner,
    runtime_memory.MemoryPlan {
      weights_bytes: 1,
      kv_bytes: 1,
      workspace_bytes: 1,
      metadata_bytes: 4096,
      staging_bytes: 1,
      legacy_cache_bytes: 0,
    },
  )?
  runtime_memory.allocate(owner)?
  runtime_weights.begin(owner, 1)?
  return match ggml_ffi.gpu_weight_add(owner, 0, 1, 1, 1, 1, 1) {
    Ok(_) => Err(Error.Invalid),
    Err(fault) => if fault.code == "ALLOCATION" { Ok(()) } else { Err(Error.Invalid) },
  }
}

fn expect_memory_budget_refusal(
  backend: str,
  device: str,
  bundle_root: str,
  weights_bytes: i64,
  kv_bytes: i64,
  workspace_bytes: i64,
  metadata_bytes: i64,
  staging_bytes: i64,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  return match ggml_ffi.gpu_memory_admit(
    owner, weights_bytes, kv_bytes, workspace_bytes, metadata_bytes, staging_bytes, 0,
  ) {
    Ok(_) => Err(Error.Invalid),
    Err(fault) => if fault.code == "MEMORY_BUDGET" { Ok(()) } else { Err(Error.Invalid) },
  }
}

fn expect_input_allocation_failure(
  backend: str,
  device: str,
  bundle_root: str,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  runtime_memory.admit(
    owner,
    runtime_memory.MemoryPlan {
      weights_bytes: 32,
      kv_bytes: 32,
      workspace_bytes: 64,
      metadata_bytes: 4096,
      staging_bytes: 4,
      legacy_cache_bytes: 0,
    },
  )?
  runtime_memory.allocate(owner)?
  runtime_weights.begin(owner, 1)?
  weight := runtime_weights.add(
    owner,
    runtime_weights.Shape {
      ggml_type: 0,
      n_dims: 1,
      ne0: 1,
      ne1: 1,
      ne2: 1,
      ne3: 1,
    },
  )?
  mut scalar := buffer(4)
  scalar.put_u32_le(1065353216)
  scalar_view := scalar.bytes()
  runtime_weights.upload(owner, weight, scalar_view)?
  runtime_weights.finish(owner)?
  runtime_kv.begin(owner, 1)?
  runtime_kv.add(
    owner,
    runtime_kv.Shape {
      ggml_type: 0,
      n_dims: 1,
      ne0: 1,
      ne1: 1,
      ne2: 1,
      ne3: 1,
    },
  )?
  runtime_kv.finish(owner)?
  runtime_inputs.begin(owner, 1)?
  runtime_inputs.add(
    owner,
    runtime_inputs.Shape {
      ggml_type: 26,
      n_dims: 1,
      ne0: 1,
      ne1: 1,
      ne2: 1,
      ne3: 1,
    },
  )?
  return match ggml_ffi.gpu_inputs_finish(owner) {
    Ok(_) => Err(Error.Invalid),
    Err(fault) => if fault.code == "ALLOCATION" { Ok(()) } else { Err(Error.Invalid) },
  }
}

fn expect_unavailable(
  backend: str,
  device: str,
  bundle_root: str,
) -> Result<(), Error> = match runtime_device.open(
  options(backend, device, bundle_root),
) {
  Ok(_) => Err(Error.Invalid),
  Err(_) => Ok(()),
}

fn expect_verification_refusal(
  backend: str,
  device: str,
  bundle_root: str,
) -> Result<(), Error> = match runtime_device.open(options(backend, device, bundle_root)) {
  Ok(_) => Err(Error.Invalid),
  Err(_) => Ok(()),
}

fn expect_bundle_switch(
  backend: str,
  device: str,
  backend_path: str,
  bundle_id: str,
) -> Result<(), Error> = match ggml_ffi.gpu_device_open(
  backend, device, backend_path, bundle_id, 1048576, 1048576,
) {
  Ok(_) => Err(Error.Invalid),
  Err(fault) => if fault.code == "BUNDLE_IDENTITY" { Ok(()) } else { Err(Error.Invalid) },
}

pub fn main(args: array<str>) -> Result<(), Error> {
  if args.len() != 9 { return Err(Error.Invalid) }
  expect_topology_key()?
  mode := args[1]
  backend := args[2]
  device := args[3]
  bundle_root := args[4]
  invalid_bundle_root := args[5]
  other_bundle_root := args[6]
  backend_path := args[7]
  bundle_id := args[8]

  if mode == "unavailable" {
    expect_unavailable(backend, device, bundle_root)?
    print("runtime device smoke: UNAVAILABLE PASS")
    return Ok(())
  }
  if mode == "allocation-failure" {
    expect_allocation_failure(backend, device, bundle_root)?
    expect_reopen_after_failure(backend, device, bundle_root)?
    print("runtime device smoke: ALLOCATION FAILURE PASS")
    return Ok(())
  }
  if mode == "input-allocation-failure" {
    expect_input_allocation_failure(backend, device, bundle_root)?
    expect_reopen_after_failure(backend, device, bundle_root)?
    print("runtime device smoke: INPUT ALLOCATION FAILURE PASS")
    return Ok(())
  }
  if mode != "available" { return Err(Error.Invalid) }

  // Returning from the helper drops the first owner. Reopening the same pinned bundle proves the
  // guard was released on that ordinary return path; returning again covers a second lifetime.
  expect_verification_refusal(backend, device, invalid_bundle_root)?
  expect_memory_budget_refusal(backend, device, bundle_root, 524289, 262144, 262144, 1, 1)?
  expect_memory_budget_refusal(backend, device, bundle_root, 1, 1, 1, 1, 1048576)?
  expect_memory_budget_refusal(backend, device, bundle_root, 1, 1, 1, 9223372036854775807, 1)?
  expect_memory_budget_refusal(backend, device, bundle_root, 9223372036854775807, 1, 1, 1, 1)?
  expect_weight_allocation_failure(backend, device, bundle_root)?
  exercise_live_owner(backend, device, bundle_root, backend_path, bundle_id)?
  exercise_live_owner(backend, device, bundle_root, backend_path, bundle_id)?

  expect_verification_refusal(backend, device, other_bundle_root)?
  expect_bundle_switch(
    backend,
    device,
    backend_path,
    "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
  )?
  print("runtime device smoke: AVAILABLE PASS")
  return Ok(())
}
