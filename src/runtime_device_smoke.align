module runtime_device_smoke

import ggml_ffi
import runtime_device
import runtime_execution
import runtime_inputs
import runtime_kv
import runtime_memory
import runtime_options
import runtime_weights

fn options(backend: str, device: str, bundle_root: str) -> runtime_options.RuntimeOptions =
runtime_options.RuntimeOptions {
  schema_version: 1,
  backend: backend.clone(),
  device: device.clone(),
  backend_bundle: bundle_root.clone(),
  placement: "resident".clone(),
  host_budget_bytes: 1048576,
  device_budget_bytes: 1048576,
  prefetch: "off".clone(),
}

fn opened(
  backend: str,
  device: str,
  bundle_root: str,
) -> Result<ggml_ffi.GpuDevice, Error> = match runtime_device.open(
  options(backend, device, bundle_root),
) {
  Ok(owner) => Ok(owner),
  Err(_) => Err(Error.Invalid),
}

fn admitted(borrow owner: ggml_ffi.GpuDevice) -> Result<(), Error> =
runtime_memory.admit(
  owner,
  runtime_memory.MemoryPlan {
    weights_bytes: 262144,
    kv_bytes: 262144,
    workspace_bytes: 524288,
    metadata_bytes: 262144,
    staging_bytes: 65536,
    legacy_cache_bytes: 720896,
  },
)

fn exercise_live_owner(
  backend: str,
  device: str,
  bundle_root: str,
  backend_path: str,
  bundle_id: str,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  if ggml_ffi.gpu_device_handle(owner).is_null()
    || ggml_ffi.gpu_backend_handle(owner).is_null() {
    return Err(Error.Invalid)
  }
  match ggml_ffi.gpu_device_synchronize(owner) {
    Ok(_) => {}
    Err(_) => { return Err(Error.Invalid) }
  }

  // The owner holds the process guard until Drop. A second open in this lexical lifetime must
  // refuse before it can inspect or mutate registry state.
  match ggml_ffi.gpu_device_open(
    backend, device, backend_path, bundle_id, 1048576, 1048576,
  ) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(fault) => {
      if fault.code != "BUSY" { return Err(Error.Invalid) }
    }
  }
  admitted(owner)?
  if runtime_memory.bytes(owner, ggml_ffi.GPU_MEMORY_HOST_TOTAL) != 1048576
    || runtime_memory.bytes(owner, ggml_ffi.GPU_MEMORY_DEVICE_TOTAL) != 1048576
    || runtime_memory.bytes(owner, ggml_ffi.GPU_MEMORY_WEIGHTS) != 262144
    || runtime_memory.bytes(owner, ggml_ffi.GPU_MEMORY_KV) != 262144
    || runtime_memory.bytes(owner, ggml_ffi.GPU_MEMORY_WORKSPACE) != 524288
    || runtime_memory.bytes(owner, ggml_ffi.GPU_MEMORY_METADATA) != 262144
    || runtime_memory.bytes(owner, ggml_ffi.GPU_MEMORY_STAGING) != 65536
    || runtime_memory.bytes(owner, ggml_ffi.GPU_MEMORY_LEGACY_CACHE) != 720896 {
    return Err(Error.Invalid)
  }
  match ggml_ffi.gpu_memory_admit(owner, 1, 1, 1, 1, 1, 0) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(fault) => {
      if fault.code != "CONFIG" { return Err(Error.Invalid) }
    }
  }
  runtime_memory.allocate(owner)?
  if runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_HOST_TOTAL) != 327680
    || runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_DEVICE_TOTAL) != 1048576
    || runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_WEIGHTS) != 262144
    || runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_KV) != 262144
    || runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_WORKSPACE) != 524288
    || runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_METADATA) != 262144
    || runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_STAGING) != 65536
    || runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_LEGACY_CACHE) != 0 {
    return Err(Error.Invalid)
  }
  match ggml_ffi.gpu_memory_allocate(owner) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(fault) => {
      if fault.code != "CONFIG" { return Err(Error.Invalid) }
    }
  }
  if runtime_weights.metadata_bytes(1) <= 0
    || runtime_weights.metadata_bytes(1) > 262144 {
    return Err(Error.Invalid)
  }
  runtime_weights.begin(owner, 1)?
  match runtime_weights.add(
    owner,
    runtime_weights.Shape {
      ggml_type: 0,
      n_dims: 1,
      ne0: 0,
      ne1: 1,
      ne2: 1,
      ne3: 1,
    },
  ) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  index := runtime_weights.add(
    owner,
    runtime_weights.Shape {
      ggml_type: 0,
      n_dims: 2,
      ne0: 256,
      ne1: 256,
      ne2: 1,
      ne3: 1,
    },
  )?
  if index != 0 { return Err(Error.Invalid) }
  match runtime_weights.add(
    owner,
    runtime_weights.Shape {
      ggml_type: 0,
      n_dims: 1,
      ne0: 1,
      ne1: 1,
      ne2: 1,
      ne3: 1,
    },
  ) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  short := buffer(1)
  short_view := short.bytes()
  match runtime_weights.upload(owner, index, short_view) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  mut weight_data := buffer(262144)
  mut weight_row := 0
  loop {
    if weight_row >= 256 { break }
    mut weight_column := 0
    loop {
      if weight_column >= 256 { break }
      weight_data.put_u32_le(if weight_row == weight_column { 1065353216 } else { 0 })
      weight_column = weight_column + 1
    }
    weight_row = weight_row + 1
  }
  weight_view := weight_data.bytes()
  runtime_weights.upload(owner, index, weight_view)?
  if runtime_weights.state(owner, ggml_ffi.GPU_WEIGHT_EXPECTED) != 1
    || runtime_weights.state(owner, ggml_ffi.GPU_WEIGHT_CREATED) != 1
    || runtime_weights.state(owner, ggml_ffi.GPU_WEIGHT_UPLOADED) != 1
    || runtime_weights.state(owner, ggml_ffi.GPU_WEIGHT_UPLOADED_BYTES) != 262144
    || runtime_weights.state(owner, ggml_ffi.GPU_WEIGHT_FINISHED) != 0 {
    return Err(Error.Invalid)
  }
  runtime_weights.finish(owner)?
  if runtime_weights.state(owner, ggml_ffi.GPU_WEIGHT_FINISHED) != 1 {
    return Err(Error.Invalid)
  }
  match runtime_weights.finish(owner) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  runtime_kv.begin(owner, 1)?
  match runtime_kv.add(
    owner,
    runtime_kv.Shape {
      ggml_type: 0,
      n_dims: 2,
      ne0: 0,
      ne1: 256,
      ne2: 1,
      ne3: 1,
    },
  ) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  kv_index := runtime_kv.add(
    owner,
    runtime_kv.Shape {
      ggml_type: 0,
      n_dims: 3,
      ne0: 256,
      ne1: 128,
      ne2: 2,
      ne3: 1,
    },
  )?
  if kv_index != 0 { return Err(Error.Invalid) }
  runtime_kv.finish(owner)?
  mut kv_data := buffer(1024)
  mut kv_at := 0
  loop {
    if kv_at >= 256 { break }
    kv_data.put_u32_le(1065353216)
    kv_at = kv_at + 1
  }
  kv_view := kv_data.bytes()
  runtime_kv.update(owner, kv_index, 0, kv_view)?
  mut kv_prefix_twos := buffer(1024)
  mut kv_prefix_two_at := 0
  loop {
    if kv_prefix_two_at >= 256 { break }
    kv_prefix_twos.put_u32_le(1073741824)
    kv_prefix_two_at = kv_prefix_two_at + 1
  }
  kv_prefix_twos_view := kv_prefix_twos.bytes()
  runtime_kv.update(owner, kv_index, 1024, kv_prefix_twos_view)?
  mut kv_second_head_threes := buffer(1024)
  mut kv_second_head_three_at := 0
  loop {
    if kv_second_head_three_at >= 256 { break }
    kv_second_head_threes.put_u32_le(1077936128)
    kv_second_head_three_at = kv_second_head_three_at + 1
  }
  kv_second_head_threes_view := kv_second_head_threes.bytes()
  runtime_kv.update(owner, kv_index, 131072, kv_second_head_threes_view)?
  mut kv_second_head_fours := buffer(1024)
  mut kv_second_head_four_at := 0
  loop {
    if kv_second_head_four_at >= 256 { break }
    kv_second_head_fours.put_u32_le(1082130432)
    kv_second_head_four_at = kv_second_head_four_at + 1
  }
  kv_second_head_fours_view := kv_second_head_fours.bytes()
  runtime_kv.update(owner, kv_index, 132096, kv_second_head_fours_view)?
  runtime_kv.update(owner, kv_index, 261120, kv_view)?
  match runtime_kv.update(owner, kv_index, 261121, kv_view) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  if runtime_kv.state(owner, ggml_ffi.GPU_KV_EXPECTED) != 1
    || runtime_kv.state(owner, ggml_ffi.GPU_KV_CREATED) != 1
    || runtime_kv.state(owner, ggml_ffi.GPU_KV_UPDATED_BYTES) != 5120
    || runtime_kv.state(owner, ggml_ffi.GPU_KV_FINISHED) != 1 {
    return Err(Error.Invalid)
  }
  match runtime_kv.finish(owner) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  runtime_inputs.begin(owner, 3)?
  input_index := runtime_inputs.add(
    owner,
    runtime_inputs.Shape {
      ggml_type: 26,
      n_dims: 1,
      ne0: 1,
      ne1: 1,
      ne2: 1,
      ne3: 1,
    },
  )?
  if input_index != 0 { return Err(Error.Invalid) }
  query_index := runtime_inputs.add(
    owner,
    runtime_inputs.Shape {
      ggml_type: 0,
      n_dims: 3,
      ne0: 256,
      ne1: 1,
      ne2: 2,
      ne3: 1,
    },
  )?
  mask_index := runtime_inputs.add(
    owner,
    runtime_inputs.Shape {
      ggml_type: 0,
      n_dims: 2,
      ne0: 256,
      ne1: 1,
      ne2: 1,
      ne3: 1,
    },
  )?
  if query_index != 1 || mask_index != 2 { return Err(Error.Invalid) }
  runtime_inputs.finish(owner)?
  mut early_input := buffer(4)
  early_input.put_u32_le(7)
  early_input_view := early_input.bytes()
  match runtime_inputs.update(owner, input_index, 0, early_input_view) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  ctx := ggml_ffi.gpu_metadata_handle(owner)
  if ctx.is_null() { return Err(Error.Invalid) }
  mut slot_storage := buffer(256)
  mut slot_word := 0
  loop {
    if slot_word >= 64 { break }
    slot_storage.put_u32_le(0)
    slot_word = slot_word + 1
  }
  slots := slot_storage.bytes()
  ggml_ffi.slots_init(slots, slots.len(), "gpu_graph_slots") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_weight_slot(owner, 0, slots, 0) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_kv_slot(owner, 0, slots, 1) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_input_slot(owner, 0, slots, 2) else {
    return Err(Error.Invalid)
  }
  match runtime_kv.prefix_slot(owner, 0, 0, slots, 4) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  match runtime_kv.prefix_slot(owner, 0, 129, slots, 4) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  runtime_kv.prefix_slot(owner, 0, 2, slots, 4)?
  ggml_ffi.gpu_input_slot(owner, query_index, slots, 5) else {
    return Err(Error.Invalid)
  }
  match runtime_inputs.mask_prefix_slot(owner, mask_index, 0, 1, slots, 7) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  match runtime_inputs.mask_prefix_slot(owner, mask_index, 257, 1, slots, 7) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  match runtime_inputs.mask_prefix_slot(owner, mask_index, 2, 2, slots, 7) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  runtime_inputs.mask_prefix_slot(owner, mask_index, 2, 1, slots, 7)?
  if ggml_ffi.slot_ne(slots, 4, 0) != 256
    || ggml_ffi.slot_ne(slots, 4, 1) != 2
    || ggml_ffi.slot_ne(slots, 4, 2) != 2
    || ggml_ffi.slot_ne(slots, 4, 3) != 1
    || ggml_ffi.slot_ne(slots, 7, 0) != 2
    || ggml_ffi.slot_ne(slots, 7, 1) != 1 {
    return Err(Error.Invalid)
  }
  ggml_ffi.op_mul_mat(ctx, slots, 3, 0, 1, "gpu_graph_mul_mat") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.op_mul_mat(ctx, slots, 6, 4, 5, "gpu_attention_scores") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.op_soft_max_ext(
    ctx, slots, 8, 6, 7, 1065353216, 0, "gpu_attention_probabilities",
  ) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.op_permute(ctx, slots, 9, 4, 1, 0, 2, 3, "gpu_attention_value_transpose") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.op_cont_3d(ctx, slots, 10, 9, 2, 256, 2, "gpu_attention_value_contiguous") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.op_mul_mat(ctx, slots, 11, 10, 8, "gpu_attention_output") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.slot_mark_output(slots, 2, "gpu_graph_input") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.slot_mark_output(slots, 3, "gpu_graph_output") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.slot_mark_output(slots, 11, "gpu_attention_output") else {
    return Err(Error.Invalid)
  }
  graph := ggml_ffi.graph_new(ctx)
  if graph.is_null() { return Err(Error.Invalid) }
  ggml_ffi.graph_expand(graph, slots, 2, "gpu_graph_input_expand") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.graph_expand(graph, slots, 3, "gpu_graph_expand") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.graph_expand(graph, slots, 11, "gpu_attention_expand") else {
    return Err(Error.Invalid)
  }
  runtime_execution.prepare(owner, graph)?
  match runtime_kv.prefix_slot(owner, 0, 1, slots, 12) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  match runtime_inputs.mask_prefix_slot(owner, mask_index, 1, 1, slots, 12) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(_) => {}
  }
  actual_workspace := runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_WORKSPACE)
  actual_device := runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_DEVICE_TOTAL)
  if actual_workspace <= 3104 || actual_workspace > 524288
    || actual_device != 524288 + actual_workspace || actual_device > 1048576 {
    return Err(Error.Invalid)
  }
  mut first_input := buffer(4)
  first_input.put_u32_le(7)
  first_input_view := first_input.bytes()
  runtime_inputs.update(owner, input_index, 0, first_input_view)?
  mut query_data := buffer(2048)
  mut query_at := 0
  loop {
    if query_at >= 512 { break }
    query_data.put_u32_le(1065353216)
    query_at = query_at + 1
  }
  query_view := query_data.bytes()
  runtime_inputs.update(owner, query_index, 0, query_view)?
  mut first_mask := buffer(8)
  first_mask.put_u32_le(0)
  first_mask.put_u32_le(4286578688)
  first_mask_view := first_mask.bytes()
  runtime_inputs.update(owner, mask_index, 0, first_mask_view)?
  if runtime_inputs.state(owner, ggml_ffi.GPU_INPUT_EXPECTED) != 3
    || runtime_inputs.state(owner, ggml_ffi.GPU_INPUT_CREATED) != 3
    || runtime_inputs.state(owner, ggml_ffi.GPU_INPUT_UPDATED_BYTES) != 2060
    || runtime_inputs.state(owner, ggml_ffi.GPU_INPUT_FINISHED) != 1 {
    return Err(Error.Invalid)
  }
  runtime_execution.compute(owner, graph)?
  match ggml_ffi.gpu_device_synchronize(owner) {
    Ok(_) => {}
    Err(_) => { return Err(Error.Invalid) }
  }
  mut output_data := buffer(262144)
  mut output_at := 0
  loop {
    if output_at >= 65536 { break }
    output_data.put_u32_le(4294967295)
    output_at = output_at + 1
  }
  output_view := output_data.bytes()
  ggml_ffi.slot_get(slots, 3, output_view, 0, output_view.len(), "gpu_graph_output") else {
    return Err(Error.Invalid)
  }
  if output_view.u32_le(0) != 1065353216
    || output_view.u32_le(131072) != 1077936128
    || output_view.u32_le(261120) != 1065353216 {
    return Err(Error.Invalid)
  }
  mut first_attention := buffer(2048)
  mut first_attention_at := 0
  loop {
    if first_attention_at >= 512 { break }
    first_attention.put_u32_le(4294967295)
    first_attention_at = first_attention_at + 1
  }
  first_attention_view := first_attention.bytes()
  ggml_ffi.slot_get(
    slots, 11, first_attention_view, 0, first_attention_view.len(), "gpu_attention_first",
  ) else {
    return Err(Error.Invalid)
  }
  if first_attention_view.u32_le(0) != 1065353216
    || first_attention_view.u32_le(1020) != 1065353216
    || first_attention_view.u32_le(1024) != 1077936128
    || first_attention_view.u32_le(2044) != 1077936128 {
    return Err(Error.Invalid)
  }
  mut second_input := buffer(4)
  second_input.put_u32_le(8)
  second_input_view := second_input.bytes()
  runtime_inputs.update(owner, input_index, 0, second_input_view)?
  mut second_mask := buffer(8)
  second_mask.put_u32_le(4286578688)
  second_mask.put_u32_le(0)
  second_mask_view := second_mask.bytes()
  runtime_inputs.update(owner, mask_index, 0, second_mask_view)?
  mut kv_twos := buffer(1024)
  mut kv_two_at := 0
  loop {
    if kv_two_at >= 256 { break }
    kv_twos.put_u32_le(1073741824)
    kv_two_at = kv_two_at + 1
  }
  kv_twos_view := kv_twos.bytes()
  runtime_kv.update(owner, kv_index, 261120, kv_twos_view)?
  other_graph := ggml_ffi.graph_new(ctx)
  if other_graph.is_null() { return Err(Error.Invalid) }
  ggml_ffi.graph_expand(other_graph, slots, 3, "gpu_graph_other_expand") else {
    return Err(Error.Invalid)
  }
  match ggml_ffi.gpu_graph_compute(owner, other_graph) {
    Ok(_) => { return Err(Error.Invalid) }
    Err(fault) => {
      if fault.code != "CONFIG" { return Err(Error.Invalid) }
    }
  }
  runtime_execution.compute(owner, graph)?
  match ggml_ffi.gpu_device_synchronize(owner) {
    Ok(_) => {}
    Err(_) => { return Err(Error.Invalid) }
  }
  ggml_ffi.slot_get(slots, 3, output_view, 0, output_view.len(), "gpu_graph_reused_output") else {
    return Err(Error.Invalid)
  }
  mut second_attention := buffer(2048)
  mut second_attention_at := 0
  loop {
    if second_attention_at >= 512 { break }
    second_attention.put_u32_le(4294967295)
    second_attention_at = second_attention_at + 1
  }
  second_attention_view := second_attention.bytes()
  ggml_ffi.slot_get(
    slots, 11, second_attention_view, 0, second_attention_view.len(), "gpu_attention_second",
  ) else {
    return Err(Error.Invalid)
  }
  mut input_readback := buffer(4)
  input_readback.put_u32_le(0)
  input_readback_view := input_readback.bytes()
  ggml_ffi.slot_get(slots, 2, input_readback_view, 0, 4, "gpu_graph_input") else {
    return Err(Error.Invalid)
  }
  if output_view.u32_le(0) != 1065353216
    || output_view.u32_le(261120) != 1073741824
    || second_attention_view.u32_le(0) != 1073741824
    || second_attention_view.u32_le(1020) != 1073741824
    || second_attention_view.u32_le(1024) != 1082130432
    || second_attention_view.u32_le(2044) != 1082130432
    || input_readback_view.u32_le(0) != 8
    || runtime_kv.state(owner, ggml_ffi.GPU_KV_UPDATED_BYTES) != 6144
    || runtime_inputs.state(owner, ggml_ffi.GPU_INPUT_UPDATED_BYTES) != 2072
    || runtime_execution.state(owner, ggml_ffi.GPU_GRAPH_PREPARED) != 1
    || runtime_execution.state(owner, ggml_ffi.GPU_GRAPH_EXECUTIONS) != 2
    || runtime_execution.state(owner, ggml_ffi.GPU_GRAPH_REUSES) != 1 {
    return Err(Error.Invalid)
  }
  return Ok(())
}

fn expect_allocation_failure(
  backend: str,
  device: str,
  bundle_root: str,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  admitted(owner)?
  return match ggml_ffi.gpu_memory_allocate(owner) {
    Ok(_) => Err(Error.Invalid),
    Err(fault) => if fault.code == "ALLOCATION" { Ok(()) } else { Err(Error.Invalid) },
  }
}

fn expect_reopen_after_failure(
  backend: str,
  device: str,
  bundle_root: str,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  return match ggml_ffi.gpu_device_synchronize(owner) {
    Ok(_) => Ok(()),
    Err(_) => Err(Error.Invalid),
  }
}

fn expect_weight_allocation_failure(
  backend: str,
  device: str,
  bundle_root: str,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  runtime_memory.admit(
    owner,
    runtime_memory.MemoryPlan {
      weights_bytes: 1,
      kv_bytes: 1,
      workspace_bytes: 1,
      metadata_bytes: 4096,
      staging_bytes: 1,
      legacy_cache_bytes: 0,
    },
  )?
  runtime_memory.allocate(owner)?
  runtime_weights.begin(owner, 1)?
  return match ggml_ffi.gpu_weight_add(owner, 0, 1, 1, 1, 1, 1) {
    Ok(_) => Err(Error.Invalid),
    Err(fault) => if fault.code == "ALLOCATION" { Ok(()) } else { Err(Error.Invalid) },
  }
}

fn expect_memory_budget_refusal(
  backend: str,
  device: str,
  bundle_root: str,
  weights_bytes: i64,
  kv_bytes: i64,
  workspace_bytes: i64,
  metadata_bytes: i64,
  staging_bytes: i64,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  return match ggml_ffi.gpu_memory_admit(
    owner, weights_bytes, kv_bytes, workspace_bytes, metadata_bytes, staging_bytes, 0,
  ) {
    Ok(_) => Err(Error.Invalid),
    Err(fault) => if fault.code == "MEMORY_BUDGET" { Ok(()) } else { Err(Error.Invalid) },
  }
}

fn expect_input_allocation_failure(
  backend: str,
  device: str,
  bundle_root: str,
) -> Result<(), Error> {
  owner := opened(backend, device, bundle_root)?
  runtime_memory.admit(
    owner,
    runtime_memory.MemoryPlan {
      weights_bytes: 32,
      kv_bytes: 32,
      workspace_bytes: 64,
      metadata_bytes: 4096,
      staging_bytes: 4,
      legacy_cache_bytes: 0,
    },
  )?
  runtime_memory.allocate(owner)?
  runtime_weights.begin(owner, 1)?
  weight := runtime_weights.add(
    owner,
    runtime_weights.Shape {
      ggml_type: 0,
      n_dims: 1,
      ne0: 1,
      ne1: 1,
      ne2: 1,
      ne3: 1,
    },
  )?
  mut scalar := buffer(4)
  scalar.put_u32_le(1065353216)
  scalar_view := scalar.bytes()
  runtime_weights.upload(owner, weight, scalar_view)?
  runtime_weights.finish(owner)?
  runtime_kv.begin(owner, 1)?
  runtime_kv.add(
    owner,
    runtime_kv.Shape {
      ggml_type: 0,
      n_dims: 1,
      ne0: 1,
      ne1: 1,
      ne2: 1,
      ne3: 1,
    },
  )?
  runtime_kv.finish(owner)?
  runtime_inputs.begin(owner, 1)?
  runtime_inputs.add(
    owner,
    runtime_inputs.Shape {
      ggml_type: 26,
      n_dims: 1,
      ne0: 1,
      ne1: 1,
      ne2: 1,
      ne3: 1,
    },
  )?
  return match ggml_ffi.gpu_inputs_finish(owner) {
    Ok(_) => Err(Error.Invalid),
    Err(fault) => if fault.code == "ALLOCATION" { Ok(()) } else { Err(Error.Invalid) },
  }
}

fn expect_unavailable(
  backend: str,
  device: str,
  bundle_root: str,
) -> Result<(), Error> = match runtime_device.open(
  options(backend, device, bundle_root),
) {
  Ok(_) => Err(Error.Invalid),
  Err(_) => Ok(()),
}

fn expect_verification_refusal(
  backend: str,
  device: str,
  bundle_root: str,
) -> Result<(), Error> = match runtime_device.open(options(backend, device, bundle_root)) {
  Ok(_) => Err(Error.Invalid),
  Err(_) => Ok(()),
}

fn expect_bundle_switch(
  backend: str,
  device: str,
  backend_path: str,
  bundle_id: str,
) -> Result<(), Error> = match ggml_ffi.gpu_device_open(
  backend, device, backend_path, bundle_id, 1048576, 1048576,
) {
  Ok(_) => Err(Error.Invalid),
  Err(fault) => if fault.code == "BUNDLE_IDENTITY" { Ok(()) } else { Err(Error.Invalid) },
}

pub fn main(args: array<str>) -> Result<(), Error> {
  if args.len() != 9 { return Err(Error.Invalid) }
  mode := args[1]
  backend := args[2]
  device := args[3]
  bundle_root := args[4]
  invalid_bundle_root := args[5]
  other_bundle_root := args[6]
  backend_path := args[7]
  bundle_id := args[8]

  if mode == "unavailable" {
    expect_unavailable(backend, device, bundle_root)?
    print("runtime device smoke: UNAVAILABLE PASS")
    return Ok(())
  }
  if mode == "allocation-failure" {
    expect_allocation_failure(backend, device, bundle_root)?
    expect_reopen_after_failure(backend, device, bundle_root)?
    print("runtime device smoke: ALLOCATION FAILURE PASS")
    return Ok(())
  }
  if mode == "input-allocation-failure" {
    expect_input_allocation_failure(backend, device, bundle_root)?
    expect_reopen_after_failure(backend, device, bundle_root)?
    print("runtime device smoke: INPUT ALLOCATION FAILURE PASS")
    return Ok(())
  }
  if mode != "available" { return Err(Error.Invalid) }

  // Returning from the helper drops the first owner. Reopening the same pinned bundle proves the
  // guard was released on that ordinary return path; returning again covers a second lifetime.
  expect_verification_refusal(backend, device, invalid_bundle_root)?
  expect_memory_budget_refusal(backend, device, bundle_root, 524289, 262144, 262144, 1, 1)?
  expect_memory_budget_refusal(backend, device, bundle_root, 1, 1, 1, 1, 1048576)?
  expect_memory_budget_refusal(backend, device, bundle_root, 1, 1, 1, 9223372036854775807, 1)?
  expect_memory_budget_refusal(backend, device, bundle_root, 9223372036854775807, 1, 1, 1, 1)?
  expect_weight_allocation_failure(backend, device, bundle_root)?
  exercise_live_owner(backend, device, bundle_root, backend_path, bundle_id)?
  exercise_live_owner(backend, device, bundle_root, backend_path, bundle_id)?

  expect_verification_refusal(backend, device, other_bundle_root)?
  expect_bundle_switch(
    backend,
    device,
    backend_path,
    "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
  )?
  print("runtime device smoke: AVAILABLE PASS")
  return Ok(())
}
