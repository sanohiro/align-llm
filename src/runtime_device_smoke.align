  actual_device := runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_DEVICE_TOTAL)
  if actual_workspace <= 3104 || actual_workspace > 524288
    || actual_device != 524288 + actual_workspace || actual_device > 1048576 {
    return Err(Error.Invalid)
  }
  mut first_input := buffer(4)
  first_input.put_u32_le(7)
