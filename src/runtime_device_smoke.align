  kv_twos_view := kv_twos.bytes()
  runtime_kv.update(owner, kv_index, 261120, kv_twos_view)?
  match ggml_ffi.gpu_graph_compute(
    owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_topology_key, decode_graph,
