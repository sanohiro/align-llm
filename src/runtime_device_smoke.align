  }
  mut second_input := buffer(4)
  second_input.put_u32_le(8)
  second_input_view := second_input.bytes()
  runtime_inputs.update(owner, input_index, 0, second_input_view)?
  mut second_mask := buffer(8)
  second_mask.put_u32_le(4286578688)
