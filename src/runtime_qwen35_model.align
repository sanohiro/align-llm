module runtime_qwen35_model

import ggml_ffi
import runtime_attention
import runtime_qwen35_attention
import runtime_qwen35_ffn
import runtime_qwen35_geometry
import runtime_qwen35_recurrent
import runtime_qwen35_roles
import runtime_qwen35_state

pub TOKEN := 19
pub POSITION := 21
pub MASK := 22
pub OUTPUT := 92
pub GREEDY_OUTPUT := 93

// Build a complete one-token Qwen3.5 graph. Publication of the staged recurrent and
// attention state belongs to the caller after successful execution and output readback.
pub fn build_one_token(
  borrow owner: ggml_ffi.GpuDevice,
  borrow g: runtime_qwen35_geometry.Geometry,
  borrow state: runtime_qwen35_state.State,
  position: i64, kind: i64, index_input: i64,
  ctx: raw, graph: raw, borrow slots: slice<u8>,
) -> Result<(), Error> {
  return build_one_token_greedy(owner, g, state, position, kind, index_input,
    ctx, graph, slots, false)
}

pub fn build_one_token_greedy(
  borrow owner: ggml_ffi.GpuDevice,
  borrow g: runtime_qwen35_geometry.Geometry,
  borrow state: runtime_qwen35_state.State,
  position: i64, kind: i64, index_input: i64,
  ctx: raw, graph: raw, borrow slots: slice<u8>, graph_greedy: bool,
) -> Result<(), Error> {
  return build_tokens_final_row_greedy(owner, g, state, position, 1, kind, index_input,
    ctx, graph, slots, true, false, graph_greedy)
}

pub fn build_tokens(
  borrow owner: ggml_ffi.GpuDevice,
  borrow g: runtime_qwen35_geometry.Geometry,
  borrow state: runtime_qwen35_state.State,
  position: i64, count: i64, kind: i64, index_input: i64,
  ctx: raw, graph: raw, borrow slots: slice<u8>,
) -> Result<(), Error> {
  return build_tokens_output(owner, g, state, position, count, kind, index_input,
    ctx, graph, slots, true)
}

// Nonfinal prefill executes every state commit and its producers, without logits.
pub fn build_tokens_output(
  borrow owner: ggml_ffi.GpuDevice,
  borrow g: runtime_qwen35_geometry.Geometry,
  borrow state: runtime_qwen35_state.State,
  position: i64, count: i64, kind: i64, index_input: i64,
  ctx: raw, graph: raw, borrow slots: slice<u8>, emit_logits: bool,
) -> Result<(), Error> {
  return build_tokens_final_row(owner, g, state, position, count, kind, index_input,
    ctx, graph, slots, emit_logits, false)
}

// Select the only requested output row before the final layer's FFN.
pub fn build_tokens_final_row(
  borrow owner: ggml_ffi.GpuDevice,
  borrow g: runtime_qwen35_geometry.Geometry,
  borrow state: runtime_qwen35_state.State,
  position: i64, count: i64, kind: i64, index_input: i64,
  ctx: raw, graph: raw, borrow slots: slice<u8>, emit_logits: bool,
  last_ffn_row: bool,
) -> Result<(), Error> {
  return build_tokens_final_row_greedy(owner, g, state, position, count, kind, index_input,
    ctx, graph, slots, emit_logits, last_ffn_row, false)
}

pub fn build_tokens_final_row_greedy(
  borrow owner: ggml_ffi.GpuDevice,
  borrow g: runtime_qwen35_geometry.Geometry,
  borrow state: runtime_qwen35_state.State,
  position: i64, count: i64, kind: i64, index_input: i64,
  ctx: raw, graph: raw, borrow slots: slice<u8>, emit_logits: bool,
  last_ffn_row: bool, graph_greedy: bool,
) -> Result<(), Error> {
  return build_tokens_rows(owner, g, state, position, count, kind, index_input,
    ctx, graph, slots, emit_logits, last_ffn_row, graph_greedy, false)
}

// Developer target-graph probe: retain all logits rows for one bounded prefill.
pub fn build_tokens_all_logits(
  borrow owner: ggml_ffi.GpuDevice,
  borrow g: runtime_qwen35_geometry.Geometry,
  borrow state: runtime_qwen35_state.State,
  position: i64, count: i64, index_input: i64,
  ctx: raw, graph: raw, borrow slots: slice<u8>,
) -> Result<(), Error> {
  return build_tokens_rows(owner, g, state, position, count,
    ggml_ffi.GPU_GRAPH_PREFILL, index_input, ctx, graph, slots,
    true, false, false, true)
}

fn build_tokens_rows(
  borrow owner: ggml_ffi.GpuDevice,
  borrow g: runtime_qwen35_geometry.Geometry,
  borrow state: runtime_qwen35_state.State,
  position: i64, count: i64, kind: i64, index_input: i64,
  ctx: raw, graph: raw, borrow slots: slice<u8>, emit_logits: bool,
  last_ffn_row: bool, graph_greedy: bool, all_logits_rows: bool,
) -> Result<(), Error> {
  if !runtime_qwen35_geometry.valid_layer_pattern(g)
    || position < 0 || count < 1 || count > runtime_attention.MAX_PREFILL
    || count > g.context_length - position
    || (count > 1 && kind != ggml_ffi.GPU_GRAPH_PREFILL)
    || (!emit_logits && kind != ggml_ffi.GPU_GRAPH_PREFILL)
    || (graph_greedy && (!emit_logits || g.n_vocab < 8192))
    || (last_ffn_row && (!emit_logits || kind != ggml_ffi.GPU_GRAPH_PREFILL || count <= 1))
    || (all_logits_rows && (kind != ggml_ffi.GPU_GRAPH_PREFILL || count <= 1
        || count > 16 || !emit_logits || last_ffn_row || graph_greedy))
    || ggml_ffi.handle_absent(ctx) || ggml_ffi.handle_absent(graph)
    || ggml_ffi.slot_ne(slots, TOKEN, 0) != count
    || ggml_ffi.slot_ne(slots, POSITION, 0) != 4 * count {
    return Err(Error.Invalid)
  }
  ggml_ffi.slot_copy(slots, 100, slots, POSITION, "q35_saved_positions") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.slot_copy(slots, 101, slots, MASK, "q35_saved_mask") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_weight_slot(owner, 0, slots, 0) else { return Err(Error.Invalid) }
  ggml_ffi.op_get_rows(ctx, slots, 20, 0, TOKEN, "q35_token_embedding") else {
    return Err(Error.Invalid)
  }
  mut layer := 0
  loop {
    if layer >= g.n_layer { break }
    if runtime_qwen35_roles.full_attention(g, layer) {
      ggml_ffi.slot_copy(slots, POSITION, slots, 100, "q35_layer_positions") else {
        return Err(Error.Invalid)
      }
      ggml_ffi.slot_copy(slots, MASK, slots, 101, "q35_layer_mask") else {
        return Err(Error.Invalid)
      }
      runtime_qwen35_attention.build_many(owner, g, layer, position, count, kind, index_input,
        ctx, graph, slots)?
      ggml_ffi.slot_copy(slots, runtime_qwen35_ffn.ATTENTION, slots,
        runtime_qwen35_attention.OUTPUT, "q35_full_attention_tail") else {
        return Err(Error.Invalid)
      }
    } else {
      runtime_qwen35_recurrent.build_many(owner, g, state, layer, count, kind,
        ctx, graph, slots)?
      ggml_ffi.slot_copy(slots, runtime_qwen35_ffn.ATTENTION, slots,
        runtime_qwen35_recurrent.OUTPUT, "q35_recurrent_tail") else {
        return Err(Error.Invalid)
      }
    }
    mut residual_input := 20
    mut ffn_rows := count
    if last_ffn_row && layer + 1 == g.n_layer {
      ggml_ffi.op_view_2d(ctx, slots, 110, 20, g.n_embd, 1, 1, 1, count - 1,
        "q35_last_ffn_input") else { return Err(Error.Invalid) }
      ggml_ffi.op_view_2d(ctx, slots, 111, runtime_qwen35_ffn.ATTENTION,
        g.n_embd, 1, 1, 1, count - 1,
        "q35_last_ffn_attention") else { return Err(Error.Invalid) }
      ggml_ffi.slot_copy(slots, runtime_qwen35_ffn.ATTENTION, slots, 111,
        "q35_last_ffn_attention_row") else { return Err(Error.Invalid) }
      residual_input = 110
      ffn_rows = 1
    }
    ggml_ffi.slot_copy(slots, runtime_qwen35_ffn.INPUT, slots, residual_input,
      "q35_block_residual_input") else { return Err(Error.Invalid) }
    runtime_qwen35_ffn.build_many(owner, g, layer, ffn_rows, ctx, slots)?
    ggml_ffi.slot_copy(slots, 20, slots, runtime_qwen35_ffn.OUTPUT,
      "q35_next_layer_input") else { return Err(Error.Invalid) }
    layer = layer + 1
  }
  if !emit_logits {
    // Attention/recurrent builders already expanded every state write. The final
    // layer's output tail has no consumer until the final chunk requests logits.
    return Ok(())
  }
  if ggml_ffi.gpu_native_q6_head_enabled(owner) && (all_logits_rows || graph_greedy) {
    return Err(Error.Invalid)
  }
  norm_index := runtime_qwen35_roles.head_norm_slot(g)
  ggml_ffi.gpu_weight_slot(owner, norm_index, slots, 1) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_weight_slot(owner, 0, slots, 0) else { return Err(Error.Invalid) }
  if all_logits_rows {
    ggml_ffi.slot_copy(slots, 89, slots, 20, "q35_all_hidden_rows") else {
      return Err(Error.Invalid)
    }
  } else {
    ggml_ffi.op_view_2d(ctx, slots, 89, 20, g.n_embd, 1, 1, 1,
      if last_ffn_row { 0 } else { count - 1 },
      "q35_last_hidden") else { return Err(Error.Invalid) }
  }
  ggml_ffi.op_rms_norm(ctx, slots, 90, 89, g.rms_eps_bits, "q35_output_norm") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.op_mul(ctx, slots, 91, 90, 1, "q35_output_norm_weight") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.op_mul_mat(ctx, slots, OUTPUT, 0, 91, "q35_output_projection") else {
    return Err(Error.Invalid)
  }
  if graph_greedy {
    ggml_ffi.op_argmax_row(ctx, slots, GREEDY_OUTPUT, OUTPUT,
      "q35_in_graph_greedy") else { return Err(Error.Invalid) }
    ggml_ffi.slot_mark_output(slots, GREEDY_OUTPUT, "q35_greedy_token") else {
      return Err(Error.Invalid)
    }
    ggml_ffi.graph_expand(graph, slots, GREEDY_OUTPUT, "q35_greedy_token") else {
      return Err(Error.Invalid)
    }
  } else {
    if ggml_ffi.gpu_native_q6_head_enabled(owner) {
      tail := ggml_ffi.gpu_native_ffn_tail_enabled(owner) && count == 1
      if tail {
        ggml_ffi.slot_mark_output(slots, runtime_qwen35_ffn.INPUT, "q35_native_tail_input") else {
          return Err(Error.Invalid)
        }
        ggml_ffi.slot_mark_output(slots, runtime_qwen35_ffn.ATTENTION,
          "q35_native_tail_attention") else { return Err(Error.Invalid) }
        ggml_ffi.graph_expand(graph, slots, runtime_qwen35_ffn.INPUT,
          "q35_native_tail_input") else { return Err(Error.Invalid) }
        ggml_ffi.graph_expand(graph, slots, runtime_qwen35_ffn.ATTENTION,
          "q35_native_tail_attention") else { return Err(Error.Invalid) }
      } else {
        ggml_ffi.slot_mark_output(slots, 91, "q35_native_head_input") else {
          return Err(Error.Invalid)
        }
        ggml_ffi.graph_expand(graph, slots, 91, "q35_native_head_input") else {
          return Err(Error.Invalid)
        }
      }
      ggml_ffi.gpu_native_q6_head_register(owner, kind, slots, 0, 91, OUTPUT) else {
        return Err(Error.Invalid)
      }
      if tail {
        ggml_ffi.gpu_native_ffn_tail_register(owner, kind, slots,
          runtime_qwen35_ffn.INPUT, runtime_qwen35_ffn.ATTENTION,
          70, 71, 72, 73, 1, g.rms_eps_bits) else { return Err(Error.Invalid) }
      }
    } else {
      ggml_ffi.slot_mark_output(slots, OUTPUT, "q35_logits") else {
        return Err(Error.Invalid)
      }
      ggml_ffi.graph_expand(graph, slots, OUTPUT, "q35_logits") else {
        return Err(Error.Invalid)
      }
    }
    if kind != ggml_ffi.GPU_GRAPH_PREFILL
      && ggml_ffi.gpu_native_copy_greedy_enabled(owner) {
      ggml_ffi.gpu_native_copy_greedy_register(owner, kind, slots, OUTPUT) else {
        return Err(Error.Invalid)
      }
    }
  }
  return Ok(())
}
