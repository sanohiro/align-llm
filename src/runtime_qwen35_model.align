module runtime_qwen35_model

import ggml_ffi
import runtime_qwen35_attention
import runtime_qwen35_ffn
import runtime_qwen35_geometry
import runtime_qwen35_recurrent
import runtime_qwen35_roles
import runtime_qwen35_state

pub TOKEN := 19
pub POSITION := 21
pub MASK := 22
pub OUTPUT := 92

// Build a complete one-token Qwen3.5 graph. Publication of the staged recurrent and
// attention state belongs to the caller after successful execution and output readback.
pub fn build_one_token(
  borrow owner: ggml_ffi.GpuDevice,
  borrow g: runtime_qwen35_geometry.Geometry,
  borrow state: runtime_qwen35_state.State,
  position: i64, kind: i64, index_input: i64,
  ctx: raw, graph: raw, borrow slots: slice<u8>,
) -> Result<(), Error> {
  if !runtime_qwen35_geometry.valid_layer_pattern(g)
    || position < 0 || position >= g.context_length
    || ggml_ffi.handle_absent(ctx) || ggml_ffi.handle_absent(graph)
    || ggml_ffi.slot_ne(slots, TOKEN, 0) != 1
    || ggml_ffi.slot_ne(slots, POSITION, 0) != 4 {
    return Err(Error.Invalid)
  }
  ggml_ffi.slot_copy(slots, 100, slots, POSITION, "q35_saved_positions") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.slot_copy(slots, 101, slots, MASK, "q35_saved_mask") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_weight_slot(owner, 0, slots, 0) else { return Err(Error.Invalid) }
  ggml_ffi.op_get_rows(ctx, slots, 20, 0, TOKEN, "q35_token_embedding") else {
    return Err(Error.Invalid)
  }
  mut layer := 0
  loop {
    if layer >= g.n_layer { break }
    if runtime_qwen35_roles.full_attention(g, layer) {
      ggml_ffi.slot_copy(slots, POSITION, slots, 100, "q35_layer_positions") else {
        return Err(Error.Invalid)
      }
      ggml_ffi.slot_copy(slots, MASK, slots, 101, "q35_layer_mask") else {
        return Err(Error.Invalid)
      }
      runtime_qwen35_attention.build_one(owner, g, layer, position, kind, index_input,
        ctx, graph, slots)?
      ggml_ffi.slot_copy(slots, runtime_qwen35_ffn.ATTENTION, slots,
        runtime_qwen35_attention.OUTPUT, "q35_full_attention_tail") else {
        return Err(Error.Invalid)
      }
    } else {
      runtime_qwen35_recurrent.build_one(owner, g, state, layer, kind,
        ctx, graph, slots)?
      ggml_ffi.slot_copy(slots, runtime_qwen35_ffn.ATTENTION, slots,
        runtime_qwen35_recurrent.OUTPUT, "q35_recurrent_tail") else {
        return Err(Error.Invalid)
      }
    }
    ggml_ffi.slot_copy(slots, runtime_qwen35_ffn.INPUT, slots, 20,
      "q35_block_residual_input") else { return Err(Error.Invalid) }
    runtime_qwen35_ffn.build_one(owner, g, layer, ctx, slots)?
    ggml_ffi.slot_copy(slots, 20, slots, runtime_qwen35_ffn.OUTPUT,
      "q35_next_layer_input") else { return Err(Error.Invalid) }
    layer = layer + 1
  }
  norm_index := runtime_qwen35_roles.head_norm_slot(g)
  ggml_ffi.gpu_weight_slot(owner, norm_index, slots, 1) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_weight_slot(owner, 0, slots, 0) else { return Err(Error.Invalid) }
  ggml_ffi.op_rms_norm(ctx, slots, 90, 20, g.rms_eps_bits, "q35_output_norm") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.op_mul(ctx, slots, 91, 90, 1, "q35_output_norm_weight") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.op_mul_mat(ctx, slots, OUTPUT, 0, 91, "q35_output_projection") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.slot_mark_output(slots, OUTPUT, "q35_logits") else {
    return Err(Error.Invalid)
  }
  ggml_ffi.graph_expand(graph, slots, OUTPUT, "q35_logits") else {
    return Err(Error.Invalid)
  }
  return Ok(())
}
