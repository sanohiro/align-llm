  sha256: string,
  bit_sum: i64,
  element_count: i64,
  nonfinite_count: i64,

  reference_verdict: i64,
  reference_compared: i64,
  reference_identical: i64,
  reference_first_node: string,
  reference_first_index: i64,
  reference_first_primary_bits: i64,
  reference_first_reference_bits: i64,

  routing_verdict: i64,
  routing_ids_total: i64,
  routing_ids_printed: i64,
  routing_ids_matched: i64,
  routing_sum_expected: i64,
  routing_sum_observed: i64,
  routing_sum_matches: bool,
  routing_first_token: i64,
  routing_first_slot: i64,

  oracle_verdict: i64,
  oracle_expected: i64,
  oracle_matched: i64,
  oracle_elements: i64,
  oracle_max_abs: i64,
  oracle_max_sum: i64,
  oracle_worst_node: string,
  oracle_worst_element: i64,
  oracle_lines: i64,
  oracle_callback_lines: i64,

  pread_ns: i64,
  claim_pread_ns: i64,
  decide_ns: i64,
  build_a_ns: i64,
  build_b_ns: i64,
  reserve_ns: i64,
  compute_a_ns: i64,
  compute_b_ns: i64,
  reference_compute_ns: i64,
  oracle_ns: i64,
  elapsed_ns: i64,

  ggml_buffers_created: i64,
  ggml_buffers_freed: i64,
  contexts_created: i64,
  contexts_freed: i64,
  backends_created: i64,
  backends_freed: i64,
  graphs_created: i64,
  gallocrs_created: i64,
  gallocrs_freed: i64,
  released_before_owner_scope_end: bool,

  tensor_alignment: i64,
  table_drift: i64,
  slot_magic_ok: bool,
  fp_contract_off: bool,
  graph_context_bytes: i64,
}

pub fn empty_outcome() -> Outcome = Outcome {
  code: "".clone(),
