module moe_layer_forward

import core.json
import std.crypto
import std.encoding
import std.fs
import std.time
import alignpack_read
import ggml_ffi
import layer_olmoe

// R5D-MOE-LAYER-FORWARD (`docs/specs/r5d-moe-layer-forward.md`). The `--moe-layer-forward` arm: the
// two-phase read of section 3.4, the two node-table walks of section 3.5, the **three** oracles of
// section 3.6, the `R5_MOE_LAYER_FORWARD` document of section 3.7, the thirty-four-step validation
// order of section 3.8, and the teardown of section 3.9.
//
// `src/ggml_spike.align` owns arm selection; this module owns everything the arm does. It holds no
// `unsafe` and no `extern`: every foreign call crosses `src/ggml_ffi.align`.
//
// The capability in one sentence: **the set of weights this layer needs is not known until the
// layer has already half-run, and Align owns both the decision and the bytes.** Everything unusual
// here follows from that — two graphs instead of one, a data-dependent `ne2`, a decision taken on
// bytes Align owns rather than through a strided view, and a routing-identity oracle that exists
// because a wrong routing produces finite, plausible, wrong numbers.

MAX_PATH_BYTES := 4096
MAX_INDEX_DIGITS := 18
MAX_DETAIL_BYTES := 256
MAX_DIMENSION := 16777216

SCHEMA_VERSION := 1
DOCUMENT_KIND := "R5_MOE_LAYER_FORWARD"

// The arm computes layer 0. Section 1.3 records the coverage that costs and section 5.4 records
// what a `LAYER` operand would buy; there is no operand, so this is a constant and not a default.
LAYER := 0

// R4.5 section 3.9's compensation window, unchanged: Align has no aligned allocator
// (`docs/align-requests.md` Request 33) and every admissible `tensor_alignment` divides 64.
MAX_TENSOR_ALIGNMENT := 64

WARMUP_CALLS := 1
TIMED_CALLS := 5

// The one reused staging buffer for the claim reads, in the shape R5B correction C6 established.
PRIME_CHUNK_BYTES := 65536

VERDICT_UNAVAILABLE := 0
VERDICT_EXTERNAL := 1
VERDICT_COPIED := 2

REFERENCE_ABSENT := 0
REFERENCE_IDENTICAL := 1
REFERENCE_MISMATCH := 2

ORACLE_ABSENT := 0
ORACLE_PASS := 1
ORACLE_FAIL := 2

ROUTING_ABSENT := 0
ROUTING_MATCH := 1
ROUTING_MISMATCH := 2

// Section 3.6's thresholds, R5A's reused unchanged and re-justified against R5D's own measurement:
// the worst element disagreement over 2,376 elements and 26 nodes was 5.0e-5, which is exactly the
// `%12.4f` print bound, and the worst sum residual was 3.0e-5 absolute and 5.35e-7 relative, which
// the rule below clears by 33x and 19x (section 2.4).
TOLERANCE_TEN_THOUSANDTHS := 1
SUM_TOLERANCE_MILLIONTHS := 1000
SUM_TOLERANCE_RELATIVE_PPM := 10

// `r5c-metal-prefill.md` section 6, correction C19, re-raised verbatim: `as i64` **saturates**, so
// an infinity becomes `i64`'s extreme and a NaN becomes `0`, and either one can compare equal or
// wrap a subtraction into a magnitude no `>` test can see. Anything at or beyond these limits —
// every non-finite value included — is a mismatch by construction.
ORACLE_SCALE_LIMIT_TEN_THOUSANDTHS := 1000000000000000
SUM_SCALE_LIMIT_MILLIONTHS := 1000000000000000000
UNREPRESENTABLE := 9223372036854775807

// The transcript's own print structure. An axis of extent `ne` prints in full when `ne <= 6` and
// otherwise prints `{0, 1, 2, ne-3, ne-2, ne-1}`, so a sampled ordinal maps back to a real index
// through `axis_index` and never through its own position.
TRUNCATION_PRINTED := 6
TRUNCATION_HALF := 3

CB_PREFIX := "common_debug_cb_eval: "

// Section 4.1. The one node every graph of this instrument opens with, and therefore the graph
// boundary a multi-graph scan counts.
GRAPH_BOUNDARY_NODE := "embd"
CB_PREFIX_BYTES := 22
HEADER_NAME_SEP := " = ("
HEADER_TAIL := "}) = {"
ELEMENT_SEP := ", "
SUM_PREFIX := "sum = "

MAX_TRANSCRIPT_LINE_BYTES := 65536
TRANSCRIPT_WINDOW_BYTES := 262144

SUMMARY_HEX := "0123456789abcdef"
DIGEST_HEX_BYTES := 64

NOT_A_NUMBER := -9223372036854775807

TextBox { v: str }

// ---------------------------------------------------------------------------------------------
// Text, numbers, and the lexical guards
// ---------------------------------------------------------------------------------------------

fn int_text(value: i64) -> string {
  b := builder()
  b.write_int(value)
  return b.to_string()
}

fn bool_text(value: bool) -> string {
  if value { return "true".clone() }
  return "false".clone()
}

// The one place a `str` becomes a JSON scalar. `json.encode` escapes every byte a document may
// not carry raw, so a container-supplied name cannot break the document's framing; the slice drops
// the one-field object wrapper the encoder puts around it.
fn json_string(value: str) -> string {
  boxed := TextBox { v: value }
  encoded := json.encode(boxed)
  return encoded[5..encoded.len() - 1].clone()
}

fn bounded_detail(value: str) -> string {
  if value.len() <= MAX_DETAIL_BYTES { return value.clone() }
  return value[0..MAX_DETAIL_BYTES].clone()
}

fn labelled(label: str, value: i64) -> string {
  b := builder()
  b.write(label)
  b.write("[")
  b.write_int(value)
  b.write("]")
  return b.to_string()
}

fn named(label: str, value: str) -> string {
  b := builder()
  b.write(label)
  b.write("[")
  b.write(value)
  b.write("]")
  return b.to_string()
}

fn expert_role_detail(expert: i64, role: str) -> string {
  b := builder()
  b.write("expert[")
  b.write_int(expert)
  b.write("]role[")
  b.write(role)
  b.write("]")
  return b.to_string()
}

fn miscount(node: str, got: i64, expected: i64) -> string {
  b := builder()
  b.write("node[")
  b.write(node)
  b.write("]")
  b.write_int(got)
  b.write("/")
  b.write_int(expected)
  return b.to_string()
}

fn at_index(label: str, node: str, index: i64) -> string {
  b := builder()
  b.write(label)
  b.write("[")
  b.write(node)
  b.write("]@")
  b.write_int(index)
  return b.to_string()
}

// The summary block is read positionally and a path or a node name is arbitrary bytes, so every
// control byte is escaped before it is printed. The JSON document is unaffected: its encoder
// already escapes the same bytes.
fn sanitize_summary_line(value: str) -> string {
  b := builder()
  view := value.bytes()
  mut start := 0
  mut index := 0
  loop {
    if index >= view.len() { break }
    byte := view.u8(index) as i64
    if byte < 32 || byte == 127 {
      if index > start { b.write(value[start..index]) }
      high := byte / 16
      low := byte % 16
      b.write("\\x")
      b.write(SUMMARY_HEX[high..high + 1])
      b.write(SUMMARY_HEX[low..low + 1])
      start = index + 1
    }
    index = index + 1
  }
  if start < view.len() { b.write(value[start..view.len()]) }
  return b.to_string()
}

pub fn valid_path(path: str) -> bool {
  if path.len() == 0 || path.len() > MAX_PATH_BYTES { return false }
  return !path.contains("\0")
}

fn parse_index(value: str) -> i64 {
  if value.len() == 0 || value.len() > MAX_INDEX_DIGITS { return -1 }
  view := value.bytes()
  if view.len() > 1 && view.u8(0) as i64 == 48 { return -1 }
  mut total := 0
  mut index := 0
  loop {
    if index >= view.len() { break }
    byte := view.u8(index) as i64
    if byte < 48 || byte > 57 { return -1 }
    total = total * 10 + (byte - 48)
    index = index + 1
  }
  return total
}

fn error_name(e: Error) -> str = match e {
  NotFound => "NotFound",
  Invalid => "Invalid",
  Denied => "Denied",
  Timeout => "Timeout",
  Code(_) => "Code",
}

fn verdict_label(value: i64) -> str {
  if value == VERDICT_EXTERNAL { return "EXTERNAL" }
  if value == VERDICT_COPIED { return "COPIED" }
  return "UNAVAILABLE"
}

fn reference_label(value: i64) -> str {
  if value == REFERENCE_IDENTICAL { return "IDENTICAL" }
  if value == REFERENCE_MISMATCH { return "MISMATCH" }
  return "-"
}

fn oracle_label(value: i64) -> str {
  if value == ORACLE_PASS { return "PASS" }
  if value == ORACLE_FAIL { return "FAIL" }
  return "-"
}

fn routing_label(value: i64) -> str {
  if value == ROUTING_MATCH { return "MATCH" }
  if value == ROUTING_MISMATCH { return "MISMATCH" }
  return "-"
}

fn op_label(op: i64) -> str {
  if op == layer_olmoe.OP_GET_ROWS { return "GET_ROWS" }
  if op == layer_olmoe.OP_RMS_NORM { return "RMS_NORM" }
  if op == layer_olmoe.OP_MUL { return "MUL" }
  if op == layer_olmoe.OP_ADD { return "ADD" }
  if op == layer_olmoe.OP_MUL_MAT { return "MUL_MAT" }
  if op == layer_olmoe.OP_RESHAPE_3D { return "RESHAPE" }
  if op == layer_olmoe.OP_PERMUTE { return "PERMUTE" }
  if op == layer_olmoe.OP_CONT_3D { return "CONT" }
  if op == layer_olmoe.OP_ROPE { return "ROPE" }
  if op == layer_olmoe.OP_SOFT_MAX { return "SOFT_MAX" }
  if op == layer_olmoe.OP_SWIGLU { return "SWIGLU" }
  if op == layer_olmoe.OP_ARGSORT { return "ARGSORT" }
  if op == layer_olmoe.OP_MUL_MAT_ID { return "MUL_MAT_ID" }
  if op == layer_olmoe.OP_VIEW_2D { return "VIEW" }
  return "UNKNOWN"
}

fn oracle_state_label(state: i64) -> str {
  if state == layer_olmoe.ORACLE_COMPARED { return "compared" }
  if state == layer_olmoe.ORACLE_SHAPE_INCOMPARABLE { return "shape_incomparable" }
  if state == layer_olmoe.ORACLE_AMBIGUOUS_NAME { return "ambiguous_name" }
  if state == layer_olmoe.ORACLE_UNSTABLE_NAME { return "unstable_name" }
  return "absent"
}

fn align_up(value: i64, alignment: i64) -> i64 {
  if alignment <= 1 { return value }
  remainder := value % alignment
  if remainder == 0 { return value }
  return value + (alignment - remainder)
}

fn larger(a: i64, b: i64) -> i64 {
  if a > b { return a }
  return b
}

fn printed_count(extent: i64) -> i64 {
  if extent <= TRUNCATION_PRINTED { return extent }
  return TRUNCATION_PRINTED
}

fn axis_index(ordinal: i64, extent: i64) -> i64 {
  if extent <= TRUNCATION_PRINTED { return ordinal }
  if ordinal < TRUNCATION_HALF { return ordinal }
  return extent - TRUNCATION_PRINTED + ordinal
}

// R6-OLMOE-DECODE. `axis_index` above maps a printed **ordinal** to a tensor **index** on the
// assumption that any axis longer than `TRUNCATION_PRINTED` was printed as three leading and three
// trailing values with an ellipsis between them. That is what an unpatched `llama-eval-callback`
// does and it is what R5D and R5E ever saw.
//
// The **R2C-patched** instrument this capability's oracles require prints `ffn_moe_topk-L` in full —
// eight of eight slots, no ellipsis — and on such a row the ordinal *is* the index. Mapping it
// through `axis_index` sends ordinal 3 to index 5 and produces a routing comparison that disagrees
// on five slots of every eight while every block **sum** still agrees, which is exactly the shape a
// reader would misread as a routing defect. Measured: 96 of 256 ids matched with 32 of 32 sums
// matched, before this function existed.
//
// The row therefore says which it is, and nothing else has to: a row that carries an ellipsis is
// truncated and keeps R5A's mapping; a row that does not is complete and maps ordinals directly.
// When the axis is at or below `TRUNCATION_PRINTED` the two agree by construction, so every R5D and
// R5E corpus is unaffected and both MoE goldens stay byte-unchanged.
fn row_truncated(inner: str) -> bool {
  mut cursor := 0
  loop {
    if cursor > inner.len() { break }
    rest := inner[cursor..inner.len()]
    cut := match rest.find(ELEMENT_SEP) {
      Some(value) => value,
      None => -1,
    }
    piece := if cut < 0 { rest } else { rest[0..cut] }
    if piece.trim() == "..." { return true }
    if cut < 0 { break }
    cursor = cursor + cut + 2
  }
  return false
}

// ---------------------------------------------------------------------------------------------
// The tokens
// ---------------------------------------------------------------------------------------------

pub TokenList { ok: bool, detail: string, count: i64, ids: array<i64> }

fn empty_array() -> array<i64> {
  mut b: array_builder<i64> := array_builder()
  return b.build()
}

// Section 3.3: one to six non-negative decimal integers, comma-separated, no spaces, no trailing
// comma, each below `n_vocab`.
pub fn parse_tokens(text: str, n_vocab: i64) -> TokenList {
  mut ids: array_builder<i64> := array_builder()
  mut count := 0
  mut cursor := 0
  mut failure := "".clone()
  if text.len() == 0 {
    return TokenList { ok: false, detail: labelled("token", 0), count: 0, ids: ids.build() }
  }
  loop {
    if cursor > text.len() { break }
    rest := text[cursor..text.len()]
    cut := match rest.find(",") {
      Some(value) => value,
      None => -1,
    }
    piece := if cut < 0 { rest } else { rest[0..cut] }
    value := parse_index(piece)
    if value < 0 || value >= n_vocab {
      failure = labelled("token", count)
      break
    }
    if count >= layer_olmoe.MAX_PREFILL_TOKENS {
      failure = labelled("token", count)
      break
    }
    ids.push(value)
    count = count + 1
    if cut < 0 { break }
    cursor = cursor + cut + 1
    if cursor >= text.len() {
      failure = labelled("token", count)
      break
    }
  }
  if failure.len() > 0 {
    return TokenList { ok: false, detail: failure, count: 0, ids: ids.build() }
  }
  return TokenList { ok: true, detail: "".clone(), count: count, ids: ids.build() }
}

// ---------------------------------------------------------------------------------------------
// The transcript scanner (section 3.6)
// ---------------------------------------------------------------------------------------------
//
// R5A section 6 correction C6 already records that `src/expert_trace.align`'s scanner is not
// reusable — it is module-private, it never captures a node's **source** names, and it parses no
// element value and no `sum`. `src/layer_forward.align`'s scanner is the same grammar, but it is
// typed against `layer_qwen2.OracleTable` and has no notion of an integer block or of a row that is
// deliberately never sought. Section 6, correction C4 records the third instance of the same class:
// this scanner is R5A's grammar with two additions and it lives here.

TranscriptCursor {
  file_size: i64,
  window_base: i64,
  window_len: i64,
  pos: i64,
  capacity: i64,
  bytes_read: i64,
}

TranscriptLine { rel: i64, len: i64, offset: i64, done: bool }

Header {
  ok: bool,
  name_start: i64,
  name_end: i64,
  op_start: i64,
  op_end: i64,
  src_start: i64,
  src_end: i64,
  ne0: i64,
  ne1: i64,
  ne2: i64,
  ne3: i64,
}

fn bad_header() -> Header = Header {
  ok: false,
  name_start: 0,
  name_end: 0,
  op_start: 0,
  op_end: 0,
  src_start: 0,
  src_end: 0,
  ne0: 0,
  ne1: 0,
  ne2: 0,
  ne3: 0,
}

fn parse_dims(text: str) -> array<i64> {
  mut values: array_builder<i64> := array_builder()
  mut cursor := 0
  mut count := 0
  loop {
    if count >= 4 { break }
    rest := text[cursor..text.len()]
    cut := match rest.find(ELEMENT_SEP) {
      Some(value) => value,
      None => -1,
    }
    piece := if cut < 0 { rest } else { rest[0..cut] }
    value := parse_index(piece.trim())
    if value < 1 { break }
    values.push(value)
    count = count + 1
    if cut < 0 { break }
    cursor = cursor + cut + 2
  }
  return values.build()
}

// `common_debug_cb_eval: %24s = (%s) %10s(src0{d,d,d,d}, ...}) = {d,d,d,d}`. The source-name span is
// what the attention output projection is matched by: it has no stable node name.
fn parse_header(line: str) -> Header {
  if !line.starts_with(CB_PREFIX) { return bad_header() }
  separator := match line.find(HEADER_NAME_SEP) {
    Some(value) => value,
    None => { return bad_header() },
  }
  if separator <= CB_PREFIX_BYTES { return bad_header() }
  field := line[CB_PREFIX_BYTES..separator]
  field_view := field.bytes()
  mut name_at := 0
  loop {
    if name_at >= field_view.len() { break }
    if field_view.u8(name_at) != 32 { break }
    name_at = name_at + 1
  }
  if name_at >= field_view.len() { return bad_header() }
  name_start := CB_PREFIX_BYTES + name_at
  name_end := separator

  after_name := separator + 4
  if after_name > line.len() { return bad_header() }
  type_tail := line[after_name..line.len()]
  type_len := match type_tail.find(")") {
    Some(value) => value,
    None => { return bad_header() },
  }
  type_close := after_name + type_len
  if type_close + 1 >= line.len() { return bad_header() }
  if !line[type_close + 1..line.len()].starts_with(" ") { return bad_header() }

  op_field_start := type_close + 2
  if op_field_start >= line.len() { return bad_header() }
  op_tail := line[op_field_start..line.len()]
  op_field_len := match op_tail.find("(") {
    Some(value) => value,
    None => { return bad_header() },
  }
  op_field := line[op_field_start..op_field_start + op_field_len]
  op_field_view := op_field.bytes()
  mut op_at := 0
  loop {
    if op_at >= op_field_view.len() { break }
    if op_field_view.u8(op_at) != 32 { break }
    op_at = op_at + 1
  }
  if op_at >= op_field_view.len() { return bad_header() }
  op_start := op_field_start + op_at
  op_end := op_field_start + op_field_len
  args_start := op_end + 1

  tail_at := match line.rfind(HEADER_TAIL) {
    Some(value) => value,
    None => { return bad_header() },
  }
  if tail_at < args_start { return bad_header() }
  if !line.ends_with("}") { return bad_header() }
  result_text := line[tail_at + 6..line.len() - 1]
  args := line[args_start..tail_at]
  open0 := match args.find("{") {
    Some(value) => value,
    None => { return bad_header() },
  }
  ne := parse_dims(result_text)
  if ne.len() != 4 { return bad_header() }
  return Header {
    ok: true,
    name_start: name_start,
    name_end: name_end,
    op_start: op_start,
    op_end: op_end,
    src_start: args_start,
    src_end: args_start + open0,
    ne0: ne[0],
    ne1: ne[1],
    ne2: ne[2],
    ne3: ne[3],
  }
}

// `     -0.0190` to `-190`. The instrument prints `%12.4f`, so a printed value **is** an integer
// number of ten-thousandths and turning it into one loses nothing.
fn parse_fixed(text: str, decimals: i64) -> i64 {
  trimmed := text.trim()
  if trimmed.len() == 0 { return NOT_A_NUMBER }
  view := trimmed.bytes()
  mut at := 0
  mut negative := false
  if view.u8(0) as i64 == 45 {
    negative = true
    at = 1
  }
  if at >= view.len() { return NOT_A_NUMBER }
  mut whole := 0
  mut digits := 0
  loop {
    if at >= view.len() { break }
    byte := view.u8(at) as i64
    if byte < 48 || byte > 57 { break }
    if whole > 922337203685477 { return NOT_A_NUMBER }
    whole = whole * 10 + (byte - 48)
    digits = digits + 1
    at = at + 1
  }
  if digits == 0 { return NOT_A_NUMBER }
  if at >= view.len() || view.u8(at) as i64 != 46 { return NOT_A_NUMBER }
  at = at + 1
  mut fraction := 0
  mut taken := 0
  loop {
    if taken >= decimals { break }
    if at >= view.len() { return NOT_A_NUMBER }
    byte := view.u8(at) as i64
    if byte < 48 || byte > 57 { return NOT_A_NUMBER }
    fraction = fraction * 10 + (byte - 48)
    taken = taken + 1
    at = at + 1
  }
  if at != view.len() { return NOT_A_NUMBER }
  mut scale := 1
  mut power := 0
  loop {
    if power >= decimals { break }
    scale = scale * 10
    power = power + 1
  }
  total := whole * scale + fraction
  if negative { return 0 - total }
  return total
}

pub TranscriptScan {
  code: string,
  detail: string,
  line_count: i64,
  callback_line_count: i64,
  bytes_read: i64,
  matched: array<i64>,
  ne0: array<i64>,
  ne1: array<i64>,
  ne2: array<i64>,
  ne3: array<i64>,
  sum_millionths: array<i64>,
  sum_present: array<i64>,
  element_node: array<i64>,
  element_index: array<i64>,
  element_value: array<i64>,
}

fn empty_scan(code: str, detail: string) -> TranscriptScan {
  return TranscriptScan {
    code: code.clone(),
    detail: detail,
    line_count: 0,
    callback_line_count: 0,
    bytes_read: 0,
    matched: empty_array(),
    ne0: empty_array(),
    ne1: empty_array(),
    ne2: empty_array(),
    ne3: empty_array(),
    sum_millionths: empty_array(),
    sum_present: empty_array(),
    element_node: empty_array(),
    element_index: empty_array(),
    element_value: empty_array(),
  }
}

pub fn empty_transcript_scan() -> TranscriptScan = empty_scan("", "".clone())

fn refill(
  borrow handle: file,
  borrow mut window: buffer,
  borrow mut c: TranscriptCursor,
) -> Result<(), Error> {
  window = buffer(c.capacity)
  count := handle.pread(window, c.pos)?
  c.window_base = c.pos
  c.window_len = count
  c.bytes_read = c.bytes_read + count
  if count == 0 { return Err(Error.Invalid) }
  mut have := count
  loop {
    if have >= c.capacity { break }
    if c.pos + have >= c.file_size { break }
    mut tail := buffer(c.capacity - have)
    extra := handle.pread(tail, c.pos + have)?
    if extra == 0 { break }
    c.bytes_read = c.bytes_read + extra
    window.append(tail.bytes())
    have = have + extra
    c.window_len = have
  }
  return Ok(())
}

fn next_line(
  borrow handle: file,
  borrow mut window: buffer,
  borrow mut c: TranscriptCursor,
) -> Result<TranscriptLine, Error> {
  loop {
    if c.pos >= c.file_size {
      return Ok(TranscriptLine { rel: 0, len: 0, offset: c.pos, done: true })
    }
    if c.window_base < 0 || c.pos < c.window_base || c.pos >= c.window_base + c.window_len {
      refill(handle, window, c)?
    }
    view := window.bytes()
    rel := c.pos - c.window_base
    mut at := rel
    mut found := -1
    loop {
      if at >= c.window_len || at >= view.len() { break }
      if view.u8(at) as i64 == 10 {
        found = at
        break
      }
      at = at + 1
    }
    if found >= 0 {
      length := found - rel
      if length > MAX_TRANSCRIPT_LINE_BYTES { return Err(Error.Invalid) }
      start := c.pos
      c.pos = c.window_base + found + 1
      return Ok(TranscriptLine { rel: rel, len: length, offset: start, done: false })
    }
    if c.window_base + c.window_len >= c.file_size {
      length := c.window_len - rel
      if length > MAX_TRANSCRIPT_LINE_BYTES { return Err(Error.Invalid) }
      start := c.pos
      c.pos = c.file_size
      return Ok(TranscriptLine { rel: rel, len: length, offset: start, done: false })
    }
    if rel == 0 { return Err(Error.Invalid) }
    c.window_base = -1
    c.window_len = 0
  }
}

fn indent_of(text: str) -> i64 {
  view := text.bytes()
  mut at := 0
  loop {
    if at >= view.len() { break }
    if view.u8(at) != 32 { break }
    at = at + 1
  }
  return at
}

// One pass. A header that matches a **scanned** oracle row not yet matched starts a captured block;
// every other block is skipped without being parsed. Rows of class `ambiguous_name` and
// `unstable_name` are never candidates, which is section 3.6's exclusion expressed as control flow
// rather than as a comment: matching four same-named `norm-0` nodes by ordinal is exactly the
// silent-miscompare hazard section 2.2 fact 5 records.
pub fn scan_transcript(path: str, borrow oracle: layer_olmoe.OracleTable) -> TranscriptScan {
  return scan_transcript_after(path, oracle, 0)
}

// R6-OLMOE-DECODE (`docs/specs/r6-olmoe-decode.md` section 4.1), and
// `layer_forward.scan_transcript_after`'s reason unchanged on the routed side: the same scan over a
// transcript that holds **more than one graph**.
//
// `llama-eval-callback -n N` emits `N + 1` of them and every node name repeats across all of them.
// The matcher takes the **first** occurrence of each name, which is the only correct rule for a
// one-graph transcript and exactly the wrong one for a decode oracle: it would compare decode step
// `k` against the prefill graph's numbers and could still report `PASS` on the rows that agree.
//
// A graph boundary is the `embd` header, which every graph this instrument prints begins with, so
// counting that one header counts graphs without depending on a marker the instrument does not
// print. Everything before `skip_graphs` boundaries is parsed for grammar and counted and never
// captured, so `transcript_lines` and `transcript_callback_lines` still describe the whole file.
//
// `scan_transcript` is `skip_graphs = 0`, so R5D's and R5E's captured element sets are unchanged by
// construction.
pub fn scan_transcript_after(
  path: str, borrow oracle: layer_olmoe.OracleTable, skip_graphs: i64) -> TranscriptScan {
  handle := match fs.open_rw(path) {
    Ok(value) => value,
    Err(failure) => { return empty_scan("R5_TRANSCRIPT", error_name(failure).clone()) },
  }
  file_size := match handle.len() {
    Ok(value) => value,
    Err(failure) => { return empty_scan("R5_TRANSCRIPT", error_name(failure).clone()) },
  }
  mut window := buffer(TRANSCRIPT_WINDOW_BYTES)
  mut c := TranscriptCursor {
    file_size: file_size,
    window_base: -1,
    window_len: 0,
    pos: 0,
    capacity: TRANSCRIPT_WINDOW_BYTES,
    bytes_read: 0,
  }
  mut matched: array_builder<i64> := array_builder()
  mut d0: array_builder<i64> := array_builder()
  mut d1: array_builder<i64> := array_builder()
  mut d2: array_builder<i64> := array_builder()
  mut d3: array_builder<i64> := array_builder()
  mut sums: array_builder<i64> := array_builder()
  mut sum_seen: array_builder<i64> := array_builder()
  mut element_node: array_builder<i64> := array_builder()
  mut element_index: array_builder<i64> := array_builder()
  mut element_value: array_builder<i64> := array_builder()
  mut row := 0
  loop {
    if row >= oracle.count { break }
    matched.push(0)
    d0.push(0)
    d1.push(0)
    d2.push(0)
    d3.push(0)
    sums.push(0)
    sum_seen.push(0)
    row = row + 1
  }
  mut found := matched.build()
  mut ne0 := d0.build()
  mut ne1 := d1.build()
  mut ne2 := d2.build()
  mut ne3 := d3.build()
  mut sum_value := sums.build()
  mut sum_present := sum_seen.build()

  mut code := "".clone()
  mut detail := "".clone()
  mut line_count := 0
  mut callback_count := 0
  mut capture := -1
  mut capture_integer := false
  mut in_block := false
  // Section 4.1: how many `embd` headers have been seen, so the matcher below can be told which
  // graph of a multi-graph transcript it is standing in.
  mut graph_index := 0
  mut o3 := 0
  mut o2 := 0
  mut o1 := 0
  mut block_ne0 := 0
  mut block_ne1 := 0
  mut block_ne2 := 0
  mut block_ne3 := 0

  loop {
    line := match next_line(handle, window, c) {
      Ok(value) => value,
      Err(failure) => {
        code = "R5_TRANSCRIPT".clone()
        detail = error_name(failure).clone()
        break
      },
    }
    if line.done { break }
    line_count = line_count + 1
    view := window.bytes()
    if line.rel + line.len > view.len() {
      code = "R5_TRANSCRIPT".clone()
      detail = int_text(line.offset)
      break
    }
    region := view[line.rel..line.rel + line.len]
    text := match region.as_str() {
      Ok(value) => value,
      Err(_) => "",
    }
    mut handled := false
    if text.len() != line.len {
      if in_block {
        code = "R5_TRANSCRIPT".clone()
        detail = int_text(line.offset)
        break
      }
      handled = true
    }
    if !handled && text.starts_with(CB_PREFIX) {
      handled = true
      callback_count = callback_count + 1
      header := parse_header(text)
      if !header.ok {
        code = "R5_TRANSCRIPT".clone()
        detail = bounded_detail(text)
        break
      }
      in_block = false
      capture = -1
      capture_integer = false
      name := text[header.name_start..header.name_end]
      operation := text[header.op_start..header.op_end]
      source := text[header.src_start..header.src_end]
      if name == GRAPH_BOUNDARY_NODE { graph_index = graph_index + 1 }
      mut candidate := if graph_index > skip_graphs { 0 } else { oracle.count }
      loop {
        if candidate >= oracle.count { break }
        mut hit := false
        if found[candidate] == 0 && layer_olmoe.oracle_scanned(oracle, candidate)
          && operation == layer_olmoe.oracle_op(oracle, candidate) {
          wanted := layer_olmoe.oracle_name(oracle, candidate)
          if oracle.by_weight[candidate] == 1 {
            hit = source == wanted
          } else {
            hit = name == wanted
          }
        }
        if hit {
          capture = candidate
          capture_integer = oracle.integer[candidate] == 1
          found[candidate] = 1
          ne0[candidate] = header.ne0
          ne1[candidate] = header.ne1
          ne2[candidate] = header.ne2
          ne3[candidate] = header.ne3
          break
        }
        candidate = candidate + 1
      }
      if capture >= 0 {
        in_block = true
        block_ne0 = header.ne0
        block_ne1 = header.ne1
        block_ne2 = header.ne2
        block_ne3 = header.ne3
        o3 = 0
        o2 = 0
        o1 = 0
      }
    }
    if !handled && !in_block { handled = true }
    if !handled {
      indent := indent_of(text)
      body := text[indent..text.len()]
      if indent == 4 && body.starts_with(SUM_PREFIX) {
        handled = true
        value := parse_fixed(body[SUM_PREFIX.len()..body.len()], 6)
        if value == NOT_A_NUMBER {
          code = "R5_TRANSCRIPT".clone()
          detail = bounded_detail(text)
          break
        }
        sum_value[capture] = value
        sum_present[capture] = 1
        in_block = false
        capture = -1
        capture_integer = false
      }
      if !handled && body.starts_with("...") { handled = true }
      if !handled && body.starts_with("]") {
        handled = true
        if indent == 8 {
          o2 = o2 + 1
          o1 = 0
        }
        if indent == 4 { o3 = o3 + 1 }
      }
      if !handled && !body.starts_with("[") {
        code = "R5_TRANSCRIPT".clone()
        detail = bounded_detail(text)
        break
      }
      if !handled && indent != 12 { handled = true }
      if !handled {
        if !body.ends_with("],") {
          code = "R5_TRANSCRIPT".clone()
          detail = bounded_detail(text)
          break
        }
        inner := body[1..body.len() - 2]
        truncated := row_truncated(inner)
        mut o0 := 0
        mut cursor := 0
        mut failed := false
        mut nonintegral := false
        loop {
          if cursor > inner.len() { break }
          rest := inner[cursor..inner.len()]
          cut := match rest.find(ELEMENT_SEP) {
            Some(value) => value,
            None => -1,
          }
          piece := if cut < 0 { rest } else { rest[0..cut] }
          trimmed := piece.trim()
          if trimmed != "..." && trimmed.len() > 0 {
            value := parse_fixed(trimmed, 4)
            if value == NOT_A_NUMBER {
              failed = true
              break
            }
            // `r2a-expert-trace.md` section 2.2 finding 5's rule, re-raised: the instrument prints
            // an i32 element through `%12.4f`, so an expert id arrives as `      57.0000`. Reject a
            // leading `-`, require the fractional part to be all zeroes, and take the integral
            // part. A violation is `R2_EXPERT_ID_NOT_INTEGRAL` and never a rounded float.
            if capture_integer && (value < 0 || value % 10000 != 0) {
              nonintegral = true
              break
            }
            i0 := if truncated { axis_index(o0, block_ne0) } else { o0 }
            i1 := axis_index(o1, block_ne1)
            i2 := axis_index(o2, block_ne2)
            i3 := axis_index(o3, block_ne3)
            element_node.push(capture)
            element_index.push(i0 + block_ne0 * (i1 + block_ne1 * (i2 + block_ne2 * i3)))
            element_value.push(value)
            o0 = o0 + 1
          }
          if cut < 0 { break }
          cursor = cursor + cut + 2
        }
        if nonintegral {
          code = "R2_EXPERT_ID_NOT_INTEGRAL".clone()
          detail = bounded_detail(text)
          break
        }
        if failed {
          code = "R5_TRANSCRIPT".clone()
          detail = bounded_detail(text)
          break
        }
        o1 = o1 + 1
      }
    }
  }
  if code.len() == 0 && callback_count == 0 {
    code = "R5_TRANSCRIPT".clone()
    detail = "no_callback_lines".clone()
  }
  return TranscriptScan {
    code: code,
    detail: detail,
    line_count: line_count,
    callback_line_count: callback_count,
    bytes_read: c.bytes_read,
    matched: found,
    ne0: ne0,
    ne1: ne1,
    ne2: ne2,
    ne3: ne3,
    sum_millionths: sum_value,
    sum_present: sum_present,
    element_node: element_node.build(),
    element_index: element_index.build(),
    element_value: element_value.build(),
  }
}

// ---------------------------------------------------------------------------------------------
// The outcome and its columns (section 3.7)
//
// The document's scalars live in one `Outcome`; its **columns** live in small records each assigned
// exactly once, as a whole, by the stage that produces it. R5A correction C9's shape: an owned
// `array<i64>` field cannot be replaced in place at this pin.
// ---------------------------------------------------------------------------------------------

pub TokenColumns { count: i64, ids: array<i64> }

pub fn empty_tokens() -> TokenColumns = TokenColumns { count: 0, ids: empty_array() }

pub MemberColumns {
  count: i64,
  names: string,
  name_start: array<i64>,
  name_end: array<i64>,
  role: array<i64>,
  kind: array<i64>,
  ggml_type: array<i64>,
  ne0: array<i64>,
  ne1: array<i64>,
  nbytes: array<i64>,
  pack_offset: array<i64>,
}

pub fn empty_members() -> MemberColumns = MemberColumns {
  count: 0,
  names: "".clone(),
  name_start: empty_array(),
  name_end: empty_array(),
  role: empty_array(),
  kind: empty_array(),
  ggml_type: empty_array(),
  ne0: empty_array(),
  ne1: empty_array(),
  nbytes: empty_array(),
  pack_offset: empty_array(),
}

pub fn member_label_at(borrow m: MemberColumns, index: i64) -> str {
  view: str := m.names
  if index < 0 || index >= m.count { return "" }
  return view[m.name_start[index]..m.name_end[index]]
}

pub Layout {
  source_offsets: array<i64>,
  block_offsets: array<i64>,
  window_offsets: array<i64>,
  row_bytes: i64,
  weight_bytes: i64,
}

pub fn empty_layout() -> Layout = Layout {
  source_offsets: empty_array(),
  block_offsets: empty_array(),
  window_offsets: empty_array(),
  row_bytes: 0,
  weight_bytes: 0,
}

pub ReadColumns { read_bytes: array<i64>, pread_count: array<i64> }

pub fn empty_reads() -> ReadColumns = ReadColumns {
  read_bytes: empty_array(),
  pread_count: empty_array(),
}

pub AbiColumns { blck: array<i64>, type_size: array<i64>, window_alignment: array<i64> }

pub fn empty_abi() -> AbiColumns = AbiColumns {
  blck: empty_array(),
  type_size: empty_array(),
  window_alignment: empty_array(),
}

pub PlacementColumns { data_offset: array<i64>, identity: array<i64> }

pub fn empty_placement() -> PlacementColumns = PlacementColumns {
  data_offset: empty_array(),
  identity: empty_array(),
}

// `3U` rows in `(expert ascending, role) `order — the order the reads are issued and the order the
// three compact windows are laid out. `ne2` is the built tensor's third dim, which is **`U`** and
// not the member record's `n_expert`; a reader that conflated the two would misread every
// `plane_stride` (section 3.7).
pub ClaimColumns {
  count: i64,
  expert: array<i64>,
  block_index: array<i64>,
  role: array<i64>,
  role_id: array<i64>,
  ggml_type: array<i64>,
  ne0: array<i64>,
  ne1: array<i64>,
  slice_index: array<i64>,
  slice_count: array<i64>,
  nbytes: array<i64>,
  pack_offset: array<i64>,
  source_offset: array<i64>,
  window_offset: array<i64>,
  plane_stride: array<i64>,
}

// Per-plane pointer identity, in its own record for R5A correction C9's reason: an owned
// `array<i64>` field cannot be replaced in place, so the column the placement stage produces cannot
// be written back into the record the read stage already assigned.
pub ClaimIdentity { flags: array<i64> }

pub fn empty_claim_identity() -> ClaimIdentity = ClaimIdentity { flags: empty_array() }

pub fn empty_claims() -> ClaimColumns = ClaimColumns {
  count: 0,
  expert: empty_array(),
  block_index: empty_array(),
  role: empty_array(),
  role_id: empty_array(),
  ggml_type: empty_array(),
  ne0: empty_array(),
  ne1: empty_array(),
  slice_index: empty_array(),
  slice_count: empty_array(),
  nbytes: empty_array(),
  pack_offset: empty_array(),
  source_offset: empty_array(),
  window_offset: empty_array(),
  plane_stride: empty_array(),
}

pub NodeColumns {
  count: i64,
  digests: string,
  op: array<i64>,
  ne0: array<i64>,
  ne1: array<i64>,
  ne2: array<i64>,
  ne3: array<i64>,
  elements: array<i64>,
  ggml_type: array<i64>,
  bit_sum: array<i64>,
  sum_millionths: array<i64>,
  nonfinite: array<i64>,
}

pub fn empty_nodes() -> NodeColumns = NodeColumns {
  count: 0,
  digests: "".clone(),
  op: empty_array(),
  ne0: empty_array(),
  ne1: empty_array(),
  ne2: empty_array(),
  ne3: empty_array(),
  elements: empty_array(),
  ggml_type: empty_array(),
  bit_sum: empty_array(),
  sum_millionths: empty_array(),
  nonfinite: empty_array(),
}

pub OracleStates { state: array<i64> }

pub fn empty_states() -> OracleStates = OracleStates { state: empty_array() }

