// Canonical input form for the two optional fields: the canonical encoder omits a `None`, and an
// explicit `null` at the input boundary normalizes to the same `None`. Both fields are adjacent and
// precede `timeout_ns`, so each accepted form is one insertion in declaration order.
fn experiment_request_input_accepted(
  canonical: str,
  value: str,
  borrow request: PromptExperimentRequest,
) -> Result<bool, Error> {
  if canonical == value {
    return Ok(true)
  }
  api_key_absent := match request.api_key_env { None => true, Some(_) => false }
  tokenize_absent := match request.tokenize_endpoint { None => true, Some(_) => false }
  if tokenize_absent {
    tokenize_null: string := canonical_with_explicit_null(
      canonical,
      "\"timeout_ns\":",
      "tokenize_endpoint",
    )?
    tokenize_null_view: str := tokenize_null
    if tokenize_null_view == value {
      return Ok(true)
    }
    if api_key_absent {
      both_null: string := canonical_with_explicit_null(
        tokenize_null_view,
        "\"tokenize_endpoint\":",
        "api_key_env",
      )?
      both_null_view: str := both_null
      if both_null_view == value {
        return Ok(true)
      }
    }
  }
  if api_key_absent {
    anchor := if tokenize_absent { "\"timeout_ns\":" } else { "\"tokenize_endpoint\":" }
    api_key_null: string := canonical_with_explicit_null(canonical, anchor, "api_key_env")?
    api_key_null_view: str := api_key_null
    if api_key_null_view == value {
      return Ok(true)
    }
  }
  return Ok(false)
}

pub fn decode_prompt_experiment_request(value: str) -> Result<PromptExperimentRequest, Error> {
  decoded: PromptExperimentRequest := json.decode(value)?
  canonical_value: PromptExperimentRequest := json.decode(value)?
  canonical: string := json.encode(canonical_value).clone()
  canonical_view: str := canonical
  if !experiment_request_input_accepted(canonical_view, value, decoded)? {
    return Err(Error.Invalid)
  }
  return Ok(decoded)
}

pub fn encode_prompt_experiment_request(value: PromptExperimentRequest) -> string {
  return json.encode(value).clone()
}

pub fn encode_prompt_experiment_request_bounded(value: PromptExperimentRequest, max_bytes: i64) -> Result<string, Error> {
  return json.encode_bounded(value, max_bytes)
}

