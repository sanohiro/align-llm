  canonical := json.encode_bounded(normalized, 2097152)?
  return Ok(digest_text(canonical))
}

pub fn verify_prompt_activation_content(borrow value: PromptActivation) -> bool {
  if !valid_activation_shape(value) || !verify_prompt_scope_content(value.scope) ||
  !verify_prompt_variant_content(value.effective_variant) {
    return false
  }
  expected := prompt_activation_content_digest(value) else {
    return false
  }
  return expected == value.content_sha256
}

pub fn prompt_activation_result_content_digest(borrow value: PromptActivationResult) -> Result<string, Error> {
  normalized := PromptActivationResult {
    schema_version: value.schema_version,
    artifact_kind: value.artifact_kind.clone(),
    decision_id: match value.decision_id {
      None => None,
      Some(id) => Some(id.clone()),
    },
    status: value.status.clone(),
    error_code: value.error_code.clone(),
    error: value.error.clone(),
    activation: clone_prompt_activation_option(value.activation),
    content_sha256: "".clone(),
  }
  canonical := json.encode_bounded(normalized, 2097152)?
  return Ok(digest_text(canonical))
}

fn valid_activation_failure_code(status: str, code: str) -> bool {
  if status == "INELIGIBLE" || status == "PARENT_MISMATCH" || status == "SCOPE_MISMATCH" ||
  status == "UNKNOWN_TARGET" || status == "NO_CHANGE" {
    return code == status
  }
  if status != "INVALID_INPUT" {
    return false
  }
  return code == "INPUT_NOT_FOUND" || code == "INPUT_TYPE" || code == "INPUT_READ" ||
  code == "INVALID_ID" || code == "INVALID_PATH" || code == "INVALID_SCHEMA" ||
  code == "INVALID_KIND" || code == "INVALID_LABEL" || code == "INVALID_BOUNDS" ||
  code == "INVALID_DIGEST" || code == "INVALID_REFERENCE" || code == "SCOPE_MISMATCH" ||
  code == "MISSING_CREDENTIAL" || code == "WORKSPACE_NOT_EMPTY"
}

pub fn verify_prompt_activation_result_content(borrow value: PromptActivationResult) -> bool {
  if value.schema_version != 1 || value.artifact_kind != "PROMPT_ACTIVATION_RESULT" ||
  !valid_content_digest(value.content_sha256) {
    return false
  }
  successful := value.status == "BASELINED" || value.status == "ACCEPTED" || value.status == "ROLLED_BACK"
  id_valid := match value.decision_id {
    None => value.status == "INVALID_INPUT",
    Some(id) => valid_ascii_identifier(id, 96),
  }
  if !id_valid {
    return false
  }
  shape_valid := if successful {
    value.error_code == "NONE" && value.error.len() == 0 && match value.activation {
      None => false,
      Some(activation) => {
        expected_operation := if value.status == "BASELINED" {
          "BASELINE"
        } else if value.status == "ACCEPTED" {
          "ACCEPT"
        } else {
          "ROLLBACK"
        }
        id_matches := match value.decision_id {
          None => false,
          Some(id) => activation.activation_id == derived_activation_id(id),
        }
        activation.operation == expected_operation && id_matches && verify_prompt_activation_content(activation)
      },
    }
  } else {
    valid_activation_failure_code(value.status, value.error_code) &&
    valid_nonempty_text(value.error, 4096) &&
    match value.activation { None => true, Some(_) => false }
  }
  if !shape_valid {
    return false
  }
  expected := prompt_activation_result_content_digest(value) else {
    return false
  }
  return expected == value.content_sha256
}

fn clone_prompt_experiment_request(borrow value: PromptExperimentRequest) -> PromptExperimentRequest {
  return PromptExperimentRequest {
    schema_version: value.schema_version,
    artifact_kind: value.artifact_kind.clone(),
    experiment_id: value.experiment_id.clone(),
    project_root: value.project_root.clone(),
    parent_activation_path: value.parent_activation_path.clone(),
    opportunity_path: value.opportunity_path.clone(),
    proposal_provider_kind: value.proposal_provider_kind.clone(),
    proposal_provider_endpoint: value.proposal_provider_endpoint.clone(),
    proposal_provider_endpoint_id: value.proposal_provider_endpoint_id.clone(),
    proposal_provider_model: value.proposal_provider_model.clone(),
    api_key_env: match value.api_key_env {
      None => None,
      Some(name) => Some(name.clone()),
    },
    tokenize_endpoint: match value.tokenize_endpoint {
      None => None,
      Some(endpoint) => Some(endpoint.clone()),
    },
    timeout_ns: value.timeout_ns,
    max_prompt_bytes: value.max_prompt_bytes,
    max_tokens: value.max_tokens,
    temperature_micros: value.temperature_micros,
  }
}

// The section 5.1 request carries no `content_sha256` field, so its canonical identity is the
// digest of the complete canonical encoding under the section 5 operation-request raw-byte cap.
pub fn prompt_experiment_request_content_digest(borrow value: PromptExperimentRequest) -> Result<string, Error> {
  normalized := clone_prompt_experiment_request(value)
  canonical := json.encode_bounded(normalized, 65536)?
  return Ok(digest_text(canonical))
}

// Section 5 universal record order: `schema_version`, `artifact_kind`, scalar fields in declaration
// order, then local bounds and field-specific labels. The two optional fields are decided last
// because they depend on `proposal_provider_kind`, exactly as the shipped provider-control
// verifier orders its own credential and tokenizer pairing.
pub fn verify_prompt_experiment_request(borrow value: PromptExperimentRequest) -> bool {
  if value.schema_version != 1 ||
  value.artifact_kind != "PROMPT_EXPERIMENT_REQUEST" ||
  !valid_ascii_identifier(value.experiment_id, 96) ||
  !valid_nonempty_text(value.project_root, 4096) ||
  !valid_nonempty_text(value.parent_activation_path, 4096) ||
  !valid_nonempty_text(value.opportunity_path, 4096) ||
  !valid_proposal_provider_kind(value.proposal_provider_kind) ||
  !valid_provider_endpoint(
    value.proposal_provider_endpoint,
    value.proposal_provider_kind == "CLOUD_OPENAI",
  ) ||
  !valid_nonempty_text(value.proposal_provider_endpoint_id, 256) ||
  !valid_nonempty_text(value.proposal_provider_model, 256) ||
  value.timeout_ns <= 0 || value.timeout_ns > 7_200_000_000_000 ||
  value.max_prompt_bytes <= 0 || value.max_prompt_bytes > 262_144 ||
  value.max_tokens <= 0 || value.max_tokens > 8_192 ||
  value.temperature_micros < 0 || value.temperature_micros > 1_000_000 {
    return false
  }
  api_key_valid := match value.api_key_env {
    None => value.proposal_provider_kind != "CLOUD_OPENAI",
    Some(name) => (value.proposal_provider_kind == "CLOUD_OPENAI" ||
      value.proposal_provider_kind == "LOCAL_OPENAI") && valid_environment_name(name),
  }
  tokenize_valid := match value.tokenize_endpoint {
    None => true,
    Some(endpoint) => value.proposal_provider_kind == "LLAMA_CPP" &&
    valid_provider_endpoint(endpoint, false),
  }
  return api_key_valid && tokenize_valid
}

fn clone_prompt_generation_request(borrow value: PromptGenerationRequest) -> PromptGenerationRequest {
  return PromptGenerationRequest {
    schema_version: value.schema_version,
    artifact_kind: value.artifact_kind.clone(),
    request_id: value.request_id.clone(),
    provider_kind: value.provider_kind.clone(),
    endpoint: value.endpoint.clone(),
    provider_model: value.provider_model.clone(),
    api_key_env: match value.api_key_env {
      None => None,
      Some(name) => Some(name.clone()),
    },
    rendered_prompt_path: value.rendered_prompt_path.clone(),
    rendered_prompt_sha256: value.rendered_prompt_sha256.clone(),
    max_tokens: value.max_tokens,
    temperature_micros: value.temperature_micros,
    paired_seed: value.paired_seed,
    timeout_ns: value.timeout_ns,
    max_response_bytes: value.max_response_bytes,
    content_sha256: value.content_sha256.clone(),
  }
}

pub fn prompt_generation_request_content_digest(borrow value: PromptGenerationRequest) -> Result<string, Error> {
  mut normalized := clone_prompt_generation_request(value)
  normalized.content_sha256 = "".clone()
  canonical := json.encode_bounded(normalized, 65536)?
  return Ok(digest_text(canonical))
}

// Section 5 universal record order: `schema_version`, `artifact_kind`, then the scalar fields in
// declaration order with the section 1.2 identifier, path, endpoint, digest, and numeric bounds. The
// optional credential name is decided last because its rule depends on `provider_kind`. `FIXTURE` is
// not a dispatchable kind, so it is rejected here rather than reaching provider dispatch.
pub fn verify_prompt_generation_request(borrow value: PromptGenerationRequest) -> bool {
  if value.schema_version != 1 ||
  value.artifact_kind != "PROMPT_GENERATION_REQUEST" ||
  !valid_ascii_identifier(value.request_id, 96) ||
  !valid_proposal_provider_kind(value.provider_kind) ||
  !valid_provider_endpoint(value.endpoint, value.provider_kind == "CLOUD_OPENAI") ||
  !valid_nonempty_text(value.provider_model, 256) ||
  !valid_nonempty_text(value.rendered_prompt_path, 4096) ||
  !valid_content_digest(value.rendered_prompt_sha256) ||
  value.max_tokens <= 0 || value.max_tokens > 1_048_576 ||
  value.temperature_micros < 0 || value.temperature_micros > 1_000_000 ||
  value.timeout_ns <= 0 || value.timeout_ns > 7_200_000_000_000 ||
  value.max_response_bytes <= 0 || value.max_response_bytes > 1_048_576 ||
  !valid_content_digest(value.content_sha256) {
    return false
  }
  api_key_valid := match value.api_key_env {
    None => value.provider_kind != "CLOUD_OPENAI",
    Some(name) => (value.provider_kind == "CLOUD_OPENAI" ||
      value.provider_kind == "LOCAL_OPENAI") && valid_environment_name(name),
  }
  if !api_key_valid {
    return false
  }
  expected := prompt_generation_request_content_digest(value) else {
    return false
  }
  return expected == value.content_sha256
}

pub fn clone_prompt_generation_response(borrow value: PromptGenerationResponse) -> PromptGenerationResponse {
  return PromptGenerationResponse {
    schema_version: value.schema_version,
    artifact_kind: value.artifact_kind.clone(),
    request_id: value.request_id.clone(),
    status: value.status.clone(),
    error_code: value.error_code.clone(),
    error: value.error.clone(),
    provider_kind: value.provider_kind.clone(),
    provider_model: value.provider_model.clone(),
    provider_request_sha256: value.provider_request_sha256.clone(),
    seed_result: value.seed_result.clone(),
    applied_seed: value.applied_seed,
    http_status: value.http_status,
    content: match value.content {
      None => None,
      Some(text) => Some(text.clone()),
    },
    dispatch_start_ns: value.dispatch_start_ns,
    dispatch_end_ns: value.dispatch_end_ns,
    content_sha256: value.content_sha256.clone(),
  }
}

pub fn prompt_generation_response_content_digest(borrow value: PromptGenerationResponse) -> Result<string, Error> {
  mut normalized := clone_prompt_generation_response(value)
  normalized.content_sha256 = "".clone()
  canonical := json.encode_bounded(normalized, 2097152)?
  return Ok(digest_text(canonical))
}

pub fn verify_prompt_generation_response_content(borrow value: PromptGenerationResponse) -> bool {
  if value.schema_version != 1 ||
  value.artifact_kind != "PROMPT_GENERATION_RESPONSE" ||
  !valid_ascii_identifier(value.request_id, 96) ||
  !valid_content_digest(value.content_sha256) {
    return false
  }
  expected := prompt_generation_response_content_digest(value) else {
    return false
  }
  return expected == value.content_sha256
}

