  // The C4 gate quantity and its two denominators.
  repair_attempt_count: Option<i64>,
  repair_recovery_count: Option<i64>,
  repair_recovery_paired_count: Option<i64>,
  // C4-REPAIR-EDITSET: repair attempts whose prompt actually carried `EDITSET`. A denominator,
  // never a gate input; the gate still consumes `repair_recovery_paired_count` only.
  repair_editset_attempt_count: Option<i64>,
  // C4-REPAIR-TEMPLATE's pre-committed secondary: ran attempts whose `edit_refusal` is not
  // `NONE`, against a C4E baseline of 10 of 22 derived from the summary strings. Reported whatever
  // the gate says; the gate still consumes `repair_recovery_paired_count` only.
  edit_refusal_count: Option<i64>,
}

