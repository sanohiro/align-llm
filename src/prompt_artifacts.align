  candidate_repair_recovery_count: Option<i64>,
  repair_recovery_paired: Option<bool>,
  // C4-REPAIR-EDITSET: the denominator of every edit-set claim, per variant.
  parent_repair_editset_attempt_count: Option<i64>,
  candidate_repair_editset_attempt_count: Option<i64>,
  // C4-REPAIR-TEMPLATE: ran attempts refused by the edit policy, per variant.
