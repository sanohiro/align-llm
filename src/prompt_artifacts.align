}

pub fn encode_prompt_generation_request_bounded(value: PromptGenerationRequest, max_bytes: i64) -> Result<string, Error> {
  return json.encode_bounded(value, max_bytes)
}

// The response carries three optional fields and a `content` text that always escapes for a real
// completion body, so decoding it is the ordinary root decode without a canonical-form comparison:
// the adapter binds the persisted bytes through the content digest instead.
pub fn decode_prompt_generation_response(value: str) -> Result<PromptGenerationResponse, Error> {
  arena {
    decoded: PromptGenerationResponse := json.decode(value)?
    return Ok(clone_prompt_generation_response(decoded))
  }
}

