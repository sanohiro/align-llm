  source_verifier_runtime: string,
  source_verifier_interpreter_sha256: string,
  git_executable_sha256: string,
  // The third explicit-input leg: the derived generation child is never a corpus member, so the
  // locator records the digest the gate must observe and the validator binds the supplied
  // `--generation-child-sha256` to it.
  generation_child_sha256: string,
  content_sha256: string,
}

fn digest_text(value: str) -> string {
  digest := crypto.sha256(value)
  return encoding.hex_encode(digest[0..digest.len()]).clone()
}

fn valid_nonempty_text(value: str, maximum: i64) -> bool {
  if value.len() <= 0 || value.len() > maximum {
    return false
  }
  bytes := value.bytes()
  mut index := 0
  loop {
    if index >= bytes.len() {
      break
    }
    if bytes[index] == 0 {
      return false
    }
    index = index + 1
  }
  return true
}

fn valid_ascii_identifier(value: str, maximum: i64) -> bool {
  if !valid_nonempty_text(value, maximum) {
    return false
  }
  bytes := value.bytes()
  mut index := 0
  loop {
    if index >= bytes.len() {
      break
    }
    if bytes[index] > 0x7f {
      return false
    }
    index = index + 1
  }
  return true
}

fn valid_content_digest(value: str) -> bool {
  if value.len() != 64 {
    return false
  }
  bytes := value.bytes()
  mut index := 0
  loop {
    if index >= bytes.len() {
      break
    }
    b := bytes[index]
    if !((b >= 0x30 && b <= 0x39) || (b >= 0x61 && b <= 0x66)) {
      return false
    }
    index = index + 1
  }
  return true
}

fn valid_source_revision(value: str) -> bool {
  if value.len() != 40 && value.len() != 64 {
    return false
  }
  bytes := value.bytes()
  mut index := 0
  loop {
    if index >= bytes.len() { break }
    b := bytes[index]
    if !((b >= 0x30 && b <= 0x39) || (b >= 0x61 && b <= 0x66)) {
      return false
    }
    index = index + 1
  }
  return true
}

fn valid_prompt_text_kind(value: str) -> bool {
  return value == "BASE_PROMPT" ||
  value == "REPO_PROMPT" ||
  value == "TASK_PROMPT" ||
  value == "OPPORTUNITY" ||
  value == "PATCH_EVALUATION" ||
  value == "FAILURE_MEMORY_JSONL" ||
  value == "DIAGNOSTIC_STDOUT" ||
  value == "DIAGNOSTIC_STDERR"
}

fn valid_environment_name(value: str) -> bool {
  if !valid_ascii_identifier(value, 256) {
    return false
  }
  bytes := value.bytes()
  mut index := 0
  loop {
    if index >= bytes.len() {
      break
    }
    b := bytes[index]
    letter := (b >= 0x41 && b <= 0x5a) || (b >= 0x61 && b <= 0x7a)
    if index == 0 {
      if !letter && b != 0x5f {
        return false
      }
    } else {
      digit := b >= 0x30 && b <= 0x39
      if !letter && !digit && b != 0x5f {
        return false
      }
    }
    index = index + 1
  }
  return true
}

// Section 1.2/5.1 endpoint rule: 4,096 bytes, the provider's accepted scheme and host form, no URL
// userinfo, and no credential query or fragment. A credential-bearing query parameter cannot be
// decided from its name, so this owner rejects every query and fragment component rather than
// guessing which parameter carries a secret. `require_tls` is the cloud provider's `https://`-only
// scheme rule already enforced by `provider_openai.validate_request_config`.
fn valid_provider_endpoint(value: str, require_tls: bool) -> bool {
  if !valid_nonempty_text(value, 4096) {
    return false
  }
  scheme_length := if value.starts_with("https://") {
    8
  } else if !require_tls && value.starts_with("http://") {
    7
  } else {
    0
  }
  if scheme_length == 0 {
    return false
  }
  bytes := value.bytes()
  mut index := scheme_length
  mut authority_length := 0
  loop {
    if index >= bytes.len() {
      break
    }
    b := bytes[index]
    if b == 0x2f {
      break
    }
    if b == 0x40 || b == 0x3f || b == 0x23 || b > 0x7f {
      return false
    }
    authority_length = authority_length + 1
    index = index + 1
  }
  if authority_length <= 0 {
    return false
  }
  loop {
    if index >= bytes.len() {
      break
    }
    b := bytes[index]
    if b == 0x3f || b == 0x23 || b > 0x7f {
      return false
    }
    index = index + 1
  }
  return true
}

fn valid_proposal_provider_kind(value: str) -> bool {
  return value == "CLOUD_OPENAI" || value == "LOCAL_OPENAI" || value == "LLAMA_CPP"
}

fn valid_section_limit(enabled: bool, limit: i64, maximum: i64) -> bool {
  if limit < 0 || limit > maximum {
    return false
  }
  if enabled {
    return limit > 0
  }
  return limit == 0
}

fn valid_context_policy(value: ContextPolicy) -> bool {
  if !valid_section_limit(value.include_patch_evaluation, value.max_patch_evaluation_bytes, 65536) {
    return false
  }
  if !valid_section_limit(value.include_failure_memory, value.max_failure_context_bytes, 65536) {
    return false
  }
  if value.max_failure_events < 0 || value.max_failure_events > 64 {
    return false
  }
  if value.include_failure_memory && value.max_failure_events <= 0 {
    return false
  }
  if !value.include_failure_memory && value.max_failure_events != 0 {
    return false
  }
  if !valid_section_limit(value.include_diagnostics, value.max_diagnostic_bytes_per_stream, 65536) {
    return false
  }
  return true
}

fn clone_prompt_text(borrow value: PromptTextArtifact) -> PromptTextArtifact {
  return PromptTextArtifact {
    schema_version: value.schema_version,
    artifact_kind: value.artifact_kind.clone(),
    artifact_id: value.artifact_id.clone(),
    text: value.text.clone(),
    content_sha256: value.content_sha256.clone(),
  }
}

fn clone_prompt_variant_without_digest(borrow value: PromptVariant) -> PromptVariant {
  return PromptVariant {
    schema_version: value.schema_version,
    artifact_kind: value.artifact_kind.clone(),
    variant_id: value.variant_id.clone(),
    base_prompt: clone_prompt_text(value.base_prompt),
    repo_prompt: clone_prompt_text(value.repo_prompt),
    learned_prompt_append: value.learned_prompt_append.clone(),
    context_policy: value.context_policy,
    candidate_id: value.candidate_id.clone(),
    content_sha256: "".clone(),
  }
}

fn clone_corpus_revision_without_digest(borrow value: CorpusRevision) -> CorpusRevision {
  return CorpusRevision {
    schema_version: value.schema_version,
    artifact_kind: value.artifact_kind.clone(),
    source_kind: value.source_kind.clone(),
    source_repository_id: value.source_repository_id.clone(),
    source_sha256: value.source_sha256.clone(),
    content_sha256: "".clone(),
  }
}

fn clone_corpus_revision(borrow value: CorpusRevision) -> CorpusRevision {
  mut cloned := clone_corpus_revision_without_digest(value)
  cloned.content_sha256 = value.content_sha256.clone()
  return cloned
}

fn clone_prompt_scope_without_digest(borrow value: PromptScope) -> PromptScope {
  return PromptScope {
    schema_version: value.schema_version,
    artifact_kind: value.artifact_kind.clone(),
    repo_id: value.repo_id.clone(),
    repo_profile_revision: value.repo_profile_revision.clone(),
    align_revision: value.align_revision.clone(),
    corpus_id: value.corpus_id.clone(),
    corpus_revision: clone_corpus_revision(value.corpus_revision),
    evaluation_provider_kind: value.evaluation_provider_kind.clone(),
    evaluation_provider_model: value.evaluation_provider_model.clone(),
    generation_policy_sha256: value.generation_policy_sha256.clone(),
    acceptance_policy_sha256: value.acceptance_policy_sha256.clone(),
    base_prompt_sha256: value.base_prompt_sha256.clone(),
    repo_prompt_sha256: value.repo_prompt_sha256.clone(),
    content_sha256: "".clone(),
  }
}

pub fn clone_prompt_scope(borrow value: PromptScope) -> PromptScope {
  mut cloned := clone_prompt_scope_without_digest(value)
  cloned.content_sha256 = value.content_sha256.clone()
  return cloned
}

pub fn clone_prompt_variant(borrow value: PromptVariant) -> PromptVariant {
  mut cloned := clone_prompt_variant_without_digest(value)
  cloned.content_sha256 = value.content_sha256.clone()
  return cloned
}

fn clone_prompt_activation_without_digest(borrow value: PromptActivation) -> PromptActivation {
  return PromptActivation {
    schema_version: value.schema_version,
    artifact_kind: value.artifact_kind.clone(),
    activation_id: value.activation_id.clone(),
    operation: value.operation.clone(),
    scope: clone_prompt_scope(value.scope),
    parent_activation_id: value.parent_activation_id.clone(),
    parent_activation_sha256: value.parent_activation_sha256.clone(),
    effective_variant: clone_prompt_variant(value.effective_variant),
    accepted_evaluation_id: value.accepted_evaluation_id.clone(),
    accepted_evaluation_sha256: value.accepted_evaluation_sha256.clone(),
    rollback_target_activation_id: value.rollback_target_activation_id.clone(),
    rollback_target_activation_sha256: value.rollback_target_activation_sha256.clone(),
    decision_reason: value.decision_reason.clone(),
    content_sha256: "".clone(),
  }
}

pub fn clone_prompt_activation(borrow value: PromptActivation) -> PromptActivation {
  mut cloned := clone_prompt_activation_without_digest(value)
  cloned.content_sha256 = value.content_sha256.clone()
  return cloned
}

fn clone_prompt_activation_option(borrow value: Option<PromptActivation>) -> Option<PromptActivation> {
  return match value {
    None => None,
    Some(activation) => Some(clone_prompt_activation(activation)),
  }
}

fn derived_activation_id(value: str) -> string {
  output := builder()
  output.write(value)
  output.write("/activation")
  return output.to_string()
}

fn valid_corpus_source_identity(borrow value: CorpusRevision) -> bool {
  if value.source_kind == "GIT_COMMIT" {
    return valid_ascii_identifier(value.source_repository_id, 128)
  }
  if value.source_kind == "FILE_SET" {
    return value.source_repository_id.len() == 0
  }
  return false
}

fn valid_scope_shape(borrow value: PromptScope) -> bool {
  return value.schema_version == 1 &&
  value.artifact_kind == "PROMPT_SCOPE" &&
  valid_ascii_identifier(value.repo_id, 128) &&
  valid_nonempty_text(value.repo_profile_revision, 256) &&
  valid_source_revision(value.align_revision) &&
  valid_ascii_identifier(value.corpus_id, 128) &&
  value.corpus_revision.schema_version == 1 &&
  value.corpus_revision.artifact_kind == "CORPUS_REVISION" &&
  valid_corpus_source_identity(value.corpus_revision) &&
  if value.corpus_revision.source_kind == "GIT_COMMIT" {
    valid_source_revision(value.corpus_revision.source_sha256)
  } else {
    valid_content_digest(value.corpus_revision.source_sha256)
  } &&
  valid_content_digest(value.corpus_revision.content_sha256) &&
  (value.evaluation_provider_kind == "FIXTURE" ||
    value.evaluation_provider_kind == "CLOUD_OPENAI" ||
    value.evaluation_provider_kind == "LOCAL_OPENAI" ||
    value.evaluation_provider_kind == "LLAMA_CPP") &&
  valid_nonempty_text(value.evaluation_provider_model, 256) &&
  valid_content_digest(value.generation_policy_sha256) &&
  valid_content_digest(value.acceptance_policy_sha256) &&
  valid_content_digest(value.base_prompt_sha256) &&
  valid_content_digest(value.repo_prompt_sha256) &&
  valid_content_digest(value.content_sha256)
}

fn valid_variant_shape(borrow value: PromptVariant) -> bool {
  return value.schema_version == 1 &&
  value.artifact_kind == "PROMPT_VARIANT" &&
  valid_ascii_identifier(value.variant_id, 128) &&
  value.base_prompt.schema_version == 1 &&
  value.base_prompt.artifact_kind == "BASE_PROMPT" &&
  valid_ascii_identifier(value.base_prompt.artifact_id, 128) &&
  value.base_prompt.text.len() <= 65536 &&
  valid_content_digest(value.base_prompt.content_sha256) &&
  value.repo_prompt.schema_version == 1 &&
  value.repo_prompt.artifact_kind == "REPO_PROMPT" &&
  valid_ascii_identifier(value.repo_prompt.artifact_id, 128) &&
  value.repo_prompt.text.len() <= 65536 &&
  valid_content_digest(value.repo_prompt.content_sha256) &&
  value.learned_prompt_append.len() <= 8192 &&
  valid_context_policy(value.context_policy) &&
  valid_ascii_identifier(value.candidate_id, 128) &&
  valid_content_digest(value.content_sha256)
}

fn valid_activation_shape(borrow value: PromptActivation) -> bool {
  if value.schema_version != 1 || value.artifact_kind != "PROMPT_ACTIVATION" ||
  !valid_ascii_identifier(value.activation_id, 128) ||
  !valid_scope_shape(value.scope) || !valid_variant_shape(value.effective_variant) ||
  value.effective_variant.base_prompt.content_sha256 != value.scope.base_prompt_sha256 ||
  value.effective_variant.repo_prompt.content_sha256 != value.scope.repo_prompt_sha256 ||
  !valid_content_digest(value.content_sha256) {
    return false
  }
  parent_empty := value.parent_activation_id.len() == 0 && value.parent_activation_sha256.len() == 0
  parent_present := valid_ascii_identifier(value.parent_activation_id, 128) &&
  valid_content_digest(value.parent_activation_sha256)
  accepted_empty := value.accepted_evaluation_id.len() == 0 && value.accepted_evaluation_sha256.len() == 0
  accepted_present := valid_ascii_identifier(value.accepted_evaluation_id, 128) &&
  valid_content_digest(value.accepted_evaluation_sha256)
  rollback_empty := value.rollback_target_activation_id.len() == 0 &&
  value.rollback_target_activation_sha256.len() == 0
  rollback_present := valid_ascii_identifier(value.rollback_target_activation_id, 128) &&
  valid_content_digest(value.rollback_target_activation_sha256)
  if value.operation == "BASELINE" {
    return parent_empty && accepted_empty && rollback_empty && value.decision_reason.len() == 0
  }
  if value.operation == "ACCEPT" {
    return parent_present && accepted_present && rollback_empty && value.decision_reason.len() == 0
  }
  if value.operation == "ROLLBACK" {
    return parent_present && (accepted_empty || accepted_present) && rollback_present &&
    valid_nonempty_text(value.decision_reason, 4096)
  }
  return false
}

pub fn prompt_text_content_digest(borrow value: PromptTextArtifact) -> Result<string, Error> {
  mut normalized := clone_prompt_text(value)
  normalized.content_sha256 = "".clone()
  canonical := json.encode_bounded(normalized, 2097152)?
  return Ok(digest_text(canonical))
}

pub fn verify_prompt_text_content(borrow value: PromptTextArtifact) -> bool {
  if value.schema_version != 1 ||
  !valid_prompt_text_kind(value.artifact_kind) ||
  !valid_ascii_identifier(value.artifact_id, 128) ||
  !valid_content_digest(value.content_sha256) {
    return false
  }
  expected := prompt_text_content_digest(value) else {
    return false
  }
  return expected == value.content_sha256
}

pub fn prompt_variant_content_digest(borrow value: PromptVariant) -> Result<string, Error> {
  normalized := clone_prompt_variant_without_digest(value)
  canonical := json.encode_bounded(normalized, 2097152)?
  return Ok(digest_text(canonical))
}

pub fn verify_prompt_variant_content(borrow value: PromptVariant) -> bool {
  if value.schema_version != 1 ||
  value.artifact_kind != "PROMPT_VARIANT" ||
  !valid_ascii_identifier(value.variant_id, 128) ||
  !valid_ascii_identifier(value.candidate_id, 128) ||
  !valid_context_policy(value.context_policy) ||
  !valid_content_digest(value.content_sha256) ||
  value.base_prompt.artifact_kind != "BASE_PROMPT" ||
  value.repo_prompt.artifact_kind != "REPO_PROMPT" ||
  value.base_prompt.text.len() > 65536 ||
  value.repo_prompt.text.len() > 65536 ||
  value.learned_prompt_append.len() > 8192 ||
  !verify_prompt_text_content(value.base_prompt) ||
  !verify_prompt_text_content(value.repo_prompt) {
    return false
  }
  expected := prompt_variant_content_digest(value) else {
    return false
  }
  return expected == value.content_sha256
}

fn corpus_revision_content_digest(borrow value: CorpusRevision) -> Result<string, Error> {
  normalized := clone_corpus_revision_without_digest(value)
  canonical := json.encode_bounded(normalized, 2097152)?
  return Ok(digest_text(canonical))
}

fn verify_corpus_revision_content(borrow value: CorpusRevision) -> bool {
  if value.schema_version != 1 || value.artifact_kind != "CORPUS_REVISION" ||
  !valid_corpus_source_identity(value) ||
  !(if value.source_kind == "GIT_COMMIT" {
      valid_source_revision(value.source_sha256)
    } else {
      valid_content_digest(value.source_sha256)
    }) || !valid_content_digest(value.content_sha256) {
    return false
  }
  expected := corpus_revision_content_digest(value) else {
    return false
  }
  return expected == value.content_sha256
}

fn prompt_scope_content_digest(borrow value: PromptScope) -> Result<string, Error> {
  normalized := clone_prompt_scope_without_digest(value)
  canonical := json.encode_bounded(normalized, 2097152)?
  return Ok(digest_text(canonical))
}

fn verify_prompt_scope_content(borrow value: PromptScope) -> bool {
  if !valid_scope_shape(value) || !verify_corpus_revision_content(value.corpus_revision) {
    return false
  }
  expected := prompt_scope_content_digest(value) else {
    return false
  }
  return expected == value.content_sha256
}

pub fn prompt_activation_content_digest(borrow value: PromptActivation) -> Result<string, Error> {
