// A one-field projection decodes any document: `json.decode` requires every DECLARED field
// exactly once and skips undeclared keys, so this reads the container's version before any field
// of the real record is touched.
PromptDocumentVersion {
  schema_version: i64,
}

pub fn peek_document_schema_version(value: str) -> Result<i64, Error> {
  peeked: PromptDocumentVersion := json.decode(value)?
  return Ok(peeked.schema_version)
