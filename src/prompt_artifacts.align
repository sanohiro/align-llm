// The canonical input form for the one optional generation-request field: the canonical encoder
// omits a `None`, and an explicit `null` immediately before `rendered_prompt_path` normalizes to
// the same `None`.
pub fn decode_prompt_generation_request(value: str) -> Result<PromptGenerationRequest, Error> {
  decoded: PromptGenerationRequest := json.decode(value)?
  canonical_value: PromptGenerationRequest := json.decode(value)?
  canonical: string := json.encode(canonical_value).clone()
  canonical_view: str := canonical
  if canonical_view != value {
    shape: PromptGenerationRequest := json.decode(value)?
    absent := match shape.api_key_env { None => true, Some(_) => false }
    if !absent { return Err(Error.Invalid) }
    explicit: string := canonical_with_explicit_null(
      canonical_view,
      "\"rendered_prompt_path\":",
      "api_key_env",
    )?
    explicit_view: str := explicit
    if explicit_view != value { return Err(Error.Invalid) }
  }
  return Ok(decoded)
}

pub fn encode_prompt_generation_request(value: PromptGenerationRequest) -> string {
