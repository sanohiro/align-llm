module prompt_artifacts

import core.json
import std.crypto
import std.encoding

// C6a1/C6a2 owns the persisted declared-record graph. Every text field in this module is an
// explicitly owned `string`; borrowed `str` values are accepted only at the codec boundary.

fn canonical_with_explicit_null(canonical: str, anchor: str, field: str) -> Result<string, Error> {
  offset := canonical.find(anchor) else { return Err(Error.Invalid) }
  output := builder()
  output.write(canonical[0..offset])
  output.write("\"")
  output.write(field)
  output.write("\":null,")
  output.write(canonical[offset..canonical.len()])
  return Ok(output.to_string())
}

