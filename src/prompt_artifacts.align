pub PromptEvaluationTask {
  schema_version: i64,
  artifact_kind: string,
  task_id: string,
  repo_id: string,
  repo_revision: string,
  repo_path: string,
  require_clean_repo: bool,
  cmd: string,
  argv: array<string>,
  snapshot_cmd: string,
  snapshot_argv: array<string>,
  measurement_adapter_runtime: string,
  snapshot_helper_runtime: string,
  cwd: string,
  timeout_ns: i64,
  task_prompt_path: string,
  context_sources_path: string,
  generation_policy_path: string,
  provider_control_path: string,
  environment_policy_path: string,
  validation_runner_path: string,
  validation_runner_sha256: string,
  task_definition_path: string,
  task_definition_sha256: string,
  validation_argv: array<string>,
  patch_path: Option<string>,
  patch_sha256: Option<string>,
  artifacts: array<ArtifactExpectation>,
  regression_limits: RegressionLimits,
  // C4-REPAIR-MEASURED. `Option::None` for every corpus frozen before the repair attempt existed,
  // and the canonical encoder omits a `None`, so the three `eval/tasks/prompt-v1/*.json` manifests
  // keep their exact bytes and their exact `content_sha256`. A task declaring
  // `maximum_repair_loops >= 1` must declare the pair; the scorer enforces that pairing.
  repair_template_path: Option<string>,
  repair_template_sha256: Option<string>,
  // C4-REPAIR-TEMPLATE's declared edit policy, `Some` exactly for a task whose `argv` names
  // `scripts/prompt-template-adapter.py` and absent otherwise, on the same optional-member
  // mechanism the repair-template pair above uses. The producer emits it, so the record must
  // declare it: a member the evaluator writes and this record omits does not merely go
  // unvalidated, it makes the whole document fail to decode and the run unpublishable.
  edit_policy: Option<EditPolicy>,
  content_sha256: string,
}

pub RegressionLimits {
  maximum_unrelated_diff_count: i64,
  maximum_patch_size_bytes: i64,
  maximum_public_api_change_count: i64,
  maximum_repair_loops: i64,
  maximum_benchmark_regression_ppm: Option<i64>,
}

// C4-REPAIR-EDITSET. One file the previous attempt rewrote, as the model wrote it.
//
// `body_bytes` is the redacted body's full length before any omission, and `body_sha256` digests
// those same redacted bytes. Digesting before redaction would make the persisted digest a
// credential oracle: anyone holding a candidate credential could confirm it by recomputing the
// digest. `body_text` is `Some` when the block was inside the producer's `EDIT_SET_LIMIT` budget
// and `None` when it was not; an omitted block keeps its path, length, and digest and loses only
// its text, so a reader can see exactly what the budget removed. Bounding is whole-block and the
// carried set is a prefix of the ascending path order: once one block would take the running total
// past the budget, that block and every block after it lose their text. A half-truncated source
// file would invite the model to complete a file it can only half see.
pub EditSetBlock {
  schema_version: i64,
  artifact_kind: string,
  path: string,
  body_bytes: i64,
  body_sha256: string,
  body_text: Option<string>,
  content_sha256: string,
}

// Both persisted versions of one measurement. The version-2 members are `Option` on the wire
// because the canonical encoder omits a `None`, so a version-1 measurement decodes and re-encodes
// byte-identically and both frozen chains — C6's and C4-REPAIR-MEASURED's — keep validating.
// Presence is NOT how the version is detected: the scorer reads `schema_version` first, then
// requires every version-2 member absent at version 1 and, for the one member that is
// unconditionally present, `Some` at version 2. There is no compatibility default and no presence
// sniffing.
pub TaskMeasurement {
  schema_version: i64,
  artifact_kind: string,
  status: string,
  failure_kind: string,
  build_status: string,
  test_status: string,
  repair_loop_count: i64,
  unrelated_diff_count: i64,
  patch_size_bytes: i64,
  public_api_change_count: i64,
  policy_violation_count: i64,
  cleanup_passed: bool,
  containment_passed: bool,
  benchmark_regression_ppm: Option<i64>,
  generation_to_passing_patch_ns: Option<i64>,
  rendered_prompt_sha256: string,
  generation_request: GenerationRequestIdentity,
  environment_probe: EnvironmentProbe,
  seed_attestation: SeedCapabilityAttestation,
  diagnostic_summary: string,
  diagnostic_stdout: string,
  diagnostic_stderr: string,
  // The four version-2 members, in their declared position immediately before `content_sha256`.
  // `edit_set` is `Some` exactly when the attempt's response produced a validated edit set **and**
  // a non-empty patch was synthesized from it; a response whose every hunk is empty resets all
  // three of `edit_set`, `edit_set_total_bytes`, and `patch_sha256` to `None`, which is the
  // measured dominant mode on the C4 corpus (`docs/specs/c4-repair-editset.md` §11.3 deviation 14);
  // `edit_set_total_bytes` is `Some` exactly with it and is the pre-omission sum of `body_bytes`;
  // `patch_sha256` is `Some` exactly when a patch reached the validation runner, which makes
  // "attempt 2 re-sent attempt 1's patch" a checkable fact rather than an inference from a byte
  // count; `base_adapter_runtime_identity` is always `Some` at version 2 and records which frozen
  // adapter the second adapter loaded, separately from the probe's own identity.
  edit_set: Option<array<EditSetBlock>>,
  edit_set_total_bytes: Option<i64>,
  patch_sha256: Option<string>,
  base_adapter_runtime_identity: Option<string>,
  // The four version-3 members, in their declared position immediately before `content_sha256`
  // and by the same rule version 2 used: the version selects the member list, presence never
  // selects the version. `edit_refusal` is always `Some` at version 3 — `NONE` when nothing was
  // refused — so the counted quantity is defined for every ran attempt rather than inferred from
  // an absence; it names one raise site of the frozen adapter, which `failure_kind: PATCH` alone
  // could not distinguish and which three design documents therefore read wrong.
  // `completion_bytes` and `completion_sha256` are `Some` whenever a provider response was
  // received and digest the **redacted** completion at its full length, so "attempt 2 re-sent
  // attempt 1's whole answer" is a measured fact at zero disclosure cost. `completion_text` is
  // `Some` only on the eight refusal codes for which no structured substitute exists, and is
  // dropped whole rather than partially when the encoded result would exceed its bound.
  edit_refusal: Option<string>,
  completion_bytes: Option<i64>,
  completion_sha256: Option<string>,
  completion_text: Option<string>,
  content_sha256: string,
}

// C4-REPAIR-TEMPLATE. The edit policy the pinned adapters enforce, declared rather than emergent.
//
// The two bounds are today's constants in five scripts and `refuse_unchanged_files` was, until
// this record existed, an unstated consequence of `synthesized_patch` refusing an empty diff — the
// rule ten of twenty-two ran attempts broke and no prompt in the repository stated. Declaring them
// changes no behaviour: the evaluator refuses a value that differs from its own constants before
// any provider call, because the pinned adapters enforce exactly those values and nothing else.
// The record is carried on the task manifest and not in the task definition, because
// `eval/runners/run-coding-task.py` is byte-frozen and rejects any key outside its required set.
pub EditPolicy {
  schema_version: i64,
  artifact_kind: string,
  maximum_file_blocks: i64,
  maximum_edit_bytes: i64,
  refuse_unchanged_files: bool,
  content_sha256: string,
}

// The sealed repair prompt's provenance: which template produced it, which attempt's persisted
// measurement it consumed, and which sections survived the fixed drop ladder. It exists so a
// verifier can re-derive the repair prompt from the row alone.
pub RepairPromptSource {
  schema_version: i64,
  artifact_kind: string,
  template_sha256: string,
  source_attempt_index: i64,
  source_measurement_sha256: string,
  included_sections: array<string>,
  dropped_sections: array<string>,
  assembled_bytes: i64,
  content_sha256: string,
}

// One ordinary adapter invocation inside a row. A `SKIPPED` attempt carries identity and the
// preparation work that reached the skip decision, and nothing else: no rendered prompt, no
// adapter request, no generation request, no measurement.
pub TaskAttemptRecord {
  schema_version: i64,
  artifact_kind: string,
  attempt_index: i64,
  attempt_kind: string,
  status: string,
  skip_reason: string,
  rendered_prompt_sha256: Option<string>,
  repair_prompt_source: Option<RepairPromptSource>,
  adapter_request_sha256: Option<string>,
  // Each attempt is its own contained invocation with its own sealed prompt, so it produces its
  // own snapshot request, before/after results, and input snapshot. `snapshot_attestations` stays
  // one record per row because its schedule check binds it positionally; these four keep every
  // trace record bound to the invocation that produced it once a row can run twice.
  snapshot_request_sha256: Option<string>,
  before_snapshot_result_sha256: Option<string>,
  after_snapshot_result_sha256: Option<string>,
  input_snapshot_sha256: Option<string>,
  generation_request: Option<GenerationRequestIdentity>,
  seed_attestation: Option<SeedCapabilityAttestation>,
  paired_seed: i64,
  measurement: Option<TaskMeasurement>,
  repair_preparation_ns: i64,
  adapter_elapsed_ns: i64,
  adapter_overhead_ns: Option<i64>,
  measurement_sha256: Option<string>,
  content_sha256: string,
}

// One row, both persisted versions. The version-2 members are `Option` on the wire because the
// canonical encoder omits a `None`, so a version-1 row decodes and re-encodes byte-identically
// and the frozen C6 chain keeps validating. Presence is NOT how the version is detected: the
// scorer selects by `schema_version` and then REQUIRES every version-2 member to be present at
// version 2 and absent at version 1, rejecting either mismatch. There is no compatibility
// default and no presence sniffing.
pub PromptTaskRow {
  schema_version: i64,
  artifact_kind: string,
  evaluation_id: string,
  task_id: string,
  sample_index: i64,
  variant: string,
  variant_id: string,
  variant_sha256: string,
  prompt_preparation_ns: i64,
  repair_loop_count: Option<i64>,
  generation_to_passing_patch_ns: Option<i64>,
  time_to_passing_patch_ns: Option<i64>,
  attempts: Option<array<TaskAttemptRecord>>,
  evaluation_input: EvaluationInputIdentity,
  measurement: TaskMeasurement,
  content_sha256: string,
}

pub PromptTraceOverflow {
  schema_version: i64,
  artifact_kind: string,
  attempted_invocation_count: i64,
  trace_record_count: i64,
  trace_digest_sha256: string,
  content_sha256: string,
}

