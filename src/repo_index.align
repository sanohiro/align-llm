module repo_index

import core.json
import std.fs
import std.path
import verify

// C2 remains repository-boundary-first: Git supplies the tracked file list, including names that
// contain newlines. The Align parser records lexical references and resolves the ones that can be
// tied to tracked user symbols; external builtins, private symbols, and missing targets stay
// explicit in the result. Related-test selection is path-based until symbol-specific ranking is
// available.

pub IndexStatus { Ready, Partial, Failed }

pub IndexBuild {
  document: string,
  status: IndexStatus,
  file_count: i64,
  symbol_count: i64,
  import_count: i64,
  reference_count: i64,
  test_count: i64,
  unreadable_count: i64,
}

pub TestSelection {
  document: string,
  status: IndexStatus,
  changed_path: string,
  candidate_count: i64,
}

IndexMeta {
  schema_version: i64,
  root: str,
  revision: str,
  status: str,
  error_code: i64,
  file_count: i64,
  symbol_count: i64,
  import_count: i64,
  reference_count: i64,
  test_count: i64,
  unreadable_count: i64,
}

IndexFile {
  path: str,
  language: str,
  line_count: i64,
  readable: bool,
  is_test: bool,
}

IndexSymbol { path: str, name: str, kind: str, line: i64 }
IndexImport { path: str, name: str, line: i64 }
IndexReference {
  path: str,
  qualifier: str,
  name: str,
  kind: str,
  resolution: str,
  target_path: str,
  target_name: str,
  line: i64,
}
IndexTest { path: str, reason: str }

SelectionMeta {
  schema_version: i64,
  root: str,
  revision: str,
  status: str,
  error_code: i64,
  changed_path: str,
  candidate_count: i64,
}

RelatedTest { path: str, score: i64, reason: str }

FileFragments {
  file_json: string,
  symbols_json: string,
  imports_json: string,
  references_json: string,
  tests_json: string,
  symbol_count: i64,
  import_count: i64,
  reference_count: i64,
  test_count: i64,
  readable: bool,
}

pub fn build(root: str, timeout_ns: i64) -> IndexBuild {
  revision_run := verify.run("git", ["git", "rev-parse", "--verify", "HEAD"].to_array(), root, timeout_ns)
  if !process_succeeded(revision_run.status, revision_run.code) {
    failed_root := root.clone()
    failed_document := render_document(failed_root, "", "error", revision_run.code, 0, 0, 0, 0, 0, 0, "", "", "", "", "")
    return IndexBuild {
      document: failed_document.clone(),
      status: IndexStatus.Failed,
      file_count: 0,
      symbol_count: 0,
      import_count: 0,
      reference_count: 0,
      test_count: 0,
      unreadable_count: 0,
    }
  }
  revision := revision_run.stdout.trim().clone()

  files_run := verify.run("git", ["git", "ls-files", "-z"].to_array(), root, timeout_ns)
  if !process_succeeded(files_run.status, files_run.code) {
    failed_root := root.clone()
    failed_document := render_document(failed_root, "", "error", files_run.code, 0, 0, 0, 0, 0, 0, "", "", "", "", "")
    return IndexBuild {
      document: failed_document.clone(),
      status: IndexStatus.Failed,
      file_count: 0,
      symbol_count: 0,
      import_count: 0,
      reference_count: 0,
      test_count: 0,
      unreadable_count: 0,
    }
  }

  mut files_body := builder()
  mut symbols_body := builder()
  mut imports_body := builder()
  mut references_body := builder()
  mut tests_body := builder()
  mut file_count := 0
  mut symbol_count := 0
  mut import_count := 0
  mut reference_count := 0
  mut test_count := 0
  mut unreadable_count := 0
  mut file_cursor := 0
  mut first_file := true
  mut first_symbol := true
  mut first_import := true
  mut first_reference := true
  mut first_test := true
  listing: str := files_run.stdout

  loop {
    if file_cursor >= listing.len() { break }
    file_end := match listing[file_cursor..listing.len()].find("\0") {
      Some(offset) => file_cursor + offset,
      None => listing.len(),
    }
    relative := listing[file_cursor..file_end]
    file_cursor = if file_end < listing.len() { file_end + 1 } else { listing.len() }
    if relative.len() == 0 { break }

    fragments := inspect_file(root, relative, listing)
    if !first_file { files_body.write(",") }
    first_file = false
    files_body.write(fragments.file_json)
    if fragments.symbol_count > 0 { symbol_count = symbol_count + fragments.symbol_count }
    if fragments.import_count > 0 { import_count = import_count + fragments.import_count }
    if fragments.reference_count > 0 { reference_count = reference_count + fragments.reference_count }
    if fragments.test_count > 0 { test_count = test_count + fragments.test_count }
    if !fragments.readable { unreadable_count = unreadable_count + 1 }
    file_count = file_count + 1

    if fragments.symbols_json.len() > 0 {
      if !first_symbol { symbols_body.write(",") }
      first_symbol = false
      symbols_body.write(fragments.symbols_json)
    }
    if fragments.imports_json.len() > 0 {
      if !first_import { imports_body.write(",") }
      first_import = false
      imports_body.write(fragments.imports_json)
    }
    if fragments.references_json.len() > 0 {
      if !first_reference { references_body.write(",") }
      first_reference = false
      references_body.write(fragments.references_json)
    }
    if fragments.tests_json.len() > 0 {
      if !first_test { tests_body.write(",") }
      first_test = false
      tests_body.write(fragments.tests_json)
    }
  }

  status := if unreadable_count == 0 { "ok" } else { "partial" }
  build_status := if unreadable_count == 0 { IndexStatus.Ready } else { IndexStatus.Partial }
  document: string := render_document(
    root,
    revision,
    status,
    -1,
    file_count,
    symbol_count,
    import_count,
    reference_count,
    test_count,
    unreadable_count,
    files_body.to_string(),
    symbols_body.to_string(),
    imports_body.to_string(),
    references_body.to_string(),
    tests_body.to_string(),
  )
  return IndexBuild {
    document: document.clone(),
    status: build_status,
    file_count: file_count,
    symbol_count: symbol_count,
    import_count: import_count,
    reference_count: reference_count,
    test_count: test_count,
    unreadable_count: unreadable_count,
  }
}

pub fn select_tests(root: str, changed_path: str, timeout_ns: i64) -> TestSelection {
  revision_run := verify.run("git", ["git", "rev-parse", "--verify", "HEAD"].to_array(), root, timeout_ns)
  if !process_succeeded(revision_run.status, revision_run.code) {
    failed_root := root.clone()
    failed_changed_path := changed_path.clone()
    failed_document := render_selection_document(failed_root, "", "error", revision_run.code, failed_changed_path, 0, "")
    return TestSelection {
      document: failed_document.clone(),
      status: IndexStatus.Failed,
      changed_path: changed_path.clone(),
      candidate_count: 0,
    }
  }
  revision := revision_run.stdout.trim().clone()

  files_run := verify.run("git", ["git", "ls-files", "-z"].to_array(), root, timeout_ns)
  if !process_succeeded(files_run.status, files_run.code) {
    failed_root := root.clone()
    failed_changed_path := changed_path.clone()
    failed_document := render_selection_document(failed_root, "", "error", files_run.code, failed_changed_path, 0, "")
    return TestSelection {
      document: failed_document.clone(),
      status: IndexStatus.Failed,
      changed_path: changed_path.clone(),
      candidate_count: 0,
    }
  }

  // The score is the sum of the only two ranking signals below: basename (100) and
  // directory (20). Bucket the four possible values in one tracked-file pass instead of
  // rescanning the complete Git listing once for every integer from 120 through 0.
  mut score_120_body := builder()
  mut score_100_body := builder()
  mut score_20_body := builder()
  mut score_0_body := builder()
  mut score_120_count := 0
  mut score_100_count := 0
  mut score_20_count := 0
  mut score_0_count := 0
  listing: str := files_run.stdout
  mut file_cursor := 0
  loop {
    if file_cursor >= listing.len() { break }
    file_end := match listing[file_cursor..listing.len()].find("\0") {
      Some(offset) => file_cursor + offset,
      None => listing.len(),
    }
    relative := listing[file_cursor..file_end]
    file_cursor = if file_end < listing.len() { file_end + 1 } else { listing.len() }
    if relative.len() == 0 { break }
    if is_test_path(relative) {
      score := related_test_score(changed_path, relative)
      reason := related_test_reason(changed_path, relative)
      record := RelatedTest { path: relative, score: score, reason: reason }
      encoded := json.encode(record)
      if score == 120 {
        if score_120_count > 0 { score_120_body.write(",") }
        score_120_body.write(encoded)
        score_120_count = score_120_count + 1
      } else {
        if score == 100 {
          if score_100_count > 0 { score_100_body.write(",") }
          score_100_body.write(encoded)
          score_100_count = score_100_count + 1
        } else {
          if score == 20 {
            if score_20_count > 0 { score_20_body.write(",") }
            score_20_body.write(encoded)
            score_20_count = score_20_count + 1
          } else {
            if score_0_count > 0 { score_0_body.write(",") }
            score_0_body.write(encoded)
            score_0_count = score_0_count + 1
          }
        }
      }
    }
  }

  mut candidates_body := builder()
  candidates_body.write(score_120_body.to_string())
  if score_100_count > 0 {
    if score_120_count > 0 { candidates_body.write(",") }
    candidates_body.write(score_100_body.to_string())
  }
  if score_20_count > 0 {
    if score_120_count + score_100_count > 0 { candidates_body.write(",") }
    candidates_body.write(score_20_body.to_string())
  }
  if score_0_count > 0 {
    if score_120_count + score_100_count + score_20_count > 0 { candidates_body.write(",") }
    candidates_body.write(score_0_body.to_string())
  }
  candidate_count := score_120_count + score_100_count + score_20_count + score_0_count

  document := render_selection_document(
    root,
    revision,
    "ok",
    -1,
    changed_path,
    candidate_count,
    candidates_body.to_string(),
  )
  return TestSelection {
    document: document.clone(),
    status: IndexStatus.Ready,
    changed_path: changed_path.clone(),
    candidate_count: candidate_count,
  }
}

fn render_document(
  root: str,
  revision: str,
  status: str,
  error_code: i64,
  file_count: i64,
  symbol_count: i64,
  import_count: i64,
  reference_count: i64,
  test_count: i64,
  unreadable_count: i64,
  files_json: str,
  symbols_json: str,
  imports_json: str,
  references_json: str,
  tests_json: str,
) -> string {
  meta := IndexMeta {
    schema_version: 3,
    root: root,
    revision: revision,
    status: status,
    error_code: error_code,
    file_count: file_count,
    symbol_count: symbol_count,
    import_count: import_count,
    reference_count: reference_count,
    test_count: test_count,
    unreadable_count: unreadable_count,
  }
  meta_json := json.encode(meta)
  b := builder()
  b.write(meta_json[0..meta_json.len() - 1])
  b.write(",\"files\":[")
  b.write(files_json)
  b.write("],\"symbols\":[")
  b.write(symbols_json)
  b.write("],\"imports\":[")
  b.write(imports_json)
  b.write("],\"references\":[")
  b.write(references_json)
  b.write("],\"test_candidates\":[")
  b.write(tests_json)
  b.write("]}")
  return b.to_string()
}

fn render_selection_document(
  root: str,
  revision: str,
  status: str,
  error_code: i64,
  changed_path: str,
  candidate_count: i64,
  candidates_json: str,
) -> string {
  meta := SelectionMeta {
    schema_version: 1,
    root: root,
    revision: revision,
    status: status,
    error_code: error_code,
    changed_path: changed_path,
    candidate_count: candidate_count,
  }
  meta_json := json.encode(meta)
  b := builder()
  b.write(meta_json[0..meta_json.len() - 1])
  b.write(",\"candidates\":[")
  b.write(candidates_json)
  b.write("]}")
  return b.to_string()
}

fn inspect_file(root: str, relative: str, listing: str) -> FileFragments {
  full_path := path.join(root, relative)
  source := fs.read_file(full_path) else {
    file_record := IndexFile {
      path: relative,
      language: language_of(relative),
      line_count: -1,
      readable: false,
      is_test: is_test_path(relative),
    }
    return FileFragments {
      file_json: json.encode(file_record).clone(),
      symbols_json: "".clone(),
      imports_json: "".clone(),
      references_json: "".clone(),
      tests_json: test_json(relative),
      symbol_count: 0,
      import_count: 0,
      reference_count: 0,
      test_count: if is_test_path(relative) { 1 } else { 0 },
      readable: false,
    }
  }

  mut symbols_body := builder()
  mut imports_body := builder()
  mut references_body := builder()
  mut symbol_count := 0
  mut import_count := 0
  mut reference_count := 0
  mut first_symbol := true
  mut first_import := true
  mut cursor := 0
  mut line_number := 1
  align_source := relative.ends_with(".align")
  loop {
    if cursor >= source.len() { break }
    line_end := match source[cursor..source.len()].find("\n") {
      Some(offset) => cursor + offset,
      None => source.len(),
    }
    line := source[cursor..line_end].trim_end()
    top_level := line == line.trim_start()
    trimmed := line.trim()
    if align_source {
      code := strip_literals_and_comments(line)
      extracted := extract_references(root, relative, source, code, line_number, listing)
      if extracted.json.len() > 0 {
        if reference_count > 0 { references_body.write(",") }
        references_body.write(extracted.json)
      }
      reference_count = reference_count + extracted.count
    }
    if align_source && top_level && trimmed.len() > 0 && !trimmed.starts_with("//") {
      if trimmed.starts_with("import ") {
        module_name := first_token(trimmed[7..trimmed.len()])
        import_record := IndexImport { path: relative, name: module_name, line: line_number }
        import_json := json.encode(import_record)
        if !first_import { imports_body.write(",") }
        first_import = false
        imports_body.write(import_json)
        import_count = import_count + 1
      } else {
        symbol_name := declaration_name(trimmed)
        symbol_kind := declaration_kind(trimmed)
        if symbol_name.len() > 0 {
          symbol_record := IndexSymbol { path: relative, name: symbol_name, kind: symbol_kind, line: line_number }
          symbol_json := json.encode(symbol_record)
          if !first_symbol { symbols_body.write(",") }
          first_symbol = false
          symbols_body.write(symbol_json)
          symbol_count = symbol_count + 1
        }
      }
    }
    cursor = if line_end < source.len() { line_end + 1 } else { source.len() }
    line_number = line_number + 1
  }

  file_record := IndexFile {
    path: relative,
    language: language_of(relative),
    line_count: count_lines(source),
    readable: true,
    is_test: is_test_path(relative),
  }
  return FileFragments {
    file_json: json.encode(file_record).clone(),
    symbols_json: symbols_body.to_string(),
    imports_json: imports_body.to_string(),
    references_json: references_body.to_string(),
    tests_json: test_json(relative),
    symbol_count: symbol_count,
    import_count: import_count,
    reference_count: reference_count,
    test_count: if is_test_path(relative) { 1 } else { 0 },
    readable: true,
  }
}

ReferenceLine { json: string, count: i64 }
Resolution { status: string, target_path: string }

fn extract_references(root: str, path_name: str, source: str, code: str, line_number: i64, listing: str) -> ReferenceLine {
  mut body := builder()
  mut count := 0
  mut cursor := 0
  mut definition_open_skipped := false
  function_name := declaration_function_name(code.trim())
  loop {
    if cursor >= code.len() { break }
    remaining := code[cursor..code.len()]
    remaining_len := remaining.len()
    dot_offset := remaining.find(".") else remaining_len
    open_offset := remaining.find("(") else remaining_len
    if dot_offset == remaining_len && open_offset == remaining_len { break }

    if dot_offset < open_offset {
      dot := cursor + dot_offset
      qualifier := last_token(code[0..dot])
      name := first_segment(code[dot + 1..code.len()])
      if qualifier.len() > 0 && name.len() > 0 && is_reference_identifier(name) && is_imported_qualifier(source, qualifier) {
        resolution := resolve_reference(root, path_name, source, qualifier, name, "qualified", listing)
        resolution_status: str := resolution.status
        target_path: str := resolution.target_path
        record := IndexReference {
          path: path_name,
          qualifier: qualifier,
          name: name,
          kind: "qualified",
          resolution: resolution_status,
          target_path: target_path,
          target_name: name,
          line: line_number,
        }
        if count > 0 { body.write(",") }
        body.write(json.encode(record))
        count = count + 1
      }
      cursor = dot + 1
    } else {
      open := cursor + open_offset
      before := code[0..open].trim_end()
      name := last_token(before)
      is_definition_open := name == function_name && !definition_open_skipped
      if is_definition_open { definition_open_skipped = true }
      if is_reference_identifier(name) && !before.contains(".") && !is_call_keyword(name) && !is_definition_open {
        resolution := resolve_reference(root, path_name, source, "", name, "local-call", listing)
        resolution_status: str := resolution.status
        target_path: str := resolution.target_path
        record := IndexReference {
          path: path_name,
          qualifier: "",
          name: name,
          kind: "local-call",
          resolution: resolution_status,
          target_path: target_path,
          target_name: name,
          line: line_number,
        }
        if count > 0 { body.write(",") }
        body.write(json.encode(record))
        count = count + 1
      }
      cursor = open + 1
    }
  }
  return ReferenceLine { json: body.to_string(), count: count }
}

fn resolve_reference(
  root: str,
  path_name: str,
  source: str,
  qualifier: str,
  name: str,
  kind: str,
  listing: str,
) -> Resolution {
  if kind == "local-call" {
    if has_local_function(source, name) {
      return Resolution { status: "resolved".clone(), target_path: path_name.clone() }
    }
    return Resolution { status: "unresolved".clone(), target_path: "".clone() }
  }

  module_name := imported_module(source, qualifier) else {
    return Resolution { status: "unresolved".clone(), target_path: "".clone() }
  }
  if module_name.starts_with("core.") || module_name.starts_with("std.") {
    return Resolution { status: "external".clone(), target_path: "".clone() }
  }

  // The index has no single compiler entry file, so use the importing file's directory as the
  // repository-index resolution base.
  directory := path.dir(path_name)
  target_relative := module_file_path(directory, module_name)
  target_relative_view: str := target_relative
  if !is_tracked_path(listing, target_relative_view) {
    return Resolution { status: "unresolved".clone(), target_path: target_relative.clone() }
  }
  target_full := path.join(root, target_relative_view)
  target_source := fs.read_file(target_full) else {
    return Resolution { status: "unresolved".clone(), target_path: target_relative.clone() }
  }
  if !has_module_declaration(target_source, module_name) {
    return Resolution { status: "unresolved".clone(), target_path: target_relative.clone() }
  }
  if has_public_symbol(target_source, name) {
    return Resolution { status: "resolved".clone(), target_path: target_relative.clone() }
  }
  return Resolution { status: "unresolved".clone(), target_path: target_relative.clone() }
}

fn imported_module(source: str, candidate: str) -> Option<str> {
  mut cursor := 0
  loop {
    if cursor >= source.len() { break }
    line_end := match source[cursor..source.len()].find("\n") {
      Some(offset) => cursor + offset,
      None => source.len(),
    }
    line := source[cursor..line_end].trim_end()
    trimmed := line.trim()
    if line == line.trim_start() && trimmed.starts_with("import ") {
      module_name := first_token(trimmed[7..trimmed.len()])
      if import_prefix(module_name) == candidate { return Some(module_name) }
    }
    cursor = if line_end < source.len() { line_end + 1 } else { source.len() }
  }
  return None
}

fn module_file_path(directory: str, module_name: str) -> string {
  mut body := builder()
  mut cursor := 0
  loop {
    if cursor >= module_name.len() { break }
    dot := match module_name[cursor..module_name.len()].find(".") {
      Some(offset) => cursor + offset,
      None => module_name.len(),
    }
    if cursor > 0 { body.write("/") }
    body.write(module_name[cursor..dot])
    if dot >= module_name.len() { break }
    cursor = dot + 1
  }
  body.write(".align")
  module_path := body.to_string()
  return path.join(directory, module_path)
}

fn is_tracked_path(listing: str, expected: str) -> bool {
  mut cursor := 0
  loop {
    if cursor >= listing.len() { break }
    end := match listing[cursor..listing.len()].find("\0") {
      Some(offset) => cursor + offset,
      None => listing.len(),
    }
    if listing[cursor..end] == expected { return true }
    if end >= listing.len() { break }
    cursor = end + 1
  }
  return false
}

fn has_local_function(source: str, name: str) -> bool {
  mut cursor := 0
  loop {
    if cursor >= source.len() { break }
    line_end := match source[cursor..source.len()].find("\n") {
      Some(offset) => cursor + offset,
      None => source.len(),
    }
    line := source[cursor..line_end].trim_end()
    trimmed := line.trim()
    if line == line.trim_start() && trimmed.len() > 0 && !trimmed.starts_with("//") {
      if declaration_kind(trimmed) == "function" && declaration_name(trimmed) == name { return true }
    }
    cursor = if line_end < source.len() { line_end + 1 } else { source.len() }
  }
  return false
}

fn has_module_declaration(source: str, module_name: str) -> bool {
  mut cursor := 0
  loop {
    if cursor >= source.len() { break }
    line_end := match source[cursor..source.len()].find("\n") {
      Some(offset) => cursor + offset,
      None => source.len(),
    }
    line := source[cursor..line_end].trim_end()
    trimmed := line.trim()
    if line == line.trim_start() && declaration_kind(trimmed) == "module" && declaration_name(trimmed) == module_name {
      return true
    }
    cursor = if line_end < source.len() { line_end + 1 } else { source.len() }
  }
  return false
}

fn has_public_symbol(source: str, name: str) -> bool {
  mut cursor := 0
  loop {
    if cursor >= source.len() { break }
    line_end := match source[cursor..source.len()].find("\n") {
      Some(offset) => cursor + offset,
      None => source.len(),
    }
    line := source[cursor..line_end].trim_end()
    trimmed := line.trim()
    if line == line.trim_start() && trimmed.starts_with("pub ") {
      if declaration_name(trimmed) == name { return true }
    }
    cursor = if line_end < source.len() { line_end + 1 } else { source.len() }
  }
  return false
}

fn declaration_function_name(line: str) -> str {
  if line.starts_with("pub fn ") { return first_token(line[7..line.len()]) }
  if line.starts_with("fn ") { return first_token(line[3..line.len()]) }
  return ""
}

fn is_call_keyword(name: str) -> bool {
  return name == "fn" || name == "if" || name == "loop" || name == "match" || name == "else" || name == "return"
}

fn is_reference_identifier(name: str) -> bool {
  if name.len() == 0 || name == "_" { return false }
  if name.starts_with("0") || name.starts_with("1") || name.starts_with("2") || name.starts_with("3") {
    return false
  }
  if name.starts_with("4") || name.starts_with("5") || name.starts_with("6") || name.starts_with("7") {
    return false
  }
  if name.starts_with("8") || name.starts_with("9") { return false }
  return true
}

fn is_imported_qualifier(source: str, candidate: str) -> bool {
  mut cursor := 0
  loop {
    if cursor >= source.len() { break }
    line_end := match source[cursor..source.len()].find("\n") {
      Some(offset) => cursor + offset,
      None => source.len(),
    }
    line := source[cursor..line_end].trim_end()
    trimmed := line.trim()
    if line == line.trim_start() && trimmed.starts_with("import ") {
      module_name := first_token(trimmed[7..trimmed.len()])
      if import_prefix(module_name) == candidate { return true }
    }
    cursor = if line_end < source.len() { line_end + 1 } else { source.len() }
  }
  return false
}

fn import_prefix(module_name: str) -> str {
  if module_name.starts_with("core.") || module_name.starts_with("std.") {
    dot := module_name.rfind(".") else { return module_name }
    return module_name[dot + 1..module_name.len()]
  }
  return module_name
}

fn strip_literals_and_comments(line: str) -> string {
  mut body := builder()
  mut cursor := 0
  loop {
    if cursor >= line.len() { break }
    remaining := line[cursor..line.len()]
    remaining_len := remaining.len()
    double_offset := remaining.find("\"") else remaining_len
    single_offset := remaining.find("'") else remaining_len
    comment_offset := remaining.find("//") else remaining_len
    quote_offset := double_offset.min(single_offset)
    if comment_offset < quote_offset {
      body.write(line[cursor..cursor + comment_offset])
      break
    }
    if quote_offset == remaining_len {
      body.write(line[cursor..line.len()])
      break
    }
    quote := cursor + quote_offset
    body.write(line[cursor..quote])
    body.write(" ")
    delimiter := if double_offset < single_offset { "\"" } else { "'" }
    after_quote := quote + 1
    closing := literal_end(line[after_quote..line.len()], delimiter)
    if closing >= line.len() - after_quote { break }
    cursor = after_quote + closing + 1
  }
  return body.to_string()
}

fn literal_end(text: str, delimiter: str) -> i64 {
  mut cursor := 0
  loop {
    if cursor >= text.len() { return text.len() }
    offset := text[cursor..text.len()].find(delimiter) else { return text.len() }
    absolute := cursor + offset
    if !is_escaped(text[0..absolute]) { return absolute }
    cursor = absolute + 1
  }
}

fn is_escaped(text: str) -> bool {
  mut remaining := text
  mut slash_count := 0
  loop {
    if !remaining.ends_with("\\") { break }
    remaining = remaining[0..remaining.len() - 1]
    slash_count = slash_count + 1
  }
  return slash_count % 2 == 1
}

fn first_segment(value: str) -> str {
  text := value.trim()
  if text.len() == 0 { return text }
  mut end := text.len()
  space := text.find(" ") else text.len()
  tab := text.find("\t") else text.len()
  dot := text.find(".") else text.len()
  open := text.find("(") else text.len()
  close := text.find(")") else text.len()
  brace := text.find("{") else text.len()
  bracket := text.find("[") else text.len()
  comma := text.find(",") else text.len()
  colon := text.find(":") else text.len()
  equal := text.find("=") else text.len()
  semicolon := text.find(";") else text.len()
  question := text.find("?") else text.len()
  bang := text.find("!") else text.len()
  plus := text.find("+") else text.len()
  minus := text.find("-") else text.len()
  star := text.find("*") else text.len()
  slash := text.find("/") else text.len()
  percent := text.find("%") else text.len()
  less := text.find("<") else text.len()
  greater := text.find(">") else text.len()
  ampersand := text.find("&") else text.len()
  pipe := text.find("|") else text.len()
  if space < end { end = space }
  if tab < end { end = tab }
  if dot < end { end = dot }
  if open < end { end = open }
  if close < end { end = close }
  if brace < end { end = brace }
  if bracket < end { end = bracket }
  if comma < end { end = comma }
  if colon < end { end = colon }
  if equal < end { end = equal }
  if semicolon < end { end = semicolon }
  if question < end { end = question }
  if bang < end { end = bang }
  if plus < end { end = plus }
  if minus < end { end = minus }
  if star < end { end = star }
  if slash < end { end = slash }
  if percent < end { end = percent }
  if less < end { end = less }
  if greater < end { end = greater }
  if ampersand < end { end = ampersand }
  if pipe < end { end = pipe }
  return text[0..end]
}

fn last_token(value: str) -> str {
  text := value.trim_end()
  if text.len() == 0 { return text }
  mut start := -1
  space := text.rfind(" ") else -1
  tab := text.rfind("\t") else -1
  open := text.rfind("(") else -1
  close := text.rfind(")") else -1
  bracket := text.rfind("[") else -1
  close_bracket := text.rfind("]") else -1
  brace := text.rfind("{") else -1
  close_brace := text.rfind("}") else -1
  comma := text.rfind(",") else -1
  colon := text.rfind(":") else -1
  equal := text.rfind("=") else -1
  semicolon := text.rfind(";") else -1
  plus := text.rfind("+") else -1
  minus := text.rfind("-") else -1
  star := text.rfind("*") else -1
  slash := text.rfind("/") else -1
  percent := text.rfind("%") else -1
  less := text.rfind("<") else -1
  greater := text.rfind(">") else -1
  bang := text.rfind("!") else -1
  question := text.rfind("?") else -1
  ampersand := text.rfind("&") else -1
  pipe := text.rfind("|") else -1
  newline := text.rfind("\n") else -1
  if space > start { start = space }
  if tab > start { start = tab }
  if open > start { start = open }
  if close > start { start = close }
  if bracket > start { start = bracket }
  if close_bracket > start { start = close_bracket }
  if brace > start { start = brace }
  if close_brace > start { start = close_brace }
  if comma > start { start = comma }
  if colon > start { start = colon }
  if equal > start { start = equal }
  if semicolon > start { start = semicolon }
  if plus > start { start = plus }
  if minus > start { start = minus }
  if star > start { start = star }
  if slash > start { start = slash }
  if percent > start { start = percent }
  if less > start { start = less }
  if greater > start { start = greater }
  if bang > start { start = bang }
  if question > start { start = question }
  if ampersand > start { start = ampersand }
  if pipe > start { start = pipe }
  if newline > start { start = newline }
  return text[start + 1..text.len()]
}

fn declaration_name(line: str) -> str {
  if line.starts_with("pub fn ") { return first_token(line[7..line.len()]) }
  if line.starts_with("fn ") { return first_token(line[3..line.len()]) }
  if line.starts_with("module ") { return first_token(line[7..line.len()]) }
  open := line.find("{") else { return "" }
  mut candidate := line[0..open].trim()
  if candidate.starts_with("pub ") { candidate = candidate[4..candidate.len()].trim() }
  if candidate.starts_with("fn ") || candidate.starts_with("import ") || candidate.len() == 0 {
    return ""
  }
  return first_token(candidate)
}

fn process_succeeded(status: verify.RunStatus, code: i64) -> bool {
  return match status {
    Completed => code == 0,
    TimedOut => false,
    SpawnFailed => false,
  }
}

fn declaration_kind(line: str) -> str {
  if line.starts_with("pub fn ") || line.starts_with("fn ") { return "function" }
  if line.starts_with("module ") { return "module" }
  return "type"
}

fn first_token(value: str) -> str {
  text := value.trim()
  if text.len() == 0 { return text }
  space := text.find(" ") else text.len()
  paren := text.find("(") else text.len()
  brace := text.find("{") else text.len()
  end := space.min(paren).min(brace)
  return text[0..end]
}

fn count_lines(source: str) -> i64 {
  mut count := 0
  mut cursor := 0
  loop {
    if cursor >= source.len() { break }
    count = count + 1
    line_end := match source[cursor..source.len()].find("\n") {
      Some(offset) => cursor + offset,
      None => source.len(),
    }
    cursor = if line_end < source.len() { line_end + 1 } else { source.len() }
  }
  return count
}

fn language_of(path_name: str) -> str {
  if path_name.ends_with(".align") { return "align" }
  if path_name.ends_with(".py") { return "python" }
  if path_name.ends_with(".rs") { return "rust" }
  if path_name.ends_with(".md") { return "markdown" }
  if path_name.ends_with(".json") { return "json" }
  if path_name.ends_with(".yml") || path_name.ends_with(".yaml") { return "yaml" }
  if path_name.ends_with(".sh") { return "shell" }
  return "unknown"
}

fn path_stem(path_name: str) -> str {
  base := path.base(path_name)
  extension := path.ext(path_name)
  if extension.len() == 0 || extension.len() > base.len() {
    return base
  }
  return base[0..base.len() - extension.len()]
}

fn related_test_basename_match(changed_path: str, test_path: str) -> bool {
  changed_stem := path_stem(changed_path)
  test_stem := path_stem(test_path)
  if changed_stem.len() == 0 || test_stem.len() == 0 {
    return false
  }
  return test_stem.contains(changed_stem) || changed_stem.contains(test_stem)
}

fn related_test_same_directory(changed_path: str, test_path: str) -> bool {
  return path.dir(changed_path) == path.dir(test_path)
}

fn related_test_score(changed_path: str, test_path: str) -> i64 {
  name_score := if related_test_basename_match(changed_path, test_path) { 100 } else { 0 }
  directory_score := if related_test_same_directory(changed_path, test_path) { 20 } else { 0 }
  return name_score + directory_score
}

fn related_test_reason(changed_path: str, test_path: str) -> str {
  name_match := related_test_basename_match(changed_path, test_path)
  same_directory := related_test_same_directory(changed_path, test_path)
  if name_match && same_directory { return "basename-match+same-directory" }
  if name_match { return "basename-match" }
  if same_directory { return "same-directory" }
  return "generic"
}

fn is_test_path(path_name: str) -> bool {
  if path_name.starts_with("test") || path_name.starts_with("tests/") || path_name.starts_with("test/") {
    return true
  }
  if path_name.contains("/tests/") || path_name.contains("/test/") {
    return true
  }
  if path_name.ends_with("_test.align") || path_name.ends_with("_test.py") {
    return true
  }
  return false
}

fn test_json(path_name: str) -> string {
  if !is_test_path(path_name) { return "".clone() }
  record := IndexTest { path: path_name, reason: "test-path" }
  return json.encode(record).clone()
}
