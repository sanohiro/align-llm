module prompt_generation_response_smoke

import prompt_generation_response
import prompt_artifacts

// Literal wire digests independently computed with Python hashlib SHA-256.
VALID_0 := "{\"schema_version\":1,\"artifact_kind\":\"PROMPT_GENERATION_RESPONSE\",\"request_id\":\"request\",\"status\":\"GENERATED\",\"error_code\":\"NONE\",\"error\":\"\",\"provider_kind\":\"OPENAI\",\"provider_model\":\"model\",\"provider_request_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"seed_result\":\"APPLIED\",\"applied_seed\":7,\"http_status\":200,\"content\":\"owned 日本語\\npatch\",\"dispatch_start_ns\":10,\"dispatch_end_ns\":20,\"content_sha256\":\"9ce9b96e9727b784d3924c4852b361ecaf8d5d8547dc183e2c957fa32b7e1208\"}"
VALID_1 := "{\"schema_version\":1,\"artifact_kind\":\"PROMPT_GENERATION_RESPONSE\",\"request_id\":\"request\",\"status\":\"PROVIDER_ERROR\",\"error_code\":\"HTTP_STATUS\",\"error\":\"fixture failure\",\"provider_kind\":\"OPENAI\",\"provider_model\":\"model\",\"provider_request_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"seed_result\":\"UNSUPPORTED\",\"http_status\":503,\"dispatch_start_ns\":10,\"dispatch_end_ns\":20,\"content_sha256\":\"f6e02082c179c2eec2b9b65cbdfc2d8351d8e98b6362213d95e5ad3bdfb7cdb7\"}"
