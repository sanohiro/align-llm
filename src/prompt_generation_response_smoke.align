fn expected() -> prompt_generation_response.Expected {
  return prompt_generation_response.Expected { request_id: "request".clone(), provider_kind: "OPENAI".clone(), provider_model: "model".clone(), paired_seed: 7 }
}

fn rejected(source: str, label: str) -> Result<(), Error> {
  identity := expected()
  match prompt_generation_response.decode(source, identity) {
    Ok(_) => { print(label); return Err(Error.Invalid) },
    Err(_) => {},
  }
  return Ok(())
}

fn owned() -> Result<prompt_artifacts.PromptGenerationResponse, Error> {
  source := VALID_0.clone()
  identity := expected()
  return prompt_generation_response.decode(source, identity)
}

pub fn main() -> Result<(), Error> {
  response := owned()?
  if response.request_id != "request" || response.provider_model != "model" { return Err(Error.Invalid) }
