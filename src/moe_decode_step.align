  d.write(",\"slot_magic_ok\":")
  d.write(moe_model_forward.bool_text(o.slot_magic_ok))
  d.write(",\"fp_contract_off\":")
  d.write(moe_model_forward.bool_text(o.fp_contract_off))
  d.write(",\"graph_context_bytes\":")
  d.write_int(o.graph_context_bytes)
  d.write("}")
  return d.to_string()
}

fn render_prologue(
  borrow o: moe_model_forward.Outcome,
  pack_path: str,
  geometry_path: str,
  reference_path: str,
  transcript_path: str,
  logits_path: str,
) -> string {
  failed := o.code.len() > 0
  code_view: str := o.code
  detail_view: str := o.detail
  d := builder()
  d.write("{\"schema_version\":")
  d.write_int(if o.expert_cache_mode { CACHE_SCHEMA_VERSION } else { SCHEMA_VERSION })
  d.write(",\"kind\":")
  d.write(moe_model_forward.json_string(DOCUMENT_KIND))
  d.write(",\"pack_path\":")
  d.write(moe_model_forward.json_string(pack_path))
  d.write(",\"geometry_path\":")
  d.write(moe_model_forward.json_string(geometry_path))
  d.write(",\"reference_path\":")
  d.write(moe_model_forward.json_string(reference_path))
  d.write(",\"transcript_path\":")
  d.write(moe_model_forward.json_string(transcript_path))
  d.write(",\"logits_path\":")
  d.write(moe_model_forward.json_string(logits_path))
  d.write(",\"status\":")
  d.write(moe_model_forward.json_string(if failed { "error" } else { "ok" }))
  d.write(",\"error_code\":")
  d.write(moe_model_forward.json_string(code_view))
  d.write(",\"error_detail\":")
  d.write(moe_model_forward.json_string(detail_view))
  d.write(",\"verdict\":")
  d.write(moe_model_forward.json_string(moe_model_forward.verdict_label(o.verdict)))
  d.write(",\"pack\":{\"format_version\":")
  d.write_int(o.format_version)
  d.write(",\"block_align\":")
  d.write_int(o.block_align)
  d.write(",\"member_align\":")
  d.write_int(o.member_align)
  d.write(",\"block_count\":")
  d.write_int(o.block_count)
  d.write(",\"member_count\":")
  d.write_int(o.member_count)
  d.write(",\"total_bytes\":")
  d.write_int(o.total_bytes)
  d.write(",\"payload_offset\":")
  d.write_int(o.payload_offset)
  d.write(",\"reader_pread_count\":")
  d.write_int(o.reader_pread_count)
  d.write(",\"reader_bytes_read\":")
  d.write_int(o.reader_bytes_read)
  d.write("},")
  return d.to_string()
}

pub fn render(
  borrow o: moe_model_forward.Outcome,
  borrow tokens: moe_model_forward.TokenColumns,
  borrow graphs: moe_model_forward.GraphColumns,
  borrow top: moe_model_forward.TopColumns,
  borrow stepped: StepRows,
  pack_path: str,
  geometry_path: str,
  reference_path: str,
  transcript_path: str,
  logits_path: str,
) -> string {
  prologue := render_prologue(
    o, pack_path, geometry_path, reference_path, transcript_path, logits_path)
  prologue_view: str := prologue
  header := moe_model_forward.render_head(o, tokens)
  header_view: str := header
  plane := render_plane(o)
  plane_view: str := plane
  decode := render_decode(o, stepped)
  decode_view: str := decode
  steps_view: str := stepped.text
  residency := render_residency(o)
  residency_view: str := residency
  window := render_window(o)
  window_view: str := window
  weights := render_weights(o)
  weights_view: str := weights
  graph := render_graph(o, graphs)
  graph_view: str := graph
  head := moe_model_forward.render_output(o, top)
  head_view: str := head
  reference := render_routing_oracle(o)
  reference_view: str := reference
  oracle := render_oracle_decode(o)
  oracle_view: str := oracle
  tail := render_tail(o)
  tail_view: str := tail
  d := builder()
  d.write(prologue_view)
  d.write(header_view)
  d.write(",\"plane\":")
  d.write(plane_view)
  d.write(",\"decode\":")
  d.write(decode_view)
  d.write(",\"steps\":[")
  d.write(steps_view)
  d.write("],\"residency\":")
  d.write(residency_view)
  d.write(",\"window\":")
  d.write(window_view)
  d.write(",\"weights\":")
  d.write(weights_view)
  d.write(",\"graph\":")
  d.write(graph_view)
  d.write(",\"head\":")
  d.write(head_view)
  d.write(",\"reference\":")
  d.write(reference_view)
  d.write(",\"oracle_decode\":")
  d.write(oracle_view)
  d.write(",\"timings\":")
  d.write(tail_view)
  d.write("}")
  return d.to_string()
}

// ---------------------------------------------------------------------------------------------
// The summary block and the CLI adapter (section 3.2)
// ---------------------------------------------------------------------------------------------

fn print_pair(left: i64, right: i64) {
  b := builder()
  b.write_int(left)
  b.write("/")
  b.write_int(right)
  rendered := b.to_string()
  rendered_view: str := rendered
  print(rendered_view)
}

fn print_summary(
  borrow o: moe_model_forward.Outcome,
  borrow tokens: moe_model_forward.TokenColumns,
  pack_path: str,
) {
  failed := o.code.len() > 0
  print("moe decode step:")
  print("status:")
  if failed { print("ERROR") } else { print("OK") }
  print("verdict:")
  print(moe_model_forward.verdict_label(o.verdict))
  print("pack path:")
  sanitized_path := moe_model_forward.sanitize_summary_line(pack_path)
  sanitized_path_view: str := sanitized_path
  print(sanitized_path_view)
  print("schema:")
  print(SCHEMA_VERSION)
  print("arch:")
  arch_view: str := o.arch
  sanitized_arch := moe_model_forward.sanitize_summary_line(arch_view)
  sanitized_arch_view: str := sanitized_arch
  print(sanitized_arch_view)
  print("layers:")
  print(o.n_layer)
  print("tokens:")
  ids := builder()
  mut token_at := 0
  loop {
    if token_at >= tokens.ids.len() { break }
    if token_at > 0 { ids.write(",") }
    ids.write_int(tokens.ids[token_at])
    token_at = token_at + 1
  }
  rendered_ids := ids.to_string()
  rendered_ids_view: str := rendered_ids
  print(rendered_ids_view)
  print("kv width:")
  print(o.attention_width)
  print("steps requested:")
  print(o.decode_steps_requested)
  print("steps completed:")
  print(o.decode_steps_completed)
  print("plane bytes:")
  print(o.plane_bytes)
  print("plane roundtrip:")
  print(roundtrip_label(o.plane_roundtrip_verdict))
  print("plane bytes compared:")
  print(o.plane_roundtrip_bytes)
  print("decode expert bytes:")
  print(o.decode_expert_bytes)
  print("decode expert pread bytes:")
  print(o.decode_expert_pread_bytes)
  print("union keys:")
  print_pair(o.union_keys_final, o.n_layer * o.n_expert)
  print("union bytes:")
  print(o.union_bytes_final)
  print("decode keys in prefill union:")
  print_pair(o.decode_keys_in_prefill_union, o.decode_keys_demanded)
  print("decode distinct keys in prefill union:")
  print_pair(o.decode_distinct_keys_in_prefill_union, o.decode_keys_distinct)
  print("step reuse per mille:")
  print(o.step_reuse_per_mille)
  print("routing:")
  print(moe_model_forward.routing_label(o.routing_verdict))
  print("routing ids:")
  print_pair(o.routing_ids_matched, o.routing_ids_printed)
  print("decode transcript:")
  print(moe_model_forward.oracle_label(o.oracle_verdict))
  print("max abs diff:")
  print(o.oracle_max_abs)
  print("prefill logits oracle:")
  print(moe_model_forward.logits_label(o.logits_verdict))
  print("prefill logits sha256:")
  sha_view: str := o.sha256
  print(sha_view)
  print("last decode logits sha256:")
  decode_sha_view: str := o.decode_sha256
  print(decode_sha_view)
  print("graph nodes:")
  print(o.node_count_total + o.decode_node_count)
  print("slot high water:")
  print(o.slot_high_water)
  print("released:")
  print(o.ggml_buffers_freed + o.contexts_freed + o.backends_freed + o.gallocrs_freed)
  print("elapsed ns:")
  print(o.elapsed_ns)
  if failed {
    print("error:")
    code_view: str := o.code
    print(code_view)
    print("detail:")
    detail_view: str := o.detail
    sanitized_detail := moe_model_forward.sanitize_summary_line(detail_view)
    sanitized_detail_view: str := sanitized_detail
    print(sanitized_detail_view)
  }
}

// Section 3.2: exactly five, six, seven, nine, ten, or eleven operands. **Eight is `R6M_ARITY`**,
// inherited from `--decode-step`'s own reason — `KV_WIDTH` travels with the transcript, so a
// transcript without a width refuses itself — and twelve and above are `R6M_ARITY` too, with
// positions 11, 12, and 13 **reserved** for `KV_SAVE`, `KV_LOAD`, and `RESIDENT` at the same indices
// the dense arm uses, so the capability that adds them renumbers nothing.
//
// **The operand shape is `--decode-step`'s, position for position**, so the two decode runners build
// their argument vectors the same way and a command line cannot be silently reordered between two
// arms that decode. `KV_WIDTH` is fail-closed with no default in both; `STEPS` absent means 1 and
// `decode.steps_requested` is published in every document so the count is never implicit.
pub fn run(args: array<str>) -> Result<(), Error> {
  count := args.len()
  // R6-MOE-RESIDENT-DENSE section 3.1. The arity set becomes {5, 6, 7, 9, 10, 11, 14}. **Eight
  // remains refused** for R6's own reason — a transcript without a width refuses itself — and 12,
  // 13, and 15 and above remain refused, because positions 11 and 12 exist only to hold the two
  // reserved `-` placeholders in front of `RESIDENT` and an invocation that stopped inside them
  // would be a caller who meant something this arm cannot do. Every one of these presents as
  // `Err(Error.Invalid)`: no document, non-zero exit, the `NO_DOCUMENT` class the seventh smoke
  // block already uses.
  if count < 5 || count == 8 || (count > 11 && count != 14) {
    return Err(Error.Invalid)
  }
  // `-` is admitted in the document, transcript and logits positions **only**, and a path operand
  // that is not UTF-8 is refused lexically: every path is copied into the document as a JSON scalar,
  // and a raw non-UTF-8 byte there produces a document no conforming reader can decode — a malformed
  // output from a malformed input. `moe_model_forward.mm_valid_path` is R5E's own guard and carries
  // both rules.
  if !moe_model_forward.mm_valid_path(args[2]) || args[2] == "-" {
    return Err(Error.Invalid)
  }
  if !moe_model_forward.mm_valid_path(args[3]) || args[3] == "-" {
    return Err(Error.Invalid)
  }
  if count >= 6 && args[5] != "-" && !moe_model_forward.mm_valid_path(args[5]) {
    return Err(Error.Invalid)
  }
  if count >= 7 && (!moe_model_forward.mm_valid_path(args[6]) || args[6] == "-") {
    return Err(Error.Invalid)
  }
  if count >= 9 && args[7] != "-" && !moe_model_forward.mm_valid_path(args[7]) {
    return Err(Error.Invalid)
  }
  if count >= 10 && args[9] != "-" && !moe_model_forward.mm_valid_path(args[9]) {
    return Err(Error.Invalid)
  }
  // `RESIDENT` is not a path and takes no path check, but it **is** copied into the document as a
  // JSON scalar by `resident_detail`, and a raw non-UTF-8 byte there produces a document no
  // conforming reader can decode. That is the same rule this module already applies to every path
  // operand through `mm_valid_path`, applied to the one non-path operand whose text reaches the
  // output; `-`, `dense`, and the empty string are all valid UTF-8, so no accepted or named-refused
  // value is affected.
  if count >= 14 && !moe_model_forward.utf8_ok(args[13]) {
    return Err(Error.Invalid)
  }
  reference_path := if count >= 7 { args[6] } else { "" }
  transcript_path := if count >= 9 && args[7] != "-" { args[7] } else { "" }
  width_text := if count >= 9 { args[8] } else { "" }
  logits_path := if count >= 10 && args[9] != "-" { args[9] } else { "" }
  steps_text := if count >= 11 { args[10] } else { "1" }
  // Positions 11 and 12 are `KV_SAVE` and `KV_LOAD` at the same indices the dense arm uses, so a
  // command line cannot be silently reordered between the two arms. KV persistence is not
  // implemented here (section 8), so both must be `-`; anything else is `R6M_KV_UNSUPPORTED`, raised
  // in `execute` because it is a refusal that owes the caller a document. The two placeholders are
  // the price of the index promise and they are cheap.
  kv_save_text := if count >= 14 { args[11] } else { "-" }
  kv_load_text := if count >= 14 { args[12] } else { "-" }
  resident_text := if count >= 14 { args[13] } else { "-" }
  mut tokens := moe_model_forward.empty_tokens()
  mut graphs := moe_model_forward.empty_graphs()
  mut top := moe_model_forward.empty_top()
  mut stepped := empty_steps()
  outcome := execute(
    args[2], args[3], args[4], reference_path, transcript_path, width_text, logits_path,
    steps_text, kv_save_text, kv_load_text, resident_text, tokens, graphs, top, stepped)
  document := render(
    outcome, tokens, graphs, top, stepped, args[2], args[3], reference_path, transcript_path,
    logits_path)
  document_view: str := document
  if count == 5 || args[5] == "-" {
    print(document_view)
  } else {
    fs.write_file(args[5], document_view)?
    print_summary(outcome, tokens, args[2])
  }
  if outcome.code.len() > 0 {
    return Err(Error.Invalid)
  }
  return Ok(())
}
