import ggml_ffi
import layer_forward
import layer_qwen2

// R5B-MODEL-PREFILL-FORWARD (`docs/specs/r5b-model-prefill-forward.md`). The `--model-forward` arm:
// the thirty window fills of section 3.4, the one reused window of section 3.5, the three node
// tables of section 3.6, the three oracles of section 3.7, the `R5_MODEL_FORWARD` document of
// section 3.8, the thirty-four-step validation order of section 3.9, and the per-graph teardown of
// section 3.10.
//
// It is a **new module** rather than four hundred more lines of `src/layer_forward.align` for
// section 5.5's reason: at this pin the checker's per-function cost is superlinear in body length
// and `src/layer_forward.align` is already 3,334 lines. Every function here is under two hundred
// lines, every fallible call inside a loop propagates with `?`, and no loop body matches on a
// `Result` (`r5a-dense-layer-forward.md` section 6, correction C8).
//
// It holds no `unsafe` and no `extern`. Every foreign call crosses `src/ggml_ffi.align`, and the
// R5A arm is imported rather than copied: `layer_forward.scan_transcript`, `parse_tokens`,
// `valid_path`, `MemberColumns`, and `Layout` are that module's public surface and this one reuses
// them unchanged.

MAX_PATH_BYTES := 4096
MAX_DETAIL_BYTES := 256
MAX_DIMENSION := 16777216
MAX_INDEX_DIGITS := 18

SCHEMA_VERSION := 1
DOCUMENT_KIND := "R5_MODEL_FORWARD"

// R4.5 section 3.9's compensation window, unchanged: Align has no aligned allocator
// (`docs/align-requests.md` Request 33) and every admissible `tensor_alignment` divides 64.
MAX_TENSOR_ALIGNMENT := 64

// Section 3.5. `2^33`, refused before a single byte is reserved, so a malformed member record
// cannot ask the process for a terabyte.
MAX_WINDOW_BYTES := 8589934592

// Section 3.7's logits thresholds, fixed by section 2.6's and 2.7's measurements **before** the
// qualification existed. At the reconciliation width the contract is byte-identity and this bound
// is not consulted; at the runtime width the bound is 1.8x the measured worst case of 2,738
// ten-thousandths over a logit range of 28.927, and the `argmax` and the whole top ten must agree
// as well.
LOGIT_TOLERANCE_TEN_THOUSANDTHS := 5000
pub TOP_K := 10

// R5C section 3.8's recorded distribution. Half a unit in ten-thousandths, and the histogram the
// p99 is read off: 65,536 exact buckets plus one overflow, which covers the whole measured support
// (section 2.3's p999 is 2,089) with three orders of magnitude to spare and reports its ceiling
// rather than a wrong number for anything wider.
HALF_UNIT_TEN_THOUSANDTHS := 5000
HISTOGRAM_BUCKETS := 65536

// Section 6, correction C23. The comparison below is integer ten-thousandths, and a `f32` element
// exists that has no such integer: every infinity and NaN, and every finite magnitude above
// `i64`'s range divided by 10,000. `((v as f64) * 10000.0).round() as i64` **saturates** on those,
// after which `primary - reference` wraps, `0 - difference` wraps `i64`'s minimum to itself, the
// histogram is indexed with a negative bucket — a `SIGABRT` with no document — and `logits_max_abs`
// publishes a magnitude the run never computed, while a NaN — whose `as i64` is `0` rather than a
// saturation — could compare *within* the tolerance. Two constants close that:
// `LOGIT_SCALE_LIMIT_TEN_THOUSANDTHS` is the largest magnitude the comparison represents, and
// anything at or beyond it — including every non-finite element — is routed to the overflow bucket
// and to a magnitude that no tolerance can admit, so an unrepresentable element is a `FAIL` rather
// than a wrap. The limit is 10^15, which is 10^11 logits: eleven orders of magnitude above the
// 28.927 range section 2.3 measured, and low enough that the difference of two of them cannot
// overflow.
LOGIT_SCALE_LIMIT_TEN_THOUSANDTHS := 1000000000000000
LOGIT_UNREPRESENTABLE := 9223372036854775807

VERDICT_UNAVAILABLE := 0
VERDICT_EXTERNAL := 1
VERDICT_COPIED := 2

REFERENCE_ABSENT := 0
REFERENCE_IDENTICAL := 1
REFERENCE_MISMATCH := 2

ORACLE_ABSENT := 0
ORACLE_PASS := 1
ORACLE_FAIL := 2
// R5C-METAL-PREFILL-ARM (`docs/specs/r5c-metal-prefill.md` section 3.7). The transcript oracle's
// grammar, coverage, and element-count rules run on the GPU arm exactly as they do here; its
// **element comparison** does not, because section 2.5 measured that the residual stream's
// massive-activation channel differs by up to 185,844 ten-thousandths against a threshold of one.
// A bound wide enough to pass would assert nothing, so the arm publishes the reason instead of a
// number that cannot fail. Unreachable on the CPU arm, which is why `--model-forward`'s goldens do
// not move.
ORACLE_NOT_APPLICABLE_DEVICE := 3

LOGITS_ABSENT := 0
LOGITS_IDENTICAL := 1
LOGITS_WITHIN := 2
LOGITS_FAIL := 3

// The three graph kinds the schedule walks.
GRAPH_EMBED := 0
GRAPH_LAYER := 1
GRAPH_HEAD := 2

// R5A section 3.6's transcript thresholds, inherited **unchanged and unwidened**: section 2.8
// measured `0` and `0` at whole-model scale over thirty thousand elements.
TOLERANCE_TEN_THOUSANDTHS := 1
SUM_TOLERANCE_MILLIONTHS := 1000
SUM_TOLERANCE_RELATIVE_PPM := 10

TRUNCATION_PRINTED := 6
TRUNCATION_HALF := 3

DIGEST_HEX_BYTES := 64
SUMMARY_HEX := "0123456789abcdef"

TextBox { v: str }

// ---------------------------------------------------------------------------------------------
// Text, numbers, and the lexical guards
// ---------------------------------------------------------------------------------------------

pub fn int_text(value: i64) -> string {
  b := builder()
  b.write_int(value)
  return b.to_string()
}

pub fn bool_text(value: bool) -> string {
  if value { return "true".clone() }
  return "false".clone()
}

pub fn json_string(value: str) -> string {
  boxed := TextBox { v: value }
  encoded := json.encode(boxed)
  return encoded[5..encoded.len() - 1].clone()
}

fn bounded_detail(value: str) -> string {
  if value.len() <= MAX_DETAIL_BYTES { return value.clone() }
  return value[0..MAX_DETAIL_BYTES].clone()
}

fn labelled(label: str, value: i64) -> string {
  b := builder()
  b.write(label)
  b.write("[")
  b.write_int(value)
  b.write("]")
  return b.to_string()
}

fn named(label: str, value: str) -> string {
  b := builder()
  b.write(label)
  b.write("[")
  b.write(value)
  b.write("]")
  return b.to_string()
}

// `layer[<n>]role[<name>]` and `layer[<n>]node[<id>]`, the two detail shapes section 3.9 names for
// almost every code the schedule can raise.
fn layer_named(layer: i64, label: str, value: str) -> string {
  b := builder()
  b.write("layer[")
  b.write_int(layer)
  b.write("]")
  b.write(label)
  b.write("[")
  b.write(value)
  b.write("]")
  return b.to_string()
}

fn graph_node_at(graph: i64, node: str, index: i64) -> string {
  b := builder()
  b.write("graph[")
  b.write_int(graph)
  b.write("]node[")
  b.write(node)
  b.write("]@")
  b.write_int(index)
  return b.to_string()
}

fn block_detail(kind: i64, layer: i64, role: str) -> string {
  b := builder()
  b.write("kind[")
  b.write_int(kind)
  b.write("]layer[")
  b.write_int(layer)
  b.write("]role[")
  b.write(role)
  b.write("]")
  return b.to_string()
}

fn shortfall(layer: i64, node: str, got: i64, expected: i64) -> string {
  b := builder()
  b.write("layer[")
  b.write_int(layer)
  b.write("]node[")
  b.write(node)
  b.write("]")
  b.write_int(got)
  b.write("/")
  b.write_int(expected)
  return b.to_string()
}

pub fn sanitize_summary_line(value: str) -> string {
  b := builder()
  view := value.bytes()
  mut start := 0
  mut index := 0
  loop {
    if index >= view.len() { break }
    byte := view.u8(index) as i64
    if byte < 32 || byte == 127 {
      if index > start { b.write(value[start..index]) }
      high := byte / 16
      low := byte % 16
      b.write("\\x")
      b.write(SUMMARY_HEX[high..high + 1])
      b.write(SUMMARY_HEX[low..low + 1])
      start = index + 1
    }
    index = index + 1
  }
  if start < view.len() { b.write(value[start..view.len()]) }
  return b.to_string()
}

// A non-negative decimal integer, no sign, no leading `+`, no whitespace, no leading zero beyond a
// bare `0`. `-1` means "not a number this grammar produces".
fn parse_index(value: str) -> i64 {
  if value.len() == 0 || value.len() > MAX_INDEX_DIGITS { return -1 }
  view := value.bytes()
  if view.len() > 1 && view.u8(0) as i64 == 48 { return -1 }
  mut total := 0
  mut index := 0
  loop {
    if index >= view.len() { break }
    byte := view.u8(index) as i64
    if byte < 48 || byte > 57 { return -1 }
    total = total * 10 + (byte - 48)
    index = index + 1
  }
  return total
}

fn error_name(e: Error) -> str = match e {
  NotFound => "NotFound",
  Invalid => "Invalid",
  Denied => "Denied",
  Timeout => "Timeout",
  Code(_) => "Code",
}

pub fn verdict_label(value: i64) -> str {
  if value == VERDICT_EXTERNAL { return "EXTERNAL" }
  if value == VERDICT_COPIED { return "COPIED" }
  return "UNAVAILABLE"
}

pub fn reference_label(value: i64) -> str {
  if value == REFERENCE_IDENTICAL { return "IDENTICAL" }
  if value == REFERENCE_MISMATCH { return "MISMATCH" }
  return "-"
}

pub fn oracle_label(value: i64) -> str {
  if value == ORACLE_PASS { return "PASS" }
  if value == ORACLE_FAIL { return "FAIL" }
  if value == ORACLE_NOT_APPLICABLE_DEVICE { return "N/A_DEVICE" }
  return "-"
}

pub fn logits_label(value: i64) -> str {
  if value == LOGITS_IDENTICAL { return "IDENTICAL" }
  if value == LOGITS_WITHIN { return "WITHIN" }
  if value == LOGITS_FAIL { return "FAIL" }
  return "-"
}

fn align_up(value: i64, alignment: i64) -> i64 {
  if alignment <= 1 { return value }
  remainder := value % alignment
  if remainder == 0 { return value }
  return value + (alignment - remainder)
}

// The transcript prints at most six positions per axis. Both halves of that rule live here so a
// sampled ordinal is never confused with a tensor index (R5A section 3.6, unchanged).
fn printed_count(extent: i64) -> i64 {
  if extent <= TRUNCATION_PRINTED { return extent }
  return TRUNCATION_PRINTED
}

pub fn column_at(borrow column: array<i64>, index: i64) -> i64 {
  if index < 0 || index >= column.len() { return 0 }
  return column[index]
}

fn fill_zero(borrow mut b: buffer, n: i64) {
  mut index := 0
  loop {
    if index >= n { break }
    b.put_u8(0 as u8)
    index = index + 1
  }
}

fn base_mod(borrow b: buffer, modulus: i64) -> i64 {
  view := b.bytes()
  return ggml_ffi.align_mod(view, modulus)
}

// ---------------------------------------------------------------------------------------------
// The columns (section 3.8)
//
// Each record is assigned exactly once, as a whole, by the stage that produces it: at this pin an
// owned `array<i64>` field cannot be replaced in place (`r5a-dense-layer-forward.md` section 6,
// correction C9), so a single wide record every stage appends to does not compile.
// ---------------------------------------------------------------------------------------------

fn empty_array() -> array<i64> {
  mut b: array_builder<i64> := array_builder()
  return b.build()
}

pub TokenColumns { count: i64, ids: array<i64> }

pub fn empty_tokens() -> TokenColumns = TokenColumns { count: 0, ids: empty_array() }

// One row per layer: the two blocks, their byte counts, the two members whose quantization varies
// across layers (section 2.1 fact 3), and everything the run measured about that layer's graph.
// `schedule[]` is the capability's real output and section 3.8 says why it is one row per layer
// rather than one row per node.
pub ScheduleColumns {
  count: i64,
  digests: string,
  attention_block: array<i64>,
  mlp_block: array<i64>,
  attention_bytes: array<i64>,
  mlp_bytes: array<i64>,
  attn_v_type: array<i64>,
  ffn_down_type: array<i64>,
  pread_ns: array<i64>,
  compute_ns: array<i64>,
  node_count: array<i64>,
  bit_sum: array<i64>,
  sum_millionths: array<i64>,
  ne0: array<i64>,
  ne1: array<i64>,
  nonfinite: array<i64>,
}

pub fn empty_schedule() -> ScheduleColumns = ScheduleColumns {
  count: 0,
  digests: "".clone(),
  attention_block: empty_array(),
  mlp_block: empty_array(),
  attention_bytes: empty_array(),
  mlp_bytes: empty_array(),
  attn_v_type: empty_array(),
  ffn_down_type: empty_array(),
  pread_ns: empty_array(),
  compute_ns: empty_array(),
  node_count: empty_array(),
  bit_sum: empty_array(),
  sum_millionths: empty_array(),
  ne0: empty_array(),
  ne1: empty_array(),
  nonfinite: empty_array(),
}

// The `gallocr` peak of every graph the run computed, in schedule order, so section 3.10's "one
// graph's activations rather than thirty" is a published measurement.
pub GraphColumns { activation_bytes: array<i64> }

pub fn empty_graphs() -> GraphColumns = GraphColumns { activation_bytes: empty_array() }

// The top ten logits, as `(index, bit pattern)` pairs. No float is rendered anywhere, for
// `r4-alignpack-layer-major.md` section 2.3's reason.
pub TopColumns { index: array<i64>, bits: array<i64> }

pub fn empty_top() -> TopColumns = TopColumns { index: empty_array(), bits: empty_array() }

// Everything the run learned that is a scalar or a name, whether or not it finished.
pub Outcome {
  code: string,
  detail: string,
  verdict: i64,
  reference_present: bool,
  transcript_present: bool,
  logits_present: bool,

  reader_pread_count: i64,
  reader_bytes_read: i64,
  format_version: i64,
  block_align: i64,
  member_align: i64,
  block_count: i64,
  member_count: i64,
  total_bytes: i64,
  payload_offset: i64,

  arch: string,
  n_layer: i64,
  n_embd: i64,
  n_head: i64,
  n_head_kv: i64,
  head_dim: i64,
  n_ff: i64,
  n_vocab: i64,
  context_length: i64,
  rms_eps_bits: i64,
  rope_type: i64,
  rope_dim_count: i64,
  rope_freq_base_bits: i64,
  attn_scale_bits: i64,
  output_tied: bool,
  output_ggml_type: i64,

  token_count: i64,
  embedding_block_index: i64,
  output_block_index: i64,
  narrow_layer: i64,
  narrow_index: i64,
  attention_width: i64,
  reconciliation_width: i64,

  window_bytes: i64,
  peak_block_index: i64,
  peak_block_kind: i64,
  peak_block_layer: i64,
  peak_block_bytes: i64,
  window_reuse_count: i64,
  pointer_identity_failures: i64,
  member_placements: i64,

  // R5C section 3.8's `device` object and the two fields microbenchmark A exists to publish. The
  // device block is read **once, before the window is sized**, so an error document produced at
  // step 21a still names the device that refused. `--model-forward` fills these in too — the
  // schedule is one schedule — and its renderer does not emit them, which is why sections 3.1 and
  // 3.2's promise that every `R5_MODEL_FORWARD` golden is byte-unchanged is a mechanical fact
  // rather than a claim.
  device_kind: i64,
  device_name: string,
  device_description: string,
  device_type_id: i64,
  device_host_ptr: bool,
  device_host_buffer: bool,
  device_buffer_alignment: i64,
  device_buffer_max_size: i64,
  device_memory_free: i64,
  device_memory_total: i64,
  // Section 6, correction C14. Both are **tri-state**: `-1` is "not evaluated", which is what an
  // error document produced before step 21 or step 21a carries. Publishing `0`/`false` there would
  // have read as a device that declares no alignment and a window that does not fit, which is a
  // measurement the run never made.
  device_window_fits: i64,
  // The transfer, summed over every window wrap, and the number of wraps. On unified memory the
  // wrap copies zero bytes and still costs 26 us/MB (section 2.7), which is the measurement this
  // capability exists to make rather than to assume away.
  wrap_ns: i64,
  wrap_count: i64,

  graph_count: i64,
  node_count_total: i64,
  reconciliation_node_count: i64,
  slot_capacity: i64,
  slot_high_water: i64,
  activation_bytes_peak: i64,
  graph_context_bytes: i64,
  backend_name: string,

  head_output_norm_bytes: i64,
  head_output_bytes: i64,
  head_pread_ns: i64,
  head_compute_ns: i64,
  head_node_count: i64,
  result_norm_sha256: string,
  result_norm_bit_sum: i64,

  residual_bytes: i64,
  logits_bytes: i64,

  sha256: string,
  bit_sum: i64,
  element_count: i64,
  nonfinite_count: i64,
  argmax: i64,

  reference_verdict: i64,
  reference_pread_count: i64,
  reference_bytes_read: i64,
  reference_graphs: i64,
  reference_compared: i64,
  reference_identical: i64,
  reference_first_graph: i64,
  reference_first_node: string,
  reference_first_index: i64,
  reference_first_primary_bits: i64,
  reference_first_reference_bits: i64,

  oracle_verdict: i64,
  oracle_layers_expected: i64,
  oracle_layers_matched: i64,
  oracle_expected: i64,
  oracle_matched: i64,
  oracle_elements: i64,
  oracle_max_abs: i64,
  oracle_max_sum: i64,
  oracle_worst_layer: i64,
  oracle_worst_node: string,
  oracle_worst_element: i64,
  oracle_lines: i64,
  oracle_callback_lines: i64,

  logits_verdict: i64,
  logits_compared_reconciliation: bool,
  logits_byte_identical: bool,
  logits_max_abs: i64,
  // R5C section 3.8's tolerance block. The three distribution fields are **recorded** — section 2.3
  // measured 529/468/1,655/2,089 ten-thousandths and zero elements over 0.5 — and only `max_abs`,
  // the `argmax`, and the top ten gate. `logits_tolerance` is the arm's own bound rather than a
  // module constant, so the two arms' numbers cannot be unified by accident: they characterize
  // different causes (a missing KV cache there, GPU kernel accumulation order here) and forcing
  // them to share a constant would make a later change to one silently move the other.
  logits_mean_abs: i64,
  logits_p99_abs: i64,
  logits_over_half: i64,
  logits_tolerance: i64,
  logits_strict_reconciliation: bool,
  compare_transcript_elements: bool,
  logits_argmax_reference: i64,
  logits_top_k_agreement: i64,
  logits_elements: i64,
  logits_reference_sha256: string,
  logits_reference_bit_sum: i64,

  pread_ns: i64,
  build_ns: i64,
  reserve_ns: i64,
  compute_ns: i64,
  reconciliation_compute_ns: i64,
  reference_compute_ns: i64,
  oracle_ns: i64,
  elapsed_ns: i64,

  ggml_buffers_created: i64,
  ggml_buffers_freed: i64,
  contexts_created: i64,
  contexts_freed: i64,
  backends_created: i64,
  backends_freed: i64,
  graphs_created: i64,
  gallocrs_created: i64,
  gallocrs_freed: i64,
  released_before_owner_scope_end: bool,
  graph_balance_failures: i64,

  tensor_alignment: i64,
  table_drift: i64,
  slot_magic_ok: bool,
  fp_contract_off: bool,
}

