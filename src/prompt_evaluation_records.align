    policy_id: value.policy_id.clone(),
    minimum_task_count: value.minimum_task_count,
    minimum_samples_per_variant: value.minimum_samples_per_variant,
    minimum_completion_gain_count: value.minimum_completion_gain_count,
    minimum_time_improvement_ppm: value.minimum_time_improvement_ppm,
    maximum_time_regression_ppm: value.maximum_time_regression_ppm,
    maximum_repair_loop_regression_count: value.maximum_repair_loop_regression_count,
    content_sha256: value.content_sha256.clone(),
  }
}

pub fn generation(borrow value: prompt_artifacts.GenerationPolicy) -> prompt_artifacts.GenerationPolicy {
  return prompt_artifacts.GenerationPolicy {
    schema_version: value.schema_version,
    artifact_kind: value.artifact_kind.clone(),
    generation_policy_id: value.generation_policy_id.clone(),
    evaluation_provider_kind: value.evaluation_provider_kind.clone(),
    evaluation_provider_endpoint_id: value.evaluation_provider_endpoint_id.clone(),
    evaluation_provider_model: value.evaluation_provider_model.clone(),
    provider_control_sha256: value.provider_control_sha256.clone(),
    provider_service_revision: value.provider_service_revision.clone(),
    max_prompt_bytes: value.max_prompt_bytes,
    max_tokens: value.max_tokens,
    temperature_micros: value.temperature_micros,
    seed_mode: value.seed_mode.clone(),
