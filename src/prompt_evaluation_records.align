  }
}

pub fn trust(borrow value: prompt_artifacts.PromptVerifierTrust) -> prompt_artifacts.PromptVerifierTrust {
  return prompt_artifacts.PromptVerifierTrust {
    schema_version: value.schema_version,
    artifact_kind: value.artifact_kind.clone(),
    expected_align_llm_commit: value.expected_align_llm_commit.clone(),
    expected_align_revision: value.expected_align_revision.clone(),
    expected_corpus_source_kind: value.expected_corpus_source_kind.clone(),
    expected_corpus_source_repository_id: value.expected_corpus_source_repository_id.clone(),
    expected_corpus_source_sha256: value.expected_corpus_source_sha256.clone(),
    align_llm_reachability: value.align_llm_reachability.clone(),
    align_llm_observed_head: copy_option_string(value.align_llm_observed_head),
    align_reachability: value.align_reachability.clone(),
    align_observed_revision: copy_option_string(value.align_observed_revision),
    corpus_reachability: value.corpus_reachability.clone(),
    corpus_observed_source_sha256: copy_option_string(value.corpus_observed_source_sha256),
    content_sha256: value.content_sha256.clone(),
  }
}
