pub fn control(borrow value: prompt_artifacts.EvaluationProviderControl) -> prompt_artifacts.EvaluationProviderControl {
  return prompt_artifacts.EvaluationProviderControl {
    schema_version: value.schema_version,
    artifact_kind: value.artifact_kind.clone(),
    provider_control_id: value.provider_control_id.clone(),
    provider_kind: value.provider_kind.clone(),
    endpoint: value.endpoint.clone(),
    endpoint_id: value.endpoint_id.clone(),
    model: value.model.clone(),
    api_key_env: copy_option_string(value.api_key_env),
