module runtime_olmoe

import ggml_ffi
import layer_olmoe
import olmoe_nodes
import runtime_inputs
import runtime_diagnostic
import runtime_kv

pub INPUT_PREFILL_TOKENS := 0
pub INPUT_PREFILL_POSITIONS := 1
pub INPUT_PREFILL_MASK := 2
pub INPUT_DECODE_TOKEN := 3
pub INPUT_DECODE_POSITION := 4
pub INPUT_DECODE_MASK := 5
pub INPUT_OUTPUT_ID := 6
pub INPUT_COUNT := 7

LAYER_DENSE_WEIGHT_COUNT := 9
LAYER_EXPERT_WEIGHT_COUNT := 3
LAYER_WEIGHT_COUNT := 12
// Layout-ready K/V rows: phase-A base 21 plus prefill rows 14/21 and decode rows 16/22.
PREFILL_K_SOURCE := 35
PREFILL_V_SOURCE := 42
DECODE_K_SOURCE := 37
DECODE_V_SOURCE := 43

pub fn weight_count(n_layer: i64) -> i64 {
  if n_layer < 1 || n_layer > 4096 { return -1 }
  return 3 + LAYER_WEIGHT_COUNT * n_layer
}

pub fn kv_count(n_layer: i64) -> i64 {
  if n_layer < 1 || n_layer > 4096 { return -1 }
  return 2 * n_layer
}

pub fn output_slot() -> i64 = layer_olmoe.mm_head_output_slot()

fn valid_geometry(borrow g: layer_olmoe.Geometry) -> bool {
  arch: str := g.arch
  return g.code.len() == 0 && arch == "olmoe" && g.n_layer >= 1 && g.n_layer <= 4096
    && g.n_embd > 0 && g.n_embd == g.n_head * g.head_dim && g.n_head == g.n_head_kv
    && g.head_dim > 0 && g.head_dim % 2 == 0 && g.n_ff_exp > 0 && g.n_vocab > 0
    && g.n_expert > 0 && g.n_expert_used > 0 && g.n_expert_used <= g.n_expert
    && g.context_length > 0
    && layer_olmoe.MM_DECODE_B_NODE_BASE + layer_olmoe.b_node_count(g.n_expert_used)
    <= layer_olmoe.MM_SLOT_KPAST
}

fn bind_weight(
  borrow owner: ggml_ffi.GpuDevice,
  index: i64,
  borrow slots: slice<u8>,
  out: i64,
) -> Result<(), Error> {
  ggml_ffi.gpu_weight_slot(owner, index, slots, out) else { return Err(Error.Invalid) }
  return Ok(())
}

fn bind_layer_weights(
  borrow owner: ggml_ffi.GpuDevice,
  layer: i64,
  borrow slots: slice<u8>,
) -> Result<(), Error> {
  base := 1 + LAYER_WEIGHT_COUNT * layer
  mut member := 0
  loop {
    if member >= LAYER_DENSE_WEIGHT_COUNT { break }
    bind_weight(owner, base + member, slots, member)?
    member = member + 1
  }
  mut expert := 0
  loop {
    if expert >= LAYER_EXPERT_WEIGHT_COUNT { break }
    bind_weight(
      owner, base + LAYER_DENSE_WEIGHT_COUNT + expert,
      slots, layer_olmoe.MM_SLOT_GATE + expert,
    )?
    expert = expert + 1
  }
  return Ok(())
}

fn bind_prefill_inputs(
  borrow owner: ggml_ffi.GpuDevice,
  tokens: i64,
  width: i64,
  borrow slots: slice<u8>,
) -> Result<(), Error> {
  ggml_ffi.gpu_input_slot(owner, INPUT_PREFILL_TOKENS, slots, layer_olmoe.MM_SLOT_TOKENS) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_input_slot(owner, INPUT_PREFILL_POSITIONS, slots, layer_olmoe.MM_SLOT_POS) else {
    return Err(Error.Invalid)
  }
  runtime_inputs.mask_prefix_slot(
    owner, INPUT_PREFILL_MASK, ggml_ffi.GPU_GRAPH_PREFILL, width, tokens,
    slots, layer_olmoe.MM_SLOT_MASK,
  )?
  ggml_ffi.gpu_input_slot(owner, INPUT_OUTPUT_ID, slots, layer_olmoe.MM_SLOT_OUT_IDS) else {
    return Err(Error.Invalid)
  }
  return Ok(())
}

fn bind_decode_inputs(
  borrow owner: ggml_ffi.GpuDevice,
  width: i64,
  borrow slots: slice<u8>,
) -> Result<(), Error> {
  ggml_ffi.gpu_input_slot(owner, INPUT_DECODE_TOKEN, slots, layer_olmoe.MM_SLOT_TOKENS) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.gpu_input_slot(owner, INPUT_DECODE_POSITION, slots, layer_olmoe.MM_SLOT_POS) else {
    return Err(Error.Invalid)
  }
  runtime_inputs.mask_prefix_slot(
    owner, INPUT_DECODE_MASK, ggml_ffi.GPU_GRAPH_DECODE, width, 1,
    slots, layer_olmoe.MM_SLOT_MASK,
  )?
  ggml_ffi.gpu_input_slot(owner, INPUT_OUTPUT_ID, slots, layer_olmoe.MM_SLOT_OUT_IDS) else {
    return Err(Error.Invalid)
  }
  return Ok(())
}

fn carry(borrow slots: slice<u8>, source: i64, label: str) -> Result<(), Error> {
  ggml_ffi.slot_copy(slots, layer_olmoe.MM_SLOT_CUR, slots, source, label) else {
    return Err(Error.Invalid)
  }
  return Ok(())
}

fn expand(
  graph: raw,
  borrow slots: slice<u8>,
  slot: i64,
  label: str,
) -> Result<(), Error> {
  ggml_ffi.graph_expand(graph, slots, slot, label) else { return Err(Error.Invalid) }
  return Ok(())
}

fn bridge_phase_b(
  ctx: raw,
  borrow slots: slice<u8>,
  borrow g: layer_olmoe.Geometry,
  tokens: i64,
  decode: bool,
) -> Result<(), Error> {
  base := layer_olmoe.MM_A_NODE_BASE
  residual := base + if decode { 31 } else { 29 }
  norm := base + if decode { 33 } else { 31 }
  probs := base + if decode { 35 } else { 33 }
  topk := base + if decode { 36 } else { 34 }
  ggml_ffi.slot_copy(
    slots, layer_olmoe.MM_SLOT_FFN_INP, slots, residual, "olmoe_ffn_input",
  ) else { return Err(Error.Invalid) }
  ggml_ffi.slot_copy(
    slots, layer_olmoe.MM_SLOT_FFN_NORM, slots, norm, "olmoe_ffn_norm",
  ) else { return Err(Error.Invalid) }
  ggml_ffi.slot_copy(
    slots, layer_olmoe.MM_SLOT_PROBS, slots, probs, "olmoe_probs",
  ) else { return Err(Error.Invalid) }
  ggml_ffi.op_view_2d(
    ctx, slots, layer_olmoe.MM_SLOT_TOPK, topk, g.n_expert_used, tokens,
    1, 0, 0, "olmoe_topk",
  ) else { return Err(Error.Invalid) }
  // The resident expert planes retain global expert order, so the global argsort ids are also the
  // `mul_mat_id` plane ids. No host routing map or compact expert upload exists in this path.
  ggml_ffi.slot_copy(
    slots, layer_olmoe.MM_SLOT_COMPACT, slots, layer_olmoe.MM_SLOT_TOPK,
    "olmoe_resident_expert_ids",
  ) else { return Err(Error.Invalid) }
  return Ok(())
}

fn build_head(
  borrow owner: ggml_ffi.GpuDevice,
  ctx: raw,
  graph: raw,
  borrow g: layer_olmoe.Geometry,
  borrow slots: slice<u8>,
) -> Result<(), Error> {
  head_base := 1 + LAYER_WEIGHT_COUNT * g.n_layer
  bind_weight(owner, head_base, slots, 0)?
  bind_weight(owner, head_base + 1, slots, 1)?
  nodes := layer_olmoe.mm_head_node_table(g)
  olmoe_nodes.build(ctx, slots, nodes, false, false, false) else {
    return Err(Error.Invalid)
  }
  ggml_ffi.slot_mark_output(slots, output_slot(), "olmoe_logits") else {
    return Err(Error.Invalid)
  }
  expand(graph, slots, output_slot(), "olmoe_logits")?
  return Ok(())
}

pub fn build_prefill(
  borrow owner: ggml_ffi.GpuDevice,
  borrow g: layer_olmoe.Geometry,
  tokens: i64,
  ctx: raw,
  graph: raw,
  borrow slots: slice<u8>,
) -> Result<(), Error> {
  mut capture := runtime_diagnostic.disabled()
  return build_prefill_diagnostic(owner, g, tokens, ctx, graph, slots, capture)
}

pub fn build_prefill_diagnostic(
  borrow owner: ggml_ffi.GpuDevice,
  borrow g: layer_olmoe.Geometry,
  tokens: i64,
  ctx: raw,
  graph: raw,
  borrow slots: slice<u8>,
  borrow mut capture: runtime_diagnostic.Capture,
) -> Result<(), Error> {
  runtime_diagnostic.reset(capture)?
  if !valid_geometry(g) || tokens < 1 || tokens > layer_olmoe.MAX_PREFILL_TOKENS
    || tokens > g.context_length || ggml_ffi.handle_absent(ctx)
    || ggml_ffi.handle_absent(graph) {
    return Err(Error.Invalid)
  }
  ggml_ffi.slots_init(slots, slots.len(), "olmoe_prefill_slots") else {
    return Err(Error.Invalid)
  }
  width := runtime_inputs.attention_width(tokens, g.context_length)?
  bind_prefill_inputs(owner, tokens, width, slots)?
  bind_weight(owner, 0, slots, 0)?
  embed := layer_olmoe.mm_embed_node_table(g)
  olmoe_nodes.build(ctx, slots, embed, false, false, false) else {
    return Err(Error.Invalid)
  }
  carry(slots, layer_olmoe.mm_embed_output_slot(), "olmoe_embed")?

  a_nodes := layer_olmoe.mm_a_node_table(g, tokens, width)
  mut layer := 0
  loop {
    if layer >= g.n_layer { break }
    bind_layer_weights(owner, layer, slots)?
    last := layer == g.n_layer - 1
    olmoe_nodes.build(ctx, slots, a_nodes, last, width > tokens, false) else {
      return Err(Error.Invalid)
    }
    runtime_kv.write_slot(
      owner, 2 * layer, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_KV_LAYOUT_K,
      0, slots, layer_olmoe.MM_SLOT_KPAST, PREFILL_K_SOURCE,
    )?
    runtime_kv.write_slot(
      owner, 2 * layer + 1, ggml_ffi.GPU_GRAPH_PREFILL, ggml_ffi.GPU_KV_LAYOUT_V,
      0, slots, layer_olmoe.MM_SLOT_VPAST, PREFILL_V_SOURCE,
    )?
    expand(graph, slots, layer_olmoe.MM_SLOT_KPAST, "olmoe_prefill_k")?
    expand(graph, slots, layer_olmoe.MM_SLOT_VPAST, "olmoe_prefill_v")?
    bridge_phase_b(ctx, slots, g, if last { 1 } else { tokens }, false)?
    t_out := if last { 1 } else { tokens }
    b_nodes := layer_olmoe.mm_b_node_table(g, t_out)
    olmoe_nodes.build(ctx, slots, b_nodes, false, false, false) else {
      return Err(Error.Invalid)
    }
    runtime_diagnostic.retain(capture, slots, layer, 0, layer_olmoe.mm_b_output_slot(g.n_expert_used))?
    runtime_diagnostic.retain(capture, slots, layer, 1, layer_olmoe.MM_A_NODE_BASE + 33)?
    runtime_diagnostic.retain(capture, slots, layer, 2, layer_olmoe.MM_A_NODE_BASE + 34)?
    runtime_diagnostic.retain(capture, slots, layer, 3, layer_olmoe.MM_B_NODE_BASE + 1)?
    carry(slots, layer_olmoe.mm_b_output_slot(g.n_expert_used), "olmoe_layer")?
    layer = layer + 1
  }
  build_head(owner, ctx, graph, g, slots)?
  return Ok(())
}

pub fn build_decode(
  borrow owner: ggml_ffi.GpuDevice,
  borrow g: layer_olmoe.Geometry,
  n_past: i64,
  ctx: raw,
  graph: raw,
  borrow slots: slice<u8>,
) -> Result<(), Error> {
  mut capture := runtime_diagnostic.disabled()
  return build_decode_diagnostic(owner, g, n_past, ctx, graph, slots, capture)
}

pub fn build_decode_diagnostic(
  borrow owner: ggml_ffi.GpuDevice,
  borrow g: layer_olmoe.Geometry,
  n_past: i64,
  ctx: raw,
  graph: raw,
  borrow slots: slice<u8>,
  borrow mut capture: runtime_diagnostic.Capture,
) -> Result<(), Error> {
  runtime_diagnostic.reset(capture)?
  if !valid_geometry(g) || n_past < 1 || n_past >= g.context_length
    || ggml_ffi.handle_absent(ctx) || ggml_ffi.handle_absent(graph) {
    return Err(Error.Invalid)
  }
  ggml_ffi.slots_init(slots, slots.len(), "olmoe_decode_slots") else {
    return Err(Error.Invalid)
  }
  width := runtime_inputs.attention_width(n_past + 1, g.context_length)?
  bind_decode_inputs(owner, width, slots)?
  bind_weight(owner, 0, slots, 0)?
  embed := layer_olmoe.mm_embed_node_table(g)
  olmoe_nodes.build(ctx, slots, embed, false, false, false) else {
    return Err(Error.Invalid)
  }
  carry(slots, layer_olmoe.mm_embed_output_slot(), "olmoe_embed")?

  a_nodes := layer_olmoe.mm_decode_a_node_table(g, n_past, width)
  b_nodes := layer_olmoe.mm_decode_b_node_table(g)
  mut layer := 0
  loop {
    if layer >= g.n_layer { break }
    bind_layer_weights(owner, layer, slots)?
    runtime_kv.prefix_slot(
      owner, 2 * layer, ggml_ffi.GPU_GRAPH_DECODE, ggml_ffi.GPU_KV_LAYOUT_K,
      n_past, slots, layer_olmoe.MM_SLOT_KPAST,
    )?
    runtime_kv.prefix_slot(
      owner, 2 * layer + 1, ggml_ffi.GPU_GRAPH_DECODE, ggml_ffi.GPU_KV_LAYOUT_V,
      n_past, slots, layer_olmoe.MM_SLOT_VPAST,
    )?
    last := layer == g.n_layer - 1
    olmoe_nodes.build(ctx, slots, a_nodes, last, false, true) else {
      return Err(Error.Invalid)
    }
    runtime_kv.write_slot(
      owner, 2 * layer, ggml_ffi.GPU_GRAPH_DECODE, ggml_ffi.GPU_KV_LAYOUT_K,
      n_past, slots, layer_olmoe.MM_SLOT_KPAST, DECODE_K_SOURCE,
    )?
    runtime_kv.write_slot(
      owner, 2 * layer + 1, ggml_ffi.GPU_GRAPH_DECODE, ggml_ffi.GPU_KV_LAYOUT_V,
      n_past, slots, layer_olmoe.MM_SLOT_VPAST, DECODE_V_SOURCE,
    )?
    expand(graph, slots, layer_olmoe.MM_SLOT_KPAST, "olmoe_decode_k")?
    expand(graph, slots, layer_olmoe.MM_SLOT_VPAST, "olmoe_decode_v")?
    bridge_phase_b(ctx, slots, g, 1, true)?
    olmoe_nodes.build(ctx, slots, b_nodes, false, false, false) else {
      return Err(Error.Invalid)
    }
    runtime_diagnostic.retain(capture, slots, layer, 0, layer_olmoe.mm_decode_b_output_slot(g.n_expert_used))?
    runtime_diagnostic.retain(capture, slots, layer, 1, layer_olmoe.MM_A_NODE_BASE + 35)?
    runtime_diagnostic.retain(capture, slots, layer, 2, layer_olmoe.MM_A_NODE_BASE + 36)?
    runtime_diagnostic.retain(capture, slots, layer, 3, layer_olmoe.MM_DECODE_B_NODE_BASE + 1)?
    carry(slots, layer_olmoe.mm_decode_b_output_slot(g.n_expert_used), "olmoe_layer")?
    layer = layer + 1
  }
  build_head(owner, ctx, graph, g, slots)?
  return Ok(())
}
