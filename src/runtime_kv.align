module runtime_kv

import ggml_ffi

pub Shape {
  ggml_type: i64,
  n_dims: i64,
  ne0: i64,
  ne1: i64,
  ne2: i64,
  ne3: i64,
}

pub fn begin(borrow owner: ggml_ffi.GpuDevice, tensor_count: i64) -> Result<(), Error> {
  ggml_ffi.gpu_kv_begin(owner, tensor_count) else {
    return Err(Error.Invalid)
  }
  return Ok(())
}

pub fn add(borrow owner: ggml_ffi.GpuDevice, shape: Shape) -> Result<i64, Error> =
match ggml_ffi.gpu_kv_add(
  owner,
  shape.ggml_type,
  shape.n_dims,
  shape.ne0,
  shape.ne1,
  shape.ne2,
  shape.ne3,
) {
  Ok(index) => Ok(index),
  Err(_) => Err(Error.Invalid),
}

pub fn update(
  borrow owner: ggml_ffi.GpuDevice,
  index: i64,
  offset: i64,
  borrow data: slice<u8>,
) -> Result<(), Error> {
  ggml_ffi.gpu_kv_update(owner, index, offset, data) else {
    return Err(Error.Invalid)
  }
  return Ok(())
}

pub fn prefix_slot(
  borrow owner: ggml_ffi.GpuDevice,
  index: i64,
  kind: i64,
  layout: i64,
  valid_width: i64,
  borrow slots: slice<u8>,
  out: i64,
) -> Result<(), Error> {
  ggml_ffi.gpu_kv_prefix_slot(owner, index, kind, layout, valid_width, slots, out) else {
    return Err(Error.Invalid)
  }
  return Ok(())
}

pub fn write_slot(
  borrow owner: ggml_ffi.GpuDevice,
  index: i64,
  kind: i64,
  layout: i64,
  position: i64,
  borrow slots: slice<u8>,
  out: i64,
  source: i64,
) -> Result<(), Error> {
  ggml_ffi.gpu_kv_write_slot(owner, index, kind, layout, position, slots, out, source) else {
    return Err(Error.Invalid)
  }
  return Ok(())
}

pub fn write_indexed_prefix(
  borrow owner: ggml_ffi.GpuDevice, index: i64, kind: i64, layout: i64, indices: i64, width: i64,
  borrow slots: slice<u8>, out: i64, source: i64,
) -> Result<(), Error> {
  ggml_ffi.gpu_kv_write_indexed_prefix(owner, index, kind, layout, indices, width, slots, out, source) else { return Err(Error.Invalid) }
  return Ok(())
}

pub fn finish(borrow owner: ggml_ffi.GpuDevice) -> Result<(), Error> {
  ggml_ffi.gpu_kv_finish(owner) else {
    return Err(Error.Invalid)
  }
  return Ok(())
}

pub fn state(borrow owner: ggml_ffi.GpuDevice, field: i64) -> i64 =
ggml_ffi.gpu_kv_state(owner, field)

pub fn write_prefix(borrow owner: ggml_ffi.GpuDevice, index: i64, kind: i64,
  layout: i64, position: i64, width: i64, borrow slots: slice<u8>, out: i64, source: i64) -> Result<(), Error> {
  ggml_ffi.gpu_kv_write_prefix(owner, index, kind, layout, position, width, slots, out, source) else { return Err(Error.Invalid) }
  return Ok(())
}

pub fn prefill_chunk(borrow owner: ggml_ffi.GpuDevice, index: i64, layout: i64,
  position: i64, valid: i64, width: i64, ctx: raw, borrow slots: slice<u8>,
  out: i64, source: i64) -> Result<(), Error> {
  if width < valid { return Err(Error.Invalid) }
  write_prefix(owner, index, ggml_ffi.GPU_GRAPH_PREFILL, layout, position, valid, slots, out, source)?
  if width > valid {
    ggml_ffi.op_pad(ctx, slots, out, out,
      if layout == ggml_ffi.GPU_KV_LAYOUT_V { width - valid } else { 0 },
      if layout == ggml_ffi.GPU_KV_LAYOUT_K { width - valid } else { 0 },
      0, 0, "prefill_kv_padding") else { return Err(Error.Invalid) }
  }
  return Ok(())
}
