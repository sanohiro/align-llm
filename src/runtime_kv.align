module runtime_kv

import ggml_ffi

pub Shape {
  ggml_type: i64,
  n_dims: i64,
  ne0: i64,
  ne1: i64,
  ne2: i64,
  ne3: i64,
}

pub fn begin(borrow owner: ggml_ffi.GpuDevice, tensor_count: i64) -> Result<(), Error> {
  ggml_ffi.gpu_kv_begin(owner, tensor_count) else {
    return Err(Error.Invalid)
  }
  return Ok(())
}

pub fn add(borrow owner: ggml_ffi.GpuDevice, shape: Shape) -> Result<i64, Error> =
match ggml_ffi.gpu_kv_add(
  owner,
  shape.ggml_type,
  shape.n_dims,
  shape.ne0,
  shape.ne1,
  shape.ne2,
  shape.ne3,
) {
  Ok(index) => Ok(index),
  Err(_) => Err(Error.Invalid),
}

pub fn update(
  borrow owner: ggml_ffi.GpuDevice,
  index: i64,
  offset: i64,
  borrow data: slice<u8>,
) -> Result<(), Error> {
  ggml_ffi.gpu_kv_update(owner, index, offset, data) else {
    return Err(Error.Invalid)
  }
  return Ok(())
}

pub fn prefix_slot(
  borrow owner: ggml_ffi.GpuDevice,
  index: i64,
  kind: i64,
  valid_width: i64,
  borrow slots: slice<u8>,
  out: i64,
) -> Result<(), Error> {
  ggml_ffi.gpu_kv_prefix_slot(owner, index, kind, valid_width, slots, out) else {
    return Err(Error.Invalid)
  }
  return Ok(())
}

pub fn finish(borrow owner: ggml_ffi.GpuDevice) -> Result<(), Error> {
  ggml_ffi.gpu_kv_finish(owner) else {
    return Err(Error.Invalid)
  }
  return Ok(())
}

pub fn state(borrow owner: ggml_ffi.GpuDevice, field: i64) -> i64 =
ggml_ffi.gpu_kv_state(owner, field)
