pub fn render(
  borrow o: Outcome,
  pack_path: str,
  geometry_path: str,
  reference_path: str,
  transcript_path: str,
  logits_path: str,
  borrow tokens: TokenColumns,
  borrow schedule: ScheduleRows,
  borrow residency_json: string,
  borrow window_json: string,
  borrow graph_json: string,
  borrow output_json: string,
  borrow oracles_json: string,
  borrow transcript_json: string,
  borrow tail_json: string,
) -> string {
  failed := o.code.len() > 0
  code_view: str := o.code
  detail_view: str := o.detail
  header := render_head(o, tokens)
  header_view: str := header
  schedule_view: str := schedule.text
  residency_view: str := residency_json
  window_view: str := window_json
  graph_view: str := graph_json
  output_view: str := output_json
  oracles_view: str := oracles_json
  transcript_view: str := transcript_json
  tail_view: str := tail_json

  d := builder()
  d.write("{\"schema_version\":")
  d.write_int(SCHEMA_VERSION)
  d.write(",\"kind\":")
  d.write(json_string(DOCUMENT_KIND))
  d.write(",\"pack_path\":")
  d.write(json_string(pack_path))
  d.write(",\"geometry_path\":")
  d.write(json_string(geometry_path))
  d.write(",\"reference_path\":")
  d.write(json_string(reference_path))
  d.write(",\"transcript_path\":")
  d.write(json_string(transcript_path))
  d.write(",\"logits_path\":")
  d.write(json_string(logits_path))
  d.write(",\"status\":")
  d.write(json_string(if failed { "error" } else { "ok" }))
  d.write(",\"error_code\":")
  d.write(json_string(code_view))
  d.write(",\"error_detail\":")
  d.write(json_string(detail_view))
  d.write(",\"verdict\":")
  d.write(json_string(verdict_label(o.verdict)))
  d.write(",\"pack\":{\"format_version\":")
  d.write_int(o.format_version)
  d.write(",\"block_align\":")
  d.write_int(o.block_align)
  d.write(",\"member_align\":")
  d.write_int(o.member_align)
  d.write(",\"block_count\":")
  d.write_int(o.block_count)
  d.write(",\"member_count\":")
  d.write_int(o.member_count)
  d.write(",\"total_bytes\":")
  d.write_int(o.total_bytes)
  d.write(",\"payload_offset\":")
  d.write_int(o.payload_offset)
  d.write(",\"reader_pread_count\":")
  d.write_int(o.reader_pread_count)
  d.write(",\"reader_bytes_read\":")
  d.write_int(o.reader_bytes_read)
  d.write("},")
  d.write(header_view)
  d.write(",\"schedule\":[")
  d.write(schedule_view)
  d.write("],\"residency\":")
  d.write(residency_view)
  d.write(",\"window\":")
  d.write(window_view)
  d.write(",\"graph\":")
  d.write(graph_view)
  d.write(",\"head\":")
  d.write(output_view)
  d.write(",\"reference\":")
  d.write(oracles_view)
  d.write(",\"oracle\":")
  d.write(transcript_view)
  d.write(",\"timings\":")
  d.write(tail_view)
  d.write("}")
  return d.to_string()
}

// ---------------------------------------------------------------------------------------------
// The summary block and the CLI adapter (section 3.3)
// ---------------------------------------------------------------------------------------------

fn print_pair(left: i64, right: i64) {
  b := builder()
  b.write_int(left)
  b.write("/")
  b.write_int(right)
  rendered := b.to_string()
  rendered_view: str := rendered
  print(rendered_view)
}

fn print_summary(borrow o: Outcome, borrow tokens: TokenColumns, pack_path: str) {
  failed := o.code.len() > 0
  print("moe model forward:")
  print("status:")
  if failed { print("ERROR") } else { print("OK") }
  print("verdict:")
  print(verdict_label(o.verdict))
  print("pack path:")
  sanitized_path := sanitize_summary_line(pack_path)
  sanitized_path_view: str := sanitized_path
  print(sanitized_path_view)
  print("schema:")
  print(SCHEMA_VERSION)
  print("arch:")
  arch_view: str := o.arch
  sanitized_arch := sanitize_summary_line(arch_view)
  sanitized_arch_view: str := sanitized_arch
  print(sanitized_arch_view)
  print("layers:")
  print(o.n_layer)
  print("tokens:")
  ids := builder()
  mut token_at := 0
  loop {
    if token_at >= tokens.ids.len() { break }
    if token_at > 0 { ids.write(",") }
    ids.write_int(tokens.ids[token_at])
    token_at = token_at + 1
  }
  rendered_ids := ids.to_string()
  rendered_ids_view: str := rendered_ids
  print(rendered_ids_view)
  print("kv width:")
  print(o.attention_width)
  print("experts routed:")
  print_pair(o.keys_demanded, o.n_layer * o.n_expert)
  print("expert bytes read:")
  print(o.expert_bytes_read)
  print("expert bytes in model:")
  print(o.expert_bytes_in_model)
  print("dense bytes read:")
  print(o.dense_bytes_read)
  print("dense window bytes:")
  print(o.dense_window_bytes)
  print("claim window bytes:")
  print(o.claim_window_bytes)
  print("claim window peak use:")
  print(o.claim_peak_use_bytes)
  print("residual bytes:")
  print(o.residual_bytes)
  print("activation bytes:")
  print(o.activation_bytes_peak)
  print("graphs:")
  print(o.graph_count)
  print("graph nodes:")
  print(o.node_count_total)
  print("backend:")
  backend_view: str := o.backend_name
  sanitized_backend := sanitize_summary_line(backend_view)
  sanitized_backend_view: str := sanitized_backend
  print(sanitized_backend_view)
  print("pread ns:")
  print(o.pread_ns)
  print("claim pread ns:")
  print(o.claim_pread_ns)
  print("compute ns:")
  print(o.compute_ns)
  print("elapsed ns:")
  print(o.elapsed_ns)
  print("logits sha256:")
  sha_view: str := o.sha256
  print(sha_view)
  print("logits bit sum:")
  print(o.bit_sum)
  print("logits argmax:")
  print(o.argmax)
  print("routing:")
  print(routing_label(o.routing_verdict))
  print("reference:")
  print(reference_label(o.reference_verdict))
  print("reference nodes:")
  if o.reference_present { print_pair(o.reference_identical, o.reference_compared) } else { print("-") }
  print("transcript:")
  print(oracle_label(o.oracle_verdict))
  print("logits oracle:")
  print(logits_label(o.logits_verdict))
  print("max abs diff:")
  print(o.oracle_max_abs)
  print("logit max diff:")
  print(o.logits_max_abs)
  print("released:")
  print(o.ggml_buffers_freed + o.contexts_freed + o.backends_freed + o.gallocrs_freed)
  if failed {
    print("error:")
    code_view: str := o.code
    print(code_view)
    print("detail:")
    detail_view: str := o.detail
    sanitized_detail := sanitize_summary_line(detail_view)
    sanitized_detail_view: str := sanitized_detail
    print(sanitized_detail_view)
  }
}

// Section 3.3: exactly five, six, seven, eight, or nine operands, and **there is no gap** —
// `KV_WIDTH` is mandatory and is operand five, because on a routed model the declared width changes
// which experts the router selects and therefore which bytes the arm reads. `-` is admitted in
// exactly two positions: the document position, where it is R0's "write to stdout", and the
// transcript position, where it means **the transcript arm does not run while the logits arm still
// does** — which is what lets the arm, rather than the runner, produce the runtime-width `WITHIN`
// verdict against the same reference logits file.
pub fn run(args: array<str>) -> Result<(), Error> {
  count := args.len()
  if count < 6 || count > 10 {
    return Err(Error.Invalid)
  }
  if !mm_valid_path(args[2]) || args[2] == "-" {
    return Err(Error.Invalid)
  }
  if !mm_valid_path(args[3]) || args[3] == "-" {
    return Err(Error.Invalid)
  }
  if count >= 7 && args[6] != "-" && !mm_valid_path(args[6]) {
    return Err(Error.Invalid)
  }
  if count >= 8 && (!mm_valid_path(args[7]) || args[7] == "-") {
    return Err(Error.Invalid)
  }
  if count >= 9 && args[8] != "-" && !mm_valid_path(args[8]) {
    return Err(Error.Invalid)
  }
  if count == 10 && (!mm_valid_path(args[9]) || args[9] == "-") {
    return Err(Error.Invalid)
  }
  reference_path := if count >= 8 { args[7] } else { "" }
  transcript_path := if count >= 9 && args[8] != "-" { args[8] } else { "" }
  logits_path := if count == 10 { args[9] } else { "" }
  mut tokens := empty_tokens()
  mut schedule := empty_schedule()
  mut graphs := empty_graphs()
  mut curve := empty_curve()
  mut top := empty_top()
  outcome := execute(
    args[2], args[3], args[4], args[5], reference_path, transcript_path, logits_path,
    tokens, schedule, graphs, curve, top)
  residency_json := render_residency(outcome, curve)
  window_json := render_window(outcome)
  graph_json := render_graph(outcome, graphs)
  output_json := render_output(outcome, top)
  oracles_json := render_oracles(outcome)
  transcript_json := render_transcript_oracle(outcome)
  tail_json := render_tail(outcome)
  document := render(
    outcome, args[2], args[3], reference_path, transcript_path, logits_path, tokens, schedule,
    residency_json, window_json, graph_json, output_json, oracles_json, transcript_json,
    tail_json)
  document_view: str := document
  if count == 6 || args[6] == "-" {
    print(document_view)
  } else {
    fs.write_file(args[6], document_view)?
    print_summary(outcome, tokens, args[2])
  }
  if outcome.code.len() > 0 {
    return Err(Error.Invalid)
  }
  return Ok(())
}
