  // Section 3.11's two-way expert-byte accounting and section 2.4's union curve. `expert_bytes_read`
  // above is the arithmetic claim over the whole run; these separate the prefill's share from the
  // decode steps', add the reader's own `pread` accounting for the claim scatters, and carry the
  // cumulative distinct-key set the capability exists to publish.
  prefill_expert_bytes: i64,
  decode_expert_bytes: i64,
  expert_pread_bytes: i64,
  decode_expert_pread_bytes: i64,

  // R6-MOE-RESIDENT-DENSE section 3.8. The `weights` object of `R6_MOE_DECODE_STEP` schema 2, owned
  // by `src/moe_decode_step.align` and rendered by nothing else: `--moe-layer-forward` and
  // `--moe-model-forward` share this record and neither renders one of these fields, so their
  // goldens cannot move. `step_dense_pack_bytes` is the capability's **primary metric** and is a
  // syscall counter, not arithmetic: it accumulates the decode steps' own dense
  // `alignpack_read.Counters.bytes_read` and never the claim scatters', which is what makes
  // "residency cannot move the expert measurement" a mechanism rather than an assurance.
  resident_mode: bool,
  resident_bytes: i64,
  resident_fill_ns: i64,
  resident_fill_pread_count: i64,
  resident_fill_bytes: i64,
  step_dense_pack_bytes: i64,
  step_expert_pack_bytes: i64,
  wrap_count: i64,
  resident_wraps_created: i64,
  resident_wraps_freed: i64,
  expert_cache_mode: bool,
  expert_cache_budget_bytes: i64,
  expert_cache_capacity_bytes: i64,
  expert_cache_key_bytes: i64,
  expert_cache_slot_count: i64,
  expert_cache_requests: i64,
  expert_cache_hits: i64,
  expert_cache_misses: i64,
  expert_cache_evictions: i64,
  expert_cache_resident_final: i64,
  expert_cache_resident_high_water: i64,
  expert_cache_bytes_served: i64,
  expert_cache_miss_bytes: i64,
  expert_cache_bytes_fetched: i64,
  union_keys_final: i64,
  union_bytes_final: i64,
  decode_keys_demanded: i64,
  decode_keys_distinct: i64,
  decode_keys_in_prefill_union: i64,
  decode_distinct_keys_in_prefill_union: i64,
  step_reuse_per_mille: i64,
  claim_decode_peak_use_bytes: i64,
  claim_planes_read_per_step: i64,
  routing_steps_compared: i64,
  routing_first_step: i64,

  tensor_alignment: i64,
  table_drift: i64,
  slot_magic_ok: bool,
  fp_contract_off: bool,
}

