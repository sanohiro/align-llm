// R5E-MOE-MODEL-PREFILL (`docs/specs/r5e-moe-model-prefill.md`). The `--moe-model-forward` arm: the
// thirty-four window fills of section 3.4, the **two** reused Align-owned windows of section 3.5,
// the four node tables of section 3.6, the four oracles of section 3.7, the
// `R5_MOE_MODEL_FORWARD` document of section 3.8, the forty-step validation order of section 3.9,
// and the per-phase teardown of section 3.10.
//
// It is a **new module** rather than four thousand more lines of `src/moe_layer_forward.align`, for
// section 5.5's reason: at this pin the checker's per-function cost is superlinear in body length
// and that module is already 4,660 lines. Every function here keeps
// `r5a-dense-layer-forward.md` section 6 correction C8's discipline — no function over two hundred
// lines, every fallible call inside a loop propagating with `?`, never a `match` on a `Result`
// inside a loop.
//
// It holds no `unsafe` and no `extern`. Every foreign call crosses `src/ggml_ffi.align`, and the
// R5D arm is **imported rather than copied**: `moe_layer_forward.parse_tokens`, `valid_path`,
// `scan_transcript`, and `TranscriptScan` are that module's public surface and this one reuses them
// unchanged.
//
// The capability in one sentence: **a whole model's weight demand is decided sixteen times over,
// each decision depending on every decision before it, and one reused window has to hold whatever
// each decision names.** Everything unusual here follows from that — two windows refilled 34 times,
// two id tables that are never one, a claim window reserved for an arithmetic bound rather than an
// observation, and a residency curve published per layer because the whole-model number hides where
// the win comes from.

pub MAX_PATH_BYTES := 4096
pub MAX_DETAIL_BYTES := 256
pub MAX_DIMENSION := 16777216
pub MAX_INDEX_DIGITS := 18

SCHEMA_VERSION := 1
DOCUMENT_KIND := "R5_MOE_MODEL_FORWARD"

// R4.5 section 3.9's compensation window, unchanged: Align has no aligned allocator
// (`docs/align-requests.md` Request 33) and every admissible `tensor_alignment` divides 64. R5E
// pays it **twice**, because there are two windows.
pub MAX_TENSOR_ALIGNMENT := 64

// Section 3.5. `2^33`, refused before a single byte is reserved, so a malformed member record
// cannot ask the process for a terabyte.
pub MAX_WINDOW_BYTES := 8589934592

// Section 3.7's logits bound, R5B's reused rather than re-derived: section 2.8 measured
// 3,086-3,491 ten-thousandths across four prompts against R5B's 5,000, and section 3.7 pre-commits
// that a fifth prompt breaching it is a finding to record rather than a number to raise.
pub LOGIT_TOLERANCE_TEN_THOUSANDTHS := 5000
pub TOP_K := 10

// R5A's transcript thresholds, inherited **unchanged and unwidened**: section 2.5 measured `0` over
// 21,372 elements and 227 nodes of a whole routed model.
pub TOLERANCE_TEN_THOUSANDTHS := 1
pub SUM_TOLERANCE_MILLIONTHS := 1000
pub SUM_TOLERANCE_RELATIVE_PPM := 10

// `r5c-metal-prefill.md` section 6 correction C19 and `r5b-model-prefill-forward.md` correction
// C23, re-raised verbatim: `as i64` **saturates**, so an infinity becomes `i64`'s extreme and a NaN
// becomes `0`, and either one can wrap a subtraction into a magnitude no `>` test can see.
pub SCALE_LIMIT_TEN_THOUSANDTHS := 1000000000000000
pub SUM_SCALE_LIMIT_MILLIONTHS := 1000000000000000000
pub UNREPRESENTABLE := 9223372036854775807

pub TRUNCATION_PRINTED := 6

// The one reused staging buffer for the dense reads and the source comparison, in the shape R5B
// correction C6 established: `f.pread` requests the buffer's whole capacity, so an oversized
// transient over-reads the tail of every member.
pub CHUNK_BYTES := 1048576
pub PRIME_CHUNK_BYTES := 65536

pub DIGEST_HEX_BYTES := 64
SUMMARY_HEX := "0123456789abcdef"

pub VERDICT_UNAVAILABLE := 0
pub VERDICT_EXTERNAL := 1
pub VERDICT_COPIED := 2

pub REFERENCE_ABSENT := 0
pub REFERENCE_IDENTICAL := 1
pub REFERENCE_MISMATCH := 2

pub ORACLE_ABSENT := 0
pub ORACLE_PASS := 1
pub ORACLE_FAIL := 2

pub ROUTING_ABSENT := 0
pub ROUTING_MATCH := 1
pub ROUTING_MISMATCH := 2

pub LOGITS_ABSENT := 0
pub LOGITS_IDENTICAL := 1
pub LOGITS_WITHIN := 2
pub LOGITS_FAIL := 3

// The three graph kinds the schedule walks; a layer is two graphs and is its own case.
pub GRAPH_EMBED := 0
pub GRAPH_HEAD := 1

pub TextBox { v: str }

// ---------------------------------------------------------------------------------------------
// Text, numbers, and the lexical guards
// ---------------------------------------------------------------------------------------------

pub fn int_text(value: i64) -> string {
  b := builder()
  b.write_int(value)
  return b.to_string()
}

pub fn bool_text(value: bool) -> string {
  if value { return "true".clone() }
  return "false".clone()
}

// The one place a `str` becomes a JSON scalar. `json.encode` escapes every byte a document may not
// carry raw; the slice drops the one-field object wrapper the encoder puts around it.
pub fn json_string(value: str) -> string {
  boxed := TextBox { v: value }
  encoded := json.encode(boxed)
  return encoded[5..encoded.len() - 1].clone()
}

// Section 3.3's six path operands are copied into the emitted document as JSON scalars. `json.encode`
// escapes every byte a JSON string may not carry **as a control character**, but a path is an OS
// byte string and a non-UTF-8 one is copied through raw, producing a document no conforming JSON
// reader can decode — which is a malformed *output* produced by a malformed *input*. R5E refuses
// such an operand in its own step 2, with `R5E_PATH` and no document at all. The check is the arm's
// and not `moe_layer_forward.valid_path`'s, so R5A/R5B/R5C/R5D keep the behaviour their goldens
// record (section 6, correction C18).
pub fn utf8_ok(path: str) -> bool {
  view := path.bytes()
  mut at := 0
  loop {
    if at >= view.len() { break }
    lead := view.u8(at) as i64
    mut extra := 0
    mut code := 0
    if lead < 128 {
      extra = 0
      code = lead
    } else if lead >= 194 && lead <= 223 {
      extra = 1
      code = lead - 192
    } else if lead >= 224 && lead <= 239 {
      extra = 2
      code = lead - 224
    } else if lead >= 240 && lead <= 244 {
      extra = 3
      code = lead - 240
    } else {
      return false
    }
    if at + extra >= view.len() { return false }
    mut k := 1
    loop {
      if k > extra { break }
      continuation := view.u8(at + k) as i64
      if continuation < 128 || continuation > 191 { return false }
      code = code * 64 + (continuation - 128)
      k = k + 1
    }
    // Overlong encodings, the UTF-16 surrogate range, and anything above U+10FFFF are refused by
    // the decoded value rather than by the lead byte alone.
    if extra == 1 && code < 128 { return false }
    if extra == 2 && (code < 2048 || (code >= 55296 && code <= 57343)) { return false }
    if extra == 3 && (code < 65536 || code > 1114111) { return false }
    at = at + extra + 1
  }
  return true
}

pub fn mm_valid_path(path: str) -> bool {
  return moe_layer_forward.valid_path(path) && utf8_ok(path)
}

pub fn bounded_detail(value: str) -> string {
  if value.len() <= MAX_DETAIL_BYTES { return value.clone() }
  return value[0..MAX_DETAIL_BYTES].clone()
}

pub fn labelled(label: str, value: i64) -> string {
  b := builder()
  b.write(label)
  b.write("[")
  b.write_int(value)
  b.write("]")
  return b.to_string()
}

pub fn named(label: str, value: str) -> string {
  b := builder()
  b.write(label)
  b.write("[")
  b.write(value)
  b.write("]")
  return b.to_string()
}

// `layer[<n>]role[<name>]` and `layer[<n>]node[<id>]`, the two detail shapes section 3.9 names for
// almost every code the schedule can raise.
pub fn layer_named(layer: i64, label: str, value: str) -> string {
  b := builder()
  b.write("layer[")
  b.write_int(layer)
  b.write("]")
  b.write(label)
  b.write("[")
  b.write(value)
  b.write("]")
  return b.to_string()
}

pub fn layer_numbered(layer: i64, label: str, value: i64) -> string {
  b := builder()
  b.write("layer[")
  b.write_int(layer)
  b.write("]")
  b.write(label)
  b.write("[")
  b.write_int(value)
  b.write("]")
  return b.to_string()
}

pub fn layer_expert_role(layer: i64, expert: i64, role: str) -> string {
  b := builder()
  b.write("layer[")
  b.write_int(layer)
  b.write("]expert[")
  b.write_int(expert)
  b.write("]role[")
  b.write(role)
  b.write("]")
  return b.to_string()
}

pub fn graph_node_at(graph: i64, layer: i64, node: str, index: i64) -> string {
  b := builder()
  b.write("graph[")
  b.write_int(graph)
  b.write("]layer[")
  b.write_int(layer)
  b.write("]node[")
  b.write(node)
  b.write("]@")
  b.write_int(index)
  return b.to_string()
}

pub fn block_detail(kind: i64, layer: i64, role: str) -> string {
  b := builder()
  b.write("kind[")
  b.write_int(kind)
  b.write("]layer[")
  b.write_int(layer)
  b.write("]role[")
  b.write(role)
  b.write("]")
  return b.to_string()
}

pub fn shortfall(layer: i64, node: str, got: i64, expected: i64) -> string {
  b := builder()
  b.write("layer[")
  b.write_int(layer)
  b.write("]node[")
  b.write(node)
  b.write("]")
  b.write_int(got)
  b.write("/")
  b.write_int(expected)
  return b.to_string()
}

pub fn sanitize_summary_line(value: str) -> string {
  b := builder()
  view := value.bytes()
  mut start := 0
  mut index := 0
  loop {
    if index >= view.len() { break }
    byte := view.u8(index) as i64
    if byte < 32 || byte == 127 {
      if index > start { b.write(value[start..index]) }
      high := byte / 16
      low := byte % 16
      b.write("\\x")
      b.write(SUMMARY_HEX[high..high + 1])
      b.write(SUMMARY_HEX[low..low + 1])
      start = index + 1
    }
    index = index + 1
  }
  if start < view.len() { b.write(value[start..view.len()]) }
  return b.to_string()
}

// A non-negative decimal integer, no sign, no leading `+`, no whitespace, no leading zero beyond a
// bare `0`. `-1` means "not a number this grammar produces".
pub fn parse_index(value: str) -> i64 {
  if value.len() == 0 || value.len() > MAX_INDEX_DIGITS { return -1 }
  view := value.bytes()
  if view.len() > 1 && view.u8(0) as i64 == 48 { return -1 }
  mut total := 0
  mut index := 0
  loop {
    if index >= view.len() { break }
    byte := view.u8(index) as i64
    if byte < 48 || byte > 57 { return -1 }
    total = total * 10 + (byte - 48)
    index = index + 1
  }
  return total
}

pub fn error_name(e: Error) -> str = match e {
  NotFound => "NotFound",
  Invalid => "Invalid",
  Denied => "Denied",
  Timeout => "Timeout",
  Code(_) => "Code",
}

pub fn verdict_label(value: i64) -> str {
  if value == VERDICT_EXTERNAL { return "EXTERNAL" }
  if value == VERDICT_COPIED { return "COPIED" }
  return "UNAVAILABLE"
}

pub fn reference_label(value: i64) -> str {
  if value == REFERENCE_IDENTICAL { return "IDENTICAL" }
  if value == REFERENCE_MISMATCH { return "MISMATCH" }
  return "-"
}

pub fn oracle_label(value: i64) -> str {
  if value == ORACLE_PASS { return "PASS" }
  if value == ORACLE_FAIL { return "FAIL" }
  return "-"
}

pub fn routing_label(value: i64) -> str {
  if value == ROUTING_MATCH { return "MATCH" }
  if value == ROUTING_MISMATCH { return "MISMATCH" }
  return "-"
}

pub fn logits_label(value: i64) -> str {
  if value == LOGITS_IDENTICAL { return "IDENTICAL" }
  if value == LOGITS_WITHIN { return "WITHIN" }
  if value == LOGITS_FAIL { return "FAIL" }
  return "-"
}

pub fn align_up(value: i64, alignment: i64) -> i64 {
  if alignment <= 1 { return value }
  remainder := value % alignment
  if remainder == 0 { return value }
  return value + (alignment - remainder)
}

pub fn larger(a: i64, b: i64) -> i64 {
  if a > b { return a }
  return b
}

pub fn printed_count(extent: i64) -> i64 {
  if extent <= TRUNCATION_PRINTED { return extent }
  return TRUNCATION_PRINTED
}

pub fn column_at(borrow column: array<i64>, index: i64) -> i64 {
  if index < 0 || index >= column.len() { return 0 }
  return column[index]
}

pub fn fill_zero(borrow mut b: buffer, n: i64) {
  mut index := 0
  loop {
    if index >= n { break }
    b.put_u8(0 as u8)
    index = index + 1
  }
}

// `buffer(cap)` reserves capacity but publishes no length, and `bytes()` is `data[..len]`, so a
// window has to be **written** to exist. Appending a 64 KiB zero block is one `memcpy` per round
// and stays inside the reservation, so the base pointer never moves (R5B's `prime_window`).
pub fn prime_window(borrow mut window: buffer, bytes: i64) {
  mut chunk: buffer := buffer(PRIME_CHUNK_BYTES)
  fill_zero(chunk, PRIME_CHUNK_BYTES)
  view := chunk.bytes()
  mut remaining := bytes
  loop {
    if remaining <= 0 { break }
    take := if remaining > PRIME_CHUNK_BYTES { PRIME_CHUNK_BYTES } else { remaining }
    window.append(view[0..take])
    remaining = remaining - take
  }
}

pub fn base_mod(borrow b: buffer, modulus: i64) -> i64 {
  view := b.bytes()
  return ggml_ffi.align_mod(view, modulus)
}

pub fn empty_array() -> array<i64> {
  mut b: array_builder<i64> := array_builder()
  return b.build()
}

pub fn zero_column(n: i64) -> array<i64> {
  mut b: array_builder<i64> := array_builder()
  mut at := 0
  loop {
    if at >= n { break }
    b.push(0)
    at = at + 1
  }
  return b.build()
}

// ---------------------------------------------------------------------------------------------
// The columns (section 3.8)
//
// Each record is assigned exactly once, as a whole, by the stage that produces it: at this pin an
// owned `array<i64>` field cannot be replaced in place (R5A correction C9). `schedule[]` is thirty
// columns wide, three of them nested integer matrices, so it is rendered **as it is produced** into
// one string rather than carried as thirty parallel arrays that would each have to be rebuilt.
// ---------------------------------------------------------------------------------------------

pub TokenColumns { count: i64, ids: array<i64> }

pub fn empty_tokens() -> TokenColumns = TokenColumns { count: 0, ids: empty_array() }

pub ScheduleRows { count: i64, text: string }

pub fn empty_schedule() -> ScheduleRows = ScheduleRows { count: 0, text: "".clone() }

pub GraphColumns { activation_bytes: array<i64> }

pub fn empty_graphs() -> GraphColumns = GraphColumns { activation_bytes: empty_array() }

pub CurveColumns { cumulative: array<i64> }

pub fn empty_curve() -> CurveColumns = CurveColumns { cumulative: empty_array() }

// The top ten logits, as `(index, bit pattern)` pairs. No float is rendered anywhere, for
// `r4-alignpack-layer-major.md` section 2.3's reason.
pub TopColumns { index: array<i64>, bits: array<i64> }

pub fn empty_top() -> TopColumns = TopColumns { index: empty_array(), bits: empty_array() }

