module layer_forward

import core.json
import std.crypto
import std.encoding
import std.fs
import std.time
import alignpack_read
import ggml_ffi
import layer_qwen2

// R5A-DENSE-LAYER-FORWARD (`docs/specs/r5a-dense-layer-forward.md`). The `--layer-forward` arm: the
// three-read shape of section 3.4, the node-table walk of section 3.5, both oracles of section 3.6,
// the `R5_LAYER_FORWARD` document of section 3.7, the thirty-step validation order of section 3.8,
// and the teardown of section 3.9.
//
// `src/ggml_spike.align` owns arm selection and the CLI; this module owns everything the arm does.
// The split is not in section 3.9's module table and is a correction rather than a design change
// (section 6, correction C5): one file holding both arms would be 2,700 lines and two unrelated
// validation orders, and the boundary costs one import.
//
// It holds no `unsafe` and no `extern`. Every foreign call crosses `src/ggml_ffi.align`.

MAX_PATH_BYTES := 4096
MAX_INDEX_DIGITS := 18
MAX_DETAIL_BYTES := 256
MAX_DIMENSION := 16777216

SCHEMA_VERSION := 1
DOCUMENT_KIND := "R5_LAYER_FORWARD"

// R4.5 section 3.9's compensation window, unchanged and for its reason: Align has no aligned
// allocator (`docs/align-requests.md` Request 33), this host answers the same reservation with a
// 32-aligned base on one run and a 16-aligned one on the next, and every admissible
// `tensor_alignment` divides 64.
MAX_TENSOR_ALIGNMENT := 64

WARMUP_CALLS := 1
TIMED_CALLS := 5

VERDICT_UNAVAILABLE := 0
VERDICT_EXTERNAL := 1
VERDICT_COPIED := 2

REFERENCE_ABSENT := 0
REFERENCE_IDENTICAL := 1
REFERENCE_MISMATCH := 2

ORACLE_ABSENT := 0
ORACLE_PASS := 1
ORACLE_FAIL := 2

// Section 3.6's thresholds, fixed by the section 2.3 measurement **before** any qualification
// existed. The element bound is evaluated in ten-thousandths because `%12.4f` rounds there, so a
// printed value carries an inherent +/- 5.0e-5 and a difference of one unit is the whole of the
// instrument's own precision. The measured worst case over 1,116 elements and 18 nodes was 5.0e-5,
// which is exactly that bound: every element agreed to the last digit printed.
TOLERANCE_TEN_THOUSANDTHS := 1
// `|dSum| <= max(1.0e-3, 1.0e-5 * |Sum|)`, in millionths. The sum is compared against a sequential
// f32 accumulation in element order, which section 2.3 showed makes three of five checked nodes
// bit-identical; the worst residual measured was 1.5e-6 relative.
SUM_TOLERANCE_MILLIONTHS := 1000
SUM_TOLERANCE_RELATIVE_PPM := 10

// `docs/specs/r5c-metal-prefill.md` section 6, correction C19. Both comparisons below scale an
// f32 activation into a fixed-point integer with `((v as f64) * S).round() as i64`, and `as i64`
// **saturates**: an infinity becomes `i64`'s minimum or maximum and a NaN becomes `0`. Against a
// transcript value near zero the first wraps `0 - difference` back to `i64`'s minimum — a negative
// magnitude that no `>` test can see — and the second compares *equal*. Either one is a silent
// `PASS` over an element that is not a number. `ORACLE_SCALE_LIMIT_TEN_THOUSANDTHS` is the largest
// magnitude the element comparison represents and `SUM_SCALE_LIMIT_MILLIONTHS` the largest the sum
// comparison does; anything at or beyond either — including every non-finite value — is a mismatch
// by construction rather than an arithmetic accident. The limits are 10^11 units and 10^12 units
// respectively, eleven and twelve orders above anything this oracle has measured, and low enough
// that the difference of two of them cannot overflow.
ORACLE_SCALE_LIMIT_TEN_THOUSANDTHS := 1000000000000000
SUM_SCALE_LIMIT_MILLIONTHS := 1000000000000000000
UNREPRESENTABLE := 9223372036854775807

// The transcript's own print structure. `llama-eval-callback` prints at most three leading and
// three trailing positions on every axis, with `...` between them, so a sampled ordinal maps back
// to a real index through `axis_index` and never through its own position.
TRUNCATION_PRINTED := 6
TRUNCATION_HALF := 3

CB_PREFIX := "common_debug_cb_eval: "
// R6 section 3.3. The node every graph this instrument prints begins with, and the only
// boundary a multi-graph transcript offers without a marker the instrument does not write.
GRAPH_BOUNDARY_NODE := "embd"
CB_PREFIX_BYTES := 22
HEADER_NAME_SEP := " = ("
HEADER_TAIL := "}) = {"
ELEMENT_SEP := ", "
SUM_PREFIX := "sum = "

MAX_TRANSCRIPT_LINE_BYTES := 65536
TRANSCRIPT_WINDOW_BYTES := 262144

SUMMARY_HEX := "0123456789abcdef"
DIGEST_HEX_BYTES := 64

TextBox { v: str }

// ---------------------------------------------------------------------------------------------
// Text, numbers, and the lexical guards
// ---------------------------------------------------------------------------------------------

fn int_text(value: i64) -> string {
  b := builder()
  b.write_int(value)
  return b.to_string()
}

fn bool_text(value: bool) -> string {
  if value { return "true".clone() }
  return "false".clone()
}

fn json_string(value: str) -> string {
  boxed := TextBox { v: value }
  encoded := json.encode(boxed)
  return encoded[5..encoded.len() - 1].clone()
}

fn bounded_detail(value: str) -> string {
  if value.len() <= MAX_DETAIL_BYTES { return value.clone() }
  return value[0..MAX_DETAIL_BYTES].clone()
}

fn labelled(label: str, value: i64) -> string {
  b := builder()
  b.write(label)
  b.write("[")
  b.write_int(value)
  b.write("]")
  return b.to_string()
}

fn named(label: str, value: str) -> string {
  b := builder()
  b.write(label)
  b.write("[")
  b.write(value)
  b.write("]")
  return b.to_string()
}

// `node[<id>]<got>/<expected>`: a compared node whose printed elements are not exactly what its own
// declared shape yields. The refusal is on **inequality in either direction** — a count above the
// expectation is a transcript that printed a record twice or a matcher that bound two records to
// one node, which is no more comparable than a count below it. The counts are in the detail because
// "the oracle compared nothing", "the oracle compared half", and "the oracle compared something
// twice" are different bugs and the document must say which (section 6, correction C19).
fn miscount(node: str, got: i64, expected: i64) -> string {
  b := builder()
  b.write("node[")
  b.write(node)
  b.write("]")
  b.write_int(got)
  b.write("/")
  b.write_int(expected)
  return b.to_string()
}

fn at_index(label: str, node: str, index: i64) -> string {
  b := builder()
  b.write(label)
  b.write("[")
  b.write(node)
  b.write("]@")
  b.write_int(index)
  return b.to_string()
}

// The summary block is read positionally and a path or a node name is arbitrary bytes. Every
// control byte is escaped before it is printed; the JSON document is unaffected because its encoder
// already escapes the same bytes.
fn sanitize_summary_line(value: str) -> string {
  b := builder()
  view := value.bytes()
  mut start := 0
  mut index := 0
  loop {
    if index >= view.len() { break }
    byte := view.u8(index) as i64
    if byte < 32 || byte == 127 {
      if index > start { b.write(value[start..index]) }
      high := byte / 16
      low := byte % 16
      b.write("\\x")
      b.write(SUMMARY_HEX[high..high + 1])
      b.write(SUMMARY_HEX[low..low + 1])
      start = index + 1
    }
    index = index + 1
  }
  if start < view.len() { b.write(value[start..view.len()]) }
  return b.to_string()
}

pub fn valid_path(path: str) -> bool {
  if path.len() == 0 || path.len() > MAX_PATH_BYTES { return false }
  return !path.contains("\0")
}

// A non-negative decimal integer, no sign, no leading `+`, no whitespace, no leading zero beyond a
// bare `0`. `-1` means "not an index".
fn parse_index(value: str) -> i64 {
  if value.len() == 0 || value.len() > MAX_INDEX_DIGITS { return -1 }
  view := value.bytes()
  if view.len() > 1 && view.u8(0) as i64 == 48 { return -1 }
  mut total := 0
  mut index := 0
  loop {
    if index >= view.len() { break }
    byte := view.u8(index) as i64
    if byte < 48 || byte > 57 { return -1 }
    total = total * 10 + (byte - 48)
    index = index + 1
  }
  return total
}

fn error_name(e: Error) -> str = match e {
  NotFound => "NotFound",
  Invalid => "Invalid",
  Denied => "Denied",
  Timeout => "Timeout",
  Code(_) => "Code",
}

fn verdict_label(value: i64) -> str {
  if value == VERDICT_EXTERNAL { return "EXTERNAL" }
  if value == VERDICT_COPIED { return "COPIED" }
  return "UNAVAILABLE"
}

fn reference_label(value: i64) -> str {
  if value == REFERENCE_IDENTICAL { return "IDENTICAL" }
  if value == REFERENCE_MISMATCH { return "MISMATCH" }
  return "-"
}

fn oracle_label(value: i64) -> str {
  if value == ORACLE_PASS { return "PASS" }
  if value == ORACLE_FAIL { return "FAIL" }
  return "-"
}

fn op_label(op: i64) -> str {
  if op == layer_qwen2.OP_GET_ROWS { return "GET_ROWS" }
  if op == layer_qwen2.OP_RMS_NORM { return "RMS_NORM" }
  if op == layer_qwen2.OP_MUL { return "MUL" }
  if op == layer_qwen2.OP_ADD { return "ADD" }
  if op == layer_qwen2.OP_MUL_MAT { return "MUL_MAT" }
  if op == layer_qwen2.OP_RESHAPE_3D { return "RESHAPE" }
  if op == layer_qwen2.OP_PERMUTE { return "PERMUTE" }
  if op == layer_qwen2.OP_CONT_3D { return "CONT" }
  if op == layer_qwen2.OP_ROPE { return "ROPE" }
  if op == layer_qwen2.OP_SOFT_MAX { return "SOFT_MAX" }
  if op == layer_qwen2.OP_SWIGLU { return "SWIGLU" }
  return "UNKNOWN"
}

fn align_up(value: i64, alignment: i64) -> i64 {
  if alignment <= 1 { return value }
  remainder := value % alignment
  if remainder == 0 { return value }
  return value + (alignment - remainder)
}

// The transcript prints at most six positions per axis. Both halves of that rule live here so a
// sampled ordinal is never confused with a tensor index.
fn printed_count(extent: i64) -> i64 {
  if extent <= TRUNCATION_PRINTED { return extent }
  return TRUNCATION_PRINTED
}

fn axis_index(ordinal: i64, extent: i64) -> i64 {
  if extent <= TRUNCATION_PRINTED { return ordinal }
  if ordinal < TRUNCATION_HALF { return ordinal }
  return extent - TRUNCATION_PRINTED + ordinal
}

// ---------------------------------------------------------------------------------------------
// The tokens
// ---------------------------------------------------------------------------------------------

pub TokenList { ok: bool, detail: string, count: i64, ids: array<i64> }

// Section 3.3: one to six non-negative decimal integers, comma-separated, no spaces, no trailing
// comma, each below `n_vocab`. The cap is the oracle's and section 3.3 says why.
pub fn parse_tokens(text: str, n_vocab: i64) -> TokenList {
  mut ids: array_builder<i64> := array_builder()
  mut count := 0
  mut cursor := 0
  mut failure := "".clone()
  if text.len() == 0 {
    return TokenList { ok: false, detail: labelled("token", 0), count: 0, ids: ids.build() }
  }
  loop {
    if cursor > text.len() { break }
    rest := text[cursor..text.len()]
    cut := match rest.find(",") {
      Some(value) => value,
      None => -1,
    }
    piece := if cut < 0 { rest } else { rest[0..cut] }
    value := parse_index(piece)
    if value < 0 || value >= n_vocab {
      failure = labelled("token", count)
      break
    }
    if count >= layer_qwen2.MAX_PREFILL_TOKENS {
      failure = labelled("token", count)
      break
    }
    ids.push(value)
    count = count + 1
    if cut < 0 { break }
    cursor = cursor + cut + 1
    if cursor >= text.len() {
      failure = labelled("token", count)
      break
    }
  }
  if failure.len() > 0 {
    return TokenList { ok: false, detail: failure, count: 0, ids: ids.build() }
  }
  return TokenList { ok: true, detail: "".clone(), count: count, ids: ids.build() }
}

// ---------------------------------------------------------------------------------------------
// The transcript oracle (section 3.6)
// ---------------------------------------------------------------------------------------------
//
// A focused parser rather than `src/expert_trace.align`'s scanner. The plan proposed reusing that
// scanner; the reuse is not available (section 6, correction C6): `scan` is module-private, it
// never captures a node's **source** names — which is how the attention output projection is
// matched — and it deliberately parses no element value and no `sum`, because R2A needed neither.
// The line grammar below is the same grammar, read from `r2a-expert-trace.md` section 2.4.

TranscriptCursor {
  file_size: i64,
  window_base: i64,
  window_len: i64,
  pos: i64,
  capacity: i64,
  bytes_read: i64,
}

TranscriptLine { rel: i64, len: i64, offset: i64, done: bool }

Header {
  ok: bool,
  name_start: i64,
  name_end: i64,
  op_start: i64,
  op_end: i64,
  src_start: i64,
  src_end: i64,
  ne0: i64,
  ne1: i64,
  ne2: i64,
  ne3: i64,
}

fn bad_header() -> Header = Header {
  ok: false,
  name_start: 0,
  name_end: 0,
  op_start: 0,
  op_end: 0,
  src_start: 0,
  src_end: 0,
  ne0: 0,
  ne1: 0,
  ne2: 0,
  ne3: 0,
}

// `{a, b, c, d}` to four extents. A dimension list that is not exactly four non-negative integers
// is grammar drift, not a shape disagreement, and the caller reports it as `R5_TRANSCRIPT`.
fn parse_dims(text: str) -> array<i64> {
  mut values: array_builder<i64> := array_builder()
  mut cursor := 0
  mut count := 0
  loop {
    if count >= 4 { break }
    rest := text[cursor..text.len()]
    cut := match rest.find(ELEMENT_SEP) {
      Some(value) => value,
      None => -1,
    }
    piece := if cut < 0 { rest } else { rest[0..cut] }
    value := parse_index(piece.trim())
    if value < 1 { break }
    values.push(value)
    count = count + 1
    if cut < 0 { break }
    cursor = cursor + cut + 2
  }
  return values.build()
}

// `common_debug_cb_eval: %24s = (%s) %10s(src0{d,d,d,d}, ...}) = {d,d,d,d}`. The source-name span is
// what section 2.2 fact 3 needs: the attention output projection has no stable node name, so it is
// matched by `blk.L.attn_output.weight` and its op instead.
fn parse_header(line: str) -> Header {
  if !line.starts_with(CB_PREFIX) { return bad_header() }
  separator := match line.find(HEADER_NAME_SEP) {
    Some(value) => value,
    None => { return bad_header() },
  }
  if separator <= CB_PREFIX_BYTES { return bad_header() }
  field := line[CB_PREFIX_BYTES..separator]
  field_view := field.bytes()
  mut name_at := 0
  loop {
    if name_at >= field_view.len() { break }
    if field_view.u8(name_at) != 32 { break }
    name_at = name_at + 1
  }
  if name_at >= field_view.len() { return bad_header() }
  name_start := CB_PREFIX_BYTES + name_at
  name_end := separator

  after_name := separator + 4
  if after_name > line.len() { return bad_header() }
  type_tail := line[after_name..line.len()]
  type_len := match type_tail.find(")") {
    Some(value) => value,
    None => { return bad_header() },
  }
  type_close := after_name + type_len
  if type_close + 1 >= line.len() { return bad_header() }
  if !line[type_close + 1..line.len()].starts_with(" ") { return bad_header() }

  op_field_start := type_close + 2
  if op_field_start >= line.len() { return bad_header() }
  op_tail := line[op_field_start..line.len()]
  op_field_len := match op_tail.find("(") {
    Some(value) => value,
    None => { return bad_header() },
  }
  op_field := line[op_field_start..op_field_start + op_field_len]
  op_field_view := op_field.bytes()
  mut op_at := 0
  loop {
    if op_at >= op_field_view.len() { break }
    if op_field_view.u8(op_at) != 32 { break }
    op_at = op_at + 1
  }
  if op_at >= op_field_view.len() { return bad_header() }
  op_start := op_field_start + op_at
  op_end := op_field_start + op_field_len
  args_start := op_end + 1

  tail_at := match line.rfind(HEADER_TAIL) {
    Some(value) => value,
    None => { return bad_header() },
  }
  if tail_at < args_start { return bad_header() }
  if !line.ends_with("}") { return bad_header() }
  result_text := line[tail_at + 6..line.len() - 1]
  args := line[args_start..tail_at]
  open0 := match args.find("{") {
    Some(value) => value,
    None => { return bad_header() },
  }
  ne := parse_dims(result_text)
  if ne.len() != 4 { return bad_header() }
  return Header {
    ok: true,
    name_start: name_start,
    name_end: name_end,
    op_start: op_start,
    op_end: op_end,
    src_start: args_start,
    src_end: args_start + open0,
    ne0: ne[0],
    ne1: ne[1],
    ne2: ne[2],
    ne3: ne[3],
  }
}

// `     -0.0190` to `-190`. The transcript prints `%12.4f`, so a printed value **is** an integer
// number of ten-thousandths and turning it into one loses nothing. `MIN_I64` means "not a number
// this grammar produces", which the caller reports as `R5_TRANSCRIPT`.
NOT_A_NUMBER := -9223372036854775807

fn parse_fixed(text: str, decimals: i64) -> i64 {
  trimmed := text.trim()
  if trimmed.len() == 0 { return NOT_A_NUMBER }
  view := trimmed.bytes()
  mut at := 0
  mut negative := false
  if view.u8(0) as i64 == 45 {
    negative = true
    at = 1
  }
  if at >= view.len() { return NOT_A_NUMBER }
  mut whole := 0
  mut digits := 0
  loop {
    if at >= view.len() { break }
    byte := view.u8(at) as i64
    if byte < 48 || byte > 57 { break }
    if whole > 922337203685477 { return NOT_A_NUMBER }
    whole = whole * 10 + (byte - 48)
    digits = digits + 1
    at = at + 1
  }
  if digits == 0 { return NOT_A_NUMBER }
  if at >= view.len() || view.u8(at) as i64 != 46 { return NOT_A_NUMBER }
  at = at + 1
  mut fraction := 0
  mut taken := 0
  loop {
    if taken >= decimals { break }
    if at >= view.len() { return NOT_A_NUMBER }
    byte := view.u8(at) as i64
    if byte < 48 || byte > 57 { return NOT_A_NUMBER }
    fraction = fraction * 10 + (byte - 48)
    taken = taken + 1
    at = at + 1
  }
  if at != view.len() { return NOT_A_NUMBER }
  mut scale := 1
  mut power := 0
  loop {
    if power >= decimals { break }
    scale = scale * 10
    power = power + 1
  }
  total := whole * scale + fraction
  if negative { return 0 - total }
  return total
}

// What one scan produced: for every oracle row, whether the transcript carried it, the shape it
// declared, its `sum`, and every printed element as a `(linear index, ten-thousandths)` pair.
pub TranscriptScan {
  code: string,
  detail: string,
  line_count: i64,
  callback_line_count: i64,
  bytes_read: i64,
  matched: array<i64>,
  ne0: array<i64>,
  ne1: array<i64>,
  ne2: array<i64>,
  ne3: array<i64>,
  sum_millionths: array<i64>,
  sum_present: array<i64>,
  element_node: array<i64>,
  element_index: array<i64>,
  element_value: array<i64>,
}

fn empty_array() -> array<i64> {
  mut b: array_builder<i64> := array_builder()
  return b.build()
}

// R5B imports this module's scanner rather than copying it, and needs a value to bind before the
// scan runs. It is the same empty record `empty_scan` builds, published.
pub fn empty_transcript_scan() -> TranscriptScan = empty_scan("", "".clone())

fn empty_scan(code: str, detail: string) -> TranscriptScan {
  return TranscriptScan {
    code: code.clone(),
    detail: detail,
    line_count: 0,
    callback_line_count: 0,
    bytes_read: 0,
    matched: empty_array(),
    ne0: empty_array(),
    ne1: empty_array(),
    ne2: empty_array(),
    ne3: empty_array(),
    sum_millionths: empty_array(),
    sum_present: empty_array(),
    element_node: empty_array(),
    element_index: empty_array(),
    element_value: empty_array(),
  }
}

fn refill(
  borrow handle: file,
  borrow mut window: buffer,
  borrow mut c: TranscriptCursor,
) -> Result<(), Error> {
  window = buffer(c.capacity)
  count := handle.pread(window, c.pos)?
  c.window_base = c.pos
  c.window_len = count
  c.bytes_read = c.bytes_read + count
  if count == 0 { return Err(Error.Invalid) }
  mut have := count
  loop {
    if have >= c.capacity { break }
    if c.pos + have >= c.file_size { break }
    mut tail := buffer(c.capacity - have)
    extra := handle.pread(tail, c.pos + have)?
    if extra == 0 { break }
    c.bytes_read = c.bytes_read + extra
    window.append(tail.bytes())
    have = have + extra
    c.window_len = have
  }
  return Ok(())
}

fn next_line(
  borrow handle: file,
  borrow mut window: buffer,
  borrow mut c: TranscriptCursor,
) -> Result<TranscriptLine, Error> {
  loop {
    if c.pos >= c.file_size {
      return Ok(TranscriptLine { rel: 0, len: 0, offset: c.pos, done: true })
    }
    if c.window_base < 0 || c.pos < c.window_base || c.pos >= c.window_base + c.window_len {
      refill(handle, window, c)?
    }
    view := window.bytes()
    rel := c.pos - c.window_base
    mut at := rel
    mut found := -1
    loop {
      if at >= c.window_len || at >= view.len() { break }
      if view.u8(at) as i64 == 10 {
        found = at
        break
      }
      at = at + 1
    }
    if found >= 0 {
      length := found - rel
      if length > MAX_TRANSCRIPT_LINE_BYTES { return Err(Error.Invalid) }
      start := c.pos
      c.pos = c.window_base + found + 1
      return Ok(TranscriptLine { rel: rel, len: length, offset: start, done: false })
    }
    if c.window_base + c.window_len >= c.file_size {
      length := c.window_len - rel
      if length > MAX_TRANSCRIPT_LINE_BYTES { return Err(Error.Invalid) }
      start := c.pos
      c.pos = c.file_size
      return Ok(TranscriptLine { rel: rel, len: length, offset: start, done: false })
    }
    if rel == 0 { return Err(Error.Invalid) }
    c.window_base = -1
    c.window_len = 0
  }
}

// The leading-space count of a value-block line, which is how its nesting level is read. The
// instrument indents four spaces per axis, so `4` opens the outermost group, `8` a plane, and `12`
// a row, and the same rule identifies the three truncation markers.
fn indent_of(text: str) -> i64 {
  view := text.bytes()
  mut at := 0
  loop {
    if at >= view.len() { break }
    if view.u8(at) != 32 { break }
    at = at + 1
  }
  return at
}

// One pass. Every `common_debug_cb_eval:` header is parsed; a header that matches an oracle row not
// yet matched starts a captured block, and every other block is skipped without being parsed, so a
// 2 MiB transcript costs one scan and holds at most 4,320 sampled elements.
pub fn scan_transcript(path: str, borrow oracle: layer_qwen2.OracleTable) -> TranscriptScan {
  return scan_transcript_after(path, oracle, 0)
}

// R6-DECODE-KV-STEP1 (`docs/specs/r6-decode-kv-step1.md` section 3.3). The same scan over a
// transcript that holds **more than one graph**.
//
// `llama-eval-callback -n 1` emits two: a prefill graph and then a decode graph, and every node
// name repeats across them. The matcher above takes the **first** occurrence of each name, which is
// the only correct rule for a one-graph transcript and exactly the wrong one for a decode oracle: it
// would compare a decode graph against a prefill graph's numbers and could still report `PASS` on
// the seven nodes that agree.
//
// A graph boundary is the `embd` header. Every graph this instrument prints begins with
// `embd = (f32) GET_ROWS(token_embd.weight{..}, inp_tokens{..})`, in the prefill at `{n_embd, T}`
// and in the decode step at `{n_embd, 1}`, so counting that one header counts graphs without
// depending on a marker the instrument does not print. Rows are matched only once `skip_graphs`
// boundaries have gone by; everything before them is parsed for grammar and counted and never
// captured, so `transcript_lines` and `transcript_callback_lines` still describe the whole file.
//
// `scan_transcript` is `skip_graphs = 0`, so R5A's and R5B's captured element sets are unchanged by
// construction.
pub fn scan_transcript_after(
  path: str, borrow oracle: layer_qwen2.OracleTable, skip_graphs: i64) -> TranscriptScan {
  handle := match fs.open_rw(path) {
    Ok(value) => value,
    Err(failure) => { return empty_scan("R5_TRANSCRIPT", error_name(failure).clone()) },
  }
  file_size := match handle.len() {
    Ok(value) => value,
    Err(failure) => { return empty_scan("R5_TRANSCRIPT", error_name(failure).clone()) },
  }
  mut window := buffer(TRANSCRIPT_WINDOW_BYTES)
  mut c := TranscriptCursor {
    file_size: file_size,
    window_base: -1,
    window_len: 0,
    pos: 0,
    capacity: TRANSCRIPT_WINDOW_BYTES,
    bytes_read: 0,
  }
  mut matched: array_builder<i64> := array_builder()
  mut d0: array_builder<i64> := array_builder()
  mut d1: array_builder<i64> := array_builder()
  mut d2: array_builder<i64> := array_builder()
  mut d3: array_builder<i64> := array_builder()
  mut sums: array_builder<i64> := array_builder()
  mut sum_seen: array_builder<i64> := array_builder()
  mut element_node: array_builder<i64> := array_builder()
  mut element_index: array_builder<i64> := array_builder()
  mut element_value: array_builder<i64> := array_builder()
  mut row := 0
  loop {
    if row >= oracle.count { break }
    matched.push(0)
    d0.push(0)
    d1.push(0)
    d2.push(0)
    d3.push(0)
    sums.push(0)
    sum_seen.push(0)
    row = row + 1
  }
  mut found := matched.build()
  mut ne0 := d0.build()
  mut ne1 := d1.build()
  mut ne2 := d2.build()
  mut ne3 := d3.build()
  mut sum_value := sums.build()
  mut sum_present := sum_seen.build()

  mut code := "".clone()
  mut detail := "".clone()
  mut line_count := 0
  mut callback_count := 0
  mut capture := -1
  mut in_block := false
  // R6 section 3.3: how many `embd` headers have been seen, so the matcher below can be told which
  // graph of a multi-graph transcript it is standing in.
  mut graph_index := 0
  mut o3 := 0
  mut o2 := 0
  mut o1 := 0
  mut block_ne0 := 0
  mut block_ne1 := 0
  mut block_ne2 := 0
  mut block_ne3 := 0

  loop {
    line := match next_line(handle, window, c) {
      Ok(value) => value,
      Err(failure) => {
        code = "R5_TRANSCRIPT".clone()
        detail = error_name(failure).clone()
        break
      },
    }
    if line.done { break }
    line_count = line_count + 1
    view := window.bytes()
    if line.rel + line.len > view.len() {
      code = "R5_TRANSCRIPT".clone()
      detail = int_text(line.offset)
      break
    }
    region := view[line.rel..line.rel + line.len]
    text := match region.as_str() {
      Ok(value) => value,
      Err(_) => "",
    }
    mut handled := false
    if text.len() != line.len {
      // A line the instrument did not write, or one that is not UTF-8. Outside a captured block it
      // is skipped, exactly as R2A's scanner skips the loader's own log lines; inside one it is a
      // value block this parser cannot read, which is grammar drift and must not be silent.
      if in_block {
        code = "R5_TRANSCRIPT".clone()
        detail = int_text(line.offset)
        break
      }
      handled = true
    }
    if !handled && text.starts_with(CB_PREFIX) {
      handled = true
      callback_count = callback_count + 1
      header := parse_header(text)
      if !header.ok {
        code = "R5_TRANSCRIPT".clone()
        detail = bounded_detail(text)
        break
      }
      in_block = false
      capture = -1
      name := text[header.name_start..header.name_end]
      operation := text[header.op_start..header.op_end]
      source := text[header.src_start..header.src_end]
      if name == GRAPH_BOUNDARY_NODE { graph_index = graph_index + 1 }
      mut candidate := if graph_index > skip_graphs { 0 } else { oracle.count }
      loop {
        if candidate >= oracle.count { break }
        mut hit := false
        if found[candidate] == 0 && operation == layer_qwen2.oracle_op(oracle, candidate) {
          wanted := layer_qwen2.oracle_name(oracle, candidate)
          if oracle.by_weight[candidate] == 1 {
            hit = source == wanted
          } else {
            hit = name == wanted
          }
        }
        if hit {
          capture = candidate
          found[candidate] = 1
          ne0[candidate] = header.ne0
          ne1[candidate] = header.ne1
          ne2[candidate] = header.ne2
          ne3[candidate] = header.ne3
          break
        }
        candidate = candidate + 1
      }
      if capture >= 0 {
        in_block = true
        block_ne0 = header.ne0
        block_ne1 = header.ne1
        block_ne2 = header.ne2
        block_ne3 = header.ne3
        o3 = 0
        o2 = 0
        o1 = 0
      }
    }
    if !handled && !in_block { handled = true }
    if !handled {
      indent := indent_of(text)
      body := text[indent..text.len()]
      if indent == 4 && body.starts_with(SUM_PREFIX) {
        handled = true
        value := parse_fixed(body[SUM_PREFIX.len()..body.len()], 6)
        if value == NOT_A_NUMBER {
          code = "R5_TRANSCRIPT".clone()
          detail = bounded_detail(text)
          break
        }
        sum_value[capture] = value
        sum_present[capture] = 1
        in_block = false
        capture = -1
      }
      // A truncation marker advances nothing: `axis_index` already maps the trailing ordinals onto
      // the trailing indices, so the marker only has to be recognised and skipped.
      if !handled && body.starts_with("...") { handled = true }
      if !handled && body.starts_with("]") {
        handled = true
        if indent == 8 {
          o2 = o2 + 1
          o1 = 0
        }
        if indent == 4 { o3 = o3 + 1 }
      }
      if !handled && !body.starts_with("[") {
        code = "R5_TRANSCRIPT".clone()
        detail = bounded_detail(text)
        break
      }
      if !handled && indent != 12 { handled = true }
      if !handled {
        if !body.ends_with("],") {
          code = "R5_TRANSCRIPT".clone()
          detail = bounded_detail(text)
          break
        }
        inner := body[1..body.len() - 2]
        mut o0 := 0
        mut cursor := 0
        mut failed := false
        loop {
          if cursor > inner.len() { break }
          rest := inner[cursor..inner.len()]
          cut := match rest.find(ELEMENT_SEP) {
            Some(value) => value,
            None => -1,
          }
          piece := if cut < 0 { rest } else { rest[0..cut] }
          trimmed := piece.trim()
          if trimmed != "..." && trimmed.len() > 0 {
            value := parse_fixed(trimmed, 4)
            if value == NOT_A_NUMBER {
              failed = true
              break
            }
            i0 := axis_index(o0, block_ne0)
            i1 := axis_index(o1, block_ne1)
            i2 := axis_index(o2, block_ne2)
            i3 := axis_index(o3, block_ne3)
            element_node.push(capture)
            element_index.push(i0 + block_ne0 * (i1 + block_ne1 * (i2 + block_ne2 * i3)))
            element_value.push(value)
            o0 = o0 + 1
          }
          if cut < 0 { break }
          cursor = cursor + cut + 2
        }
        if failed {
          code = "R5_TRANSCRIPT".clone()
          detail = bounded_detail(text)
          break
        }
        o1 = o1 + 1
      }
    }
  }
  if code.len() == 0 && callback_count == 0 {
    code = "R5_TRANSCRIPT".clone()
    detail = "no_callback_lines".clone()
  }
  return TranscriptScan {
    code: code,
    detail: detail,
    line_count: line_count,
    callback_line_count: callback_count,
    bytes_read: c.bytes_read,
    matched: found,
    ne0: ne0,
    ne1: ne1,
    ne2: ne2,
    ne3: ne3,
    sum_millionths: sum_value,
    sum_present: sum_present,
    element_node: element_node.build(),
    element_index: element_index.build(),
    element_value: element_value.build(),
  }
}

// ---------------------------------------------------------------------------------------------
// The outcome and its columns (section 3.7)
//
// The document's scalars live in one `Outcome`; its **columns** live in six small records, each
// assigned exactly once, as a whole, by the stage that produces it. That shape is forced rather
// than chosen: at this pin an owned `array<i64>` field cannot be replaced in place — the compiler
// says so and tells the caller to "replace the whole struct" — so a single wide record that every
// stage appends a column to does not compile (section 6, correction C9).
// ---------------------------------------------------------------------------------------------

// The prefill's token ids, produced by step 4 and consumed by the read shape, the reference arm,
// and the document.
pub TokenColumns { count: i64, ids: array<i64> }

pub fn empty_tokens() -> TokenColumns = TokenColumns { count: 0, ids: empty_array() }

// The thirteen members in slot order, as step 13 selected them.
pub MemberColumns {
  count: i64,
  names: string,
  name_start: array<i64>,
  name_end: array<i64>,
  role: array<i64>,
  kind: array<i64>,
  ggml_type: array<i64>,
  ne0: array<i64>,
  ne1: array<i64>,
  nbytes: array<i64>,
  pack_offset: array<i64>,
}

pub fn empty_members() -> MemberColumns = MemberColumns {
  count: 0,
  names: "".clone(),
  name_start: empty_array(),
  name_end: empty_array(),
  role: empty_array(),
  kind: empty_array(),
  ggml_type: empty_array(),
  ne0: empty_array(),
  ne1: empty_array(),
  nbytes: empty_array(),
  pack_offset: empty_array(),
}

pub fn member_label_at(borrow m: MemberColumns, index: i64) -> str {
  view: str := m.names
  if index < 0 || index >= m.count { return "" }
  return view[m.name_start[index]..m.name_end[index]]
}

// Where every member's bytes are: in the source GGUF, inside its own block, and inside the
// Align-owned window. `weight_bytes` excludes the alignment pad, so it is a property of the model
// and the token count rather than of the allocator.
pub Layout {
  source_offsets: array<i64>,
  block_offsets: array<i64>,
  window_offsets: array<i64>,
  row_bytes: i64,
  weight_bytes: i64,
}

pub fn empty_layout() -> Layout = Layout {
  source_offsets: empty_array(),
  block_offsets: empty_array(),
  window_offsets: empty_array(),
  row_bytes: 0,
  weight_bytes: 0,
}

// What step 16 actually read, per member: `read_bytes` is this member's bytes and `pread_count` is
// the number of `pread` calls whose range covered them — `T` for the row-gathered embedding and one
// for every member of a block that was read whole.
pub ReadColumns { read_bytes: array<i64>, pread_count: array<i64> }

pub fn empty_reads() -> ReadColumns = ReadColumns {
  read_bytes: empty_array(),
  pread_count: empty_array(),
}

pub AbiColumns { blck: array<i64>, type_size: array<i64>, window_alignment: array<i64> }

pub fn empty_abi() -> AbiColumns = AbiColumns {
  blck: empty_array(),
  type_size: empty_array(),
  window_alignment: empty_array(),
}

pub PlacementColumns { data_offset: array<i64>, identity: array<i64> }

pub fn empty_placement() -> PlacementColumns = PlacementColumns {
  data_offset: empty_array(),
  identity: empty_array(),
}

// The twenty read-back nodes. `digests` is 64 hex characters per row, in row order.
pub NodeColumns {
  count: i64,
  digests: string,
  op: array<i64>,
  ne0: array<i64>,
  ne1: array<i64>,
  ne2: array<i64>,
  ne3: array<i64>,
  elements: array<i64>,
  bit_sum: array<i64>,
  sum_millionths: array<i64>,
  nonfinite: array<i64>,
}

pub fn empty_nodes() -> NodeColumns = NodeColumns {
  count: 0,
  digests: "".clone(),
  op: empty_array(),
  ne0: empty_array(),
  ne1: empty_array(),
  ne2: empty_array(),
  ne3: empty_array(),
  elements: empty_array(),
  bit_sum: empty_array(),
  sum_millionths: empty_array(),
  nonfinite: empty_array(),
}

pub OracleStates { state: array<i64> }

pub fn empty_states() -> OracleStates = OracleStates { state: empty_array() }

// Everything the run learned that is a scalar or a name, whether or not it finished. An error
// document reports what was observed rather than only what failed.
pub Outcome {
  code: string,
  detail: string,
  verdict: i64,
  reference_present: bool,
  transcript_present: bool,

  reader_pread_count: i64,
  reader_bytes_read: i64,
  format_version: i64,
  block_align: i64,
  member_align: i64,
  block_count: i64,
  member_count: i64,
  total_bytes: i64,
  payload_offset: i64,

  arch: string,
  n_layer: i64,
  n_embd: i64,
  n_head: i64,
  n_head_kv: i64,
  head_dim: i64,
  n_ff: i64,
  n_vocab: i64,
  context_length: i64,
  rms_eps_bits: i64,
  rope_type: i64,
  rope_dim_count: i64,
  rope_freq_base_bits: i64,
  attn_scale_bits: i64,

  layer: i64,
  embedding_block_index: i64,
  attention_block_index: i64,
  mlp_block_index: i64,
  token_count: i64,

  node_count: i64,
  slot_capacity: i64,
  slot_high_water: i64,
  weight_bytes: i64,
  activation_bytes: i64,
  backend_name: string,
  compute_status: i64,

  sha256: string,
  bit_sum: i64,
  element_count: i64,
  nonfinite_count: i64,

  reference_verdict: i64,
  reference_compared: i64,
  reference_identical: i64,
  reference_first_node: string,
  reference_first_index: i64,
  reference_first_primary_bits: i64,
  reference_first_reference_bits: i64,

  oracle_verdict: i64,
  oracle_expected: i64,
  oracle_matched: i64,
  oracle_elements: i64,
  oracle_max_abs: i64,
  oracle_max_sum: i64,
  oracle_worst_node: string,
  oracle_worst_element: i64,
  oracle_lines: i64,
  oracle_callback_lines: i64,

  pread_ns: i64,
  build_ns: i64,
  reserve_ns: i64,
  compute_ns: i64,
  reference_compute_ns: i64,
  oracle_ns: i64,
  elapsed_ns: i64,

  ggml_buffers_created: i64,
  ggml_buffers_freed: i64,
  contexts_created: i64,
  contexts_freed: i64,
  backends_created: i64,
  backends_freed: i64,
  graphs_created: i64,
  gallocrs_created: i64,
  gallocrs_freed: i64,
  released_before_owner_scope_end: bool,

  tensor_alignment: i64,
  table_drift: i64,
  slot_magic_ok: bool,
  fp_contract_off: bool,
  graph_context_bytes: i64,
}

pub fn empty_outcome() -> Outcome = Outcome {
  code: "".clone(),
  detail: "".clone(),
  verdict: VERDICT_UNAVAILABLE,
  reference_present: false,
  transcript_present: false,
  reader_pread_count: 0,
  reader_bytes_read: 0,
  format_version: 0,
  block_align: 0,
  member_align: 0,
  block_count: 0,
  member_count: 0,
  total_bytes: 0,
  payload_offset: 0,
  arch: "".clone(),
  n_layer: 0,
  n_embd: 0,
  n_head: 0,
  n_head_kv: 0,
  head_dim: 0,
  n_ff: 0,
  n_vocab: 0,
  context_length: 0,
  rms_eps_bits: 0,
  rope_type: -1,
  rope_dim_count: 0,
  rope_freq_base_bits: 0,
  attn_scale_bits: 0,
  layer: -1,
  embedding_block_index: -1,
  attention_block_index: -1,
  mlp_block_index: -1,
  token_count: 0,
  node_count: 0,
  slot_capacity: 0,
  slot_high_water: 0,
  weight_bytes: 0,
  activation_bytes: 0,
  backend_name: "".clone(),
  compute_status: 0,
  sha256: "".clone(),
  bit_sum: 0,
  element_count: 0,
  nonfinite_count: 0,
  reference_verdict: REFERENCE_ABSENT,
  reference_compared: 0,
  reference_identical: 0,
  reference_first_node: "".clone(),
  reference_first_index: -1,
  reference_first_primary_bits: 0,
  reference_first_reference_bits: 0,
  oracle_verdict: ORACLE_ABSENT,
  oracle_expected: 0,
  oracle_matched: 0,
  oracle_elements: 0,
  oracle_max_abs: 0,
  oracle_max_sum: 0,
  oracle_worst_node: "".clone(),
  oracle_worst_element: -1,
  oracle_lines: 0,
  oracle_callback_lines: 0,
  pread_ns: 0,
  build_ns: 0,
  reserve_ns: 0,
  compute_ns: 0,
  reference_compute_ns: 0,
  oracle_ns: 0,
  elapsed_ns: 0,
  ggml_buffers_created: 0,
  ggml_buffers_freed: 0,
  contexts_created: 0,
  contexts_freed: 0,
  backends_created: 0,
  backends_freed: 0,
  graphs_created: 0,
  gallocrs_created: 0,
  gallocrs_freed: 0,
  released_before_owner_scope_end: false,
  tensor_alignment: 0,
  table_drift: -1,
  slot_magic_ok: false,
  fp_contract_off: false,
  graph_context_bytes: 0,
}

fn fail(borrow mut o: Outcome, code: str, detail: str) {
  if o.code.len() == 0 {
    o.code = code.clone()
    o.detail = bounded_detail(detail)
  }
}

fn fault_into(borrow mut o: Outcome, borrow f: ggml_ffi.Fault) {
  code_view: str := f.code
  detail_view: str := f.detail
  fail(o, code_view, detail_view)
}

fn pack_fault_into(borrow mut o: Outcome, borrow f: alignpack_read.Fault) {
  code_view: str := f.code
  detail_view: str := f.detail
  fail(o, code_view, detail_view)
}

fn ffi_fault(code: str, detail: string) -> ggml_ffi.Fault =
ggml_ffi.Fault { code: code.clone(), detail: detail }

// One `match` in one place. At this pin a `match` on a `Result` with block arms is markedly more
// expensive to check than a call — inside a loop the difference is minutes against seconds — so
// every one of the arm's fallible calls either propagates with `?` or routes through this two-line
// function (section 6, correction C8).
fn take(borrow mut o: Outcome, outcome: Result<(), ggml_ffi.Fault>) {
  match outcome {
    Ok(_) => {},
    Err(f) => { fault_into(o, f) },
  }
}

fn take_pack(borrow mut o: Outcome, outcome: Result<(), alignpack_read.Fault>) {
  match outcome {
    Ok(_) => {},
    Err(f) => { pack_fault_into(o, f) },
  }
}

fn fill_zero(borrow mut b: buffer, n: i64) {
  mut index := 0
  loop {
    if index >= n { break }
    b.put_u8(0 as u8)
    index = index + 1
  }
}

fn column_at(borrow column: array<i64>, index: i64) -> i64 {
  if index < 0 || index >= column.len() { return 0 }
  return column[index]
}

// ---------------------------------------------------------------------------------------------
// Container navigation (section 3.4)
// ---------------------------------------------------------------------------------------------

// Blocks are located by `(kind, layer)` and never by a hard-coded index. The embedding block is the
// `WeightBlock` whose layer is `-1`; the layer's own two blocks carry `LAYER`.
fn find_block(borrow x: alignpack_read.PackIndex, kind: i64, layer: i64) -> i64 {
  mut at := 0
  loop {
    if at >= x.block_count { break }
    if x.block_kind[at] == kind && x.block_layer[at] == layer { return at }
    at = at + 1
  }
  return -1
}

// Members are located by `role_id` against `r4-alignpack-layer-major.md` section 2.4.4's frozen
// role list, never by name string and never by position: an id taken from a frontend would mean two
// different things in two packs, and a position would mean nothing at all.
fn find_member(
  borrow f: file,
  borrow x: alignpack_read.PackIndex,
  borrow b: alignpack_read.PackBlock,
  role: i64,
  borrow mut c: alignpack_read.Counters,
) -> Result<alignpack_read.PackMember, alignpack_read.Fault> {
  mut at := 0
  loop {
    if at >= b.member_count { break }
    candidate := alignpack_read.member_at(f, x, b, at, c)?
    if candidate.role_id == role { return Ok(candidate) }
    at = at + 1
  }
  return Err(alignpack_read.Fault {
      code: "R5_MEMBER_MISSING".clone(),
      detail: labelled("role", role),
    })
}

// The allocator's base for a window still being filled, modulo `modulus`. A Borrow crossing an FFI
// wrapper must be a stable named local rather than a temporary, so the view is taken, measured, and
// dropped here.
fn base_mod(borrow b: buffer, modulus: i64) -> i64 {
  view := b.bytes()
  return ggml_ffi.align_mod(view, modulus)
}

// ---------------------------------------------------------------------------------------------
// The node-table walk (section 3.5)
// ---------------------------------------------------------------------------------------------

// One loop, one shim call per row, and no control flow that depends on which node this is. Adding
// a node to the layer is adding a row to `src/layer_qwen2.align`'s table.
fn build_nodes(
  ctx: raw,
  borrow slots: slice<u8>,
  borrow nodes: layer_qwen2.NodeTable,
) -> Result<(), ggml_ffi.Fault> {
  mut row := 0
  loop {
    if row >= nodes.count { break }
    op := nodes.op[row]
    out := nodes.out[row]
    a := nodes.a[row]
    b := nodes.b[row]
    tag := labelled("node", row)
    label: str := tag
    if op == layer_qwen2.OP_GET_ROWS {
      ggml_ffi.op_get_rows(ctx, slots, out, a, b, label)?
    }
    if op == layer_qwen2.OP_RMS_NORM {
      ggml_ffi.op_rms_norm(ctx, slots, out, a, nodes.p0[row], label)?
    }
    if op == layer_qwen2.OP_MUL {
      ggml_ffi.op_mul(ctx, slots, out, a, b, label)?
    }
    if op == layer_qwen2.OP_ADD {
      ggml_ffi.op_add(ctx, slots, out, a, b, label)?
    }
    if op == layer_qwen2.OP_MUL_MAT {
      ggml_ffi.op_mul_mat(ctx, slots, out, a, b, label)?
    }
    if op == layer_qwen2.OP_RESHAPE_3D {
      ggml_ffi.op_reshape_3d(ctx, slots, out, a, nodes.p0[row], nodes.p1[row], nodes.p2[row], label)?
    }
    if op == layer_qwen2.OP_PERMUTE {
      ggml_ffi.op_permute(
        ctx, slots, out, a, nodes.p0[row], nodes.p1[row], nodes.p2[row], nodes.p3[row], label)?
    }
    if op == layer_qwen2.OP_CONT_3D {
      ggml_ffi.op_cont_3d(ctx, slots, out, a, nodes.p0[row], nodes.p1[row], nodes.p2[row], label)?
    }
    if op == layer_qwen2.OP_ROPE {
      ggml_ffi.op_rope_neox(
        ctx, slots, out, a, b, nodes.p0[row], nodes.p1[row], nodes.p2[row], nodes.p3[row], label)?
    }
    if op == layer_qwen2.OP_SOFT_MAX {
      ggml_ffi.op_soft_max_ext(ctx, slots, out, a, b, nodes.p0[row], nodes.p1[row], label)?
    }
    if op == layer_qwen2.OP_SWIGLU {
      ggml_ffi.op_swiglu_split(ctx, slots, out, a, b, label)?
    }
    row = row + 1
  }
  return Ok(())
}

// `ggml_set_output` on every oracle node, and section 5.6 records why it is not optional: without
// it `ggml_gallocr` reuses an intermediate's memory and the bytes read back are not the node
// computed. The probe hit exactly this before the call was added.
fn mark_outputs(
  borrow slots: slice<u8>,
  borrow oracle: layer_qwen2.OracleTable,
) -> Result<(), ggml_ffi.Fault> {
  mut row := 0
  loop {
    if row >= oracle.count { break }
    id := layer_qwen2.oracle_id(oracle, row)
    ggml_ffi.slot_mark_output(slots, layer_qwen2.SLOT_NODE_BASE + oracle.node[row], id)?
    row = row + 1
  }
  return Ok(())
}

// Steps 25 and 26. The pack's bytes against the original GGUF at `member.source_offset`, member by
// member and — for the row-gathered embedding — row by row, before a second graph exists. A
// difference is `R5_SOURCE_DIVERGED` and stops the arm, because a numeric comparison between two
// different tensors would report the wrong cause.
//
// The reference file is **not** the container and nothing has proved this range is inside it:
// `source_offset` and `nbytes` are the pack's claims about a file the caller merely named. An
// empty, short, or simply wrong reference is therefore named as what it is rather than reaching
// `read_exact`, whose zero-length answer blames this side's allocator.
fn compare_source(
  reference_path: str,
  borrow members: MemberColumns,
  borrow layout: Layout,
  borrow tokens: TokenColumns,
  borrow window: slice<u8>,
  borrow mut c: alignpack_read.Counters,
) -> Result<(), alignpack_read.Fault> {
  handle := match fs.open_rw(reference_path) {
    Ok(value) => value,
    Err(failure) => {
      return Err(alignpack_read.Fault {
          code: "R5_SOURCE_UNREADABLE".clone(),
          detail: error_name(failure).clone(),
        })
    },
  }
  size := match handle.len() {
    Ok(value) => value,
    Err(failure) => {
      return Err(alignpack_read.Fault {
          code: "R5_SOURCE_UNREADABLE".clone(),
          detail: error_name(failure).clone(),
        })
    },
  }
  mut compare: buffer := buffer(0)
  mut member_at := 0
  loop {
    if member_at >= members.count { break }
    label := member_label_at(members, member_at)
    pieces := if member_at == 0 { tokens.count } else { 1 }
    span := if member_at == 0 { layout.row_bytes } else { members.nbytes[member_at] }
    mut piece := 0
    loop {
      if piece >= pieces { break }
      at := if member_at == 0 {
        layout.source_offsets[0] + tokens.ids[piece] * layout.row_bytes
      } else {
        layout.source_offsets[member_at]
      }
      window_at := layout.window_offsets[member_at] + piece * span
      if at < 0 || span < 0 || at > size || span > size - at {
        return Err(alignpack_read.Fault {
            code: "R5_SOURCE_UNREADABLE".clone(),
            detail: named("role", label),
          })
      }
      alignpack_read.read_exact(handle, compare, c, "R5_SOURCE_UNREADABLE", at, span)?
      packed := window[window_at..window_at + span]
      source := compare.bytes()
      if !crypto.constant_time_equal(packed, source) {
        return Err(alignpack_read.Fault {
            code: "R5_SOURCE_DIVERGED".clone(),
            detail: named("role", label),
          })
      }
      piece = piece + 1
    }
    member_at = member_at + 1
  }
  return Ok(())
}

// ---------------------------------------------------------------------------------------------
// The arm (section 3.8)
//
// Thirty steps, first applicable row wins, in fourteen functions rather than one. The split is not
// taste: at this pin the checker's per-function cost is superlinear in body length, so a single
// `execute` holding the whole validation order would make `make check` unusable. Every stage is
// under two hundred lines, and the handles stay bare locals in `execute` because `raw` cannot be
// aggregated (section 2.6): a stage receives the handles it needs as parameters and never owns one.
// ---------------------------------------------------------------------------------------------

fn finish(borrow mut o: Outcome, started: i64) {
  o.elapsed_ns = time.instant() - started
}

// Steps 3 to 10: the layer index, the token list, the geometry document, and the two range checks
// that need `n_layer` and `n_vocab`. A non-empty `o.code` is the caller's signal to stop.
fn stage_geometry(
  layer_text: str,
  tokens_text: str,
  geometry_path: str,
  borrow mut tokens: TokenColumns,
  borrow mut o: Outcome,
) -> layer_qwen2.Geometry {
  mut g := layer_qwen2.empty_geometry()
  layer := parse_index(layer_text)
  if layer < 0 {
    fail(o, "R5_INDEX", bounded_detail(sanitize_summary_line(layer_text)))
    return g
  }
  o.layer = layer
  // The token list parses lexically here; its range is step 10's, because `n_vocab` is the
  // geometry's and the geometry has not been read yet.
  lexical := parse_tokens(tokens_text, 9223372036854775807)
  if !lexical.ok {
    detail_view: str := lexical.detail
    fail(o, "R5_TOKENS", detail_view)
    return g
  }
  geometry_text := match fs.read_file(geometry_path) {
    Ok(value) => value,
    Err(failure) => {
      fail(o, "R5_GEOMETRY_UNREADABLE", error_name(failure))
      return g
    },
  }
  geometry_view: str := geometry_text
  g = layer_qwen2.parse_geometry(geometry_view)
  o.arch = g.arch.clone()
  o.n_layer = g.n_layer
  o.n_embd = g.n_embd
  o.n_head = g.n_head
  o.n_head_kv = g.n_head_kv
  o.head_dim = g.head_dim
  o.n_ff = g.n_ff
  o.n_vocab = g.n_vocab
  o.context_length = g.context_length
  o.rms_eps_bits = g.rms_eps_bits
  o.rope_type = g.rope_type
  o.rope_dim_count = g.rope_dim_count
  o.rope_freq_base_bits = g.rope_freq_base_bits
  o.attn_scale_bits = g.attn_scale_bits
  if g.code.len() > 0 {
    code_view: str := g.code
    detail_view: str := g.detail
    fail(o, code_view, detail_view)
    return g
  }
  if layer >= g.n_layer {
    fail(o, "R5_INDEX", labelled("layer", layer))
    return g
  }
  parsed := parse_tokens(tokens_text, g.n_vocab)
  if !parsed.ok {
    detail_view: str := parsed.detail
    fail(o, "R5_TOKENS", detail_view)
    return g
  }
  // R6-DECODE-KV-STEP1 section 2.7 lifted `MAX_PREFILL_TOKENS` from 6 to 8 for the **decode** arm,
  // whose per-token tensors are one column wide and are therefore printed in full at any `T`. This
  // arm's tensors are not. `llama-eval-callback` prints a tensor's rows in full only while
  // `ne1 <= TRUNCATION_PRINTED`, and above it prints three leading and three trailing rows; the
  // scan's `printed_count` clamps to six on **both** sides, so at `T = 7` or `T = 8` a transcript
  // comparison would silently check six of seven rows and report `PASS` on a tensor it never saw.
  // The oracle refuses itself instead. Without a transcript there is no oracle and the lift is
  // arithmetic only, which is what `--decode-step`'s own `--model-forward` characterization pass
  // relies on: it supplies `-` in the transcript position.
  if o.transcript_present && parsed.count > TRUNCATION_PRINTED {
    fail(o, "R5_ORACLE_TRUNCATED", labelled("tokens", parsed.count))
    return g
  }
  // A nested struct field cannot be moved out of a struct at this pin, so the column is rebuilt
  // rather than lifted out of the parser's own record (section 6, correction C9).
  mut ids: array_builder<i64> := array_builder()
  mut copy_at := 0
  loop {
    if copy_at >= parsed.count { break }
    ids.push(parsed.ids[copy_at])
    copy_at = copy_at + 1
  }
  o.token_count = parsed.count
  tokens = TokenColumns { count: parsed.count, ids: ids.build() }
  return g
}

// The three blocks step 12 selects. It carries no handle and no column: `alignpack_read.PackBlock`
// is a plain record of integers.
Selection {
  ok: bool,
  embedding: alignpack_read.PackBlock,
  attention: alignpack_read.PackBlock,
  mlp: alignpack_read.PackBlock,
}

fn empty_block() -> alignpack_read.PackBlock = alignpack_read.PackBlock {
  index: -1,
  kind: -1,
  layer: -1,
  expert: -1,
  member_count: 0,
  member_start: 0,
  pack_offset: 0,
  pack_bytes: 0,
  payload_bytes: 0,
}

fn empty_selection() -> Selection = Selection {
  ok: false,
  embedding: empty_block(),
  attention: empty_block(),
  mlp: empty_block(),
}

fn stage_blocks(
  borrow index: alignpack_read.PackIndex,
  layer: i64,
  borrow mut o: Outcome,
) -> Selection {
  mut selection := empty_selection()
  embedding_index := find_block(index, layer_qwen2.KIND_WEIGHT, -1)
  attention_index := find_block(index, layer_qwen2.KIND_ATTENTION, layer)
  mlp_index := find_block(index, layer_qwen2.KIND_MLP, layer)
  o.embedding_block_index = embedding_index
  o.attention_block_index = attention_index
  o.mlp_block_index = mlp_index
  if embedding_index < 0 || attention_index < 0 || mlp_index < 0 {
    mut missing := layer_qwen2.KIND_MLP
    mut missing_layer := layer
    if embedding_index >= 0 && attention_index < 0 { missing = layer_qwen2.KIND_ATTENTION }
    if embedding_index < 0 {
      missing = layer_qwen2.KIND_WEIGHT
      missing_layer = -1
    }
    b := builder()
    b.write("kind[")
    b.write_int(missing)
    b.write("]layer[")
    b.write_int(missing_layer)
    b.write("]")
    rendered := b.to_string()
    rendered_view: str := rendered
    fail(o, "R5_BLOCK_MISSING", rendered_view)
    return selection
  }
  selection.embedding = match alignpack_read.block_at(index, embedding_index) {
    Ok(value) => value,
    Err(f) => {
      pack_fault_into(o, f)
      return selection
    },
  }
  selection.attention = match alignpack_read.block_at(index, attention_index) {
    Ok(value) => value,
    Err(f) => {
      pack_fault_into(o, f)
      return selection
    },
  }
  selection.mlp = match alignpack_read.block_at(index, mlp_index) {
    Ok(value) => value,
    Err(f) => {
      pack_fault_into(o, f)
      return selection
    },
  }
  selection.ok = true
  return selection
}

// Steps 13 and 14, and the window layout of section 3.9. Members are located by `role_id`, their
// dims are checked against the geometry exactly, and the row stride the embedding gather depends on
// is validated rather than assumed: a tensor is only constructible when `ne0 % blck_size == 0`, so
// `nbytes / n_vocab` must divide exactly.
fn stage_members(
  borrow pak: file,
  borrow index: alignpack_read.PackIndex,
  borrow table: layer_qwen2.MemberTable,
  borrow selection: Selection,
  n_vocab: i64,
  token_count: i64,
  borrow mut members: MemberColumns,
  borrow mut layout: Layout,
  borrow mut o: Outcome,
  borrow mut counters: alignpack_read.Counters,
) {
  mut kinds: array_builder<i64> := array_builder()
  mut types: array_builder<i64> := array_builder()
  mut ne0: array_builder<i64> := array_builder()
  mut ne1: array_builder<i64> := array_builder()
  mut nbytes: array_builder<i64> := array_builder()
  mut pack_offsets: array_builder<i64> := array_builder()
  mut sources: array_builder<i64> := array_builder()
  mut block_offsets: array_builder<i64> := array_builder()
  mut roles: array_builder<i64> := array_builder()
  mut name_start: array_builder<i64> := array_builder()
  mut name_end: array_builder<i64> := array_builder()
  names := builder()
  mut cursor := 0
  mut slot := 0
  loop {
    if slot >= table.count { break }
    label := layer_qwen2.member_label(table, slot)
    kind := table.block[slot]
    found := if kind == layer_qwen2.KIND_WEIGHT {
      find_member(pak, index, selection.embedding, table.role[slot], counters)
    } else {
      if kind == layer_qwen2.KIND_ATTENTION {
        find_member(pak, index, selection.attention, table.role[slot], counters)
      } else {
        find_member(pak, index, selection.mlp, table.role[slot], counters)
      }
    }
    member := match found {
      Ok(value) => value,
      Err(f) => {
        code_view: str := f.code
        fail(o, code_view, named("role", label))
        break
      },
    }
    mut block_offset := selection.mlp.pack_offset
    if kind == layer_qwen2.KIND_WEIGHT { block_offset = selection.embedding.pack_offset }
    if kind == layer_qwen2.KIND_ATTENTION { block_offset = selection.attention.pack_offset }
    if member.dim0 != table.ne0[slot] || member.dim1 != table.ne1[slot] {
      fail(o, "R5_SHAPE", named("role", label))
      break
    }
    if member.dim0 > MAX_DIMENSION || member.dim1 > MAX_DIMENSION || member.nbytes < 1 {
      fail(o, "R5_SHAPE", named("role", label))
      break
    }
    roles.push(table.role[slot])
    kinds.push(kind)
    types.push(member.ggml_type)
    ne0.push(member.dim0)
    ne1.push(member.dim1)
    nbytes.push(member.nbytes)
    pack_offsets.push(member.pack_offset)
    sources.push(member.source_offset)
    block_offsets.push(member.pack_offset - block_offset)
    names.write(label)
    name_start.push(cursor)
    cursor = cursor + label.len()
    name_end.push(cursor)
    slot = slot + 1
  }
  o.reader_pread_count = counters.pread_count
  o.reader_bytes_read = counters.bytes_read
  if o.code.len() > 0 { return }
  member_nbytes := nbytes.build()
  row_bytes := member_nbytes[0] / n_vocab
  if row_bytes <= 0 || row_bytes * n_vocab != member_nbytes[0] {
    fail(o, "R5_SHAPE", named("role", "token_embd"))
    return
  }
  mut window_offsets: array_builder<i64> := array_builder()
  mut total := 0
  mut window_at := 0
  loop {
    if window_at >= table.count { break }
    window_offsets.push(total)
    span := if window_at == 0 { row_bytes * token_count } else { member_nbytes[window_at] }
    total = total + align_up(span, index.block_align)
    window_at = window_at + 1
  }
  members = MemberColumns {
    count: table.count,
    names: names.to_string(),
    name_start: name_start.build(),
    name_end: name_end.build(),
    role: roles.build(),
    kind: kinds.build(),
    ggml_type: types.build(),
    ne0: ne0.build(),
    ne1: ne1.build(),
    nbytes: member_nbytes,
    pack_offset: pack_offsets.build(),
  }
  layout = Layout {
    source_offsets: sources.build(),
    block_offsets: block_offsets.build(),
    window_offsets: window_offsets.build(),
    row_bytes: row_bytes,
    weight_bytes: total,
  }
  o.weight_bytes = total
}

// Steps 15 and 16. Three reads: one `pread` per embedding row, one per block, short reads
// completed, everything copied into `block_align`-aligned window slots. Section 2.5 is why the
// embedding is row-gathered: the whole member is 3.1x the bytes and 4.5x the read time for a
// byte-identical answer.
fn stage_read(
  borrow pak: file,
  borrow index: alignpack_read.PackIndex,
  borrow selection: Selection,
  borrow members: MemberColumns,
  borrow layout: Layout,
  borrow tokens: TokenColumns,
  borrow mut weights: buffer,
  borrow mut reads: ReadColumns,
  borrow mut o: Outcome,
  borrow mut counters: alignpack_read.Counters,
) {
  mut read_bytes: array_builder<i64> := array_builder()
  mut pread_count: array_builder<i64> := array_builder()
  started := time.instant()
  mut token_at := 0
  loop {
    if token_at >= tokens.count || o.code.len() > 0 { break }
    take_pack(o, alignpack_read.read_append(
        pak, weights, counters, "R4_PACK_UNREADABLE",
        members.pack_offset[0] + tokens.ids[token_at] * layout.row_bytes, layout.row_bytes))
    token_at = token_at + 1
  }
  read_bytes.push(layout.row_bytes * tokens.count)
  pread_count.push(tokens.count)
  gathered := layout.row_bytes * tokens.count
  if o.code.len() == 0 {
    fill_zero(weights, align_up(gathered, index.block_align) - gathered)
  }
  mut attention_image: buffer := buffer(0)
  mut mlp_image: buffer := buffer(0)
  if o.code.len() == 0 {
    take_pack(o, alignpack_read.read_exact(
        pak, attention_image, counters, "R4_PACK_UNREADABLE",
        selection.attention.pack_offset, selection.attention.pack_bytes))
  }
  if o.code.len() == 0 {
    take_pack(o, alignpack_read.read_exact(
        pak, mlp_image, counters, "R4_PACK_UNREADABLE",
        selection.mlp.pack_offset, selection.mlp.pack_bytes))
  }
  if o.code.len() == 0 {
    attention_view := attention_image.bytes()
    mlp_view := mlp_image.bytes()
    mut copy_at := 1
    loop {
      if copy_at >= members.count { break }
      span := members.nbytes[copy_at]
      start := layout.block_offsets[copy_at]
      attention := members.kind[copy_at] == layer_qwen2.KIND_ATTENTION
      available := if attention { attention_view.len() } else { mlp_view.len() }
      if start < 0 || span > available - start {
        fail(o, "R4_PACK_UNREADABLE", named("role", member_label_at(members, copy_at)))
        break
      }
      if attention {
        weights.append(attention_view[start..start + span])
      } else {
        weights.append(mlp_view[start..start + span])
      }
      fill_zero(weights, align_up(span, index.block_align) - span)
      read_bytes.push(span)
      pread_count.push(1)
      copy_at = copy_at + 1
    }
  }
  o.pread_ns = time.instant() - started
  o.reader_pread_count = counters.pread_count
  o.reader_bytes_read = counters.bytes_read
  reads = ReadColumns { read_bytes: read_bytes.build(), pread_count: pread_count.build() }
}

// Steps 18, 19, and 20: the ABI probe, the operand-table drift guard, the type predicate, and the
// alignment rule that keeps `GGML_ASSERT` and `abort()` unreachable for all thirteen placements.
// Section 2.3 found two Q6_K members in this layer, which R4.5's single-member spike never
// exercised, so the type predicate is thirteen answers and not one.
fn stage_abi(
  borrow members: MemberColumns,
  borrow layout: Layout,
  borrow types: array<i64>,
  borrow window: slice<u8>,
  borrow mut abi: AbiColumns,
  borrow mut o: Outcome,
) {
  alignment := ggml_ffi.tensor_alignment()
  o.tensor_alignment = if alignment > 0 { alignment } else { 0 }
  o.table_drift = ggml_ffi.table_drift()
  if alignment <= 0 {
    fail(o, "R5_ABI", labelled("alignment", alignment))
    return
  }
  if alignment > MAX_TENSOR_ALIGNMENT {
    fail(o, "R5_ABI", labelled("alignment_bound", alignment))
    return
  }
  if o.table_drift >= 0 {
    fail(o, "R5_ABI", labelled("type", o.table_drift))
    return
  }
  mut blck: array_builder<i64> := array_builder()
  mut sizes: array_builder<i64> := array_builder()
  mut alignments: array_builder<i64> := array_builder()
  mut type_failure := -1
  mut type_status := 0
  mut alignment_failure := -1
  mut at := 0
  loop {
    if at >= members.count { break }
    kind := types[at]
    size := ggml_ffi.blck_size(kind)
    blck.push(if size > 0 { size } else { 0 })
    width := ggml_ffi.type_size(kind)
    sizes.push(if width > 0 { width } else { 0 })
    alignments.push(layout.window_offsets[at] % alignment)
    status := ggml_ffi.type_ok_status(kind, members.ne0[at])
    if status != 0 && type_failure < 0 {
      type_failure = at
      type_status = status
    }
    if layout.window_offsets[at] % alignment != 0 && alignment_failure < 0 {
      alignment_failure = at
    }
    at = at + 1
  }
  abi = AbiColumns {
    blck: blck.build(),
    type_size: sizes.build(),
    window_alignment: alignments.build(),
  }
  if type_failure >= 0 {
    code := if type_status == ggml_ffi.STATUS_TYPE { "R5_TYPE_UNSUPPORTED" } else { "R5_SHAPE" }
    fail(o, code, named("role", member_label_at(members, type_failure)))
    return
  }
  if ggml_ffi.align_mod(window, alignment) != 0 {
    fail(o, "R5_ALIGNMENT", "window")
    return
  }
  if alignment_failure >= 0 {
    fail(o, "R5_ALIGNMENT", named("role", member_label_at(members, alignment_failure)))
  }
}

// The thirteen weight tensors, created in the weight context and **placed** at their own interior
// offsets in the Align-owned window. This is R4.5's contract, thirteen times.
fn stage_weight_tensors(
  ctx: raw,
  handle: raw,
  borrow slots: slice<u8>,
  borrow window: slice<u8>,
  borrow table: layer_qwen2.MemberTable,
  borrow members: MemberColumns,
  borrow layout: Layout,
  borrow types: array<i64>,
  token_count: i64,
) -> Result<(), ggml_ffi.Fault> {
  mut at := 0
  loop {
    if at >= members.count { break }
    label := member_label_at(members, at)
    span := if at == 0 { layout.row_bytes * token_count } else { members.nbytes[at] }
    rows := if at == 0 { token_count } else { members.ne1[at] }
    if table.n_dims[at] == 1 {
      ggml_ffi.slot_new_tensor_1d(ctx, slots, at, types[at], members.ne0[at], label)?
    } else {
      ggml_ffi.slot_new_tensor_2d(ctx, slots, at, types[at], members.ne0[at], rows, label)?
    }
    // The pack's recorded `nbytes` and `ggml_nbytes()` of the tensor ggml built from the recorded
    // dims must agree; that equality is the check that the member table carries enough to size a
    // member from the pack alone, which is the difference between a container and an index.
    if ggml_ffi.slot_nbytes(slots, at) != span {
      return Err(ffi_fault("R5_SHAPE", named("role", label)))
    }
    offset := layout.window_offsets[at]
    // The Borrow crossing the FFI boundary must be a stable named local, never a temporary.
    region := window[offset..offset + span]
    ggml_ffi.slot_place(handle, slots, at, region, label)?
    at = at + 1
  }
  return Ok(())
}

// `verdict` is `EXTERNAL` exactly when every one of the thirteen data pointers landed at the offset
// this arm chose; `COPIED` is a successful run reporting the answer the roadmap actually asked for.
fn stage_weight_identity(
  borrow slots: slice<u8>,
  borrow window: slice<u8>,
  borrow members: MemberColumns,
  borrow layout: Layout,
  borrow mut placement: PlacementColumns,
  borrow mut o: Outcome,
) {
  mut data_offsets: array_builder<i64> := array_builder()
  mut identity: array_builder<i64> := array_builder()
  mut external := true
  mut at := 0
  loop {
    if at >= members.count { break }
    landed := ggml_ffi.slot_data_offset(slots, at, window)
    data_offsets.push(landed)
    identity.push(if landed == layout.window_offsets[at] { 1 } else { 0 })
    if landed != layout.window_offsets[at] { external = false }
    at = at + 1
  }
  placement = PlacementColumns { data_offset: data_offsets.build(), identity: identity.build() }
  o.verdict = if external { VERDICT_EXTERNAL } else { VERDICT_COPIED }
}

// The three inputs live in ggml's own memory: they are activations, not weights, and section 3.9
// assigns activation lifetime to ggml deliberately.
fn stage_input_tensors(
  ctx: raw, borrow slots: slice<u8>, tokens: i64) -> Result<(), ggml_ffi.Fault> {
  ggml_ffi.slot_new_i32_1d(ctx, slots, layer_qwen2.SLOT_TOKENS, tokens, "inp_tokens")?
  ggml_ffi.slot_new_i32_1d(ctx, slots, layer_qwen2.SLOT_POS, tokens, "inp_pos")?
  ggml_ffi.slot_new_tensor_2d(
    ctx, slots, layer_qwen2.SLOT_MASK, layer_qwen2.GGML_TYPE_F32, tokens, tokens, "kq_mask")?
  return Ok(())
}

fn stage_input_values(
  borrow slots: slice<u8>,
  borrow ids: slice<u8>,
  borrow positions: slice<u8>,
  borrow mask: slice<u8>,
  tokens: i64,
) -> Result<(), ggml_ffi.Fault> {
  ggml_ffi.slot_set(slots, layer_qwen2.SLOT_TOKENS, ids, 0, tokens * 4, "inp_tokens")?
  ggml_ffi.slot_set(slots, layer_qwen2.SLOT_POS, positions, 0, tokens * 4, "inp_pos")?
  ggml_ffi.slot_set(slots, layer_qwen2.SLOT_MASK, mask, 0, tokens * tokens * 4, "kq_mask")?
  return Ok(())
}

// Steps 22 and 23 for one arm: the node-table walk, the output marks, the graph, and the two
// `gallocr` predicates whose `bool` return section 2.6 required to be wrapped.
fn stage_graph(
  ctx: raw,
  graph: raw,
  galloc: raw,
  borrow slots: slice<u8>,
  borrow nodes: layer_qwen2.NodeTable,
  borrow oracle: layer_qwen2.OracleTable,
  reserve_label: str,
  alloc_label: str,
  borrow mut activation_bytes: i64,
) -> Result<(), ggml_ffi.Fault> {
  build_nodes(ctx, slots, nodes)?
  mark_outputs(slots, oracle)?
  ggml_ffi.graph_expand(graph, slots, layer_qwen2.output_slot(), "l_out")?
  ggml_ffi.gallocr_reserve(galloc, graph, reserve_label)?
  activation_bytes = ggml_ffi.gallocr_bytes(galloc)
  ggml_ffi.gallocr_alloc(galloc, graph, alloc_label)?
  return Ok(())
}

// Step 24. One warm-up call, then five timed ones: section 2.3 measured a first compute costing an
// order of magnitude more than the steady state — the CPU backend's thread-pool spin-up — so the
// warm-up is contractual and `compute_ns` is the mean of the calls that follow it.
fn stage_compute(backend: raw, graph: raw, borrow mut o: Outcome) {
  mut warmed := 0
  loop {
    if warmed >= WARMUP_CALLS { break }
    status := ggml_ffi.graph_compute(backend, graph)
    if status != 0 {
      o.compute_status = status
      fail(o, "R5_COMPUTE", labelled("status", status))
      return
    }
    warmed = warmed + 1
  }
  started := time.instant()
  mut repeat := 0
  loop {
    if repeat >= TIMED_CALLS { break }
    status := ggml_ffi.graph_compute(backend, graph)
    if status != 0 {
      o.compute_status = status
      fail(o, "R5_COMPUTE", labelled("status", status))
      return
    }
    repeat = repeat + 1
  }
  o.compute_ns = (time.instant() - started) / TIMED_CALLS
}

// The per-node digests. `l_out` alone would make a failure undiagnosable: a single wrong digit
// could come from any of thirty-two nodes, and a per-node `sha256`, `bit_sum`, and
// `f32_sum_millionths` is what turns a red qualification into a bug report naming one node.
// Checksums are never floats, for `r4-alignpack-layer-major.md` section 2.3's reason.
fn stage_digests(
  borrow slots: slice<u8>,
  borrow oracle: layer_qwen2.OracleTable,
  borrow table: layer_qwen2.NodeTable,
  borrow window: slice<u8>,
  borrow mut nodes: NodeColumns,
  borrow mut o: Outcome,
) -> Result<(), ggml_ffi.Fault> {
  mut ops: array_builder<i64> := array_builder()
  mut ne0: array_builder<i64> := array_builder()
  mut ne1: array_builder<i64> := array_builder()
  mut ne2: array_builder<i64> := array_builder()
  mut ne3: array_builder<i64> := array_builder()
  mut elements: array_builder<i64> := array_builder()
  mut bit_sums: array_builder<i64> := array_builder()
  mut sums: array_builder<i64> := array_builder()
  mut nonfinite: array_builder<i64> := array_builder()
  digests := builder()
  mut at := 0
  loop {
    if at >= oracle.count { break }
    id := layer_qwen2.oracle_id(oracle, at)
    index_of := layer_qwen2.SLOT_NODE_BASE + oracle.node[at]
    span := ggml_ffi.slot_nbytes(slots, index_of)
    if span <= 0 || span > window.len() {
      return Err(ffi_fault("R5_SLOT", named("node", id)))
    }
    ggml_ffi.slot_get(slots, index_of, window, 0, span, id)?
    region := window[0..span]
    digest := crypto.sha256(region)
    digests.write(encoding.hex_encode(digest[0..digest.len()]))
    ops.push(table.op[oracle.node[at]])
    ne0.push(ggml_ffi.slot_ne(slots, index_of, 0))
    ne1.push(ggml_ffi.slot_ne(slots, index_of, 1))
    ne2.push(ggml_ffi.slot_ne(slots, index_of, 2))
    ne3.push(ggml_ffi.slot_ne(slots, index_of, 3))
    count := span / 4
    elements.push(count)
    mut bits_total := 0
    mut nonfinite_count := 0
    mut accumulator: f32 := 0.0 as f32
    mut element := 0
    loop {
      if element >= count { break }
      bits := region.u32_le(element * 4) as i64
      bits_total = bits_total + bits
      if (bits / 8388608) % 256 == 255 { nonfinite_count = nonfinite_count + 1 }
      // Sequential f32 accumulation in element order, which is section 2.3's finding: the
      // instrument accumulates its `sum` this way, and matching it made three of five checked nodes
      // bit-identical instead of merely close.
      accumulator = accumulator + region.f32_le(element * 4)
      element = element + 1
    }
    bit_sums.push(bits_total)
    nonfinite.push(nonfinite_count)
    sums.push(((accumulator as f64) * 1000000.0).round() as i64)
    at = at + 1
  }
  nodes = NodeColumns {
    count: oracle.count,
    digests: digests.to_string(),
    op: ops.build(),
    ne0: ne0.build(),
    ne1: ne1.build(),
    ne2: ne2.build(),
    ne3: ne3.build(),
    elements: elements.build(),
    bit_sum: bit_sums.build(),
    sum_millionths: sums.build(),
    nonfinite: nonfinite.build(),
  }
  last := oracle.count - 1
  view: str := nodes.digests
  if view.len() >= (last + 1) * DIGEST_HEX_BYTES {
    o.sha256 = view[last * DIGEST_HEX_BYTES..(last + 1) * DIGEST_HEX_BYTES].clone()
    o.bit_sum = nodes.bit_sum[last]
    o.element_count = nodes.elements[last]
    o.nonfinite_count = nodes.nonfinite[last]
  }
  return Ok(())
}

// The reference arm's thirteen weights: created in a second context, allocated by
// `ggml_backend_alloc_ctx_tensors`, and filled from the same Align window, so ggml owns them. The
// three inputs are **shared, not rebuilt** — the arm must differ in where the weights live and in
// nothing else.
fn stage_reference_weights(
  ctx: raw,
  borrow slots: slice<u8>,
  borrow primary: slice<u8>,
  borrow window: slice<u8>,
  borrow table: layer_qwen2.MemberTable,
  borrow members: MemberColumns,
  borrow layout: Layout,
  borrow types: array<i64>,
  token_count: i64,
  fill: bool,
) -> Result<(), ggml_ffi.Fault> {
  mut at := 0
  loop {
    if at >= members.count { break }
    label := member_label_at(members, at)
    span := if at == 0 { layout.row_bytes * token_count } else { members.nbytes[at] }
    rows := if at == 0 { token_count } else { members.ne1[at] }
    offset := layout.window_offsets[at]
    if fill {
      region := window[offset..offset + span]
      ggml_ffi.slot_set(slots, at, region, 0, span, label)?
    } else {
      if table.n_dims[at] == 1 {
        ggml_ffi.slot_new_tensor_1d(ctx, slots, at, types[at], members.ne0[at], label)?
      } else {
        ggml_ffi.slot_new_tensor_2d(ctx, slots, at, types[at], members.ne0[at], rows, label)?
      }
    }
    at = at + 1
  }
  if !fill { return Ok(()) }
  mut copy_at := layer_qwen2.SLOT_TOKENS
  loop {
    if copy_at > layer_qwen2.SLOT_MASK { break }
    ggml_ffi.slot_copy(slots, copy_at, primary, copy_at, "input")?
    copy_at = copy_at + 1
  }
  return Ok(())
}

// Step 27's comparison. Every oracle node's bytes must be **byte-identical** between the two arms.
// This oracle proves bytes: it holds regardless of ggml version, kernel choice, or llama.cpp build,
// because both arms run the same kernels over the same bits.
fn stage_reference_compare(
  borrow primary: slice<u8>,
  borrow reference: slice<u8>,
  borrow oracle: layer_qwen2.OracleTable,
  borrow left: slice<u8>,
  borrow right: slice<u8>,
  borrow mut o: Outcome,
) -> Result<(), ggml_ffi.Fault> {
  mut at := 0
  loop {
    if at >= oracle.count { break }
    id := layer_qwen2.oracle_id(oracle, at)
    index_of := layer_qwen2.SLOT_NODE_BASE + oracle.node[at]
    span := ggml_ffi.slot_nbytes(primary, index_of)
    if span <= 0 || span > left.len() || span > right.len() {
      return Err(ffi_fault("R5_SLOT", named("node", id)))
    }
    ggml_ffi.slot_get(primary, index_of, left, 0, span, id)?
    ggml_ffi.slot_get(reference, index_of, right, 0, span, id)?
    o.reference_compared = o.reference_compared + 1
    mut element := 0
    mut differed := false
    loop {
      if element >= span / 4 { break }
      a := left.u32_le(element * 4) as i64
      b := right.u32_le(element * 4) as i64
      if a != b {
        differed = true
        if o.reference_first_index < 0 {
          o.reference_first_node = id.clone()
          o.reference_first_index = element
          o.reference_first_primary_bits = a
          o.reference_first_reference_bits = b
        }
        break
      }
      element = element + 1
    }
    if !differed { o.reference_identical = o.reference_identical + 1 }
    at = at + 1
  }
  if o.reference_identical == o.reference_compared {
    o.reference_verdict = REFERENCE_IDENTICAL
  } else {
    o.reference_verdict = REFERENCE_MISMATCH
    worst_view: str := o.reference_first_node
    fail(o, "R5_REFERENCE_MISMATCH", at_index("node", worst_view, o.reference_first_index))
  }
  return Ok(())
}

// `r5c-metal-prefill.md` section 6, correction C19. One computed activation, in ten-thousandths,
// or `UNREPRESENTABLE` when it has no such value. The exponent test is `digest_region`'s — an
// all-ones exponent field is an infinity or a NaN — so one definition of "non-finite" serves the
// published node counts and this oracle, and a NaN is caught by the bits rather than by its `as i64`, which is `0`. A finite
// magnitude beyond the limit is refused by the same route, so no caller has to know which of the
// two it met.
fn oracle_ten_thousandths(borrow region: slice<u8>, at: i64) -> i64 {
  bits := region.u32_le(at * 4) as i64
  if (bits / 8388608) % 256 == 255 { return UNREPRESENTABLE }
  scaled := ((region.f32_le(at * 4) as f64) * 10000.0).round() as i64
  if scaled > ORACLE_SCALE_LIMIT_TEN_THOUSANDTHS { return UNREPRESENTABLE }
  if scaled < 0 - ORACLE_SCALE_LIMIT_TEN_THOUSANDTHS { return UNREPRESENTABLE }
  return scaled
}

// Steps 28 and 29. A named node the transcript does not carry is `R5_ORACLE_MISSING` and a declared
// shape that disagrees is `R5_ORACLE_SHAPE` — both **errors**, while a tolerance breach is not. The
// asymmetry is deliberate: a breach is the measurement this capability exists to make, and
// reporting `PASS` for zero compared nodes is the failure this design most needs to make
// impossible. Both comparisons are integer comparisons and neither renders a float.
fn stage_oracle(
  transcript_path: str,
  borrow slots: slice<u8>,
  borrow oracle: layer_qwen2.OracleTable,
  borrow nodes: NodeColumns,
  borrow window: slice<u8>,
  borrow mut matched: array<i64>,
  borrow mut o: Outcome,
) -> Result<(), ggml_ffi.Fault> {
  started := time.instant()
  scan := scan_transcript(transcript_path, oracle)
  o.oracle_lines = scan.line_count
  o.oracle_callback_lines = scan.callback_line_count
  if scan.code.len() > 0 {
    code_view: str := scan.code
    detail_view: str := scan.detail
    fail(o, code_view, detail_view)
  }
  mut at := 0
  loop {
    if at >= oracle.count || o.code.len() > 0 { break }
    if scan.matched[at] == 0 {
      fail(o, "R5_ORACLE_MISSING", named("node", layer_qwen2.oracle_id(oracle, at)))
      break
    }
    matched[at] = 1
    if oracle.compared[at] == 1 {
      o.oracle_matched = o.oracle_matched + 1
      if scan.ne0[at] != nodes.ne0[at] || scan.ne1[at] != nodes.ne1[at]
        || scan.ne2[at] != nodes.ne2[at] || scan.ne3[at] != nodes.ne3[at] {
        fail(o, "R5_ORACLE_SHAPE", named("node", layer_qwen2.oracle_id(oracle, at)))
        break
      }
    }
    at = at + 1
  }
  // Every compared node must have contributed the elements its own declared shape yields. Each
  // axis prints at most six positions, so the product of `printed_count(ne_d)` is exactly how many
  // `(index, value)` pairs a well-formed record carries. A record whose value block was truncated,
  // deleted, or silently skipped matches by name and by shape and then compares **nothing**, and
  // the run would report `PASS` over an oracle that measured nothing — the one failure section 3.8
  // says this design most needs to make impossible. The test is `got != expected`, not
  // `got < expected`: a count above the expectation is a double-bound record, which is not a
  // measurement of the node either (section 6, correction C19).
  mut count_at := 0
  loop {
    if count_at >= oracle.count || o.code.len() > 0 { break }
    if oracle.compared[count_at] == 1 {
      expected := printed_count(scan.ne0[count_at]) * printed_count(scan.ne1[count_at])
        * printed_count(scan.ne2[count_at]) * printed_count(scan.ne3[count_at])
      mut got := 0
      mut probe := 0
      loop {
        if probe >= scan.element_node.len() { break }
        if scan.element_node[probe] == count_at { got = got + 1 }
        probe = probe + 1
      }
      if got != expected {
        fail(o, "R5_ORACLE_MISSING",
          miscount(layer_qwen2.oracle_id(oracle, count_at), got, expected))
        break
      }
    }
    count_at = count_at + 1
  }
  mut current := -1
  mut span := 0
  mut element_at := 0
  loop {
    if element_at >= scan.element_node.len() || o.code.len() > 0 { break }
    row := scan.element_node[element_at]
    if oracle.compared[row] == 1 {
      if row != current {
        index_of := layer_qwen2.SLOT_NODE_BASE + oracle.node[row]
        span = ggml_ffi.slot_nbytes(slots, index_of)
        ggml_ffi.slot_get(slots, index_of, window, 0, span, layer_qwen2.oracle_id(oracle, row))?
        current = row
      }
      spot := scan.element_index[element_at]
      if spot < 0 || spot * 4 + 4 > span {
        fail(o, "R5_ORACLE_SHAPE", named("node", layer_qwen2.oracle_id(oracle, row)))
        break
      }
      // `r5c-metal-prefill.md` section 6, correction C19: the computed activation crosses the
      // range-checked conversion and the transcript's own value is range-checked beside it, so the
      // subtraction, the absolute value, and every comparison below are in range by construction.
      // An unrepresentable operand takes the scale limit as its magnitude, which is above
      // `TOLERANCE_TEN_THOUSANDTHS` by fifteen orders, so it is an `ORACLE_FAIL` and never a
      // wrapped pass.
      computed := oracle_ten_thousandths(window, spot)
      expected := scan.element_value[element_at]
      unrepresentable := computed == UNREPRESENTABLE
        || expected > ORACLE_SCALE_LIMIT_TEN_THOUSANDTHS
        || expected < 0 - ORACLE_SCALE_LIMIT_TEN_THOUSANDTHS
      difference := if unrepresentable { 0 } else { computed - expected }
      magnitude := if unrepresentable {
        ORACLE_SCALE_LIMIT_TEN_THOUSANDTHS
      } else if difference < 0 {
        0 - difference
      } else {
        difference
      }
      o.oracle_elements = o.oracle_elements + 1
      if magnitude > o.oracle_max_abs {
        o.oracle_max_abs = magnitude
        o.oracle_worst_node = layer_qwen2.oracle_id(oracle, row).clone()
        o.oracle_worst_element = spot
      }
    }
    element_at = element_at + 1
  }
  mut breach := false
  mut sum_at := 0
  loop {
    if sum_at >= oracle.count || o.code.len() > 0 { break }
    if oracle.compared[sum_at] == 1 && scan.sum_present[sum_at] == 1 {
      expected := scan.sum_millionths[sum_at]
      computed := nodes.sum_millionths[sum_at]
      // `r5c-metal-prefill.md` section 6, correction C19, the sum half of the same class.
      // `nodes.nonfinite` is the count the digest already published for this node, so a node
      // holding an infinity or a NaN — whose f32 accumulation has no millionths value at all, and
      // whose saturated or zeroed conversion is what wraps the subtraction below — is a breach
      // here rather than an arithmetic accident.
      // It covers the elements the transcript never printed, which the element comparison above
      // cannot reach.
      if nodes.nonfinite[sum_at] > 0
        || computed > SUM_SCALE_LIMIT_MILLIONTHS
        || computed < 0 - SUM_SCALE_LIMIT_MILLIONTHS {
        o.oracle_max_sum = UNREPRESENTABLE
        breach = true
      } else {
        difference := computed - expected
        magnitude := if difference < 0 { 0 - difference } else { difference }
        scale := if expected < 0 { 0 - expected } else { expected }
        mut bound := SUM_TOLERANCE_MILLIONTHS
        relative := scale / (1000000 / SUM_TOLERANCE_RELATIVE_PPM)
        if relative > bound { bound = relative }
        if magnitude > o.oracle_max_sum { o.oracle_max_sum = magnitude }
        if magnitude > bound { breach = true }
      }
    }
    sum_at = sum_at + 1
  }
  // The backstop the count check above makes nearly unreachable, kept because "PASS with zero
  // elements" must be impossible by construction and not only by arithmetic.
  if o.code.len() == 0 && o.oracle_elements <= 0 {
    fail(o, "R5_ORACLE_MISSING", "elements[0]")
  }
  if o.code.len() == 0 {
    if o.oracle_max_abs <= TOLERANCE_TEN_THOUSANDTHS && !breach {
      o.oracle_verdict = ORACLE_PASS
    } else {
      o.oracle_verdict = ORACLE_FAIL
    }
  }
  o.oracle_ns = time.instant() - started
  return Ok(())
}

// Step 30's teardown, in section 3.9's contractual order. It runs on **every** exit path from
// construction onward, which is why the steps above are guards rather than early returns: R4.5
// section 2.4 measured that a leaked ggml buffer is not a leak on this backend, it is a crash at
// `exit`.
fn stage_teardown(
  galloc: raw,
  reference_galloc: raw,
  graph_ctx: raw,
  reference_graph_ctx: raw,
  weight_buffer: raw,
  weight_ctx: raw,
  input_buffer: raw,
  input_ctx: raw,
  reference_buffer: raw,
  reference_ctx: raw,
  backend: raw,
  borrow mut o: Outcome,
) {
  if !ggml_ffi.handle_absent(reference_galloc) {
    ggml_ffi.gallocr_free(reference_galloc)
    o.gallocrs_freed = o.gallocrs_freed + 1
  }
  if !ggml_ffi.handle_absent(galloc) {
    ggml_ffi.gallocr_free(galloc)
    o.gallocrs_freed = o.gallocrs_freed + 1
  }
  if !ggml_ffi.handle_absent(reference_graph_ctx) {
    ggml_ffi.context_close(reference_graph_ctx)
    o.contexts_freed = o.contexts_freed + 1
  }
  if !ggml_ffi.handle_absent(graph_ctx) {
    ggml_ffi.context_close(graph_ctx)
    o.contexts_freed = o.contexts_freed + 1
  }
  if !ggml_ffi.handle_absent(weight_buffer) {
    ggml_ffi.buffer_free(weight_buffer)
    o.ggml_buffers_freed = o.ggml_buffers_freed + 1
  }
  if !ggml_ffi.handle_absent(weight_ctx) {
    ggml_ffi.context_close(weight_ctx)
    o.contexts_freed = o.contexts_freed + 1
  }
  if !ggml_ffi.handle_absent(input_buffer) {
    ggml_ffi.buffer_free(input_buffer)
    o.ggml_buffers_freed = o.ggml_buffers_freed + 1
  }
  if !ggml_ffi.handle_absent(input_ctx) {
    ggml_ffi.context_close(input_ctx)
    o.contexts_freed = o.contexts_freed + 1
  }
  if !ggml_ffi.handle_absent(reference_buffer) {
    ggml_ffi.buffer_free(reference_buffer)
    o.ggml_buffers_freed = o.ggml_buffers_freed + 1
  }
  if !ggml_ffi.handle_absent(reference_ctx) {
    ggml_ffi.context_close(reference_ctx)
    o.contexts_freed = o.contexts_freed + 1
  }
  if !ggml_ffi.handle_absent(backend) {
    ggml_ffi.backend_close(backend)
    o.backends_freed = o.backends_freed + 1
  }
  o.released_before_owner_scope_end =
  o.ggml_buffers_created == o.ggml_buffers_freed
    && o.contexts_created == o.contexts_freed
    && o.backends_created == o.backends_freed
    && o.gallocrs_created == o.gallocrs_freed
}

// Steps 3 to 16: everything before ggml exists. It returns the alignment pad the window was built
// behind, or `-1` when the arm must stop, having already recorded the code and detail.
fn stage_prepare(
  pack_path: str,
  layer_text: str,
  geometry_path: str,
  tokens_text: str,
  borrow mut g: layer_qwen2.Geometry,
  borrow mut tokens: TokenColumns,
  borrow mut members: MemberColumns,
  borrow mut layout: Layout,
  borrow mut reads: ReadColumns,
  borrow mut weights: buffer,
  borrow mut o: Outcome,
) -> i64 {
  g = stage_geometry(layer_text, tokens_text, geometry_path, tokens, o)
  if o.code.len() > 0 { return -1 }
  table := layer_qwen2.member_table(g)
  pak := match fs.open_rw(pack_path) {
    Ok(handle) => handle,
    Err(failure) => {
      fail(o, "R4_PACK_UNREADABLE", error_name(failure))
      return -1
    },
  }
  mut counters := alignpack_read.new_counters()
  index := match alignpack_read.open_pack(pak, counters) {
    Ok(value) => value,
    Err(f) => {
      pack_fault_into(o, f)
      o.reader_pread_count = counters.pread_count
      o.reader_bytes_read = counters.bytes_read
      return -1
    },
  }
  o.format_version = index.format_version
  o.block_align = index.block_align
  o.member_align = index.member_align
  o.block_count = index.block_count
  o.member_count = index.member_count
  o.total_bytes = index.total_bytes
  o.payload_offset = index.payload_offset
  chosen_layer := o.layer
  selection := stage_blocks(index, chosen_layer, o)
  if !selection.ok { return -1 }
  stage_members(
    pak, index, table, selection, g.n_vocab, tokens.count, members, layout, o, counters)
  if o.code.len() > 0 { return -1 }
  // The device-visible window is over-reserved by `MAX_TENSOR_ALIGNMENT` so the arm can hand ggml
  // an **interior** range that starts on a boundary: Align has no aligned allocator
  // (`docs/align-requests.md` Request 33) and this host answers the same reservation with a
  // 32-aligned base on one run and a 16-aligned one on the next. One byte is published first
  // because that is what makes the base measurable at all.
  weights = buffer(layout.weight_bytes + MAX_TENSOR_ALIGNMENT)
  fill_zero(weights, 1)
  pad := MAX_TENSOR_ALIGNMENT - base_mod(weights, MAX_TENSOR_ALIGNMENT)
  fill_zero(weights, pad - 1)
  stage_read(
    pak, index, selection, members, layout, tokens, weights, reads, o, counters)
  if o.code.len() > 0 { return -1 }
  if weights.bytes().len() != pad + layout.weight_bytes {
    fail(o, "R4_WINDOW_UNAVAILABLE", "weights")
    return -1
  }
  return pad
}

// Steps 21 to 24, plus the digests: every ggml object exists here and every one of them is a bare
// local, because `raw` cannot be aggregated.
pub fn execute(
  pack_path: str,
  layer_text: str,
  geometry_path: str,
  tokens_text: str,
  reference_path: str,
  transcript_path: str,
  borrow mut tokens: TokenColumns,
  borrow mut members: MemberColumns,
  borrow mut layout: Layout,
  borrow mut reads: ReadColumns,
  borrow mut abi: AbiColumns,
  borrow mut placement: PlacementColumns,
  borrow mut nodes: NodeColumns,
  borrow mut states: OracleStates,
) -> Outcome {
  started := time.instant()
  mut o := empty_outcome()
  // A compile-time property of the loaded library, not of any run, so it is read before the first
  // validation step and published even when the arm stops at step 1 (section 6, correction C15).
  o.fp_contract_off = ggml_ffi.fp_contract_off()
  o.reference_present = reference_path.len() > 0
  o.transcript_present = transcript_path.len() > 0

  mut g := layer_qwen2.empty_geometry()
  mut weights: buffer := buffer(0)
  pad := stage_prepare(
    pack_path, layer_text, geometry_path, tokens_text, g, tokens, members, layout, reads,
    weights, o)
  if pad < 0 {
    finish(o, started)
    return o
  }
  table := layer_qwen2.member_table(g)
  node_table := layer_qwen2.node_table(g, tokens.count)
  oracle := layer_qwen2.oracle_table(o.layer)
  o.node_count = node_table.count
  o.oracle_expected = oracle.count - 2
  weights_view := weights.bytes()
  window_view := weights_view[pad..pad + layout.weight_bytes]

  // Step 17. Availability. This is where the default stub shim stops, and everything above it — the
  // whole reader, the geometry, every index, shape, and role check — has run for real without ggml.
  if !ggml_ffi.available() {
    fail(o, "R5_GGML_UNAVAILABLE", "stub")
    o.verdict = VERDICT_UNAVAILABLE
    finish(o, started)
    return o
  }
  stage_abi(members, layout, members.ggml_type, window_view, abi, o)
  if o.code.len() > 0 {
    finish(o, started)
    return o
  }

  // The Align-owned side of section 3.9: the two slot stores, the causal mask, and the two index
  // images. Every one of them is this side's bytes, and every pointer the shim writes into them is
  // bounds-checked against the store's own declared capacity.
  slot_bytes := layer_qwen2.SLOT_HEADER_BYTES
    + layer_qwen2.SLOT_BYTES * layer_qwen2.MAX_NODE_SLOTS
  mut slots: buffer := buffer(slot_bytes + 8)
  fill_zero(slots, 1)
  slot_pad := 8 - base_mod(slots, 8)
  fill_zero(slots, slot_pad - 1 + slot_bytes)
  mut reference_slots: buffer := buffer(slot_bytes + 8)
  fill_zero(reference_slots, 1)
  reference_pad := 8 - base_mod(reference_slots, 8)
  fill_zero(reference_slots, reference_pad - 1 + slot_bytes)
  mut mask: buffer := buffer(tokens.count * tokens.count * 4)
  layer_qwen2.write_mask(mask, tokens.count)
  mut token_image: buffer := buffer(tokens.count * 4)
  mut position_image: buffer := buffer(tokens.count * 4)
  mut image_at := 0
  loop {
    if image_at >= tokens.count { break }
    // The gathered ids, remapped to `0..T-1`: the embedding window holds only the rows this prefill
    // needs, so `GET_ROWS` addresses them by position and not by vocabulary id (section 3.4).
    token_image.put_u32_le(image_at as u32)
    position_image.put_u32_le(image_at as u32)
    image_at = image_at + 1
  }
  slots_all := slots.bytes()
  reference_slots_all := reference_slots.bytes()
  mask_view := mask.bytes()
  token_view := token_image.bytes()
  position_view := position_image.bytes()
  if slots_all.len() < slot_pad + slot_bytes
    || reference_slots_all.len() < reference_pad + slot_bytes
    || mask_view.len() != tokens.count * tokens.count * 4
    || token_view.len() != tokens.count * 4
    || position_view.len() != tokens.count * 4 {
    fail(o, "R4_WINDOW_UNAVAILABLE", "slots")
    finish(o, started)
    return o
  }
  slot_view := slots_all[slot_pad..slot_pad + slot_bytes]
  reference_slot_view := reference_slots_all[reference_pad..reference_pad + slot_bytes]

  // Steps 21 to 30. One block, no early return, one convergent teardown.
  mut backend := ggml_ffi.null_handle()
  mut weight_ctx := ggml_ffi.null_handle()
  mut input_ctx := ggml_ffi.null_handle()
  mut graph_ctx := ggml_ffi.null_handle()
  mut reference_ctx := ggml_ffi.null_handle()
  mut reference_graph_ctx := ggml_ffi.null_handle()
  mut weight_buffer := ggml_ffi.null_handle()
  mut input_buffer := ggml_ffi.null_handle()
  mut reference_buffer := ggml_ffi.null_handle()
  mut graph := ggml_ffi.null_handle()
  mut reference_graph := ggml_ffi.null_handle()
  mut galloc := ggml_ffi.null_handle()
  mut reference_galloc := ggml_ffi.null_handle()

  context_bytes := ggml_ffi.graph_context_bytes(layer_qwen2.MAX_NODE_SLOTS)
  o.graph_context_bytes = context_bytes
  if context_bytes <= 0 {
    fail(o, "R5_ABI", labelled("graph_context_bytes", context_bytes))
  }
  device := ggml_ffi.device_open()
  if o.code.len() == 0 && ggml_ffi.handle_absent(device) {
    fail(o, "R5_GGML_UNAVAILABLE", "device")
  }
  if o.code.len() == 0 {
    backend = ggml_ffi.backend_open(device)
    if ggml_ffi.handle_absent(backend) {
      fail(o, "R5_GGML_INIT", "backend")
    } else {
      o.backends_created = o.backends_created + 1
      o.backend_name = ggml_ffi.backend_name(backend)
    }
  }
  if o.code.len() == 0 {
    weight_ctx = ggml_ffi.context_open(context_bytes)
    input_ctx = ggml_ffi.context_open(context_bytes)
    graph_ctx = ggml_ffi.context_open(context_bytes)
    if ggml_ffi.handle_absent(weight_ctx) || ggml_ffi.handle_absent(input_ctx)
      || ggml_ffi.handle_absent(graph_ctx) {
      fail(o, "R5_GGML_INIT", "context")
    } else {
      o.contexts_created = o.contexts_created + 3
    }
  }
  if o.code.len() == 0 {
    take(o, ggml_ffi.slots_init(slot_view, slot_bytes, "slots"))
  }
  if o.code.len() == 0 {
    take(o, ggml_ffi.slots_init(reference_slot_view, slot_bytes, "reference_slots"))
  }
  o.slot_magic_ok = ggml_ffi.slots_ok(slot_view)
  o.slot_capacity = ggml_ffi.slots_capacity(slot_view)
  build_started := time.instant()
  if o.code.len() == 0 {
    weight_buffer = ggml_ffi.buffer_from_host(device, window_view, layout.weight_bytes)
    if ggml_ffi.handle_absent(weight_buffer) {
      fail(o, "R5_GGML_INIT", "weight_buffer")
    } else {
      o.ggml_buffers_created = o.ggml_buffers_created + 1
    }
  }
  if o.code.len() == 0 {
    take(o, stage_weight_tensors(
        weight_ctx, weight_buffer, slot_view, window_view, table, members, layout, members.ggml_type,
        tokens.count))
  }
  if o.code.len() == 0 {
    stage_weight_identity(slot_view, window_view, members, layout, placement, o)
  }
  if o.code.len() == 0 {
    take(o, stage_input_tensors(input_ctx, slot_view, tokens.count))
  }
  if o.code.len() == 0 {
    input_buffer = ggml_ffi.alloc_remaining(input_ctx, backend)
    if ggml_ffi.handle_absent(input_buffer) {
      fail(o, "R5_GGML_INIT", "input_buffer")
    } else {
      o.ggml_buffers_created = o.ggml_buffers_created + 1
    }
  }
  if o.code.len() == 0 {
    take(o, stage_input_values(
        slot_view, token_view, position_view, mask_view, tokens.count))
  }
  if o.code.len() == 0 {
    graph = ggml_ffi.graph_new(graph_ctx)
    galloc = ggml_ffi.gallocr_new(backend)
    if ggml_ffi.handle_absent(graph) || ggml_ffi.handle_absent(galloc) {
      fail(o, "R5_GGML_INIT", "graph")
    } else {
      o.graphs_created = o.graphs_created + 1
      o.gallocrs_created = o.gallocrs_created + 1
    }
  }
  mut activation_bytes := 0
  if o.code.len() == 0 {
    take(o, stage_graph(
        graph_ctx, graph, galloc, slot_view, node_table, oracle, "reserve", "alloc",
        activation_bytes))
    o.activation_bytes = activation_bytes
    o.build_ns = time.instant() - build_started
    o.node_count = ggml_ffi.graph_node_count(graph)
    o.slot_high_water = ggml_ffi.slots_high_water(slot_view)
  }
  if o.code.len() == 0 { stage_compute(backend, graph, o) }

  mut node_window: buffer := buffer(0)
  mut reference_window: buffer := buffer(0)
  mut readback := 0
  if o.code.len() == 0 {
    mut measure := 0
    loop {
      if measure >= oracle.count { break }
      span := ggml_ffi.slot_nbytes(slot_view, layer_qwen2.SLOT_NODE_BASE + oracle.node[measure])
      if span > readback { readback = span }
      measure = measure + 1
    }
    node_window = buffer(readback)
    reference_window = buffer(readback)
    fill_zero(node_window, readback)
    fill_zero(reference_window, readback)
    if node_window.bytes().len() != readback || reference_window.bytes().len() != readback {
      fail(o, "R4_WINDOW_UNAVAILABLE", "node_readback")
    }
  }
  node_view := node_window.bytes()
  reference_view := reference_window.bytes()
  if o.code.len() == 0 {
    match stage_digests(slot_view, oracle, node_table, node_view, nodes, o) {
      Ok(_) => {},
      Err(f) => { fault_into(o, f) },
    }
  }

  mut counters := alignpack_read.new_counters()
  if o.code.len() == 0 && o.reference_present {
    take_pack(o, compare_source(
        reference_path, members, layout, tokens, window_view, counters))
    o.reader_pread_count = o.reader_pread_count + counters.pread_count
    o.reader_bytes_read = o.reader_bytes_read + counters.bytes_read
  }
  if o.code.len() == 0 && o.reference_present {
    reference_ctx = ggml_ffi.context_open(context_bytes)
    reference_graph_ctx = ggml_ffi.context_open(context_bytes)
    if ggml_ffi.handle_absent(reference_ctx) || ggml_ffi.handle_absent(reference_graph_ctx) {
      fail(o, "R5_GGML_INIT", "reference_context")
    } else {
      o.contexts_created = o.contexts_created + 2
    }
    if o.code.len() == 0 {
      take(o, stage_reference_weights(
          reference_ctx, reference_slot_view, slot_view, window_view, table, members, layout,
          members.ggml_type, tokens.count, false))
    }
    if o.code.len() == 0 {
      reference_buffer = ggml_ffi.alloc_remaining(reference_ctx, backend)
      if ggml_ffi.handle_absent(reference_buffer) {
        fail(o, "R5_GGML_INIT", "reference_buffer")
      } else {
        o.ggml_buffers_created = o.ggml_buffers_created + 1
      }
    }
    if o.code.len() == 0 {
      take(o, stage_reference_weights(
          reference_ctx, reference_slot_view, slot_view, window_view, table, members, layout,
          members.ggml_type, tokens.count, true))
    }
    if o.code.len() == 0 {
      reference_graph = ggml_ffi.graph_new(reference_graph_ctx)
      reference_galloc = ggml_ffi.gallocr_new(backend)
      if ggml_ffi.handle_absent(reference_graph) || ggml_ffi.handle_absent(reference_galloc) {
        fail(o, "R5_GGML_INIT", "reference_graph")
      } else {
        o.graphs_created = o.graphs_created + 1
        o.gallocrs_created = o.gallocrs_created + 1
      }
    }
    mut reference_bytes := 0
    if o.code.len() == 0 {
      take(o, stage_graph(
          reference_graph_ctx, reference_graph, reference_galloc, reference_slot_view,
          node_table, oracle, "reference_reserve", "reference_alloc", reference_bytes))
    }
    if o.code.len() == 0 {
      reference_started := time.instant()
      status := ggml_ffi.graph_compute(backend, reference_graph)
      o.reference_compute_ns = time.instant() - reference_started
      if status != 0 { fail(o, "R5_COMPUTE", labelled("reference_status", status)) }
    }
    if o.code.len() == 0 {
      match stage_reference_compare(
        slot_view, reference_slot_view, oracle, node_view, reference_view, o) {
        Ok(_) => {},
        Err(f) => { fault_into(o, f) },
      }
    }
  }

  mut zero_flags: array_builder<i64> := array_builder()
  mut flag_at := 0
  loop {
    if flag_at >= oracle.count { break }
    zero_flags.push(0)
    flag_at = flag_at + 1
  }
  mut matched := zero_flags.build()
  if o.code.len() == 0 && o.transcript_present {
    match stage_oracle(
      transcript_path, slot_view, oracle, nodes, node_view, matched, o) {
      Ok(_) => {},
      Err(f) => { fault_into(o, f) },
    }
  }
  mut state_column: array_builder<i64> := array_builder()
  mut state_at := 0
  loop {
    if state_at >= oracle.count { break }
    if oracle.compared[state_at] == 0 {
      state_column.push(2)
    } else {
      state_column.push(if matched[state_at] == 1 { 1 } else { 0 })
    }
    state_at = state_at + 1
  }
  states = OracleStates { state: state_column.build() }

  stage_teardown(
    galloc, reference_galloc, graph_ctx, reference_graph_ctx, weight_buffer, weight_ctx,
    input_buffer, input_ctx, reference_buffer, reference_ctx, backend, o)
  finish(o, started)
  return o
}

// ---------------------------------------------------------------------------------------------
// The document (section 3.7)
// ---------------------------------------------------------------------------------------------

fn digest_at(borrow nodes: NodeColumns, index: i64) -> str {
  view: str := nodes.digests
  start := index * DIGEST_HEX_BYTES
  if start < 0 || start + DIGEST_HEX_BYTES > view.len() { return "" }
  return view[start..start + DIGEST_HEX_BYTES]
}

fn oracle_state_label(state: i64) -> str {
  if state == 1 { return "compared" }
  if state == 2 { return "shape_incomparable" }
  return "absent"
}

fn render_members(
  borrow members: MemberColumns,
  borrow layout: Layout,
  borrow reads: ReadColumns,
  borrow abi: AbiColumns,
  borrow placement: PlacementColumns,
  token_count: i64,
) -> string {
  d := builder()
  mut at := 0
  loop {
    if at >= members.count { break }
    if at > 0 { d.write(",") }
    d.write("{\"role\":")
    d.write(json_string(member_label_at(members, at)))
    d.write(",\"role_id\":")
    d.write_int(column_at(members.role, at))
    d.write(",\"ggml_type\":")
    d.write_int(column_at(members.ggml_type, at))
    d.write(",\"ne0\":")
    d.write_int(column_at(members.ne0, at))
    d.write(",\"ne1\":")
    // The dims of the tensor R5A **built**, which for `token_embd` is the row-gathered window and
    // not the container's `n_vocab` (section 3.7).
    d.write_int(if at == 0 { token_count } else { column_at(members.ne1, at) })
    d.write(",\"nbytes\":")
    d.write_int(column_at(reads.read_bytes, at))
    d.write(",\"blck_size\":")
    d.write_int(column_at(abi.blck, at))
    d.write(",\"type_size\":")
    d.write_int(column_at(abi.type_size, at))
    d.write(",\"pack_offset\":")
    d.write_int(column_at(members.pack_offset, at))
    d.write(",\"window_offset\":")
    d.write_int(column_at(layout.window_offsets, at))
    d.write(",\"window_alignment\":")
    d.write_int(column_at(abi.window_alignment, at))
    d.write(",\"tensor_data_offset\":")
    d.write_int(if at < placement.data_offset.len() { placement.data_offset[at] } else { -1 })
    d.write(",\"pointer_identity\":")
    d.write(bool_text(column_at(placement.identity, at) == 1))
    d.write(",\"read_bytes\":")
    d.write_int(column_at(reads.read_bytes, at))
    d.write(",\"pread_count\":")
    d.write_int(column_at(reads.pread_count, at))
    d.write("}")
    at = at + 1
  }
  return d.to_string()
}

fn render_nodes(
  borrow nodes: NodeColumns,
  borrow states: OracleStates,
  borrow oracle: layer_qwen2.OracleTable,
) -> string {
  d := builder()
  mut at := 0
  loop {
    if at >= nodes.count { break }
    if at > 0 { d.write(",") }
    d.write("{\"id\":")
    d.write(json_string(layer_qwen2.oracle_id(oracle, at)))
    d.write(",\"op\":")
    d.write(json_string(op_label(column_at(nodes.op, at))))
    d.write(",\"transcript_name\":")
    d.write(json_string(layer_qwen2.oracle_name(oracle, at)))
    d.write(",\"transcript_op\":")
    d.write(json_string(layer_qwen2.oracle_op(oracle, at)))
    d.write(",\"ne0\":")
    d.write_int(column_at(nodes.ne0, at))
    d.write(",\"ne1\":")
    d.write_int(column_at(nodes.ne1, at))
    d.write(",\"ne2\":")
    d.write_int(column_at(nodes.ne2, at))
    d.write(",\"ne3\":")
    d.write_int(column_at(nodes.ne3, at))
    d.write(",\"element_count\":")
    d.write_int(column_at(nodes.elements, at))
    d.write(",\"sha256\":")
    d.write(json_string(digest_at(nodes, at)))
    d.write(",\"bit_sum\":")
    d.write_int(column_at(nodes.bit_sum, at))
    d.write(",\"f32_sum_millionths\":")
    d.write_int(column_at(nodes.sum_millionths, at))
    d.write(",\"nonfinite_count\":")
    d.write_int(column_at(nodes.nonfinite, at))
    d.write(",\"oracle\":")
    d.write(json_string(oracle_state_label(column_at(states.state, at))))
    d.write("}")
    at = at + 1
  }
  return d.to_string()
}

pub fn render(
  borrow o: Outcome,
  pack_path: str,
  geometry_path: str,
  reference_path: str,
  transcript_path: str,
  borrow tokens: TokenColumns,
  borrow members_json: string,
  borrow nodes_json: string,
) -> string {
  failed := o.code.len() > 0
  code_view: str := o.code
  detail_view: str := o.detail
  arch_view: str := o.arch
  backend_view: str := o.backend_name
  sha_view: str := o.sha256
  reference_node_view: str := o.reference_first_node
  worst_node_view: str := o.oracle_worst_node
  members_view: str := members_json
  nodes_view: str := nodes_json

  d := builder()
  d.write("{\"schema_version\":")
  d.write_int(SCHEMA_VERSION)
  d.write(",\"kind\":")
  d.write(json_string(DOCUMENT_KIND))
  d.write(",\"pack_path\":")
  d.write(json_string(pack_path))
  d.write(",\"geometry_path\":")
  d.write(json_string(geometry_path))
  d.write(",\"reference_path\":")
  d.write(json_string(reference_path))
  d.write(",\"transcript_path\":")
  d.write(json_string(transcript_path))
  d.write(",\"status\":")
  d.write(json_string(if failed { "error" } else { "ok" }))
  d.write(",\"error_code\":")
  d.write(json_string(code_view))
  d.write(",\"error_detail\":")
  d.write(json_string(detail_view))
  d.write(",\"verdict\":")
  d.write(json_string(verdict_label(o.verdict)))

  d.write(",\"pack\":{\"format_version\":")
  d.write_int(o.format_version)
  d.write(",\"block_align\":")
  d.write_int(o.block_align)
  d.write(",\"member_align\":")
  d.write_int(o.member_align)
  d.write(",\"block_count\":")
  d.write_int(o.block_count)
  d.write(",\"member_count\":")
  d.write_int(o.member_count)
  d.write(",\"total_bytes\":")
  d.write_int(o.total_bytes)
  d.write(",\"payload_offset\":")
  d.write_int(o.payload_offset)
  d.write(",\"reader_pread_count\":")
  d.write_int(o.reader_pread_count)
  d.write(",\"reader_bytes_read\":")
  d.write_int(o.reader_bytes_read)

  d.write("},\"model\":{\"arch\":")
  d.write(json_string(arch_view))
  d.write(",\"n_layer\":")
  d.write_int(o.n_layer)
  d.write(",\"n_embd\":")
  d.write_int(o.n_embd)
  d.write(",\"n_head\":")
  d.write_int(o.n_head)
  d.write(",\"n_head_kv\":")
  d.write_int(o.n_head_kv)
  d.write(",\"head_dim\":")
  d.write_int(o.head_dim)
  d.write(",\"n_ff\":")
  d.write_int(o.n_ff)
  d.write(",\"n_vocab\":")
  d.write_int(o.n_vocab)
  d.write(",\"context_length\":")
  d.write_int(o.context_length)
  d.write(",\"rms_eps_bits\":")
  d.write_int(o.rms_eps_bits)
  d.write(",\"rope_type\":")
  d.write_int(o.rope_type)
  d.write(",\"rope_dim_count\":")
  d.write_int(o.rope_dim_count)
  d.write(",\"rope_freq_base_bits\":")
  d.write_int(o.rope_freq_base_bits)
  d.write(",\"attn_scale_bits\":")
  d.write_int(o.attn_scale_bits)

  d.write("},\"selection\":{\"layer\":")
  d.write_int(o.layer)
  d.write(",\"embedding_block_index\":")
  d.write_int(o.embedding_block_index)
  d.write(",\"attention_block_index\":")
  d.write_int(o.attention_block_index)
  d.write(",\"mlp_block_index\":")
  d.write_int(o.mlp_block_index)
  d.write(",\"token_count\":")
  d.write_int(o.token_count)
  d.write(",\"tokens\":[")
  mut token_at := 0
  loop {
    if token_at >= tokens.ids.len() { break }
    if token_at > 0 { d.write(",") }
    d.write_int(tokens.ids[token_at])
    token_at = token_at + 1
  }

  d.write("]},\"members\":[")
  d.write(members_view)

  d.write("],\"graph\":{\"node_count\":")
  d.write_int(o.node_count)
  d.write(",\"slot_capacity\":")
  d.write_int(o.slot_capacity)
  d.write(",\"slot_high_water\":")
  d.write_int(o.slot_high_water)
  d.write(",\"weight_bytes\":")
  d.write_int(o.weight_bytes)
  d.write(",\"activation_bytes\":")
  d.write_int(o.activation_bytes)
  d.write(",\"context_bytes\":")
  d.write_int(o.graph_context_bytes)
  d.write(",\"backend_name\":")
  d.write(json_string(backend_view))
  d.write(",\"compute_status\":")
  d.write_int(o.compute_status)

  d.write("},\"nodes\":[")
  d.write(nodes_view)

  d.write("],\"output\":{\"sha256\":")
  d.write(json_string(sha_view))
  d.write(",\"bit_sum\":")
  d.write_int(o.bit_sum)
  d.write(",\"element_count\":")
  d.write_int(o.element_count)
  d.write(",\"nonfinite_count\":")
  d.write_int(o.nonfinite_count)

  d.write("},\"reference\":{\"present\":")
  d.write(bool_text(o.reference_present))
  d.write(",\"verdict\":")
  d.write(json_string(reference_label(o.reference_verdict)))
  d.write(",\"nodes_compared\":")
  d.write_int(o.reference_compared)
  d.write(",\"nodes_identical\":")
  d.write_int(o.reference_identical)
  d.write(",\"first_difference_node\":")
  d.write(json_string(reference_node_view))
  d.write(",\"first_difference_index\":")
  d.write_int(o.reference_first_index)
  d.write(",\"first_difference_primary_bits\":")
  d.write_int(o.reference_first_primary_bits)
  d.write(",\"first_difference_reference_bits\":")
  d.write_int(o.reference_first_reference_bits)

  d.write("},\"oracle\":{\"present\":")
  d.write(bool_text(o.transcript_present))
  d.write(",\"verdict\":")
  d.write(json_string(oracle_label(o.oracle_verdict)))
  d.write(",\"instrument\":")
  d.write(json_string("llama-eval-callback"))
  d.write(",\"nodes_expected\":")
  d.write_int(o.oracle_expected)
  d.write(",\"nodes_matched\":")
  d.write_int(o.oracle_matched)
  d.write(",\"elements_compared\":")
  d.write_int(o.oracle_elements)
  d.write(",\"max_abs_diff_ten_thousandths\":")
  d.write_int(o.oracle_max_abs)
  d.write(",\"max_sum_diff_millionths\":")
  d.write_int(o.oracle_max_sum)
  d.write(",\"tolerance_ten_thousandths\":")
  d.write_int(TOLERANCE_TEN_THOUSANDTHS)
  d.write(",\"sum_tolerance_millionths\":")
  d.write_int(SUM_TOLERANCE_MILLIONTHS)
  d.write(",\"sum_tolerance_relative_ppm\":")
  d.write_int(SUM_TOLERANCE_RELATIVE_PPM)
  d.write(",\"worst_node\":")
  d.write(json_string(worst_node_view))
  d.write(",\"worst_element_index\":")
  d.write_int(o.oracle_worst_element)
  d.write(",\"transcript_lines\":")
  d.write_int(o.oracle_lines)
  d.write(",\"transcript_callback_lines\":")
  d.write_int(o.oracle_callback_lines)

  d.write("},\"timings\":{\"pread_ns\":")
  d.write_int(o.pread_ns)
  d.write(",\"build_ns\":")
  d.write_int(o.build_ns)
  d.write(",\"reserve_ns\":")
  d.write_int(o.reserve_ns)
  d.write(",\"compute_ns\":")
  d.write_int(o.compute_ns)
  d.write(",\"reference_compute_ns\":")
  d.write_int(o.reference_compute_ns)
  d.write(",\"oracle_ns\":")
  d.write_int(o.oracle_ns)
  d.write(",\"elapsed_ns\":")
  d.write_int(o.elapsed_ns)

  d.write("},\"lifetime\":{\"ggml_buffers_created\":")
  d.write_int(o.ggml_buffers_created)
  d.write(",\"ggml_buffers_freed\":")
  d.write_int(o.ggml_buffers_freed)
  d.write(",\"contexts_created\":")
  d.write_int(o.contexts_created)
  d.write(",\"contexts_freed\":")
  d.write_int(o.contexts_freed)
  d.write(",\"backends_created\":")
  d.write_int(o.backends_created)
  d.write(",\"backends_freed\":")
  d.write_int(o.backends_freed)
  d.write(",\"graphs_created\":")
  d.write_int(o.graphs_created)
  d.write(",\"gallocrs_created\":")
  d.write_int(o.gallocrs_created)
  d.write(",\"gallocrs_freed\":")
  d.write_int(o.gallocrs_freed)
  d.write(",\"released_before_owner_scope_end\":")
  d.write(bool_text(o.released_before_owner_scope_end))

  d.write("},\"abi\":{\"tensor_alignment\":")
  d.write_int(o.tensor_alignment)
  d.write(",\"table_drift\":")
  d.write_int(o.table_drift)
  d.write(",\"slot_magic_ok\":")
  d.write(bool_text(o.slot_magic_ok))
  d.write(",\"fp_contract_off\":")
  d.write(bool_text(o.fp_contract_off))
  d.write(",\"graph_context_bytes\":")
  d.write_int(o.graph_context_bytes)
  d.write("}}")
  return d.to_string()
}

// Section 3.3's stable summary block, read positionally, printed only in the six-, seven-, and
// eight-operand forms. The JSON document remains the authoritative result.
fn print_summary(borrow o: Outcome, borrow tokens: TokenColumns, pack_path: str) {
  failed := o.code.len() > 0
  print("layer forward:")
  print("status:")
  if failed { print("ERROR") } else { print("OK") }
  print("verdict:")
  print(verdict_label(o.verdict))
  print("pack path:")
  sanitized_path := sanitize_summary_line(pack_path)
  sanitized_path_view: str := sanitized_path
  print(sanitized_path_view)
  print("schema:")
  print(SCHEMA_VERSION)
  print("arch:")
  arch_view: str := o.arch
  sanitized_arch := sanitize_summary_line(arch_view)
  sanitized_arch_view: str := sanitized_arch
  print(sanitized_arch_view)
  print("layer:")
  print(o.layer)
  print("tokens:")
  ids := builder()
  mut token_at := 0
  loop {
    if token_at >= tokens.ids.len() { break }
    if token_at > 0 { ids.write(",") }
    ids.write_int(tokens.ids[token_at])
    token_at = token_at + 1
  }
  rendered_ids := ids.to_string()
  rendered_ids_view: str := rendered_ids
  print(rendered_ids_view)
  print("weight bytes:")
  print(o.weight_bytes)
  print("activation bytes:")
  print(o.activation_bytes)
  print("graph nodes:")
  print(o.node_count)
  print("backend:")
  backend_view: str := o.backend_name
  sanitized_backend := sanitize_summary_line(backend_view)
  sanitized_backend_view: str := sanitized_backend
  print(sanitized_backend_view)
  print("pread ns:")
  print(o.pread_ns)
  print("build ns:")
  print(o.build_ns)
  print("compute ns:")
  print(o.compute_ns)
  print("l_out sha256:")
  sha_view: str := o.sha256
  print(sha_view)
  print("l_out bit sum:")
  print(o.bit_sum)
  print("reference:")
  print(reference_label(o.reference_verdict))
  print("reference nodes:")
  if o.reference_present {
    pair := builder()
    pair.write_int(o.reference_identical)
    pair.write("/")
    pair.write_int(o.reference_compared)
    rendered_pair := pair.to_string()
    rendered_pair_view: str := rendered_pair
    print(rendered_pair_view)
  } else {
    print("-")
  }
  print("transcript:")
  print(oracle_label(o.oracle_verdict))
  print("transcript nodes:")
  if o.transcript_present {
    pair := builder()
    pair.write_int(o.oracle_matched)
    pair.write("/")
    pair.write_int(o.oracle_expected)
    rendered_pair := pair.to_string()
    rendered_pair_view: str := rendered_pair
    print(rendered_pair_view)
  } else {
    print("-")
  }
  print("max abs diff:")
  print(o.oracle_max_abs)
  print("max sum diff:")
  print(o.oracle_max_sum)
  print("released:")
  print(o.ggml_buffers_freed + o.contexts_freed + o.backends_freed + o.gallocrs_freed)
  if failed {
    print("error:")
    code_view: str := o.code
    print(code_view)
    print("detail:")
    detail_view: str := o.detail
    sanitized_detail := sanitize_summary_line(detail_view)
    sanitized_detail_view: str := sanitized_detail
    print(sanitized_detail_view)
  }
}

// Section 3.3's CLI adapter. Arity and every path operand are checked before any file work, so an
// arity or path failure produces no output and no file — the two codes section 3.8 marks `N/A` for
// a detail, because no document exists to carry one.
pub fn run(args: array<str>) -> Result<(), Error> {
  if args.len() < 6 || args.len() > 9 {
    return Err(Error.Invalid)
  }
  if !valid_path(args[2]) || !valid_path(args[4]) {
    return Err(Error.Invalid)
  }
  if args.len() >= 7 && args[6] != "-" && !valid_path(args[6]) {
    return Err(Error.Invalid)
  }
  if args.len() >= 8 && !valid_path(args[7]) {
    return Err(Error.Invalid)
  }
  if args.len() == 9 && !valid_path(args[8]) {
    return Err(Error.Invalid)
  }
  reference_path := if args.len() >= 8 { args[7] } else { "" }
  transcript_path := if args.len() == 9 { args[8] } else { "" }
  mut tokens := empty_tokens()
  mut members := empty_members()
  mut layout := empty_layout()
  mut reads := empty_reads()
  mut abi := empty_abi()
  mut placement := empty_placement()
  mut nodes := empty_nodes()
  mut states := empty_states()
  outcome := execute(
    args[2], args[3], args[4], args[5], reference_path, transcript_path,
    tokens, members, layout, reads, abi, placement, nodes, states)
  oracle := layer_qwen2.oracle_table(if outcome.layer >= 0 { outcome.layer } else { 0 })
  members_json := render_members(members, layout, reads, abi, placement, tokens.count)
  nodes_json := render_nodes(nodes, states, oracle)
  document := render(
    outcome, args[2], args[4], reference_path, transcript_path, tokens, members_json, nodes_json)
  document_view: str := document
  if args.len() == 6 || args[6] == "-" {
    print(document_view)
  } else {
    fs.write_file(args[6], document_view)?
    print_summary(outcome, tokens, args[2])
  }
  if outcome.code.len() > 0 {
    return Err(Error.Invalid)
  }
  return Ok(())
}
