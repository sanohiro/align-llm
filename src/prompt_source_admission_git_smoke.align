module prompt_source_admission_git_smoke

import prompt_artifacts
import prompt_source_admission_git
import prompt_git_metadata
import prompt_tool_image
import prompt_scope_cleanup
import std.fs
import std.process
import std.time

fn image(path: str, digest: str) -> Result<process.image, Error> {
  root := fs.open_directory(path)?
  return prompt_tool_image.admit(root, "git".bytes(), digest, 268435456, time.instant() + 10000000000)
}

fn rows(first: str, last: str, empty: bool) -> array<prompt_artifacts.ArtifactDigest> {
  mut output: array_builder<prompt_artifacts.ArtifactDigest> := array_builder()
  if !empty {
    output.push(prompt_artifacts.ArtifactDigest { path: "a".clone(), mode: "100644".clone(), byte_count: 3, sha256: first.clone() })
    output.push(prompt_artifacts.ArtifactDigest { path: "two".clone(), mode: "100644".clone(), byte_count: 2, sha256: last.clone() })
  }
  return output.build()
}

fn inspect(result: Result<prompt_source_admission_git.Readout, Error>, expected: str) -> Result<(), Error> {
  match result {
    Err(error) => {
      if expected == "expired" { if !match error { Timeout => true, _ => false } { return Err(error) } } else if expected != "invalid" { return Err(error) } else if !match error { Invalid => true, _ => false } { return Err(error) }
    },
    Ok(value) => match value {
      Ready => { if expected != "ready" && expected != "empty" { return Err(Error.Invalid) } },
      Cancelled(_) => { if expected != "cancel" && expected != "pre-cancel-empty" { return Err(Error.Invalid) } },
      Stopped(attempt) => {
        mut scope := attempt.scope
        cleanup := prompt_scope_cleanup.run(scope, time.instant() + 10000000000, 32768, 8192)?
        if !cleanup.released { return Err(Error.Timeout) }
        match cleanup.first_error { None => {}, Some(error) => { return Err(error) } }
        if expected != "stopped" && expected != "timeout" && expected != "cancel" { return Err(Error.Invalid) }
        match attempt.report {
          None => { return Err(Error.Invalid) },
          Some(report) => {
            if !report.cleanup.released { return Err(Error.Invalid) }
            if expected == "timeout" && !match report.stop { Timeout => true, _ => false } { return Err(Error.Invalid) }
            if expected == "cancel" && !match report.stop { Cancelled(_) => true, _ => false } { return Err(Error.Invalid) }
          },
        }
      },
    },
  }
  print(expected)
  return Ok(())
}

pub fn main(args: array<str>) -> Result<(), Error> {
  if args.len() != 10 { return Err(Error.Invalid) }
  executable := match image(args[2], args[3]) {
    Ok(value) => value,
    Err(error) => { if args[1] == "Darwin" && match error { Code(code) => code == 45, _ => false } { print("source admission Git: Darwin executable memory ENOTSUP 45"); return Ok(()) }; return Err(error) },
  }
  project := fs.open_directory(args[4])?
  metadata := prompt_git_metadata.admit(args[5], time.instant() + 10000000000)?
  procfs := fs.open_directory("/proc")?
  mut signals := process.signals(process.signal_set { hangup: false, interrupt: true, quit: false, terminate: true })?
  selected := rows(args[7], args[8], args[9] == "empty" || args[9] == "pre-cancel-empty")
  if args[9] == "pre-cancel-empty" {
    sender := process.command("/bin/sh", ["/bin/sh", "-c", "kill -TERM \"$PPID\""])
    outcome := sender.run()?
    status := outcome.status()
    if !match status.termination { Exited(code) => code == 0, _ => false } { return Err(Error.Invalid) }
  }
  deadline := if args[9] == "expired" { 0 } else { time.instant() + if args[9] == "timeout" { 300000000 } else { 10000000000 } }
  result := prompt_source_admission_git.run(project, metadata, executable, args[6], selected, signals, procfs, deadline)
  checked := inspect(result, args[9])
  signals.close()?
  checked?
  return Ok(())
}
