module layer_olmoe

import core.json

// R5D-MOE-LAYER-FORWARD (`docs/specs/r5d-moe-layer-forward.md` section 3.5). The OLMoE **routed**
// layer as data: two node tables, the member-role and claim-role tables, the shape rules, the
// scalar derivations, the oracle table, and the routing decision. It contains no `extern`
// declaration, no `unsafe` block, no handle, and no file, and `scripts/run-layer-forward-smoke`
// asserts the first two by scanning `src/` and finding only `src/ggml_ffi.align`.
//
// It is a **second module beside `src/layer_qwen2.align`, not a widening of it** (section 3.1).
// That module's `parse_geometry` refuses `n_expert != 0` and `arch != "qwen2"` by design and its
// `Geometry` record has no `n_expert_used` and no `n_ff_exp`; the two architectures' attention
// halves differ — OLMoE has a QK-norm and no QKV biases, Qwen2 has biases and no QK-norm — so one
// module owning both would be the "second architecture is a second module behind the same
// node-table shape" that `r5a-dense-layer-forward.md` section 1.3 already named.
//
// **The two node tables are the design.** One loop in `src/moe_layer_forward.align` walks each and
// issues one shim call per row. Three of this file's orderings are normative and were each chosen
// after a probe refuted the plan:
//
//   * the QK-norm is an RMS norm over `ne[0] == n_embd` applied **before** the head reshape, not a
//     per-head norm (section 2.2 fact 1). A table that reshapes first type-checks, runs, and is
//     wrong;
//   * the router is a 64-way softmax with **no renormalization** and its top-k is an `ARGSORT`
//     plus a slice taken in Align, never `ggml_top_k`, whose own header says its indices are in no
//     particular order (section 2.2 facts 2 and 3);
//   * the expert reduction's eight views and seven adds are in **ascending slot order**. Section
//     2.3 measured a reversed order changing 1,189 of 2,048 elements of one token's `ffn_moe_out`.
//     The table encodes the order; no loop direction is free to choose it.

// ---------------------------------------------------------------------------------------------
// Slots, ops, and the bounds
// ---------------------------------------------------------------------------------------------

// R5A's store, unchanged in representation and in capacity. The two phases share it and occupy
// **disjoint** ranges, so phase A's nodes stay readable while phase B is built and the published
// high-water mark is the whole run's.
pub MAX_NODE_SLOTS := 128
pub SLOT_HEADER_BYTES := 16
pub SLOT_BYTES := 8

// Phase A: ten dense members in slot order, three inputs, thirty-one nodes.
pub MEMBER_COUNT := 10
pub SLOT_TOKENS := 10
pub SLOT_POS := 11
pub SLOT_MASK := 12
pub A_NODE_BASE := 13
pub A_NODE_COUNT := 31

// Phase B: the three compact expert stacks, the five carried values, and `2 * n_expert_used + 8`
// nodes. `A_NODE_BASE + A_NODE_COUNT == SLOT_GATE` by construction.
pub SLOT_GATE := 44
pub SLOT_UP := 45
pub SLOT_DOWN := 46
pub SLOT_FFN_NORM := 47
pub SLOT_FFN_INP := 48
pub SLOT_PROBS := 49
pub SLOT_TOPK := 50
pub SLOT_COMPACT := 51
pub B_NODE_BASE := 52
pub CLAIM_ROLE_COUNT := 3

// Section 3.3's prefill cap, raised from 6 to 32 by `docs/specs/r6-olmoe-decode.md` section 3.8 so
// that oracle C′ can run `--moe-model-forward` at `TOKENS,d_1..d_k` — `T + k` tokens, 22 of them at
// the qualification's `T <= 6` and `N = 16`. It is now the value `layer_qwen2.MAX_PREFILL_TOKENS`
// held at that checkpoint, so two architectures no longer carried two caps for one reason.
//
// **The cap's original reason survives and is not weakened.** R5A section 3.3's reason is the
// *oracle's*, not the arithmetic's: `llama-eval-callback` prints every row of an axis only while
// its extent is `<= 6`, and an oracle that compares fewer elements as the input grows while still
// reporting `PASS` is worse than one that refuses. That refusal is `R5_ORACLE_TRUNCATED`, raised
// against `TRUNCATION_PRINTED` (6) whenever a transcript is present, and it is byte-unchanged.
// R6-PREFIX-TTFT (`docs/specs/r6-prefix-ttft.md`) raises the arithmetic cap from 32 to **2048** for
// the same frozen shared-prefix consumer as Qwen2. The range 7..2048 is open for arithmetic and
// closed for comparison, at 2048 exactly as it was at 32.
pub MAX_PREFILL_TOKENS := 2048

// Section 3.4's ceiling on the routed union's three windows, checked at step 26 **after** the
// routing decision, because `U` does not exist before it.
pub MAX_CLAIM_WINDOW_BYTES := 8589934592

pub OP_GET_ROWS := 1
pub OP_RMS_NORM := 2
pub OP_MUL := 3
pub OP_ADD := 4
pub OP_MUL_MAT := 5
pub OP_RESHAPE_3D := 6
pub OP_PERMUTE := 7
pub OP_CONT_3D := 8
pub OP_ROPE := 9
pub OP_SOFT_MAX := 10
pub OP_SWIGLU := 11
// R5D's three new ops. `OP_VIEW_2D`'s two dimension parameters are axis **selectors**, never byte
// counts: section 3.5 keeps stride arithmetic on the C side so Align cannot forge an offset.
pub OP_ARGSORT := 12
pub OP_MUL_MAT_ID := 13
pub OP_VIEW_2D := 14

// `src/alignpack.align`'s frozen `role_id` list, the thirteen entries this layer needs. Members are
// located by `role_id` and never by name string and never by position.
pub ROLE_ATTN_NORM := 0
pub ROLE_ATTN_Q := 1
pub ROLE_ATTN_K := 3
pub ROLE_ATTN_V := 5
pub ROLE_ATTN_OUTPUT := 7
pub ROLE_FFN_NORM := 8
pub ROLE_TOKEN_EMBD := 12
pub ROLE_ROUTER := 17
pub ROLE_FFN_GATE_EXPS := 19
pub ROLE_FFN_UP_EXPS := 21
pub ROLE_FFN_DOWN_EXPS := 23
pub ROLE_ATTN_Q_NORM := 27
pub ROLE_ATTN_K_NORM := 28

// `src/model_ir.align`'s block-kind encoding, unchanged. R5D invents no kind of its own.
pub KIND_WEIGHT := 0
pub KIND_EXPERT := 3
pub KIND_ROUTER := 4
pub KIND_ATTENTION := 1

pub GGML_TYPE_F32 := 0

// The `-inf` an f32 causal mask is made of, as a bit pattern: the mask is written from bit patterns
// rather than float arithmetic, so nothing here depends on Align's rendering of infinity.
pub MASK_NEG_INFINITY_BITS := 4286578688
pub MASK_ZERO_BITS := 0

pub ROPE_TYPE_NEOX := 2
pub MAX_BIAS_BITS := 0
// `1.0f`, the router softmax's scale. The gate is a plain `ggml_soft_max`, which is
// `ggml_soft_max_ext(ctx, a, NULL, 1.0f, 0.0f)` (section 2.2 fact 2).
pub UNIT_SCALE_BITS := 1065353216

// The geometry document this module consumes: the shipped `R1_MODEL_IR` at `schema_version: 2`,
// the same pair `src/layer_qwen2.align` declares.
pub GEOMETRY_KIND := "R1_MODEL_IR"
pub GEOMETRY_SCHEMA_VERSION := 2

// The four oracle classes of section 3.6, published verbatim in `nodes[].oracle` so every exclusion
// is a document field rather than a silent gap. `ORACLE_ABSENT` is the arm's, for a compared row
// the transcript did not carry.
pub ORACLE_ABSENT := 0
pub ORACLE_COMPARED := 1
pub ORACLE_SHAPE_INCOMPARABLE := 2
pub ORACLE_AMBIGUOUS_NAME := 3
pub ORACLE_UNSTABLE_NAME := 4

// The twenty-six nodes section 3.6 compares. It is a constant rather than a count of the table,
// because a table edit that silently dropped a compared row must be a failing number and not a
// smaller expectation.
pub ORACLE_COMPARED_COUNT := 26

// Rows 0 to 29 of the oracle table do not depend on `n_expert_used`; the reduction chain does.
ORACLE_FIXED_ROWS := 30

// ---------------------------------------------------------------------------------------------
// The geometry
// ---------------------------------------------------------------------------------------------

pub Geometry {
  code: string,
  detail: string,
  arch: string,
  n_layer: i64,
  n_embd: i64,
  n_head: i64,
  n_head_kv: i64,
  head_dim: i64,
  n_ff_exp: i64,
  n_vocab: i64,
  n_expert: i64,
  n_expert_used: i64,
  context_length: i64,
  rms_eps_bits: i64,
  rope_type: i64,
  rope_dim_count: i64,
  rope_freq_base_bits: i64,
  attn_scale_bits: i64,
}

pub fn empty_geometry() -> Geometry = Geometry {
  code: "".clone(),
  detail: "".clone(),
  arch: "".clone(),
  n_layer: 0,
  n_embd: 0,
  n_head: 0,
  n_head_kv: 0,
  head_dim: 0,
  n_ff_exp: 0,
  n_vocab: 0,
  n_expert: 0,
  n_expert_used: 0,
  context_length: 0,
  rms_eps_bits: -1,
  rope_type: -1,
  rope_dim_count: 0,
  rope_freq_base_bits: -1,
  attn_scale_bits: 0,
}

// `1/sqrt(head_dim)` as a bit pattern, derived in Align and never rendered as a float. Section 3.2
// records that this model's value is `3db504f3`, the same as R5A's, because both have `head_dim`
// 128.
pub fn attn_scale_bits(head_dim: i64) -> i64 {
  if head_dim <= 0 { return 0 }
  mut window: buffer := buffer(4)
  scale: f32 := (1.0 as f32) / ((head_dim as f32).sqrt())
  window.put_f32_le(scale)
  view := window.bytes()
  if view.len() < 4 { return 0 }
  return view.u32_le(0) as i64
}

// Eight lowercase hexadecimal digits to the `u32` they name, or `-1`.
fn parse_bits32(text: str) -> i64 {
  view := text.bytes()
  if view.len() != 8 { return -1 }
  mut value := 0
  mut at := 0
  loop {
    if at >= 8 { break }
    byte := view.u8(at) as i64
    mut digit := -1
    if byte >= 48 && byte <= 57 { digit = byte - 48 }
    if byte >= 97 && byte <= 102 { digit = byte - 87 }
    if digit < 0 { return -1 }
    value = value * 16 + digit
    at = at + 1
  }
  return value
}

// `true` only for a finite, non-negative float. `rms_eps_bits` reaches `ggml_rms_norm`, which
// asserts `eps >= 0.0f` inside ggml, and `GGML_ASSERT` is `abort()`: a geometry carrying `7fc00000`
// or `ff800000` is a legal eight-hex-digit string that would take the process down with no
// document. R5A section 6 correction C17's rule, re-raised here because the pattern reaches the
// same kernel.
fn bits32_finite_nonnegative(bits: i64) -> bool {
  if bits < 0 { return false }
  if bits >= 2147483648 { return false }
  exponent := (bits / 8388608) % 256
  if exponent == 255 { return false }
  return true
}

fn geometry_fault(borrow mut g: Geometry, detail: str) {
  if g.code.len() == 0 {
    g.code = "R5_GEOMETRY".clone()
    g.detail = detail.clone()
  }
}

// Section 3.8 steps 5 to 8, in order, first applicable row wins. Every consumed field is required:
// there is no default and no fallback, because a geometry that silently assumed `n_expert_used`
// would route a different number of experts and still report `PASS`.
pub fn parse_geometry(text: str) -> Geometry {
  mut g := empty_geometry()
  mut parsed := false
  arena {
    match json.doc(text) {
      Ok(d) => {
        parsed = true
        match d.get("kind").as_str() {
          Some(value) => {
            if value != GEOMETRY_KIND { geometry_fault(g, "kind") }
          },
          None => { geometry_fault(g, "kind") },
        }
        match d.get("schema_version").as_i64() {
          Some(value) => {
            if value != GEOMETRY_SCHEMA_VERSION { geometry_fault(g, "schema_version") }
          },
          None => { geometry_fault(g, "schema_version") },
        }
        model := d.get("model")
        match model.get("arch").as_str() {
          Some(value) => { g.arch = value.clone() },
          None => { geometry_fault(g, "arch") },
        }
        match model.get("n_layer").as_i64() {
          Some(value) => { g.n_layer = value },
          None => { geometry_fault(g, "n_layer") },
        }
        match model.get("n_embd").as_i64() {
          Some(value) => { g.n_embd = value },
          None => { geometry_fault(g, "n_embd") },
        }
        match model.get("n_head").as_i64() {
          Some(value) => { g.n_head = value },
          None => { geometry_fault(g, "n_head") },
        }
        match model.get("n_head_kv").as_i64() {
          Some(value) => { g.n_head_kv = value },
          None => { geometry_fault(g, "n_head_kv") },
        }
        match model.get("head_dim").as_i64() {
          Some(value) => { g.head_dim = value },
          None => { geometry_fault(g, "head_dim") },
        }
        // The two fields R5A's consumer never reads and R5D cannot run without: `n_ff_exp` is the
        // expert planes' inner width and `n_expert_used` is the slot count of every MoE tensor.
        match model.get("n_ff_exp").as_i64() {
          Some(value) => { g.n_ff_exp = value },
          None => { geometry_fault(g, "n_ff_exp") },
        }
        match model.get("n_vocab").as_i64() {
          Some(value) => { g.n_vocab = value },
          None => { geometry_fault(g, "n_vocab") },
        }
        match model.get("n_expert").as_i64() {
          Some(value) => { g.n_expert = value },
          None => { geometry_fault(g, "n_expert") },
        }
        match model.get("n_expert_used").as_i64() {
          Some(value) => { g.n_expert_used = value },
          None => { geometry_fault(g, "n_expert_used") },
        }
        match model.get("context_length").as_i64() {
          Some(value) => { g.context_length = value },
          None => { geometry_fault(g, "context_length") },
        }
        match model.get("rms_eps_bits").as_str() {
          Some(value) => { g.rms_eps_bits = parse_bits32(value) },
          None => { geometry_fault(g, "rms_eps_bits") },
        }
        rope := model.get("rope")
        match rope.get("type").as_i64() {
          Some(value) => { g.rope_type = value },
          None => { geometry_fault(g, "rope.type") },
        }
        match rope.get("dim_count").as_i64() {
          Some(value) => { g.rope_dim_count = value },
          None => { geometry_fault(g, "rope.dim_count") },
        }
        match rope.get("freq_base_bits").as_str() {
          Some(value) => { g.rope_freq_base_bits = parse_bits32(value) },
          None => { geometry_fault(g, "rope.freq_base_bits") },
        }
        // Section 3.2's five fixed RoPE constants are only correct for a model that declares no
        // scaling, so the precondition is checked rather than assumed.
        match rope.get("scaling_type").kind() {
          Null => {},
          _ => { geometry_fault(g, "rope.scaling_type") },
        }
      },
      Err(_) => {},
    }
  }
  if !parsed {
    geometry_fault(g, "json")
    return g
  }
  if g.code.len() > 0 { return g }
  if g.rms_eps_bits < 0 { geometry_fault(g, "rms_eps_bits") }
  if g.rope_freq_base_bits < 0 { geometry_fault(g, "rope.freq_base_bits") }
  if g.code.len() > 0 { return g }
  if !bits32_finite_nonnegative(g.rms_eps_bits) { geometry_fault(g, "rms_eps_bits") }
  if !bits32_finite_nonnegative(g.rope_freq_base_bits) {
    geometry_fault(g, "rope.freq_base_bits")
  }
  if g.rope_freq_base_bits == 0 { geometry_fault(g, "rope.freq_base_bits") }
  if g.code.len() > 0 { return g }

  // Step 7's ranges.
  if g.n_layer < 1 { geometry_fault(g, "n_layer") }
  if g.n_embd < 1 { geometry_fault(g, "n_embd") }
  if g.n_head < 1 { geometry_fault(g, "n_head") }
  if g.n_head_kv < 1 { geometry_fault(g, "n_head_kv") }
  if g.head_dim < 1 { geometry_fault(g, "head_dim") }
  if g.n_ff_exp < 1 { geometry_fault(g, "n_ff_exp") }
  if g.n_vocab < 1 { geometry_fault(g, "n_vocab") }
  if g.n_expert < 1 { geometry_fault(g, "n_expert") }
  if g.context_length < 1 { geometry_fault(g, "context_length") }
  if g.code.len() > 0 { return g }
  // Step 7's self-consistency. OLMoE is MHA, so `n_head == n_head_kv` is an equality and not the
  // divisibility a grouped-query model would need.
  if g.n_embd != g.n_head * g.head_dim { geometry_fault(g, "n_embd==n_head*head_dim") }
  if g.n_head != g.n_head_kv { geometry_fault(g, "n_head==n_head_kv") }
  if g.n_expert_used < 1 || g.n_expert_used > g.n_expert {
    geometry_fault(g, "n_expert_used")
  }
  if g.code.len() > 0 { return g }
  // Section 6, correction C1. The phase-B table is `2 * n_expert_used + 8` rows long, so a
  // geometry whose slot count exceeds what the store can hold is refused **here**, naming the
  // field, rather than reaching the node walk and reporting `R5_SLOT` on a row that is not at
  // fault. The bound is the store's, not an invented ceiling.
  if B_NODE_BASE + b_node_count(g.n_expert_used) > MAX_NODE_SLOTS {
    geometry_fault(g, "n_expert_used")
  }
  if g.code.len() > 0 { return g }
  // Step 8's architecture preconditions. This step is what earns section 3.2's five fixed RoPE
  // constants.
  arch_view: str := g.arch
  if arch_view != "olmoe" { geometry_fault(g, "arch") }
  if g.rope_type != ROPE_TYPE_NEOX { geometry_fault(g, "rope.type") }
  if g.rope_dim_count != g.head_dim { geometry_fault(g, "rope.dim_count") }
  if g.code.len() > 0 { return g }
  if g.head_dim % 2 != 0 { geometry_fault(g, "head_dim") }
  if g.code.len() > 0 { return g }
  g.attn_scale_bits = attn_scale_bits(g.head_dim)
  return g
}

// ---------------------------------------------------------------------------------------------
// The member-role table and the shape rules
// ---------------------------------------------------------------------------------------------

// Ten dense members in **slot order**: slot `i` of the node-slot store holds member `i`. The order
// is a contract between this table and phase A's node table and nothing else depends on it.
pub MemberTable {
  count: i64,
  names: string,
  name_start: array<i64>,
  name_end: array<i64>,
  role: array<i64>,
  block: array<i64>,
  ne0: array<i64>,
  ne1: array<i64>,
  n_dims: array<i64>,
}

fn member_label_of(row: i64) -> str {
  if row == 0 { return "token_embd" }
  if row == 1 { return "attn_norm" }
  if row == 2 { return "attn_q" }
  if row == 3 { return "attn_q_norm" }
  if row == 4 { return "attn_k" }
  if row == 5 { return "attn_k_norm" }
  if row == 6 { return "attn_v" }
  if row == 7 { return "attn_output" }
  if row == 8 { return "ffn_norm" }
  return "router"
}

fn member_role_of(row: i64) -> i64 {
  if row == 0 { return ROLE_TOKEN_EMBD }
  if row == 1 { return ROLE_ATTN_NORM }
  if row == 2 { return ROLE_ATTN_Q }
  if row == 3 { return ROLE_ATTN_Q_NORM }
  if row == 4 { return ROLE_ATTN_K }
  if row == 5 { return ROLE_ATTN_K_NORM }
  if row == 6 { return ROLE_ATTN_V }
  if row == 7 { return ROLE_ATTN_OUTPUT }
  if row == 8 { return ROLE_FFN_NORM }
  return ROLE_ROUTER
}

// `ffn_norm` and `router` live in the `RouterBlock` — everything the layer needs *before* it knows
// which experts to fetch — and the other eight in the embedding `WeightBlock` and the
// `AttentionBlock` (`r1c-olmoe-moe-ir.md` section 2.5.3).
fn member_block_of(row: i64) -> i64 {
  if row == 0 { return KIND_WEIGHT }
  if row <= 7 { return KIND_ATTENTION }
  return KIND_ROUTER
}

// The four norms are 1-D at `n_embd`; everything else is 2-D. **Both QK-norms are `n_embd` wide**,
// which is section 2.2 fact 1 as a shape rule: a per-head norm would be `head_dim` wide and the
// container would be refused here rather than computing a different layer.
fn member_is_1d(row: i64) -> bool {
  return row == 1 || row == 3 || row == 5 || row == 8
}

fn member_ne0_of(borrow g: Geometry, row: i64) -> i64 {
  return g.n_embd
}

fn member_ne1_of(borrow g: Geometry, row: i64) -> i64 {
  if member_is_1d(row) { return 1 }
  if row == 0 { return g.n_vocab }
  if row == 2 { return g.n_head * g.head_dim }
  if row == 4 { return g.n_head_kv * g.head_dim }
  if row == 6 { return g.n_head_kv * g.head_dim }
  if row == 7 { return g.n_embd }
  return g.n_expert
}

pub fn member_table(borrow g: Geometry) -> MemberTable {
  labels := builder()
  mut names: array_builder<i64> := array_builder()
  mut ends: array_builder<i64> := array_builder()
  mut roles: array_builder<i64> := array_builder()
  mut blocks: array_builder<i64> := array_builder()
  mut d0: array_builder<i64> := array_builder()
  mut d1: array_builder<i64> := array_builder()
  mut dims: array_builder<i64> := array_builder()
  mut cursor := 0
  mut row := 0
  loop {
    if row >= MEMBER_COUNT { break }
    label := member_label_of(row)
    labels.write(label)
    names.push(cursor)
    cursor = cursor + label.len()
    ends.push(cursor)
    roles.push(member_role_of(row))
    blocks.push(member_block_of(row))
    d0.push(member_ne0_of(g, row))
    d1.push(member_ne1_of(g, row))
    dims.push(if member_is_1d(row) { 1 } else { 2 })
    row = row + 1
  }
  return MemberTable {
    count: MEMBER_COUNT,
    names: labels.to_string(),
    name_start: names.build(),
    name_end: ends.build(),
    role: roles.build(),
    block: blocks.build(),
    ne0: d0.build(),
    ne1: d1.build(),
    n_dims: dims.build(),
  }
}

pub fn member_label(borrow m: MemberTable, index: i64) -> str {
  names_view: str := m.names
  if index < 0 || index >= m.count { return "" }
  return names_view[m.name_start[index]..m.name_end[index]]
}

// The three claim roles, in the order the three compact windows are laid out and in the order the
// `ExpertBlock` declares them. `ne0` and `ne1` are one **plane's** dims — a claim is a plane of a
// stacked tensor, `moe-prereq-discharge.md` section 1.1 — and the built tensor's third dim is `U`,
// never `n_expert`.
pub fn claim_label(index: i64) -> str {
  if index == 0 { return "ffn_gate_exps" }
  if index == 1 { return "ffn_up_exps" }
  return "ffn_down_exps"
}

pub fn claim_role(index: i64) -> i64 {
  if index == 0 { return ROLE_FFN_GATE_EXPS }
  if index == 1 { return ROLE_FFN_UP_EXPS }
  return ROLE_FFN_DOWN_EXPS
}

pub fn claim_ne0(borrow g: Geometry, index: i64) -> i64 {
  if index == 2 { return g.n_ff_exp }
  return g.n_embd
}

pub fn claim_ne1(borrow g: Geometry, index: i64) -> i64 {
  if index == 2 { return g.n_embd }
  return g.n_ff_exp
}

pub fn claim_slot(index: i64) -> i64 {
  if index == 0 { return SLOT_GATE }
  if index == 1 { return SLOT_UP }
  return SLOT_DOWN
}

// ---------------------------------------------------------------------------------------------
// The node tables
// ---------------------------------------------------------------------------------------------

// `c` is `mul_mat_id`'s third slot and `p4` is `view_2d`'s offset index. Both columns exist because
// R5D's three new ops need them; every R5A op leaves them `-1` and `0`.
pub NodeTable {
  count: i64,
  base: i64,
  op: array<i64>,
  a: array<i64>,
  b: array<i64>,
  c: array<i64>,
  out: array<i64>,
  p0: array<i64>,
  p1: array<i64>,
  p2: array<i64>,
  p3: array<i64>,
  p4: array<i64>,
}

// One row, assigned once and pushed once: an owned `array<i64>` field cannot be replaced in place at
// this pin, which is R5A correction C9's shape forced on every column set in this repository.
Row {
  op: i64,
  a: i64,
  b: i64,
  c: i64,
  p0: i64,
  p1: i64,
  p2: i64,
  p3: i64,
  p4: i64,
}

fn row(op: i64, a: i64, b: i64) -> Row = Row {
  op: op,
  a: a,
  b: b,
  c: -1,
  p0: 0,
  p1: 0,
  p2: 0,
  p3: 0,
  p4: 0,
}

// The number of rows phase B's table holds: eight fixed rows, then `n_expert_used` views,
// `n_expert_used - 1` adds, and `l_out`. At `n_expert_used = 8` that is 24 (section 3.5); at the
// synthetic corpus's 3 it is 14.
pub fn b_node_count(n_expert_used: i64) -> i64 {
  return 2 * n_expert_used + 8
}

// Phase A, rows 0 to 30, in the order `ggml_build_forward_expand` visits them.
fn a_row(borrow g: Geometry, tokens: i64, index: i64) -> Row {
  n := A_NODE_BASE
  if index == 0 { return row(OP_GET_ROWS, 0, SLOT_TOKENS) }
  if index == 1 {
    mut r := row(OP_RMS_NORM, n + 0, -1)
    r.p0 = g.rms_eps_bits
    return r
  }
  if index == 2 { return row(OP_MUL, n + 1, 1) }
  if index == 3 { return row(OP_MUL_MAT, 2, n + 2) }
  // Section 2.2 fact 1: the QK-norm normalizes over `ne[0] == n_embd` and scales, and only then is
  // the result reshaped to `{head_dim, n_head, T}`. Reversing rows 4-6 with row 6 type-checks.
  if index == 4 {
    mut r := row(OP_RMS_NORM, n + 3, -1)
    r.p0 = g.rms_eps_bits
    return r
  }
  if index == 5 { return row(OP_MUL, n + 4, 3) }
  if index == 6 {
    mut r := row(OP_RESHAPE_3D, n + 5, -1)
    r.p0 = g.head_dim
    r.p1 = g.n_head
    r.p2 = tokens
    return r
  }
  if index == 7 {
    mut r := row(OP_ROPE, n + 6, SLOT_POS)
    r.p0 = g.head_dim
    r.p1 = ROPE_TYPE_NEOX
    r.p2 = g.context_length
    r.p3 = g.rope_freq_base_bits
    return r
  }
  if index == 8 { return row(OP_MUL_MAT, 4, n + 2) }
  if index == 9 {
    mut r := row(OP_RMS_NORM, n + 8, -1)
    r.p0 = g.rms_eps_bits
    return r
  }
  if index == 10 { return row(OP_MUL, n + 9, 5) }
  if index == 11 {
    mut r := row(OP_RESHAPE_3D, n + 10, -1)
    r.p0 = g.head_dim
    r.p1 = g.n_head_kv
    r.p2 = tokens
    return r
  }
  if index == 12 {
    mut r := row(OP_ROPE, n + 11, SLOT_POS)
    r.p0 = g.head_dim
    r.p1 = ROPE_TYPE_NEOX
    r.p2 = g.context_length
    r.p3 = g.rope_freq_base_bits
    return r
  }
  if index == 13 { return row(OP_MUL_MAT, 6, n + 2) }
  if index == 14 {
    mut r := row(OP_RESHAPE_3D, n + 13, -1)
    r.p0 = g.head_dim
    r.p1 = g.n_head_kv
    r.p2 = tokens
    return r
  }
  if index == 15 {
    mut r := row(OP_PERMUTE, n + 12, -1)
    r.p1 = 2
    r.p2 = 1
    r.p3 = 3
    return r
  }
  if index == 16 {
    mut r := row(OP_PERMUTE, n + 7, -1)
    r.p1 = 2
    r.p2 = 1
    r.p3 = 3
    return r
  }
  if index == 17 { return row(OP_MUL_MAT, n + 15, n + 16) }
  if index == 18 {
    mut r := row(OP_SOFT_MAX, n + 17, SLOT_MASK)
    r.p0 = g.attn_scale_bits
    r.p1 = MAX_BIAS_BITS
    return r
  }
  if index == 19 {
    mut r := row(OP_PERMUTE, n + 14, -1)
    r.p0 = 1
    r.p1 = 2
    r.p2 = 0
    r.p3 = 3
    return r
  }
  if index == 20 {
    mut r := row(OP_CONT_3D, n + 19, -1)
    r.p0 = tokens
    r.p1 = g.head_dim
    r.p2 = g.n_head_kv
    return r
  }
  if index == 21 { return row(OP_MUL_MAT, n + 20, n + 18) }
  if index == 22 {
    mut r := row(OP_PERMUTE, n + 21, -1)
    r.p1 = 2
    r.p2 = 1
    r.p3 = 3
    return r
  }
  if index == 23 {
    // `ggml_cont_3d` at `ne2 = 1` is the `cont_2d` R5A correction C4 established; no second symbol.
    mut r := row(OP_CONT_3D, n + 22, -1)
    r.p0 = g.n_embd
    r.p1 = tokens
    r.p2 = 1
    return r
  }
  if index == 24 { return row(OP_MUL_MAT, 7, n + 23) }
  if index == 25 { return row(OP_ADD, n + 24, n + 0) }
  if index == 26 {
    mut r := row(OP_RMS_NORM, n + 25, -1)
    r.p0 = g.rms_eps_bits
    return r
  }
  if index == 27 { return row(OP_MUL, n + 26, 8) }
  if index == 28 { return row(OP_MUL_MAT, 9, n + 27) }
  if index == 29 {
    // Section 2.2 fact 2: a plain 64-way softmax, unit scale, **no mask** and no renormalization.
    // `-1` is section 3.5's widened `soft_max_ext` domain.
    mut r := row(OP_SOFT_MAX, n + 28, -1)
    r.p0 = UNIT_SCALE_BITS
    r.p1 = MAX_BIAS_BITS
    return r
  }
  // Section 2.2 fact 3: `ARGSORT` descending, and the slice is Align's. `ggml_top_k` is not
  // reachable from this table.
  mut r := row(OP_ARGSORT, n + 29, -1)
  r.p0 = 1
  return r
}

pub fn a_node_table(borrow g: Geometry, tokens: i64) -> NodeTable {
  return build_table(g, tokens, A_NODE_BASE, A_NODE_COUNT, true)
}

pub fn b_node_table(borrow g: Geometry, tokens: i64) -> NodeTable {
  return build_table(g, tokens, B_NODE_BASE, b_node_count(g.n_expert_used), false)
}

// Phase B, rows 0 to `2 * n_expert_used + 7`. The router's decision is an **input** to this graph
// and not a node in it, which is what lets a constant table serve a data-dependent `U`.
fn b_row(borrow g: Geometry, tokens: i64, index: i64) -> Row {
  m := B_NODE_BASE
  used := g.n_expert_used
  if index == 0 {
    mut r := row(OP_RESHAPE_3D, SLOT_PROBS, -1)
    r.p0 = 1
    r.p1 = g.n_expert
    r.p2 = tokens
    return r
  }
  // The gather is over the **global** expert ids, because it indexes the full 64-way softmax; the
  // three `mul_mat_id` rows below use the **compact** ids, because they index the routed union's
  // stack. Confusing the two is the defect section 2.8's `R5D_EXPERT_ID` exists to catch.
  if index == 1 { return row(OP_GET_ROWS, m + 0, SLOT_TOPK) }
  if index == 2 {
    mut r := row(OP_RESHAPE_3D, SLOT_FFN_NORM, -1)
    r.p0 = g.n_embd
    r.p1 = 1
    r.p2 = tokens
    return r
  }
  if index == 3 {
    mut r := row(OP_MUL_MAT_ID, SLOT_GATE, m + 2)
    r.c = SLOT_COMPACT
    return r
  }
  if index == 4 {
    mut r := row(OP_MUL_MAT_ID, SLOT_UP, m + 2)
    r.c = SLOT_COMPACT
    return r
  }
  if index == 5 { return row(OP_SWIGLU, m + 3, m + 4) }
  if index == 6 {
    mut r := row(OP_MUL_MAT_ID, SLOT_DOWN, m + 5)
    r.c = SLOT_COMPACT
    return r
  }
  if index == 7 { return row(OP_MUL, m + 6, m + 1) }
  // The reduction, in **ascending slot order**, which section 2.3 measured to be load-bearing to
  // the last bit. Slot `i` is `view_2d(weighted, n_embd, T, nb1 = weighted->nb[2],
  // offset = i * weighted->nb[1])`, expressed as two axis selectors and an index.
  if index < 8 + used {
    mut r := row(OP_VIEW_2D, m + 7, -1)
    r.p0 = g.n_embd
    r.p1 = tokens
    r.p2 = 2
    r.p3 = 1
    r.p4 = index - 8
    return r
  }
  if index < 8 + 2 * used - 1 {
    // The chain accumulates left to right from slot 0: the first add takes views 0 and 1 and every
    // later one takes the running total and the next view.
    step := index - (8 + used)
    left := if step == 0 { m + 8 } else { m + 8 + used + step - 1 }
    return row(OP_ADD, left, m + 9 + step)
  }
  // `l_out`, against the carried `ffn_inp`.
  last := if used == 1 { m + 8 } else { m + 8 + 2 * used - 2 }
  return row(OP_ADD, last, SLOT_FFN_INP)
}

fn build_table(borrow g: Geometry, tokens: i64, base: i64, count: i64, phase_a: bool) -> NodeTable {
  mut op: array_builder<i64> := array_builder()
  mut a: array_builder<i64> := array_builder()
  mut b: array_builder<i64> := array_builder()
  mut c: array_builder<i64> := array_builder()
  mut out: array_builder<i64> := array_builder()
  mut p0: array_builder<i64> := array_builder()
  mut p1: array_builder<i64> := array_builder()
  mut p2: array_builder<i64> := array_builder()
  mut p3: array_builder<i64> := array_builder()
  mut p4: array_builder<i64> := array_builder()
  mut index := 0
  loop {
    if index >= count { break }
    r := if phase_a { a_row(g, tokens, index) } else { b_row(g, tokens, index) }
    op.push(r.op)
    a.push(r.a)
    b.push(r.b)
    c.push(r.c)
    out.push(base + index)
    p0.push(r.p0)
    p1.push(r.p1)
    p2.push(r.p2)
    p3.push(r.p3)
    p4.push(r.p4)
    index = index + 1
  }
  return NodeTable {
    count: count,
    base: base,
    op: op.build(),
    a: a.build(),
    b: b.build(),
    c: c.build(),
    out: out.build(),
    p0: p0.build(),
    p1: p1.build(),
    p2: p2.build(),
    p3: p3.build(),
    p4: p4.build(),
  }
}

// The last node of each graph, which is what `ggml_build_forward_expand` is called on.
pub fn a_output_slot() -> i64 = A_NODE_BASE + A_NODE_COUNT - 1

pub fn b_output_slot(n_expert_used: i64) -> i64 = B_NODE_BASE + b_node_count(n_expert_used) - 1

// ---------------------------------------------------------------------------------------------
// The oracle table
// ---------------------------------------------------------------------------------------------

// `30 + 2 * n_expert_used` rows: the twenty-six section 3.6 compares, plus every node it excludes
// **by contract** carrying the class that says why. Publishing the exclusions as rows is the whole
// point: a silent gap and a declared exclusion look identical in a passing run and completely
// different in a review.
pub OracleTable {
  count: i64,
  text: string,
  id_start: array<i64>,
  id_end: array<i64>,
  name_start: array<i64>,
  name_end: array<i64>,
  op_start: array<i64>,
  op_end: array<i64>,
  slot: array<i64>,
  class: array<i64>,
  by_weight: array<i64>,
  integer: array<i64>,
  phase_b: array<i64>,
}

pub fn oracle_count(n_expert_used: i64) -> i64 = ORACLE_FIXED_ROWS + 2 * n_expert_used

// The row of `ffn_moe_out`, which is the last add of the reduction — or, at `n_expert_used == 1`,
// the single view that is the whole reduction.
fn oracle_moe_out_row(n_expert_used: i64) -> i64 = ORACLE_FIXED_ROWS + 2 * n_expert_used - 2

fn oracle_fixed_id(index: i64) -> str {
  if index == 0 { return "embd" }
  if index == 1 { return "norm_embd" }
  if index == 2 { return "attn_norm" }
  if index == 3 { return "q_pre" }
  if index == 4 { return "norm_q" }
  if index == 5 { return "q_normed" }
  if index == 6 { return "q_rope" }
  if index == 7 { return "k_pre" }
  if index == 8 { return "norm_k" }
  if index == 9 { return "k_normed" }
  if index == 10 { return "k_rope" }
  if index == 11 { return "v_cur" }
  if index == 12 { return "kq" }
  if index == 13 { return "kq_soft_max" }
  if index == 14 { return "kqv" }
  if index == 15 { return "kqv_out" }
  if index == 16 { return "attn_out" }
  if index == 17 { return "ffn_inp" }
  if index == 18 { return "norm_ffn" }
  if index == 19 { return "ffn_norm" }
  if index == 20 { return "ffn_moe_logits" }
  if index == 21 { return "ffn_moe_probs" }
  if index == 22 { return "ffn_moe_argsort" }
  if index == 23 { return "ffn_moe_topk" }
  if index == 24 { return "ffn_moe_weights" }
  if index == 25 { return "ffn_moe_gate" }
  if index == 26 { return "ffn_moe_up" }
  if index == 27 { return "ffn_moe_swiglu" }
  if index == 28 { return "ffn_moe_down" }
  return "ffn_moe_weighted"
}

// The instrument's own names. Section 2.2 fact 5: four different tensors of one OLMoE layer print
// under `norm-0`, so the four rows below carry that name, are marked `ambiguous_name`, and are
// **never matched** — each is proved instead by its unique `MUL` consumer, which is compared.
fn oracle_fixed_stem(index: i64) -> str {
  if index == 0 { return "embd" }
  if index == 1 || index == 4 || index == 8 || index == 18 { return "norm" }
  if index == 2 { return "attn_norm" }
  if index == 3 { return "Qcur" }
  if index == 5 { return "Qcur_normed" }
  if index == 6 { return "Qcur" }
  if index == 7 { return "Kcur" }
  if index == 9 { return "Kcur_normed" }
  if index == 10 { return "Kcur" }
  if index == 11 { return "Vcur" }
  if index == 12 { return "kq" }
  if index == 13 { return "kq_soft_max" }
  if index == 14 { return "kqv" }
  if index == 15 { return "kqv_out" }
  if index == 17 { return "ffn_inp" }
  if index == 19 { return "ffn_norm" }
  if index == 20 { return "ffn_moe_logits" }
  if index == 21 { return "ffn_moe_probs" }
  if index == 22 { return "ffn_moe_argsort" }
  if index == 23 { return "ffn_moe_topk" }
  if index == 24 { return "ffn_moe_weights" }
  if index == 25 { return "ffn_moe_gate" }
  if index == 26 { return "ffn_moe_up" }
  if index == 27 { return "ffn_moe_swiglu" }
  if index == 28 { return "ffn_moe_down" }
  return "ffn_moe_weighted"
}

fn oracle_fixed_op(index: i64) -> str {
  if index == 0 { return "GET_ROWS" }
  if index == 1 || index == 4 || index == 8 || index == 18 { return "RMS_NORM" }
  if index == 2 { return "MUL" }
  if index == 3 { return "MUL_MAT" }
  if index == 5 { return "MUL" }
  if index == 6 { return "ROPE" }
  if index == 7 { return "MUL_MAT" }
  if index == 9 { return "MUL" }
  if index == 10 { return "ROPE" }
  if index == 11 { return "MUL_MAT" }
  if index == 12 { return "MUL_MAT" }
  if index == 13 { return "SOFT_MAX" }
  if index == 14 { return "MUL_MAT" }
  if index == 15 { return "CONT" }
  if index == 16 { return "MUL_MAT" }
  if index == 17 { return "ADD" }
  if index == 19 { return "MUL" }
  if index == 20 { return "MUL_MAT" }
  if index == 21 { return "SOFT_MAX" }
  if index == 22 { return "ARGSORT" }
  if index == 23 { return "VIEW" }
  if index == 24 { return "GET_ROWS" }
  if index == 25 { return "MUL_MAT_ID" }
  if index == 26 { return "MUL_MAT_ID" }
  if index == 27 { return "SWIGLU" }
  if index == 28 { return "MUL_MAT_ID" }
  return "MUL"
}

// The slot each oracle row observes. `ffn_moe_topk` is the one row that is not a node of either
// graph: R5D slices the top-k in Align and writes it into phase B's `topk_ids` **input**, which is
// exactly the tensor the transcript's `ffn_moe_topk-0` view holds (section 2.8).
fn oracle_fixed_slot(index: i64) -> i64 {
  if index == 0 { return A_NODE_BASE + 0 }
  if index == 1 { return A_NODE_BASE + 1 }
  if index == 2 { return A_NODE_BASE + 2 }
  if index == 3 { return A_NODE_BASE + 3 }
  if index == 4 { return A_NODE_BASE + 4 }
  if index == 5 { return A_NODE_BASE + 5 }
  if index == 6 { return A_NODE_BASE + 7 }
  if index == 7 { return A_NODE_BASE + 8 }
  if index == 8 { return A_NODE_BASE + 9 }
  if index == 9 { return A_NODE_BASE + 10 }
  if index == 10 { return A_NODE_BASE + 12 }
  if index == 11 { return A_NODE_BASE + 13 }
  if index == 12 { return A_NODE_BASE + 17 }
  if index == 13 { return A_NODE_BASE + 18 }
  if index == 14 { return A_NODE_BASE + 21 }
  if index == 15 { return A_NODE_BASE + 23 }
  if index == 16 { return A_NODE_BASE + 24 }
  if index == 17 { return A_NODE_BASE + 25 }
  if index == 18 { return A_NODE_BASE + 26 }
  if index == 19 { return A_NODE_BASE + 27 }
  if index == 20 { return A_NODE_BASE + 28 }
  if index == 21 { return A_NODE_BASE + 29 }
  if index == 22 { return A_NODE_BASE + 30 }
  if index == 23 { return SLOT_TOPK }
  if index == 24 { return B_NODE_BASE + 1 }
  if index == 25 { return B_NODE_BASE + 3 }
  if index == 26 { return B_NODE_BASE + 4 }
  if index == 27 { return B_NODE_BASE + 5 }
  if index == 28 { return B_NODE_BASE + 6 }
  return B_NODE_BASE + 7
}

fn oracle_fixed_class(index: i64) -> i64 {
  // Section 2.2 fact 5's four `norm-0` nodes.
  if index == 1 || index == 4 || index == 8 || index == 18 { return ORACLE_AMBIGUOUS_NAME }
  // R5A section 3.6's reason, unchanged: the instrument's `n_kv` is a padded cache width and R5D
  // has no cache, so the two tensors are different shapes and element comparison is undefined.
  if index == 12 || index == 13 { return ORACLE_SHAPE_INCOMPARABLE }
  return ORACLE_COMPARED
}

pub fn oracle_table(borrow g: Geometry, layer: i64) -> OracleTable {
  body := builder()
  mut ids: array_builder<i64> := array_builder()
  mut id_ends: array_builder<i64> := array_builder()
  mut names: array_builder<i64> := array_builder()
  mut name_ends: array_builder<i64> := array_builder()
  mut ops: array_builder<i64> := array_builder()
  mut op_ends: array_builder<i64> := array_builder()
  mut slots: array_builder<i64> := array_builder()
  mut classes: array_builder<i64> := array_builder()
  mut weighted: array_builder<i64> := array_builder()
  mut integer: array_builder<i64> := array_builder()
  mut phase: array_builder<i64> := array_builder()
  used := g.n_expert_used
  count := oracle_count(used)
  moe_out := oracle_moe_out_row(used)
  suffix := builder()
  suffix.write("-")
  suffix.write_int(layer)
  suffix_text := suffix.to_string()
  suffix_view: str := suffix_text
  weight := builder()
  weight.write("blk.")
  weight.write_int(layer)
  weight.write(".attn_output.weight")
  weight_text := weight.to_string()
  weight_view: str := weight_text
  mut cursor := 0
  mut index := 0
  loop {
    if index >= count { break }
    // The identity of a reduction row, computed rather than tabulated: the chain is
    // `n_expert_used` long and its rows are named by position.
    reduction := index - ORACLE_FIXED_ROWS
    mut id_text := "".clone()
    mut name_text := "".clone()
    mut op_text := "ADD".clone()
    mut class := ORACLE_COMPARED
    mut is_integer := 0
    if index < ORACLE_FIXED_ROWS {
      id_text = oracle_fixed_id(index).clone()
      op_text = oracle_fixed_op(index).clone()
      class = oracle_fixed_class(index)
      if index == 22 || index == 23 { is_integer = 1 }
      n := builder()
      if index == 16 {
        n.write(weight_view)
      } else {
        n.write(oracle_fixed_stem(index))
        if index != 0 { n.write(suffix_view) }
      }
      name_text = n.to_string()
    } else if index == moe_out {
      id_text = "ffn_moe_out".clone()
      op_text = if used == 1 { "VIEW".clone() } else { "ADD".clone() }
      n := builder()
      n.write("ffn_moe_out")
      n.write(suffix_view)
      name_text = n.to_string()
    } else if index == count - 1 {
      id_text = "l_out".clone()
      n := builder()
      n.write("l_out")
      n.write(suffix_view)
      name_text = n.to_string()
    } else if reduction < used {
      // Section 2.2 fact 4: the eight slot views print under one repeated name.
      class = ORACLE_UNSTABLE_NAME
      op_text = "VIEW".clone()
      b := builder()
      b.write("moe_view_")
      b.write_int(reduction)
      id_text = b.to_string()
      n := builder()
      n.write("ffn_moe_weighted")
      n.write(suffix_view)
      n.write(" (view)")
      name_text = n.to_string()
    } else {
      // `node_56` … `node_61`: positional names `r2a-expert-trace.md` section 2.2 finding 3 already
      // establishes as unstable. Section 6, correction C2: the published name is the wildcard
      // `node_*` rather than a number that is right for one build of one model and wrong elsewhere.
      class = ORACLE_UNSTABLE_NAME
      b := builder()
      b.write("moe_add_")
      b.write_int(reduction - used)
      id_text = b.to_string()
      name_text = "node_*".clone()
    }
    id_view: str := id_text
    name_view: str := name_text
    op_view: str := op_text
    body.write(id_view)
    ids.push(cursor)
    cursor = cursor + id_view.len()
    id_ends.push(cursor)
    names.push(cursor)
    body.write(name_view)
    cursor = cursor + name_view.len()
    name_ends.push(cursor)
    ops.push(cursor)
    body.write(op_view)
    cursor = cursor + op_view.len()
    op_ends.push(cursor)
    slots.push(if index < ORACLE_FIXED_ROWS {
        oracle_fixed_slot(index)
      } else {
        B_NODE_BASE + 8 + reduction
      })
    classes.push(class)
    weighted.push(if index == 16 { 1 } else { 0 })
    integer.push(is_integer)
    phase.push(if index < 23 { 0 } else { 1 })
    index = index + 1
  }
  return OracleTable {
    count: count,
    text: body.to_string(),
    id_start: ids.build(),
    id_end: id_ends.build(),
    name_start: names.build(),
    name_end: name_ends.build(),
    op_start: ops.build(),
    op_end: op_ends.build(),
    slot: slots.build(),
    class: classes.build(),
    by_weight: weighted.build(),
    integer: integer.build(),
    phase_b: phase.build(),
  }
}

pub fn oracle_id(borrow o: OracleTable, index: i64) -> str {
  view: str := o.text
  if index < 0 || index >= o.count { return "" }
  return view[o.id_start[index]..o.id_end[index]]
}

pub fn oracle_name(borrow o: OracleTable, index: i64) -> str {
  view: str := o.text
  if index < 0 || index >= o.count { return "" }
  return view[o.name_start[index]..o.name_end[index]]
}

pub fn oracle_op(borrow o: OracleTable, index: i64) -> str {
  view: str := o.text
  if index < 0 || index >= o.count { return "" }
  return view[o.op_start[index]..o.op_end[index]]
}

// `true` when a row is sought in the transcript at all. An `ambiguous_name` or `unstable_name` row
// is **not**: matching four same-named nodes by ordinal is the silent-miscompare hazard section 2.2
// fact 5 records, and `node_56` is a name that moves whenever anything upstream changes.
pub fn oracle_scanned(borrow o: OracleTable, index: i64) -> bool {
  if index < 0 || index >= o.count { return false }
  class := o.class[index]
  // `ORACLE_ROUTING` is R5E's: a row the scanner must capture because the routing oracle reads its
  // elements, and which the element oracle neither compares against a tolerance nor shape-checks
  // against the declared attention width. R5D's tables never emit it, so R5D's scan is unchanged.
  return class == ORACLE_COMPARED || class == ORACLE_SHAPE_INCOMPARABLE
    || class == ORACLE_ROUTING
}

pub fn oracle_compared(borrow o: OracleTable, index: i64) -> bool {
  if index < 0 || index >= o.count { return false }
  return o.class[index] == ORACLE_COMPARED
}

// The row the routing-identity oracle reads: `ffn_moe_topk`, whose scanned block is the transcript's
// own `ffn_moe_topk-0`.
pub fn oracle_topk_row() -> i64 = 23

// ---------------------------------------------------------------------------------------------
// The causal mask
// ---------------------------------------------------------------------------------------------

// A `{T, T}` f32 image, written from bit patterns rather than float arithmetic, so no float is
// parsed, no float is formatted, and nothing depends on how Align renders infinity.
pub fn write_mask(borrow mut window: buffer, tokens: i64) {
  mut row := 0
  loop {
    if row >= tokens { break }
    mut col := 0
    loop {
      if col >= tokens { break }
      bits := if col <= row { MASK_ZERO_BITS } else { MASK_NEG_INFINITY_BITS }
      window.put_u32_le(bits as u32)
      col = col + 1
    }
    row = row + 1
  }
}

// ---------------------------------------------------------------------------------------------
// The routing decision (section 3.4, between the phases)
// ---------------------------------------------------------------------------------------------

// What Align decided, on bytes Align owns. `code` is empty on success; otherwise it is the arm's
// error code and `detail` names the token, the slot, or `remap`.
//
// **No view is ever read back** (section 2.8). `ffn_moe_argsort` is contiguous `{n_expert, T}` and
// the arm reads it whole; the top-k slice below is Align's arithmetic over those bytes, not a
// strided `ggml_backend_tensor_get`. The probe made exactly that mistake and it produced a
// plausible expert set, a plausible union, and an `l_out` that was finite, wrong, and off by O(1).
pub Routing {
  code: string,
  detail: string,
  count: i64,
  // `[token * n_expert_used + slot]`, the global ids in slot order.
  topk: array<i64>,
  // The ascending distinct union, and the same ids remapped onto `[0, U)`.
  routed: array<i64>,
  compact: array<i64>,
}

fn empty_i64_array() -> array<i64> {
  mut b: array_builder<i64> := array_builder()
  return b.build()
}

pub fn empty_routing() -> Routing = Routing {
  code: "".clone(),
  detail: "".clone(),
  count: 0,
  topk: empty_i64_array(),
  routed: empty_i64_array(),
  compact: empty_i64_array(),
}

fn routing_fault(code: str, detail: string) -> Routing = Routing {
  code: code.clone(),
  detail: detail,
  count: 0,
  topk: empty_i64_array(),
  routed: empty_i64_array(),
  compact: empty_i64_array(),
}

fn token_slot_detail(token: i64, slot: i64) -> string {
  b := builder()
  b.write("token[")
  b.write_int(token)
  b.write("]slot[")
  b.write_int(slot)
  b.write("]")
  return b.to_string()
}

// Steps 24 and 25. `argsort` is the whole contiguous `{n_expert, T}` i32 readback; the result is the
// slice, the ascending union, and the verified bijection.
//
// Every check here is a defence against the one failure mode this design most needs to avoid: a
// wrong routing produces finite, plausible, wrong numbers and passes every shape check downstream.
pub fn decide(borrow argsort: slice<u8>, n_expert: i64, n_expert_used: i64, tokens: i64) -> Routing {
  if n_expert < 1 || n_expert_used < 1 || n_expert_used > n_expert || tokens < 1 {
    return routing_fault("R5D_EXPERT_ID", "geometry".clone())
  }
  if argsort.len() < n_expert * tokens * 4 {
    return routing_fault("R5D_EXPERT_ID", "argsort".clone())
  }
  mut topk: array_builder<i64> := array_builder()
  // `seen[e]` is `1` once expert `e` has entered the union, so the union is built in one pass and
  // the pairwise-distinct test inside a token is a second, per-token pass over the same idea.
  mut union_flag: array_builder<i64> := array_builder()
  mut flag_at := 0
  loop {
    if flag_at >= n_expert { break }
    union_flag.push(0)
    flag_at = flag_at + 1
  }
  mut seen := union_flag.build()
  mut token := 0
  loop {
    if token >= tokens { break }
    mut slot := 0
    loop {
      if slot >= n_expert_used { break }
      id := argsort.u32_le((token * n_expert + slot) * 4) as i64
      if id < 0 || id >= n_expert {
        return routing_fault("R5D_EXPERT_ID", token_slot_detail(token, slot))
      }
      topk.push(id)
      slot = slot + 1
    }
    token = token + 1
  }
  ids := topk.build()
  // Pairwise distinctness inside one token. Section 3.8 records why this is the check that catches
  // a strided readback: reading `{8, T}` out of a `{64, T}` row's stride yields ranks 8-15 of token
  // 0 for token 1, which are in range and distinct only sometimes.
  mut check_token := 0
  loop {
    if check_token >= tokens { break }
    mut left := 0
    loop {
      if left >= n_expert_used { break }
      mut right := left + 1
      loop {
        if right >= n_expert_used { break }
        if ids[check_token * n_expert_used + left] == ids[check_token * n_expert_used + right] {
          return routing_fault("R5D_EXPERT_ID", token_slot_detail(check_token, right))
        }
        right = right + 1
      }
      left = left + 1
    }
    check_token = check_token + 1
  }
  mut mark := 0
  loop {
    if mark >= ids.len() { break }
    seen[ids[mark]] = 1
    mark = mark + 1
  }
  // The **ascending** union, which is what makes `routed[u]` the plane at window slot `u` and what
  // a reader reproduces from `routing.expert_ids` alone.
  mut routed_builder: array_builder<i64> := array_builder()
  mut position_builder: array_builder<i64> := array_builder()
  mut expert := 0
  mut next := 0
  loop {
    if expert >= n_expert { break }
    if seen[expert] == 1 {
      routed_builder.push(expert)
      position_builder.push(next)
      next = next + 1
    } else {
      position_builder.push(-1)
    }
    expert = expert + 1
  }
  routed := routed_builder.build()
  position := position_builder.build()
  mut compact_builder: array_builder<i64> := array_builder()
  mut remap_at := 0
  loop {
    if remap_at >= ids.len() { break }
    slot_of := position[ids[remap_at]]
    if slot_of < 0 || slot_of >= routed.len() {
      return routing_fault("R5D_EXPERT_ID", "remap".clone())
    }
    compact_builder.push(slot_of)
    remap_at = remap_at + 1
  }
  compact := compact_builder.build()
  // The bijection, verified rather than assumed: every compact slot must be reached by at least one
  // `(token, slot)` pair, or the union and the remap disagree about `U`.
  mut cover_builder: array_builder<i64> := array_builder()
  mut cover_at := 0
  loop {
    if cover_at >= routed.len() { break }
    cover_builder.push(0)
    cover_at = cover_at + 1
  }
  mut cover := cover_builder.build()
  mut walk := 0
  loop {
    if walk >= compact.len() { break }
    cover[compact[walk]] = 1
    walk = walk + 1
  }
  mut verify := 0
  loop {
    if verify >= cover.len() { break }
    if cover[verify] == 0 {
      return routing_fault("R5D_EXPERT_ID", "remap".clone())
    }
    verify = verify + 1
  }
  return Routing {
    code: "".clone(),
    detail: "".clone(),
    count: routed.len(),
    topk: ids,
    routed: routed,
    compact: compact,
  }
}

// =============================================================================================
// R5E-MOE-MODEL-PREFILL (`docs/specs/r5e-moe-model-prefill.md` section 3.6)
//
// The `LAYER` operand, expressed the way this repository already expresses one: the four topologies
// below are **functions of `L`, `T_in`, `T_out`, and the declared attention width**, and nothing in
// them is a literal layer index. R5D's tables above are untouched — its goldens are compared byte
// for byte and section 3.1 of its own ledger promises they do not move — so R5E adds four new
// tables beside them and shares the geometry, the routing decision, the claim roles, and the
// `OracleTable` record.
//
// Four tables, because a whole routed prefill is four different graphs walked 34 times:
//
//   embed   1 row     GET_ROWS(token_embd window, inp_tokens)
//   layer A 35 rows   R5D's 31 minus the gather, plus two narrowing and three width rows
//   layer B 2u+8 rows R5D's phase-B table at R5E's slot base
//   head    3 rows    RMS_NORM, MUL(output_norm), MUL_MAT(output)
//
// and a `node_when` column that selects rows as **data**: `0` always, `1` only at the last layer,
// `2` only when `KV_WIDTH > token_count`. Encoding the narrowing and the reconciliation as rows
// rather than as `if` statements inside the walk is what keeps "the topology is a table a test can
// assert on" true.
// =============================================================================================

// R5B's `ggml_pad`, the one op R5D's table never needed: the reconciliation width is reached by
// zero-padding K and V and widening the mask, not by a second kernel. No new shim symbol.
pub OP_PAD := 15

// Section 3.3's ceiling on the declared attention width. R5E never contains the value the
// instrument happens to use; `KV_WIDTH` is a mandatory operand.
pub MAX_ATTENTION_WIDTH := 4096

// The three conditions of the `node_when` column, and R6-OLMOE-DECODE's fourth.
pub WHEN_ALWAYS := 0
pub WHEN_LAST := 1
pub WHEN_WIDE := 2

// `docs/specs/r6-olmoe-decode.md` section 3.7. A `WHEN_DECODE` row is a K or V `CONCAT` against the
// uploaded plane; the row that consumes it redirects its `a` operand through `alt_when`. The
// numbering matches `layer_qwen2.WHEN_DECODE` because the two predicates answer the same question.
//
// **`WHEN_WIDE` cannot be reused for the concatenation**, which is the trap section 3.7 names
// before implementation rather than after it: `ggml_pad` writes its source at the **start** of each
// padded axis and zeroes the rest, so at `T = 1` a `WHEN_WIDE` widening puts the step's one new
// column at index 0 with zeros above it, where the plane's columns must occupy `[0, n_past)` and
// the new column `n_past`. A decode topology is a new condition and two `CONCAT` rows.
pub WHEN_DECODE := 4

// R5B's concatenation, the one op R5E's four tables never needed. `ggml_ffi.op_concat` already
// ships for the dense decode arm, so this is a table vocabulary entry and not a new FFI symbol.
pub OP_CONCAT := 16

// Section 3.2's step ceiling, R6-STEP-N section 2.3's reason unchanged: a loop whose bound is an
// operand needs a bound the document can publish, and 64 is large enough that no qualification has
// wanted more and small enough that every accumulator's saturation argument is trivial.
pub MAX_DECODE_STEPS := 64

// The head's two members, from `src/alignpack.align`'s frozen `role_id` list.
pub ROLE_OUTPUT_NORM := 13
pub ROLE_OUTPUT := 14

// R5E's slot map. `token_embd` is gone from the layer — it is the embedding graph's own member —
// which is what makes all sixteen phase-A graphs the same table walked sixteen times with different
// weights. Nine dense members, four inputs, three compact stacks, five carried values, thirty-five
// phase-A nodes and `2 * n_expert_used + 8` phase-B nodes: a high-water of 80 against a capacity of
// 128 at this geometry.
pub MM_LAYER_MEMBER_COUNT := 9
pub MM_EMBED_MEMBER_COUNT := 1
pub MM_HEAD_MEMBER_COUNT := 2

pub MM_SLOT_CUR := 9
pub MM_SLOT_TOKENS := 9
pub MM_SLOT_POS := 10
pub MM_SLOT_MASK := 11
pub MM_SLOT_OUT_IDS := 12
pub MM_SLOT_GATE := 13
pub MM_SLOT_UP := 14
pub MM_SLOT_DOWN := 15
pub MM_SLOT_FFN_NORM := 16
pub MM_SLOT_FFN_INP := 17
pub MM_SLOT_PROBS := 18
pub MM_SLOT_TOPK := 19
pub MM_SLOT_COMPACT := 20
pub MM_A_NODE_BASE := 21
pub MM_A_NODE_COUNT := 35
pub MM_B_NODE_BASE := 56
pub MM_EMBED_NODE_COUNT := 1
pub MM_HEAD_NODE_COUNT := 3

// ---------------------------------------------------------------------------------------------
// R6-OLMOE-DECODE's slot map, which extends R5E's rather than moving one number of it
// ---------------------------------------------------------------------------------------------
//
// `docs/specs/r6-olmoe-decode.md` section 3.7 derived the slot budget rather than inheriting it,
// and implementation moved one row of that derivation. The design predicted a 37-row decode phase A
// at `MM_A_NODE_BASE` with phase B left at 56; 21 + 37 is 58, so those two ranges **overlap at
// slots 56 and 57**, which is exactly the "disjoint ranges" property the store's own header says
// lets phase A's nodes stay readable while phase B is built. The decode phase-B base therefore
// moves to 58 — for the decode tables only. R5E's `MM_B_NODE_BASE` is byte-unchanged and no prefill
// slot number moves, so the two MoE goldens cannot move for this reason.
//
// The consequence is one value of a public precondition, recorded rather than discovered: the
// decode arm's ceiling is `MM_DECODE_B_NODE_BASE + b_node_count(u) <= MM_SLOT_KPAST`, which admits
// `n_expert_used <= 30` where section 3.7 predicted 31 and R5E's prefill admits 32. It is checked
// in the arm's `stage_geometry`, naming the field, and `layer_olmoe.parse_geometry` stays
// byte-unchanged.
//
// The uploaded plane's two past tensors take the **top two slots** rather than a fixed pair just
// above R5E's measured high water of 80, because `MM_B_NODE_BASE + b_node_count(u)` passes 80 at
// `n_expert_used >= 13` and a fixed pair there would collide with phase B on a legal geometry.
pub MM_SLOT_KPAST := 126
pub MM_SLOT_VPAST := 127
pub MM_DECODE_A_NODE_COUNT := 37
pub MM_DECODE_B_NODE_BASE := 58

// The two phase-A rows the plane is written **from**, at both `T` and `T = 1`: the post-QK-norm,
// post-RoPE `Kcur` and the reshaped `Vcur`. They are the same two rows in the prefill table and in
// the decode table because both tables share `mm_a_row_head` unchanged, which is why this
// architecture needs one pair where `src/decode_step.align` derived four qwen2 indices.
//
// Reading the plane from these rows and **not** from the two `CONCAT` outputs is deliberate: the V
// concatenation's new column is strided, so a write-back sourced from it would copy the wrong bytes
// with the right shape.
pub MM_K_ROW := 11
pub MM_V_ROW := 13

// The two decode-table rows oracle B reads **back**: the tensors the attention actually consumed.
// Comparing the plane against these rather than against the rows it was written from is what makes
// the round trip an oracle instead of an echo.
pub MM_DECODE_K_CONCAT_ROW := 17
pub MM_DECODE_V_CONCAT_ROW := 23

// Seventeen oracle rows per layer: the fourteen section 3.7 element-compares, plus `kq-L` and
// `kq_soft_max-L` — matched, shape-checked against `KV_WIDTH`, never compared — plus
// `ffn_moe_topk-L`, which the **routing** oracle reads and the element oracle does not.
pub MM_LAYER_ORACLE_COUNT := 17
pub MM_HEAD_ORACLE_COUNT := 2

// The class a row carries when it is scanned for the routing oracle alone: it is matched by name
// and op, its elements feed oracle 3 of section 3.7, and it is neither element-compared against a
// tolerance nor shape-checked against the declared attention width. R5D's tables never emit it, so
// R5D's own scan is unchanged.
pub ORACLE_ROUTING := 5

// ---------------------------------------------------------------------------------------------
// R5E's member tables
// ---------------------------------------------------------------------------------------------

fn mm_layer_label_of(row: i64) -> str {
  if row == 0 { return "attn_norm" }
  if row == 1 { return "attn_q" }
  if row == 2 { return "attn_q_norm" }
  if row == 3 { return "attn_k" }
  if row == 4 { return "attn_k_norm" }
  if row == 5 { return "attn_v" }
  if row == 6 { return "attn_output" }
  if row == 7 { return "ffn_norm" }
  return "router"
}

fn mm_layer_role_of(row: i64) -> i64 {
  if row == 0 { return ROLE_ATTN_NORM }
  if row == 1 { return ROLE_ATTN_Q }
  if row == 2 { return ROLE_ATTN_Q_NORM }
  if row == 3 { return ROLE_ATTN_K }
  if row == 4 { return ROLE_ATTN_K_NORM }
  if row == 5 { return ROLE_ATTN_V }
  if row == 6 { return ROLE_ATTN_OUTPUT }
  if row == 7 { return ROLE_FFN_NORM }
  return ROLE_ROUTER
}

// The three norms and the QK-norms are 1-D at `n_embd`. **Both QK-norms are `n_embd` wide**, which
// is `r5d-moe-layer-forward.md` section 2.2 fact 1 as a shape rule.
fn mm_layer_is_1d(row: i64) -> bool {
  return row == 0 || row == 2 || row == 4 || row == 7
}

fn mm_layer_ne1_of(borrow g: Geometry, row: i64) -> i64 {
  if mm_layer_is_1d(row) { return 1 }
  if row == 1 { return g.n_head * g.head_dim }
  if row == 3 { return g.n_head_kv * g.head_dim }
  if row == 5 { return g.n_head_kv * g.head_dim }
  if row == 6 { return g.n_embd }
  return g.n_expert
}

pub fn mm_layer_member_table(borrow g: Geometry) -> MemberTable {
  labels := builder()
  mut names: array_builder<i64> := array_builder()
  mut ends: array_builder<i64> := array_builder()
  mut roles: array_builder<i64> := array_builder()
  mut blocks: array_builder<i64> := array_builder()
  mut d0: array_builder<i64> := array_builder()
  mut d1: array_builder<i64> := array_builder()
  mut dims: array_builder<i64> := array_builder()
  mut cursor := 0
  mut row := 0
  loop {
    if row >= MM_LAYER_MEMBER_COUNT { break }
    label := mm_layer_label_of(row)
    labels.write(label)
    names.push(cursor)
    cursor = cursor + label.len()
    ends.push(cursor)
    roles.push(mm_layer_role_of(row))
    // `ffn_norm` and the router live in the `RouterBlock` — everything the layer needs *before* it
    // knows which experts to fetch (`r1c-olmoe-moe-ir.md` section 2.5.3).
    blocks.push(if row <= 6 { KIND_ATTENTION } else { KIND_ROUTER })
    d0.push(g.n_embd)
    d1.push(mm_layer_ne1_of(g, row))
    dims.push(if mm_layer_is_1d(row) { 1 } else { 2 })
    row = row + 1
  }
  return MemberTable {
    count: MM_LAYER_MEMBER_COUNT,
    names: labels.to_string(),
    name_start: names.build(),
    name_end: ends.build(),
    role: roles.build(),
    block: blocks.build(),
    ne0: d0.build(),
    ne1: d1.build(),
    n_dims: dims.build(),
  }
}

pub fn mm_embed_member_table(borrow g: Geometry) -> MemberTable {
  labels := builder()
  mut names: array_builder<i64> := array_builder()
  mut ends: array_builder<i64> := array_builder()
  mut roles: array_builder<i64> := array_builder()
  mut blocks: array_builder<i64> := array_builder()
  mut d0: array_builder<i64> := array_builder()
  mut d1: array_builder<i64> := array_builder()
  mut dims: array_builder<i64> := array_builder()
  labels.write("token_embd")
  names.push(0)
  ends.push(10)
  roles.push(ROLE_TOKEN_EMBD)
  blocks.push(KIND_WEIGHT)
  d0.push(g.n_embd)
  d1.push(g.n_vocab)
  dims.push(2)
  return MemberTable {
    count: MM_EMBED_MEMBER_COUNT,
    names: labels.to_string(),
    name_start: names.build(),
    name_end: ends.build(),
    role: roles.build(),
    block: blocks.build(),
    ne0: d0.build(),
    ne1: d1.build(),
    n_dims: dims.build(),
  }
}

// `output_norm` is 1-D at `n_embd` and `output` is `[n_embd, n_vocab]`. Section 2.1 measured this
// model as **untied** and section 3.4 detects rather than assumes it.
pub fn mm_head_member_table(borrow g: Geometry) -> MemberTable {
  labels := builder()
  mut names: array_builder<i64> := array_builder()
  mut ends: array_builder<i64> := array_builder()
  mut roles: array_builder<i64> := array_builder()
  mut blocks: array_builder<i64> := array_builder()
  mut d0: array_builder<i64> := array_builder()
  mut d1: array_builder<i64> := array_builder()
  mut dims: array_builder<i64> := array_builder()
  labels.write("output_norm")
  names.push(0)
  ends.push(11)
  roles.push(ROLE_OUTPUT_NORM)
  blocks.push(KIND_WEIGHT)
  d0.push(g.n_embd)
  d1.push(1)
  dims.push(1)
  labels.write("output")
  names.push(11)
  ends.push(17)
  roles.push(ROLE_OUTPUT)
  blocks.push(KIND_WEIGHT)
  d0.push(g.n_embd)
  d1.push(g.n_vocab)
  dims.push(2)
  return MemberTable {
    count: MM_HEAD_MEMBER_COUNT,
    names: labels.to_string(),
    name_start: names.build(),
    name_end: ends.build(),
    role: roles.build(),
    block: blocks.build(),
    ne0: d0.build(),
    ne1: d1.build(),
    n_dims: dims.build(),
  }
}

// ---------------------------------------------------------------------------------------------
// R5E's node tables
// ---------------------------------------------------------------------------------------------

// One row of an R5E table. `when` selects the row, `alt_when` selects the *operands*: the
// narrowing and the reconciliation change a consumer's source without adding a consumer, so
// encoding them as a second operand pair keeps one row per computed node.
pub MmNodeTable {
  count: i64,
  base: i64,
  op: array<i64>,
  a: array<i64>,
  b: array<i64>,
  c: array<i64>,
  out: array<i64>,
  p0: array<i64>,
  p1: array<i64>,
  p2: array<i64>,
  p3: array<i64>,
  p4: array<i64>,
  when: array<i64>,
  alt_when: array<i64>,
  alt_a: array<i64>,
  alt_b: array<i64>,
}

MmRow {
  op: i64,
  a: i64,
  b: i64,
  c: i64,
  p0: i64,
  p1: i64,
  p2: i64,
  p3: i64,
  p4: i64,
  when: i64,
  alt_when: i64,
  alt_a: i64,
  alt_b: i64,
}

fn mm_row(op: i64, a: i64, b: i64) -> MmRow = MmRow {
  op: op,
  a: a,
  b: b,
  c: -1,
  p0: 0,
  p1: 0,
  p2: 0,
  p3: 0,
  p4: 0,
  when: WHEN_ALWAYS,
  alt_when: WHEN_ALWAYS,
  alt_a: -1,
  alt_b: -1,
}

// `true` when a row is issued for a graph with these two conditions. One loop in
// `src/moe_model_forward.align` walks the table and skips a row whose condition does not hold.
// R6-OLMOE-DECODE keeps this signature and defines it as the `decode = false` case of the
// four-condition form below, so R5E's issued row set is unchanged by construction.
pub fn mm_row_issued(condition: i64, last: bool, wide: bool) -> bool {
  return mm_row_issued_at(condition, last, wide, false)
}

// `docs/specs/r6-olmoe-decode.md` section 3.7. The same predicate with the decode condition, walked
// by `src/moe_decode_step.align`. In a decode walk `wide` means `width > n_past + 1`, not
// `width > tokens`, because the concatenated operand is `n_past + 1` columns long before it is
// padded.
pub fn mm_row_issued_at(condition: i64, last: bool, wide: bool, decode: bool) -> bool {
  if condition == WHEN_ALWAYS { return true }
  if condition == WHEN_LAST { return last }
  if condition == WHEN_DECODE { return decode }
  return wide
}

// Rows 0 to 13: the norm, the two QK-normed projections, `Vcur`, the three reshapes and the two
// RoPEs. `r5d-moe-layer-forward.md` section 2.2 fact 1 is normative here: the QK-norm is an RMS
// norm over `ne[0] == n_embd` applied **before** the head reshape. A table that reshapes first
// type-checks, runs, and is wrong.
fn mm_a_row_head(borrow g: Geometry, tokens: i64, row: i64) -> MmRow {
  m := MM_A_NODE_BASE
  if row == 0 {
    mut r := mm_row(OP_RMS_NORM, MM_SLOT_CUR, -1)
    r.p0 = g.rms_eps_bits
    return r
  }
  if row == 1 { return mm_row(OP_MUL, m + 0, 0) }
  if row == 2 { return mm_row(OP_MUL_MAT, 1, m + 1) }
  if row == 3 {
    mut r := mm_row(OP_RMS_NORM, m + 2, -1)
    r.p0 = g.rms_eps_bits
    return r
  }
  if row == 4 { return mm_row(OP_MUL, m + 3, 2) }
  if row == 5 {
    mut r := mm_row(OP_RESHAPE_3D, m + 4, -1)
    r.p0 = g.head_dim
    r.p1 = g.n_head
    r.p2 = tokens
    return r
  }
  if row == 6 {
    mut r := mm_row(OP_ROPE, m + 5, MM_SLOT_POS)
    r.p0 = g.head_dim
    r.p1 = ROPE_TYPE_NEOX
    r.p2 = g.context_length
    r.p3 = g.rope_freq_base_bits
    return r
  }
  if row == 7 { return mm_row(OP_MUL_MAT, 3, m + 1) }
  if row == 8 {
    mut r := mm_row(OP_RMS_NORM, m + 7, -1)
    r.p0 = g.rms_eps_bits
    return r
  }
  if row == 9 { return mm_row(OP_MUL, m + 8, 4) }
  if row == 10 {
    mut r := mm_row(OP_RESHAPE_3D, m + 9, -1)
    r.p0 = g.head_dim
    r.p1 = g.n_head_kv
    r.p2 = tokens
    return r
  }
  if row == 11 {
    mut r := mm_row(OP_ROPE, m + 10, MM_SLOT_POS)
    r.p0 = g.head_dim
    r.p1 = ROPE_TYPE_NEOX
    r.p2 = g.context_length
    r.p3 = g.rope_freq_base_bits
    return r
  }
  if row == 12 { return mm_row(OP_MUL_MAT, 5, m + 1) }
  mut r := mm_row(OP_RESHAPE_3D, m + 12, -1)
  r.p0 = g.head_dim
  r.p1 = g.n_head_kv
  r.p2 = tokens
  return r
}

// Rows 14 to 25: the attention itself, including the three `WHEN_WIDE` rows that widen K and V to
// the instrument's declared reduction length. `ggml_pad` writes the source at the **start** of each
// padded axis and zeroes the rest, and the mask's extra columns are `-inf`, so the padded lanes
// contribute nothing but the f32 reduction length matches llama.cpp's
// (`r5b-model-prefill-forward.md` section 2.7).
fn mm_a_row_attention(borrow g: Geometry, tokens: i64, width: i64, row: i64) -> MmRow {
  m := MM_A_NODE_BASE
  if row == 14 {
    mut r := mm_row(OP_PERMUTE, m + 11, -1)
    r.p1 = 2
    r.p2 = 1
    r.p3 = 3
    return r
  }
  if row == 15 {
    mut r := mm_row(OP_PERMUTE, m + 6, -1)
    r.p1 = 2
    r.p2 = 1
    r.p3 = 3
    return r
  }
  if row == 16 {
    mut r := mm_row(OP_CONT_3D, m + 14, -1)
    r.p0 = g.head_dim
    r.p1 = tokens
    r.p2 = g.n_head_kv
    r.when = WHEN_WIDE
    return r
  }
  if row == 17 {
    mut r := mm_row(OP_PAD, m + 16, -1)
    r.p1 = width - tokens
    r.when = WHEN_WIDE
    return r
  }
  if row == 18 {
    mut r := mm_row(OP_MUL_MAT, m + 14, m + 15)
    r.alt_when = WHEN_WIDE
    r.alt_a = m + 17
    return r
  }
  if row == 19 {
    mut r := mm_row(OP_SOFT_MAX, m + 18, MM_SLOT_MASK)
    r.p0 = g.attn_scale_bits
    r.p1 = MAX_BIAS_BITS
    return r
  }
  if row == 20 {
    mut r := mm_row(OP_PERMUTE, m + 13, -1)
    r.p0 = 1
    r.p1 = 2
    r.p2 = 0
    r.p3 = 3
    return r
  }
  if row == 21 {
    mut r := mm_row(OP_CONT_3D, m + 20, -1)
    r.p0 = tokens
    r.p1 = g.head_dim
    r.p2 = g.n_head_kv
    return r
  }
  if row == 22 {
    mut r := mm_row(OP_PAD, m + 21, -1)
    r.p0 = width - tokens
    r.when = WHEN_WIDE
    return r
  }
  if row == 23 {
    mut r := mm_row(OP_MUL_MAT, m + 21, m + 19)
    r.alt_when = WHEN_WIDE
    r.alt_a = m + 22
    return r
  }
  if row == 24 {
    mut r := mm_row(OP_PERMUTE, m + 23, -1)
    r.p1 = 2
    r.p2 = 1
    r.p3 = 3
    return r
  }
  // `ggml_cont_3d` at `ne2 = 1` is R5A correction C4's `cont_2d`; no second symbol.
  mut r := mm_row(OP_CONT_3D, m + 24, -1)
  r.p0 = g.n_embd
  r.p1 = tokens
  r.p2 = 1
  return r
}

// Rows 26 to 34: the attention output projection, the two `WHEN_LAST` narrowing rows, the residual
// add, the FFN norm, and the router. Section 2.2: the prefill narrows **inside** layer 15, after
// the output projection, on **both** branches of the residual add — and therefore *before* the last
// layer's router, which is why `ffn_moe_logits-15` is `{n_expert, 1}`.
fn mm_a_row_tail(borrow g: Geometry, row: i64) -> MmRow {
  m := MM_A_NODE_BASE
  if row == 26 { return mm_row(OP_MUL_MAT, 6, m + 25) }
  if row == 27 {
    mut r := mm_row(OP_GET_ROWS, m + 26, MM_SLOT_OUT_IDS)
    r.when = WHEN_LAST
    return r
  }
  if row == 28 {
    mut r := mm_row(OP_GET_ROWS, MM_SLOT_CUR, MM_SLOT_OUT_IDS)
    r.when = WHEN_LAST
    return r
  }
  if row == 29 {
    mut r := mm_row(OP_ADD, m + 26, MM_SLOT_CUR)
    r.alt_when = WHEN_LAST
    r.alt_a = m + 27
    r.alt_b = m + 28
    return r
  }
  if row == 30 {
    mut r := mm_row(OP_RMS_NORM, m + 29, -1)
    r.p0 = g.rms_eps_bits
    return r
  }
  if row == 31 { return mm_row(OP_MUL, m + 30, 7) }
  if row == 32 { return mm_row(OP_MUL_MAT, 8, m + 31) }
  if row == 33 {
    // A plain 64-way softmax, unit scale, **no mask** and no renormalization.
    mut r := mm_row(OP_SOFT_MAX, m + 32, -1)
    r.p0 = UNIT_SCALE_BITS
    r.p1 = MAX_BIAS_BITS
    return r
  }
  mut r := mm_row(OP_ARGSORT, m + 33, -1)
  r.p0 = 1
  return r
}

// Phase B, at R5E's slot base. The rows are R5D's `b_row` exactly — the router's decision is an
// **input** to this graph and not a node in it, which is what lets a constant table serve a
// data-dependent `U` — and the only differences are the slot numbers and the token count, which is
// `T_out(L)` and therefore `1` at the last layer.
fn mm_b_row(borrow g: Geometry, base: i64, tokens: i64, index: i64) -> MmRow {
  m := base
  used := g.n_expert_used
  if index == 0 {
    mut r := mm_row(OP_RESHAPE_3D, MM_SLOT_PROBS, -1)
    r.p0 = 1
    r.p1 = g.n_expert
    r.p2 = tokens
    return r
  }
  // The gather is over the **global** expert ids, because it indexes the full `n_expert`-way
  // softmax; the three `mul_mat_id` rows below use the **compact** ids, because they index the
  // routed union's stack. Section 2.3 measured what conflating them costs: every gate, up, swiglu
  // and down node still agrees with llama.cpp and the mixing weights are garbage.
  if index == 1 { return mm_row(OP_GET_ROWS, m + 0, MM_SLOT_TOPK) }
  if index == 2 {
    mut r := mm_row(OP_RESHAPE_3D, MM_SLOT_FFN_NORM, -1)
    r.p0 = g.n_embd
    r.p1 = 1
    r.p2 = tokens
    return r
  }
  if index == 3 {
    mut r := mm_row(OP_MUL_MAT_ID, MM_SLOT_GATE, m + 2)
    r.c = MM_SLOT_COMPACT
    return r
  }
  if index == 4 {
    mut r := mm_row(OP_MUL_MAT_ID, MM_SLOT_UP, m + 2)
    r.c = MM_SLOT_COMPACT
    return r
  }
  if index == 5 { return mm_row(OP_SWIGLU, m + 3, m + 4) }
  if index == 6 {
    mut r := mm_row(OP_MUL_MAT_ID, MM_SLOT_DOWN, m + 5)
    r.c = MM_SLOT_COMPACT
    return r
  }
  if index == 7 { return mm_row(OP_MUL, m + 6, m + 1) }
  if index < 8 + used {
    mut r := mm_row(OP_VIEW_2D, m + 7, -1)
    r.p0 = g.n_embd
    r.p1 = tokens
    r.p2 = 2
    r.p3 = 1
    r.p4 = index - 8
    return r
  }
  if index < 8 + 2 * used - 1 {
    step := index - (8 + used)
    left := if step == 0 { m + 8 } else { m + 8 + used + step - 1 }
    return mm_row(OP_ADD, left, m + 9 + step)
  }
  last := if used == 1 { m + 8 } else { m + 8 + 2 * used - 2 }
  return mm_row(OP_ADD, last, MM_SLOT_FFN_INP)
}

// The head's three rows, kept beside the other generators so one builder answers for all four
// tables.
fn mm_head_row(borrow g: Geometry, index: i64) -> MmRow {
  m := MM_A_NODE_BASE
  if index == 0 {
    mut r := mm_row(OP_RMS_NORM, MM_SLOT_CUR, -1)
    r.p0 = g.rms_eps_bits
    return r
  }
  if index == 1 { return mm_row(OP_MUL, m + 0, 0) }
  return mm_row(OP_MUL_MAT, 1, m + 1)
}

// ---------------------------------------------------------------------------------------------
// R6-OLMOE-DECODE — the decode phase-A table
//
// `docs/specs/r6-olmoe-decode.md` section 3.7. Thirty-seven rows: the prefill layer's thirty-five
// at `tokens = 1`, plus one `CONCAT` on K and one on V.
//
// The two concats are the whole mandatory topology change. A decode layer joins the plane's
// `n_past` real columns to the step's one new column, so the new column lands at index `n_past`.
// Item 63 constructs production decode graphs at that exact live width; the two PAD rows remain for
// a general wider table but are not issued when concat already has the requested width.
//
// K and V concatenate on **different** axes and the table says so per row. After row 16's `CONT_3D`
// K is `{head_dim, columns, n_head_kv}`, so its column axis is **1**; after row 22's `CONT_3D` V is
// `{columns, head_dim, n_head_kv}`, so its column axis is **0**. One shared constant here would be
// a silent transpose that every downstream shape check accepts.
//
// Rows 0 to 13 are `mm_a_row_head` at `tokens = 1`, byte for byte: the norm, the two QK-normed
// projections, `Vcur`, the three reshapes and the two RoPEs are `T`-independent, which is what lets
// one pair of write-back rows (`MM_K_ROW`, `MM_V_ROW`) serve the prefill and every step.
// ---------------------------------------------------------------------------------------------

// Rows 14 to 27: the attention, with two concatenations and conditional pads. Row 16's `CONT_3D`
// is `WHEN_ALWAYS` here where the prefill makes it `WHEN_WIDE`, because a concatenation needs a
// contiguous operand even when the requested width is already `n_past + 1`.
fn mm_decode_a_row_attention(borrow g: Geometry, n_past: i64, width: i64, row: i64) -> MmRow {
  m := MM_A_NODE_BASE
  if row == 14 {
    mut r := mm_row(OP_PERMUTE, m + 11, -1)
    r.p1 = 2
    r.p2 = 1
    r.p3 = 3
    return r
  }
  if row == 15 {
    mut r := mm_row(OP_PERMUTE, m + 6, -1)
    r.p1 = 2
    r.p2 = 1
    r.p3 = 3
    return r
  }
  if row == 16 {
    mut r := mm_row(OP_CONT_3D, m + 14, -1)
    r.p0 = g.head_dim
    r.p1 = 1
    r.p2 = g.n_head_kv
    return r
  }
  if row == 17 {
    mut r := mm_row(OP_CONCAT, MM_SLOT_KPAST, m + 16)
    r.p0 = 1
    r.when = WHEN_DECODE
    return r
  }
  if row == 18 {
    mut r := mm_row(OP_PAD, m + 17, -1)
    r.p1 = width - (n_past + 1)
    r.when = WHEN_WIDE
    return r
  }
  if row == 19 {
    mut r := mm_row(OP_MUL_MAT, m + 17, m + 15)
    r.alt_when = WHEN_WIDE
    r.alt_a = m + 18
    return r
  }
  if row == 20 {
    mut r := mm_row(OP_SOFT_MAX, m + 19, MM_SLOT_MASK)
    r.p0 = g.attn_scale_bits
    r.p1 = MAX_BIAS_BITS
    return r
  }
  if row == 21 {
    mut r := mm_row(OP_PERMUTE, m + 13, -1)
    r.p0 = 1
    r.p1 = 2
    r.p2 = 0
    r.p3 = 3
    return r
  }
  if row == 22 {
    mut r := mm_row(OP_CONT_3D, m + 21, -1)
    r.p0 = 1
    r.p1 = g.head_dim
    r.p2 = g.n_head_kv
    return r
  }
  if row == 23 {
    mut r := mm_row(OP_CONCAT, MM_SLOT_VPAST, m + 22)
    r.p0 = 0
    r.when = WHEN_DECODE
    return r
  }
  if row == 24 {
    mut r := mm_row(OP_PAD, m + 23, -1)
    r.p0 = width - (n_past + 1)
    r.when = WHEN_WIDE
    return r
  }
  if row == 25 {
    mut r := mm_row(OP_MUL_MAT, m + 23, m + 20)
    r.alt_when = WHEN_WIDE
    r.alt_a = m + 24
    return r
  }
  if row == 26 {
    mut r := mm_row(OP_PERMUTE, m + 25, -1)
    r.p1 = 2
    r.p2 = 1
    r.p3 = 3
    return r
  }
  mut r := mm_row(OP_CONT_3D, m + 26, -1)
  r.p0 = g.n_embd
  r.p1 = 1
  r.p2 = 1
  return r
}

// Rows 28 to 36: the prefill's rows 26 to 34, shifted by the two concatenations. The two `WHEN_LAST`
// narrowing rows are **kept** at `t = 1`, where `get_rows(x, [0])` is the identity: they cost two
// redundant nodes and keep one shape rule for both passes, which is `src/layer_qwen2.align`'s own
// decision for the same rows and the same reason. Section 2.2 measured that a decode graph does not
// narrow, so they compute nothing; they are not load-bearing and they are not free to be wrong.
fn mm_decode_a_row_tail(borrow g: Geometry, row: i64) -> MmRow {
  m := MM_A_NODE_BASE
  if row == 28 { return mm_row(OP_MUL_MAT, 6, m + 27) }
  if row == 29 {
    mut r := mm_row(OP_GET_ROWS, m + 28, MM_SLOT_OUT_IDS)
    r.when = WHEN_LAST
    return r
  }
  if row == 30 {
    mut r := mm_row(OP_GET_ROWS, MM_SLOT_CUR, MM_SLOT_OUT_IDS)
    r.when = WHEN_LAST
    return r
  }
  if row == 31 {
    mut r := mm_row(OP_ADD, m + 28, MM_SLOT_CUR)
    r.alt_when = WHEN_LAST
    r.alt_a = m + 29
    r.alt_b = m + 30
    return r
  }
  if row == 32 {
    mut r := mm_row(OP_RMS_NORM, m + 31, -1)
    r.p0 = g.rms_eps_bits
    return r
  }
  if row == 33 { return mm_row(OP_MUL, m + 32, 7) }
  if row == 34 { return mm_row(OP_MUL_MAT, 8, m + 33) }
  if row == 35 {
    // A plain 64-way softmax, unit scale, **no mask** and no renormalization — R5D's router,
    // unchanged, because nothing in the routing arithmetic is `T`-conditional.
    mut r := mm_row(OP_SOFT_MAX, m + 34, -1)
    r.p0 = UNIT_SCALE_BITS
    r.p1 = MAX_BIAS_BITS
    return r
  }
  mut r := mm_row(OP_ARGSORT, m + 35, -1)
  r.p0 = 1
  return r
}

MM_TABLE_EMBED := 0
MM_TABLE_A := 1
MM_TABLE_B := 2
MM_TABLE_HEAD := 3
MM_TABLE_DECODE_A := 4

fn mm_table_row(
  borrow g: Geometry,
  kind: i64,
  tokens: i64,
  width: i64,
  n_past: i64,
  base: i64,
  index: i64,
) -> MmRow {
  if kind == MM_TABLE_EMBED { return mm_row(OP_GET_ROWS, 0, MM_SLOT_TOKENS) }
  if kind == MM_TABLE_B { return mm_b_row(g, base, tokens, index) }
  if kind == MM_TABLE_HEAD { return mm_head_row(g, index) }
  if kind == MM_TABLE_DECODE_A {
    if index <= 13 { return mm_a_row_head(g, 1, index) }
    if index <= 27 { return mm_decode_a_row_attention(g, n_past, width, index) }
    return mm_decode_a_row_tail(g, index)
  }
  if index <= 13 { return mm_a_row_head(g, tokens, index) }
  if index <= 25 { return mm_a_row_attention(g, tokens, width, index) }
  return mm_a_row_tail(g, index)
}

// One loop, one row assigned once and pushed once: an owned `array<i64>` field cannot be replaced
// in place at this pin, which is R5A correction C9's shape forced on every column set here.
fn mm_table(
  borrow g: Geometry,
  kind: i64,
  count: i64,
  base: i64,
  tokens: i64,
  width: i64,
  n_past: i64,
) -> MmNodeTable {
  mut op: array_builder<i64> := array_builder()
  mut a: array_builder<i64> := array_builder()
  mut b: array_builder<i64> := array_builder()
  mut c: array_builder<i64> := array_builder()
  mut out: array_builder<i64> := array_builder()
  mut p0: array_builder<i64> := array_builder()
  mut p1: array_builder<i64> := array_builder()
  mut p2: array_builder<i64> := array_builder()
  mut p3: array_builder<i64> := array_builder()
  mut p4: array_builder<i64> := array_builder()
  mut when: array_builder<i64> := array_builder()
  mut alt_when: array_builder<i64> := array_builder()
  mut alt_a: array_builder<i64> := array_builder()
  mut alt_b: array_builder<i64> := array_builder()
  mut index := 0
  loop {
    if index >= count { break }
    r := mm_table_row(g, kind, tokens, width, n_past, base, index)
    op.push(r.op)
    a.push(r.a)
    b.push(r.b)
    c.push(r.c)
    out.push(base + index)
    p0.push(r.p0)
    p1.push(r.p1)
    p2.push(r.p2)
    p3.push(r.p3)
    p4.push(r.p4)
    when.push(r.when)
    alt_when.push(r.alt_when)
    alt_a.push(r.alt_a)
    alt_b.push(r.alt_b)
    index = index + 1
  }
  return MmNodeTable {
    count: count,
    base: base,
    op: op.build(),
    a: a.build(),
    b: b.build(),
    c: c.build(),
    out: out.build(),
    p0: p0.build(),
    p1: p1.build(),
    p2: p2.build(),
    p3: p3.build(),
    p4: p4.build(),
    when: when.build(),
    alt_when: alt_when.build(),
    alt_a: alt_a.build(),
    alt_b: alt_b.build(),
  }
}

pub fn mm_a_node_table(borrow g: Geometry, tokens: i64, width: i64) -> MmNodeTable {
  return mm_table(g, MM_TABLE_A, MM_A_NODE_COUNT, MM_A_NODE_BASE, tokens, width, 0)
}

pub fn mm_b_node_table(borrow g: Geometry, tokens: i64) -> MmNodeTable {
  return mm_table(g, MM_TABLE_B, b_node_count(g.n_expert_used), MM_B_NODE_BASE, tokens, 0, 0)
}

// R6-OLMOE-DECODE's two tables. Phase A is the thirty-seven-row decode topology at `n_past`; phase B
// is R5D's routed FFN, byte-identical in its rows and moved to `MM_DECODE_B_NODE_BASE` so the two
// decode ranges stay disjoint. Phase B never saw `T` except through three `p` parameters and it
// already runs at `t_out = 1` today, at layer 15 of every prefill.
pub fn mm_decode_a_node_table(borrow g: Geometry, n_past: i64, width: i64) -> MmNodeTable {
  return mm_table(
    g, MM_TABLE_DECODE_A, MM_DECODE_A_NODE_COUNT, MM_A_NODE_BASE, 1, width, n_past)
}

pub fn mm_decode_b_node_table(borrow g: Geometry) -> MmNodeTable {
  return mm_table(
    g, MM_TABLE_B, b_node_count(g.n_expert_used), MM_DECODE_B_NODE_BASE, 1, 0, 0)
}

pub fn mm_embed_node_table(borrow g: Geometry) -> MmNodeTable {
  return mm_table(g, MM_TABLE_EMBED, MM_EMBED_NODE_COUNT, MM_A_NODE_BASE, 0, 0, 0)
}

// `RMS_NORM`, `MUL(output_norm)`, `MUL_MAT(output)` — the three nodes the transcript names `norm`,
// `result_norm`, and `result_output`, **without a layer suffix** (section 2.2 consequence 3).
pub fn mm_head_node_table(borrow g: Geometry) -> MmNodeTable {
  return mm_table(g, MM_TABLE_HEAD, MM_HEAD_NODE_COUNT, MM_A_NODE_BASE, 0, 0, 0)
}

pub fn mm_a_output_slot() -> i64 = MM_A_NODE_BASE + MM_A_NODE_COUNT - 1

pub fn mm_b_output_slot(n_expert_used: i64) -> i64 =
MM_B_NODE_BASE + b_node_count(n_expert_used) - 1

pub fn mm_decode_a_output_slot() -> i64 = MM_A_NODE_BASE + MM_DECODE_A_NODE_COUNT - 1

pub fn mm_decode_b_output_slot(n_expert_used: i64) -> i64 =
MM_DECODE_B_NODE_BASE + b_node_count(n_expert_used) - 1

pub fn mm_embed_output_slot() -> i64 = MM_A_NODE_BASE

pub fn mm_head_output_slot() -> i64 = MM_A_NODE_BASE + MM_HEAD_NODE_COUNT - 1

// The causal mask at a declared width. Columns at or beyond `height` are `-inf` for every row,
// which is what makes the reconciliation pass's padded lanes contribute nothing.
pub fn mm_write_mask(borrow mut window: buffer, width: i64, height: i64) {
  mm_write_mask_offset(window, width, height, 0)
}

// R6-OLMOE-DECODE section 3.7, and `layer_qwen2.mf_write_mask_offset`'s reason unchanged: the same
// image with the row index **shifted**, so row `r` masks `col <= r + row_offset`.
//
// `mm_write_mask` is correct only when row `r` means position `r`, which is true of every prefill
// graph and false of every decode graph: a decode row is position `n_past` while its `row` is 0.
// Writing the prefill's rule at a decode step masks every past column and produces a confidently
// wrong answer that every shape check passes. `mm_write_mask` is defined as the `row_offset = 0`
// case, so R5E's bytes are unchanged by construction rather than by inspection.
pub fn mm_write_mask_offset(
  borrow mut window: buffer, width: i64, height: i64, row_offset: i64) {
  // A negative offset is unreachable — every caller passes `0` or `n_past >= 1` — but returning
  // without writing would leave the buffer's zero bits in place, and an all-zero mask is
  // `0.0f` everywhere, which is **unmasked everywhere**: a confidently wrong answer every shape
  // check accepts. Fail closed instead and write the fully masked image, which no oracle passes.
  masked := row_offset < 0
  mut row := 0
  loop {
    if row >= height { break }
    mut col := 0
    loop {
      if col >= width { break }
      bits := if !masked && col <= row + row_offset {
        MASK_ZERO_BITS
      } else {
        MASK_NEG_INFINITY_BITS
      }
      window.put_u32_le(bits as u32)
      col = col + 1
    }
    row = row + 1
  }
}

// ---------------------------------------------------------------------------------------------
// R5E's oracle table — one flat index space for the whole prefill
//
// `1 + 17 * n_layer + 2` rows: the embedding graph's `embd`, seventeen rows per layer, and the
// head's `result_norm` and `result_output`. Row addressing is arithmetic — `mm_oracle_layer_base(L)`
// — so no column has to carry the graph a row belongs to.
//
// Fourteen of the seventeen are element-compared, which is section 3.7's table; `kq-L` and
// `kq_soft_max-L` are `shape_incomparable` and exist so the declared `ne0` can be validated against
// `KV_WIDTH` in every layer; and `ffn_moe_topk-L` is `routing`, read by oracle 3 and by nothing
// else. `1 + 14 * n_layer + 2` is `nodes_expected`, which is **227** at this geometry.
// ---------------------------------------------------------------------------------------------

pub fn mm_oracle_layer_base(layer: i64) -> i64 = 1 + MM_LAYER_ORACLE_COUNT * layer

pub fn mm_oracle_head_base(n_layer: i64) -> i64 = 1 + MM_LAYER_ORACLE_COUNT * n_layer

pub fn mm_oracle_compared_count(n_layer: i64) -> i64 = 1 + 14 * n_layer + MM_HEAD_ORACLE_COUNT

// The row of `ffn_moe_topk-L` inside a layer's seventeen, which is the one the routing oracle reads.
pub fn mm_oracle_topk_row() -> i64 = 8

fn mm_oracle_stem_of(row: i64) -> str {
  if row == 0 { return "attn_norm" }
  if row == 1 { return "kq" }
  if row == 2 { return "kq_soft_max" }
  if row == 3 { return "ffn_inp" }
  if row == 4 { return "ffn_norm" }
  if row == 5 { return "ffn_moe_logits" }
  if row == 6 { return "ffn_moe_probs" }
  if row == 7 { return "ffn_moe_argsort" }
  if row == 8 { return "ffn_moe_topk" }
  if row == 9 { return "ffn_moe_weights" }
  if row == 10 { return "ffn_moe_gate" }
  if row == 11 { return "ffn_moe_up" }
  if row == 12 { return "ffn_moe_swiglu" }
  if row == 13 { return "ffn_moe_down" }
  if row == 14 { return "ffn_moe_weighted" }
  if row == 15 { return "ffn_moe_out" }
  return "l_out"
}

fn mm_oracle_op_of(n_expert_used: i64, row: i64) -> str {
  if row == 0 { return "MUL" }
  if row == 1 { return "MUL_MAT" }
  if row == 2 { return "SOFT_MAX" }
  if row == 3 { return "ADD" }
  if row == 4 { return "MUL" }
  if row == 5 { return "MUL_MAT" }
  if row == 6 { return "SOFT_MAX" }
  if row == 7 { return "ARGSORT" }
  if row == 8 { return "VIEW" }
  if row == 9 { return "GET_ROWS" }
  if row == 10 { return "MUL_MAT_ID" }
  if row == 11 { return "MUL_MAT_ID" }
  if row == 12 { return "SWIGLU" }
  if row == 13 { return "MUL_MAT_ID" }
  if row == 14 { return "MUL" }
  // At `n_expert_used == 1` the reduction is one view and `ffn_moe_out` prints as that view.
  if row == 15 { return if n_expert_used == 1 { "VIEW" } else { "ADD" } }
  return "ADD"
}

// The node slot each layer row observes, in the shared store. Phase A's and phase B's ranges are
// disjoint, which is what lets the routing decision read a phase-A node back while phase B is built.
// R6-OLMOE-DECODE. The decode table inserts two `CONCAT` rows at 17 and 23, so every phase-A row
// after the K path shifts — `kq` by one and `kq_soft_max` by one, then the whole tail by two — and
// phase B sits at `MM_DECODE_B_NODE_BASE`. The prefill answer is the `decode = false` case, so R5E's
// oracle slots are unchanged by construction.
fn mm_oracle_slot_at(n_expert_used: i64, row: i64, decode: bool) -> i64 {
  a := MM_A_NODE_BASE
  b := if decode { MM_DECODE_B_NODE_BASE } else { MM_B_NODE_BASE }
  if row == 0 { return a + 1 }
  if row == 1 { return if decode { a + 19 } else { a + 18 } }
  if row == 2 { return if decode { a + 20 } else { a + 19 } }
  if row == 3 { return if decode { a + 31 } else { a + 29 } }
  if row == 4 { return if decode { a + 33 } else { a + 31 } }
  if row == 5 { return if decode { a + 34 } else { a + 32 } }
  if row == 6 { return if decode { a + 35 } else { a + 33 } }
  if row == 7 { return if decode { a + 36 } else { a + 34 } }
  // `ffn_moe_topk` is a phase-B **input**, not a node: Align slices the top-k out of
  // `ffn_moe_argsort-L` and writes it, which is exactly the tensor the transcript's view holds.
  if row == 8 { return MM_SLOT_TOPK }
  if row == 9 { return b + 1 }
  if row == 10 { return b + 3 }
  if row == 11 { return b + 4 }
  if row == 12 { return b + 5 }
  if row == 13 { return b + 6 }
  if row == 14 { return b + 7 }
  if row == 15 {
    return if n_expert_used == 1 { b + 8 } else { b + 8 + 2 * n_expert_used - 2 }
  }
  return b + b_node_count(n_expert_used) - 1
}

fn mm_oracle_class_of(row: i64) -> i64 {
  // The instrument's `n_kv` is a padded cache width and R5E has no cache, so the two tensors are
  // different shapes and element comparison is undefined. Their declared `ne0` **is** validated
  // against `KV_WIDTH` in every layer, which is the one thing they are good for.
  if row == 1 || row == 2 { return ORACLE_SHAPE_INCOMPARABLE }
  if row == 8 { return ORACLE_ROUTING }
  return ORACLE_COMPARED
}

pub fn mm_oracle_table(borrow g: Geometry, n_layer: i64) -> OracleTable {
  return mm_oracle_table_at(g, n_layer, false)
}

// R6-OLMOE-DECODE. The same seventeen rows per layer against the decode slot map. The row grammar —
// names, ops, classes, the `ffn_moe_topk` routing row — is identical, because a decode graph
// computes the same nodes with the same names; only the slots the arm reads them back from move.
pub fn mm_oracle_table_at(borrow g: Geometry, n_layer: i64, decode: bool) -> OracleTable {
  body := builder()
  mut ids: array_builder<i64> := array_builder()
  mut id_ends: array_builder<i64> := array_builder()
  mut names: array_builder<i64> := array_builder()
  mut name_ends: array_builder<i64> := array_builder()
  mut ops: array_builder<i64> := array_builder()
  mut op_ends: array_builder<i64> := array_builder()
  mut slots: array_builder<i64> := array_builder()
  mut classes: array_builder<i64> := array_builder()
  mut weighted: array_builder<i64> := array_builder()
  mut integer: array_builder<i64> := array_builder()
  mut phase: array_builder<i64> := array_builder()
  used := g.n_expert_used
  head_base := mm_oracle_head_base(n_layer)
  count := head_base + MM_HEAD_ORACLE_COUNT
  mut cursor := 0
  mut at := 0
  loop {
    if at >= count { break }
    layer := if at <= 0 || at >= head_base { -1 } else { (at - 1) / MM_LAYER_ORACLE_COUNT }
    row := if layer < 0 { -1 } else { (at - 1) % MM_LAYER_ORACLE_COUNT }
    mut id_text := "embd".clone()
    mut op_text := "GET_ROWS".clone()
    mut class := ORACLE_COMPARED
    mut is_integer := 0
    mut slot_of := MM_A_NODE_BASE
    mut phase_b := 0
    n := builder()
    if at == 0 {
      n.write("embd")
    } else if at == head_base {
      id_text = "result_norm".clone()
      op_text = "MUL".clone()
      slot_of = MM_A_NODE_BASE + 1
      n.write("result_norm")
    } else if at > head_base {
      id_text = "result_output".clone()
      op_text = "MUL_MAT".clone()
      slot_of = MM_A_NODE_BASE + 2
      n.write("result_output")
    } else {
      stem := mm_oracle_stem_of(row)
      id_text = stem.clone()
      op_text = mm_oracle_op_of(used, row).clone()
      class = mm_oracle_class_of(row)
      is_integer = if row == 7 || row == 8 { 1 } else { 0 }
      slot_of = mm_oracle_slot_at(used, row, decode)
      phase_b = if row >= 8 { 1 } else { 0 }
      n.write(stem)
      n.write("-")
      n.write_int(layer)
    }
    name_text := n.to_string()
    id_view: str := id_text
    name_view: str := name_text
    op_view: str := op_text
    body.write(id_view)
    ids.push(cursor)
    cursor = cursor + id_view.len()
    id_ends.push(cursor)
    names.push(cursor)
    body.write(name_view)
    cursor = cursor + name_view.len()
    name_ends.push(cursor)
    ops.push(cursor)
    body.write(op_view)
    cursor = cursor + op_view.len()
    op_ends.push(cursor)
    slots.push(slot_of)
    classes.push(class)
    weighted.push(0)
    integer.push(is_integer)
    phase.push(phase_b)
    at = at + 1
  }
  return OracleTable {
    count: count,
    text: body.to_string(),
    id_start: ids.build(),
    id_end: id_ends.build(),
    name_start: names.build(),
    name_end: name_ends.build(),
    op_start: ops.build(),
    op_end: op_ends.build(),
    slot: slots.build(),
    class: classes.build(),
    by_weight: weighted.build(),
    integer: integer.build(),
    phase_b: phase.build(),
  }
}
