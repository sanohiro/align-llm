module runtime_generation

import ggml_ffi
import runtime_attention
import layer_olmoe
import layer_qwen2
import runtime_diagnostic
import runtime_device
import runtime_execution
import runtime_inputs
import runtime_kv
import runtime_numeric_stream
import runtime_memory
import runtime_olmoe
import runtime_olmoe_load
import runtime_options
import runtime_pack_identity
import runtime_qwen
import runtime_qwen_load
import runtime_sampler
import runtime_weights
import std.crypto
import std.encoding
import std.fs
import std.rand

MAX_EXTENT := 9223372036854775807
SLOT_BYTES := 1040
MAX_STAGING_BYTES := 16777216
PREFILL_MICROBATCH := 128
MASK_NEG_INFINITY_BITS := 4286578688

fn checked_add(left: i64, right: i64) -> Result<i64, Error> {
  if left < 0 || right < 0 || left > MAX_EXTENT - right { return Err(Error.Invalid) }
  return Ok(left + right)
}

fn checked_mul(left: i64, right: i64) -> Result<i64, Error> {
  if left < 0 || right < 0 || (right > 0 && left > MAX_EXTENT / right) {
    return Err(Error.Invalid)
  }
  return Ok(left * right)
}

fn digest(value: str) -> string {
  bytes := crypto.sha256(value)
  return encoding.hex_encode(bytes[0..bytes.len()]).clone()
}

fn signature(model_id: str, kind: i64, width: i64, height: i64) -> string {
  out := builder()
  out.write("g1:")
  out.write(model_id)
  out.write(":")
  out.write_int(kind)
  out.write(":")
  out.write_int(width)
  out.write(":")
  out.write_int(height)
  return digest(out.to_string())
}

fn topology(
  borrow options: runtime_options.RuntimeOptions,
  bundle_id: str,
  model_id: str,
  geometry: str,
  attention_policy: str,
  kind: i64,
  width: i64,
  height: i64,
  valid: i64,
  output_tokens: i64,
) -> Result<string, Error> {
  shape_base := signature(model_id, kind, width, height)
  identity := runtime_execution.TopologyIdentity {
    backend: options.backend.clone(),
    bundle_id: bundle_id.clone(),
    model_id: model_id.clone(),
    model_layout_sha256: digest(geometry),
    tensor_shape_stride_sha256: signature(shape_base, kind, valid, height),
    attention_policy: attention_policy.clone(),
  }
  invocation := runtime_execution.TopologyInvocation {
    graph_kind: kind,
    buffer_generation: 1,
    kv_view_width: width,
    query_width: height,
    mask_layout_sha256: signature("mask", kind, width, height),
    position_layout_sha256: signature("position", kind, width, height),
    output_selection_sha256: signature("output", kind, output_tokens, height),
  }
  return runtime_execution.topology_key(identity, invocation)
}

// Graph contexts retain every tensor created while the per-layer slot window is reused. The
// capacity therefore scales with model depth even though either architecture needs at most 128
// simultaneously addressable slots. These bounds include the embed/head tensors and, per layer,
// both resident-KV views and copy nodes.
fn qwen_graph_capacity(n_layer: i64) -> Result<i64, Error> {
  return checked_add(4, checked_mul(n_layer, 56)?)
}

fn olmoe_graph_capacity(n_layer: i64, n_expert_used: i64) -> Result<i64, Error> {
  per_layer := checked_add(56, layer_olmoe.b_node_count(n_expert_used))?
  return checked_add(4, checked_mul(n_layer, per_layer)?)
}

// Upper bounds on application-owned requested capacities, independently of native
// allocation counters. Array builders double from four elements; 24 bytes per
// i64 covers old/new realloc overlap. Fixed allowances cover small shells, file
// windows, topology serialization and pinned allocator bookkeeping.
fn application_capacity(weight_count: i64, pieces: i64, blocks: i64, graph_capacity: i64,
  geometry_bytes: i64, prompt: i64, mask_width: i64, lanes: i64, vocabulary: i64,
  generated: i64, observation_bytes: i64) -> Result<i64, Error> {
  plan_elements := checked_add(checked_mul(weight_count, 8)?, checked_mul(pieces, 3)?)?
  index_elements := checked_mul(blocks, 8)?
  arrays := checked_mul(checked_add(checked_add(plan_elements, index_elements)?, generated)?, 24)?
  prompt_images := checked_add(checked_mul(prompt, 8)?, checked_mul(checked_mul(prompt, mask_width)?, 4)?)?
  decode_images := checked_mul(checked_add(mask_width, lanes)?, 4)?
  outputs := checked_add(checked_mul(vocabulary, 4)?, observation_bytes)?
  graph_control := checked_add(checked_mul(graph_capacity, 2048)?, checked_mul(geometry_bytes, 128)?)?
  return checked_add(checked_add(checked_add(arrays, prompt_images)?, checked_add(decode_images, outputs)?)?,
    checked_add(graph_control, 262144 + SLOT_BYTES)?)
}

fn reserve_application(borrow owner: ggml_ffi.GpuDevice, bytes: i64) -> Result<(), Error> {
  ggml_ffi.gpu_host_reserve(owner, bytes) else { return Err(Error.Invalid) }
  return Ok(())
}

fn chunk_application(base: i64, width: i64, mask_width: i64) -> Result<i64, Error> {
  if width < 1 { return Err(Error.Invalid) }
  return checked_add(base, checked_mul(width - 1, checked_add(8, checked_mul(mask_width, 4)?)?)?)
}

fn prepare_memory(
  borrow owner: ggml_ffi.GpuDevice,
  borrow options: runtime_options.RuntimeOptions,
  weight_count: i64,
  weights_bytes: i64,
  kv_count: i64,
  kv_bytes: i64,
  legacy_cache_bytes: i64,
  graph_capacity: i64,
  observation_bytes: i64,
) -> Result<i64, Error> {
  tensor_count := checked_add(checked_add(weight_count, kv_count)?, runtime_qwen.INPUT_COUNT)?
  root_metadata := runtime_weights.metadata_bytes(tensor_count)
  graph_metadata := ggml_ffi.graph_context_bytes(graph_capacity)
  if root_metadata < 1 || graph_metadata < 1 { return Err(Error.Invalid) }
  metadata_bytes := checked_add(
    checked_add(root_metadata, checked_mul(graph_metadata, 2)?)?, 128)?
  device_used := checked_add(weights_bytes, kv_bytes)?
  if device_used >= options.device_budget_bytes {
    ggml_ffi.gpu_note_failure(ggml_ffi.GPU_STATUS_MEMORY_BUDGET, ggml_ffi.GPU_STAGE_PLAN)
    return Err(Error.Invalid)
  }
  workspace_bytes := options.device_budget_bytes - device_used
  host_used := checked_add(checked_add(metadata_bytes, legacy_cache_bytes)?, observation_bytes)?
  if host_used >= options.host_budget_bytes {
    ggml_ffi.gpu_note_failure(ggml_ffi.GPU_STATUS_MEMORY_BUDGET, ggml_ffi.GPU_STAGE_PLAN)
    return Err(Error.Invalid)
  }
  // Native staging and the Align loader window coexist. Buffer shell is separate.
  host_remaining := options.host_budget_bytes - host_used
  if host_remaining < 66 {
    ggml_ffi.gpu_note_failure(ggml_ffi.GPU_STATUS_MEMORY_BUDGET, ggml_ffi.GPU_STAGE_PLAN)
    return Err(Error.Invalid)
  }
  each_staging := (host_remaining - 64) / 2
  staging_bytes := if each_staging < MAX_STAGING_BYTES { each_staging } else { MAX_STAGING_BYTES }
  reserve_application(owner, checked_add(observation_bytes, staging_bytes + 64)?)?
  runtime_memory.admit(owner, runtime_memory.MemoryPlan {
      weights_bytes: weights_bytes,
      kv_bytes: kv_bytes,
      workspace_bytes: workspace_bytes,
      metadata_bytes: metadata_bytes,
      staging_bytes: staging_bytes,
      legacy_cache_bytes: legacy_cache_bytes,
    })?
  runtime_memory.allocate(owner)?
  return Ok(staging_bytes)
}

fn admit_qwen_shapes(
  borrow owner: ggml_ffi.GpuDevice,
  borrow options: runtime_options.RuntimeOptions,
  borrow g: layer_qwen2.Geometry,
  borrow plan: runtime_qwen_load.Plan,
  geometry_text: str,
  prompt_width: i64,
  diagnostic: bool,
  capacity: i64,
  graph_capacity: i64,
  observation_bytes: i64,
  legacy_cache_bytes: i64,
) -> Result<i64, Error> {
  mask_width := runtime_inputs.attention_width(capacity, g.context_length)?
  mut width := if prompt_width < PREFILL_MICROBATCH { prompt_width } else { PREFILL_MICROBATCH }
  loop {
    application := chunk_application(observation_bytes, width, mask_width)?
    result := admit_qwen_shapes_at(owner, options, g, plan, geometry_text, prompt_width,
      width, diagnostic, capacity, graph_capacity, application, legacy_cache_bytes)
    match result {
      Ok(_) => { return Ok(width) },
      Err(_) => {},
    }
    cause := ggml_ffi.gpu_last_failure()
    runtime_memory.plan_cancel(owner)?
    if cause.code != "MEMORY_BUDGET" || width == 1 || diagnostic { return Err(Error.Invalid) }
    ggml_ffi.gpu_failure_reset()
    // Descend the committed powers of two, skipping widths already clipped away.
    mut next := PREFILL_MICROBATCH
    loop {
      if next < width { break }
      next = next / 2
    }
    width = next
  }
}

fn admit_qwen_shapes_at(
  borrow owner: ggml_ffi.GpuDevice,
  borrow options: runtime_options.RuntimeOptions,
  borrow g: layer_qwen2.Geometry,
  borrow plan: runtime_qwen_load.Plan,
  geometry_text: str,
  prompt_width: i64,
  chunk_width: i64,
  diagnostic: bool,
  capacity: i64,
  graph_capacity: i64,
  observation_bytes: i64,
  legacy_cache_bytes: i64,
) -> Result<(), Error> {
  runtime_attention.select(owner, prompt_width, chunk_width, capacity, g.context_length, g.head_dim, g.n_head, g.n_head_kv)?
  runtime_memory.plan_begin(owner)?
  staging := prepare_memory(owner, options, plan.count, plan.weights_bytes,
    runtime_qwen.kv_count(g.n_layer), plan.kv_bytes, legacy_cache_bytes,
    graph_capacity, observation_bytes)?
  if staging < 1 { return Err(Error.Invalid) }
  runtime_qwen_load.define(owner, plan)?
  initialize_kv(owner, g.n_layer, g.head_dim, capacity, g.n_head_kv)?
  lanes := checked_mul(g.head_dim, g.n_head_kv)?
  mask_capacity := runtime_inputs.attention_width(capacity, g.context_length)?
  initialize_inputs(owner, chunk_width, mask_capacity, lanes)?
  graph_bytes := ggml_ffi.graph_context_bytes(graph_capacity)
  prefill_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_PREFILL, graph_bytes)
  decode_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_DECODE, graph_bytes)
  if ggml_ffi.handle_absent(prefill_ctx) || ggml_ffi.handle_absent(decode_ctx) {
    return Err(Error.Invalid)
  }
  mut slot_storage := slot_buffer()
  slot_view := slot_storage.bytes()
  mut capture := if diagnostic { runtime_diagnostic.create(g.n_layer, g.n_embd, prompt_width, 0, 0)? } else { runtime_diagnostic.disabled() }
  bundle_id := runtime_device.bundle_id(owner)
  mut offset := 0
  loop {
    if offset >= prompt_width { break }
    if offset > 0 { runtime_execution.invalidate(owner, ggml_ffi.GPU_GRAPH_PREFILL)? }
    count := if prompt_width - offset < chunk_width { prompt_width - offset } else { chunk_width }
    final_chunk := offset + count == prompt_width
    prefill_width := runtime_inputs.attention_width(offset + count, g.context_length)?
    prefill_graph := ggml_ffi.graph_new(prefill_ctx)
    if ggml_ffi.handle_absent(prefill_graph) { return Err(Error.Invalid) }
    runtime_qwen.build_prefill_chunk(owner, g, offset, count, final_chunk, prefill_ctx, prefill_graph, slot_view, capture)?
    prefill_key := topology(options, bundle_id, "qwen2", geometry_text, runtime_attention.name(owner),
      ggml_ffi.GPU_GRAPH_PREFILL, prefill_width, count, offset + count, if final_chunk { 1 } else { 0 })?
    runtime_execution.prepare(owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_key, prefill_graph)?
    offset = offset + count
  }
  mut n_past := prompt_width
  mut built := false
  loop {
    if n_past >= capacity { break }
    if built { runtime_execution.invalidate(owner, ggml_ffi.GPU_GRAPH_DECODE)? }
    width := runtime_inputs.attention_width(n_past + 1, g.context_length)?
    graph := ggml_ffi.graph_new(decode_ctx)
    if ggml_ffi.handle_absent(graph) { return Err(Error.Invalid) }
    runtime_qwen.build_decode_diagnostic(owner, g, n_past, capacity, decode_ctx, graph, slot_view, capture)?
    key := topology(options, bundle_id, "qwen2", geometry_text, runtime_attention.name(owner),
      ggml_ffi.GPU_GRAPH_DECODE, width, 1, if width < capacity { width } else { capacity }, 1)?
    runtime_execution.prepare(owner, ggml_ffi.GPU_GRAPH_DECODE, key, graph)?
    built = true
    n_past = width
  }
  if runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_DEVICE_TOTAL) != 0 {
    return Err(Error.Invalid)
  }
  return runtime_memory.plan_finish(owner)
}

fn admit_olmoe_shapes(
  borrow owner: ggml_ffi.GpuDevice,
  borrow options: runtime_options.RuntimeOptions,
  borrow g: layer_olmoe.Geometry,
  borrow plan: runtime_olmoe_load.Plan,
  geometry_text: str,
  prompt_width: i64,
  diagnostic: bool,
  capacity: i64,
  graph_capacity: i64,
  observation_bytes: i64,
  legacy_cache_bytes: i64,
) -> Result<i64, Error> {
  mask_width := runtime_inputs.attention_width(capacity, g.context_length)?
  mut width := if prompt_width < PREFILL_MICROBATCH { prompt_width } else { PREFILL_MICROBATCH }
  loop {
    application := chunk_application(observation_bytes, width, mask_width)?
    result := admit_olmoe_shapes_at(owner, options, g, plan, geometry_text, prompt_width,
      width, diagnostic, capacity, graph_capacity, application, legacy_cache_bytes)
    match result {
      Ok(_) => { return Ok(width) },
      Err(_) => {},
    }
    cause := ggml_ffi.gpu_last_failure()
    runtime_memory.plan_cancel(owner)?
    if cause.code != "MEMORY_BUDGET" || width == 1 || diagnostic { return Err(Error.Invalid) }
    ggml_ffi.gpu_failure_reset()
    // Descend the committed powers of two, skipping widths already clipped away.
    mut next := PREFILL_MICROBATCH
    loop {
      if next < width { break }
      next = next / 2
    }
    width = next
  }
}

fn admit_olmoe_shapes_at(
  borrow owner: ggml_ffi.GpuDevice,
  borrow options: runtime_options.RuntimeOptions,
  borrow g: layer_olmoe.Geometry,
  borrow plan: runtime_olmoe_load.Plan,
  geometry_text: str,
  prompt_width: i64,
  chunk_width: i64,
  diagnostic: bool,
  capacity: i64,
  graph_capacity: i64,
  observation_bytes: i64,
  legacy_cache_bytes: i64,
) -> Result<(), Error> {
  runtime_attention.select(owner, prompt_width, chunk_width, capacity, g.context_length, g.head_dim, g.n_head, g.n_head_kv)?
  runtime_memory.plan_begin(owner)?
  staging := prepare_memory(owner, options, plan.count, plan.weights_bytes,
    runtime_olmoe.kv_count(g.n_layer), plan.kv_bytes, legacy_cache_bytes,
    graph_capacity, observation_bytes)?
  if staging < 1 { return Err(Error.Invalid) }
  runtime_olmoe_load.define(owner, plan)?
  initialize_kv(owner, g.n_layer, g.head_dim, capacity, g.n_head_kv)?
  lanes := checked_mul(g.head_dim, g.n_head_kv)?
  mask_capacity := runtime_inputs.attention_width(capacity, g.context_length)?
  initialize_inputs(owner, chunk_width, mask_capacity, lanes)?
  graph_bytes := ggml_ffi.graph_context_bytes(graph_capacity)
  prefill_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_PREFILL, graph_bytes)
  decode_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_DECODE, graph_bytes)
  if ggml_ffi.handle_absent(prefill_ctx) || ggml_ffi.handle_absent(decode_ctx) {
    return Err(Error.Invalid)
  }
  mut slot_storage := slot_buffer()
  slot_view := slot_storage.bytes()
  mut capture := if diagnostic { runtime_diagnostic.create(g.n_layer, g.n_embd, prompt_width, g.n_expert, g.n_expert_used)? } else { runtime_diagnostic.disabled() }
  bundle_id := runtime_device.bundle_id(owner)
  mut offset := 0
  loop {
    if offset >= prompt_width { break }
    if offset > 0 { runtime_execution.invalidate(owner, ggml_ffi.GPU_GRAPH_PREFILL)? }
    count := if prompt_width - offset < chunk_width { prompt_width - offset } else { chunk_width }
    final_chunk := offset + count == prompt_width
    prefill_width := runtime_inputs.attention_width(offset + count, g.context_length)?
    prefill_graph := ggml_ffi.graph_new(prefill_ctx)
    if ggml_ffi.handle_absent(prefill_graph) { return Err(Error.Invalid) }
    runtime_olmoe.build_prefill_chunk(owner, g, offset, count, final_chunk, prefill_ctx, prefill_graph, slot_view, capture)?
    prefill_key := topology(options, bundle_id, "olmoe", geometry_text, runtime_attention.name(owner),
      ggml_ffi.GPU_GRAPH_PREFILL, prefill_width, count, offset + count, if final_chunk { 1 } else { 0 })?
    runtime_execution.prepare(owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_key, prefill_graph)?
    offset = offset + count
  }
  mut n_past := prompt_width
  mut built := false
  loop {
    if n_past >= capacity { break }
    if built { runtime_execution.invalidate(owner, ggml_ffi.GPU_GRAPH_DECODE)? }
    width := runtime_inputs.attention_width(n_past + 1, g.context_length)?
    graph := ggml_ffi.graph_new(decode_ctx)
    if ggml_ffi.handle_absent(graph) { return Err(Error.Invalid) }
    runtime_olmoe.build_decode_diagnostic(owner, g, n_past, capacity, decode_ctx, graph, slot_view, capture)?
    key := topology(options, bundle_id, "olmoe", geometry_text, runtime_attention.name(owner),
      ggml_ffi.GPU_GRAPH_DECODE, width, 1, if width < capacity { width } else { capacity }, 1)?
    runtime_execution.prepare(owner, ggml_ffi.GPU_GRAPH_DECODE, key, graph)?
    built = true
    n_past = width
  }
  if runtime_memory.allocated_bytes(owner, ggml_ffi.GPU_MEMORY_DEVICE_TOTAL) != 0 {
    return Err(Error.Invalid)
  }
  return runtime_memory.plan_finish(owner)
}

fn initialize_kv(
  borrow owner: ggml_ffi.GpuDevice,
  n_layer: i64,
  head_dim: i64,
  context_length: i64,
  n_head_kv: i64,
) -> Result<(), Error> {
  count := checked_mul(n_layer, 2)?
  runtime_kv.begin(owner, count)?
  mut layer := 0
  loop {
    if layer >= n_layer { break }
    k := runtime_kv.add(owner, runtime_kv.Shape {
        ggml_type: 0, n_dims: 3, ne0: head_dim, ne1: context_length,
        ne2: n_head_kv, ne3: 1,
      })?
    v := runtime_kv.add(owner, runtime_kv.Shape {
        ggml_type: 0, n_dims: 3,
        ne0: if runtime_attention.fused(owner) { head_dim } else { context_length },
        ne1: if runtime_attention.fused(owner) { context_length } else { head_dim },
        ne2: n_head_kv, ne3: 1,
      })?
    if k != 2 * layer || v != 2 * layer + 1 { return Err(Error.Invalid) }
    layer = layer + 1
  }
  return runtime_kv.finish(owner)
}

fn initialize_inputs(
  borrow owner: ggml_ffi.GpuDevice,
  prompt_count: i64,
  context_length: i64,
  v_lanes: i64,
) -> Result<(), Error> {
  runtime_inputs.begin(owner, runtime_qwen.INPUT_COUNT)?
  tokens := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: prompt_count, ne1: 1, ne2: 1, ne3: 1,
    })?
  positions := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: prompt_count, ne1: 1, ne2: 1, ne3: 1,
    })?
  mask := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 0, n_dims: 2, ne0: context_length, ne1: prompt_count, ne2: 1, ne3: 1,
    })?
  decode_token := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 1, ne1: 1, ne2: 1, ne3: 1,
    })?
  decode_position := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 1, ne1: 1, ne2: 1, ne3: 1,
    })?
  decode_mask := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 0, n_dims: 2, ne0: context_length, ne1: 1, ne2: 1, ne3: 1,
    })?
  output_id := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 1, ne1: 1, ne2: 1, ne3: 1,
    })?
  v_indices := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: v_lanes, ne1: 1, ne2: 1, ne3: 1,
    })?
  if tokens != 0 || positions != 1 || mask != 2 || decode_token != 3
    || decode_position != 4 || decode_mask != 5 || output_id != 6 || v_indices != 7 {
    return Err(Error.Invalid)
  }
  return runtime_inputs.finish(owner)
}

fn slot_buffer() -> buffer {
  mut storage := buffer(SLOT_BYTES)
  mut at := 0
  loop {
    if at >= SLOT_BYTES / 4 { break }
    storage.put_u32_le(0)
    at = at + 1
  }
  return storage
}

fn update_prompt(
  borrow owner: ggml_ffi.GpuDevice,
  borrow prompt_ids: array<i64>,
  n_vocab: i64,
  position: i64,
  tokens: i64,
  width: i64,
) -> Result<(), Error> {
  if position < 0 || tokens < 1 || position > prompt_ids.len() || tokens > prompt_ids.len() - position { return Err(Error.Invalid) }
  mut token_image := buffer(checked_mul(tokens, 4)?)
  mut position_image := buffer(checked_mul(tokens, 4)?)
  mut at := 0
  loop {
    if at >= tokens { break }
    if prompt_ids[position + at] < 0 || prompt_ids[position + at] >= n_vocab { return Err(Error.Invalid) }
    token_image.put_u32_le(prompt_ids[position + at] as u32)
    position_image.put_u32_le((position + at) as u32)
    at = at + 1
  }
  mut mask_image := buffer(checked_mul(checked_mul(tokens, width)?, 4)?)
  mut row := 0
  loop {
    if row >= tokens { break }
    mut col := 0
    loop {
      if col >= width { break }
      mask_image.put_u32_le(if col <= position + row { 0 } else { MASK_NEG_INFINITY_BITS as u32 })
      col = col + 1
    }
    row = row + 1
  }
  mut output_image := buffer(4)
  output_image.put_u32_le((tokens - 1) as u32)
  token_view := token_image.bytes()
  position_view := position_image.bytes()
  mask_view := mask_image.bytes()
  output_view := output_image.bytes()
  runtime_inputs.update(owner, 0, 0, token_view)?
  runtime_inputs.update(owner, 1, 0, position_view)?
  runtime_inputs.update(owner, 2, 0, mask_view)?
  return runtime_inputs.update(owner, 6, 0, output_view)
}

fn update_decode(
  borrow owner: ggml_ffi.GpuDevice,
  token: i64,
  n_past: i64,
  context_length: i64,
  capacity: i64,
  v_lanes: i64,
) -> Result<(), Error> {
  mut token_image := buffer(4)
  token_image.put_u32_le(token as u32)
  mut position_image := buffer(4)
  position_image.put_u32_le(n_past as u32)
  mut mask_image := buffer(checked_mul(context_length, 4)?)
  mut col := 0
  loop {
    if col >= context_length { break }
    mask_image.put_u32_le(if col <= n_past { 0 } else { MASK_NEG_INFINITY_BITS as u32 })
    col = col + 1
  }
  mut output_image := buffer(4)
  output_image.put_u32_le(0)
  mut v_image := buffer(checked_mul(v_lanes, 4)?)
  mut lane := 0
  loop {
    if lane >= v_lanes { break }
    index := checked_add(checked_mul(lane, capacity)?, n_past)?
    if index > 2147483647 { return Err(Error.Invalid) }
    v_image.put_u32_le(index as u32)
    lane = lane + 1
  }
  v_view := v_image.bytes()
  token_view := token_image.bytes()
  position_view := position_image.bytes()
  mask_view := mask_image.bytes()
  output_view := output_image.bytes()
  runtime_inputs.update(owner, 3, 0, token_view)?
  runtime_inputs.update(owner, 4, 0, position_view)?
  runtime_inputs.update(owner, 7, 0, v_view)?
  runtime_inputs.update(owner, 5, 0, mask_view)?
  return runtime_inputs.update(owner, 6, 0, output_view)
}

fn finite_f32(borrow logits: slice<u8>, offset: i64) -> bool {
  bits := logits.u32_le(offset)
  return (bits / 8388608) % 256 != 255
}

fn greedy(borrow logits: slice<u8>) -> Result<i64, Error> {
  if logits.len() < 4 || logits.len() % 4 != 0 { return Err(Error.Invalid) }
  mut best := -1
  mut best_value := 0.0 as f32
  mut token := 0
  loop {
    if token >= logits.len() / 4 { break }
    offset := token * 4
    if !finite_f32(logits, offset) { return Err(Error.Invalid) }
    value := logits.f32_le(offset)
    if best < 0 || value > best_value {
      best = token
      best_value = value
    }
    token = token + 1
  }
  if best < 0 { return Err(Error.Invalid) }
  return Ok(best)
}

fn choose_token(
  borrow logits: slice<u8>, sampled: bool, borrow mut random: rng,
) -> Result<i64, Error> {
  if sampled {
    selected := runtime_sampler.select(logits, random)?
    return Ok(selected.token_id)
  }
  return greedy(logits)
}

fn contains(borrow ids: array<i64>, value: i64) -> bool {
  mut at := 0
  loop {
    if at >= ids.len() { break }
    if ids[at] == value { return true }
    at = at + 1
  }
  return false
}

fn logits_buffer(n_vocab: i64) -> Result<buffer, Error> {
  bytes := checked_mul(n_vocab, 4)?
  mut logits := buffer(bytes)
  mut at := 0
  loop {
    if at >= n_vocab { break }
    logits.put_u32_le(0)
    at = at + 1
  }
  return Ok(logits)
}

pub fn generate_qwen(
  borrow owner: ggml_ffi.GpuDevice,
  borrow options: runtime_options.RuntimeOptions,
  pack_path: str,
  borrow source_identity: runtime_pack_identity.SourceIdentity,
  geometry_text: str,
  borrow prompt_ids: array<i64>,
  borrow eog_ids: array<i64>,
  max_tokens: i64,
) -> Result<array<i64>, Error> {
  mut stream := runtime_numeric_stream.disabled()
  return generate_qwen_observed(owner, options, pack_path, source_identity, geometry_text, prompt_ids, eog_ids, max_tokens, stream)
}

pub fn generate_qwen_observed(
  borrow owner: ggml_ffi.GpuDevice,
  borrow options: runtime_options.RuntimeOptions,
  pack_path: str,
  borrow source_identity: runtime_pack_identity.SourceIdentity,
  geometry_text: str,
  borrow prompt_ids: array<i64>,
  borrow eog_ids: array<i64>,
  max_tokens: i64,
  borrow mut stream: runtime_numeric_stream.Stream,
) -> Result<array<i64>, Error> {
  mut ids: array_builder<i64> := array_builder()
  forced := ids.build()
  return generate_qwen_mode(owner, options, pack_path, source_identity, geometry_text, prompt_ids, eog_ids, max_tokens, stream, false, forced)
}

pub fn generate_qwen_diagnostic(
  borrow owner: ggml_ffi.GpuDevice,
  borrow options: runtime_options.RuntimeOptions,
  pack_path: str,
  borrow source_identity: runtime_pack_identity.SourceIdentity,
  geometry_text: str,
  borrow prompt_ids: array<i64>,
  borrow eog_ids: array<i64>,
  max_tokens: i64,
  borrow mut stream: runtime_numeric_stream.Stream,
  borrow forced_ids: array<i64>,
) -> Result<array<i64>, Error> {
  return generate_qwen_mode(owner, options, pack_path, source_identity, geometry_text, prompt_ids, eog_ids, max_tokens, stream, true, forced_ids)
}

fn generate_qwen_mode(
  borrow owner: ggml_ffi.GpuDevice,
  borrow options: runtime_options.RuntimeOptions,
  pack_path: str,
  borrow source_identity: runtime_pack_identity.SourceIdentity,
  geometry_text: str,
  borrow prompt_ids: array<i64>,
  borrow eog_ids: array<i64>,
  max_tokens: i64,
  borrow mut stream: runtime_numeric_stream.Stream,
  diagnostic: bool,
  borrow forced_ids: array<i64>,
) -> Result<array<i64>, Error> {
  reserve_application(owner, checked_add(262144, checked_mul(geometry_text.len(), 128)?)?)?
  g := layer_qwen2.parse_geometry(geometry_text)
  forced := diagnostic && forced_ids.len() > 0
  if forced_ids.len() > 4096 || (!diagnostic && forced_ids.len() != 0) { return Err(Error.Invalid) }
  mut forced_index := 0
  loop {
    if forced_index >= forced_ids.len() { break }
    if forced_ids[forced_index] < 0 || forced_ids[forced_index] >= g.n_vocab { return Err(Error.Invalid) }
    forced_index = forced_index + 1
  }
  decode_steps := if forced { forced_ids.len() } else {
    if max_tokens > 1 { max_tokens - 1 } else { 0 }
  }
  kv_capacity := prompt_ids.len() + decode_steps
  if g.code.len() != 0 || prompt_ids.len() < 1 || prompt_ids.len() > 2048
    || max_tokens < 1 || max_tokens > 128
    || kv_capacity > g.context_length {
    return Err(Error.Invalid)
  }
  v_lanes := checked_mul(g.head_dim, g.n_head_kv)?
  if checked_mul(v_lanes, kv_capacity)? > 2147483647 { return Err(Error.Invalid) }
  graph_capacity := qwen_graph_capacity(g.n_layer)?
  capture_bytes := if diagnostic { runtime_diagnostic.required_bytes(g.n_layer, g.n_embd, prompt_ids.len(), 0, 0)? } else { 0 }
  stream_capture := checked_add(runtime_numeric_stream.reservation(stream), capture_bytes)?
  maximum_blocks := checked_add(2, checked_mul(g.n_layer, 2)?)?
  maximum_pieces := 0
  mask_bound := runtime_inputs.attention_width(kv_capacity, g.context_length)?
  observation_bytes := application_capacity(runtime_qwen.weight_count(g.n_layer), maximum_pieces,
    maximum_blocks, graph_capacity, geometry_text.len(), 1, mask_bound,
    v_lanes, g.n_vocab, decode_steps + 1, stream_capture)?
  reserve_application(owner, observation_bytes)?
  pack := fs.open_rw(pack_path)?
  runtime_pack_identity.verify_file_bounded(pack, source_identity, maximum_blocks)?
  plan := runtime_qwen_load.build_plan_file_capacity_bounded(owner, pack, g, kv_capacity, maximum_blocks)?
  chunk_width := admit_qwen_shapes(owner, options, g, plan, geometry_text, prompt_ids.len(), diagnostic, kv_capacity,
    graph_capacity, observation_bytes, 0)?
  application_bytes := chunk_application(observation_bytes, chunk_width, mask_bound)?
  staging := prepare_memory(
    owner, options, plan.count, plan.weights_bytes, runtime_qwen.kv_count(g.n_layer),
    plan.kv_bytes, 0, graph_capacity, application_bytes)?
  mut capture := if diagnostic { runtime_diagnostic.create(g.n_layer, g.n_embd, prompt_ids.len(), 0, 0)? } else { runtime_diagnostic.disabled() }
  runtime_qwen_load.load_file(owner, pack, plan, staging)?
  initialize_kv(owner, g.n_layer, g.head_dim, kv_capacity, g.n_head_kv)?
  mask_capacity := runtime_inputs.attention_width(kv_capacity, g.context_length)?
  initialize_inputs(owner, chunk_width, mask_capacity, v_lanes)?
  graph_bytes := ggml_ffi.graph_context_bytes(graph_capacity)
  prefill_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_PREFILL, graph_bytes)
  decode_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_DECODE, graph_bytes)
  if ggml_ffi.handle_absent(prefill_ctx) || ggml_ffi.handle_absent(decode_ctx) {
    return Err(Error.Invalid)
  }
  mut slot_storage := slot_buffer()
  mut slot_view := slot_storage.bytes()
  bundle_id := runtime_device.bundle_id(owner)
  mut prompt_offset := 0
  loop {
    if prompt_offset >= prompt_ids.len() { break }
    if prompt_offset > 0 { runtime_execution.invalidate(owner, ggml_ffi.GPU_GRAPH_PREFILL)? }
    count := if prompt_ids.len() - prompt_offset < chunk_width { prompt_ids.len() - prompt_offset } else { chunk_width }
    final_chunk := prompt_offset + count == prompt_ids.len()
    prefill_width := runtime_inputs.attention_width(prompt_offset + count, g.context_length)?
    prefill_graph := ggml_ffi.graph_new(prefill_ctx)
    if ggml_ffi.handle_absent(prefill_graph) { return Err(Error.Invalid) }
    runtime_qwen.build_prefill_chunk(owner, g, prompt_offset, count, final_chunk, prefill_ctx, prefill_graph, slot_view, capture)?
    prefill_key := topology(options, bundle_id, "qwen2", geometry_text, runtime_attention.name(owner),
      ggml_ffi.GPU_GRAPH_PREFILL, prefill_width, count, prompt_offset + count, if final_chunk { 1 } else { 0 })?
    runtime_execution.prepare(owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_key, prefill_graph)?
    update_prompt(owner, prompt_ids, g.n_vocab, prompt_offset, count, prefill_width)?
    runtime_execution.compute(owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_key, prefill_graph)?
    if diagnostic { runtime_diagnostic.write_chunk(capture, count, final_chunk, stream)? }
    prompt_offset = prompt_offset + count
  }
  mut logits := logits_buffer(g.n_vocab)?
  logits_view := logits.bytes()
  ggml_ffi.gpu_slot_get(
    owner, slot_view, runtime_qwen.output_slot(), logits_view, 0, logits_view.len(), "qwen_logits",
  ) else { return Err(Error.Invalid) }
  mut random := rand.seed_with(0)
  runtime_numeric_stream.record(stream, runtime_numeric_stream.Frame {
      kind: if diagnostic { 6 } else { 1 }, layer: 4294967295, step: 0, width: g.n_vocab, height: 1,
    }, logits_view)?
  mut token := choose_token(logits_view, false, random)?
  mut generated: array_builder<i64> := array_builder()
  generated.push(token)
  mut count := 1
  mut n_past := prompt_ids.len()
  mut decode_width := 0
  mut decode_graph := ggml_ffi.null_handle()
  mut decode_key := "".clone()
  loop {
    if forced {
      if count > forced_ids.len() { break }
    } else {
      if count >= max_tokens || contains(eog_ids, token) { break }
    }
    current_width := runtime_inputs.attention_width(n_past + 1, g.context_length)?
    if current_width != decode_width {
      if decode_width > 0 { runtime_execution.invalidate(owner, ggml_ffi.GPU_GRAPH_DECODE)? }
      decode_graph = ggml_ffi.graph_new(decode_ctx)
      if ggml_ffi.handle_absent(decode_graph) { return Err(Error.Invalid) }
      runtime_qwen.build_decode_diagnostic(owner, g, n_past, kv_capacity, decode_ctx, decode_graph, slot_view, capture)?
      decode_key = topology(
        options, bundle_id, "qwen2", geometry_text, runtime_attention.name(owner), ggml_ffi.GPU_GRAPH_DECODE,
        current_width, 1, if current_width < kv_capacity { current_width } else { kv_capacity }, 1)?
      runtime_execution.prepare(owner, ggml_ffi.GPU_GRAPH_DECODE, decode_key, decode_graph)?
      decode_width = current_width
    }
    input_token := if forced { forced_ids[count - 1] } else { token }
    update_decode(owner, input_token, n_past, current_width, kv_capacity, v_lanes)?
    runtime_execution.compute(owner, ggml_ffi.GPU_GRAPH_DECODE, decode_key, decode_graph)?
    ggml_ffi.gpu_slot_get(
      owner, slot_view, runtime_qwen.output_slot(), logits_view, 0, logits_view.len(), "qwen_logits",
    ) else { return Err(Error.Invalid) }
    if diagnostic { runtime_diagnostic.write(capture, count, stream)? }
    runtime_numeric_stream.record(stream, runtime_numeric_stream.Frame {
        kind: if diagnostic { 6 } else { 1 }, layer: 4294967295, step: count, width: g.n_vocab, height: 1,
      }, logits_view)?
    token = choose_token(logits_view, false, random)?
    generated.push(token)
    count = count + 1
    n_past = n_past + 1
  }
  runtime_device.synchronize(owner)?
  return Ok(generated.build())
}

pub fn generate_olmoe(
  borrow owner: ggml_ffi.GpuDevice,
  borrow options: runtime_options.RuntimeOptions,
  pack_path: str,
  borrow source_identity: runtime_pack_identity.SourceIdentity,
  geometry_text: str,
  borrow prompt_ids: array<i64>,
  borrow eog_ids: array<i64>,
  max_tokens: i64,
  legacy_cache_bytes: i64,
  seed: Option<i64>,
) -> Result<array<i64>, Error> {
  mut stream := runtime_numeric_stream.disabled()
  return generate_olmoe_observed(owner, options, pack_path, source_identity, geometry_text, prompt_ids, eog_ids, max_tokens, legacy_cache_bytes, seed, stream)
}

pub fn generate_olmoe_observed(
  borrow owner: ggml_ffi.GpuDevice,
  borrow options: runtime_options.RuntimeOptions,
  pack_path: str,
  borrow source_identity: runtime_pack_identity.SourceIdentity,
  geometry_text: str,
  borrow prompt_ids: array<i64>,
  borrow eog_ids: array<i64>,
  max_tokens: i64,
  legacy_cache_bytes: i64,
  seed: Option<i64>,
  borrow mut stream: runtime_numeric_stream.Stream,
) -> Result<array<i64>, Error> {
  mut ids: array_builder<i64> := array_builder()
  forced := ids.build()
  return generate_olmoe_mode(owner, options, pack_path, source_identity, geometry_text, prompt_ids, eog_ids, max_tokens, legacy_cache_bytes, seed, stream, false, forced)
}

pub fn generate_olmoe_diagnostic(
  borrow owner: ggml_ffi.GpuDevice,
  borrow options: runtime_options.RuntimeOptions,
  pack_path: str,
  borrow source_identity: runtime_pack_identity.SourceIdentity,
  geometry_text: str,
  borrow prompt_ids: array<i64>,
  borrow eog_ids: array<i64>,
  max_tokens: i64,
  legacy_cache_bytes: i64,
  seed: Option<i64>,
  borrow mut stream: runtime_numeric_stream.Stream,
  borrow forced_ids: array<i64>,
) -> Result<array<i64>, Error> {
  return generate_olmoe_mode(owner, options, pack_path, source_identity, geometry_text, prompt_ids, eog_ids, max_tokens, legacy_cache_bytes, seed, stream, true, forced_ids)
}

fn generate_olmoe_mode(
  borrow owner: ggml_ffi.GpuDevice,
  borrow options: runtime_options.RuntimeOptions,
  pack_path: str,
  borrow source_identity: runtime_pack_identity.SourceIdentity,
  geometry_text: str,
  borrow prompt_ids: array<i64>,
  borrow eog_ids: array<i64>,
  max_tokens: i64,
  legacy_cache_bytes: i64,
  seed: Option<i64>,
  borrow mut stream: runtime_numeric_stream.Stream,
  diagnostic: bool,
  borrow forced_ids: array<i64>,
) -> Result<array<i64>, Error> {
  reserve_application(owner, checked_add(262144, checked_mul(geometry_text.len(), 128)?)?)?
  g := layer_olmoe.parse_geometry(geometry_text)
  forced := diagnostic && forced_ids.len() > 0
  if forced_ids.len() > 4096 || (!diagnostic && forced_ids.len() != 0) { return Err(Error.Invalid) }
  mut forced_index := 0
  loop {
    if forced_index >= forced_ids.len() { break }
    if forced_ids[forced_index] < 0 || forced_ids[forced_index] >= g.n_vocab { return Err(Error.Invalid) }
    forced_index = forced_index + 1
  }
  decode_steps := if forced { forced_ids.len() } else {
    if max_tokens > 1 { max_tokens - 1 } else { 0 }
  }
  kv_capacity := prompt_ids.len() + decode_steps
  if g.code.len() != 0 || prompt_ids.len() < 1 || prompt_ids.len() > 2048
    || max_tokens < 1 || max_tokens > 128
    || kv_capacity > g.context_length {
    return Err(Error.Invalid)
  }
  v_lanes := checked_mul(g.head_dim, g.n_head_kv)?
  if checked_mul(v_lanes, kv_capacity)? > 2147483647 { return Err(Error.Invalid) }
  graph_capacity := olmoe_graph_capacity(g.n_layer, g.n_expert_used)?
  capture_bytes := if diagnostic { runtime_diagnostic.required_bytes(g.n_layer, g.n_embd, prompt_ids.len(), g.n_expert, g.n_expert_used)? } else { 0 }
  stream_capture := checked_add(runtime_numeric_stream.reservation(stream), capture_bytes)?
  maximum_blocks := checked_add(2, checked_mul(g.n_layer, checked_add(2, g.n_expert)?)?)?
  maximum_pieces := checked_add(3, checked_mul(g.n_layer, checked_add(9, checked_mul(3, g.n_expert)?)?)?)?
  mask_bound := runtime_inputs.attention_width(kv_capacity, g.context_length)?
  observation_bytes := application_capacity(runtime_olmoe.weight_count(g.n_layer), maximum_pieces,
    maximum_blocks, graph_capacity, geometry_text.len(), 1, mask_bound,
    v_lanes, g.n_vocab, decode_steps + 1, stream_capture)?
  reserve_application(owner, observation_bytes)?
  pack := fs.open_rw(pack_path)?
  runtime_pack_identity.verify_file_bounded(pack, source_identity, maximum_blocks)?
  plan := runtime_olmoe_load.build_plan_file_capacity_bounded(owner, pack, g, kv_capacity, maximum_blocks)?
  chunk_width := admit_olmoe_shapes(owner, options, g, plan, geometry_text, prompt_ids.len(), diagnostic, kv_capacity,
    graph_capacity, observation_bytes, legacy_cache_bytes)?
  application_bytes := chunk_application(observation_bytes, chunk_width, mask_bound)?
  staging := prepare_memory(
    owner, options, plan.count, plan.weights_bytes, runtime_olmoe.kv_count(g.n_layer),
    plan.kv_bytes, legacy_cache_bytes, graph_capacity, application_bytes)?
  mut capture := if diagnostic { runtime_diagnostic.create(g.n_layer, g.n_embd, prompt_ids.len(), g.n_expert, g.n_expert_used)? } else { runtime_diagnostic.disabled() }
  runtime_olmoe_load.load_file(owner, pack, plan, staging)?
  initialize_kv(owner, g.n_layer, g.head_dim, kv_capacity, g.n_head_kv)?
  mask_capacity := runtime_inputs.attention_width(kv_capacity, g.context_length)?
  initialize_inputs(owner, chunk_width, mask_capacity, v_lanes)?
  graph_bytes := ggml_ffi.graph_context_bytes(graph_capacity)
  prefill_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_PREFILL, graph_bytes)
  decode_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_DECODE, graph_bytes)
  if ggml_ffi.handle_absent(prefill_ctx) || ggml_ffi.handle_absent(decode_ctx) {
    return Err(Error.Invalid)
  }
  mut slot_storage := slot_buffer()
  mut slot_view := slot_storage.bytes()
  bundle_id := runtime_device.bundle_id(owner)
  mut prompt_offset := 0
  loop {
    if prompt_offset >= prompt_ids.len() { break }
    if prompt_offset > 0 { runtime_execution.invalidate(owner, ggml_ffi.GPU_GRAPH_PREFILL)? }
    count := if prompt_ids.len() - prompt_offset < chunk_width { prompt_ids.len() - prompt_offset } else { chunk_width }
    final_chunk := prompt_offset + count == prompt_ids.len()
    prefill_width := runtime_inputs.attention_width(prompt_offset + count, g.context_length)?
    prefill_graph := ggml_ffi.graph_new(prefill_ctx)
    if ggml_ffi.handle_absent(prefill_graph) { return Err(Error.Invalid) }
    runtime_olmoe.build_prefill_chunk(owner, g, prompt_offset, count, final_chunk, prefill_ctx, prefill_graph, slot_view, capture)?
    prefill_key := topology(options, bundle_id, "olmoe", geometry_text, runtime_attention.name(owner),
      ggml_ffi.GPU_GRAPH_PREFILL, prefill_width, count, prompt_offset + count, if final_chunk { 1 } else { 0 })?
    runtime_execution.prepare(owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_key, prefill_graph)?
    update_prompt(owner, prompt_ids, g.n_vocab, prompt_offset, count, prefill_width)?
    runtime_execution.compute(owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_key, prefill_graph)?
    if diagnostic { runtime_diagnostic.write_chunk(capture, count, final_chunk, stream)? }
    prompt_offset = prompt_offset + count
  }
  mut logits := logits_buffer(g.n_vocab)?
  logits_view := logits.bytes()
  ggml_ffi.gpu_slot_get(
    owner, slot_view, runtime_olmoe.output_slot(), logits_view, 0, logits_view.len(), "olmoe_logits",
  ) else { return Err(Error.Invalid) }
  sampled := match seed { Some(_) => true, None => false }
  sampling_seed := match seed { Some(value) => value, None => 0 }
  mut random := rand.seed_with(sampling_seed)
  runtime_numeric_stream.record(stream, runtime_numeric_stream.Frame {
      kind: if diagnostic { 6 } else { 1 }, layer: 4294967295, step: 0, width: g.n_vocab, height: 1,
    }, logits_view)?
  mut token := choose_token(logits_view, sampled, random)?
  mut generated: array_builder<i64> := array_builder()
  generated.push(token)
  mut count := 1
  mut n_past := prompt_ids.len()
  mut decode_width := 0
  mut decode_graph := ggml_ffi.null_handle()
  mut decode_key := "".clone()
  loop {
    if forced {
      if count > forced_ids.len() { break }
    } else {
      if count >= max_tokens || contains(eog_ids, token) { break }
    }
    current_width := runtime_inputs.attention_width(n_past + 1, g.context_length)?
    if current_width != decode_width {
      if decode_width > 0 { runtime_execution.invalidate(owner, ggml_ffi.GPU_GRAPH_DECODE)? }
      decode_graph = ggml_ffi.graph_new(decode_ctx)
      if ggml_ffi.handle_absent(decode_graph) { return Err(Error.Invalid) }
      runtime_olmoe.build_decode_diagnostic(owner, g, n_past, kv_capacity, decode_ctx, decode_graph, slot_view, capture)?
      decode_key = topology(
        options, bundle_id, "olmoe", geometry_text, runtime_attention.name(owner), ggml_ffi.GPU_GRAPH_DECODE,
        current_width, 1, if current_width < kv_capacity { current_width } else { kv_capacity }, 1)?
      runtime_execution.prepare(owner, ggml_ffi.GPU_GRAPH_DECODE, decode_key, decode_graph)?
      decode_width = current_width
    }
    input_token := if forced { forced_ids[count - 1] } else { token }
    update_decode(owner, input_token, n_past, current_width, kv_capacity, v_lanes)?
    runtime_execution.compute(owner, ggml_ffi.GPU_GRAPH_DECODE, decode_key, decode_graph)?
    ggml_ffi.gpu_slot_get(
      owner, slot_view, runtime_olmoe.output_slot(), logits_view, 0, logits_view.len(), "olmoe_logits",
    ) else { return Err(Error.Invalid) }
    if diagnostic { runtime_diagnostic.write(capture, count, stream)? }
    runtime_numeric_stream.record(stream, runtime_numeric_stream.Frame {
        kind: if diagnostic { 6 } else { 1 }, layer: 4294967295, step: count, width: g.n_vocab, height: 1,
      }, logits_view)?
    token = choose_token(logits_view, sampled, random)?
    generated.push(token)
    count = count + 1
    n_past = n_past + 1
  }
  runtime_device.synchronize(owner)?
  return Ok(generated.build())
}

pub Session {
  owner: ggml_ffi.GpuDevice,
  options: runtime_options.RuntimeOptions,
  geometry_text: string,
  qwen: layer_qwen2.Geometry,
  olmo: layer_olmoe.Geometry,
  olmoe: bool,
  kv_capacity: i64,
  chunk_width: i64,
  graph_bytes: i64,
  prefill_slots: buffer,
  decode_slots: buffer,
  prefill_key: string,
  decode_key: string,
  prefix: buffer,
  prefix_count: i64,
  healthy: bool,
}

SessionPlan { kv_capacity: i64, chunk_width: i64, graph_bytes: i64 }

fn prepare_session_qwen(borrow owner: ggml_ffi.GpuDevice,
  borrow options: runtime_options.RuntimeOptions, pack_path: str,
  borrow source_identity: runtime_pack_identity.SourceIdentity, geometry_text: str,
  borrow g: layer_qwen2.Geometry, legacy_cache_bytes: i64,
  retained_host_bytes: i64) -> Result<SessionPlan, Error> {
  if g.code.len() != 0 || g.context_length < 1 || retained_host_bytes < 0 { return Err(Error.Invalid) }
  kv_capacity := if g.context_length < 2175 { g.context_length } else { 2175 }
  maximum_prompt := if g.context_length < 2048 { g.context_length } else { 2048 }
  v_lanes := checked_mul(g.head_dim, g.n_head_kv)?
  if checked_mul(v_lanes, kv_capacity)? > 2147483647 { return Err(Error.Invalid) }
  graph_capacity := qwen_graph_capacity(g.n_layer)?
  stream_capture := checked_add(retained_host_bytes, 1040 + 2175 * 24)?
  maximum_blocks := checked_add(2, checked_mul(g.n_layer, 2)?)?
  maximum_pieces := 0
  mask_bound := runtime_inputs.attention_width(kv_capacity, g.context_length)?
  observation_bytes := application_capacity(runtime_qwen.weight_count(g.n_layer), maximum_pieces,
    maximum_blocks, graph_capacity, geometry_text.len(), 1, mask_bound,
    v_lanes, g.n_vocab, 128, stream_capture)?
  reserve_application(owner, observation_bytes)?
  pack := fs.open_rw(pack_path)?
  runtime_pack_identity.verify_file_bounded(pack, source_identity, maximum_blocks)?
  plan := runtime_qwen_load.build_plan_file_capacity_bounded(owner, pack, g, kv_capacity, maximum_blocks)?
  chunk_width := admit_qwen_shapes(owner, options, g, plan, geometry_text, maximum_prompt, false, kv_capacity,
    graph_capacity, observation_bytes, 0)?
  application_bytes := chunk_application(observation_bytes, chunk_width, mask_bound)?
  staging := prepare_memory(
    owner, options, plan.count, plan.weights_bytes, runtime_qwen.kv_count(g.n_layer),
    plan.kv_bytes, 0, graph_capacity, application_bytes)?
  runtime_qwen_load.load_file(owner, pack, plan, staging)?
  initialize_kv(owner, g.n_layer, g.head_dim, kv_capacity, g.n_head_kv)?
  mask_capacity := runtime_inputs.attention_width(kv_capacity, g.context_length)?
  initialize_inputs(owner, chunk_width, mask_capacity, v_lanes)?
  return Ok(SessionPlan { kv_capacity: kv_capacity, chunk_width: chunk_width,
      graph_bytes: ggml_ffi.graph_context_bytes(graph_capacity) })
}

fn prepare_session_olmoe(borrow owner: ggml_ffi.GpuDevice,
  borrow options: runtime_options.RuntimeOptions, pack_path: str,
  borrow source_identity: runtime_pack_identity.SourceIdentity, geometry_text: str,
  borrow g: layer_olmoe.Geometry, legacy_cache_bytes: i64,
  retained_host_bytes: i64) -> Result<SessionPlan, Error> {
  if g.code.len() != 0 || g.context_length < 1 || retained_host_bytes < 0 { return Err(Error.Invalid) }
  kv_capacity := if g.context_length < 2175 { g.context_length } else { 2175 }
  maximum_prompt := if g.context_length < 2048 { g.context_length } else { 2048 }
  v_lanes := checked_mul(g.head_dim, g.n_head_kv)?
  if checked_mul(v_lanes, kv_capacity)? > 2147483647 { return Err(Error.Invalid) }
  graph_capacity := olmoe_graph_capacity(g.n_layer, g.n_expert_used)?
  stream_capture := checked_add(retained_host_bytes, 1040 + 2175 * 24)?
  maximum_blocks := checked_add(2, checked_mul(g.n_layer, checked_add(2, g.n_expert)?)?)?
  maximum_pieces := checked_add(3, checked_mul(g.n_layer, checked_add(9, checked_mul(3, g.n_expert)?)?)?)?
  mask_bound := runtime_inputs.attention_width(kv_capacity, g.context_length)?
  observation_bytes := application_capacity(runtime_olmoe.weight_count(g.n_layer), maximum_pieces,
    maximum_blocks, graph_capacity, geometry_text.len(), 1, mask_bound,
    v_lanes, g.n_vocab, 128, stream_capture)?
  reserve_application(owner, observation_bytes)?
  pack := fs.open_rw(pack_path)?
  runtime_pack_identity.verify_file_bounded(pack, source_identity, maximum_blocks)?
  plan := runtime_olmoe_load.build_plan_file_capacity_bounded(owner, pack, g, kv_capacity, maximum_blocks)?
  chunk_width := admit_olmoe_shapes(owner, options, g, plan, geometry_text, maximum_prompt, false, kv_capacity,
    graph_capacity, observation_bytes, legacy_cache_bytes)?
  application_bytes := chunk_application(observation_bytes, chunk_width, mask_bound)?
  staging := prepare_memory(
    owner, options, plan.count, plan.weights_bytes, runtime_olmoe.kv_count(g.n_layer),
    plan.kv_bytes, legacy_cache_bytes, graph_capacity, application_bytes)?
  runtime_olmoe_load.load_file(owner, pack, plan, staging)?
  initialize_kv(owner, g.n_layer, g.head_dim, kv_capacity, g.n_head_kv)?
  mask_capacity := runtime_inputs.attention_width(kv_capacity, g.context_length)?
  initialize_inputs(owner, chunk_width, mask_capacity, v_lanes)?
  return Ok(SessionPlan { kv_capacity: kv_capacity, chunk_width: chunk_width,
      graph_bytes: ggml_ffi.graph_context_bytes(graph_capacity) })
}

pub fn create_session(owner: ggml_ffi.GpuDevice, options: runtime_options.RuntimeOptions,
  pack_path: str, borrow source_identity: runtime_pack_identity.SourceIdentity,
  geometry_text: str, olmoe: bool, legacy_cache_bytes: i64,
  retained_host_bytes: i64) -> Result<Session, Error> {
  if retained_host_bytes < 0 || retained_host_bytes >= options.host_budget_bytes
    || (olmoe && legacy_cache_bytes <= 0) || (!olmoe && legacy_cache_bytes != 0) {
    return Err(Error.Invalid)
  }
  reserve_application(owner, checked_add(retained_host_bytes,
      checked_add(262144, checked_mul(geometry_text.len(), 128)?)?)?)?
  qwen := if olmoe { layer_qwen2.empty_geometry() } else { layer_qwen2.parse_geometry(geometry_text) }
  olmo := if olmoe { layer_olmoe.parse_geometry(geometry_text) } else { layer_olmoe.empty_geometry() }
  plan := if olmoe {
    prepare_session_olmoe(owner, options, pack_path, source_identity, geometry_text, olmo,
      legacy_cache_bytes, retained_host_bytes)?
  } else {
    prepare_session_qwen(owner, options, pack_path, source_identity, geometry_text, qwen,
      legacy_cache_bytes, retained_host_bytes)?
  }
  prefill := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_PREFILL, plan.graph_bytes)
  decode := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_DECODE, plan.graph_bytes)
  if ggml_ffi.handle_absent(prefill) || ggml_ffi.handle_absent(decode) { return Err(Error.Invalid) }
  mut empty := buffer(plan.kv_capacity * 8)
  mut at := 0
  loop {
    if at >= plan.kv_capacity { break }
    empty.put_i64_le(0)
    at = at + 1
  }
  return Ok(Session { owner: owner, options: options, geometry_text: geometry_text.clone(),
      qwen: qwen, olmo: olmo, olmoe: olmoe, kv_capacity: plan.kv_capacity,
      chunk_width: plan.chunk_width, graph_bytes: plan.graph_bytes,
      prefill_slots: slot_buffer(), decode_slots: slot_buffer(),
      prefill_key: "".clone(), decode_key: "".clone(), prefix: empty, prefix_count: 0, healthy: true })
}

fn prefix_length(borrow session: Session, borrow prompt: array<i64>) -> i64 {
  old := session.prefix.bytes()
  mut count := 0
  loop {
    if count >= session.prefix_count || count >= prompt.len() - 1 { break }
    if old.i64_le(count * 8) != prompt[count] { break }
    count = count + 1
  }
  return count
}

pub fn generate_session(borrow mut session: Session, borrow prompt_ids: array<i64>,
  borrow eog_ids: array<i64>, max_tokens: i64, seed: Option<i64>) -> Result<array<i64>, Error> {
  if !session.healthy { return Err(Error.Invalid) }
  vocabulary := if session.olmoe { session.olmo.n_vocab } else { session.qwen.n_vocab }
  if prompt_ids.len() < 1 || prompt_ids.len() > 2048 || max_tokens < 1 || max_tokens > 128
    || prompt_ids.len() + max_tokens - 1 > session.kv_capacity { return Err(Error.Invalid) }
  mut at := 0
  loop {
    if at >= prompt_ids.len() { break }
    if prompt_ids[at] < 0 || prompt_ids[at] >= vocabulary { return Err(Error.Invalid) }
    at = at + 1
  }
  // Semantic refusal above is recoverable. Any error after this point forbids further reuse.
  session.healthy = false
  result := execute_session(session, prompt_ids, eog_ids, max_tokens, seed)?
  session.healthy = true
  return Ok(result)
}

fn execute_session(borrow mut session: Session, borrow prompt_ids: array<i64>,
  borrow eog_ids: array<i64>, max_tokens: i64, seed: Option<i64>) -> Result<array<i64>, Error> {
  vocabulary := if session.olmoe { session.olmo.n_vocab } else { session.qwen.n_vocab }
  context_length := if session.olmoe { session.olmo.context_length } else { session.qwen.context_length }
  v_lanes := if session.olmoe { session.olmo.head_dim * session.olmo.n_head_kv } else { session.qwen.head_dim * session.qwen.n_head_kv }
  model_id := if session.olmoe { "olmoe" } else { "qwen2" }
  bundle_id := runtime_device.bundle_id(session.owner)
  mut capture := runtime_diagnostic.disabled()
  mut prompt_offset := prefix_length(session, prompt_ids)
  mut prefill_view := session.prefill_slots.bytes()
  mut decode_view := session.decode_slots.bytes()
  loop {
    if prompt_offset >= prompt_ids.len() { break }
    count := if prompt_ids.len() - prompt_offset < session.chunk_width {
      prompt_ids.len() - prompt_offset
    } else { session.chunk_width }
    final_chunk := prompt_offset + count == prompt_ids.len()
    width := runtime_inputs.attention_width(prompt_offset + count, context_length)?
    key := topology(session.options, bundle_id, model_id, session.geometry_text,
      runtime_attention.name(session.owner), ggml_ffi.GPU_GRAPH_PREFILL, width, count,
      prompt_offset + count, if final_chunk { 1 } else { 0 })?
    mut graph := ggml_ffi.gpu_graph_lookup(session.owner, ggml_ffi.GPU_GRAPH_PREFILL, key)
    if ggml_ffi.handle_absent(graph) {
      if session.prefill_key.len() > 0 {
        runtime_execution.invalidate(session.owner, ggml_ffi.GPU_GRAPH_PREFILL)?
      }
      context := ggml_ffi.gpu_graph_context_lookup(session.owner, ggml_ffi.GPU_GRAPH_PREFILL)
      if ggml_ffi.handle_absent(context) { return Err(Error.Invalid) }
      graph = ggml_ffi.graph_new(context)
      if ggml_ffi.handle_absent(graph) { return Err(Error.Invalid) }
      if session.olmoe {
        runtime_olmoe.build_prefill_chunk(session.owner, session.olmo, prompt_offset, count,
          final_chunk, context, graph, prefill_view, capture)?
      } else {
        runtime_qwen.build_prefill_chunk(session.owner, session.qwen, prompt_offset, count,
          final_chunk, context, graph, prefill_view, capture)?
      }
      runtime_execution.prepare(session.owner, ggml_ffi.GPU_GRAPH_PREFILL, key, graph)?
      session.prefill_key = key.clone()
    }
    update_prompt(session.owner, prompt_ids, vocabulary, prompt_offset, count, width)?
    runtime_execution.compute(session.owner, ggml_ffi.GPU_GRAPH_PREFILL, key, graph)?
    prompt_offset = prompt_offset + count
  }
  mut logits := logits_buffer(vocabulary)?
  logits_view := logits.bytes()
  output_slot := if session.olmoe { runtime_olmoe.output_slot() } else { runtime_qwen.output_slot() }
  ggml_ffi.gpu_slot_get(session.owner, prefill_view, output_slot, logits_view, 0,
    logits_view.len(), "session_prefill_logits") else { return Err(Error.Invalid) }
  sampled := session.olmoe && match seed { Some(_) => true, None => false }
  mut random := rand.seed_with(match seed { Some(value) => value, None => 0 })
  mut token := choose_token(logits_view, sampled, random)?
  mut generated: array_builder<i64> := array_builder()
  generated.push(token)
  mut count := 1
  mut n_past := prompt_ids.len()
  loop {
    if count >= max_tokens || contains(eog_ids, token) { break }
    width := runtime_inputs.attention_width(n_past + 1, context_length)?
    key := topology(session.options, bundle_id, model_id, session.geometry_text,
      runtime_attention.name(session.owner), ggml_ffi.GPU_GRAPH_DECODE, width, 1,
      if width < session.kv_capacity { width } else { session.kv_capacity }, 1)?
    mut graph := ggml_ffi.gpu_graph_lookup(session.owner, ggml_ffi.GPU_GRAPH_DECODE, key)
    if ggml_ffi.handle_absent(graph) {
      if session.decode_key.len() > 0 {
        runtime_execution.invalidate(session.owner, ggml_ffi.GPU_GRAPH_DECODE)?
      }
      context := ggml_ffi.gpu_graph_context_lookup(session.owner, ggml_ffi.GPU_GRAPH_DECODE)
      if ggml_ffi.handle_absent(context) { return Err(Error.Invalid) }
      graph = ggml_ffi.graph_new(context)
      if ggml_ffi.handle_absent(graph) { return Err(Error.Invalid) }
      if session.olmoe {
        runtime_olmoe.build_decode_diagnostic(session.owner, session.olmo, n_past,
          session.kv_capacity, context, graph, decode_view, capture)?
      } else {
        runtime_qwen.build_decode_diagnostic(session.owner, session.qwen, n_past,
          session.kv_capacity, context, graph, decode_view, capture)?
      }
      runtime_execution.prepare(session.owner, ggml_ffi.GPU_GRAPH_DECODE, key, graph)?
      session.decode_key = key.clone()
    }
    update_decode(session.owner, token, n_past, width, session.kv_capacity, v_lanes)?
    runtime_execution.compute(session.owner, ggml_ffi.GPU_GRAPH_DECODE, key, graph)?
    ggml_ffi.gpu_slot_get(session.owner, decode_view, output_slot, logits_view, 0,
      logits_view.len(), "session_decode_logits") else { return Err(Error.Invalid) }
    token = choose_token(logits_view, sampled, random)?
    generated.push(token)
    count = count + 1
    n_past = n_past + 1
  }
  runtime_device.synchronize(session.owner)?
  ids := generated.build()
  publish_prefix(session, prompt_ids, ids)
  return Ok(ids)
}

fn publish_prefix(borrow mut session: Session, borrow prompt_ids: array<i64>,
  borrow ids: array<i64>) {
  mut destination := session.prefix.bytes()
  total := prompt_ids.len() + ids.len() - 1
  mut at := 0
  loop {
    if at >= total { break }
    mut value := if at < prompt_ids.len() { prompt_ids[at] } else { ids[at - prompt_ids.len()] }
    mut byte := 0
    loop {
      if byte >= 8 { break }
      destination[at * 8 + byte] = (value % 256) as u8
      value = value / 256
      byte = byte + 1
    }
    at = at + 1
  }
  session.prefix_count = total
}
