module runtime_generation

import ggml_ffi
import layer_olmoe
import layer_qwen2
import runtime_device
import runtime_execution
import runtime_inputs
import runtime_kv
import runtime_memory
import runtime_olmoe
import runtime_olmoe_load
import runtime_options
import runtime_qwen
import runtime_qwen_load
import runtime_sampler
import runtime_weights
import std.crypto
import std.encoding
import std.rand

MAX_EXTENT := 9223372036854775807
SLOT_BYTES := 1040
MAX_STAGING_BYTES := 16777216
MASK_NEG_INFINITY_BITS := 4286578688

fn checked_add(left: i64, right: i64) -> Result<i64, Error> {
  if left < 0 || right < 0 || left > MAX_EXTENT - right { return Err(Error.Invalid) }
  return Ok(left + right)
}

fn checked_mul(left: i64, right: i64) -> Result<i64, Error> {
  if left < 0 || right < 0 || (right > 0 && left > MAX_EXTENT / right) {
    return Err(Error.Invalid)
  }
  return Ok(left * right)
}

fn digest(value: str) -> string {
  bytes := crypto.sha256(value)
  return encoding.hex_encode(bytes[0..bytes.len()]).clone()
}

fn signature(model_id: str, kind: i64, width: i64, height: i64) -> string {
  out := builder()
  out.write("g1:")
  out.write(model_id)
  out.write(":")
  out.write_int(kind)
  out.write(":")
  out.write_int(width)
  out.write(":")
  out.write_int(height)
  return digest(out.to_string())
}

fn topology(
  borrow options: runtime_options.RuntimeOptions,
  bundle_id: str,
  model_id: str,
  geometry: str,
  kind: i64,
  width: i64,
  height: i64,
) -> Result<string, Error> {
  identity := runtime_execution.TopologyIdentity {
    backend: options.backend.clone(),
    bundle_id: bundle_id.clone(),
    model_id: model_id.clone(),
    model_layout_sha256: digest(geometry),
    tensor_shape_stride_sha256: signature(model_id, kind, width, height),
    attention_policy: "decomposed-f32".clone(),
  }
  invocation := runtime_execution.TopologyInvocation {
    graph_kind: kind,
    buffer_generation: 1,
    kv_view_width: width,
    query_width: height,
    mask_layout_sha256: signature("mask", kind, width, height),
    position_layout_sha256: signature("position", kind, width, height),
    output_selection_sha256: signature("output", kind, width, height),
  }
  return runtime_execution.topology_key(identity, invocation)
}

// Graph contexts retain every tensor created while the per-layer slot window is reused. The
// capacity therefore scales with model depth even though either architecture needs at most 128
// simultaneously addressable slots. These bounds include the embed/head tensors and, per layer,
// both resident-KV views and copy nodes.
fn qwen_graph_capacity(n_layer: i64) -> Result<i64, Error> {
  return checked_add(4, checked_mul(n_layer, 44)?)
}

fn olmoe_graph_capacity(n_layer: i64, n_expert_used: i64) -> Result<i64, Error> {
  per_layer := checked_add(44, layer_olmoe.b_node_count(n_expert_used))?
  return checked_add(4, checked_mul(n_layer, per_layer)?)
}

fn prepare_memory(
  borrow owner: ggml_ffi.GpuDevice,
  borrow options: runtime_options.RuntimeOptions,
  weight_count: i64,
  weights_bytes: i64,
  kv_count: i64,
  kv_bytes: i64,
  legacy_cache_bytes: i64,
  graph_capacity: i64,
) -> Result<i64, Error> {
  tensor_count := checked_add(checked_add(weight_count, kv_count)?, runtime_qwen.INPUT_COUNT)?
  root_metadata := runtime_weights.metadata_bytes(tensor_count)
  graph_metadata := ggml_ffi.graph_context_bytes(graph_capacity)
  if root_metadata < 1 || graph_metadata < 1 { return Err(Error.Invalid) }
  metadata_bytes := checked_add(
    checked_add(root_metadata, checked_mul(graph_metadata, 2)?)?, 128)?
  device_used := checked_add(weights_bytes, kv_bytes)?
  if device_used >= options.device_budget_bytes { return Err(Error.Invalid) }
  workspace_bytes := options.device_budget_bytes - device_used
  host_used := checked_add(metadata_bytes, legacy_cache_bytes)?
  if host_used >= options.host_budget_bytes { return Err(Error.Invalid) }
  host_remaining := options.host_budget_bytes - host_used
  staging_bytes := if host_remaining < MAX_STAGING_BYTES {
    host_remaining
  } else { MAX_STAGING_BYTES }
  runtime_memory.admit(owner, runtime_memory.MemoryPlan {
      weights_bytes: weights_bytes,
      kv_bytes: kv_bytes,
      workspace_bytes: workspace_bytes,
      metadata_bytes: metadata_bytes,
      staging_bytes: staging_bytes,
      legacy_cache_bytes: legacy_cache_bytes,
    })?
  runtime_memory.allocate(owner)?
  return Ok(staging_bytes)
}

fn initialize_kv(
  borrow owner: ggml_ffi.GpuDevice,
  n_layer: i64,
  head_dim: i64,
  context_length: i64,
  n_head_kv: i64,
) -> Result<(), Error> {
  count := checked_mul(n_layer, 2)?
  runtime_kv.begin(owner, count)?
  mut layer := 0
  loop {
    if layer >= n_layer { break }
    k := runtime_kv.add(owner, runtime_kv.Shape {
        ggml_type: 0, n_dims: 3, ne0: head_dim, ne1: context_length,
        ne2: n_head_kv, ne3: 1,
      })?
    v := runtime_kv.add(owner, runtime_kv.Shape {
        ggml_type: 0, n_dims: 3, ne0: context_length, ne1: head_dim,
        ne2: n_head_kv, ne3: 1,
      })?
    if k != 2 * layer || v != 2 * layer + 1 { return Err(Error.Invalid) }
    layer = layer + 1
  }
  return runtime_kv.finish(owner)
}

fn initialize_inputs(
  borrow owner: ggml_ffi.GpuDevice,
  prompt_count: i64,
  context_length: i64,
) -> Result<(), Error> {
  runtime_inputs.begin(owner, runtime_qwen.INPUT_COUNT)?
  tokens := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: prompt_count, ne1: 1, ne2: 1, ne3: 1,
    })?
  positions := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: prompt_count, ne1: 1, ne2: 1, ne3: 1,
    })?
  mask := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 0, n_dims: 2, ne0: context_length, ne1: prompt_count, ne2: 1, ne3: 1,
    })?
  decode_token := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 1, ne1: 1, ne2: 1, ne3: 1,
    })?
  decode_position := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 1, ne1: 1, ne2: 1, ne3: 1,
    })?
  decode_mask := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 0, n_dims: 2, ne0: context_length, ne1: 1, ne2: 1, ne3: 1,
    })?
  output_id := runtime_inputs.add(owner, runtime_inputs.Shape {
      ggml_type: 26, n_dims: 1, ne0: 1, ne1: 1, ne2: 1, ne3: 1,
    })?
  if tokens != 0 || positions != 1 || mask != 2 || decode_token != 3
    || decode_position != 4 || decode_mask != 5 || output_id != 6 {
    return Err(Error.Invalid)
  }
  return runtime_inputs.finish(owner)
}

fn slot_buffer() -> buffer {
  mut storage := buffer(SLOT_BYTES)
  mut at := 0
  loop {
    if at >= SLOT_BYTES / 4 { break }
    storage.put_u32_le(0)
    at = at + 1
  }
  return storage
}

fn update_prompt(
  borrow owner: ggml_ffi.GpuDevice,
  borrow prompt_ids: array<i64>,
  context_length: i64,
  n_vocab: i64,
) -> Result<(), Error> {
  mut token_image := buffer(checked_mul(prompt_ids.len(), 4)?)
  mut position_image := buffer(checked_mul(prompt_ids.len(), 4)?)
  mut at := 0
  loop {
    if at >= prompt_ids.len() { break }
    if prompt_ids[at] < 0 || prompt_ids[at] >= n_vocab { return Err(Error.Invalid) }
    token_image.put_u32_le(prompt_ids[at] as u32)
    position_image.put_u32_le(at as u32)
    at = at + 1
  }
  mut mask_image := buffer(checked_mul(checked_mul(context_length, prompt_ids.len())?, 4)?)
  mut row := 0
  loop {
    if row >= prompt_ids.len() { break }
    mut col := 0
    loop {
      if col >= context_length { break }
      mask_image.put_u32_le(if col <= row { 0 } else { MASK_NEG_INFINITY_BITS as u32 })
      col = col + 1
    }
    row = row + 1
  }
  mut output_image := buffer(4)
  output_image.put_u32_le((prompt_ids.len() - 1) as u32)
  token_view := token_image.bytes()
  position_view := position_image.bytes()
  mask_view := mask_image.bytes()
  output_view := output_image.bytes()
  runtime_inputs.update(owner, 0, 0, token_view)?
  runtime_inputs.update(owner, 1, 0, position_view)?
  runtime_inputs.update(owner, 2, 0, mask_view)?
  return runtime_inputs.update(owner, 6, 0, output_view)
}

fn update_decode(
  borrow owner: ggml_ffi.GpuDevice,
  token: i64,
  n_past: i64,
  context_length: i64,
) -> Result<(), Error> {
  mut token_image := buffer(4)
  token_image.put_u32_le(token as u32)
  mut position_image := buffer(4)
  position_image.put_u32_le(n_past as u32)
  mut mask_image := buffer(checked_mul(context_length, 4)?)
  mut col := 0
  loop {
    if col >= context_length { break }
    mask_image.put_u32_le(if col <= n_past { 0 } else { MASK_NEG_INFINITY_BITS as u32 })
    col = col + 1
  }
  mut output_image := buffer(4)
  output_image.put_u32_le(0)
  token_view := token_image.bytes()
  position_view := position_image.bytes()
  mask_view := mask_image.bytes()
  output_view := output_image.bytes()
  runtime_inputs.update(owner, 3, 0, token_view)?
  runtime_inputs.update(owner, 4, 0, position_view)?
  runtime_inputs.update(owner, 5, 0, mask_view)?
  return runtime_inputs.update(owner, 6, 0, output_view)
}

fn finite_f32(borrow logits: slice<u8>, offset: i64) -> bool {
  bits := logits.u32_le(offset)
  return (bits / 8388608) % 256 != 255
}

fn greedy(borrow logits: slice<u8>) -> Result<i64, Error> {
  if logits.len() < 4 || logits.len() % 4 != 0 { return Err(Error.Invalid) }
  mut best := -1
  mut best_value := 0.0 as f32
  mut token := 0
  loop {
    if token >= logits.len() / 4 { break }
    offset := token * 4
    if !finite_f32(logits, offset) { return Err(Error.Invalid) }
    value := logits.f32_le(offset)
    if best < 0 || value > best_value {
      best = token
      best_value = value
    }
    token = token + 1
  }
  if best < 0 { return Err(Error.Invalid) }
  return Ok(best)
}

fn choose_token(
  borrow logits: slice<u8>, sampled: bool, borrow mut random: rng,
) -> Result<i64, Error> {
  if sampled {
    selected := runtime_sampler.select(logits, random)?
    return Ok(selected.token_id)
  }
  return greedy(logits)
}

fn contains(borrow ids: array<i64>, value: i64) -> bool {
  mut at := 0
  loop {
    if at >= ids.len() { break }
    if ids[at] == value { return true }
    at = at + 1
  }
  return false
}

fn logits_buffer(n_vocab: i64) -> Result<buffer, Error> {
  bytes := checked_mul(n_vocab, 4)?
  mut logits := buffer(bytes)
  mut at := 0
  loop {
    if at >= n_vocab { break }
    logits.put_u32_le(0)
    at = at + 1
  }
  return Ok(logits)
}

pub fn generate_qwen(
  borrow owner: ggml_ffi.GpuDevice,
  borrow options: runtime_options.RuntimeOptions,
  pack_path: str,
  geometry_text: str,
  borrow prompt_ids: array<i64>,
  borrow eog_ids: array<i64>,
  max_tokens: i64,
) -> Result<array<i64>, Error> {
  g := layer_qwen2.parse_geometry(geometry_text)
  allocation_steps := if max_tokens > 1 { max_tokens - 1 } else { 1 }
  if g.code.len() != 0 || prompt_ids.len() < 1 || prompt_ids.len() > 2048
    || max_tokens < 1 || max_tokens > 128
    || prompt_ids.len() + allocation_steps > g.context_length {
    return Err(Error.Invalid)
  }
  graph_capacity := qwen_graph_capacity(g.n_layer)?
  plan := runtime_qwen_load.build_plan(owner, pack_path, g)?
  staging := prepare_memory(
    owner, options, plan.count, plan.weights_bytes, runtime_qwen.kv_count(g.n_layer),
    plan.kv_bytes, 0, graph_capacity)?
  runtime_qwen_load.load(owner, pack_path, plan, staging)?
  initialize_kv(owner, g.n_layer, g.head_dim, g.context_length, g.n_head_kv)?
  initialize_inputs(owner, prompt_ids.len(), g.context_length)?
  graph_bytes := ggml_ffi.graph_context_bytes(graph_capacity)
  prefill_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_PREFILL, graph_bytes)
  decode_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_DECODE, graph_bytes)
  if ggml_ffi.handle_absent(prefill_ctx) || ggml_ffi.handle_absent(decode_ctx) {
    return Err(Error.Invalid)
  }
  mut slot_storage := slot_buffer()
  mut slot_view := slot_storage.bytes()
  prefill_graph := ggml_ffi.graph_new(prefill_ctx)
  if ggml_ffi.handle_absent(prefill_graph) { return Err(Error.Invalid) }
  runtime_qwen.build_prefill(owner, g, prompt_ids.len(), prefill_ctx, prefill_graph, slot_view)?
  bundle_id := runtime_device.bundle_id(owner)
  prefill_key := topology(
    options, bundle_id, "qwen2", geometry_text, ggml_ffi.GPU_GRAPH_PREFILL,
    prompt_ids.len(), prompt_ids.len())?
  runtime_execution.prepare(owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_key, prefill_graph)?
  update_prompt(owner, prompt_ids, g.context_length, g.n_vocab)?
  runtime_execution.compute(owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_key, prefill_graph)?
  mut logits := logits_buffer(g.n_vocab)?
  logits_view := logits.bytes()
  ggml_ffi.slot_get(
    slot_view, runtime_qwen.output_slot(), logits_view, 0, logits_view.len(), "qwen_logits",
  ) else { return Err(Error.Invalid) }
  mut random := rand.seed_with(0)
  mut token := choose_token(logits_view, false, random)?
  mut generated: array_builder<i64> := array_builder()
  generated.push(token)
  mut count := 1
  mut n_past := prompt_ids.len()
  mut decode_prepared := false
  loop {
    if count >= max_tokens || contains(eog_ids, token) { break }
    if decode_prepared { runtime_execution.invalidate(owner, ggml_ffi.GPU_GRAPH_DECODE)? }
    decode_graph := ggml_ffi.graph_new(decode_ctx)
    if ggml_ffi.handle_absent(decode_graph) { return Err(Error.Invalid) }
    runtime_qwen.build_decode(owner, g, n_past, decode_ctx, decode_graph, slot_view)?
    decode_key := topology(
      options, bundle_id, "qwen2", geometry_text, ggml_ffi.GPU_GRAPH_DECODE,
      n_past + 1, 1)?
    runtime_execution.prepare(owner, ggml_ffi.GPU_GRAPH_DECODE, decode_key, decode_graph)?
    decode_prepared = true
    update_decode(owner, token, n_past, g.context_length)?
    runtime_execution.compute(owner, ggml_ffi.GPU_GRAPH_DECODE, decode_key, decode_graph)?
    ggml_ffi.slot_get(
      slot_view, runtime_qwen.output_slot(), logits_view, 0, logits_view.len(), "qwen_logits",
    ) else { return Err(Error.Invalid) }
    token = choose_token(logits_view, false, random)?
    generated.push(token)
    count = count + 1
    n_past = n_past + 1
  }
  runtime_device.synchronize(owner)?
  return Ok(generated.build())
}

pub fn generate_olmoe(
  borrow owner: ggml_ffi.GpuDevice,
  borrow options: runtime_options.RuntimeOptions,
  pack_path: str,
  geometry_text: str,
  borrow prompt_ids: array<i64>,
  borrow eog_ids: array<i64>,
  max_tokens: i64,
  legacy_cache_bytes: i64,
  seed: Option<i64>,
) -> Result<array<i64>, Error> {
  g := layer_olmoe.parse_geometry(geometry_text)
  allocation_steps := if max_tokens > 1 { max_tokens - 1 } else { 1 }
  if g.code.len() != 0 || prompt_ids.len() < 1 || prompt_ids.len() > 2048
    || max_tokens < 1 || max_tokens > 128
    || prompt_ids.len() + allocation_steps > g.context_length {
    return Err(Error.Invalid)
  }
  graph_capacity := olmoe_graph_capacity(g.n_layer, g.n_expert_used)?
  plan := runtime_olmoe_load.build_plan(owner, pack_path, g)?
  staging := prepare_memory(
    owner, options, plan.count, plan.weights_bytes, runtime_olmoe.kv_count(g.n_layer),
    plan.kv_bytes, legacy_cache_bytes, graph_capacity)?
  runtime_olmoe_load.load(owner, pack_path, plan, staging)?
  initialize_kv(owner, g.n_layer, g.head_dim, g.context_length, g.n_head_kv)?
  initialize_inputs(owner, prompt_ids.len(), g.context_length)?
  graph_bytes := ggml_ffi.graph_context_bytes(graph_capacity)
  prefill_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_PREFILL, graph_bytes)
  decode_ctx := runtime_execution.context(owner, ggml_ffi.GPU_GRAPH_DECODE, graph_bytes)
  if ggml_ffi.handle_absent(prefill_ctx) || ggml_ffi.handle_absent(decode_ctx) {
    return Err(Error.Invalid)
  }
  mut slot_storage := slot_buffer()
  mut slot_view := slot_storage.bytes()
  prefill_graph := ggml_ffi.graph_new(prefill_ctx)
  if ggml_ffi.handle_absent(prefill_graph) { return Err(Error.Invalid) }
  runtime_olmoe.build_prefill(owner, g, prompt_ids.len(), prefill_ctx, prefill_graph, slot_view)?
  bundle_id := runtime_device.bundle_id(owner)
  prefill_key := topology(
    options, bundle_id, "olmoe", geometry_text, ggml_ffi.GPU_GRAPH_PREFILL,
    prompt_ids.len(), prompt_ids.len())?
  runtime_execution.prepare(owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_key, prefill_graph)?
  update_prompt(owner, prompt_ids, g.context_length, g.n_vocab)?
  runtime_execution.compute(owner, ggml_ffi.GPU_GRAPH_PREFILL, prefill_key, prefill_graph)?
  mut logits := logits_buffer(g.n_vocab)?
  logits_view := logits.bytes()
  ggml_ffi.slot_get(
    slot_view, runtime_olmoe.output_slot(), logits_view, 0, logits_view.len(), "olmoe_logits",
  ) else { return Err(Error.Invalid) }
  sampled := match seed { Some(_) => true, None => false }
  sampling_seed := match seed { Some(value) => value, None => 0 }
  mut random := rand.seed_with(sampling_seed)
  mut token := choose_token(logits_view, sampled, random)?
  mut generated: array_builder<i64> := array_builder()
  generated.push(token)
  mut count := 1
  mut n_past := prompt_ids.len()
  mut decode_prepared := false
  loop {
    if count >= max_tokens || contains(eog_ids, token) { break }
    if decode_prepared { runtime_execution.invalidate(owner, ggml_ffi.GPU_GRAPH_DECODE)? }
    decode_graph := ggml_ffi.graph_new(decode_ctx)
    if ggml_ffi.handle_absent(decode_graph) { return Err(Error.Invalid) }
    runtime_olmoe.build_decode(owner, g, n_past, decode_ctx, decode_graph, slot_view)?
    decode_key := topology(
      options, bundle_id, "olmoe", geometry_text, ggml_ffi.GPU_GRAPH_DECODE,
      n_past + 1, 1)?
    runtime_execution.prepare(owner, ggml_ffi.GPU_GRAPH_DECODE, decode_key, decode_graph)?
    decode_prepared = true
    update_decode(owner, token, n_past, g.context_length)?
    runtime_execution.compute(owner, ggml_ffi.GPU_GRAPH_DECODE, decode_key, decode_graph)?
    ggml_ffi.slot_get(
      slot_view, runtime_olmoe.output_slot(), logits_view, 0, logits_view.len(), "olmoe_logits",
    ) else { return Err(Error.Invalid) }
    token = choose_token(logits_view, sampled, random)?
    generated.push(token)
    count = count + 1
    n_past = n_past + 1
  }
  runtime_device.synchronize(owner)?
  return Ok(generated.build())
}
